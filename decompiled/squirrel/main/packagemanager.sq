const PACKAGE_SXR_NOTREADY = 0;
const PACKAGE_SXR_READY = 1;
const PACKAGE_SXR_OPEN = 2;

class PackageManager
{
  static DEV_LEVEL = 99;

  pkgdir = null;
  pkg = null;
  pkgstatus = null;

  sxrlist = null;
  res = null;

  appendfile = null;
  appendsxr = null;

  constructor(pdir, appenddir = null, _pkg = null) {
    pkgdir = pdir;
    pkg = _pkg || decodeJSON(::getResource("pkg.json").getContent());

    if (appenddir) {
      local appendf = null, maxrev = -1;
      local prefix = sprintf("append-%05d_", pkg.version);
      foreach (f in appenddir.getList()) {
        local n = f.name;
        if (n.startsWith(prefix)) {
          local rev = int(n.substring(length(prefix)));
          if (rev > maxrev) {
            appendf = f;
            maxrev = rev;
          }
        }
      }
      appendfile = appendf;
      if (appendf && appendf.exists()) {
        local sxr = SxrFile(appendf);
        try {
          sxr.open();
          local sxrres = SxrResource(sxr.getRoot(), null);;
          local apkg = decodeJSON(sxrres.getContent("append.json"));
          if (pkg.version == apkg.version) {
            printf("found append package : revision %d\n", apkg.revision);
            mergeAppendPackage(pkg.entries[0][2], sxr.getRoot());
            appendsxr = sxr;
            mergeSystem(::getResource("/system"), sxrres.getResource("/system"));
          } else {
            printf("ignore append package : version mismatch %d != %d\n", pkg.version, apkg.version);
          }
        } catch (ex) {
          local p1 = printf, p2 = printexception;
          printf("loading append package failure...\n");
          printexception(ex);
        }
      }
    }

    buildResouceTree(pkg);
  }

  function getSxrItem(name) {
    foreach (v in sxrlist) {
      if (v.sxrname == name) return v;
    }
    return null;
  }

  function buildResouceTree(t) {

    local _sxrlist = array(length(t.sxrlist));
    foreach (i, r in t.sxrlist) {
      _sxrlist[i] = SxrListItem(pkgdir, r);
    }
    sxrlist = _sxrlist;

    res = MultiSxrResource(t.entries[0], null);
    res.manager = this;
  }

  function mergeSystem(srcdir, apndir) {
    local srclist = srcdir.getList();
    foreach (i, v in apndir.getList()) {
      local r0 = srcdir.getResource(v.name);
      if (r0) {
        if (r0.isdir && v.isdir) {

          mergeSystem(r0, v);
        } else {

          srclist.removeValue(r0);
          srclist + v;
          v.pres = srcdir;
        }
      } else {

        srclist + v;
        v.pres = srcdir;
      }
    }
  }

  function _getclistitem(clist, ename) {
    foreach (i, v in clist) {
      if (v[1] == ename) return i;
    }
    return -1;
  }

  function mergeAppendPackage(clist, sxe) {
    foreach (i, e in sxe.getList([])) {
      local si = _getclistitem(clist, e);
      if (si >= 0) {
        if (clist[si][0] == 1 && e.isDirectory()) {
          mergeAppendPackage(clist[si][2], e.name);
        } else {
          clist[si] = e;
        }
      } else {
        clist + e;
      }
    }
  }
}

class SxrListItem
{
  sxrname = "";
  sxrpath = "";
  size = 0;
  md5 = "";
  version = 0;
  autorelease = 1;

  rootdir = null;
  file = null;
  sxr = null;
  status = -1;

  constructor(dir, t) {
    rootdir = dir;
    sxrname = t.sxrname;
    sxrpath = sprintf("%S/%S-%04x.sxr", rootdir.path, t.sxrname, t.version);
    file = FileRef(sxrpath);
    size = t.size;
    md5 = t.md5;
    version = t.version;

    checkStatus();
  }

  function ready() {
    if (sxr) return sxr;
    if (status == PACKAGE_SXR_READY) {
      sxr = SxrFile(file);
      sxr.open();
      sxr.setAutoRelease(30);
      return sxr;
    } else {
      return null;
    }
  }

  function checkStatus() {
    status = PACKAGE_SXR_NOTREADY;
    file = FileRef(file.path);
    if (file.exists() && file.size == size) {
      status = PACKAGE_SXR_READY;
    } else {

    }
  }
}

class MultiSxrResource extends Resource
{
  manager = null;
  sxridx = -1;
  sxrentryidx = -1;

  clist = null;

  constructor(t, p) {
    if (t[0] == 1) {
      clist = t[2];
      isdir = true;
    } else {
      sxridx = t[2];
      sxrentryidx = t[3];
    }
    if (p) {
      pres = p;
      manager = p.manager;
    }
    name = t[1];
  }

  function getDataSource() {
    local sxr = manager.sxrlist[sxridx].ready();
    if (!sxr) {
      throw Exception("missing sxr : " + manager.sxrlist[sxridx].sxrname + " / " + path);
    }
    local e = sxr.getRoot().getChild(string(sxrentryidx));
    return e;
  }

  function loadList() {
    if (!isdir) list = emptylist;
    else {
      local len = length(clist);
      list = array(len);
      for (local l = len - 1; l >= 0; l--) {
        local r;
        if (clist[l] instanceof SxrEntity) {
          r = SxrResource(clist[l], this);
        } else {
          r = MultiSxrResource(clist[l], this);
        }
        r = checkAlias(r);
        list[l] = r;
      }
    }
  }

  function loadData() {
    if (isdir) return null;
    local sxr = manager.sxrlist[sxridx].ready();
    if (!sxr) {
      throw Exception("missing sxr : " + manager.sxrlist[sxridx].sxrname + " / " + path);
    }
    local e = sxr.getRoot().getChild(string(sxrentryidx));
    if (!e) {
      throw Exception("missing sxr entry : " + sxrentryidx + " / " + manager.sxrlist[sxridx].sxrname + " / " + path);
    }
    return e.getData(ByteBuffer());
  }
}