class MenuAdaptor
{

  rootnode = null;

  constructor() {
  }

  function getCellHeight() {
    return 20;
  }

  function getItemView(idx, o, convertv, parentv, stateonly) {
    return null;
  }

  function getListWidth(o) {
    return 100;
  }

  function hasList(o) {
    return false;
  }

  function getListAdaptor(o) {
    return null;
  }

  function getParent(o) {
    return null;
  }

}

class MenuListAdaptor extends ListAdaptor
{
  menuadapt = null;
  node = null;

  function getItemView(idx, convertv, parentv, stateonly) {
    return menuadapt.getItemView(idx, list[idx], convertv, parentv, stateonly);
  }

  function isSelectable(idx) {
    return true;
  }

  function getCellHeight() {
    return menuadapt.getCellHeight();
  }
}

