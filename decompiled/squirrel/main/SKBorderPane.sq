class SKBorderPane extends SKView
{
  bordersp = null;
  magl = 0;
  magr = 0;
  magt = 0;
  magb = 0;
  padl = 2;
  padr = 2;
  padt = 2;
  padb = 2;

  constructor() {
    bordersp = Sprite();
  }

  function margin(...) {
    switch (vargc) {
    case 1: magl = magr = magt = magb = vargv[0]; break;
    case 2: magl = magr = vargv[0]; magt = magb = vargv[1]; break;
    case 4: magl = vargv[0]; magr = vargv[1]; magt = vargv[2]; magb = vargv[3]; break;
    }
  }

  function padding(...) {
    switch (vargc) {
    case 1: padl = padr = padt = padb = vargv[0]; break;
    case 2: padl = padr = vargv[0]; padt = padb = vargv[1]; break;
    case 4: padl = vargv[0]; padr = vargv[1]; padt = vargv[2]; padb = vargv[3]; break;
    }
  }

  function updateLayout() {
    local w = bnd.w, h = bnd.h;
    bordersp.bnd.set(magl, magr, w - magl - magr, h - magt - magb);
    foreach (c in children) {
      c.setRect(padl, padt, w - padl - padr, h - padt - padb);
    }
  }

  function setContent(c) {
    addChild(c);
    updateLayout();
  }

  function render() {
    skDrawSprite(bordersp);
  }
}