  RGBA = 13
  PATH = 14

  TEXTSTYLE = 100
  PATH = 101
  ALIGN = 102
  STRETCH = 103
  BODY = 104
  VEC2 = 105
  ROT1 = 106
  FLOAT2_SCALE = 200
