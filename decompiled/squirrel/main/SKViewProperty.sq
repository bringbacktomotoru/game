import PropertyType;
import SKViewPropertyID;

class SKProperties
{
  props = null;

  constructor() {
    props = {};
  }

  function _get(id) {
    if (!(id in props)) {
      foreach (p in props) {
        printf("%S ", p.id);
      }
      printf("\n");
      throw Exception("prop id " + id + " not found");
    }
    return props[id];
  }

  function _concat(p) {
    if (p.id in props) {
      throw Exception("duplicate PARAMETER ID : " + p.id);
    }
    props[p.id] <- p;
  }
};

local blendlist = ["0:OFF", "1:MIX", "2:PMAMIX", "3:ADD", "4:MULT", "5:MIXADD", "6:MASKMIX", "7:MASKALPHA"];
local wraplist = ["0:OFF", "1:ON", "2:ON(-)"];
local alignlist = ["0:←↑・", "1:・↑・", "2:・↑→", "3:←・・", "4:・〇・", "5:・・→", "6:←↓・", "7:・↓・", "8:・↓→", "9:・↑・(LINE)", "10:・〇・(LINE)", "11:・↓・(LINE)"];
local alignlist2 = ["0:←↑・", "1:・↑・", "2:・↑→", "3:←・・", "4:・〇・", "5:・・→", "6:←↓・", "7:・↓・", "8:・↓→", "9:伸縮"];
local buflist = ["0:OFF", "1:ON", "2:ON(+Z)"];

::SKVP <- SKProperties();
