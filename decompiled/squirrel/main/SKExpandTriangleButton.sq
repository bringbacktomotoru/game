class SKExpandTriangleButton extends SKView
{
  splist = null;
  sp = null;
  expanded = false;

  static zaxis = Vector3D(0.0, 0.0, 1.0);
  static q_1 = Quaternion();

  constructor(txt = "", g = null, type = 0) {
    splist = [
    ::getSprite("/system/ui.silver/ui.clp#tri1"),
    ::getSprite("/system/ui.silver/ui.clp#tri2"),
    ];
    sp = clone splist[0];
    sp.mat = Matrix();
    bnd.set(sp.bnd);
  }

  function updateLayout() {
    super.updateLayout();
    sp.mat.setTranslation((bnd.w * 0.5 - 2) | 0, (bnd.h * 0.5) | 0, 0.0);
  }

  function render() {
    skDrawSprite(sp);
  }

  function setExpanded(b) {
    if (expanded == b) return;
    stopMethod();
    expanded = b;
    sp.mat.identity();
    if (b) sp.mat.rotate(q_1.set(zaxis, 3.1415927 * 0.5));
    sp.mat.setTranslation((bnd.w * 0.5 - 2) | 0, (bnd.h * 0.5) | 0, 0.0);
    sp.uvmat0 = splist[b ? 1 : 0].uvmat0;
  }

  function expand() {
    local func = function() {
      for (local l = 1; l <= 3; l++) {
        sleep(30);
        sp.mat.identity();
        sp.mat.rotate(q_1.set(zaxis, 3.1415927 * 0.5 * l / 3));
        sp.mat.setTranslation((bnd.w * 0.5 - 2) | 0, (bnd.h * 0.5) | 0, 0.0);
        repaint();
      }
      sp.uvmat0 = splist[1].uvmat0;
    }
    newthread().start(func, this);
  }

  function shrink() {
    local func = function() {
      for (local l = 1; l <= 3; l++) {
        sleep(30);
        sp.mat.identity();
        sp.mat.rotate(q_1.set(zaxis, 3.1415927 * 0.5 * (3 - l) / 3));
        sp.mat.setTranslation((bnd.w * 0.5 - 2) | 0, (bnd.h * 0.5) | 0, 0.0);
        repaint();
      }
      sp.uvmat0 = splist[0].uvmat0;
    }
    newthread().start(func, this);
  }

  function processEvent(e) {
    switch (e.id) {
    case MOUSE_PRESSED:
      if (expanded = !expanded) {
        expand();
        postActionEvent("expand");
      } else {
        shrink();
        postActionEvent("shrink");
      }
      e.consume();
      break;
    case MOUSE_RELEASED:
    case MOUSE_DRAGGED:
    case MOUSE_MOVED:
    case MOUSE_ENTERED:
    case MOUSE_EXITED:
      e.consume();
      break;
    }
    return super.processEvent(e);
  }
}