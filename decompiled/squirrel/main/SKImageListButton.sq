class SKImageListButton extends SKButtonBase
{
  splist = null;
  sp = null;

  viewenabled = true;

  constructor(spl = null) {
    splist = spl || array(3);
    sp = spl[0];
    if (sp) {
      bnd.set(sp.bnd);
    }
  }

  function setSpriteList(spl) {
    splist = spl;
  }

  function updateLayout() {
    foreach (s in splist) {
      if (s) s.bnd.set(bnd);
    }
  }

  function render() {
    skDrawSprite(sp);
  }

  function updateButtonState(st) {

    switch (st) {
    case 4:
      sp = splist[0]; break;
    case 5:
      sp = splist[1]; break;
    case 6:
      sp = splist[1]; break;
    case 7:
      sp = splist[2]; break;
    default:
      sp = splist[3]; break;
    }
  }
}