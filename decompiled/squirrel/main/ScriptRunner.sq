local arglist = [];

class ScriptRunner
{
  thread = null;
  threadstack = null;
  scp = null;
  argv = null;

  running = false;
  func = null;
  nextfunc = null;
  interruptlabel = null;

  constructor(s = null) {
    setScript(s);
  }

  function setScript(s) {
    scp = s;
  }

  function _get(idx) {
    return scp[idx];
  }

  function _set(idx, val) {
    scp[idx] = val;
    return val;
  }

  function _newslot(idx, val) {
    scp[idx] <- val;
    return val;
  }

  function _exec_(m, ...) {
    local fn = (typeof(m) == SS_CLOSURE) ? m : scp[m];
    if (!fn) return false;
    switch (vargc) {
    case 1: fn(vargv[0]); break;
    case 2: fn(vargv[0], vargv[1]); break;
    case 3: fn(vargv[0], vargv[1], vargv[2]); break;
    case 4: fn(vargv[0], vargv[1], vargv[2], vargv[3]); break;
    default: fn(); break;
    }
    return true;
  }

  function _start_(m, ...) {
    local fn = func = (typeof(m) == SS_CLOSURE) ? m : scp[m];
    if (!fn) return false;
    arglist.clear();
    for (local l = 0; l < vargc; l++) arglist + vargv[l];
    if (thread == currentthread()) {
      nextfunc = func;
    } else {
      if (thread) { _stop_(); }
      thread = newthread();
      thread.call(_run_, this, fn, arglist);
    }
    return true;
  }

  function _starta_(m, vargs) {
    local fn = func = (typeof(m) == SS_CLOSURE) ? m : scp[m];
    if (!fn) return false;
    arglist.clear();
    arglist.extend(vargs);
    if (thread == currentthread()) {
      nextfunc = func;
    } else {
      if (thread) { _stop_(); }
      thread = newthread();
      thread.call(_run_, this, fn, arglist);
    }
    return true;
  }

  function _push_(m, ...) {
    local fn = func = (typeof(m) == SS_CLOSURE) ? m : scp[m];
    if (!fn) return false;
    arglist.clear();
    for (local l = 0; l < vargc; l++) arglist + vargv[l];
    if (!thread) {
      thread = newthread();
      thread.call(_run_, this, fn, arglist);
    } else {
      if (threadstack) {
        threadstack + thread;
      } else {
        threadstack = [thread];
      }
      thread = newthread();
      thread.call(_run2_, this, fn, arglist);
    }
    return true;
  }

  function _run_(func, argv) {
    running = true;
    for (;;) {
      interruptlabel = null;
      try {
        switch (length(argv)) {
        case 1: func(argv[0]); break;
        case 2: func(argv[0], argv[1]); break;
        case 3: func(argv[0], argv[1], argv[2]); break;
        case 4: func(argv[0], argv[1], argv[2], argv[3]); break;
        default: func(); break;
        }
      } catch (id) {
        if (id != -1) {
          running = false;
          thread = null;
          printf("An exception occured in %S. func=%S.\n", this, func ? func.getName() : null);
          func = null;
          throw id;
        }
      }
      if (!nextfunc) {
        running = false;
        func = null;
        thread = null;
        return;
      }
      func = nextfunc;
      argv = arglist;
      nextfunc = null;
    }
  }

  function _run2_(func, argv) {
    try {
      switch (length(argv)) {
      case 1: func(argv[0]); break;
      case 2: func(argv[0], argv[1]); break;
      case 3: func(argv[0], argv[1], argv[2]); break;
      case 4: func(argv[0], argv[1], argv[2], argv[3]); break;
      default: func(); break;
      }
    } catch (id) {
      if (id != -1) {
        printf("An exception occured in %S. func=%S.\n", this, func ? func.getName() : null);
        printexception(id);
      }
    }
    if (threadstack) {
      thread = threadstack.pop();
      if (!length(threadstack)) threadstack = null;
    } else {
      running = false;
      thread = null;
      func = null;
    }
  }

  function _stop_() {
    if (!thread) return;
    nextfunc = null;
    threadstack = null;
    if (interruptlabel) {
      local lbl = interruptlabel;
      interruptlabel = null;
      thread.interruptGoto(lbl);
    } else
    if (thread == currentthread()) {
      throw -1;
    } else {
      thread.wakeupThrow(-1);
    }
  }

  function pass(dt = -1) {
    if (dt >= 0) {
      sleep(dt);
      return dt;
    } else {
      local t = skGetTime();
      suspend();
      return skGetTime() - t;
    }
  }

  function update(dt) {
    if (thread) {
      if (nextfunc) thread.wakeupThrow(-1);
      thread.wakeup(dt);
    }
  }

  function onInterrupt(lbl) {
    interruptlabel = lbl;
  }
}