Camera.sk3d <- null;

with (Light)
{
  sk3d <- null;

  function setDirLight(v) {
    type = 1;
    vx = v.x;
    vy = v.y;
    vz = v.z;
    return this;
  }

  function setPointLight(p, _k1 = 0.0, _k2 = 0.0) {
    type = 2;
    px = p.x;
    py = p.y;
    pz = p.z;
    k1 = _k1;
    k2 = _k2;
    return this;
  }

  function setColor(c, sc, p) {
    color = c;
    scolor = sc;
    power = p;
    return this;
  }
}

try {
  SK3DRenderNode;
} catch (ex) {
  (::["SK3DRenderNode"] <- class {
    parent = null;
    children = null;

    gmat = null;
    gbnd = null;

    mesh = null;
    ptc = null;

    visible = true;
    incamera = 0;
    visiblemask = 0;
    depth = 0;
    depthvolume = 0.0;

    billboard = false;
    billboardbank = 0.0;

    visiblemask = -1;

    static function cull(a, cam, visiblemask, outa) {
      foreach (n in a) {
        if (!n) continue;
        if (n.incamera = cam.isInside(n.gbnd)) {
          n.depth = cam.getDistance(n.gbnd);
          if (n.visible && (visiblemask & n.visiblemask)) {
            outa + n;
          }
        } else {
          n.depth = 9999.9;
        }
        local ca = n.children;
        if (ca) {
          SK3DRenderNode.cull(ca, cam, visiblemask, outa);
        }
      }
    }
  }).setName("SK3DRenderNode");
}

local tf = Transform();

class SK3DObject extends SK3DRenderNode
{
  name = "";

  scn = null;

  parentbone = null;

  bones = null;
  appendbones = null;
  reference = null;
  lock = false;
  lockscp = false;

  groups = null;
  groupparent = null;

  materials = null;

  res = null;

  priolv = 3;
  alive = true;
  killtime = -1;
  autokill = false;
  activelv = 0;
  accumdt = 0;
  animating = false;
  panimating = false;
  timescale = 100;

  srttf = null;
  modtf = null;
  tflayers = null;
  pos = null;
  scale = null;
  rot = null;
  pivot = null;
  mat = null;

  bnd = null;

  matdirty = true;

  drawedge = false;
  dropshadow = false;

  sortscale = -1.0;
  sortoffset = 0.0;
  sortval = 0;
  layer = 0;

  shapetarget = null;
  motion = null;
  lastmotion = null;
  setmotion = null;
  animstat = null;

  shapemotion = null;

  scprunner = null;
  modifiers = null;

  sounds = null;

  params = null;
  userpointer = null;

  b3body = null;
  enablepbone = false;
  mutepbone = false;

  sk3dentity = null;
  selectorid = 0;

  cameraproj = null;
  focusz = 10.0;

  constructor(src = null) {
    srttf = Transform();
    tflayers = [srttf];
    pos = Vector3D();
    scale = Vector3D(1.0);
    rot = Quaternion();
    mat = Matrix();
    gmat = Matrix();
    bnd = Rect3D();
    gbnd = Rect3D();
    if (src) setSource(src);
  }

  function _nexti(itr) {
    return !itr ? 1 : null;
  }

  function _get(i) {
    if (i == 1) {
      return this;
    } else {
      return undefined;
    }
  }

  function setSource(src) {
    if (typeof(src) == SS_STRING) {
      local r = res ? (res.getResource(src)) : (::getResource(src));
      if (!r) throw Exception("source path not found : " + src);
      src = r;
    }
    if (src instanceof Resource) {
      res = src;
      local name = src.name;
      if (name.endsWith(".pm")) {
        src = ::getPolygonMesh(src);
      } else
      if (name.endsWith(".ptd")) {
        src = ::getParticleEffect(src);
      } else {
        src = src.getContent();
      }
    }
    if (src instanceof ParticleEffect) {
      setParticle(src);
    } else
    if (src instanceof PolygonMesh) {
      setPolygonMesh(src);
    } else
    if (src instanceof SK3) {
      setSK3(src);
    }
  }

  function setSK3(sk3) {

    local mot = sk3["model"];
    if (mot) {
      local rootnum = 0;
      foreach (parts in mot) {
        if (!parts["parentname"])++rootnum;
      }
      if (!rootnum) throw Exception("no root model");
      local ptable = #{};
      foreach (name, parts in mot) {
        if (name in ptable) continue;
        ptable[name] <- setSK3Parts(rootnum > 1 ? this : null, sk3.res || ::resroot, mot, name, ptable);
      }
      Table.clear(ptable);
    }

    local scp;
    if (scp = sk3["script"]) {
      local clsstr = sk3.scriptclass || "SK3DScriptRunner";
      local cls = getroottable()[clsstr];
      if (!cls) throw Exception("sk3 class " + clsstr + " not found.");
      scprunner = cls(sk3.clonescp ? clone scp : scp);
      scprunner.setSK3DObject(this);
      if ("setup" in scprunner) scprunner._exec_("setup");
    }

    params = sk3.params;
    if (sk3.bnd) {
      local b = sk3.bnd;
      bnd.set(b[0], b[1], b[2], b[3], b[4], b[5]);
    } else {
      foreach (co in children) _growbnd(co);
    }
    materials = null;
  }

  function _growbnd(o) {
    o.runMatrix(true);
    bnd << (bnd | o.bnd);
    foreach (co in o.children) _growbnd(co);
  }

  function setSK3Parts(root, r, mot, name, ptable) {
    local parts = mot[name];
    local pp = parts["parentname"] || null;
    local sk3d = null;
    if (!pp && !root) {
      sk3d = this;
      sk3d.res = res;
    } else {
      sk3d = SK3DObject();
      sk3d.res = res;
    }
    sk3d.name = name;
    local motion = null;
    if (parts["mot"]) {
      motion = getMotionData(res.getResource(parts.mot));
    }
    if (parts["pm"]) {
      local r = res.getResource(parts.pm);
      if (!r) throw Exception(sprintf("pm not found : %S %S", res ? res.path : "", parts.pm));
      local pm = ::getPolygonMesh(r);
      if (motion) pm.motion = motion;
      sk3d.setPolygonMesh(pm);
    } else
    if (parts["ptc"]) {
      local p = ::getParticleEffect(res.getResource(parts.ptc));
      sk3d.setParticle(p);
    }

    local pose = parts["pose"];
    if (pose) {
      sk3d.pos(pose[0], pose[1], pose[2]);
      sk3d.scale(pose[3], pose[4], pose[5]);
      sk3d.rot(pose[6], pose[7], pose[8], pose[9]);
    }
    local pv = parts["pivot"];
    if (pv) {
      sk3d.setPivot(Transform([pv[0], pv[1], pv[2], 1, 1, 1, 0, 0, 0, 1]));
    }
    if (!pp) {
      if (root) {
        root.addChild(sk3d);
        root.addGroup(sk3d);
      }
    } else {
      if (pp in ptable) {
        ptable[pp].addChild(sk3d);
      } else {
        if (!mot[pp]) throw Exception("non existing parts[" + pp + "] referenced by " + name);
        local ppo = setSK3Parts(root, r, mot, pp, ptable);
        ptable[pp] <- ppo;
        ppo.addChild(sk3d, "bone" in parts ? parts.bone : null);
      }
    }
    if (parts["shadowbones"]) {
      local sp = ptable[parts.shadowbones];
      if (sp) sk3d.shadowBonesTo(sp);
    }
    if (parts["group"]) {
      local gp = ptable[parts.group];
      if (gp) gp.addGroup(sk3d);
    }
    if (parts["bnd"]) {
      sk3d.bnd.set(parts.bnd);
    }

    sk3d.lock = parts["lock"] || false;

    return sk3d;
  }

  function setParticle(p) {
    ptc = p;
    p.setSK3DObject(this);
    layer = p.layer;
    updateSortOffset();
    materials = null;
  }

  function startParticle(_autokill = true) {
    if (ptc) {
      autokill = _autokill;
      ptc.start();
    }
  }

  function setPolygonMesh(m) {
    mesh = m;
    if (m) {
      motion = lastmotion = m.motion;
      bnd << m.bnd;
      m.setEdge(drawedge);
    } else {
      motion = lastmotion = null;
      visiblemask = 0;
    }
    if (motion) {

      createBones();
      if (mesh) {
        assignBonesToPolygonMesh(mesh);
        if (!animstat) animstat = AnimationState();
        animstat.set(0.0, 0.0, 1.0, false);
        updateMotion(0);
      }
    } else {
      bones = null;
    }
    updateSortOffset();
    materials = null;
  }

  function setMotion(mot) {
    if (motion) {
      if (motion != mot) {
        setmotion = mot;
      } else {
        setmotion = null;
      }
    } else {
      motion = mot;
      createBones();
      if (mesh) assignBonesToPolygonMesh(mesh);
      if (!animstat) animstat = AnimationState();
      animstat.set(0.0, 0.0, 1.0, false);
      updateMotion(0);
    }
  }

  function findBone(name) {
    if (typeof(name) == SS_INTEGER) {
      foreach (b in bones) if (b.parts.id == name) return b;
    } else {
      foreach (b in bones) if (b.name == name) return b;
    }
    return null;
  }

  function createBones() {
    bones = array(length(motion.parts));
    foreach (i, p in motion.parts) {
      local b = Bone();
      b.name = p.name;
      b.parts = p;
      b.invbindpose = p.invbindpose;
      b.lastparts = p;
      b.mat = Matrix();
      if (p.parentid >= 0) {
        for (local j = 0; j < i; j++) {
          if (bones[j].parts.id == p.parentid) { b.parentbone = bones[j]; break; }
        }
        if (!b.parentbone) {
          throw Exception(sprintf("bone[id=%d,name=%S,parentid=%d] parent not found.", p.id, p.name, p.parentid));
        }
      }
      bones[i] = b;
    }
  }

  function assignBonesToPolygonMesh(m) {
    local wn = m.wmapname;
    if (!wn) return;
    local bones = array(length(wn));
    foreach (l, n in wn) {
      local j = findBone(n);
      bones[l] = j;
    }
    if (m.bones) m.bones.resize(0);
    m.bones = bones;
  }

  function shadowBonesTo(src) {
    local oldb = bones;
    bones = src.bones;
    appendbones = [];

    if (motion && src.motion) {
      bones = clone bones;
      local srcmot = src.motion;
      foreach (p in motion.parts) {
        if (p.name in srcmot.partsmap) continue;
        local b = Bone();
        b.name = p.name;
        b.parts = p;
        b.invbindpose = p.invbindpose;
        b.lastparts = p;
        b.mat = Matrix();
        b.parentbone = p.parentid < 0 ? null : findBone(p.parentid);
        bones + b;
        appendbones + b;
      }
    }
    if (length(appendbones) == 0) {
      motion = null;
    }
    assignBonesToPolygonMesh(mesh);

  }

  function countObjects(findChildren = true) {
    local count = 1;
    if (!findChildren) return count;
    foreach (c in children) count += c.countObjects();
    return count;
  }

  function countPolygons(findChildren = true) {
    local count = 0;

    foreach (face in mesh["face"]) {
      count += (face.len - face.offs);
    }
    count /= 3;
    if (!findChildren) return count;

    foreach (c in children) count += c.countPolygons();
    return count;
  }

  function addedToScene(s) {
    scn = s;
    if (!s.disablesimulation) {
      enablePhysicalBones();
    }
    update(0, true);
    foreach (c in children) {
      c.addedToScene(s);
    }
    if (dropshadow) scn.addDropShadowObject(this);
  }

  function removedFromScene(s) {
    disablePhysicalBones();
    foreach (c in children) {
      c.removedFromScene(s);
    }
    if (dropshadow) s.removeDropShadowObject(this);
  }

  function kill(dt = 0) {
    if (dt > 0) {
      killtime = dt;
    } else {
      alive = false;
    }
  }

  function addChild(sk3d, boneid = null) {
    sk3d.parent = this;
    if (boneid != null) {
      if (boneid instanceof Bone) {
        if (bones && bones.indexOf(boneid) >= 0) sk3d.parentbone = boneid;
      } else {
        sk3d.parentbone = findBone(boneid);
      }
    }
    if (!children) children = [sk3d];
    else children + sk3d;
    sk3d.setLayer(layer);
    if (scn) {
      sk3d.addedToScene(scn);
    }
  }

  function removeChild(sk3d) {
    if (sk3d && sk3d.parent == this) {
      foreach (i, v in children) {
        if (sk3d == v) {
          delete children[i];
          if (scn) sk3d.removedFromScene(scn);
          return;
        }
      }
    }
  }

  function finishChildren(force = false) {
    foreach (i, v in children) {
      if (v.lock) continue;
      if (!force && m.lockscp) continue;
      if (!v.startScript("end")) {
        v.kill();
      }
    }
  }

  function clearChildren() {
    if (children) {
      foreach (i, v in children) {
        if (scn) v.removedFromScene(scn);
      }
      children.clear();
    }
  }

  function removeFromParent() {
    if (parent) {
      parent.removeChild(this);
    } else
    if (scn) {
      scn.removeObject(this);
    }
  }

  function addGroup(sk3d) {
    if (sk3d.groupparent) {
      sk3d.groupparent.removeGroup(sk3d);
    }
    if (groups) {
      groups + sk3d;
    } else {
      groups = [sk3d];
    }
    sk3d.groupparent = this;
    materials = null;
  }

  function removeGroup(sk3d) {
    if (groups) {
      groups.removeValue(sk3d);
      sk3d.groupparent = null;
    }
    materials = null;
  }

  function getMaterials() {
    if (!materials) {
      materials = [];
      foreach (f in mesh["face"]) { materials + f.m; }
      foreach (f in ptc["groups"]) { materials + f.m; }
      foreach (go in groups) {
        foreach (f in go.mesh["face"]) { materials + f.m; }
        foreach (f in go.ptc["groups"]) { materials + f.m; }
      }
    }
    return materials;
  }

  function findByName(n) {
    if (name == n) return this;
    foreach (o in children) {
      local ret = o.findByName(n);
      if (ret) return ret;
    }
    return null;
  }

  function addToRenderList(cam, visiblemask, sorttable) {
    if (isVisible()) {
      sorttable.append(sortoffset + (depth - depthvolume) * sortscale, this);
    }
  }

  function addShadowMapVolume(smap) {
    smap.addVolume(gbnd);
  }

  function update(dt, pmatdirty = true) {
    if (timescale != 100) {
      dt = (timescale * dt) / 100;
    }
    animating = !!modifiers;
    if (killtime >= 0 && (killtime -= dt) <= 0) {
      return alive = false;
    }
    if (scprunner["running"]) {
      scprunner.update(dt);
    }
    if (modtf) modtf.clear();
    foreach (mod in modifiers) {
      if (!mod.modify(this, dt)) {
        if (length(modifiers) == 1) { modifiers = null; }
        removei;
      }
    }
    local matchanged = runMatrix(pmatdirty);
    updateMotion(dt, matchanged);

    if (ptc) {
      if (ptc.update(dt)) {
        animating = true;
        (gbnd << (bnd << ptc.bnd));
      } else {
        if (autokill) {
          ptc = null;
          alive = false;
        } else {
          (gbnd << (bnd << ptc.bnd));
        }
      }
    }
    animating |= panimating;
    panimating = false;
    return alive;
  }

  function runMatrix(pmatdirty = true) {
    local ret = false;
    if (matdirty) {
      srttf.setSRT(pos, scale, rot);
      mat.integrate(tflayers);
      matdirty = false;
      pmatdirty = true;
    }
    if (pmatdirty || (parentbone && parent.animating)) {
      gmat.set(mat);
      if (parentbone) parentbone.mat.mult34(gmat, gmat);
      if (parent) parent.gmat.mult34(gmat, gmat);
      if (b3body) b3body.setTransform(gmat);
      ret = animating = true;
      (gbnd << bnd).transform(gmat);
    }
    return ret;
  }

  function updateMatrix() {
    if (parent) parent.updateMatrix();
    if (matdirty) {
      srttf.setSRT(pos, scale, rot);
      mat.integrate(tflayers);
      gmat.set(mat);
      if (parentbone) parentbone.mat.mult34(gmat, gmat);
      if (parent) parent.gmat.mult34(gmat, gmat);
      if (b3body) b3body.setTransform(gmat);
      (gbnd << bnd).transform(gmat);
      panimating = true;
      matdirty = false;
      foreach (c in children) c.matdirty = true;
    } else
    if (animating) {
      foreach (c in children) {
        if (c.parentbone) c.matdirty = true;
      }
    }
  }

  function updateMotion(dt, matchanged = false) {

    if (!animstat || (!animstat.update(dt) && !appendbones)) {
      if (enablepbone) {
        skBonePoseToPhysicalList(gmat, appendbones ? appendbones : bones, true);
      }
      return;
    }

    if (animstat.fadestopped && motion != lastmotion) {
      foreach (j in bones) j.lastparts = j.parts;
      lastmotion = motion;
    }

    skCalculateBonePoses(appendbones ? appendbones : bones, animstat, gmat, mutepbone || (scn && scn.disablesimulation));

    local sl;
    if (sl = (mesh && mesh.shapeline)) {
      sl.evaluate(animstat, mesh.shapetarget);
    }
    animating = true;
  }

  function calcBonePoses() {
    skCalculateBonePoses(appendbones ? appendbones : bones, animstat, gmat, mutepbone || (scn && scn.disablesimulation));
  }

  function setPivot(pv) {
    if (pivot) tflayers.removeValue(pivot);
    pivot = pv;
    if (pv) tflayers + pv;
  }

  function getModTransform() {
    return modtf || (tflayers[tflayers.indexOf(srttf) + 1] <- (modtf = Transform()));
  }

  function execScript(fname) {
    return scprunner ? scprunner._exec_(fname) : false;
  }

  function startScript(fname) {
    return scprunner ? scprunner._start_(fname) : false;
  }

  function startScriptv(fname, ...) {
    return scprunner ? scprunner._starta_(fname, varguments()) : false;
  }

  function pushScript(fname) {
    return scprunner ? scprunner._push_(fname) : false;
  }

  function stopScript() {
    if (scprunner) scprunner._stop_();
  }

  function setScript(r) {

    res = r;
    local sk3 = r.getContent();
    local clsstr = sk3.scriptclass || "SK3DScriptRunner";
    local cls = getroottable()[clsstr];
    scprunner = cls(sk3.clonescp ? clone sk3.script : sk3.script);
    scprunner.setSK3DObject(this);
    if ("setup" in scprunner) scprunner._exec_("setup");
  }

  function anime(st, en = null, spd = null, lp = false, ft = 0.0) {

    if (!animstat) {
      animstat = AnimationState();
    }
    if (en == null) {
      en = st;
      spd = 1.0;
    } else
    if (spd == null) {
      ft = en;
      en = st;
      spd = 1.0;
    }
    if (!ft || animstat.fadew > 0.9) {
      if (setmotion) {
        motion = setmotion;
        setmotion = null;
        foreach (b in bones) b.parts = motion.partsmap[b.name];
      }
      animstat.set(st, en, spd, lp);
    } else {
      if (setmotion) {
        lastmotion = motion;
        motion = setmotion;
        setmotion = null;
        foreach (b in bones) {
          b.lastparts = b.parts;
          b.parts = motion.partsmap[b.name];
        }
      } else
      if (lastmotion != motion) {
        lastmotion = motion;
        foreach (b in bones) b.lastparts = b.parts;
      }
      animstat.fade(st, en, spd, lp, ft);
    }
  }

  function morph(t, time = 0) {
    if (mesh) {
      local _t = typeof(t) == SS_STRING ? mesh.shapesets[t] : t;
      if (mesh.shapetarget) {
        local ss1 = mesh.shapetarget;
        local ss2 = ShapeState();
        ss2.shapekeys = ss1.shapekeys;
        ss2.assign(_t);
        if (time) {
          local dst = mesh.shapetarget = clone ss1;
          addModifier(MorphModifier(ss1, ss2, dst, time));
        } else {
          mesh.shapetarget = ss2;
        }
      }
      if (_t["uvscroll"]) {
        foreach (i, v in _t["uvscroll"]) {
          mesh.face[i].m.uvmat = v ? Matrix.fromTranslate(v[0], v[1], 0.0) : null;
        }
      } else {
        foreach (f in mesh.face) {
          f.m.uvmat = null;
        }
      }
      panimating = true;
    }
  }

  function setTimeScale(s) {
    timescale = s;
    foreach (c in children) {
      c.setTimeScale(s);
    }
  }

  function addModifier(m) {
    if (modifiers) {
      local o;
      if (o = m.order) {
        foreach (i, v in modifiers) {
          if (o == v.order) {

            v.interrupt(this);
            modifiers[i] = m;
            m.start(this);
            return;
          } else
          if (o > v.order) {
            modifiers[i] <- m;
            m.start(this);
            return;
          }
        }
      }
      m.start(this);
      modifiers + m;
    } else {
      m.start(this);
      modifiers = [m];
    }
  }

  function removeModifierOrder(o) {
    foreach (i, v in modifiers) {
      if (v.order == o) {
        v.interrupt(this);
        return delete modifiers[i];
      }
    }
  }

  function removeModifierClass(c) {
    foreach (i, v in modifiers) {
      if (v instanceof c) {
        v.interrupt(this);
        return delete modifiers[i];
      }
    }
  }

  function getModifierOf(c) {
    foreach (i, v in modifiers) {
      if (v instanceof c) {
        return v;
      }
    }
  }

  function clearModifiers() {
    if (modifiers) {
      foreach (v in modifiers) {
        v.interrupt();
      }
      modifiers.resize(0);
      modifiers = null;
    }
  }

  function setVisible(b) {
    visible = b;
  }

  function isVisible() {
    if (groupparent) {
      return visible && groupparent.isVisible();
    } else {
      return visible;
    }
  }

  function setBlend(b, changedepth = 1) {
    foreach (m in getMaterials()) {
      m.blend = b;
      if (changedepth) {
        if (b) {
          m.depthtest = SK_LESS; m.depthmask = 0;
        } else {
          m.depthtest = SK_LESS; m.depthmask = 1;
        }
      }
    }
    updateSortOffset();
    foreach (go in groups) {
      go.updateSortOffset();
    }
  }

  function setEdge(b) {
    drawedge = b;
    if (mesh) {
      mesh.setEdge(b);
    }
    foreach (go in groups) {
      if (go.mesh) {
        go.mesh.setEdge(b);
      }
    }
  }

  function setDropShadow(b) {
    b = !!b;
    if (dropshadow != b) {
      dropshadow = b;
      if (scn) {
        if (b) scn.addDropShadowObject(this);
        else scn.removeDropShadowObject(this);
      }
    }
  }

  function setLayer(l) {
    layer = l;
    updateSortOffset();
    foreach (c in children) {
      c.setLayer(l);
    }
  }

  function updateSortOffset() {
    local b = false;
    visiblemask = 0;
    foreach (f in mesh ? mesh.face : ptc ? ptc.groups : null) {
      if (!f.m.depthmask) { b = true; }
      visiblemask |= f.m.visiblemask;
    }
    if (b) {
      sortoffset = layer * 1000.0 + 1999.0;
      sortscale = -1.0;
    } else {
      sortoffset = layer * 1000.0 + 1.0;
      sortscale = 1.0;
    }
  }

  function isCamera() {
    return !!cameraproj;
  }

  function toCamera(cam, vpw, vph) {
    cam[1] = gmat.transpose33();
    if (cameraproj) {
      cameraproj.setProjectionMatrixTo(cam, vpw, vph);
    }
  }

  function setSK3DEntity(e) {
    sk3dentity = e;
    if (e instanceof ::SK3DCameraEntity) {
      cameraproj = clone e.proj;
      focusz = Vector3D(e.lookat[0], e.lookat[1], e.lookat[2]).hypot(Vector3D(e.pos[0], e.pos[1], e.pos[2]));
    } else {
      cameraproj = null;
    }
  }

  function lookat(eye, to) {
    local hpb = #[0, 0, 0];
    local vec = to - eye;
    SK3DCameraEntity.aimHP(vec.normalize(), hpb);
    rot << Quaternion.fromHPB(hpb[0], hpb[1], hpb[2]);
    pos << eye;
    focusz = vec.length();
    matdirty = true;
  }

  function moveToEntity(e, time, easing = null) {
    local m = CameraMoveModifier();
    m.set(this, e, time, easing);
    addModifier(m);
  }

  function disablePhysicalBones() {
    if (enablepbone) {
      if (scn) {
        local b3world = scn.b3world;
        local _bones = appendbones ? appendbones : bones;
        foreach (b in _bones) {
          if (b3world && b.rigidbody) {
            b3world.removeBody(b.rigidbody);
          }
          b.rbconstraints = null;
          b.rigidbody = null;
          b.dynamic = 0;
          b.r2bmat = null;
          b.b2rmat = null;
          b.deflpos = null;
        }
        scn.removePhysicalBoneObject(this);
      }
      enablepbone = false;
      mutepbone = false;
      animstat.animating = true;
      updateMotion(0);
    }
  }

  function mutePhysicalBones() {
    if (enablepbone && !mutepbone) {
      if (scn) {
        local _bones = appendbones ? appendbones : bones;
        foreach (b in _bones) {
          if (b.rigidbody) {
            b.rigidbody.mute(true);
          }
          b.dynamic = 0;
        }
        scn.removePhysicalBoneObject(this);
      }
      mutepbone = true;
    }
  }

  function resetPhysicalBones() {
    mutePhysicalBones();
    enableJointPhys();
  }

  function enablePhysicalBones() {
    if (enablepbone && !mutepbone) return;
    if (!mesh || !mesh.rbdataset) return;
    if (!scn || !scn.getB3World()) return;
    enablepbone = true;
    mutepbone = false;
    local rbdataset = mesh.rbdataset;

    local _pbones = null;

    updateMatrix();

    local b3world = scn.b3world;
    local created = false;
    local gscale = gmat.getScale();
    local _bones = appendbones ? appendbones : bones;

    foreach (b in _bones) {
      local data = rbdataset[b.name];
      if (!data || !data.shapes) continue;
      if (!b.rigidbody) {
        b.rigidbody = data.createRigidBody(this, b, gscale);
        b3world.addBody(b.rigidbody);
        created = true;
        b.rbrecovercount = 2;
      } else {
        b.rigidbody.mute(false);
        b.rbrecovercount = 4;
      }
      b.dynamic = data.dynamic;

      if (b.dynamic) {
        if (_pbones) _pbones + b; else _pbones = [b];
      }
    }

    if (created) {
      local vec1 = Vector3D();
      local vec2 = Vector3D();
      local frame1 = Matrix();
      local frame2 = Matrix();
      foreach (b in _bones) {

        local data = rbdataset[b.name];
        if (!b.rigidbody || !data) continue;
        local consdatas = data.constraints;
        if (consdatas && length(consdatas) > 0) {
          b.rbconstraints = [];
          foreach (consdata in consdatas) {

            local pairbonename = consdata.pairbonename;
            local pairbone;
            if (pairbonename == null || pairbonename == "") {
              pairbone = b.parentbone;
              if (!pairbone) pairbone = parentbone;
            } else {
              pairbone = findBone(pairbonename);
            }

            if (!pairbone || !pairbone.rigidbody || (!b.dynamic && !pairbone.dynamic)) {
              continue;
            }

            local gbmat = gmat.mult34(b.mat);
            if (b.mat.abs() < 0.0) gbmat.scale(1.0, 1.0, -1.0);
            frame1 << pairbone.rigidbody.getTransform().invert34().mult34(gbmat);
            frame2 << b.rigidbody.getTransform().invert34().mult34(gbmat);

            local cons = consdata.createConstraint(pairbone.rigidbody, b.rigidbody, frame1, frame2);
            if (consdata.isDeflpos()) {
              gbmat << pairbone.mat.invert34().mult34(b.mat);
              b.deflpos = gbmat.getTranslation();
            }
            b.rbconstraints + cons;
            b3world.addConstraint(cons);
          }
        }
      }

      if (_pbones) {
        local g = SK3DScene.PhysicalBoneGroup(this, _pbones);
        scn.addPhysicalBoneGroup(g);
      }
    }
  }
}

class SK3
{
  res = null;

  model = null;
  objectclass = null;
  scriptclass = null;
  script = null;
  bnd = null;
  params = null;

  clonescp = false;

  function setup() {
    foreach (v in script) {
      if (typeof(v) != SS_CLOSURE) {
        clonescp = true;
      } else {
        v.paramcheck(false);
      }
    }
  }
}

local _pos = Vector3D(), _scale = Vector3D(), _rot = Quaternion();

function generateSK3DObject(gen, parentsk3d, scn, script = null) {
  if (!("view" in gen)) return null;
  local r;
  if (parentsk3d["res"]) {
    r = parentsk3d.res.getResource(gen.view);
  } else {
    r = ::getResource(gen.view);
  }
  if (!r) return null;

  local v;
  if (v = gen["pos"]) { _pos(v); } else { _pos(0.0); }
  if (v = gen["scale"]) { _scale(v); } else { _scale(1.0); }
  if (v = gen["hpb"]) { _rot.setHPB(v[0] * Math.DTOR, v[1] * Math.DTOR, v[2] * Math.DTOR); } else { _rot(0.0, 0.0, 0.0, 1.0); }

  local sk3d = SK3DObject(r);
  if ("name" in gen) sk3d.name = gen.name;
  sk3d.pos << _pos;
  sk3d.scale << _scale;
  sk3d.rot << _rot;

  if ("billboard" in gen) { sk3d.billboard = gen.billboard; }
  if ("billboardbank" in gen) { sk3d.billboardbank = gen.billboardbank * Math.DTOR; }
  if ("depthoffset" in gen) { sk3d.depthoffset = gen.depthoffset; }

  if ("lock" in gen) { sk3d.lock = !!gen.lock; }

  if (parentsk3d) {
    if (gen["connect"]) {
      parentsk3d.addChild(sk3d, "parts" in gen ? gen.parts : null);
      if (gen["shadowbones"]) {
        sk3d.shadowBonesTo(parentsk3d);
      }
      if (gen["group"]) {
        if (parentsk3d.groupparent) {
          parentsk3d.groupparent.addGroup(sk3d);
        } else {
          parentsk3d.addGroup(sk3d);
        }
      }
      sk3d.updateMatrix();
    } else {
      sk3d.updateMatrix();
      local m = sk3d.mat;
      local parts = gen["parts"];
      if (parts != undefined) {
        local b = parentsk3d.findBone(parts);
        if (b) b.mat.mult34(m, m);
      }
      parentsk3d.gmat.mult34(m, m);
      m.getTranslation(sk3d.pos);
      m.getScale(sk3d.scale);
      m.getRotation(sk3d.rot);
      if (scn) {
        scn.addObject(sk3d);
      }
      sk3d.matdirty = true;
    }
    sk3d.reference = weakref(parentsk3d);
  } else {
    sk3d.matdirty = true;
    sk3d.updateMatrix();
    if (scn) {
      scn.addObject(sk3d);
    }
  }

  local scp = script || gen["script"];
  if (scp) {
    sk3d.startScript(scp);
  } else {
    if (!sk3d.startScript("start")) {
      if (sk3d.ptc && (gen["autostart"] == undefined || gen["autostart"])) {
        sk3d.startParticle();
      }
    }
  }

  return sk3d;
}