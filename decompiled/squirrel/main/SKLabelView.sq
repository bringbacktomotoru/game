import SKViewPropertyID;

class SKLabelView extends SKView
{
  icontype = "ttf";
  static deffontattr = FontAttribute(Fonts.ui, 12, 0xffffffff, SK_FONT_BOLD);

  fontattr = null;
  resetattr = false;
  textbox = null;
  style = 0;
  text = "";

  constructor(s = "", a = null) {
    fontattr = a ? a : deffontattr;
    textbox = TextBox(fontattr, s);
    text = s;
    enabled = false;
  }

  function getText() {
    return text;
  }

  function setText(s) {
    textbox.setText(s);
    text = s;
    repaint();
  }

  function appendText(s) {

    textbox.setText(text = text + s);
    repaint();
  }

  function updateLayout() {
    textbox.width = bnd.w | 0;
    textbox.height = bnd.h | 0;
    repaint();
  }

  function render() {
    if (resetattr) {
      textbox.setAttribute(fontattr);
      resetattr = false;
    }
    skDrawTextBox(textbox);
  }

  function setFontAttribute(a) {
    fontattr = a;
    resetattr = true;
    repaint();
  }

  function setColor(c) {
    fontattr.color = c;
    resetattr = true;
    repaint();
  }

  function getProperties() {
    return #[
    (SKVP[NAME]),
    (SKVP[VISIBLE]),
    (SKVP[SIZE_STATIC]),
    (SKVP[PIVOT]),
    (SKVP[POSITION]),
    (SKVP[SCALE]),
    (SKVP[ROTATION]),
    (SKVP[LABEL]),
    (SKVP[TEXTCOLOR]),
    (SKVP[FONT]),
    (SKVP[TEXTALIGN]),
    (SKVP[WRAPTEXT]),
    (SKVP[USERDATA]),
    ];
  }

  function getParam(pid) {
    switch (pid) {
    case LABEL: return text;
    case FONT: return {
        fontname = fontattr.font.name, fontsize = fontattr.size, fontcolor = fontattr.color, fontflags = fontattr.flags,
        strokecolor = fontattr.strokecolor, strokesize = fontattr.strokesize, strokex = fontattr.strokex, strokey = fontattr.strokey,
      };
    case TEXTCOLOR: return (textbox.colormask & 255) | (fontattr.color & 0xffffff00);
    case WRAPTEXT: return textbox.wrapmode;
    case TEXTALIGN: return textbox.align;
    default: return super.getParam(pid);
    }
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case LABEL:
      {
        setText(p0);
      }
      break;
    case FONT:
      {
        local c0 = fontattr.color;
        local fa = FontAttribute(::Fonts[p0.fontname], p0.fontsize, c0, p0.fontflags);
        fa.strokecolor = p0["strokecolor"] || 255;
        fa.strokesize = p0["strokesize"] || 0;
        fa.strokex = p0["strokex"] || 0;
        fa.strokey = p0["strokey"] || 0;
        setFontAttribute(fa);
      }
      break;
    case TEXTCOLOR:
      local c = Math.lerpcolor(p0, p1, w);
      local a = (c & 255);
      textbox.colormask = (a << 24) | (a << 16) | (a << 8) | a;
      fontattr.color = c | 255;
      resetattr = true; repaint();
      break;
    case WRAPTEXT:
      textbox.wrapmode = p0; repaint();
      break;
    case TEXTALIGN:
      textbox.align = p0; repaint();
      break;

    default:
      super.setParam(pid, p0, p1, w);
      break;
    }
  }
}