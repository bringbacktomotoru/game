with Serializable() {

  class RoomEditData {
    static SerialVersion = 1;

    static JOIN_TOP = 1;
    static JOIN_BOTTOM = 2;
    static JOIN_LEFT = 3;
    static JOIN_RIGHT = 4;

    uid = -1;
    room_id = -1;

    exp = -1;
    level = -1;

    furniture_layouts = null;

    furniture_amount_table = null;
    furniture_type_list = null;
    useable_furniture_type_list = null;

    panel_mission_id = null;
    gmoney = null;
    tap_hapiness = null;

    constructor() {
    }

    static function create(room_id) {
      local data = ::RoomEditData();

      data.uid = room_id;
      data.room_id = room_id;
      data.furniture_layouts = [];
      data.panel_mission_id = -1;
      data.setLevel(1, 0);
      data.gmoney = 0;
      data.furniture_amount_table = {};
      data.tap_hapiness = 0;
      data.furniture_type_list = [];
      data.useable_furniture_type_list = [];

      return data;
    }

    static function loadWithCreate(loader) {
      local uid = loader.get();
      local room_id = loader.get();
      local data = ::RoomEditData.create(room_id);

      local furniture_num = loader.get();
      if (furniture_num > 0) {
        local layouts = data.furniture_layouts;
        layouts.resize(furniture_num, null);
        foreach (idx, _ in layouts) {
          layouts[idx] = ::FurnitureLayoutData.loadWithCreate(loader);
        }
      }
      data.panel_mission_id = loader.get();

      data.gmoney = loader.get();

      return data;
    }

    function _cloned(that) {
      this.furniture_layouts = [];

      foreach (f in that.furniture_layouts) {
        this.furniture_layouts + clone f;
      }

    }

    function getUID() {
      return this.uid;
    }

    function getRoomID() {
      return this.room_id;
    }

    function getFurnitureLayouts() {
      return this.furniture_layouts;
    }

    function getFurnitureLayoutData(furniture_uid) {
      foreach (f in this.furniture_layouts) {
        if (f.getUID() == furniture_uid) return f;
      }
      return null;
    }

    function getFurnitureLayoutIdx(furniture_uid) {
      foreach (idx, f in furniture_layouts) {
        if (f.uid == furniture_uid) return idx;
      }
      return -1;
    }

    function isContainFurniture(furniture_uid) {
      foreach (f in furniture_layouts) {
        if (f.uid == furniture_uid) return true;
      }
      return false;
    }

    function getRoomSetting() {
      return ::gamesetting.room_settings[this.room_id];
    }

    function getEnableResideMaxNums() {
      return getRoomSetting().getResideMaxNums();
    }

    function getEnableResideNums() {
      return getRoomSetting().getResideNums(this.level);
    }

    function getGameMoney() {
      return this.gmoney;
    }
    function addGameMoney(v) {
      this.gmoney += v;
      local _scene = ::gamesession.getCurrentScene();
      if (_scene instanceof ::SanrioGameScene) {
        local _pmm = _scene.getPanelMissionManager();
        if (v > 0) {
          _pmm.addGM(v);
        } else {
          _pmm.consumeGM(-v);
        }
      }
      this.gmoney = Math.min(this.gmoney, GAMEMONEY_MAX);

      ::gamesession.updateGMValue();
    }
    function setGameMoney(v) {
      this.gmoney = Math.min(v, GAMEMONEY_MAX);
      ::gamesession.updateGMValue();
    }

    function getPanelMissionID() {
      return this.panel_mission_id;
    }
    function getPanelMissionData() {
      return ::gamesession.getUserData().getPanelMissionData(this.panel_mission_id);
    }
    function setPanelMissionID(pmid) {
      this.panel_mission_id = pmid;
    }

    function addFurnitureAmount(furniture_id, furniture_uid, calc_hapiness = true) {
      local _fad = this.furniture_amount_table[furniture_id];
      if (!_fad) {
        _fad = ::FurnitureAmountData(furniture_id);
        this.furniture_amount_table[furniture_id] <- _fad;
      }
      _fad.addFurniture(furniture_uid, calc_hapiness);
      if (calc_hapiness) this.calcTapHapiness();

      _addFurnitureType(furniture_id);

      return _fad.getFurnitureAmount();
    }

    function addFurnitureAmountAtLoad(furniture_id, furniture_uid, calc_hapiness = true) {
      addFurnitureAmount(furniture_id, furniture_uid, calc_hapiness);
      if (this.isContainFurniture(furniture_uid)) {
        local _fad = this.furniture_amount_table[furniture_id];
        _fad.editLayoutFurniture(furniture_uid, true);
      }
    }

    function subFurnitureAmount(fid, fuid) {
      local _fad = this.getFurnitureAmountData(fid) || null;
      if (!_fad || _fad.getFurnitureAmount() == 0) return;
      _fad.removeFurniture(fuid, true);
    }

    function getFurnitureAmount(furniture_id) {
      local _fad = this.furniture_amount_table[furniture_id];
      if (!_fad) return 0;
      return _fad.getFurnitureAmount();
    }

    function getFurnitureAmountTable() {
      return this.furniture_amount_table;
    }

    function getFurnitureAmountData(furniture_id) {
      return this.furniture_amount_table[furniture_id];
    }

    function getRoomFurnitureAmount() {
      local _sum = 0;
      foreach (fad in this.furniture_amount_table) {
        _sum += fad.getFurnitureAmount();
      }
      return _sum;
    }

    function _addFurnitureType(fid) {
      local _fs = ::gamesetting.furniture_settings[fid];
      if (!_fs) return;
      local _fts = _fs.getTypeSetting();
      if (!_fts) return;

      this.furniture_type_list + _fts.getID();
      if (_fts.canUse()) this.useable_furniture_type_list + _fts.getID();
    }

    function getFurnitureTypeList() {
      return this.furniture_type_list;
    }

    function getUseableFurnitureTypeList() {
      return this.useable_furniture_type_list;
    }

    function calcTapHapiness(update = false) {
      local _init_gm = ::gamesetting.game_rule.getInitialTapGM();
      local _val = 0;

      foreach (fad in this.furniture_amount_table) {
        if (update) fad.updateTapGM();
        _val += fad.getTapGM();
      }

      this.tap_hapiness = _init_gm + _val;

      local _scene = ::gamesession.getCurrentScene();
      if (_scene instanceof SanrioGameScene) {
        _scene.getUI().updateHapinessValueInfo();
      }
    }

    function getTapHapiness() {
      return this.tap_hapiness;
    }

    function setExp(val) {
    }

    function setLevel(lv, exp) {
      this.level = lv;
      this.exp = exp;
    }

    function getLevel() {
      return this.level;
    }

    function addExp(val) {
      local room_setting = getRoomSetting();
      local exp_table = ::gamesetting.room_exp_table[room_setting.exp_table_index];

      local lv = this.level;
      local exp = this.exp;
      local is_level_up = false;
      while (exp_table[lv - 1]) {
        local next_exp = exp_table[lv - 1];
        if (exp + val < next_exp) {
          exp += val;
          break;
        }

        val -= next_exp - exp;
        exp = 0;
        lv++;
        is_level_up = true;

        if (val == 0) break;
      }

      setLevel(lv, exp);
      return is_level_up;
    }

    function getExp() {
      return this.exp;
    }
    function getMaxExp() {
      local room_setting = getRoomSetting();
      local exp_table = ::gamesetting.room_exp_table[room_setting.exp_table_index];

      return exp_table[this.level - 1];
    }

    function addFurniture(furniture_layout_data) {
      foreach (f in furniture_layouts) {
        if (f.uid == furniture_layout_data.uid) return;
      }
      this.furniture_layouts + furniture_layout_data;

      local _fd = ::gamesession.getUserData().getFurnitureData(furniture_layout_data.getUID());
      local _fad = this.furniture_amount_table[_fd.getID()];
      if (!_fad) return;
      _fad.editLayoutFurniture(furniture_layout_data.getUID(), true);
    }

    function removeFurniture(furniture_idx) {
      local _fld = delete this.furniture_layouts[furniture_idx];

      local _fd = ::gamesession.getUserData().getFurnitureData(_fld.getUID());
      local _fad = this.furniture_amount_table[_fd.getID()];
      if (!_fad) return;
      _fad.editLayoutFurniture(_fld.getUID(), false);
    }

    function removeFurniture_byUID(furniture_uid) {
      local idx = getFurnitureLayoutIdx(furniture_uid);
      removeFurniture(idx);
    }

    function removeAllFurnitures() {
      local _ud = ::gamesession.getUserData();
      foreach (fld in this.furniture_layouts) {
        local _fd = _ud.getFurnitureData(fld.getUID());
        local _fad = this.furniture_amount_table[_fd.getID()];
        if (!_fad) continue;
        _fad.editLayoutFurniture(_fld.getUID(), false);
      }

      this.furniture_layouts.clear();
    }

    function apply(that) {
      if (this.room_id != that.room_id) {

        return false;
      }

      _applyFurnitureLayouts(this.furniture_layouts, that.furniture_layouts);

      return true;
    }

    function _applyFurnitureLayouts(a, b) {
      foreach (i, e in a) {
        local idx = _getFurnitureIdx(b, e.uid);
        if (idx == -1) {
          removei;
        }
      }

      foreach (e in b) {
        local idx = _getFurnitureIdx(a, e.uid);
        if (idx == -1) {
          local d = ::FurnitureLayoutData.create(e.uid);
          d.apply(e);
          a + d;
        }
        else {
          a[idx].apply(e);
        }
      }
    }

    function _getFurnitureIdx(furniture_layouts, uid) {
      foreach (idx, f in furniture_layouts) {
        if (f.uid == uid) return idx;
      }
      return -1;
    }

    function getRoomParameters() {
      return getRoomSetting().getParameters(this.level);
    }

    function debugPrintFurnitureAmount() {
      println("=== debugPrintFurnitureAmount uid:" + uid + " rid:" + room_id);
      foreach (fad in furniture_amount_table) {
        println("id:" + fad.getID() + " pro:" + fad.getPropertyAmount() + " amount:" + fad.getFurnitureAmount());
      }
    }
  }

}