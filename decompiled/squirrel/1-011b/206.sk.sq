class DiarySetting extends Setting {
  id = null;
  name = null;
  event = null;
  titles = null;
  lbl_titles = null;
  texts = null;
  writer_ids = null;

  reply_key = null;
  reply_text_keys = null;

  contents_conditions = null;
  illust = null;
  nodiary_image = null;
  label_image = null;
  label_angle = 0;

  function loadConfAtServer(t) {
    local setting = DiarySetting();

    foreach (k, v in t) {
      switch (k) {
      case "titles":
      case "texts":
      case "writer_ids":
      case "reply_text_keys":
      case "contents_conditions":
        setting[k] = decodeJSON(v);
        break;
      default:
        setting[k] = v;
      }
    }
    return setting;
  }

  function getTranslateTarget() {
    local trans = [];
    if (name) trans + "name";
    if (texts) trans + "texts";
    if (titles) trans + "titles";
    if (lbl_titles) trans + "lbl_titles"
    return trans;
  }

  function getID() {
    return this.id;
  }

  function getName() {
    return this.name;
  }

  function getNumberingName() {
    local _numbering = getID() % 100;
    if (_numbering == 0) _numbering = ::dict.get("diary_numbering_begin");
    return getName() + ::dict.get("diary_numbering", [_numbering]);
  }

  function getDiaryWriterID(idx = -1) {
    if (this.writer_ids.len() == 1) idx = 0;
    if (idx < 0) {
      local _choiced = ::gamesession.getUserData().getReplyTextKey(this.reply_key);
      idx = getIndexReplyTextKey(_choiced);
    }
    local _chara_id = this.writer_ids[idx];
    return _chara_id;
  }
  function getDiaryWriterName(idx = -1) {
    local _chara_id = getDiaryWriterID(idx);
    local _scs = ::gamesetting.sanrio_chara_settings[_chara_id];
    return _scs.getNickName();
  }
  function getDiaryTextColor(idx = -1) {
    if (this.writer_ids.len() == 1) idx = 0;
    if (idx < 0) {
      local _choiced = ::gamesession.getUserData().getReplyTextKey(this.reply_key);
      idx = getIndexReplyTextKey(_choiced);
    }
    local _chara_id = this.writer_ids[idx];
    local _scs = ::gamesetting.sanrio_chara_settings[_chara_id];
    if (!_scs) return null;

    return _scs.getTextColor();
  }

  function getDiaryTitle(idx = -1, use_lbl_title = false) {
    local _titles = this.titles;
    if (use_lbl_title) {
      _titles = this.lbl_titles ? this.lbl_titles : this.titles;
    }
    if (!_titles || _titles.len() < 1) return "";
    else if (_titles.len() == 1) return _titles[0];

    if (idx < 0) {
      local _choiced = ::gamesession.getUserData().getReplyTextKey(this.reply_key);
      idx = getIndexReplyTextKey(_choiced);
    }
    return _titles[idx];
  }
  function getDiary(idx = -1) {
    if (texts.len() == 1) return this.texts[0];

    if (idx < 0) {
      local _choiced = ::gamesession.getUserData().getReplyTextKey(this.reply_key);
      idx = getIndexReplyTextKey(_choiced);
    }
    return this.texts[idx];
  }
  function getLabelTitles() {
    return this.lbl_titles;
  }

  function getEventPath() {
    local _path = "/talk/" + ::READ_TRANS_FILE + "/" + this.event;
    return _path;
  }

  function getReplyKey() {
    return this.reply_key;
  }
  function getReplyTextKeys() {
    return this.reply_text_keys;
  }
  function getIndexReplyTextKey(key) {
    foreach (idx, textkey in this.reply_text_keys) {
      if (key != textkey) continue;
      return idx;
    }
    return 0;

  }

  function getIllustSprite() {
    local _sp = ::getSprite(this.illust);
    _sp.blend = SK_MIX;
    return _sp;
  }

  function getClearSprite() {
    local _f_path = (this.id / 100 + 1) / 2;
    local _path = "/image/icon/diary/page" + _f_path + "/" + this.id + ".png";
    local _sp = ::getSprite(_path);
    if (!_sp) {
      _sp = ::getSprite("/image/icon/diary/page1/1.png");
    }
    _sp.blend = SK_MIX;
    return _sp;
  }

  function getNoClearSprite() {
    local _f_path = (this.id / 100 + 1) / 2;
    local _path = "/image/icon/diary/page" + _f_path + "/" + this.nodiary_image;

    local _sp = ::getSprite(_path);
    _sp.blend = SK_MIX;
    return _sp;
  }

  function getLabelSprite(t = "") {
    if (!t) return null;
    local _path = "/ui/image/diary/diary/" + label_image;
    if (t.indexOf("/n") >= 0) _path + "_L";
    _path += ".png";
    local _sp = ::getSprite(_path);
    _sp.blend = SK_MIX;

    return _sp;
  }
  function getLabelAngle() {
    return this.label_angle;
  }

  function checkConditions() {
    if (!this.contents_conditions) return true;

    return ::checkCondition(this.contents_conditions, ::gamesetting.diary_condition_settings);
  }
}