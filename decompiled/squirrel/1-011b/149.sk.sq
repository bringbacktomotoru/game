with SK3DObject {
  dir <- 0.0;

  lock_flag <- false;
  visible_distance <- 0.0;

  is_capture_model <- false;

  function execScript(fname, ...) {
    if (!scprunner || lock_flag) return false;

    switch (vargc) {
    case 1: return scprunner._exec_(fname, vargv[0]); break;
    case 2: return scprunner._exec_(fname, vargv[0], vargv[1]); break;
    case 3: return scprunner._exec_(fname, vargv[0], vargv[1], vargv[2]); break;
    default: return scprunner._exec_(fname); break;
    }

  }

  function startScript(fname, ...) {
    if (!scprunner || lock_flag) return false;

    switch (vargc) {
    case 1: return scprunner._start_(fname, vargv[0]); break;
    case 2: return scprunner._start_(fname, vargv[0], vargv[1]); break;
    case 3: return scprunner._start_(fname, vargv[0], vargv[1], vargv[2]); break;
    case 4: return scprunner._start_(fname, vargv[0], vargv[1], vargv[2], vargv[3]); break;
    case 5: return scprunner._start_(fname, vargv[0], vargv[1], vargv[2], vargv[3], vargv[4]); break;
    case 6: return scprunner._start_(fname, vargv[0], vargv[1], vargv[2], vargv[3], vargv[4], vargv[5]); break;
    case 7: return scprunner._start_(fname, vargv[0], vargv[1], vargv[2], vargv[3], vargv[4], vargv[5], vargv[6]); break;
    default: return scprunner._start_(fname); break;
    }

  }

  local _setMotion = SK3DObject.setMotion;
  function setMotion(mot) {
    if (typeof(mot) == SS_STRING) {
      mot = ::getMotionData(::getResource("/res/anime/" + mot + ".mot"));
    }

    _setMotion(mot);
  }

  function setScriptLock(b) {
    lock_flag = b;
  }

  function setPos(x, y, z) {
    this.pos.set(x, y, z);
    matdirty = true;
  }

  function setRotHPB(h, p, b) {
    this.rot.setHPB(h * Math.DTOR, p * Math.DTOR, b * Math.DTOR);
    matdirty = true;
  }

  function changeParentParts(parts) {
    if (!this.parent) return;
    if (!parent.findBone(parts)) return;

    removeFromParent();
    parent.addChild(this, parts);
    updateMatrix();
  }

  function clearModifiers() {
    if (modifiers) {
      foreach (v in modifiers) {
        v.interrupt(this);
      }
      modifiers.resize(0);
      modifiers = null;
    }
  }

  function isCaptureModel() {
    return is_capture_model;
  }

  function setCaptureModel(b) {
    this.is_capture_model = b;
  }

  function setMoveFuncLock(b) {
    if (!this.scprunner) return;
    this.scprunner.setMoveFuncLock(b);
  }

  function resetPhysicalBones() {
    mutePhysicalBones();
    enablePhysicalBones();
  }

}