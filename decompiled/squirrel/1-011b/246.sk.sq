class ModelViewScene extends ::StageScene {

  constructor() {
    super();

    this.house_manager = RoomManager(this);
  }

  function changeRoom(room_setting_id) {
    foreach (cos_id, chara in this.charas) {
      chara.release();
    }
    Table.clear(this.charas);

    this.house_manager.changeRoom(room_setting_id);
  }

}

class ModelViewScene.RoomManager {
  room = null;

  current_camera_dir = 0.0;

  constructor(stage) {
    this.room = Room(stage.scene);
  }

  function changeRoom(room_setting_id) {
    this.room.boot(room_setting_id);
  }

  function cameraUpdated(pos, h, p, b, force = false) {

    this.current_camera_dir = h;

    this.room.updateVisibleWall(this.current_camera_dir);
  }

  function update(dt) {
  }
}

class ModelViewScene.RoomManager.Room {
  info = null;
  model = null;

  constructor(scene) {
    this.info = RoomInfo();
    this, model = ::HouseModel(scene);
  }

  function clear() {
    this.info.reset();
    this.model.release();
  }

  function boot(room_setting_id) {
    clear();

    this.model.build(room_setting_id);
    this.info.setup(room_setting_id);
    _registerWalls(this.info, this.model);
  }

  function updateVisibleWall(dir) {

    local wall_infos = this.info.wall_infos;
    local wall_objs = this.model.walls;
    local pillar_objs = this.model.pillars;
    foreach (pillar in pillar_objs) {
      pillar.setVisible(true);
    }

    local pillar_num = length(pillar_objs);
    foreach (info in wall_infos) {
      local uid = info.getWallModelUID();
      foreach (idx, obj in wall_objs) {
        if (obj.getUID() != uid) continue;

        local prev_visible = obj.isVisible();
        obj.updateVisible(dir);
        local current_visible = obj.isVisible();
        if (current_visible == false) {

          pillar_objs[idx].setVisible(false);
          pillar_objs[(idx + 1) % pillar_num].setVisible(false);
        }
        if (prev_visible != current_visible) {
          local wall_obj_uids = info.getWallObjectUIDs();
          foreach (uid in wall_obj_uids) {

          }
        }
      }
    }
  }

  function _registerWalls(room_info, house_model) {
    local wall_infos = room_info.wall_infos;
    local wall_objs = house_model.walls;
    foreach (idx, info in wall_infos) {
      info.setWallModelUID(wall_objs[idx].getUID());
    }
  }
}

class ModelViewScene.RoomManager.Room.RoomInfo extends ::RoomInfo {

  function setup(room_setting_id) {
    _reset_grid();

    local room_setting = ::gamesetting.room_settings[room_setting_id];
    this.grid.setup(room_setting.getRoomRects());

    _createWallInfoProcess(this.wall_infos, this.grid);

  }
}