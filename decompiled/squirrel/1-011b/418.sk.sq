with SKImageView {

  function setEnabled(b) {
    super.setEnabled(b);

    if (b) {
      this.setColor(0xffffffff);
    } else {
      this.setColor(COLOR_DISABLE);
    }
  }

  function setDisableColor(b) {
    if (b) {
      this.setColor(COLOR_DISABLE);
    } else {
      this.setColor(0xffffffff);
    }
  }
}