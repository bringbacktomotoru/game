with Serializable() {

  class GachaData {
    static SerialVersion = 1;

    gacha_version = 0;
    id = 0;
    count = 0;
    limit_count = 0;
    limit_last_time = -1;
    step_last_time = -1;

    constructor() {
    }

    function createGachaData(gid, ver) {
      local _gd = ::GachaData();
      _gd.id = gid;
      _gd.gacha_version = ver;
      return _gd;
    }

    static function loadWithCreate(loader) {
      local _data = ::GachaData();
      _data.gacha_version = loader.get();
      _data.id = loader.get();
      _data.count = loader.get();
      _data.limit_count = loader.get();
      _data.limit_last_time = loader.get();
      _data.step_last_time = loader.get();
      return _data;
    }

    function getID() {
      return this.id;
    }

    function getSetting() {
      return ::gamesetting.gacha_settings[this.id];
    }

    function getCount(ver) {
      if (this.gacha_version != ver) return 0
      return this.count;
    }
    function addCound(ver) {
      if (this.gacha_version != ver) _resetData(ver);
      this.count++;
    }

    function getLimitCount(ver) {
      if (this.gacha_version != ver) return 0
      return this.limit_count;
    }
    function getDailyCount(ver) {
      if (this.gacha_version != ver) return 0;
      if (this.limit_last_time < 0 || ::isOtherDay(this.limit_last_time)) return 0;
      return this.limit_count;
    }
    function addLimitCount(ver) {
      if (this.gacha_version != ver) _resetData(ver);
      this.limit_count++;
    }
    function addDailyCount(ver, st) {
      if (this.gacha_version != ver) _resetData(ver);
      else if (this.limit_last_time < 0 || ::isOtherDay(this.limit_last_time, st)) this.limit_count = 0;

      this.limit_last_time = st;
      this.limit_count++;
    }

    function getStepCount(ver) {
      if (this.gacha_version != ver) return 0;
      local _gs = getSetting();
      if (!_gs) return this.count;
      if (this.step_last_time < 0 || _gs.isStepPriceReset(this.step_last_time)) return 0;
      return this.count;
    }
    function addStepCount(ver, st) {
      local _gs = getSetting();
      if (!_gs) return;

      if (this.gacha_version != ver) _resetData(ver);
      else if (this.step_last_time < 0 || _gs.isStepPriceReset(this.step_last_time)) this.count = 0;

      this.step_last_time = st;
      this.count++;
    }

    function _resetData(ver) {
      this.gacha_version = ver;
      this.count = 0;
      this.limit_count = 0;
    }
  }

}