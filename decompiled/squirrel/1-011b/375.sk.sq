import SKViewPropertyID;

class ARPanel extends HomeUI.Panel
{
  static CAPTURE_STATE_PHOTO = 1;
  static CAPTURE_STATE_VIDEO = 2;
  static MULTI_TAP_ROTATE = 3;
  static RECORD_TIME_LIMIT = 60 * 1000;

  static NUMBER_OF_POSSIBLE_SHOTS = 10;

  static STATE_DETECTING = 1;
  static STATE_SEARCHING = 2;
  static STATE_NO_DETECT = 3;
  static STATE_LOSING = 4;
  static LOWER_FPS = 30;
  static LOWER_FPS_COUNT_THRESHOLD = 10;
  static FPS_NO_CHECK_AFTER_CAPTURE = 3000;

  static PERFORMANCE_YET = 0;
  static PERFORMANCE_PLAYING = 1;
  static PERFORMANCE_DONE = 2;

  static DETECT_TIMEOUT = 5000;

  static GRAVITY = 9.8;

  static GYRO_BUFFER_SIZE = 30;
  static INVALID_COUNT_THRESHOLD = 5;
  static VALID_VALUES_THRESHOLD = 0.15;
  static SENSOR_ESTIMATE_ENABLED = false;

  static need_money_layer = false;
  static need_rank_layer = false;
  static need_camera = false;

  static need_menu_layer = false;
  static need_panel_name = false;
  static need_push_animation = false;

  view = null;
  btn_back = null;
  btn_capture = null;
  btn_record = null;
  btn_stop = null;
  btn_backfront = null;
  btn_AR_enable = null;

  btn_back_front = null;
  pnl_image_layer = null;
  pnl_mouse_event = null;
  btn_change = null;
  img_desc = null;
  lbl_record = null;
  image_viewer = null;
  pnl_loading = null;
  pnl_capturing = null;
  scale_slider = null;
  lbl_slider_value = null;
  btn_chara_menu = null;

  record_time_layer = null;

  ar_chara_menu_layer = null;
  is_show_chara_menu = false;
  btn_exec_motion = null;
  img_playing = null;
  btn_exec_motion_lock = null;
  btn_next_motion = null;
  select_motion = null;
  current_motion_index = 0;
  pnl_current_chara = null;
  old_current_chara_id = -1;

  static UI_STATE_ENABLE = 1;
  static UI_STATE_DISABLE = 2;
  static UI_STATE_DISABLE_CANT_INTERRUPT = 3;
  chara_ui_state = null;

  shutter_chance_frame = null;
  shutter_chance_desc = null;

  is_show_right = false;

  hint_detect = null;
  hint_capture = null;
  hint_controll = null;
  hint_buffer = null;
  first_detect = false;
  detect_timeout_id = -1;

  pictures = null;
  disable_panel_anime = false;
  picture_move_layer = null;

  ar_module = null;
  is_capture = null;
  prev_is_capture = false;
  last_capture_time = -1;
  is_shot = null;
  capture_state = null;
  fps_prev_time = null;
  fps_timer = null;

  accel_norm = null;
  accel_vec = null;
  unit_time_gyro = null;
  total_gyro_rot = null;
  total_velocity = null;
  estimated_pos = null;
  accel_history = null;
  accel_history_count = 0;
  sensor_start_time = 0;
  pos_integrated = 0.0;
  gyro_sampling_time = -1;
  accel_sampling_time = -1;
  gyro_history = null;
  gyro_history_count = 0;
  start_invalid_index = -1;
  gyro_invalid_count = 0;
  gyro_standard_index = -1;
  gyro_unit_count = 0;
  prev_accel_vec = null;
  accel_offset = null;
  update_accel_offset_time = -1;

  fps_counter = 0;
  last_fps_update_time = 0;
  zooming = false;
  lower_fps_count = 0;
  fps_message_timeout_id = -1;

  model_viewer = null;
  costume_id = 0;
  first_costume_id = 0;
  current_furniture_id = -1;

  taking_id_tables = null;
  first_chara_pos_table = null;

  can_write_movie_prev = false;
  last_state = 0;

  pausing = false;
  already_removed = false;

  is_reseted = false;
  seen_performance = 0;
  performance_thread = null;

  last_detect_state = -1;

  press_time = -1;
  press_pos = null;
  press_pos_old = null;
  first_route = null;
  move_vec_buf = null;
  multi_tapped = false;
  mouse_stack = null;

  v_1 = null;
  v_2 = null;
  ar_update = true;

  constructor() {
    super();

    this.taking_id_tables = null;

    ::gamesession.getUserDataLocal().setLastARTime();

    this.press_pos = { x = -1, z = -1 };
    this.press_pos_old = { x = -1, z = -1 };
    this.move_vec_buf = { x = 0.0, z = 0.0 };
  }

  function added() {
    super.added();
    ::rootview.borderVisible(false);

    v_1 = Vector3D();
    v_2 = Vector3D();

    view = ::loadSKView("/ui/ARPanel_3.ui");
    this.addChild(view);

    this.img_desc = this.view.findChild("img_desc");
    this.pnl_loading = view.findChild("pnl_loading_front");
    this.pnl_loading.pickable = false;
    this.pnl_loading.findChild("lbl_loading_front").setText(::dict.get("ar_detecting"));

    view.startMethod("setup");

    local _desc_func = function() {
      this.img_desc.visible = false;

      local _v = this.pnl_loading.visible;
      this.pnl_loading.setVisible(false);
      if (!this.view) return;
      this.pnl_loading = this.view.findChild("pnl_loading_back");
      this.pnl_loading.setVisible(_v);
      this.pnl_loading.pickable = false;
      this.pnl_loading.findChild("lbl_loading_back").setText(::dict.get("ar_detecting"));
    }.bindenv(this);
    if (this.disable_panel_anime) {
      _desc_func();
      _desc_func = null;
    }

    btn_back = view.findChild("btn_back");
    ::TapButton(btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    this.btn_capture = view.findChild("btn_capture");
    ::TapButton(this.btn_capture).view.addEventListener(ACTION_EVENT, _actionevent_capture);

    this.btn_record = view.findChild("btn_record");
    this.btn_stop = view.findChild("btn_stop");
    local _btn = ::TapButton(btn_record);
    _btn.view.addEventListener(ACTION_EVENT, _actionevent_record);
    _btn.setTappedSE(SoundConstants.SOUND_RECORD_START);

    _btn = ::TapButton(btn_stop);
    _btn.view.addEventListener(ACTION_EVENT, _actionevent_stop);
    _btn.setTappedSE(SoundConstants.SOUND_RECORD_END);

    this.pnl_capturing = view.findChild("pnl_capturing");
    this.pnl_capturing.pickable = false;
    this.pnl_capturing.setVisible(false);

    this.lbl_record = view.findChild("lbl_record");
    this.lbl_record.setText(::dict.get("recording"));
    this.lbl_record.setVisible(false);

    this.btn_change = view.findChild("btn_change");
    ::TapButton(this.btn_change).view.addEventListener(ACTION_EVENT, _actionevent_changeCaptureMode);

    this.btn_chara_menu = view.findChild("btn_chara_menu");
    ::TapButton(this.btn_chara_menu).view.addEventListener(ACTION_EVENT, actionevent_chara_menu);
    this.btn_exec_motion = view.findChild("btn_exec_motion");
    this.btn_exec_motion_lock = view.findChild("btn_exec_motion_lock");
    this.btn_exec_motion_lock.visible = false;
    this.img_playing = view.findChild("img_playing");
    this.img_playing.visible = false;
    setCharaMotionIcon(null, true);
    ::TapButton(this.btn_exec_motion).view.addEventListener(ACTION_EVENT, actionevent_exec_motion);
    this.pnl_current_chara = view.findChild("pnl_current_chara");
    this.pnl_current_chara.visible = false;

    this.btn_next_motion = view.findChild("btn_next_motion");
    ::TapButton(this.btn_next_motion).view.addEventListener(ACTION_EVENT, actionevent_next_motion);
    this.btn_next_motion.visible = false;

    this.btn_back_front = view.findChild("btn_back_front");

    ::TapButton(this.btn_back_front).view.addEventListener(ACTION_EVENT, _actionevent_backfront);
    if (skGetOSName() == "iOS") this.btn_back_front.visible = false;

    this.chara_ui_state = {};

    this.shutter_chance_frame = view.findChild("ShutterChanceFrame");
    this.shutter_chance_desc = view.findChild("ShutterChanceDesc");
    this.shutter_chance_desc.findChild("lbl_shutter_chance_desc1").setText(::dict.get("ar_shutter_chance_desc1"));
    this.shutter_chance_desc.findChild("lbl_shutter_chance_desc2").setText(::dict.get("ar_shutter_chance_desc2"));
    this.shutter_chance_frame.pickable = false;
    this.shutter_chance_desc.pickable = false;

    hint_buffer = [];

    hint_capture = HintBalloon(view.findChild("pnl_desc_capture"), ::dict.get("arpanel_hint_capture"));
    hint_controll = HintView(view.findChild("pnl_desc_controll"));
    hint_controll.setTexts(::dict.get("arpanel_hint_trans"), ::dict.get("arpanel_hint_rotate"), ::dict.get("arpanel_hint_scale"));

    this.pictures = Pictures(view.findChild("btn_pictures"), this);
    this.pictures.setVisible(false);
    this.picture_move_layer = PictureMoveLayer();
    this.addChild(this.picture_move_layer);
    this.picture_move_layer.visible = false;

    this.record_time_layer = RecordTimeLayer(findChild("pnl_recordtime"));

    this.capture_state = CAPTURE_STATE_PHOTO;
    changeCaptureMode(CAPTURE_STATE_VIDEO);

    fps_prev_time = 0;
    fps_timer = 0;

    local _pnl_scale_slider = view.findChild("pnl_scale_slider");
    this.scale_slider = ::SliderH(_pnl_scale_slider, 300);
    this.scale_slider.view.addEventListener(ACTION_EVENT, actionevent_scale_slider);

    if (_desc_func) {
      _uiVisible(false);

      local _trans = ::addedTransition(this.img_desc, ::getTexture("/image/rule/ar.jpg"), 5.0, 50);
      _trans.perform(this, 3000, _desc_func);
    }

    seen_performance = PERFORMANCE_YET;

    local _sdef = float(::ARModule.COODINATE_SYSTEM_SCALE_DEFAULT) - ::ARModule.COODINATE_SYSTEM_SCALE_MIN;
    this.scale_slider.setValue(1.0 - _sdef / (::ARModule.COODINATE_SYSTEM_SCALE_MAX - ::ARModule.COODINATE_SYSTEM_SCALE_MIN));
    this.scale_slider.view.repaint();

    _pnl_scale_slider.findChild("lbl_slider_value").visible = false;

    v_1 = Vector3D();
    v_2 = Vector3D();

    this.mouse_stack = [];
    if (!_desc_func) load();
  }

  function showed() {
    view.startMethod("loading");
  }

  function _uiVisible(b) {
    this.btn_capture.visible = b;
    this.btn_change.visible = b;
    this.btn_chara_menu.visible = b;
    this.btn_back.visible = b;
    this.btn_exec_motion.visible = b;
    this.scale_slider.view.visible = b;
    if (skGetOSName() != "iOS") this.btn_back_front.visible = b;

  }

  function load() {

    _uiVisible(true);

    hint_buffer + hint_capture;
    first_detect = true;

    ::rootview.addEventListener(skGetOSName().equals("Android") ? 14 : 13, _sensorevent_changesensor, this);

    ::rootview.addEventListener(APP_EVENT, _appevent_on_resume, this);
    ::rootview.addEventListener(APP_EVENT, _appevent_on_pause, this);

    pnl_image_layer = view.findChild("pnl_image_layer");
    pnl_image_layer.setRect(0, 0, ::screenWidth, ::screenHeight);
    pnl_image_layer.pos.x -= (view.bnd.w - ::screenWidth) / 2.0;
    pnl_image_layer.pos.y = (view.bnd.h - ::screenHeight) / 2.0;
    pnl_mouse_event = view.findChild("pnl_mouse_event");
    pnl_mouse_event.setRect(0, 0, ::screenWidth, ::screenHeight);
    pnl_mouse_event.pos.x -= (view.bnd.w - ::screenWidth) / 2.0;
    pnl_mouse_event.pos.y = (view.bnd.h - ::screenHeight) / 2.0;
    registerMouseEventReceiver(pnl_mouse_event);

    image_viewer = SKImageView();
    image_viewer.setRect(0, 0, ::viewWidth, ::viewHeight);
    image_viewer.setColor(65535);
    image_viewer.sp.blend = SK_OFF;

    local _width = ::screenWidth;
    local _height = ::screenHeight;
    local _model_rect = Rect2D(0, 0, _width, _height);
    this.model_viewer = ::ARModelViewer(_model_rect);
    this.model_viewer.setRect(0, 0, _width, _height);
    this.model_viewer.loadStageScene();
    this.model_viewer.renderer.setBackView(image_viewer);
    this.model_viewer.renderer.setOffsetMatrix(::rootview.mat);
    this.model_viewer.setARPanel(this);

    is_capture = false;
    is_shot = false;

    this.model_viewer.addSanrioCharaByTakingIds(this.taking_id_tables);
    this.model_viewer.initApproachCharaList();
    this.model_viewer.addFurnitureByTakingIds(this.taking_id_tables);
    this.model_viewer.setFurnituresLayout();
    this.model_viewer.startUseFurnitureForce(this.taking_id_tables);

    changeDetectState(::ENABLE_AR ? STATE_SEARCHING : STATE_NO_DETECT);

    if (::ENABLE_AR) {

      this.model_viewer.setCharasVisible(false);
      this.model_viewer.setFurnituresVisible(false);
    }

    pnl_mouse_event.addChild(this.model_viewer);

    if (ENABLE_AR) {
      local _os_name = skGetOSName();
      switch (_os_name) {
      case "Android": ar_module = ARModuleAndroid(); break;
      case "iOS": ar_module = ARModuleIOS(); break;
      }
      if (!ar_module.isSupported()) {
        _backDialog();
        return;
      }
      ar_module.create();

      if (!ar_module.isSupported()) {
        _backDialog();
        return;
      }
      ar_module.setARMode(ENABLE_AR);

      this.model_viewer.setARModule(ar_module);

      this.pictures.setPictureSize(this.ar_module.getStillImageSize());

      _updateRecordTime();
    } else {
      this.model_viewer.selectAllModels();
    }

    setUpdateFunc(update);

    local game_scene = getHomeUI().getGameScene();
    game_scene.stopStageUpdate();

    skStartAcceleroMeter();
    if (SENSOR_ESTIMATE_ENABLED) {
      skStartGyroScope();
    }
    sensor_start_time = skGetTime();
    accel_norm = Vector3D();
    accel_vec = Vector3D();
    unit_time_gyro = Vector3D();
    total_velocity = Vector3D();
    accel_history = [];
    accel_history.resize(8);
    already_removed = false;
    estimated_pos = Vector3D();
    model_viewer.setEstimatedPosition(estimated_pos);

    last_fps_update_time = skGetTime();

    this.ar_chara_menu_layer = ARCharaMenuLayer(this, this.view.findChild("pnl_chara_menu"));
    this.ar_chara_menu_layer.setEnable(false);
    updateNextMotionButtonVisible();
    setCharaIcon(this.model_viewer.getCurrentCharaID());
  }

  function _backDialog() {

    local _dlg = ::SimpleDialog();
    _dlg.lbl_msg.setText(::dict.get("can_not_use_AR"));
    _dlg.show();

    local gamescene = getHomeUI().getGameScene();
    local stage = gamescene.getStage();

    local _home_ui = getHomeUI();
    _home_ui.panel_history.clear();
    _home_ui.backTapped();
  }

  function changeDetectState(state) {
    if (this.last_detect_state == state) return;
    this.last_detect_state = state;

    switch (state) {
    case STATE_DETECTING:

      first_detect = false;
      this.pnl_loading.setVisible(false);

      this.model_viewer.setModelsVisible(true);
      this.model_viewer.initHouseVisible();
      _resetDetectTimeout();
      break;
    case STATE_SEARCHING:
      this.pnl_loading.setVisible(true);

      this.model_viewer.setModelsVisible(false);
      _resetDetectTimeout();
      break;
    case STATE_NO_DETECT:
      hint_buffer + hint_controll;
      this.pnl_loading.setVisible(false);

      _resetDetectTimeout();
      break;
    case STATE_LOSING:
      this.pnl_loading.setVisible(true);

      if (!SENSOR_ESTIMATE_ENABLED) {
        this.model_viewer.setModelsVisible(false);
        this.model_viewer.setHouseVisible(false);
      }
      detect_timeout_id = setTimeout(_resetARParam.bindenv(this), DETECT_TIMEOUT);
      break;
    }
  }

  function getDetectState() {
    return this.last_detect_state;
  }
  function isDetecting() {
    return this.last_detect_state == STATE_DETECTING;
  }

  function _appevent_on_resume(e) {
    if (!ar_module) return;

    skStartAcceleroMeter();
    if (SENSOR_ESTIMATE_ENABLED) {
      skStartGyroScope();
    }

    last_fps_update_time = skGetTime();
    fps_counter = 0;
    lower_fps_count = 0;
    zooming = false;

    switch (e.id) {
    case ACTIVESTATE_CHANGED:
      if (e.keycode != AppActiveState.APPACTIVE_ACTIVE) break;
      ar_module.onResume();
      setUpdateFunc(update);
      pausing = false;
      break;
    }
  }

  function _appevent_on_pause(e) {
    if (!ar_module) return;
    if (detect_timeout_id != -1) {
      clearInterval(detect_timeout_id);
      detect_timeout_id = -1;
    }

    if (fps_message_timeout_id) {
      clearInterval(fps_message_timeout_id);
      fps_message_timeout_id = -1;
    }

    switch (e.id) {
    case ACTIVESTATE_CHANGED:
      if (e.keycode != AppActiveState.APPACTIVE_INACTIVE) break;
      setUpdateFunc(null);

      if (is_capture) {
        switch (capture_state) {
        case CAPTURE_STATE_PHOTO:
          if (isShot()) {
            suspend();
          }
          ar_module.waitSaveImageThread();
          this.pnl_capturing.setVisible(false);
          changeCaptureMode(CAPTURE_STATE_VIDEO);
          break;
        case CAPTURE_STATE_VIDEO:

          if (ar_module.movie_writer) ar_module.movie_writer.end();
          this.model_viewer.removeImageViewer();
          _startsave();
          last_state = 0;
          break;
        }
      }

      is_capture = false;
      ar_module.onPause();
      pausing = true;
      break;
    }
  }

  function removed() {
    if (already_removed) return;
    already_removed = true;
    ::rootview.borderVisible(true);

    skStopAcceleroMeter();
    skStopGyroScope();

    foreach (i, l in ::rootview.listeners[skGetOSName().equals("Android") ? 14 : 13]) {
      if (!l.getName().equals(_sensorevent_changesensor.getName())) continue;
      removei;
      break;
    }

    foreach (i, l in ::rootview.listeners[APP_EVENT]) {
      if (!(l.getName().equals(_appevent_on_resume.getName()) || l.getName().equals(_appevent_on_pause.getName()))) continue;
      removei;
    }

    setUpdateFunc(null);

    if (is_capture) {
      switch (capture_state) {
      case CAPTURE_STATE_PHOTO:
        ar_module.waitSaveImageThread();
        break;
      case CAPTURE_STATE_VIDEO:
        if (ar_module.movie_writer) ar_module.movie_writer.end();
        this.model_viewer.removeImageViewer();
        break;
      }
    }

    this.model_viewer.destruct();

    removeMouseEventReceiver(this.pnl_mouse_event);
    mouseevent_manager.refreshAll();

    _resetDetectTimeout();

    if (fps_message_timeout_id != -1) {
      clearInterval(fps_message_timeout_id);
      fps_message_timeout_id = -1;
    }

    view = null;
    btn_back = null;
    btn_capture = null;
    btn_backfront = null;
    btn_AR_enable = null;
    pnl_image_layer = null;
    pnl_mouse_event = null;
    btn_back_front = null;
    image_viewer = null;
    btn_chara_menu = null;

    is_show_right = false;

    hint_capture.removed();
    hint_buffer.clear();

    hint_capture = null;
    hint_buffer = null;
    if (performance_thread) performance_thread.wakeupThrow("stop");

    accel_norm = null;
    accel_vec = null;
    unit_time_gyro = null;

    total_gyro_rot = null;
    accel_history = null;
    total_velocity = null;
    estimated_pos = null;

    press_pos = null;
    press_pos_old = null;
    first_route = null;
    move_vec_buf = null;
    mouse_stack = null;

    if (ar_module) ar_module.removed();
    ar_module = null;

    suspend();

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != ::SanrioGameScene) return;
    local _home_ui = _scene.getUI();
    if (getclassname(_home_ui.getCurrentPanel()) != "HomeTopPanel") return;
    _home_ui.updateShopMark(true, true);
  }

  function setPanelParam(param) {
    if ("taking_id_table" in param) {
      this.taking_id_tables = param.taking_id_table;
    } else {
      this.taking_id_tables = null;
    }
    if ("chara_pos_table" in param) {
      this.first_chara_pos_table = param.chara_pos_table;
    }

    if ("disable_panel_anime" in param) {
      this.disable_panel_anime = true;
    }
  }

  function changeCaptureMode(capture_mask, check = true) {
    local _mode_flag = capture_state == capture_mask;

    this.btn_capture.setVisible(!_mode_flag);
    this.btn_record.setVisible(_mode_flag);
    this.record_time_layer.setVisible(_mode_flag);
    if (_mode_flag && check) {
      _updateRecordTime(true);
    }
    this.btn_stop.setVisible(false);
  }

  function changeSanrioChara(costume_id) {
    if (this.model_viewer.changeSanrioChara(costume_id)) {
      this.costume_id = costume_id;
    }

    this.model_viewer.removeAllTalkWindow();
    local _processing = ::gamesession.processinglayer;
    _processing.endProcess();
  }

  function changeFurniture(furniture_uid) {
    local _processing = ::gamesession.processinglayer;
    _processing.startProcess(skGetTime());

    this.model_viewer.clearFurnitures();
    this.model_viewer.addFurnitureId(furniture_uid);

    is_reseted = false;

    this.model_viewer.removeAllTalkWindow();

    _processing.endProcess();
  }

  function addTalkWindow(sk3d, talk_key, chara_key, big = false, small = false) {
    this.model_viewer.addTalkWindow(sk3d, talk_key, chara_key, small);
  }

  function render() {
    if (already_removed) return;
    super.render();
    if (!::ENABLE_AR) return;
    if (!this.model_viewer || !ar_module) return;

    local _time = skGetTime();
    fps_timer += _time - fps_prev_time;
    if (fps_timer >= 10000) {
      local _liner = model_viewer.liner;
      foreach (line in _liner) {
        model_viewer.scene.removeObject(line);
      }
      model_viewer.liner.clear();
      fps_timer = 0;
    }
    fps_prev_time = _time;

    local _half_view = {
      w = pnl_image_layer.bnd.w / 2.0;
      h = pnl_image_layer.bnd.h / 2.0;
    }
    if (ar_module.isSupported()) ar_module.pasteImage(image_viewer, model_viewer, _half_view);
  }

  function update(dt) {
    local _os_name = skGetOSName();
    local _t = skGetTime();

    if (::ENABLE_AR && !this.ar_update) {
      ar_module.getResult();
      _updateCaptureProcess();
      this.ar_update = !(this.ar_module.ProcessingRenderImage() || isShot());
      return;
    }

    local _fps_check = _os_name.equals("Android") && !ar_module.isLowerVideoImage() && fps_message_timeout_id == -1 && !zooming;
    if (this.prev_is_capture && !this.is_capture) {
      this.last_capture_time = _t;
    }
    _fps_check &= (!this.is_capture && this.last_capture_time + FPS_NO_CHECK_AFTER_CAPTURE < _t);
    this.prev_is_capture = this.is_capture;
    if (_fps_check) {
      fps_counter++;
      if (_t - last_fps_update_time >= 1000) {
        local _fps = fps_counter * (2.0 - (_t - last_fps_update_time) / 1000.0);
        if (_fps < LOWER_FPS) {
          lower_fps_count++;
          if (lower_fps_count >= LOWER_FPS_COUNT_THRESHOLD) {

            local _msg = ::Message();
            _msg.setText(::dict.get("arpanel_lower_fps"));
            _msg.setMsec(2000);
            _msg.setFontSize(32);
            _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0, 0);
            _msg.setColor(0xffffffff);
            _msg.stroke();
            _msg.show();

            fps_message_timeout_id = setTimeout(function() {
              _restartCamera(ARModuleAndroid.VIDEO_IMAGE_SIZE_LOW);
              fps_message_timeout_id = -1;
            }.bindenv(this), 2000 + 500);
            lower_fps_count = 0;
          }
        } else {
          lower_fps_count = 0;
        }
        fps_counter = 0;
        last_fps_update_time = _t;
      }
    }

    if (::ENABLE_AR) {
      local _ret = ar_module.getResult();

      local _recognized = false;

      if (ar_module.isARMode() && _ret.len() > 0 && ar_module.isRecognized(_ret[0])) {
        changeDetectState(STATE_DETECTING);
        _recognized = true;
      }

      if (ar_module.isARMode() && !ar_module.isRecognized(_ret[0])) {
        if (this.last_detect_state == STATE_DETECTING) {
          changeDetectState(STATE_LOSING);
        }
      }

      if (_ret.len() > 0) {
        this.model_viewer.setARParam(
        _ret[0],
        ar_module.isARMode(),
        ar_module.isFlipY(),
        calcCurrentDeviceDirection()
        );
      }

      if (_recognized) {

        if (seen_performance == PERFORMANCE_YET && !img_desc.visible) {

          seen_performance = PERFORMANCE_PLAYING;
          performance_thread = newthread().start(_appearPerformance, this);
        }

        model_viewer.setFurnituresVisible(true);

        if (!is_reseted) {
          model_viewer.setFurnituresLayout();
          this.model_viewer.startUseFurnitureForce(this.taking_id_tables);
          this.taking_id_tables = null;
          model_viewer.initCharasPos(this.first_chara_pos_table);
          this.first_chara_pos_table = null;
          if (seen_performance == PERFORMANCE_DONE) {

            model_viewer.setCharasRandomAction();
          }
        }
        is_reseted = true;

        this.model_viewer.updateHouseVisible();
      } else {
        model_viewer.setFurnituresVisible(false);
      }

      ar_module.calcAccelDiff();
    }

    this.model_viewer.setAccelVec(this.accel_norm);
    this.model_viewer.update(dt);

    if (!img_desc.visible && hint_buffer.len() > 0) {
      if (!hint_buffer[0].thread) {
        hint_buffer[0].showBalloon(500);
      } else if (!hint_buffer[0].isRunning()) {
        delete hint_buffer[0];
        if (hint_buffer.len() > 0) hint_buffer[0].showBalloon(500);
      }
    }

    if (!ENABLE_AR) return;

    _updateCaptureProcess();

    ar_module.modifyExposure();
  }

  function _updateCaptureProcess() {
    local _state = -1;
    switch (capture_state) {
    case CAPTURE_STATE_PHOTO:
      local _cap = ar_module.saveImage(model_viewer, this);
      if (is_capture && !_cap) {

        skCollectGarbage();
        this.pnl_capturing.setVisible(false);
        changeCaptureMode(CAPTURE_STATE_VIDEO);
      }
      is_capture = _cap;
      break;
    case CAPTURE_STATE_VIDEO:
      _state = ar_module.saveFrame(model_viewer, is_capture);
      if (_state == ARModule.STATE_RECORD_TIMEOUT) {

        endRecordMovie();
        ::gamesession.messagelayer.closeAllMessage();
        local _msg = ::Message();
        _msg.setText(::dict.get("record_timeout"));
        _msg.setFontSize(32);
        _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0, 0);
        _msg.setColor(0xffffffff);
        _msg.stroke();
        _msg.show();
        last_state = _state;

        _startsave();

        _updateRecordTime(true);

      } else if (_state == ARModule.STATE_RECORD_INVALID) {
        is_capture = false;
        model_viewer.removeImageViewer();
        _updateRecordTime(true);

        this.lbl_record.setVisible(false);
        changeCaptureMode(CAPTURE_STATE_VIDEO, false);
        last_state = _state;
      } else if (_state == ARModule.STATE_RECORDING) {

        _updateRecordTime();
      }
      break;
    }

    if (ar_module.movie_writer) {
      local _b = ar_module.canWriteMovie();
      if (_b && !can_write_movie_prev) {
        local _offs = 0;

        this.pnl_capturing.setVisible(false);
        changeCaptureMode(CAPTURE_STATE_VIDEO, false);

        this.ar_module.displayMovieThumbnail(displayPicture.bindenv(this));
      }
      can_write_movie_prev = _b;
    }
  }

  function _updateRecordTime(reset = false) {
    local _time = !reset ? this.ar_module.getRecordElapsedTime() / 1000 : 0;
    local _param = { minute = -1, sec = -1 };
    _param = ::calcTimePart(_time, _param);

    local _min_txt = _param.minute >= 10 ? _param.minute : "0" + _param.minute;
    local _sec_txt = _param.sec >= 10 ? _param.sec : "0" + _param.sec;
    this.record_time_layer.setTime(_min_txt, _sec_txt);
  }

  function _hasReachedCaptureLimit() {
    if (reachedCaptureLimit()) {

      local _message = ::Message();
      _message.setFontSize(32);
      _message.setText(::dict.get("arpanel_capture_limit"));
      _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0, 0.0);
      _message.setColor(0xffffffff);
      _message.stroke();
      _message.show();
      return true;
    }
    return false;
  }

  function _appearPerformance() {
    try {
      local _chara_script = "appear_ar";

      this.model_viewer.setCharasVisible(true);
      this.model_viewer.startCharasScript(_chara_script);

      model_viewer.selectAllModels();
      this.model_viewer.startUseFurnitureForce(this.taking_id_tables);
      this.taking_id_tables = null;
      model_viewer.setCharasRandomAction();

      seen_performance = PERFORMANCE_DONE;
      suspend();

      this.model_viewer.startFurnituresEffect("appear_ar");
      sleep(100);

    } catch (ex) {
      if (ex != "stop") printexception(ex);
    }
  }

  function _startsave() {
    this.lbl_record.setVisible(false);
    this.pnl_capturing.setVisible(true);
    this.view.startMethod("capturing");
    this.btn_record.setVisible(false);
    this.btn_capture.setVisible(false);
    this.btn_stop.setVisible(false);
  }

  function calcCurrentDeviceDirection() {
    local orient = 0;
    if (Math.abs(accel_norm.x) < 0.5) {
      if (accel_norm.y < 0) orient = 270;
      else orient = 90;
    } else {
      if (accel_norm.x < 0) orient = 180;
      else orient = 0;
    }
    return orient;
  }

  function actionevent_back(e) {
    e.consume();

    processBack(e.src);
  }

  function _actionevent_record(e) {
    e.consume();
    if (_hasReachedCaptureLimit()) return;

    if (!ENABLE_AR || capture_state != CAPTURE_STATE_VIDEO) return;

    if (ar_module.movie_writer && !ar_module.canWriteMovie()) return;
    is_capture = ar_module.startRecordMovie(model_viewer, accel_norm);
    if (!is_capture) return;

    ar_module.setRecordTimeLimit(RECORD_TIME_LIMIT);
    this.lbl_record.setVisible(true);
    this.view.startMethod("recording");

    this.btn_record.setVisible(false);
    this.btn_stop.setVisible(true);
  }

  function _actionevent_stop(e) {
    endRecordMovie();
  }

  function _actionevent_capture(e) {
    e.consume();
    if (_hasReachedCaptureLimit()) return;

    if (!ENABLE_AR || capture_state != CAPTURE_STATE_PHOTO) return;

    if (is_capture) return;

    this.ar_update = false;

    this.is_capture = true;
    this.is_shot = true;

    ar_module.startCaptureImage(accel_norm);

    newthread().start(function() {
      local _flash = ::SKImageView();
      local _sp = _flash.sp;
      _sp.color = 0xffffffff;
      _sp.blend = SK_MIX;
      _flash.setRect(0.0, 0.0, this.bnd.w, this.bnd.h);
      addChild(_flash);
      local _frames = 30;
      local fdiv = 1.0 / float(_frames - 1);
      for (local l = _frames - 1; l >= 0; l--) {
        local a = ((l * fdiv) * 255.0);
        _sp.color = (_sp.color & 0xffffff00) | a;
        _flash.repaint();
        sleep(16);
      }
    }, this);
    _startsave();

    if (this.model_viewer.executeCapture()) {

      this.picture_move_layer.initView();
      this.picture_move_layer.visible = true;
      this.shutter_chance_frame.visible = false;
      this.shutter_chance_desc.visible = false;
    }
  }

  function _actionevent_changeCaptureMode(e) {
    e.consume();

    if (is_capture) {
      switch (capture_state) {
      case CAPTURE_STATE_PHOTO:
        if (isShot()) return;
        ar_module.waitSaveImageThread();
        this.pnl_capturing.setVisible(false);
        changeCaptureMode(CAPTURE_STATE_VIDEO);
        break;
      case CAPTURE_STATE_VIDEO:
        ar_module.movie_writer.end();
        this.model_viewer.removeImageViewer();
        last_state = 0;
        break;

      }
    }
    lbl_record.setVisible(false);

    if (is_capture && capture_state == CAPTURE_STATE_VIDEO) {

      _startsave();
    } else {
      this.pnl_capturing.setVisible(false);
      changeCaptureMode(CAPTURE_STATE_PHOTO);
    }
    is_capture = false;

    capture_state = (capture_state % CAPTURE_STATE_VIDEO) + 1;
  }

  function _actionevent_reset_arparam(e) {
    e.consume();

    _resetARParam();
  }

  function actionevent_scale_slider(e) {
    e.consume();

    switch (e.actioncmd) {
    case "dragged":
      local _s = ::ARModule.COODINATE_SYSTEM_SCALE_MAX - (::ARModule.COODINATE_SYSTEM_SCALE_MAX - ::ARModule.COODINATE_SYSTEM_SCALE_MIN) * this.scale_slider.getValue();
      if (this.ar_module) this.ar_module.setCoodinateSystemScale(_s);

      break;
    }
  }

  function _actionevent_backfront(e) {
    e.consume();
    _restartCameraProcess(function() {
      self.ar_module.changeCamera();
    }.bindenv({ self = this }));
  }

  function actionevent_chara_menu(e) {
    e.consume();

    if (!this.model_viewer.getCurrentCharaModel()) return;

    if (this.is_show_chara_menu) {
      hideCharaMenu();
    }
    else {
      showCharaMenu()
    }
  }
  function showCharaMenu() {
    if (this.is_show_chara_menu) return;
    this.view.startMethod("show_chara_menu");
    this.is_show_chara_menu = true;
    this.ar_chara_menu_layer.setCharaModel(this.model_viewer.getCurrentCharaModel());
    this.ar_chara_menu_layer.setEnable(true);
  }
  function hideCharaMenu() {
    if (!this.is_show_chara_menu) return;
    updateNextMotionButtonVisible();
    this.view.startMethod("hide_chara_menu");
    this.is_show_chara_menu = false;
    this.ar_chara_menu_layer.setEnable(false);
  }

  function showShutterChanceDesc() {
    this.shutter_chance_desc.visible = true;
    this.shutter_chance_desc.startMethod("show_shutter_chance_desc");
  }
  function setShutterChanceDescVisible(b) {
    this.shutter_chance_desc.visible = b;
  }

  function showShutterFrame() {
    this.shutter_chance_frame.visible = true;
    this.shutter_chance_frame.startMethod("show_shutter_frame");
  }
  function hideShutterFrame(type = "") {
    this.shutter_chance_frame.visible = true;
    this.shutter_chance_frame.startMethod("hide_shutter_frame" + type);
  }
  function changeShutterFrame() {
    this.shutter_chance_frame.visible = true;
    this.shutter_chance_frame.startMethod("change_shutter_frame");
  }
  function setShutterFrameVisible(b) {
    this.shutter_chance_frame.visible = b;
  }

  function actionevent_exec_motion(e) {
    e.consume();

    if (this.model_viewer.startCharaAction(this.select_motion)) {

      setEnableMotions(UI_STATE_DISABLE_CANT_INTERRUPT, this.model_viewer.getCurrentCharaID());
    }
  }

  function actionevent_next_motion(e) {
    e.consume();

    local _cur = this.model_viewer.getCurrentCharaModel();
    if (!_cur) return;

    local _fl = clone ::gamesession.getUserDataLocal().getFavoriteMotionsByARCharaModel(_cur);
    _fl[0] <- null;
    if (_fl.len() < 2) return;

    this.current_motion_index++;
    if (_fl.len() <= this.current_motion_index) this.current_motion_index = 0;

    setCharaMotionIcon(::gamesetting.costume_motion_settings[_fl[this.current_motion_index]]);
  }

  function resetMotion() {
    local _cur = this.model_viewer.getCurrentCharaModel();
    if (!_cur) return;

    local _fl = clone ::gamesession.getUserDataLocal().getFavoriteMotionsByARCharaModel(_cur);
    _fl[0] <- null;
    if (_fl.len() < 2) return;

    this.current_motion_index = 0;
    if (_fl.len() <= this.current_motion_index) this.current_motion_index = 0;

    setCharaMotionIcon(::gamesetting.costume_motion_settings[_fl[this.current_motion_index]]);
  }

  function updateNextMotionButtonVisible() {
    local _cur = this.model_viewer.getCurrentCharaModel();
    if (!_cur) {
      this.btn_exec_motion.visible = false;
      this.btn_next_motion.visible = false;
      this.btn_chara_menu.visible = false;
      return;
    }

    this.btn_exec_motion.visible = true;
    this.btn_chara_menu.visible = true;
    _setEnableMotionButton(_cur.getCharaID());

    local _fl = ::gamesession.getUserDataLocal().getFavoriteMotionsByARCharaModel(_cur);
    if (_fl.len() < 1) {
      this.btn_next_motion.visible = false;
      return;
    }

    this.btn_next_motion.visible = true;
  }

  function setCharaMotion(as) {
    setCharaMotionIcon(as);
    if (this.model_viewer.startCharaAction(as)) {

      setEnableMotions(UI_STATE_DISABLE, this.model_viewer.getCurrentCharaID());
      return true;
    }
    return false;
  }
  function setCharaMotionIcon(as, force = false) {
    if (!force && this.select_motion == as) return;
    this.select_motion = as;
    this.btn_exec_motion.clearChildren();

    local _sp;
    if (this.select_motion) {
      _sp = this.select_motion.getIconSprite();
    }
    else {
      _sp = ::getSprite("/image/icon/motion/motion1/random.png");
      _sp.blend = SK_MIX;
    }

    if (_sp) {
      _sp.bnd.set(0, 0, this.btn_exec_motion.bnd.w, this.btn_exec_motion.bnd.h);
      local _img_motion = ::SKImageView(_sp);
      this.btn_exec_motion.addChild(_img_motion);

      if (this.model_viewer) {
        this.btn_exec_motion.setEnabled(getCurrentCharaUIEnable());
        local _cur = this.model_viewer.getCurrentCharaModel();
        if (_cur) _setEnableMotionButton(_cur.getCharaID());
      }
    }
  }

  function setCharaIcon(chara_id) {

    this.pnl_current_chara.clearChildren();
    local _setting = ::gamesetting.sanrio_chara_settings[chara_id];
    if (!_setting) return;

    local _sp = _setting.getIconSprite();
    local _imageview = SKImageView(_sp);
    _imageview.setRect(0, 0, this.pnl_current_chara.bnd.w, this.pnl_current_chara.bnd.h);
    this.pnl_current_chara.addChild(_imageview);
  }

  function mouseevent_panel(e) {

    if (this.already_removed) return;

    local last_event = this.mouseevent_manager.getLastEvent();
    if (!last_event) return;

    local game_scene = ::gamesession.getCurrentScene();

    if (this.mouseevent_manager.isMultiTapped()) {
      if (!this.multi_tapped) {
        this.model_viewer.clearMoveRoute();
        this.model_viewer.interruptDragRouteThread();
        this.multi_tapped = true;
      }

      if (last_event.id == MOUSE_PRESSED) {

        this.mouse_stack + last_event.mouseid;
      }

      local _pinch_rate = this.mouseevent_manager.getPinchRate();

      if (multi_tap_state == MULTI_TAP_NONE) {
        if (this.mouseevent_manager.isMultiDragged(45.0)) {
          multi_tap_state = MULTI_TAP_DRAG;
        } else if (this.mouseevent_manager.isPinched(45.0)) {
          if (Math.abs(1 - _pinch_rate) > 0.02) multi_tap_state = MULTI_TAP_PINCH;
        }
      }

      switch (multi_tap_state) {
      case MULTI_TAP_PINCH:
        local rate = 2.0 - _pinch_rate;

        rate = 1.0 + (rate - 1.0) * 0.33;
        mousePinched(-(rate - 1.0));

        break;
      case MULTI_TAP_DRAG:

        local keeper = this.mouseevent_manager.keepers[0];
        local prev = keeper.event_history[length(keeper.event_history) - 2];
        local last = keeper.event_history[length(keeper.event_history) - 1];
        v_1.set(last.x, last.y, 0).sub(prev.x, prev.y, 0).scale(0.1);

        mouseMultiDragged(v_1.x, v_1.y);
        break;
      case MULTI_TAP_ROTATE:
        mouseMultiRotate(_getRotateDist());
        break;
      }

      this.enable_release_action = false;

      return;
    } else {
      multi_tap_state = MULTI_TAP_NONE;
    }
    switch (last_event.id) {
    case MOUSE_PRESSED:

      this.enable_release_action = true;
      this.pressed_x = last_event.x;
      this.pressed_y = last_event.y;

      this.mouse_stack + last_event.mouseid;

      local _time = last_event.time;
      mousePressed(pressed_x, pressed_y, _time);

      break;
    case MOUSE_DRAGGED:
      v_1.set(last_event.x, last_event.y, 0).sub(this.pressed_x, this.pressed_y, 0);
      if (v_1.length() < UNABLE_DRAG_DIST) return;

      local dragVec = this.mouseevent_manager.getDragVec();
      local _time = last_event.time;
      mouseDragged(dragVec.x, dragVec.y, _time);

      this.is_dragged = this.mouseevent_manager.isDraggedLastKeeper();

      break;
    case MOUSE_RELEASED:

      local _idx = this.mouse_stack.indexOf(last_event.mouseid);
      delete this.mouse_stack[_idx];
      if (this.mouse_stack.len() < 1) this.multi_tapped = false;

      if (!this.first_route) {
        local _ret = this.model_viewer.screenDragged();
        if (_ret) {
          setEnableMotions(UI_STATE_ENABLE, this.model_viewer.getCurrentCharaID());
          return;
        }
      }

      if (this.zooming) this.zooming = false;
      if (is_dragged || !this.enable_release_action) {
        this.is_dragged = false;
        this.enable_release_action = true;
        return;
      }
      break;
    case MOUSE_CLICKED:
      mouseClicked(last_event.x, last_event.y);
      break;
    case MOUSE_WHEEL_MOVED:
      break;
    }
  }

  function _sensorevent_changesensor(e) {
    e.consume();

    local _t = skGetTime();
    switch (e.id) {
    case ACCEL_CHANGED:
    case 1300:
      if (!accel_norm || !accel_vec) return;

      local _strval = e.actioncmd.substring(1, e.actioncmd.len() - 1);
      local _accel_val = _stringToArray(_strval);
      accel_norm.set(_accel_val[0], _accel_val[1], _accel_val[2]).normalize();
      accel_vec.set(_accel_val[0], _accel_val[1], _accel_val[2]);

      if (SENSOR_ESTIMATE_ENABLED) {
        local _ms;
        if (accel_sampling_time < 0) accel_sampling_time = _t;
        _ms = (_t - accel_sampling_time);
        if (_ms < 0) return;

        _accelVecToPos(accel_vec, _ms, _t);
        accel_sampling_time = _t;
      }
      break;
    case GYRO_CHANGED:
    case 1301:
      local _strval = e.actioncmd.substring(1, e.actioncmd.len() - 1);
      local _gyro_val = _stringToArray(_strval);

      local _unit = (1.0 / 1000.0);
      local _gv = Vector3D(-_gyro_val[0] * _unit, _gyro_val[1] * _unit, _gyro_val[2] * _unit);

      local _ms;
      if (gyro_sampling_time < 0) gyro_sampling_time = _t;
      _ms = (_t - gyro_sampling_time);
      unit_time_gyro.add(_gv);
      gyro_unit_count++;

      if (_ms == 0) return;

      unit_time_gyro.div(gyro_unit_count * 1.0);
      gyro_unit_count = 0;

      gyro_sampling_time = _t;

      if (!total_gyro_rot) {
        total_gyro_rot = Quaternion.fromHPB(unit_time_gyro);
        this.model_viewer.setTotalGyroRotation(total_gyro_rot);
        gyro_history = [];
        gyro_history.resize(GYRO_BUFFER_SIZE);
        gyro_standard_index = 0;
      } else {

        local _len = unit_time_gyro.length() * Math.RTOD;
        local _history_length = GYRO_BUFFER_SIZE;
        local _dist = _len;
        local _invalid = false;
        if (gyro_history_count > 0) {

          local _current_idx = gyro_history_count % GYRO_BUFFER_SIZE;
          if (_current_idx == gyro_standard_index && gyro_invalid_count > 0) {
            gyro_standard_index = start_invalid_index;
          }

          _dist = Math.abs(gyro_history[gyro_standard_index].length - _len);
          if (_dist > VALID_VALUES_THRESHOLD) {
            gyro_invalid_count++;
            _invalid = true;
            if (gyro_invalid_count >= INVALID_COUNT_THRESHOLD) {

              gyro_standard_index = (gyro_history_count) % GYRO_BUFFER_SIZE;
              gyro_invalid_count = 0;
            }
            if (start_invalid_index < 0) {
              start_invalid_index = (gyro_history_count) % GYRO_BUFFER_SIZE;
            }
          } else {
            if (gyro_invalid_count > 0) {

              local _start = start_invalid_index - 1;
              if (_start < 0) _start += GYRO_BUFFER_SIZE;
              local _length = (gyro_history[_start].length + _len) / 2.0;
              local _value = (gyro_history[_start].value + unit_time_gyro) / 2.0;
              local _stand = gyro_history[gyro_standard_index];

              local _s_val = gyro_history[_start].value;
              for (local i = 1; i <= gyro_invalid_count; i++) {
                local _idx = (_start + i) % GYRO_BUFFER_SIZE;
                local _ms = gyro_history[_idx].ms;
                local _l = gyro_history[_idx].length;
                local _v = gyro_history[_idx].value;
                local _st = gyro_history[_idx].standard;
                local _d = Math.abs(gyro_history[gyro_standard_index].length - _length);

                gyro_history[_idx] = { length = _length, value = _value, ms = _ms, dist = _d, adjust = true, standard = _st };
              }
              gyro_invalid_count = 0;
              start_invalid_index = -1;
            }
          }

          if (gyro_history_count > GYRO_BUFFER_SIZE / 2) {
            local _idx = (gyro_history_count % GYRO_BUFFER_SIZE) - GYRO_BUFFER_SIZE / 2;
            if (_idx < 0) _idx += GYRO_BUFFER_SIZE;
            local _hpb = total_gyro_rot.toMatrix().getHPB();
            local _ms = gyro_history[_idx].ms;
            local _d = gyro_history[_idx].dist;
            local _val = gyro_history[_idx].value;
            local _adjust = gyro_history[_idx].adjust;
            local _l = gyro_history[_idx].length;
            local _st = gyro_history[_idx].standard;
            local _gvec = Vector3D(_val) * _ms;
            total_gyro_rot.setHPB(-(_hpb.x + _gvec.x), _hpb.y + _gvec.y, _hpb.z + _gvec.z);
            _hpb = total_gyro_rot.toMatrix().getHPB() * Math.RTOD;
            _val = _val * Math.RTOD;
            local _is = _idx == gyro_standard_index;
          }
        }

        local _idx = gyro_history_count % GYRO_BUFFER_SIZE;

        local _one_before = gyro_history_count - 1;
        if (_one_before < 0) _one_before += GYRO_BUFFER_SIZE;

        if (gyro_history[_one_before]) {
          if (unit_time_gyro.length() < 0.003) {
            unit_time_gyro.set(0.0);
            if (_invalid) {
              gyro_invalid_count--;
              if (gyro_invalid_count == 0) start_invalid_index = -1;
            }
            return;
          }
          local _before_nval = Vector3D(gyro_history[_one_before].value).normalize();
          local _nval = Vector3D(unit_time_gyro).normalize();
          local _f = Math.acos(_nval.dot(_before_nval));
          if (_f < 3.0 * Math.DTOR) {
            unit_time_gyro.set(0.0);
            if (_invalid) {
              gyro_invalid_count--;
              if (gyro_invalid_count == 0) start_invalid_index = -1;
            }
            return;
          }
        }

        gyro_history[_idx] = { length = _len, value = Vector3D(unit_time_gyro), ms = _ms, dist = _dist, adjust = false, standard = (_idx == gyro_standard_index) };
        gyro_history_count++;

        unit_time_gyro.set(0.0);
      }

      pos_integrated += _gv.length() * _ms * 5.0;
      break;
    }
  }

  function _calcDeviceRotationFromGravity() {

    local _gvec = ar_module.getGravity();
    v_1.set(_gvec.x, _gvec.y, 0.0).normalize();
    v_2.set(1.0, 0.0, 0.0);

    return Math.acos(v_1.dot(v_2) / (v_1.length() / v_2.length()));
  }

  function _stringToArray(_strval) {
    local _sensor_val = [];
    _strval = _strval + ", ";
    while (_strval.len() > 0 && _strval.indexOf(", ") != -1) {
      local _idx = _strval.indexOf(", ");
      _sensor_val + float(_strval.substring(0, _idx - 1));
      _strval = _strval.substring(_idx + 2, _strval.len());
    }
    return _sensor_val;
  }

  function _groundRotationMatrix(time) {

    local _ground_norm = Vector3D(0.0, 1.0, 0.0);
    local _z_norm = Vector3D(0.0, 0.0, 1.0);
    local _temp_vec = Vector3D(1.0, 0.0, 0.0);

    local _tmp = total_gyro_rot.toMatrix().getHPB();
    local _inv = -total_gyro_rot;
    _temp_vec.transform0(_inv.toMatrix());

    local _q = Quaternion.from2Axis(_temp_vec, _ground_norm);

    return _q.toMatrix();
  }

  function _accelVecToPos(accel_vec, msec, time) {
    if (time - sensor_start_time < 500) return;
    local _v_hpb = Vector3D();

    local _gmat = _groundRotationMatrix(time);
    local _inv = -total_gyro_rot;
    local _rotmat = _inv.toMatrix();

    local _v = Vector3D(accel_vec);
    _v.transform0(_gmat);

    local _vtmp = Vector3D(_v);

    _v.y -= GRAVITY;

    if (!prev_accel_vec) prev_accel_vec = Vector3D(_v);
    local _acc_diff = ar_module.getAccelDiff();
    local _acc_diff2 = (_v) * (1.0 / 1000.0);

    if (!accel_offset || update_accel_offset_time < time) {
      accel_offset = _v - _acc_diff;
      update_accel_offset_time = time + 2000;
    }
    _v -= accel_offset;

    total_velocity += _v * (1.0 / 1000.0) * msec;

    if (total_velocity.length() > 5000.0) {
      total_velocity.scale(0.95);
    }

    local _resting = false;

    accel_history[(accel_history_count++) % accel_history.len()] = _v.length();
    if (accel_history_count > accel_history.len()) {
      local _l = _v.length();
      local _min = _l, _max = _l, _sum = 0.0;

      foreach (_acc in accel_history) {
        _sum += _acc;
        if (_acc > _max) _max = _acc;
        else if (_acc < _min) _min = _acc;
      }
      if (_sum > 2.5 && _max - _min < 0.2) {
        _resting = true;
        total_velocity.scale(0.5);
        if (_max - _min < 0.1) {
          total_velocity.set(0.0, 0.0, 0.0);
        }
      }

    }

    if (total_velocity.length() > 0.005) {

      local _v = total_velocity * (1.0 / 1000.0) * msec;

      _v.y *= -1.0;
      estimated_pos.add(_v);
    }

    local _hpb = total_gyro_rot.toMatrix().getHPB() * Math.RTOD;

    pos_integrated += total_velocity.length() * 0.0001 + _v.length() * 0.1;

    if (_resting && pos_integrated > 0.0) {
      local _temp_pos = Vector3D().set(estimated_pos);
      pos_integrated -= (_temp_pos - estimated_pos).length();
    }

    prev_accel_vec = _v;
  }

  function _isMultiRotated() {
    local LENGTH = 20;
    local keeper0 = this.mouseevent_manager.keepers[0];
    local keeper1 = this.mouseevent_manager.keepers[1];
    local prev0 = keeper0.event_history[length(keeper0.event_history) - 2];
    local prev1 = keeper1.event_history[length(keeper1.event_history) - 2];
    local last0 = keeper0.event_history[length(keeper0.event_history) - 1];
    local last1 = keeper1.event_history[length(keeper1.event_history) - 1];

    if (!prev0 || !prev1 || !last0 || !last1) return false;

    v_1 = Vector3D(last0.x, last0.y, 0).sub(prev0.x, prev0.y, 0);
    v_2 = Vector3D(last1.x, last1.y, 0).sub(prev1.x, prev1.y, 0);

    if (!_isVecAngleOver(v_1, v_2)) return false;

    local _usevec = v_1.length() > v_2.length();

    local _vec = Vector3D(_usevec ? v_1 : v_2);
    _vec = (Quaternion.fromHPB(0, 0, 90 * Math.DTOR) * _vec.normalize()).scale(LENGTH);
    local _vec_rev = Vector3D(_usevec ? v_1 : v_2);
    _vec_rev = (Quaternion.fromHPB(0, 0, -90 * Math.DTOR) * _vec_rev.normalize()).scale(LENGTH);
    local _point_vec = Vector3D(prev0.x, prev0.y, 0).sub(prev1.x, prev1.y, 0);
    if (!_usevec) _point_vec.scale(-1);

    local v_3 = _vec - _point_vec;
    local v_4 = _vec_rev - _point_vec;

    if (_isVecAngleOver(_vec.scale(1), v_3) || _isVecAngleOver(_vec_rev.scale(1), v_4)) {
      return true;
    }
    return false;
  }

  function _isVecAngleOver(v_1, v_2) {
    local dot = v_1.x * v_2.x + v_1.y * v_2.y;
    local len = v_2.length() * v_1.length();
    local _cos = Math.clamp(dot / len, -1, 1);
    local _angle = Math.acos(_cos) * Math.RTOD;
    if (_angle > 180) _angle -= 180.0;
    return Math.abs(_angle) > 90.0;
  }

  function _getRotateDist() {
    local keeper0 = this.mouseevent_manager.keepers[0];
    local keeper1 = this.mouseevent_manager.keepers[1];
    local prev0 = keeper0.event_history[length(keeper0.event_history) - 2];
    local prev1 = keeper1.event_history[length(keeper1.event_history) - 2];
    local last0 = keeper0.event_history[length(keeper0.event_history) - 1];
    local last1 = keeper1.event_history[length(keeper1.event_history) - 1];

    v_1.set(last0.x, last0.y, 0).sub(prev0.x, prev0.y, 0);
    v_2.set(last1.x, last1.y, 0).sub(prev1.x, prev1.y, 0);

    local _usevec = v_1.length() > v_2.length();

    local _point_vec = Vector3D(prev0.x, prev0.y, 0).sub(prev1.x, prev1.y, 0);
    local _point_vert_vec = Quaternion.fromHPB(0, 0, 90 * Math.DTOR) * _point_vec.normalize();

    return (_usevec ? v_1 : v_2).length() * (_isVecAngleOver(_point_vert_vec, _usevec ? v_1 : v_2) ? 1 : -1) * 0.1;
  }

  function mousePinched(rate) {
    if (!ar_module || !ar_module.isARMode()) {
      this.model_viewer.ScalingSelectModel_atPinch(rate);
    } else if (::ENABLE_AR) {

      local _r = ar_module.getZoomRate();
      ar_module.setZoomRate(_r - rate);
      zooming = true;
    }
  }

  function mouseMultiDragged(vec_x, vec_y) {
    if (!ar_module || !ar_module.isARMode()) {
      this.model_viewer.rotateSelectModel_atScreenXY(vec_x, vec_y);
    }
  }

  function mouseMultiRotate(angle) {
  }

  function mousePressed(x, y, time) {

    if (hint_buffer.len() > 0) {
      hint_buffer[0].removed();
    }

    this.press_time = skGetTime();
    this.press_pos.x = x;
    this.press_pos.z = y;
    this.press_pos_old.x = x;
    this.press_pos_old.z = y;
    this.first_route = { x = x, z = y, t = time };
  }

  function mouseClicked(x, y) {

    this.model_viewer.screenTapped(x, y);

    local _chara_id = this.model_viewer.getCurrentCharaID();
    if (this.old_current_chara_id != _chara_id) {
      this.old_current_chara_id = _chara_id;
      setCharaIcon(_chara_id);
      updateNextMotionButtonVisible();
    }
  }

  function mouseDragged(vec_x, vec_y, time) {
    if (!ar_module || !ar_module.isARMode()) {
      this.model_viewer.moveSelectModel_atScreenPos(vec_x, vec_y);
    }

    if (this.multi_tapped) return;
    move_vec_buf.x += vec_x;
    move_vec_buf.z += vec_y;

    if (getCurrentCharaUIEnable()) {
      local _dpos = { x = this.press_pos_old.x + move_vec_buf.x, z = this.press_pos_old.z + move_vec_buf.z, t = time };
      if (::getDistance(this.press_pos_old, _dpos) > 10) {
        if (this.first_route) {

          this.model_viewer.clearMoveRoute();
          this.model_viewer.addMoveRoute(this.first_route);
          this.first_route = null;
        }
        this.press_pos_old.x = _dpos.x;
        this.press_pos_old.z = _dpos.z;
        this.move_vec_buf.x = this.move_vec_buf.z = 0.0;
        this.model_viewer.addMoveRoute(_dpos);
      }
    }
  }

  function getARCharaModelByCostumeId(cos_id) {
    local _chara_id = ::gamesetting.costume_settings[cos_id].getCharaID();
    return this.model_viewer.getChara(_chara_id);
  }
  function getARFurnitureModel(fuid) {
    return this.model_viewer.getFurnitureModel(fuid);
  }
  function getModelViewer() {
    return this.model_viewer;
  }

  function getLastExecuteMotionID() {
    return this.model_viewer.getLastExecuteMotionID();
  }

  function getARModule() {
    return this.ar_module;
  }

  function getCaptureState() {
    return this.capture_state;
  }

  function _restartCamera(video_state = -1) {
    _restartCameraProcess(function() {
      self.ar_module.restartCameraDevice(video_state);
    }.bindenv({ self = this, video_state = video_state }));
  }

  function _restartCameraProcess(func) {
    if (!ENABLE_AR || pausing) return;
    if (is_capture) {
      switch (capture_state) {
      case CAPTURE_STATE_PHOTO:
        if (isShot()) return;
        try {
          ar_module.waitSaveImageThread();
        } catch (ex) {

          fps_message_timeout_id = setTimeout(function() {
            _restartCamera(ARModuleAndroid.VIDEO_IMAGE_SIZE_LOW);
            fps_message_timeout_id = -1;
          }.bindenv(this), 500);
          return;
        }
        this.pnl_capturing.setVisible(false);
        changeCaptureMode(CAPTURE_STATE_VIDEO);
        break;
      case CAPTURE_STATE_VIDEO:

        if (ar_module.movie_writer) ar_module.movie_writer.end();
        model_viewer.removeImageViewer();
        _startsave();
        last_state = 0;
        break;
      }
    }

    func();

    changeDetectState(STATE_SEARCHING);

    local _ud = ::gamesession.getUserData();
    if (_ud.hasHapinessAction()) {
      _ud.failHapinessAction(_ud.getHapinessActionCosId());
    }
    model_viewer.clearCharaParam();
    model_viewer.releaseAllBalloons();
    model_viewer.interruptDragRouteThread();

    is_reseted = false;
    is_capture = false;
    _resetDetectTimeout();
  }

  function changePlaneDetection(btn_on, btn_off) {
    if (!ENABLE_AR) return;

    if (is_capture && capture_state == CAPTURE_STATE_PHOTO) {
      if (isShot()) return;
      ar_module.waitSaveImageThread();
      this.pnl_capturing.setVisible(false);
      changeCaptureMode(CAPTURE_STATE_VIDEO);

      is_capture = false;
    }

    ar_module.changeARMode(is_capture, capture_state);

    foreach (_particle_map in model_viewer.landmark_particle_map) {
      if (_particle_map[0]) model_viewer.scene.removeObject(_particle_map[0]);
      _particle_map[0] = null;
    }

    model_viewer.clearCharasAction();
    is_reseted = false;

    if (!ar_module.isARMode()) {

      model_viewer.selectAllModels();
      mouseevent_manager.refreshAll();

      changeDetectState(STATE_NO_DETECT);
      btn_on.setVisible(false);
      btn_off.setVisible(true);
    } else {
      changeDetectState(STATE_SEARCHING);
      btn_on.setVisible(true);
      btn_off.setVisible(false);
    }

    _resetDetectTimeout();
  }

  function _resetARParam() {

    if (is_capture && capture_state == CAPTURE_STATE_PHOTO) {
      if (isShot()) return;
      try {
        ar_module.waitSaveImageThread();
      } catch (ex) {

        this.detect_timeout_id = setTimeout(_resetARParam.bindenv(this), 500);
        return;
      }
      is_capture = false;
      this.pnl_capturing.setVisible(false);
      changeCaptureMode(CAPTURE_STATE_VIDEO);
    }
    ar_module.reset();
    changeDetectState(STATE_SEARCHING);

    is_reseted = false;

    model_viewer.setFurnituresVisible(false);

    local _ud = ::gamesession.getUserData();
    if (_ud.hasHapinessAction()) {
      _ud.failHapinessAction(_ud.getHapinessActionCosId());
    }

    model_viewer.clearCharaParam();
    model_viewer.releaseAllBalloons();
    model_viewer.interruptDragRouteThread();

    this.btn_exec_motion.setEnabled(true);
    this.ar_chara_menu_layer.setEnableListButtons(true);
    this.chara_ui_state = {};

    _resetDetectTimeout();
  }

  function _resetDetectTimeout() {
    if (detect_timeout_id != -1) {
      clearInterval(detect_timeout_id);
      this.detect_timeout_id = -1;
    }
  }

  function startCharasScripts() {

    model_viewer.startCharasScripts();
  }

  function processBack(view) {

    local _home_ui = getHomeUI();
    local game_scene = _home_ui.getGameScene();
    local stage = game_scene.getStage();

    game_scene.startStageUpdate();

    if (view.name.equals("btn_back") || view.name.equals("btn_home")) {

      if (ENABLE_AR && this.ar_module.getCacheCount() > 0) {

        this.ar_module.waitSaveImageThread();

        local _size = this.ar_module.getStillImageSize();
        _home_ui.movePanel(::GalleryPanel, false, { back_to_home = true, picture_state_table = {}, image_size = _size });
        return;
      } else {
        _home_ui.panel_history.clear();
      }
    }

    _home_ui.backTapped();
  }

  function isShot() { return is_shot; }
  function isCapture() { return is_capture; }

  function setShot(b) {
    this.is_shot = b;
  }

  function reachedCaptureLimit() {
    return NUMBER_OF_POSSIBLE_SHOTS > 0 && this.ar_module.getCacheCount() >= NUMBER_OF_POSSIBLE_SHOTS;
  }

  function endRecordMovie() {
    local _end_sucess = ar_module.movie_writer.end();
    if (!_end_sucess) return;

    model_viewer.removeImageViewer();
    last_state = 0;
    is_capture = false;

    _startsave();
  }

  function displayPicture(texture, thumbnail_texture, picture_length, movie = false) {
    _procShutterChance(texture);

    this.pictures.setCaptureNum(picture_length, NUMBER_OF_POSSIBLE_SHOTS);

    if (reachedCaptureLimit()) {
      this.btn_capture.setColor(0x888888ff);
      this.btn_record.setColor(0x888888ff);
    }
    switch (picture_length) {
    case 2:
      this.pictures.backPicktureVisible(true);

    case 1:
      this.pictures.setVisible(true);
      break;
    }
    this.pictures.setPicture(thumbnail_texture);
    if (movie) this.pictures.setPlayButton();
  }

  function _procShutterChance(texture) {
    local _add_gm = this.model_viewer.getAddGameMoney();
    if (_add_gm < 0) return;

    local _picture = Picture(texture);
    this.picture_move_layer.setPicture(_picture);
    sleep(1000);

    _picture.showText();
    ::gamesession.getCurrentScene().showGetHapinessEffectAndAddGM(null, _add_gm, this.model_viewer.renderer.camera, false);
    sleep(4000);
    _picture.hideText();

    this.picture_move_layer.executeMove();
    sleep(250);
    this.picture_move_layer.visible = false;

    this.model_viewer.resetAddGameMoney();
  }

  function setEnableMotions(s, chara_id) {
    if (this.chara_ui_state[chara_id] == UI_STATE_DISABLE_CANT_INTERRUPT && s == UI_STATE_ENABLE) return;
    this.chara_ui_state[chara_id] <- s;

    _setEnableMotionButton(chara_id);
  }

  function _setEnableMotionButton(chara_id) {
    local _enable = this.chara_ui_state[chara_id] == UI_STATE_ENABLE;
    this.ar_chara_menu_layer.setEnableListButtons(_enable);

    if (_enable) {
      this.btn_exec_motion.setEnabled(true);
      this.img_playing.visible = false;
      this.btn_exec_motion_lock.visible = false;
    }
    else if (this.select_motion) {
      local _motion;
      if (this.model_viewer) _motion = ::gamesetting.costume_motion_settings[this.model_viewer.getLastExecuteMotionID()];

      if (this.select_motion == _motion) {

        this.img_playing.visible = true;
        this.btn_exec_motion.setEnabled(true);
        this.btn_exec_motion_lock.visible = true;
      }
      else {

        this.img_playing.visible = false;
        local _as = ::gamesetting.costume_motion_settings[this.model_viewer.getLastExecuteMotionID()];
        if (_as && !_as.canInterrupt()) this.btn_exec_motion.setEnabled(false);
        else this.btn_exec_motion.setEnabled(true);
        this.btn_exec_motion_lock.visible = false;
      }
    }
    else {

      this.img_playing.visible = false;
      local _as = ::gamesetting.costume_motion_settings[this.model_viewer.getLastExecuteMotionID()];
      if (_as && !_as.canInterrupt()) this.btn_exec_motion.setEnabled(false);
      else this.btn_exec_motion.setEnabled(true);
      this.btn_exec_motion_lock.visible = false;
    }
  }

  function getCharaUIEnable(chara_id) {
    if (!this.chara_ui_state[chara_id]) return true;
    return this.chara_ui_state[chara_id] == UI_STATE_ENABLE;
  }

  function getCurrentCharaUIEnable() {
    local _chara_id = this.model_viewer.getCurrentCharaID();
    if (!this.chara_ui_state[_chara_id]) return true;
    return this.chara_ui_state[_chara_id] == UI_STATE_ENABLE;
  }

  function setCharaShadowVisible(b, chara_id) {
    local _chara = this.getModelViewer().getCharas()[chara_id];
    _chara.shadowVisible(b);
  }
}

class CaptureView extends SKViewEx {
  function renderToBufferExtension(buf, bufflags, fxlist, target_scale = 1.0) {
    _renderToBuffer(buf, bufflags, fxlist, target_scale);
  }
}

class ::ARPanel.Hint {
  view = null;

  thread = null;
  showed = null;

  function removed() {
    if (thread) {
      thread.wakeupThrow("stop");
    }
    thread = null;
  }

  function showBalloon(t) {
    if (showed) return;
    showed = true;

    local _env = {
      view = this.view;
      time = t;
    }

    local _func = function() {
      try {
        local _start = skGetTime();
        local _time = _start;
        local _reach = false;
        while (_time - _start < 3000 + time) {
          if (!_reach && _time - _start >= time) {
            view.setVisible(true);
            _reach = true;
          }
          sleep(16);
          _time = skGetTime();
        }
      } catch (ex) {
        if (ex != "stop") {
          printexception(ex);
        }
      }
      view.setVisible(false);
    };

    thread = newthread();
    thread.start(_func.bindenv(_env));
  }

  function isRunning() {
    return isThreadRunning(thread);
  }
}

class ::ARPanel.HintBalloon extends ::ARPanel.Hint {
  constructor(view, text) {
    this.view = view;
    this.view.pickable = false;
    this.view.setVisible(false);
    this.showed = false;
    this.view.findChild("lbl_desc").setText(text);
  }
}

class ::ARPanel.HintView extends ::ARPanel.Hint {

  constructor(view) {
    this.view = view;
    this.view.pickable = false;
    this.view.setVisible(false);
    this.showed = false;
  }

  function setTexts(...) {
    if (vargc != 3) return;

    this.view.findChild("lbl_trans").setText(vargv[0]);
    this.view.findChild("lbl_rotate").setText(vargv[1]);
    this.view.findChild("lbl_scale").setText(vargv[2]);
  }
}

class ::ARPanel.Pictures {
  btn = null;

  pnl_picture = null;
  pnl_backpicture = null;
  bg = null;
  panel = null;

  play_button = null;

  original_size = null;

  lbl_capture_num = null;

  constructor(v, panel) {
    this.btn = v;
    this.panel = panel;

    this.pnl_backpicture = this.btn.findChild("pnl_backpicture");
    this.pnl_picture = this.btn.findChild("pnl_picture");
    this.lbl_capture_num = this.btn.findChild("lbl_capture_num");

    backPicktureVisible(false);
    ::TapButton(this.btn).view.addEventListener(ACTION_EVENT, _actionevent_movegallery);
  }

  function setPictureSize(arr) {
    local _bg = this.btn.findChild("bg");
    local _idx = this.btn.removeChild(_bg);

    local _w = _bg.bnd.w;
    local _h = _bg.bnd.h;
    local _aspect = float(arr[0]) / arr[1];
    if (_aspect > 1.0) _h = _w * float(arr[1]) / arr[0];
    else _w = _h * float(arr[0]) / arr[1];
    _bg.centerize();

    local _rgba = RGBAImage(_w, _h, 0xff000000);
    local _t = Texture();
    _t.load(_rgba);
    this.bg = SKImageView(_t);
    this.bg.centerize();
    this.bg.pos.set(_bg.pos.x, _bg.pos.y, 0.0);

    this.btn.insertChild(_idx, this.bg);
  }

  function setVisible(b) {
    this.btn.setVisible(b);
  }

  function backPicktureVisible(b) {
    this.pnl_backpicture.setVisible(b);
  }

  function setPicture(tex) {
    local _iv = SKImageView(tex);
    this.pnl_picture.clearChildren();

    local _w = _iv.bnd.w;
    local _h = _iv.bnd.h;

    this.original_size = [_w, _h];

    if (_w / _h > 1.0) {

      local _rate = this.bg.bnd.w / _w;
      _w = this.bg.bnd.w;
      _h *= _rate;
    }
    else {

      local _rate = this.bg.bnd.h / _h;
      _w *= _rate;
      _h = this.bg.bnd.h;
    }

    _iv.setRect(0, 0, _w, _h);

    this.pnl_picture.setRect(0, 0, _w, _h);
    this.pnl_picture.centerize();
    this.pnl_picture.pos.set(this.btn.bnd.w / 2.0, this.btn.bnd.h / 2.0);
    this.pnl_picture.addChild(_iv);
  }

  function setCaptureNum(cache, max) {
    if (max <= 0) {
      this.lbl_capture_num.setVisible(false);
      return;
    }
    if (cache >= max) this.lbl_capture_num.setColor(0xff0000ff);
    this.lbl_capture_num.setText(::dict.get("nums_slash", [cache, max]));
  }

  function setPlayButton() {
    if (!this.play_button) {
      local _v = ::loadSKView("/ui/common/PlayButton.ui");

      _v.scale(0.5);
      _v.centerize();
      this.play_button = _v;
    }
    this.play_button.pos.set(this.pnl_picture.bnd.w / 2.0, this.pnl_picture.bnd.h / 2.0, 0.0);
    this.pnl_picture.addChild(this.play_button);
  }

  function _actionevent_movegallery(e) {

    local _home_ui = this.panel.getHomeUI();
    local _module = this.panel.getARModule();
    local _size = _module.getStillImageSize();

    local _charas = this.panel.getModelViewer().getCharas();

    local _costume_ids = [];
    foreach (_chara in _charas) {
      _costume_ids + { cids = [_chara.getCostumeData().getID()], fuid = -1 };
    }

    _module.waitSaveImageThread();
    _home_ui.movePanel(::GalleryPanel, false, { taking_id_table = _costume_ids, picture_state_table = {}, image_size = _size });
  }
}

class ::ARPanel.RecordTimeLayer {
  view = null;

  lbl_time = null;

  constructor(view) {
    this.view = view;
    this.lbl_time = this.view.findChild("lbl_time");
  }

  function setTime(min, sec) {
    this.lbl_time.setText(::dict.get("nums_colon", [min, sec]));
  }

  function setVisible(b) {
    this.view.setVisible(b);
  }

}