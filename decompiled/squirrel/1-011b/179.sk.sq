with Serializable() {

  class WorkRewardData {
    static SerialVersion = 1;

    costume_id = -1;
    reward_list = null;
    reward_version_list = null;

    constructor() {
    }

    function createWorkRewardData(cid) {
      local _wrd = ::WorkRewardData();
      _wrd.costume_id = cid;
      _wrd.reward_list = {};
      _wrd.reward_version_list = {};
      return _wrd;
    }

    static function loadWithCreate(loader) {
      local _data = ::WorkRewardData.createWorkRewardData(loader.get());
      local _reward_list_num = loader.get();
      for (local i = 0; i < _reward_list_num; i++) {
        local _key = loader.get();
        local _list_num = loader.get();
        local _list = [];
        for (local j = 0; j < _list_num; j++) {
          _list + loader.get();
        }
        _data.reward_list[_key] <- _list;
      }
      local _reward_version_list_num = loader.get();
      for (local i = 0; i < _reward_version_list_num; i++) {
        local _key = loader.get();
        _data.reward_version_list[_key] <- loader.get();
      }
      return _data;
    }

    function getCostumeID() {
      return this.costume_id;
    }

    function addIndex(wid, idx) {
      local _cas = ::gamesetting.costume_action_settings[wid];
      if (!_cas) return;

      local _ver = _cas.getRewardVersion();
      local _reset = false;
      if (this.reward_version_list[wid] != _ver) {
        this.reward_version_list[wid] <- _ver;
        _reset = true;
      }

      local _list = this.reward_list[wid];
      if (_reset || !_list) {
        _list = [];
        this.reward_list[wid] <- _list;
      }

      for (local i = 0; i < _list.len(); i++) {
        if (_list[i] == idx) return;
      }
      _list + idx;
    }

    function contain(wid, idx) {
      local _cas = ::gamesetting.costume_action_settings[wid];
      if (!_cas) return false;
      if (_cas.getRewardVersion() != this.reward_version_list[wid]) return false;

      local _list = this.reward_list[wid];
      if (!_list) return false;

      for (local i = 0; i < _list.len(); i++) {
        if (_list[i] == idx) return true;
      }
      return false;
    }

    function getRewardRate(wid) {
      local _cas = ::gamesetting.costume_action_settings[wid];
      if (!_cas) return 1;
      if (_cas.getRewardVersion() != this.reward_version_list[wid]) return 0;

      local _ret = 0;
      local _rt = ::gamesetting.costume_action_settings[wid].getRewardTable();
      if (!_rt || _rt.len() == 0) return 1;
      local _list = this.reward_list[wid];
      if (!_list || _list.len() == 0) return 0;

      return float(_list.len()) / float(_rt.len());
    }

    function getCostumeRewardRate() {

      local _setting = ::gamesetting.costume_settings[this.costume_id];
      if (!_setting) return 0;
      local _sum_reward = _setting.getWorkRewardNum();
      if (_sum_reward == 0) return 1;

      local _cass = ::gamesetting.costume_action_settings;
      local _sum_clear = 0;
      foreach (k, l in this.reward_list) {
        local _cas = _cass[k];
        if (!_cas) continue;
        if (_cas.getRewardVersion() != this.reward_version_list[k]) continue;
        if (l) _sum_clear += l.len();
      }

      return float(_sum_clear) / float(_sum_reward);

    }
  }

}