local GRID_LENGTH = ::FurnitureLayoutManager.FURNITURE_MODE_DIST / 2.0;

class RoomInfo {
  static FURNITURE_CAPACITY_RATE = 0.8;

  grid = null;
  furniture_infos = null;
  wall_infos = null;

  room_setting_id = -1;

  constructor() {
    this.grid = Grid();
    this.furniture_infos = {};
    this.wall_infos = [];
  }

  function getPolygonMeshGridWire() {
    return this.grid.getPolygonMeshGridWire();
  }

  function reset() {
    _reset_grid();
    _reset_furniture_infos();
  }
  function _reset_grid() {
    this.grid.clear();
    this.wall_infos.clear();
  }
  function _reset_furniture_infos() {
    Table.clear(this.furniture_infos);
    this.grid.validateAll();
  }

  function enableAddFurniture() {
    if (!this.grid) return false;
    local _invalid = this.grid.getTotalNodeNum() - this.grid.getValidNodeNum();
    return _invalid < _getFurnitureCapacity() ? true : false;
  }

  function _getFurnitureCapacity() {
    if (!this.grid) return 0;
    return int(this.grid.getTotalNodeNum() * FURNITURE_CAPACITY_RATE);
  }

  static SETUP_ALL = 1;
  static SETUP_GRID = 16;
  static SETUP_FURNITURES = 256;
  static SETUP_NEW_FURNITURES = 4096;
  static SETUP_INVALIDATE = 65536;
  static SETUP_CONNECT = 1048576;
  function setup(room_uid, flags = 1) {
    local ud = ::gamesession.getUserData();
    local room_data = ud.getRoomEditData(room_uid);
    if (!room_data) {
      ::errorln("invalid room uid : " + room_uid);
      return;
    }

    _setupProcess(room_data, flags);

  }

  function setupByRoomEditData(room_data, flags = 1) {
    local ud = ::gamesession.getUserData();
    _setupProcess(room_data, flags);
  }

  function isNode(x, z) {
    local x_idx = (x - grid.pos_left) / GRID_LENGTH;
    local z_idx = (z - grid.pos_bottom) / GRID_LENGTH;
    return this.grid.isNode(x_idx, z_idx);
  }

  function isValidNode(x, z) {
    local x_idx = (x - grid.pos_left) / GRID_LENGTH;
    local z_idx = (z - grid.pos_bottom) / GRID_LENGTH;
    return this.grid.isValidNode(x_idx, z_idx);
  }

  function isValidNodesAtPos(x, z) {
    local x_idx = (x - grid.pos_left) / GRID_LENGTH;
    local z_idx = (z - grid.pos_bottom) / GRID_LENGTH;

    if (grid.isValidNode(x_idx, z_idx)) return true;
    if (grid.isValidNode(x_idx + 1, z_idx)) return true;
    if (grid.isValidNode(x_idx, z_idx + 1)) return true;
    if (grid.isValidNode(x_idx + 1, z_idx + 1)) return true;

    return false;
  }

  function getRoomSettingID() {
    return this.room_setting_id;
  }

  function getNearNodePos(x, z) {
  }

  function getNearestNodePos(x, z) {
    return this.grid.getNearestNodePos(x, z);
  }
  function getNearestValidNodePos(x, z) {
    return this.grid.getNearestNodePos(x, z, true);
  }

  function getRandomNodePos() {
    return this.grid.getRandomNodePos();
  }

  function getValidNodePos(check_func = null) {
    local _p = this.grid.getValidNodePos(check_func);
    if (!_p) _p = Vector3D();
    return _p;
  }

  function getNodePosListNearXZ(x, z) {
    return this.grid.getNodePosListNearXZ(x, z);
  }

  function getFurnitureNodePos(furniture_uid) {

  }

  function getRoute(from, to) {
    return this.grid.getRoute(from, to);
  }

  function getVertexCoordinateWithWall(x1, y1, x2, y2) {
    local isLineCrossed = ::isLineCrossed;
    local getVertexCoordinate = ::getVertexCoordinate;
    local c1, c2;
    local ret = null;
    local calc = null;
    local xdist, ydist;
    local distsq;
    local min_distsq = 100000.0;
    foreach (info in this.wall_infos) {
      c1 = info.coord1;
      c2 = info.coord2;
      if (!isLineCrossed(x1, y1, x2, y2, c1.x, c1.z, c2.x, c2.z)) continue;

      calc = getVertexCoordinate(x1, y1, x2, y2, c1.x, c1.z, c2.x, c2.z);

      xdist = calc[0] - x1;
      ydist = calc[1] - y1;
      distsq = xdist * xdist + ydist * ydist;
      if (distsq < min_distsq) {
        min_distsq = distsq;
        ret = calc;
      }
    }

    return ret;
  }

  function getTotalNodeNum() {
    return this.grid.getTotalNodeNum();
  }

  function hasFurnitureInfo(furniture_uid) {
    return furniture_uid in this.furniture_infos;
  }

  function addFurniture(furniture_layout_data, furniture_id, force = false) {
    local furniture_uid = furniture_layout_data.getUID();
    if (furniture_uid in this.furniture_infos && !force) return null;

    local furniture_info = FurnitureInfo().setup(furniture_layout_data, furniture_id);
    this.furniture_infos[furniture_uid] <- furniture_info;

    return furniture_info;
  }

  function updateFurnitureInfo(furniture_layout_data) {
    local furniture_uid = furniture_layout_data.getUID();
    if (!(furniture_uid in this.furniture_infos)) return;

    local ud = ::gamesession.getUserData();
    local furniture_id = ud.getFurnitureData(furniture_uid).getID();
    local furniture_info = this.furniture_infos[furniture_uid];
    furniture_info.setup(furniture_layout_data, furniture_id);
  }

  function removeFurniture(furniture_uid) {
    local removed_info = delete this.furniture_infos[furniture_uid];
    return removed_info != undefined;
  }

  function removeAllFurniture() {
    Table.clear(this.furniture_infos);
  }

  function calcFurniturePos(edit_model, x, z, angle) {

    return _calcFurniturePosByLineCross(edit_model, x, z, angle);
  }

  function calcFurnitureRotate(edit_model, x, z, angle) {
    local furniture_model = edit_model.getModel();
    if (_calcFurniturePosByLineCross(edit_model, x, z, angle)) {
      return true;
    }
    else {
      furniture_model.setAngle(angle);
      if (!edit_model.isOrverlapState()) {

        edit_model.disableFixButton(RoomEditPanel.EditModel.FIX_STATE_OUTSIDE);
      }
      return false;
    }
  }

  function _calcFurniturePosByLineCross(edit_model, x, z, angle) {
    local room_setting = ::gamesetting.room_settings[this.room_setting_id];

    local furniture_model = edit_model.getModel();
    local model_pos = furniture_model.getPos();
    local furniture_setting = furniture_model.getFurnitureSetting();

    local near_pos = getNearestNodePos(x, z);

    if (!near_pos) {
      return false;
    }
    local np_x = near_pos.x;
    local np_z = near_pos.z;

    local ox = furniture_setting.size_origin_x;
    local oz = furniture_setting.size_origin_z;
    local _hw = ::round(furniture_setting.size_w / 2.0, Math.pow(10.0, -3));
    local _hd = ::round(furniture_setting.size_d / 2.0, Math.pow(10.0, -3));
    local _vlist = getFurnitureVertex(ox, oz, _hw, _hd, angle);
    local _pvlist = [];
    foreach (v in _vlist) {
      _pvlist + { x = v.x + np_x, z = v.z + np_z };
    }

    local disable = _checkOverlapNode(_vlist, _pvlist, np_x, np_z, ox, oz, _hw, _hd, angle);
    if (disable == -1) {

      return false;
    }
    else if (disable == 1) {

      if (furniture_setting.isOverlaid()) edit_model.enableFixButton();
      else edit_model.disableFixButton(RoomEditPanel.EditModel.FIX_STATE_OVERLAP);
    }
    else {

      edit_model.enableFixButton();
    }

    model_pos.set(np_x, model_pos.y, np_z);
    furniture_model.setAngle(angle);

    return true;
  }

  function convertGridVertex(left, bottom, vlist, x, z) {
    local _glist = [];
    local _togrid = RoomInfo.posToGrid;
    foreach (v in vlist) {
      _glist + { x = _togrid(v.x, left, x < v.x), z = _togrid(v.z, bottom, z < v.z) };
    }
    return _glist;
  }

  function getFurnitureVertex(ox, oz, hw, hd, angle) {
    local _pl = array(4);
    local _r = angle * Math.DTOR;
    local _cosr = Math.cos(_r);
    local _sinr = Math.sin(_r);
    if (angle % 90 == 0) {
      local _ox = -ox * _cosr - oz * _sinr;
      local _oz = ox * _sinr - oz * _cosr;
      local _x = hw * _cosr + hd * _sinr;
      local _z = hw * _sinr + hd * _cosr;
      local x_min, x_max;
      if (_x > 0) {
        x_min = _ox - _x;
        x_max = _ox + _x;
      }
      else {
        x_min = _ox + _x;
        x_max = _ox - _x;
      }

      local z_min, z_max;
      if (_z > 0) {
        z_min = _oz - _z;
        z_max = _oz + _z;
      }
      else {
        z_min = _oz + _z;
        z_max = _oz - _z;
      }

      local lx = RoomInfo.roundGrid(::round(x_min, 0.001), x_min < 0.0);
      local rx = RoomInfo.roundGrid(::round(x_max, 0.001), x_max > 0.0);
      local fz = RoomInfo.roundGrid(::round(z_min, 0.001), z_min < 0.0);
      local bz = RoomInfo.roundGrid(::round(z_max, 0.001), z_max > 0.0);

      _pl[0] = { x = lx, z = fz };
      _pl[1] = { x = lx, z = bz };
      _pl[2] = { x = rx, z = fz };
      _pl[3] = { x = rx, z = bz };
    }
    else {

      local _ox = -ox * _cosr - oz * _sinr;
      local _oz = ox * _sinr - oz * _cosr;

      local x0 = _ox - hw * _cosr + hd * _sinr;
      local z0 = _oz - hw * _sinr - hd * _cosr;
      local x1 = _ox - hw * _cosr - hd * _sinr;
      local z1 = _oz - hw * _sinr + hd * _cosr;
      local x2 = _ox + hw * _cosr + hd * _sinr;
      local z2 = _oz + hw * _sinr - hd * _cosr;
      local x3 = _ox + hw * _cosr - hd * _sinr;
      local z3 = _oz + hw * _sinr + hd * _cosr;

      local x_min = x0; if (x_min > x1) x_min = x1; if (x_min > x2) x_min = x2; if (x_min > x3) x_min = x3;
      local x_max = x0; if (x_max < x1) x_max = x1; if (x_max < x2) x_max = x2; if (x_max < x3) x_max = x3;
      local z_min = z0; if (z_min > z1) z_min = z1; if (z_min > z2) z_min = z2; if (z_min > z3) z_min = z3;
      local z_max = z0; if (z_max < z1) z_max = z1; if (z_max < z2) z_max = z2; if (z_max < z3) z_max = z3;

      _pl[0] = { x = x0, z = z0 };
      _pl[1] = { x = x1, z = z1 };
      _pl[2] = { x = x2, z = z2 };
      _pl[3] = { x = x3, z = z3 };
    }
    return _pl;
  }

  function isInArea(x, z, ox, oz, w, h, angle) {
    local r1 = angle * Math.DTOR;

    local l1 = Math.sqrt(x * x + z * z);
    local r2 = Math.atan2(x, z);

    local r3 = r2 - r1;
    local tx = l1 * -Math.sin(r3);
    local tz = l1 * -Math.cos(r3);

    local result = ox - w <= tx && tx <= ox + w && oz - h <= tz && tz <= oz + h;
    return result;
  }

  function isInRect(x, z, ox, oz, hw, hd, angle) {
    local _grid_len = RoomInfo.Grid.GRID_LENGTH;
    local _inArea = RoomInfo.isInArea;
    if (_inArea(x - _grid_len, z - _grid_len, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x - _grid_len, z, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x - _grid_len, z + _grid_len, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x, z - _grid_len, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x, z, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x, z + _grid_len, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x + _grid_len, z - _grid_len, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x + _grid_len, z, ox, oz, hw, hd, angle)) {
      return true;
    }
    if (_inArea(x + _grid_len, z + _grid_len, ox, oz, hw, hd, angle)) {
      return true;
    }

    return false;
  }

  function _getGridRectIncludeRect(vlist, posx, posz) {
    local vl1 = vlist[0];
    local vl2 = vlist[1];
    local vl3 = vlist[2];
    local vl4 = vlist[3];

    vl1.x += posx;
    vl1.z += posz;
    vl2.x += posx;
    vl2.z += posz;
    vl3.x += posx;
    vl3.z += posz;
    vl4.x += posx;
    vl4.z += posz;

    local vx, vz;
    local left, right, bottom, top;
    foreach (v in vlist) {
      vx = v.x;
      vz = v.z;
      if (left == null || left > vx) left = vx;
      if (right == null || right < vx) right = vx;
      if (bottom == null || bottom > vz) bottom = vz;
      if (top == null || top < vz) top = vz;
    }

    local grid_length = GRID_LENGTH;
    if (left % grid_length != 0.0) left = int(left / grid_length - (left < 0 ? 1 : 0)) * grid_length;
    if (right % grid_length != 0.0) right = int(right / grid_length + (right > 0 ? 1 : 0)) * grid_length;
    if (bottom % grid_length != 0.0) bottom = int(bottom / grid_length - (bottom < 0 ? 1 : 0)) * grid_length;
    if (top % grid_length != 0.0) top = int(top / grid_length + (top > 0 ? 1 : 0)) * grid_length;

    return [left, right, bottom, top];
  }

  function getCoverRect(list) {
    local _left = list[0].x;
    local _right = list[0].x;
    local _bottom = list[0].z;
    local _top = list[0].z;

    for (local i = 1; i < list.len(); i++) {
      local _gx = list[i].x;
      local _gz = list[i].z;
      if (_left > _gx) _left = _gx;
      else if (_right < _gx) _right = _gx;
      if (_bottom > _gz) _bottom = _gz;
      else if (_top < _gz) _top = _gz;
    }

    return { x = _left, z = _bottom, w = _right, h = _top };
  }

  function _checkOverlapNode(vlist, pvlist, posx, posz, ox, oz, hw, hd, angle) {
    local _all_nodes = this.grid.all_nodes;
    local _left = this.grid.pos_left;
    local _bottom = this.grid.pos_bottom;
    local _ret = 0;
    if (angle % 90 == 0) {
      local _glist = convertGridVertex(_left, _bottom, pvlist, posx, posz);
      local _grect = getCoverRect(_glist);

      for (local z = _grect.z; z <= _grect.h; z++) {
        local _z_nodes = _all_nodes[z];
        for (local x = _grect.x; x <= _grect.w; x++) {
          local _node = _z_nodes[x];
          if (!_node) {
            return -1;
          }
          else if (!_node.isValid() && z != _grect.z && z != _grect.h && x != _grect.x && x != _grect.w) {

            _ret = 1;
          }
        }
      }
    }
    else {
      local _grid_len = RoomInfo.Grid.GRID_LENGTH;
      local _inRect = isInRect;

      local cover_rect = ::RoomInfo._getGridRectIncludeRect(vlist, posx, posz);
      local left = cover_rect[0];
      local right = cover_rect[1];
      local bottom = cover_rect[2];
      local top = cover_rect[3];
      local valid_node_info = [];
      local valid_node_part = null;
      for (local z = bottom; z <= top; z += _grid_len) {
        valid_node_part = [];
        valid_node_info + valid_node_part;
        for (local x = left; x <= right; x += _grid_len) {
          if (_inRect(x - posx, z - posz, ox, oz, hw, hd, angle)) {
            local _gx = int((x - _left) / _grid_len);
            local _gz = int((z - _bottom) / _grid_len);
            local _node = _all_nodes[_gz][_gx];
            if (!_node) {
              return -1;
            }

            else {

              if (length(valid_node_part) < 2) {
                valid_node_part + _gx;
                valid_node_part + _gx;
              }
              else {
                valid_node_part[1] = _gx;
              }
            }
          }
        }
      }

      if (length(valid_node_info) != 0) {
        local check_node_info = [];
        local check_node_part = null;
        foreach (idx, node_info in valid_node_info) {

          check_node_part = [];
          check_node_info + check_node_part;
          local prev_node_info = valid_node_info[idx - 1];
          local next_node_info = valid_node_info[idx + 1];
          if (length(node_info) != 0 && prev_node_info && length(prev_node_info) != 0 && next_node_info && length(next_node_info) != 0) {

            check_node_part + node_info[0] + 1;
            if (check_node_part[0] < prev_node_info[0] + 1) {
              check_node_part[0] = prev_node_info[0] + 1;
            }
            if (check_node_part[0] < next_node_info[0] + 1) {
              check_node_part[0] = next_node_info[0] + 1;
            }

            check_node_part + node_info[1] - 1;
            if (check_node_part[1] > prev_node_info[1] - 1) {
              check_node_part[1] = prev_node_info[1] - 1;
            }
            if (check_node_part[1] > next_node_info[1] - 1) {
              check_node_part[1] = next_node_info[1] - 1;
            }
          }
        }

        foreach (idx, node_info in check_node_info) {
          if (!node_info || length(node_info) == 0) continue;

          local node;
          local z = (bottom - _bottom) / _grid_len + idx;
          local x_max = node_info[1];
          for (local x = node_info[0]; x <= x_max; x++) {
            node = _all_nodes[z][x];
            if (!node.isValid()) {
              _ret = 1;
              break;
            }
          }
          if (_ret == 1) break;
        }

      }
    }
    return _ret;
  }

  function roundGrid(val, is_round_up) {
    return is_round_up ? ::roundUp(val, GRID_LENGTH) : roundDown(val, GRID_LENGTH);

  }

  function posToGrid(p, end, ru = false) {
    local _r = 0;
    if (ru) {
      local _v = int((p % RoomInfo.Grid.GRID_LENGTH) * 1000);
      if (_v != 0) _r = 1;
    }
    return int((p - end) / RoomInfo.Grid.GRID_LENGTH) + _r;
  }

  function _calcFurniturePosOnGrid(edit_model, x, z, angle) {
    local furniture_model = edit_model.getModel();
    local model_pos = furniture_model.getPos();
    local furniture_setting = furniture_model.getFurnitureSetting();

    local grid_length = RoomInfo.Grid.GRID_LENGTH;
    local Math = Math;
    local abs = Math.abs;
    local sin = Math.sin;
    local cos = Math.cos;
    local dir = angle * Math.DTOR;
    local size_hw = furniture_setting.size_w / 2.0;
    local size_hd = furniture_setting.size_d / 2.0;
    local w = abs(size_hw * cos(dir)) + abs(size_hd * sin(dir));
    local h = abs(size_hw * sin(dir)) + abs(size_hd * cos(dir));

    local gw = angle % 90 == 0 ? w : (int(w / grid_length + 1) * grid_length);
    local gh = angle % 90 == 0 ? h : (int(h / grid_length + 1) * grid_length);
    local points = [x - gw, x + gw, z - gh, z + gh];

    local near_pos = getNearestNodePos(x, z);

    if (!near_pos) {
      return;
    }

    local diff_x = x - near_pos.x;
    local diff_z = z - near_pos.z;
    points[0] -= diff_x;
    points[1] -= diff_x;
    points[2] -= diff_z;
    points[3] -= diff_z;

    local left_grid_idx = int((points[0] - grid.pos_left) / grid_length);
    local right_grid_idx = int((points[1] - grid.pos_left) / grid_length);
    local bottom_grid_idx = int((points[2] - grid.pos_bottom) / grid_length);
    local top_grid_idx = int((points[3] - grid.pos_bottom) / grid_length);
    local grid = this.grid;
    for (local x_idx = left_grid_idx; x_idx <= right_grid_idx; x_idx++) {
      for (local z_idx = bottom_grid_idx; z_idx <= top_grid_idx; z_idx++) {
        if (!grid.isValidNode(x_idx, z_idx)) {

          model_pos.set(near_pos.x, model_pos.y, near_pos.z);
          furniture_model.setAngle(angle);

          if (furniture_setting.isOverlaid()) edit_model.enableFixButton();
          else edit_model.disableFixButton();

          return;
        }
      }
    }

    model_pos.set(near_pos.x, model_pos.y, near_pos.z);
    furniture_model.setAngle(angle);
    edit_model.enableFixButton();
    return;
  }

  function checkAllNodeConnected() {
    return this.grid.checkAllNodeConnected();
  }

  function _setupProcess(room_data, flags) {

    if ((flags & (SETUP_ALL + SETUP_GRID)) != 0) _reset_grid();

    if ((flags & (SETUP_ALL + SETUP_FURNITURES)) != 0) _reset_furniture_infos();

    if ((flags & (SETUP_ALL + SETUP_GRID)) != 0) {

      local room_setting = ::gamesetting.room_settings[room_data.getRoomID()];
      this.grid.setup(room_setting.getRoomRects());

      this.room_setting_id = room_setting.getID();

      _createWallInfoProcess(this.wall_infos, this.grid);
    }

    local ud = ::gamesession.getUserData();
    if ((flags & (SETUP_ALL + SETUP_FURNITURES)) != 0) {

      foreach (layout_data in room_data.getFurnitureLayouts()) {
        local furniture_id = ud.getFurnitureData(layout_data.getUID()).getID();
        addFurniture(layout_data, furniture_id, true);
      }
    }
    else if ((flags & SETUP_NEW_FURNITURES) != 0) {

      foreach (layout_data in room_data.getFurnitureLayouts()) {
        local furniture_id = ud.getFurnitureData(layout_data.getUID()).getID();
        local furniture_info = addFurniture(layout_data, furniture_id, false);
        if (!furniture_info) continue;

        local furniture_uid = furniture_data.getUID();
      }
    }

    if ((flags & (SETUP_ALL + SETUP_INVALIDATE)) != 0) {
      this.grid.validateAll();
      this.grid.invalidateNodes(this.furniture_infos);
    }

    if ((flags & (SETUP_ALL + SETUP_CONNECT)) != 0) {
      this.grid.connect();
    }

  }

  function onlyGridSetup(room_uid) {

    local room_setting = ::gamesetting.room_settings[room_uid];
    this.grid.setup(room_setting.getRoomRects());
    this.room_setting_id = room_setting.getID();
    this.grid.validateAll();
    this.grid.invalidateNodes(this.furniture_infos);

    _createWallInfoProcess(this.wall_infos, this.grid);
  }

  function _createWallInfoProcess(wall_infos, grid) {
    local all_nodes = grid.all_nodes;
    local start_node_idxes = null;
    foreach (z_idx, x_nodes in all_nodes) {
      local find = false;
      foreach (x_idx, node in x_nodes) {
        if (!node) continue;

        start_node_idxes = [x_idx, z_idx];
        find = true;
        break;
      }
      if (find) break;
    }
    if (!start_node_idxes) {
      ::errorln("start node not found");
      return;
    }

    local end_node_idxes = [];
    local search_points = [[-1, 0], [0, 1], [1, 0], [0, -1]];
    local search_point_num = length(search_points);
    local current_line = 1;
    local current_node_idxes = clone start_node_idxes;
    local next_node_idxes = array(length(current_node_idxes));
    local tmp_node_idxes = clone current_node_idxes;
    local swap = [];

    do {
      local grid_left = this.grid.pos_left;
      local grid_bottom = this.grid.pos_bottom;

      local search_line = (current_line + search_point_num - 1) % search_point_num;
      local coord1_x_idx = tmp_node_idxes[0];
      local coord1_z_idx = tmp_node_idxes[1];
      while (true) {
        local search_point = search_points[search_line];

        foreach (idx, node_idx in current_node_idxes) next_node_idxes[idx] = node_idx + search_point[idx];
        if (!all_nodes[next_node_idxes[1]] || !all_nodes[next_node_idxes[1]][next_node_idxes[0]]) {

          search_line = (search_line + 1) % search_point_num;
          continue;
        }

        foreach (idx, node_idx in current_node_idxes) tmp_node_idxes[idx] = node_idx;
        foreach (idx, node_idx in next_node_idxes) current_node_idxes[idx] = node_idx;
        if (length(end_node_idxes) == 0) foreach (node_idx in current_node_idxes) end_node_idxes + node_idx;
        if (search_line == (current_line + search_point_num - 1) % search_point_num) {

          current_line = search_line;
          break;
        }
        else if (search_line == current_line) {

          search_line = (current_line + search_point_num - 1) % search_point_num;
          continue;
        }
        else if (search_line == (current_line + 1) % search_point_num) {

          current_line = search_line;
          break;
        }
        else {

          ::warnln("wall line search is unexpected");
          current_line = search_line;
          break;
        }
      }
      local coord2_x_idx = tmp_node_idxes[0];
      local coord2_z_idx = tmp_node_idxes[1];
      local wall_info = WallInfo(grid_left + coord1_x_idx * GRID_LENGTH, grid_bottom + coord1_z_idx * GRID_LENGTH, grid_left + coord2_x_idx * GRID_LENGTH, grid_bottom + coord2_z_idx * GRID_LENGTH);
      wall_infos + wall_info;
    } while (current_node_idxes[0] != end_node_idxes[0] || current_node_idxes[1] != end_node_idxes[1]);

    ::traceln("wall info created")
  }

  function getEnabledNodeByVortex(x, z) {
    return this.grid.getEnabledNodeByVortex(x, z);
  }

  function printGrid() {
    ::traceln("====[grid info]================================================================");
    ::traceln("furniture_num : " + length(this.furniture_infos));
    this.grid.printGrid();
    ::traceln("===============================================================================");
  }
}

class RoomInfo.PointBuffer {
  buf = null;

  constructor() {
    buf = [];
  }

  function add(_x, _z) {
    local _p = { x = _x, z = _z };
    buf[len()] <- _p;
  }

  function get(idx) {
    return buf[idx];
  }

  function len() {
    return buf.len();
  }
}

class RoomInfo.Grid extends ::Graph {
  static GRID_LENGTH = GRID_LENGTH;

  pos_left = 0.0;
  pos_bottom = 0.0;
  all_nodes = null;

  valid_node_checker = null;
  total_node_num = 0;
  valid_node_num = 0;

  constructor() {
    super();
    this.valid_node_checker = ValidNodeChecker(this);
  }

  function hasNode() {
    return this.total_node_num >= 1;
  }

  function clear() {
    super.clear();
    this.all_nodes = null;
    this.total_node_num = 0;
    this.valid_node_num = 0;
    ::traceln("grid cleared");
  }

  function setup(room_rects) {
    clear();

    local left = 100000.0;
    local right = -100000.0;
    local bottom = 100000.0;
    local top = -100000.0;
    foreach (rect in room_rects) {
      local hw = rect.w / 2.0;
      local hh = rect.h / 2.0;
      if (rect.x - hw < left) left = rect.x - hw;
      if (rect.x + hw > right) right = rect.x + hw;
      if (rect.y - hh < bottom) bottom = rect.y - hh;
      if (rect.y + hh > top) top = rect.y + hh;
    }
    this.pos_left = left;
    this.pos_bottom = bottom;

    local v_num = int((top - bottom) / GRID_LENGTH) + 1;
    local h_num = int((right - left) / GRID_LENGTH) + 1;
    local grid_z = array(v_num);
    foreach (idx, _ in grid_z) {
      local grid_x = array(h_num);
      grid_z[idx] = grid_x;
    }
    this.all_nodes = grid_z;

    local n_num = 0;
    foreach (rect in room_rects) {
      local hw = rect.w / 2.0;
      local hh = rect.h / 2.0;
      local l = rect.x - hw;
      local r = rect.x + hw;
      local b = rect.y - hh;
      local t = rect.y + hh;
      local start_x = int((l - left) / GRID_LENGTH);
      local end_x = start_x + int((r - l) / GRID_LENGTH);
      local start_z = int((b - bottom) / GRID_LENGTH);
      local end_z = start_z + int((t - b) / GRID_LENGTH);
      for (local z = start_z; z <= end_z; z++) {
        local grid_x = grid_z[z];
        for (local x = start_x; x <= end_x; x++) {
          if (!grid_x[x]) {
            grid_x[x] = Node(left + x * GRID_LENGTH, bottom + z * GRID_LENGTH);
            n_num++;
          }
        }
      }
    }
    this.total_node_num = n_num;
    this.valid_node_num = n_num;

    ::traceln("grid setuped");
  }

  function invalidateNodes(furniture_infos) {
    local pos_left = this.pos_left;
    local pos_bottom = this.pos_bottom;
    foreach (info in furniture_infos) {
      if (info.isOverlaid()) continue;

      local _pos = info.getPosition();
      local _angle = info.getAngle();
      local _size = info.getSize();
      local origin = info.getSizeOrigin();
      local ox = origin.x;
      local oz = origin.z;
      local _hw = ::round(_size.w / 2.0, Math.pow(10.0, -3));
      local _hd = ::round(_size.d / 2.0, Math.pow(10.0, -3));
      local _vlist = RoomInfo.getFurnitureVertex(ox, oz, _hw, _hd, _angle);
      local _all_nodes = this.all_nodes;

      if (_angle % 90 == 0) {
        local _pvlist = [];
        foreach (v in _vlist) {
          _pvlist + { x = v.x + _pos.x, z = v.z + _pos.z };
        }
        local _glist = RoomInfo.convertGridVertex(pos_left, pos_bottom, _pvlist, _pos.x, _pos.z);
        local _grect = RoomInfo.getCoverRect(_glist);

        for (local z = _grect.z; z <= _grect.h; z++) {
          local _z_nodes = _all_nodes[z];
          for (local x = _grect.x; x <= _grect.w; x++) {
            local _node = _z_nodes[x];
            if (!_node || !_node.isValid()) continue;

            _node.invalidate();
            this.valid_node_num--;
          }
        }
      }
      else {
        local _inRect = RoomInfo.isInRect;
        local posx = _pos.x;
        local posz = _pos.z;
        local cover_rect = ::RoomInfo._getGridRectIncludeRect(_vlist, posx, posz);
        local left = cover_rect[0];
        local right = cover_rect[1];
        local bottom = cover_rect[2];
        local top = cover_rect[3];
        for (local z = bottom; z <= top; z += GRID_LENGTH) {
          for (local x = left; x <= right; x += GRID_LENGTH) {
            local _gx = int((x - pos_left) / GRID_LENGTH);
            local _gz = int((z - pos_bottom) / GRID_LENGTH);
            if (_inRect(x - posx, z - posz, ox, oz, _hw, _hd, _angle)) {
              local _node = _all_nodes[_gz][_gx];

              if (!_node || !_node.isValid()) continue;

              _node.invalidate();
              this.valid_node_num--;
            }
          }
        }
      }
    }
  }

  function validateAll() {
    this.valid_node_num = 0;
    foreach (x_nodes in this.all_nodes) {
      foreach (node in x_nodes) {
        if (!node) continue;

        node.validate();
        this.valid_node_num++;
      }
    }
  }

  function connect() {
    foreach (node, _ in this.nodes) {
      node.clearConnects();
    }

    local UP = NodeConnect.UP;
    local DOWN = NodeConnect.DOWN;
    local LEFT = NodeConnect.LEFT;
    local RIGHT = NodeConnect.RIGHT;
    local L_UP = NodeConnect.L_UP;
    local L_DOWN = NodeConnect.L_DOWN;
    local R_UP = NodeConnect.R_UP;
    local R_DOWN = NodeConnect.R_DOWN;

    local all_nodes = this.all_nodes;
    local addNodeConnect = this.addNodeConnect;
    foreach (idx_z, x_nodes in all_nodes) {
      local down = idx_z - 1;
      local up = idx_z + 1;
      foreach (idx_x, node in x_nodes) {
        if (!node || !node.isValid()) continue;

        this.nodes[node] <- null;

        local left = idx_x - 1;
        local right = idx_x + 1;
        if (x_nodes[left] && x_nodes[left].isValid()) {
          addNodeConnect(x_nodes[left], node, LEFT);
        }
        if (x_nodes[right] && x_nodes[right].isValid()) {
          addNodeConnect(x_nodes[right], node, RIGHT);
        }

        local x_up_nodes = all_nodes[up];
        if (x_up_nodes) {
          if (x_up_nodes[idx_x] && x_up_nodes[idx_x].isValid()) {
            addNodeConnect(x_up_nodes[idx_x], node, UP);
          }
          if (x_up_nodes[left] && x_up_nodes[left].isValid()) {
            addNodeConnect(x_up_nodes[left], node, L_UP);
          }
          if (x_up_nodes[right] && x_up_nodes[right].isValid()) {
            addNodeConnect(x_up_nodes[right], node, R_UP);
          }
        }
        local x_down_nodes = all_nodes[down];
        if (x_down_nodes) {
          if (x_down_nodes[idx_x] && x_down_nodes[idx_x].isValid()) {
            addNodeConnect(x_down_nodes[idx_x], node, DOWN);
          }
          if (x_down_nodes[left] && x_down_nodes[left].isValid()) {
            addNodeConnect(x_down_nodes[left], node, L_DOWN);
          }
          if (x_down_nodes[right] && x_down_nodes[right].isValid()) {
            addNodeConnect(x_down_nodes[right], node, R_DOWN);
          }
        }
      }
    }

    ::traceln("grid connected");
  }

  function checkAllNodeConnected() {

    ::ScanLineAlgorithmProcesser.fill(this.all_nodes);

    local reachable = true;
    foreach (node, _ in this.nodes) {
      if (!node.isValid()) continue;

      if (node.cost == -1) {
        reachable = false;
        break;
      }
    }
    return reachable;
  }

  function getTotalNodeNum() {
    return this.total_node_num;
  }

  function getValidNodeNum() {
    return this.valid_node_num;
  }

  function getNearestNodePos(x, z, valid_check = false) {
    local node = _getNearestNode(x, z, valid_check);
    if (!node) return null;

    return node.getPos();
  }

  function getRandomNodePos() {

    local node = Math.rndArray(::toArray(this.nodes))[0];

    local _loop = 0;
    while (true) {
      node = Math.rndArray(::toArray(this.nodes))[0];
      if (_loop < 10) {
        if (node.isValid() && node.getConnectNum() == 8) break;
      }
      else if (node.isValid()) {
        break;
      }
      _loop++;
    }
    return node.getPos();
  }

  function getNodePosListNearXZ(x, z) {
    local center_node = _getNearestNode(x, z);
    local x_idx = 0;
    local z_idx = 0;

    foreach (z, x_arr in this.all_nodes) {
      foreach (x, node in x_arr) {
        if (center_node == node) {
          x_idx = x;
          z_idx = z;
        }
      }
    }

    local x_min = Math.max(0, x_idx - 5);
    local x_max = Math.min(this.all_nodes[0].len(), x_idx + 5);
    local z_min = Math.max(0, z_idx - 5);
    local z_max = Math.min(this.all_nodes.len(), z_idx + 5);

    local pos_list = [];

    for (local z = z_min; z < z_max; z++) {
      for (local x = x_min; x < x_max; x++) {
        local _node = this.all_nodes[z][x];
        if (!_node) continue;
        if (_node.isValid()) pos_list + _node.getPos();
      }
    }

    return pos_list;
  }

  function getValidNodePos(check_func = null) {
    foreach (idx, grid_x in all_nodes) {
      foreach (g in grid_x) {
        if (!g || !g.isValid()) continue;
        if (check_func && !check_func(g.getPos())) continue;
        return g.getPos();
      }
      all_nodes[idx] = grid_x;
    }
    return null;
  }

  function isNode(x_idx, z_idx) {
    if (!this.all_nodes[z_idx]) return false;
    if (!this.all_nodes[z_idx][x_idx]) return false;

    return true;
  }

  function isValidNode(x_idx, z_idx) {
    if (!isNode(x_idx, z_idx)) return false;
    return this.all_nodes[z_idx][x_idx].isValid();
  }

  function getRoute(from, to) {
    local to_node_x_idx = int((to.x - this.pos_left) / GRID_LENGTH);
    local to_node_z_idx = int((to.z - this.pos_bottom) / GRID_LENGTH);
    local goal = _getNode(to_node_x_idx, to_node_z_idx);
    if (!goal) goal = _getNearestNode(to_node_x_idx, to_node_z_idx);
    if (!goal) return null;

    local tmp_connected_nodes = [];
    local from_node_x_idx = int((from.x - this.pos_left) / GRID_LENGTH);
    local from_node_z_idx = int((from.z - this.pos_bottom) / GRID_LENGTH);
    local start = _getNode(from_node_x_idx, from_node_z_idx);
    if (!start || !start.isValid()) {

      start = Node(from.x, from.z);

      local search_grid_num = 1;
      while (length(tmp_connected_nodes) == 0) _connectNearGrids(start, search_grid_num - 1, search_grid_num++, tmp_connected_nodes);
      ::traceln("tmp node created")
    }

    calcShortestPath(goal);

    local next = start;
    local route = [];
    while (next != goal) {

      next = next.to;
      if (!next) break;
      route + next.getPos();
    }

    foreach (node in tmp_connected_nodes) {

      removeNodeConnect(start, node);
    }

    return route;
  }

  function hasNotReachableNode() {

    local debug_time = skGetTime();

    _checkAllNodeConnected();

    debug_time = skGetTime()

    local reachable = true;
    foreach (node, _ in this.nodes) {
      if (!node.isValid()) continue;

      if (node.cost == -1) {
        reachable = false;
        break;
      }
    }

    return !reachable;
  }

  function addNodeConnect(from, to, angle) {
    local connect = _createNodeConnect(from, angle);
    to.addConnect(connect);
  }
  function _createNodeConnect(node, angle) {
    return NodeConnect(node, angle);
  }

  function _updateShortestPathNode(node, next) {

    local connects = node.connects;
    local to_connect = null;
    if (node.to) {
      foreach (connect, _ in node.to.connects) {
        if (connect.node == node) {
          to_connect = connect;
          break;
        }
      }
    }
    foreach (connect, _ in connects) {
      local node_cost = node.cost + connect.cost;
      local node_turn = node.turn;
      if (to_connect && to_connect.angle != connect.angle) {
        node_turn++;
      }
      if (connect.node.cost != -1) {
        if (node_cost > connect.node.cost) continue;
        if (node_cost == connect.node.cost) {
          if (node_turn >= connect.node.turn) continue;
        }
      }
      connect.node.cost = node_cost;
      connect.node.turn = node_turn;
      connect.node.to = node;

      next + connect.node;
    }
  }

  function _getNearestNode(x, z, valid_check = false) {
    if (!hasNode()) {
      ::traceln("no grid");
      return;
    }

    local half_grid_length = GRID_LENGTH / 2.0;

    local search_grids = null;
    local left_idx = int((x - this.pos_left) / GRID_LENGTH);
    local right_idx = left_idx + 1;
    local down_idx = int((z - this.pos_bottom) / GRID_LENGTH);
    local up_idx = down_idx + 1;
    local left_dist = x % GRID_LENGTH;
    local down_dist = z % GRID_LENGTH;
    if (left_dist < half_grid_length) {

      if (down_dist < half_grid_length) {

        if (left_dist < down_dist) {

          search_grids = [[left_idx, down_idx], [left_idx, up_idx], [right_idx, down_idx], [right_idx, up_idx]];
        }
        else {

          search_grids = [[left_idx, down_idx], [right_idx, down_idx], [left_idx, up_idx], [right_idx, up_idx]];
        }
      }
      else {

        local up_dist = GRID_LENGTH - down_dist;
        if (left_dist < up_dist) {

          search_grids = [[left_idx, down_idx], [left_idx, up_idx], [right_idx, down_idx], [right_idx, down_idx]];
        }
        else {

          search_grids = [[left_idx, up_idx], [right_idx, up_idx], [left_idx, down_idx], [right_idx, down_idx]];
        }
      }
    }
    else {

      local right_dist = GRID_LENGTH - left_dist;
      if (down_dist < half_grid_length) {

        if (right_dist < down_dist) {

          search_grids = [[right_idx, down_idx], [right_idx, up_idx], [left_idx, down_idx], [left_idx, up_idx]];
        }
        else {

          search_grids = [[right_idx, down_idx], [left_idx, down_idx], [right_idx, up_idx], [left_idx, up_idx]];
        }
      }
      else {

        local up_dist = GRID_LENGTH - down_dist;
        if (left_dist < up_dist) {

          search_grids = [[right_idx, down_idx], [right_idx, up_idx], [left_idx, down_idx], [left_idx, down_idx]];
        }
        else {

          search_grids = [[right_idx, up_idx], [left_idx, up_idx], [right_idx, down_idx], [left_idx, down_idx]];
        }
      }
    }

    foreach (idx in search_grids) {
      local grid = _getNode(idx[0], idx[1]);
      if (!grid || (valid_check && !grid.isValid())) continue;

      return grid;
    }

    return null;
  }

  function _getNode(x_idx, z_idx) {
    if (!isNode(x_idx, z_idx)) {
      return null;
    }

    return this.all_nodes[z_idx][x_idx];
  }

  function _connectNearGrids(node, from_num, to_num, out = null) {
    if (!out) out = [];

    local GRID_LENGTH = this.GRID_LENGTH;
    local ANOTHER = NodeConnect.ANOTHER;
    local all_nodes = this.all_nodes;
    local h_base_idx = int((node.pos.x - this.pos_left) / GRID_LENGTH);
    local v_base_idx = int((node.pos.z - this.pos_bottom) / GRID_LENGTH);
    for (local i = from_num; i < to_num; i++) {
      local left_idx = h_base_idx - i + 1;
      local right_idx = h_base_idx + i;

      local down_idx = v_base_idx - i + 1;
      local up_idx = v_base_idx + i;

      local x_down_nodes = all_nodes[down_idx];
      if (x_down_nodes && x_down_nodes[left_idx] && x_down_nodes[left_idx].isValid()) {
        addNodeConnect(node, x_down_nodes[left_idx], ANOTHER);
        out + x_down_nodes[left_idx];
      }
      if (x_down_nodes && x_down_nodes[right_idx] && x_down_nodes[right_idx].isValid()) {
        addNodeConnect(node, x_down_nodes[right_idx], ANOTHER);
        out + x_down_nodes[right_idx];
      }
      local x_up_nodes = all_nodes[up_idx];
      if (x_up_nodes && x_up_nodes[left_idx] && x_up_nodes[left_idx].isValid()) {
        addNodeConnect(node, x_up_nodes[left_idx], ANOTHER);
        out + x_up_nodes[left_idx];
      }
      if (x_up_nodes && x_up_nodes[right_idx] && x_up_nodes[right_idx].isValid()) {
        addNodeConnect(node, x_up_nodes[right_idx], ANOTHER);
        out + x_up_nodes[right_idx];
      }
    }
  }

  function getEnabledNodeByVortex(x, z) {
    this.valid_node_checker.setupVortex(x, z);
    return this.valid_node_checker.getPos();
  }

  function printGrid() {
    ::traceln("valid node num : " + length(this.nodes));

    for (local z = length(this.all_nodes) - 1; z >= 0; z--) {
      local x_nodes = this.all_nodes[z];
      local log = "";
      foreach (node in x_nodes) {
        if (!node) log = log + "  ";
        else if (node.isValid()) log = log + " 1";
        else log = log + " 0";
      }
      ::traceln(log);
    }
  }
  function printShortestPathResult() {
    for (local z = length(this.all_nodes) - 1; z >= 0; z--) {
      local x_nodes = this.all_nodes[z];
      local log = "";
      foreach (node in x_nodes) {
        if (!node) log = log + "   ";
        else if (node.isValid()) log = log + sprintf("%3d", node.cost);
        else log = log + "  -";
      }
      ::traceln(log);
    }
  }

  function getNode(x, z) {

    throw Exception();
  }

  function getPolygonMeshGridWire() {
    local mb = PolygonMeshBuilder();
    local m = Material();
    m.tec = skFXFindTechnique("decal.def");

    mb.setMaterial(m);
    mb.begin(SK_LINES);

    local grid_len = RoomInfo.Grid.GRID_LENGTH;

    local v_1 = Vector3D();
    local _prev = null;

    local _vertexmb = function(pos1, pos2, idx) {
      local rgb = idx % 5 == 0 ? 0xffffffff : 0xffffff02;
      mb.vertex(pos1.x, 0, pos1.z);
      mb.vertex(pos2.x, 0, pos2.z);
    }

    local _checkend = function(idx, maxlen, node, prev) {
      if (idx == maxlen - 1 && node) {
        return node.pos;
      } else if (!node && prev) {
        return prev.pos;
      }

      return null;
    }

    local _tmp = [];

    foreach (idx_z, x_nodes in this.all_nodes) {
      foreach (idx_x, node in x_nodes) {
        if (!_tmp[idx_x]) _tmp[idx_x] <- [];
        _tmp[idx_x][idx_z] <- node;

        if (node && !_prev) {
          v_1.set(node.pos);
          _prev = node;
          continue;
        }
        local v_2 = _checkend(idx_x, x_nodes.len(), node, _prev);
        if (v_2) {
          _vertexmb(v_1, v_2, idx_x);
          _prev = null;
          continue;
        }
        _prev = node;
      }
    }

    foreach (idx_x, z_nodes in _tmp) {
      foreach (idx_z, node in z_nodes) {
        if (node && !_prev) {
          v_1.set(node.pos);
          _prev = node;
          continue;
        }
        local v_2 = _checkend(idx_z, z_nodes.len(), node, _prev);
        if (v_2) {
          _vertexmb(v_1, v_2, idx_z);
          _prev = null;
          continue;
        }
        _prev = node;
      }
    }
    mb.end();
    return mb.toPolygonMesh();
  }
}
class RoomInfo.Grid.Node extends ::Graph.Node {

  pos = null;

  is_valid = true;
  turn = -1;

  constructor(x, z) {
    super();

    this.pos = Vector3D(x, ::HouseModel.FLOOR_DEPTH, z);
  }

  function reset() {
    super.reset();
    this.turn = -1;
  }

  function validate() {
    this.is_valid = true;
  }

  function invalidate() {
    this.is_valid = false;

    foreach (connect, _ in this.connects) {
      connect.node.removeConnect(this);
    }
    clearConnects();
  }

  function isValid() {
    return this.is_valid;
  }

  function setGoal() {
    super.setGoal();
    this.turn = 0;
  }

  function getPos() {
    return this.pos();
  }
}

class RoomInfo.Grid.NodeConnect extends ::Graph.NodeConnect {
  static UP = 1;
  static DOWN = 2;
  static LEFT = 3;
  static RIGHT = 4;

  static L_UP = 5;
  static L_DOWN = 6;
  static R_UP = 7;
  static R_DOWN = 8;

  static ANOTHER = 9;

  angle = 0;

  constructor(node, angle) {
    super(node);
    this.angle = angle;
  }
}

class RoomInfo.FurnitureInfo {
  static COLLIDE_OFFSET = GRID_LENGTH;

  pos_x = 0.0;
  pos_z = 0.0;
  size_origin_x = 0.0;
  size_origin_z = 0.0;
  size_w = 0.0;
  size_d = 0.0;
  angle = 0;
  dir = 0.0;

  object_points = null;

  is_overlaid_object = true;

  constructor() {
  }

  function setup(furniture_layout_data, furniture_id) {
    local furniture_setting = ::gamesetting.furniture_settings[furniture_id];

    this.is_overlaid_object = furniture_setting.isOverlaid();

    local furniture_pos = furniture_layout_data.getPosXYZ();
    local pos_x = this.pos_x = furniture_pos[0];
    local pos_z = this.pos_z = furniture_pos[2];
    this.angle = furniture_layout_data.getAngle();
    this.dir = furniture_layout_data.getAngle() * Math.DTOR;

    this.size_origin_x = furniture_setting.size_origin_x;
    this.size_origin_z = furniture_setting.size_origin_z;
    this.size_w = furniture_setting.size_w;
    this.size_d = furniture_setting.size_d;
    local hw = furniture_setting.size_w / 2.0;
    local hd = furniture_setting.size_d / 2.0;

    local left = pos_x - hw;
    local right = pos_x + hw;
    local bottom = pos_z - hd;
    local top = pos_z + hd;
    this.object_points = [left, right, bottom, top];

    return this;
  }

  function isOverlaid() {
    return this.is_overlaid_object;
  }

  function getBounds() {
    local sin = Math.sin;
    local cos = Math.cos;

    local dir = this.dir;
    local op = this.object_points;
    local ow = op[1] - op[0];
    local oh = op[3] - op[2];
    local w = (ow * cos(dir) + oh * sin(dir)) * 0.5;
    local h = (ow * sin(dir) + ow * cos(dir)) * 0.5;

    return Rect2D(this.pos_x, this.pos_z, w, h);
  }

  function getPosition() {
    return { x = this.pos_x, z = this.pos_z };
  }

  function getSizeOrigin() {
    return { x = this.size_origin_x, z = this.size_origin_z };
  }

  function getSize() {
    return { w = this.size_w, d = this.size_d };
  }

  function getAngle() {
    return this.angle;
  }

  function isInObject(x, z) {
    local tx, tz;
    if (this.dir == 0.0) {

      tx = x;
      tz = z;
    }
    else {

      local Math = Math;
      local cx = this.pos_x;
      local cz = this.pos_z;

      local px = x - cx;
      local pz = z - cz;
      local l = Math.sqrt(px * px + pz * pz);
      local r1;
      if (px == 0.0 && pz == 0.0) {

        return true;
      }
      if (px == 0.0) {

        r1 = pz < 0.0 ? Math.PI / 2.0 : Math.PI / 2.0 * 3.0;
      }
      else {
        r1 = Math.atan(pz / px);
      }
      local r2 = r1 - this.dir;
      tx = l * Math.cos(r2) + cx;
      tz = l * Math.sin(r2) + cz;
    }

    local op = this.object_points;
    local result = tx > op[0] && tx < op[1] && tz > op[2] && tz < op[3];

    return result;
  }

  function isCrossObject(x1, x2, y1, y2) {

    return false;
  }
}

class RoomInfo.WallInfo {
  wall_model_uid = -1;
  wall_object_uids = null;

  coord1 = null;
  coord2 = null;

  constructor(x1, z1, x2, z2) {
    this.wall_object_uids = [];
    this.coord1 = Vector3D(x1, 0.0, z1);
    this.coord2 = Vector3D(x2, 0.0, z2);

  }

  function getWallModelUID() {
    return this.wall_model_uid;
  }

  function setWallModelUID(uid) {
    this.wall_model_uid = uid;
  }

  function setWallObjectUID(uid) {}

  function getWallObjectUIDs() {
    return this.wall_object_uids
  }
}

class RoomInfo.Grid.ValidNodeChecker {
  graph = null;
  mover = null;
  checker = null;

  check_info = null;
  total_move_limit = 99999;

  constructor(graph) {
    this.graph = graph;
  }

  function setupVortex(x, z, move_limit = -1) {

    if (move_limit == -1) move_limit = this.graph.getTotalNodeNum();
    this.check_info = CheckInfo(this.graph, move_limit);
    this.check_info.init(x, z);
    this.mover = VortexMover(check_info, true, ::RoomInfo.Grid.ValidNodeChecker.VortexMover.MOVE_UP);
    this.checker = RectChecker(check_info);
    this.checker.createRectByPoints(-0.5, 0.5, -0.5, 0.5);
  }

  function move() {
    local m = this.mover, c = this.checker;

    while (!c.check()) {
      if (!m.move()) {
        break;
      }
    }
  }

  function getPos() {
    move();
    return this.check_info.getPos();
  }
}

class RoomInfo.Grid.ValidNodeChecker.PointMover {
  check_info = null;

  constructor(check_info) {
    this.check_info = check_info;
  }

  function setMoveLimit(val) {
    this.total_move_limit = val;
  }

  function move() {
    if (this.check_info.isReachedMoveLimit()) return false;
    return true;
  }
}

class RoomInfo.Grid.ValidNodeChecker.VortexMover extends ::RoomInfo.Grid.ValidNodeChecker.PointMover {
  static MOVE_UP = 0;
  static MOVE_RIGHT = 1;
  static MOVE_DOWN = 2;
  static MOVE_LEFT = 3;
  static MOVE_ORDER = [0, 1, 2, 3];
  static MOVE_DIST = [[-1, 0], [0, 1], [1, 0], [0, -1]];
  is_clockwise = true;
  move_order_idx = 0;

  limit_up = true;
  one_edge_move_limit = 1;
  one_edge_move_count = 0;

  constructor(check_info, is_clockwise, move_order_idx) {
    super(check_info);

    this.is_clockwise = is_clockwise;
    this.move_order_idx = move_order_idx;
  }

  function move() {
    if (!super.move()) return false;

    local move_dist_idxes = MOVE_DIST[MOVE_ORDER[this.move_order_idx]];
    this.check_info.moveCheckPointByIdx(move_dist_idxes[0], move_dist_idxes[1]);

    this.one_edge_move_count++;
    if (this.one_edge_move_count >= this.one_edge_move_limit) {
      this.move_order_idx = (this.move_order_idx + 1) % length(MOVE_ORDER);
      this.one_edge_move_count = 0;
      this.limit_up = !this.limit_up;
      if (this.limit_up) {
        this.one_edge_move_limit++;
      }
    }

    this.check_info.addMoveCount(1);
    return true;
  }
}

class RoomInfo.Grid.ValidNodeChecker.Checker {
  check_info = null;

  constructor(check_info) {
    this.check_info = check_info;
  }

  function check() {
    return true;
  }
}

class RoomInfo.Grid.ValidNodeChecker.PointChecker extends ::RoomInfo.Grid.ValidNodeChecker.Checker {

  function check() {
    if (!super.check()) return false;

    local x_idx = this.check_info.getXIndex();
    local z_idx = this.check_info.getZIndex();
    local ret = this.check_info.getGraph().isValidNode(x_idx, z_idx);
    return ret;
  }
}

class RoomInfo.Grid.ValidNodeChecker.RectChecker extends ::RoomInfo.Grid.ValidNodeChecker.Checker {
  left = 0.0;
  right = 0.0;
  front = 0.0;
  back = 0.0;

  function createRectByPoints(l, r, f, b) {
    this.left = l;
    this.right = r;
    this.front = f;
    this.back = b;
  }

  function check() {
    if (!super.check()) return false;

    local x_idx = this.check_info.getXIndex();
    local z_idx = this.check_info.getZIndex();

    local start_x_idx = x_idx + this.left / this.check_info.grid_length;
    if (this.left % this.check_info.grid_length != 0.0) start_x_idx -= 1;
    local end_x_idx = x_idx + this.right / this.check_info.grid_length;
    if (this.right % this.check_info.grid_length != 0.0) end_x_idx += 1;

    local start_z_idx = z_idx + this.front / this.check_info.grid_length;
    if (this.front % this.check_info.grid_length != 0.0) start_z_idx -= 1;
    local end_z_idx = z_idx + this.back / this.check_info.grid_length;
    if (this.back % this.check_info.grid_length != 0.0) end_z_idx += 1;

    for (local x = start_x_idx; x < end_x_idx; x++) {
      for (local z = start_z_idx; z < end_z_idx; z++) {
        local is_valid = this.check_info.getGraph().isValidNode(x, z);
        if (!is_valid) return false;
      }
    }

    return true;
  }
}

class RoomInfo.Grid.ValidNodeChecker.CheckInfo {
  static grid_length = ::RoomInfo.Grid.GRID_LENGTH;

  graph = null;
  x_idx = -1;
  z_idx = -1;

  move_limit = -1;
  move_count = 0;

  checkable = false;

  constructor(graph, move_limit) {
    this.graph = graph;
    this.move_limit = move_limit;
  }

  function init(x, z) {
    local pos = this.graph.getNearestNodePos(x, z);
    if (!pos) {
      checkable = false;
      return;
    }

    this.move_count = 0;
    this.x_idx = (pos.x - graph.pos_left) / grid_length;
    this.z_idx = (pos.z - graph.pos_bottom) / grid_length;
  }

  function isReachedMoveLimit() {
    return this.move_limit <= this.move_count;
  }

  function addMoveCount(val) {
    this.move_count += val;
  }

  function moveCheckPointByIdx(x_idx, z_idx) {
    this.x_idx += x_idx;
    this.z_idx += z_idx;
  }

  function getGraph() {
    return this.graph;
  }

  function getXIndex() {
    return this.x_idx;
  }

  function getZIndex() {
    return this.z_idx;
  }

  function getPos() {
    local x = this.graph.pos_left + x_idx * grid_length;
    local y = 0.0;
    local z = this.graph.pos_bottom + z_idx * grid_length;
    return Vector3D(x, y, z);
  }
}