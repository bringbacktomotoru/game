class HelpPanel extends ::HomeUI.Panel {

  static need_camera_default = false;
  static need_money_layer = false;
  static need_rank_layer = false;
  static need_history_clear = true;
  static need_menu_layer = false;

  static STATE_MENU = 1;
  static STATE_HELP = 2;
  static STATE_WEB = 3;
  state = 1;

  current_index = 0;
  current_info = null;
  first_costumes = null;

  help_list = null;
  web_layer = null;

  btn_back = null;

  function create() {
    return ::loadSKView("/ui/HelpPanel.ui", ::HelpPanel);
  }

  function added() {
    super.added();

    this.help_list = HelpList(this);
    this.btn_back = findChild("btn_back");
    ::TapButton(this.btn_back).view.addEventListener(ACTION_EVENT, _actionevent_back);
    this.web_layer = WebLayer(this);
  }

  function changePage(s) {
    if (this.state == s) return;
    this.state = s;
    switch (this.state) {
    case STATE_HELP:
      this.help_list._help_setup();
      break;
    case STATE_WEB:
      this.btn_back.setEnabled(false);
      this.web_layer.show();

      break;
    }
  }

  function setState(s) {
    this.state = s;
  }

  function _actionevent_back(e) {
    e.consume();
    if (this.state == STATE_HELP) {
      this.state = STATE_MENU;
      this.help_list._setup();
    }
    else {
      getHomeUI().backPanel();
    }
  }
}

class HelpPanel.HelpList {
  parent_panel = null;
  view = null;
  reclist = null;
  scroll = null;

  pnl_list = null;

  constructor(p) {
    this.parent_panel = p;
    this.view = this.parent_panel.findChild("pnl_helps");

    this.pnl_list = this.view.findChild("pnl_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dxscale = 0.0;
    this.pnl_list.addChild(this.reclist);
    this.pnl_list.setBuffer(true);

    _setup();
  }

  function _setup() {
    this.reclist.clearChildren();
    local _offset = 0;
    local _view = null;

    local _set_lbl = [];
    switch (::READ_TRANS_FILE) {
    case "JP":
      _set_lbl + { "txt" = ::dict.get("help"), "state" = ::HelpPanel.STATE_HELP };
      _set_lbl + { "txt" = ::dict.get("tokutei"), "state" = ::HelpPanel.STATE_WEB };
      break;
    default:
      _set_lbl + { "txt" = ::dict.get("help"), "state" = ::HelpPanel.STATE_HELP };
      _set_lbl + { "txt" = ::dict.get("terms_of_service"), "state" = ::HelpPanel.STATE_WEB };
    }

    foreach (idx, info in _set_lbl) {
      _view = ::loadSKView("/ui/common/HelpMenu_" + (idx % 2 + 1) + ".ui");
      _view.findChild("lbl_name").setText(info.txt);
      switch (info.state) {
      case ::HelpPanel.STATE_HELP:
        TapButton(_view.findChild("btn"), false).view.addEventListener(ACTION_EVENT, _actionevent_help);
        break;
      case ::HelpPanel.STATE_WEB:
        ::TapButton(_view.findChild("btn"), false).view.addEventListener(ACTION_EVENT, _actionevent_show);
        break;
      }
      this.reclist.addChild(_view);
      _view.pos.x = this.pnl_list.bnd.w / 2.0;
      _view.pos.y = _view.bnd.h / 2.0 + _offset;
      _offset += _view.bnd.h;
    }

    this.reclist.setRect(0, 0, this.pnl_list.bnd.w, _offset);
    this.view.findChild("pnl_scroll_bar").visible = false;
  }

  function _actionevent_help(e) {
    e.consume();
    this.parent_panel.changePage(::HelpPanel.STATE_HELP);
  }

  function _actionevent_show(e) {
    e.consume();
    this.parent_panel.changePage(::HelpPanel.STATE_WEB);
  }

  function _help_setup() {
    this.reclist.clearChildren();

    local _helps = ::gamesetting.help_settings;
    local _temp_table = {};
    local _sort_helps = [];
    local _sorttable = SortTable();

    foreach (_help in _helps) {
      _sorttable.append(_help.getID(), _help);
    }
    _sorttable.toArray(_sort_helps);
    _sorttable.clear();

    local _offset = 0;
    local _size_y = 0;
    local _cnt = 1;
    foreach (_table in _sort_helps) {
      if (!_table.canAdd()) continue;

      local _view = ::loadSKView((_cnt % 2 == 1 ? "/ui/common/HelpMenu_1.ui" : "/ui/common/HelpMenu_2.ui"));
      Menu(_view, _table);
      this.reclist.addChild(_view);
      if (_cnt == 1) _size_y = _view.bnd.h;
      _view.pos.x = this.pnl_list.bnd.w / 2.0;

      _view.pos.y = _view.bnd.h / 2.0 + _offset;
      _offset += _size_y;
      _cnt++;
    }
    _offset += _size_y;

    this.reclist.setRect(0, 0, this.pnl_list.bnd.w, _offset);
    this.scroll.setScrollRect(this.reclist.bnd);

    local _scroll_bar = ::ScrollBarV(this.view.findChild("pnl_scroll_bar"));
    _scroll_bar.setup(this.scroll, this.pnl_list.bnd, true);
  }
}

class HelpPanel.HelpList.Menu {

  view = null;
  lbl_name = null;

  table = null;

  constructor(view, table) {
    this.view = view;
    this.table = table;

    view.findChild("lbl_name").setText(table.title);
    ::TapButton(view.findChild("btn"), false).view.addEventListener(ACTION_EVENT, _actionevent);
  }

  function _actionevent(e) {
    e.consume();

    local _dlg = ::ImageViewDialog();
    _dlg.setupFromTable(table);
    _dlg.show(true);
  }
}

class HelpPanel.WebLayer {
  static URL = "https://www.tomotoru.com/asct";
  static URL_EN = "https://www.tomotoru.com/tos?lang=en";
  static OFFSET = 50;
  parent_panel = null;
  view = null;
  web_view = null;
  epx = null;
  epy = null;
  size_w = null;
  size_h = null;

  constructor(p) {
    this.parent_panel = p;
    this.view = p.findChild("pnl_web");

    this.view.findChild("lbl_close").setText(::dict.get("close"));
    this.view.visible = false;

    local _pnl_web_view = this.view.findChild("pnl_web_view");
    local _ds = getDisplayScale();
    this.epx = (_pnl_web_view.pos.x) * _ds;
    this.epy = (_pnl_web_view.pos.y - ::screenHeight / 2.0) * _ds + OFFSET;
    this.size_w = _pnl_web_view.bnd.w * _ds;
    this.size_h = _pnl_web_view.bnd.h * _ds;
    ::TapButton(this.view.findChild("btn_back")).view.addEventListener(ACTION_EVENT, actionevent_close);

  }

  function show() {

    this.web_view = WebView();
    this.web_view.setType(-1);
    this.web_view.setRect(this.epx, this.epy, this.size_w, this.size_h);

    local _url = URL;
    switch (::READ_TRANS_FILE) {
    case "EN":
      _url = URL_EN;
      break;
    }
    this.web_view.openURL(_url);
    this.web_view.show();

    this.view.visible = true;
  }

  function actionevent_close(e) {

    this.web_view.close();
    this.web_view = null;

    this.view.visible = false;
    parent_panel.setState(::HelpPanel.STATE_MENU);
    parent_panel.btn_back.setEnabled(true);
  }
}