class CameraWork {
  active = false;

  camera = null;
  hpb = null;

  v_1 = Vector3D();

  constructor(camera, h, p, b) {
    this.camera = camera;
    this.hpb = [h, p, b];

    activate(h, p, b);
  }

  function activate(h, p, b) {
    if (this.active) return;

    this.active = true;

    rotateTo(h, p, b);
  }

  function deactivate() {
    if (!this.active) return;

    this.active = false;
  }

  function setActive(a) {
    this.active = a;
  }

  function _mv(x, y, z) {
    if (!this.active) return false;

    v_1.set(x, y, z);
    if (this.camera.pos.equals(v_1)) return false;

    this.camera.pos.set(x, y, z);
    this.camera.matdirty = true;

    return true;
  }

  function move(x, y, z) {
    local cp = this.camera.pos;
    return _mv(cp.x + x, cp.y + y, cp.z + z);
  }

  function moveTo(x, y, z) {
    return _mv(x, y, z);
  }

  function _rt(h, p, b, force = false) {
    if (!this.active) return false;

    local pi2 = Math.PI * 2;
    h = (h < 0.0 ? h + pi2 : h) % pi2;
    p = (p < 0.0 ? p + pi2 : p) % pi2;
    b = (b < 0.0 ? b + pi2 : b) % pi2;

    if (!force && this.hpb[0] == h && this.hpb[1] == p && this.hpb[2] == b) return false;

    this.hpb[0] = h;
    this.hpb[1] = p;
    this.hpb[2] = b;
    this.camera.rot.setHPB(h, p, b);
    camera.matdirty = true;

    return true;
  }

  function rotate(h, p, b) {
    return _rt(this.hpb[0] + h, this.hpb[1] + p, this.hpb[2] + b);
  }

  function rotateTo(h, p, b, force = false) {
    return _rt(h, p, b, force);
  }
}