class MissionData {
  id = null;
  progress = null;
  cleared = null;
  set_piece = null;

  function createMissionData(id) {
    local _md = MissionData();
    _md.id = id;
    _md.progress = 0;
    _md.cleared = false;
    _md.set_piece = false;

    return _md;
  }

  function loadWithCreate(loader) {
    this.id = loader.get();
    this.progress = loader.get();
    local _b = loader.get();
    this.cleared = _b > 0 ? true : false;
    _b = loader.get();
    this.set_piece = _b > 0 ? true : false;
  }

  function getID() {
    return this.id;
  }
  function getMissionSetting() {
    return ::gamesetting.mission_settings[this.id];
  }
  function isCleared() {
    return this.cleared;
  }
  function isSetPiece() {
    return this.set_piece;
  }
  function setPieceFlagAtServer() {
    this.set_piece = true;
  }

  function checkMissionType(type) {
    return getMissionSetting().checkMissionType(type);
  }

  function getDescMissionInfo() {
    local _setting = getMissionSetting();
    local _desc = _setting.getDesc() + " " + ::dict.get("nums_slash", [::formatNumberString(this.progress), ::formatNumberString(_setting.getValue())]);
    return _desc;
  }

  function getDesc() {
    return getMissionSetting().getDesc();
  }
  function getDetailDesc() {
    return getMissionSetting().getDetailDesc();
  }
  function hasDetailDesc() {
    return getMissionSetting().hasDetailDesc();
  }

  function getProgressText() {
    local _setting = getMissionSetting();
    return ::dict.get("nums_slash", [::formatNumberString(this.progress), ::formatNumberString(_setting.getValue())]);
  }

  function hasNext() {
    return getMissionSetting().hasNext();
  }
  function getNextMissionID() {
    return getMissionSetting().getNextMissionID();
  }

  function getProgress() {
    return this.progress;
  }

  function needSendProgressAPI() {
    return getMissionSetting().needSendProgressAPI();
  }

  function hasTargetList() {
    return getMissionSetting().hasTargetList();
  }

  function checkTargetList(targets) {
    if (!hasTargetList()) return true;

    return getMissionSetting().checkTargetList(targets);
  }

  function hasTargetStr() {
    return getMissionSetting().hasTargetStr();
  }
  function checkTargetStr(str) {
    if (!hasTargetStr()) return true;
    return getMissionSetting().checkTargetStr(str);
  }

  function updateProgress(val) {
    if (this.cleared) return false;

    local _ms = getMissionSetting();

    if (_ms.isProgressAdd()) {
      this.progress += val;
    } else {
      this.progress = val;
    }

    if (this.progress >= _ms.getValue()) {
      this.progress = _ms.getValue();
      this.cleared = true;
    }

    return true;
  }

  function needSendProgressAPI() {
    return getMissionSetting().needSendProgressAPI();
  }
}