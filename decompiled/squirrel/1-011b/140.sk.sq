class JSONConnection
{
  status = 0;

  hostname = "";
  port = 0;
  ipaddr = null;

  con = null;
  listener = null;

  phase = 0;
  readlen = 0;
  readflag = 0;
  readrnd = null;
  writernd = null;
  readbb = null;
  writebb = null;
  zipbb = null;

  queryqueue = null;
  querymap = null;

  constructor(hn, p) {
    ipaddr = null;
    hostname = hn;
    port = p;
    readbb = ByteBuffer();
    writebb = ByteBuffer();
    zipbb = ByteBuffer();
    initQueryMap();
  }

  function initQueryMap() {
    queryqueue = [];
    querymap = {};
    for (local l = 1; l < 256; l++) {
      local q = NetQueryState(l);
      queryqueue + q;
      querymap.put(l, q);
    }
  }

  function connect() {
    if (con) {
      switch (con.getState()) {
      case 2: return;
      case 1: waitForConnect(); return;
      }
    }
    if (!ipaddr) {
      ipaddr = resolveIP(hostname, port);
    }
    local c = TCPConnection();
    c.setListener(listenerfunc);
    c.setReader(readfunc);
    c.connect(ipaddr);
    con = c;
    waitForConnect();

    phase = 0;
    readlen = 8;
    readrnd = Random();
    writernd = Random();
    readbb.clear();
    writebb.clear();
  }

  function waitForConnect() {
    while (con.getState() == 1) {
      suspend();
    }
    if (con.getState() != 2) {
      throw Exception("tcp connection error");
    }
  }

  function close() {
  }

  function isConnected() {
    return con ? (con.getState() != 2) : 0;
  }

  function query(o, timeout) {
    local ret = null;
    local q = popQuery();
    q.returned = false;
    write(o, 16384 | (q.reqid & 255));
    q.wait(timeout);
    if (!q.returned) throw Exception("time out");
    ret = q.ret;
    q.ret = null;
    pushQuery(q);
    return ret;
  }

  function send(o) {
    write(o, 0);
  }

  function write(o, flags) {
    writebb.clear();
    local s = encodeJSON(o);
    writebb.puti(0);
    writebb.puti(0);
    writebb.print(s);
    writebb.pos = 8;
    local sendbb = writebb;

    {
      if (writebb.size > 10000) {
        writebb.pos = 8;
        flags |= 32768;
        zipbb.clear();
        zipbb.puti(0);
        zipbb.puti(0);
        sendbb = compress(writebb, zipbb, 1);
      }
      sendbb.pos = 0;

      sendbb.puts(0);
      sendbb.puti(sendbb.size - 8);
      sendbb.puts(flags);

      sendbb.pos = 0;
      writernd.crypt(sendbb);
    }
    con.write(sendbb);
  }

  function compress(srcbb, dstbb, lv) {
    local defl = ZDeflater(srcbb, dstbb, lv);
    while (defl.step()) {
      ;
    }
    return dstbb;
  }

  function uncompress(srcbb, dstbb) {
    local infl = ZInflater(srcbb, dstbb);
    while (infl.step()) {
      ;
    }
    return dstbb;
  }

  function received(o) {

    return null;
  }

  function popQuery() {
    local q = delete queryqueue[0];
    return q;
  }

  function pushQuery(q) {
    queryqueue + q;
  }

  function getQuery(i) {
    return querymap[i];
  }

  function readfunc(c, bbuf) {
    readbb.putBuffer(bbuf);
    while (readbb.remain >= readlen) {
      switch (phase) {
      case 0:
        {
          readrnd.crypt(readbb, 8);
          if (readbb.gets() != 0) throw Exception("decode error");
          readlen = readbb.geti();
          readflag = readbb.gets() & 65535;
          phase = 1;
          break;
        }
      case 1:
        {
          readbb.trim();
          local recvbb = readbb;
          readrnd.crypt(recvbb, readlen);
          if ((flags & 32768)) {
            zipbb.clear();
            recvbb = uncompress(readbb, zipbb);
            recvbb.pos = 0;
          }
          phase = 0;
          readlen = 8;
          try {
            local s = recvbb.asText();
            local o = decodeJSON(s);

            if ((readflag & 8192)) {

              local q = getQuery(readflag & 255);
              q.returned = true;
              q.ret = o;
            } else
            if ((readflag & 16384)) {

              newthread().call(function() {
                local res = received(o);
                respond(res, readflag & 255);
              }.bindenv(this));
            } else {

              newthread().call(function() {
                received(o);
              }.bindenv(this));
            }
          } catch (ex) {
            printf("GameNetConnection.readfunc caused an Exception : " + e + "  addr:" + ipaddr);
            close();
            throw ex;
          }
          break;
        }
      case 2:
        break;
      }
    }
  }

  function listenerfunc(id, c, target) {
    switch (id) {
    case 2:
      break;
    case 3:
      break;
    }
  }

}

class NetQueryState
{
  reqid = -1;
  ret = null;
  returned = false;

  constructor(id) { reqid = id; }

  function wait(time) {
    local endtime = skGetTime() + time;
    while (!retuned && skGetTime() < endtime) {
      suspend();
    }
  }
}