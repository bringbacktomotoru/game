class CostumeActionSetting extends Setting {
  id = -1;
  name = null;
  level = 0;

  use_health = 0;
  time = 0;

  costume_exp = 0;
  room_exp = 0;
  reward_gm = 0;

  reward_version = 0;
  reward = null;

  event_ids = null;

  function loadConfAtServer(t) {
    local _setting = CostumeActionSetting();

    foreach (k, v in t) {
      switch (k) {
      case "reward":
      case "event_ids":
        _setting[k] = decodeJSON(v);
        break;
      default:
        _setting[k] = v;
      }

    }
    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (name) trans + "name";

    return trans;
  }

  function getID() {
    return this.id;
  }

  function getName() {
    return this.name;
  }

  function getRewardGM() {
    return this.reward_gm;
  }

  function getRewardRoomExp() {
    return this.room_exp;
  }

  function getRewardCostumeExp() {
    return this.costume_exp;
  }

  function getRewardTable() {
    return this.reward;
  }

  function getRewardTableLength() {
    if (!this.reward) return 0;
    return this.reward.len();
  }

  function getReward(idx) {
    if (!this.reward || idx < 0 || idx >= this.reward.len()) return null;
    return this.reward[idx];
  }

  function getUseHealth() {
    return this.use_health;
  }

  function getWorkTime() {
    return this.time;
  }

  function getWorkTimeText() {
    return ::getTimeText(this.time);
  }

  function getLevel() {
    return this.level;
  }

  function getRewardVersion() {
    return reward_version;
  }

  function getWorkStartEvent() {
    if (!event_ids || event_ids.len() <= 1) {
      return -1;
    }
    return event_ids[0];

  }

  function getWorkEndEvent() {
    if (!event_ids || event_ids.len() <= 1) {
      return -1;
    }
    return event_ids[1];

  }
}