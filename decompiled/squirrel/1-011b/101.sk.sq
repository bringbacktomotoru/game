      setCharasVisible(b);
      setFurnituresVisible(b);
    }
  }

  function setARParam(result, enable, flipY, device_rotate) {

    local _os_name = skGetOSName();
    local _recognized = ar_module.isRecognized(result);

    local _tMat = null;
    if (enable && _os_name == "iOS") {
      _tMat = result.getTargetMatrix();
      _tMat[14] *= -1.0;
      targetMat = _tMat;
    }

    foreach (chara in charas) {
      chara.setARMode(enable);

      if (is_enabled_prev != enable) {
        chara.setScale(Vector3D(1.0));
        chara.resetPhysicalBones();
      }
    }

    foreach (furniture in furnitures) {
      furniture.setARMode(enable);
    }

    if (enable) {
      if (_os_name == "Android") {
        sarSmartar.sarConvertPose2Matrix(result.position_, result.rotation_, viewmat);
        cameraPos = clone result.position_;
      } else if (_recognized) {
        viewmat = result.getMatrix();
        cameraPos = clone result.position_;

        if (first_result) {
          camera_near = 0.01;
          camera_far = 100.0;
          local _width = rect.w;
          local _height = rect.h;
          ar_module.calcProjectionMatrix(result, _width, _height, camera_near, camera_far);
          local projmat = result.getProjectionMatrix();
          this.renderer.camera[SK_PROJECTION] = projmat;
          this.renderer.camera.prjtype = 1;
          this.renderer.camera.znear = camera_near;
          this.renderer.camera.zfar = camera_far;
          this.renderer.camera.fovy = 0.0;

          first_result = false;
        }
      }
    }

    this.deviceRotate = device_rotate;

    _cameraEnable(enable, _recognized, flipY);

    if (is_enabled_prev != enable) {
      if (enable) {
        first_result = true;
      } else {
        cameraPos = clone BASE_CAMERA_POS;
        image_camera_pos = clone BASE_CAMERA_POS;
        setPerspective(40.0, rect.w, rect.h);
        setImagePerspective(40.0, image_rect.w, image_rect.h);
      }
    }

    is_recognized_prev = _recognized;
    is_enabled_prev = enable;
  }

  function getFixedCameraPos() {
    return this.fixed_camera_pos;
  }

  function setPerspective(fovy, width, height) {
    this.renderer.camera.perspective(fovy, float(width) / height, camera_near, camera_far);
  }

  function setImagePerspective(fovy, width, height) {
    this.image_renderer.camera.perspective(fovy, float(width) / height, camera_near, camera_far);
  }

  function getPerspective() {
    return this.renderer.camera[SK_PROJECTION];
  }

  function getImagePerspective() {
    return this.image_renderer.camera[SK_PROJECTION];
  }

  function setAccelVec(vec) {
    this.accel_vec.set(vec);
  }

  function setTotalGyroRotation(rot) {
    this.total_gyro_rot = rot;
  }

  function setEstimatedPosition(pos) {
    this.estimated_pos = pos;
  }

  function inBoundOtherModel(model, pos) {
    local _is_capture = model.capture_model == null;

    if (model instanceof ARFurnitureModel && model.isOverlaidModel()) return null;

    foreach (chara in charas) {
      local _cm = chara;
      if (_is_capture) _cm = chara.capture_model;

      if (model instanceof ARCharaModel && _cm.getCostumeID() == model.getCostumeID()) continue;
      if (!model.checkHit(pos, _cm.getPos(), _cm.sk3d.bnd)) continue;
      return _cm;
    }

    if (this.house_manager.getRoomInfo()) return null;
    foreach (furniture in furnitures) {
      local _fm = furniture;
      if (_is_capture) _fm = funriture.capture_model;

      if (model instanceof ARFurnitureModel && model.getUID() == _fm.getUID()) continue;
      if (_fm.isOverlaidModel()) continue;
      if (!model.checkHit(pos, _fm.getPos(), _fm.obj.sk3d.bnd)) continue;
      return _fm;
    }

    return null;
  }

