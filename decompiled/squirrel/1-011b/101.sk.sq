  function getImageTalkWindow() {
    return this.image_talk_window;
  }

  function updateARImageParam(result, enable = true, flipY = false, image_device_rotate = -1) {

    local _os_name = skGetOSName();
    local _image_device_rotate = image_device_rotate;
    local _recognized = ar_module.isRecognized(result);

    if (_os_name == "Android") {
      if (_image_device_rotate >= 0) {

        local _flipy = ar_module.isFlipY();
        local _imgrot = ar_module.getCameraImageRotation();
        if ((_flipy && _imgrot == 0) || (!_flipy && _imgrot == 180)) {
          _image_device_rotate = (_image_device_rotate + 180) % 360;
        }
      }
      if (enable) {
        image_camera_pos.set(result.position_);

        local mat = Matrix().set(viewmat);
        if (_image_device_rotate >= 0) {
          local _rotmat = Matrix.fromHPB(0, 0, _image_device_rotate * Math.DTOR);
          for (local i = 4; i < 8; i++) {
            local _tmp = mat[i];
            mat[i] = mat[i + 4];
            mat[i + 4] = _tmp;
          }
          mat = mat.invert44() * _rotmat;
          mat = mat.invert44();
          for (local i = 4; i < 8; i++) {
            local _tmp = mat[i];
            mat[i] = mat[i + 4];
            mat[i + 4] = _tmp;
          }
        }
        imageViewMat = mat;
      }
    } else if (_recognized) {
      viewmat = result.getMatrix();
      imageViewMat = Matrix().set(viewmat);
      image_camera_pos = clone result.position_;

      if (first_result) {
        camera_near = 0.01;
        camera_far = 100.0;
        local _width = image_rect.w;
        local _height = image_rect.h;
        ar_module.calcProjectionMatrix(result, _width, _height, camera_near, camera_far);
        local projmat = result.getProjectionMatrix();
        this.image_renderer.camera[SK_PROJECTION] = projmat;
        this.image_renderer.camera.prjtype = 1;
        this.image_renderer.camera.znear = camera_near;
        this.image_renderer.camera.zfar = camera_far;
        this.image_renderer.camera.fovy = 0.0;

        first_result = false;
      }
    }

    this.imageDeviceRotate = _image_device_rotate;

    _cameraEnable(enable, _recognized, flipY, image_device_rotate);
  }

  function getImageRect() {
    return image_rect;
  }

  function screenTapped(x, y) {
    local _model = getTappedModel(x, y);
    local _image_model = null;

    if (_model instanceof ::ARCharaModel) {
      local _fuid = _model.getTargetFurnitureUID();
      if (_fuid >= 0) _model = getFurnitureModel(_fuid);
    }

    updateSelectModel(_model);

    if (_model instanceof ARCharaModel) {
      tappedCharaModel(_model);
    }
    else if (_model instanceof ARFurnitureModel) {
      tappedFurnitureModel(_model);
    }
    else if (!_model) {
      tappedSpace(x, y);
    }
  }

  function screenDragged() {
    if (!::ENABLE_AR) return false;

    local _cur = getCurrentChara();
    if (!_cur) return false;

    if (this.move_route.len() < 2) return false;

    ::gamesession.getTapViewLayer().killTapEffect();

    _cur.startRouteMoveAction(this.move_route);

    return true;
  }

  function clearMoveRoute(clear = true) {
    interruptDragRouteThread(clear);
    this.route_prev = null;
    this.move_route.clear();
    this.route_length = 0;
  }

  function addMoveRoute(route) {
    if (!::ENABLE_AR) return;

    local _at_room = this.house_manager.getRoomInfo() != null;

    local _cur = getCurrentChara();
    if (!_cur) return;

    local _col_pos;
    if (this.house_manager.getHouseModel()) _col_pos = this.house_manager.getFloorCollisionPos(this.renderer, route.x, route.z);
    else _col_pos = _getPlaneCollisionPos(route.x, route.z);

    if (!_col_pos) return;
    local _move_pos;
    if (_at_room) {
      _move_pos = _col_pos;
    }
    else {
      local _p = _cur.getPos();
      local _v = _col_pos - _p;
      _move_pos = _p + _v;
    }

    if (this.route_prev) {
      local _d = ::getDistance(this.route_prev, _move_pos);
      if (_d < 1) {
        return;
      }
    }
    if (move_route.len() >= MOVE_ROUTE_QUEUE_SIZE) {
      delete move_route[0];
    }

    this.move_route + { pos = _move_pos, timestamp = route.t, first = true, idx = route_length };
    this.route_length = (this.route_length + 1) % MOVE_ROUTE_QUEUE_SIZE;
    this.route_prev = _move_pos;

    if (this.route_length == 2) {
      _startMoveRouteEffect();
    }
  }

  function interruptDragRouteThread(clear = true) {
    if (drag_route_thread && isThreadRunning(drag_route_thread)) {
      drag_route_thread.interruptGoto("END");
    }

    local _cur = getCurrentChara();
    if (clear && _cur && _cur.isRouteMoveAction()) {
      _cur.clearAction(false);
    }
  }

  function _startMoveRouteEffect() {
    if (!drag_route_thread) drag_route_thread = newthread();

    if (isThreadRunning(drag_route_thread)) return;
    local _cur = getCurrentChara();
    if (!_cur) return;
    drag_route_thread.start(_monitorCharaReach, { self = this, route = this.move_route, chara = _cur });
  }

  function _monitorCharaReach() {
    local _effects = [];

    local _rp = self.is_recognized_prev;
    local _rem_idx = 0;

    while ((chara.getPos() - route[0].pos).length() > 0.2) {
      local _visible_changed = false;
      if (_rp != self.is_recognized_prev) {
        _rp = self.is_recognized_prev;
        _visible_changed = true;
      }

      local _del_start_idx = -1;
      local _over = false;
      if (_rem_idx != route[0].idx) {

        _del_start_idx = _rem_idx;
        if (route[0].idx - _rem_idx < 0) _over = true;
        _rem_idx = route[0].idx;

      }
      local _front_route = route[0];
      local _rem_cnt = 0;
      foreach (_efx in _effects) {
        if (_del_start_idx != -1 && !_efx.removed) {
          _efx.removed = (_over && (_del_start_idx <= _efx.idx || _efx.idx < _rem_idx)) || (_del_start_idx <= _efx.idx && _efx.idx < _rem_idx);
        }
        if (!_efx.sk3d.alive) {

          if (_efx.removed) removei;

          _effects + { sk3d = self.generateRouteEffect("/res/efx/ptd/tap_route_loop.ptd", _efx.sk3d.pos), idx = _efx.idx, removed = false };
          removei;
        }
        if (_visible_changed) _efx.sk3d.visible = _rp;

      }

      _effects.extend(self.drawDragRoute(route));
      sleep(16 * 10);
    }
    sleep(300);
    END:
    if (self.getCurrentChara() != chara) {

      chara.clearAction(false);
    }

    foreach (_efx in _effects) {
      _efx.sk3d.kill();
      removei;
    }
    return;
  }

  function drawDragRoute(route) {

    local _effects = [];
    foreach (r in route) {
      if (!r.first) continue;
      _effects + { sk3d = generateRouteEffect("/res/efx/ptd/tap_route.ptd", r.pos), idx = r.idx, removed = false };
      r.first = false;
    }
    return _effects;
  }

  function generateRouteEffect(path, pos) {
    local _p_efx = getParticleEffect(::getResource(path));
    local _ptd = ::SK3DObject();

    _ptd.pos.set(pos);
    _ptd.scale.set(2.7);
    _ptd.matdirty = true;
    _ptd.updateMatrix();
    _ptd.visible = is_recognized_prev;

    this.scene.addObject(_ptd);

    _ptd.setParticle(_p_efx);
    _ptd.startParticle();
    return _ptd;
  }

  function tappedSpace(x, y) {

    if (::ENABLE_AR) conductCharas_atScreenPos(x, y);
  }

  function _getPlaneCollisionPos(screen_x, screen_y) {
    local v = Vector3D(screen_x / ::displayWidth, screen_y / ::displayHeight, 1.0);

    local _q1 = Vector3D().set(this.fixed_camera_pos);
    local _q2 = this.renderer.camera.unproject(v);

    local _rectangle = ar_module.getRectangle(Vector3D(0, 0, 0));
    if (!_rectangle) return null;
    local _p = _rectangle.getVertexes()[0].position_;
    local _n = Vector3D(0.0, 1.0, 0.0);

    local _pq1 = _p - _q1;
    local _pq2 = _p - _q2;
    local _dot_pq1 = _pq1.dot(_n);
    local _dot_pq2 = _pq2.dot(_n);

    if (Math.abs(_dot_pq1) < 1e-05) { _dot_pq1 = 0.0; }
    if (Math.abs(_dot_pq2) < 1e-05) { _dot_pq2 = 0.0; }

    if (_dot_pq1 == 0.0 && _dot_pq2 == 0.0) {

      println("lay to rectangle can't calc to cross.");
      return null;
    } else if (!((_dot_pq1 >= 0.0 && _dot_pq2 <= 0.0) || (_dot_pq1 <= 0.0 && _dot_pq2 >= 0.0))) {
      println("lay to rectangle don't cross.");
      return null;
    }

    local _q1q2 = _q2 - _q1;

    local _ratio = Math.abs(_dot_pq1) / (Math.abs(_dot_pq1) + Math.abs(_dot_pq2));

    local _v = (_q1q2 * _ratio);
    return _q1 + _v;
  }

  function conductCharas_atScreenPos(screen_x, screen_y) {
    local _t = skGetTime();
    if (next_can_conduct_time > _t) return;

    local _panel = ::gamesession.getCurrentScene().getUI().getCurrentPanel();
    if (!(_panel instanceof ARPanel)) return;
    if (!_panel.getCharaUIEnable(this.current_chara_id)) return;

    local _col_pos;
    if (this.house_manager.getHouseModel()) _col_pos = this.house_manager.getFloorCollisionPos(this.renderer, screen_x, screen_y);
    else _col_pos = _getPlaneCollisionPos(screen_x, screen_y);

    if (!_col_pos) return;
    local _DIST = 0.01 * ar_module.getCoodinateSystemScale();

    local p_efx = getParticleEffect(::getResource("/res/efx/ptd/tap_floor.ptd"));
    local _ptd = ::SK3DObject();

    _ptd.pos.set(_col_pos);
    _ptd.scale.set(2, 2, 2);
    _ptd.matdirty = true;
    _ptd.updateMatrix();

    this.scene.addObject(_ptd);

    _ptd.setParticle(p_efx);
    _ptd.startParticle();
    ::gamesession.getTapViewLayer().killTapEffect();

    local _chara = getCurrentCharaModel();
    if (_chara) {
      local _p = _chara.getPos();
      local _v = _col_pos - _p;

      this.talk_window.interruptTalkWindow(_chara.getCostumeID())

      local _suc;
      if (this.house_manager.getHouseModel()) {
        _suc = _chara.startMoveAction(_col_pos);
      }
      else {
        _suc = _chara.startMoveAction(_p + _v);
      }

      if (_suc) {

        interruptDragRouteThread();

        _panel.setEnableMotions(::ARPanel.UI_STATE_ENABLE, _chara.getCharaID());
      }
    }

    next_can_conduct_time = _t + NEXT_CONDUCT_INTERVAL;
  }

  function _removeTappedCharaEffect() {

    if (this.select_chara_models.len() > 0) {

      local _cur = this.charas[this.select_chara_models[0]];
      if (_cur) _cur.startEffect("removeFocusEffect");
    }
  }

  function tappedCharaModel(model) {

    if (model.hasTappedScript()) {
      model.startTappedScript();
      return;
    }

    if (model == this.focus_chara) {
      this.sentence_manager.execTapTalk(model);
      return;
    }

    this.select_chara_models.clear();
    this.select_chara_models + model.getCharaID();
    _updateCurrentCharaID();

    this.replaceApprochList(model, true);

    local _fuid = model.getTargetFurnitureUID();
    if (_fuid > 0) {
      local _fm = getFurnitureModel(_fuid);
      _fm.tapProduct();
    }

  }

  function _searchFurnitures(screen_x, screen_y) {
    local _v = Vector3D(screen_x / ::displayWidth, screen_y / ::displayHeight, 0.0);

    local near = this.renderer.camera.unproject(_v);
    _v.z = 1.0;
    local far = this.renderer.camera.unproject(_v);

    scene.b3world.updateAABBs();
    local b3res = scene.b3world.rayTest(1, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);
    if (b3res.len() < 1) return null;
    foreach (model in furnitures) {
      if (model.getB3body() == b3res.bodyb) {
        return model;
      }
    }
    return null;
  }

  function tappedFurnitureModel(model) {
    local _now = skGetTime();

    if (!model.getFurnitureSetting().canUseFurniture()) return;

    model.startEffect("focusEffectFurniture");

    local _fd = model.getFurnitureData();
    if (_fd.hasProductData()) {
      local _pd = _fd.getProductData();
      local _cid = _pd.getCostumeIDList()[0] || -1;
      if (_cid > 0) {
        local _setting = ::gamesetting.costume_settings[_cid];
        local _chara_id = _setting.getCharaID();
        local _cm = getChara(_chara_id);
        tappedCharaModel(_cm);
        return;
      }
    } else {
      if (this.last_select_model instanceof ::ARCharaModel) {
        this.approach_model = popApproachChara();
        this.attract_model = model;
        this.start_attract_time = _now;
      } else {

        if (!this.approach_model || this.last_tap_time + ::SanrioGameScene.CHARACTER_APPROACH_LIMIT < _now) {
          this.approach_model = popApproachChara();
          this.attract_model = model;
          this.start_attract_time = _now;
        }
      }

      if (this.approach_model) {
        if (!this.approach_model.isPlayRandomAction()) {
          return;
        }

        local _is_add = model.addAttractChara(this.approach_model);
        if (_is_add) {
          this.chara_appeal_layer.addAttractBalloon(this.approach_model);
        }
        model.updateAttractTime();
      }
    }

    this.last_tap_time = _now;
  }

  function updateSelectModel(model) {
    this.last_select_model = this.select_model;
    this.select_model = model;
  }

  function selectTappedModels_startTappedMotion(screen_x, screen_y) {
    if (skGetTime() - last_tapped < LAST_TAPPED_INTERVAL) {
      last_tapped = skGetTime();
      return;
    }
    last_tapped = skGetTime();

    local chara = getCurrentChara();

    if (chara.isFurnitureScriptRunning()) return;
    if (!chara.canInterruptAction()) return;

    local _viewmat = Matrix().set(this.renderer.camera[1]);
    local _v0 = fixed_camera_pos;
    local _v1 = _v0 - chara.getPos();
    local _v3 = _v1 * -1;

    local _v2 = -Vector3D(_viewmat[2], _viewmat[6], _viewmat[10]);
    local _cos_theta = _v3.dot(_v2) / (_v3.length() * _v2.length());
    local _dist = _v3.length() * _cos_theta;

    local pos = s2wPos(screen_x * getViewScale(), screen_y * getViewScale(), _dist);

    pos.z = chara.getPos().z;

    if (!chara.inBounds(pos)) {
      selectAllModels();
      _updateCurrentCharaID();
      return;
    }

    _v1.normalize();

    _viewmat[12] = 0;
    _viewmat[13] = 0;
    _viewmat[14] = 0;

    local _v2 = Vector3D(0, 0, -1);

    local _rot = Quaternion.from2Axis(_v1, _v2);
    local _hpb = _rot.toMatrix().getHPB();

    local _tasks = chara.createTapScriptAction(_hpb.x);
    chara.setupTasks(_tasks);
  }

  function moveSelectModel_atScreenPos(screen_x, screen_y) {

    foreach (chara_id in select_chara_models) {
      local _model = charas[chara_id];
      local _pos = _model.getPos();
      local _screen_pos = w2sPos(_pos);

      local _viewmat = Matrix().set(this.renderer.camera[1]);
      local _v0 = clone BASE_CAMERA_POS;
      local _v1 = _pos - _v0;

      local _v2 = -Vector3D(_viewmat[2], _viewmat[6], _viewmat[10]);
      local _cos_theta = _v1.dot(_v2) / (_v1.length() * _v2.length());
      local _dist = _v1.length() * _cos_theta;
      local _v_1 = s2wPos(_screen_pos.x + (screen_x * getViewScale()), _screen_pos.y + (screen_y * getViewScale()), 8.0);

      local _x = _v_1.x;
      local _y = _v_1.y;

      _model.setBothModelPos(_v_1);
    }
  }

  function rotateSelectModel_atScreenXY(screen_x, screen_y) {
    foreach (chara_id in select_chara_models) {
      local _model = charas[chara_id];

      local _v1 = Vector3D(screen_x, screen_y, 0.0).normalize();
      local _v2 = Vector3D(0.0, 1.0 0.0);

      local _dot = _v1.x * _v2.x + _v1.y * _v2.y;
      local _len = _v1.length() * _v2.length();
      local _cos = Math.clamp((_dot / _len), -1, 1);
      local _theta = int(Math.abs(Math.acos(_cos) * Math.RTOD));

      local _before = _theta;
      while (_theta > 90) { _theta -= 90; }

      if (_theta >= 30 && _theta <= 60) return;

      local _rot = _model.getRotation();
      local _rot2 = Quaternion.fromAxis(-screen_y * Math.DTOR, Vector3D(1, 0, 0));
      local _rot3 = Quaternion.fromAxis(-screen_x * Math.DTOR, Vector3D(0, 1, 0));
      _rot3.synthesize(_rot2);
      _rot = _rot3.synthesize(_rot);
      _rot.normalize();
      _model.setBothModelRotation(_rot);
    }
  }

  function ScalingSelectModel_atPinch(scale) {
    foreach (chara_id in select_chara_models) {
      local _model = charas[chara_id];
      local _scale = _model.getScale();
      _scale += Vector3D(scale);
      if (_scale.lengthSq() < 0.5) {
        continue;
      }
      _model.setBothModelScale(_scale);
    }
  }

  function w2sPos(pos) {
    local v = this.renderer.camera.project(pos);
    v.x *= ::screenWidth;
    v.y *= ::screenHeight;
    v.z = 0.0;

    return v;
  }

  function s2wPos(x, y, rate_z) {
    local ratex = x / rect.w;
    local ratey = y / rect.h;
    local v = Vector3D(ratex, ratey, 0.0);
    local pos_near = this.renderer.camera.unproject(v);

    v.z = 1.0;
    local pos_far = this.renderer.camera.unproject(v);

    local _r = rate_z / (pos_far - pos_near).length();
    local _world_x = pos_near.x + (pos_far.x - pos_near.x) * _r;
    local _world_y = pos_near.y + (pos_far.y - pos_near.y) * _r;
    local _world_z = pos_near.z + (pos_far.z - pos_near.z) * _r;

    return v.set(_world_x, _world_y, _world_z);
  }

  function addTalkWindow(sk3d, talk_key, chara_key, small) {

    local _charas = charas;
    foreach (chara in _charas) {
      if (chara.sk3d != sk3d) continue;
      this.talk_window.addTalk(sk3d, talk_key, chara_key, chara.getCostumeID(), this.renderer.camera, -1, small);
      return;
    }
    foreach (chara in _charas) {
      local _cm = chara.capture_model;
      if (_cm.sk3d != sk3d) continue;

      local _tw = getTalk(talk_key, chara_key);
      if (!_tw) {
        println("does not have talkkey in model_viewer.....");
        return;
      }
      this.image_talk_window.addTalk(sk3d, talk_key, chara_key, chara.getCostumeID(), this.image_renderer.camera, _tw.talk_index, small);
      return;
    }
  }

  function removeAllTalkWindow() {
    talk_window.removeAllTalkWindow();
    image_talk_window.removeAllTalkWindow();
  }

  function getTalkView() {
    return this.talk_view;
  }

  function getTalk(talk_key, chara_key) {
    return talk_window.getTalk(talk_key, chara_key);
  }

  function rebuildTalk(big_size) {
    image_talk_window.rebuildRandomTalk(big_size);
  }

  function flushTalkWindowPosition() {
    image_talk_window.flushPosition();
  }

  function flushTalkWindowScale(sc) {
    image_talk_window.flushScale(sc);
  }

  function updateSceneBound() {
    image_talk_window.updateSceneBound();
  }

  function registerDir(dir) {

    this.capture_dir = dir;
  }

  function flushTalkWindowRotation(is_record, is_capture) {
    local _prev_accel = Vector3D().set(accel_vec);
    local _ret = 0.0;
    if (!is_recognized_prev || !is_enabled_prev || is_capture) {
      accel_vec.set(0.0, 0.0, 0.0);
    }
    if (!is_record && !is_capture) {
      this.deviceRotate = is_enabled_prev ? 0.0 : this.deviceRotate * -1.0;
      local _device_rot = this.deviceRotate;

      local _dir = this.deviceRotate;
      if (ENABLE_AR) {
        local _a = !is_record && !is_capture;
        local _flipy = ar_module.isFlipY();
        local _imgrot = ar_module.getCameraImageRotation();

        if (_a) {

          if ((_flipy && _imgrot == 0) || (!_flipy && _imgrot == 180)) {
            _dir += 180.0;
            if (_dir > 360.0) _dir -= 360.0;
          }
        }
      }
      talk_window.updateOffset(_dir, is_enabled_prev);

      _dir = calcAcculateDeviceRotation();
      _dir += _device_rot;

      if (ENABLE_AR) {

        local _a = !is_record && !is_capture && !is_recognized_prev && is_enabled_prev;
        local _flipy = ar_module.isFlipY();
        local _imgrot = ar_module.getCameraImageRotation();
        if (!_a) {
          if ((_flipy && _imgrot == 0) || (!_flipy && _imgrot == 180)) {
            _dir += 180.0;
            if (_dir > 360.0) _dir -= 360.0;
          }
        }
      }
      _ret = _dir * Math.DTOR;
      talk_window.update(_ret);
    } else {

      local _image_device_rot = is_enabled_prev && !is_record ? 0.0 : this.imageDeviceRotate * -1.0;

      if ((is_record || is_capture) && !is_enabled_prev) {

        _image_device_rot -= capture_dir * (is_record ? -1.0 : 1.0);
      }
      if (is_record && is_enabled_prev) {
        _image_device_rot = capture_dir;
      }

      local _image_dir = _image_device_rot;
      local _p = false;

      image_talk_window.updateOffset(_image_dir, is_enabled_prev);

      _image_dir = calcAcculateDeviceRotation();
      _image_dir += _image_device_rot;

      if (ENABLE_AR) {

        local _b = is_record && !is_capture && is_recognized_prev && is_enabled_prev;
        local _c = !is_record && is_capture && is_enabled_prev;
        local _flipy = ar_module.isFlipY();
        local _imgrot = ar_module.getCameraImageRotation();

      }
      _ret = _image_dir * Math.DTOR;
      image_talk_window.update(_ret);
    }

    accel_vec.set(_prev_accel);

    return _ret;
  }

  function setProp() {
    local _cur = getCurrentChara();
    if (!_cur) return;
    local _dlg = ::PropDialog();
    _dlg.setCharaModel(_cur);
    _dlg.show();

  }
}

class ::ARModelViewer.TalkWindow extends SKView {

  layer = null;

  function setWindowLayer(layer) {
    this.layer = layer;
  }

  function removed() {
    layer = null;
  }

  function removeChild(c) {
    if (layer) {
      local _balloons = layer.balloons;
      foreach (i, _balloon in _balloons) {
        if (_balloon != c) continue;
        delete _balloons[i];
        break;
      }
    }
    return super.removeChild(c);
  }

}