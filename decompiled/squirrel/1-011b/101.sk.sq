class ARModelViewer extends SKView {
  static BASE_CAMERA_POS = Vector3D(0.0, 1.4, -8.0);
  static DEVICE_ROTATION_INTERVAL = 5;
  static LAST_TAPPED_INTERVAL = 2000.0;
  static NEXT_CONDUCT_INTERVAL = 2000;
  static CANCEL_USE_FURNITURE_COUNT = 3;
  static FURNITURE_BARRAGE_LIMIT = 800;
  static FOCUS_TIME = 5000;
  static MOVE_ROUTE_QUEUE_SIZE = 50;

  current_chara_id = null;

  rect = null;
  image_rect = null;

  scene = null;
  renderer = null;
  sk3dview = null;

  image_scene = null;
  image_renderer = null;
  image_sk3dview = null;

  charas = null;
  furnitures = null;
  house_manager = null;

  select_chara_models = null;

  last_tap_time = -1;
  attract_model = null;
  approach_model = null;
  approach_chara_list = null;
  select_model = null;
  last_select_model = null;
  start_attract_time = -1;

  current_furniture_id = -1;

  current_pos = null;
  total_move = null;

  viewmat = null;
  imageViewMat = null;
  cameraPos = null;
  image_camera_pos = null;
  fixed_camera_pos = null;
  image_fixed_camera_pos = null;
  target_pos = null;
  camera_rot = null;
  recognized_count = 0;
  first_result = true;

  is_recognized_prev = false;
  is_enabled_prev = false;
  camera_near = 1.0;
  camera_far = 100.0;

  ar_module = null;

  texture_landmark = null;
  landmark_particle_map = null;
  liner = null;

  talk_view = null;
  talk_window = null;
  image_talk_view = null;
  image_talk_window = null;
  sentence_manager = null;

  accel_vec = null;
  v_1 = null;
  v_2 = null;
  deviceRotate = 0;
  imageDeviceRotate = 0;
  capture_dir = 0;
  prev_device_rotation = 0;

  total_gyro_rot = null;
  estimated_pos = null;
  recognition_lost_gyro = null;
  recognition_lost_pos = null;
  fixed_tar = null;
  fixed_up = null;
  image_fixed_tar = null;
  image_fixed_up = null;

  last_tapped = null;

  origin = null;

  landmark_update_time = 0;

  next_can_conduct_time = 0;

  chara_appeal_layer = null;

  last_furniture_tap = -1;
  furniture_barrage_count = 0;

  focus_chara = null;
  focus_time = -1;
  focus_lock = false;

  drag_route_thread = null;
  route_prev = null;
  move_route = null;
  route_length = 0;

  shutter_chance_manager = null;
  last_exec_motion_id = -1;

  targetMat = null;

  constructor(rect) {
    super();
    charas = {};
    furnitures = {};
    updateRect(rect);
    image_rect = clone rect;
    viewmat = Matrix();
    imageViewMat = Matrix();
    cameraPos = Vector3D();
    image_camera_pos = Vector3D();
    target_pos = Vector3D(0, 0.5, 0);
    camera_rot = Vector3D();

    is_enabled_prev = ::ENABLE_AR;
    current_chara_id = -1;

    texture_landmark = Texture().create(32, 32, SK_RGBA, 3, 0);
    landmark_particle_map = {};
    liner = [];
    this.accel_vec = Vector3D();
    this.fixed_camera_pos = Vector3D();
    this.image_fixed_camera_pos = Vector3D();
    this.last_tapped = 0;

    this.approach_chara_list = [];

    this.recognition_lost_gyro = Quaternion();
    this.recognition_lost_pos = Vector3D();
    fixed_tar = Vector3D();
    fixed_up = Vector3D();
    image_fixed_tar = Vector3D();
    image_fixed_up = Vector3D();

    this.move_route = [];

    this.shutter_chance_manager = ARShutterChanceManager(this);
  }

  function loadStageScene() {
    total_move = current_pos = Vector3D();

    this.scene = SK3DScene();
    this.scene.getB3World();
    this.renderer = createSceneRenderer();

    this.sk3dview = SK3DView(this.scene, this.renderer);
    this.sk3dview.setRect(rect.x, rect.y, rect.w, rect.h);
    this.sk3dview.setAutoUpdate(false);

    this.image_scene = SK3DScene();
    this.image_scene.getB3World();
    this.image_renderer = createSceneRenderer();
    this.image_sk3dview = SK3DView(this.image_scene, this.image_renderer);
    this.image_sk3dview.setRect(image_rect.x, image_rect.y, image_rect.w, image_rect.h);
    this.image_sk3dview.setAutoUpdate(false);

    addChild(sk3dview);

    this.scene.clearObjects();
    this.image_scene.clearObjects();

    this.renderer.camera.lookat(BASE_CAMERA_POS, Vector3D(0, 0.5, 0));
    this.image_renderer.camera.lookat(BASE_CAMERA_POS, Vector3D(0, 0.5, 0));

    this.fixed_camera_pos.set(BASE_CAMERA_POS);
    this.image_fixed_camera_pos.set(BASE_CAMERA_POS);

    this.renderer.cullfilterfunc = function(o) {
      if (o.parent) {
        return self.cullfilterfunc(o.parent);
      }
      self.v_1.set(o.pos).sub(pos);
      return self.v_1.length() >= o.visible_distance ? true : false;
    }.bindenv({ self = this.renderer, pos = fixed_camera_pos });

    this.image_renderer.cullfilterfunc = function(o) {
      if (o.parent) {
        return self.cullfilterfunc(o.parent);
      }
      self.v_1.set(o.pos).sub(pos);
      return self.v_1.length() >= o.visible_distance ? true : false;
    }.bindenv({ self = this.renderer, pos = image_fixed_camera_pos });

    cameraPos = clone BASE_CAMERA_POS;
    image_camera_pos = clone BASE_CAMERA_POS;
    local w = rect.w, h = rect.h;
    this.renderer.camera.perspective(40.0, float(w) / h, camera_near, camera_far);
    this.image_renderer.camera.perspective(40.0, float(w) / h, camera_near, camera_far);

    _cameraEnable(false);

    local env = SK3DEnvironment(::gamesetting.scnenv["morning"]);
    this.scene.setEnvironment(env);
    this.image_scene.setEnvironment(env);

    setRenderSetting(false);

    select_chara_models = [];
    selectAllModels();

    talk_view = TalkWindow();
    talk_view.setRect(rect.x, rect.y, rect.w, rect.h);
    talk_window = ARTalkWindowLayer(talk_view);
    talk_view.setWindowLayer(talk_window);

    this.chara_appeal_layer = ARCharaAppealLayer(this);

    image_talk_view = TalkWindow();
    image_talk_view.setRect(image_rect.x, image_rect.y, image_rect.w, image_rect.h);
    image_talk_window = ARTalkWindowLayer(image_talk_view);
    image_talk_view.setWindowLayer(image_talk_window);

    this.addChild(talk_view);

    this.sentence_manager = ARSentenceManager(this, talk_window, image_talk_window, this.renderer.camera, this.image_renderer.camera);

    imageDeviceRotate = deviceRotate = 0;

    this.house_manager = ARHouseManager(this.scene, this.image_scene);
  }

  function removed() {
    super.removed();
    this.ar_module = null;
    talk_view = null;
    this.accel_vec = null;
    this.move_route = null;
  }

  function setARModule(ar_module) {
    this.ar_module = ar_module;
    foreach (chara in charas) {
      chara.setARModule(ar_module);
    }
    this.talk_window.setARModule(ar_module);
  }

  function setARPanel(pnl) {
    this.shutter_chance_manager.setARPanel(pnl);
  }

  function setRenderSetting(enable_ios_movie) {
    local env = SK3DEnvironment(::gamesetting.scnenv["morning"]);
    local model_render = ::createRenderSetting(env["postfx"]);
    local _shadow_rs = ::createRenderSetting({});

    if (enable_ios_movie) {
      model_render.passes[2] = {
        cls = "FXMixImageBGRAPass"
        src1 = "colortex"
        src2 = "eighthtex"
        target = null
      };
    }
    renderer.setRenderSetting(model_render);

    image_renderer.setRenderSetting(model_render);
  }

  function selectAllModels() {

    select_chara_models.clear();
    foreach (id, chara in charas) {

      chara.setDark(false);

      select_chara_models + id;

    }
    _updateCurrentCharaID();
  }

  function _updateCurrentCharaID() {
    if (select_chara_models.len() != 1) current_chara_id = -1;
    else current_chara_id = select_chara_models[0];
  }

  function selectAllClear() {
    foreach (chara_id in select_chara_models) {
      local model = charas[chara_id];
      model.setDark(true);
    }

    select_chara_models.clear();
    _updateCurrentCharaID();
  }

  function _cameraEnable(enable, recognized = false, flipY = false, image_device_rotate = -1) {
    if (enable) {
      if (recognized) {
        local _camera_value = ar_module.calcCameraMatrix(cameraPos, viewmat, flipY, targetMat);
        this.fixed_camera_pos.set(_camera_value[0]);
        this.fixed_tar.set(_camera_value[1]);
        this.fixed_up.set(_camera_value[2]);
        this.renderer.camera.lookat(_camera_value[0], _camera_value[1], _camera_value[2]);

        _camera_value = ar_module.calcCameraMatrix(image_camera_pos, imageViewMat, flipY, targetMat);
        this.image_fixed_camera_pos.set(_camera_value[0]);
        this.image_fixed_tar.set(_camera_value[1]);
        this.image_fixed_up.set(_camera_value[2]);
        this.image_renderer.camera.lookat(_camera_value[0], _camera_value[1], _camera_value[2]);
      } else {

        if (ARPanel.SENSOR_ESTIMATE_ENABLED) {
          if (!total_gyro_rot) return;

          if (is_recognized_prev) {
            recognition_lost_gyro.set(total_gyro_rot);
            recognition_lost_pos.set(estimated_pos * ar_module.getCoodinateSystemScale() * 5.0);
          }

          local _hpb = total_gyro_rot.toMatrix().getHPB();
          local _lost_hpb = recognition_lost_gyro.toMatrix().getHPB();

          local _r = Quaternion.fromHPB((_hpb.x - _lost_hpb.x), _hpb.y - _lost_hpb.y, (_hpb.z - _lost_hpb.z));

          local _t = _r * (fixed_tar - fixed_camera_pos);
          local _u = _r * (fixed_up);

          local _v = Vector3D().set(recognition_lost_pos) - (estimated_pos * ar_module.getCoodinateSystemScale() * 5.0);

          local _e = fixed_camera_pos + _v;
          this.renderer.camera.lookat(_e, _e + _t, _u);

          _hpb = _r.toMatrix().getHPB() * Math.RTOD;

        } else {
          local _eye = clone BASE_CAMERA_POS;
          local _tar = Vector3D(0, 0.5, 0);
          local _upvec = Vector3D(0.0, 1.0, 0.0);

          this.fixed_camera_pos.set(_eye);
          this.renderer.camera.lookat(_eye, _tar, _upvec);

          if (image_device_rotate >= 0) {
            local _mat = Matrix.fromHPB(0, 0, image_device_rotate * Math.DTOR);
            _eye.transform0(_mat);
            _tar.transform0(_mat);
            _upvec.transform0(_mat);
          }
          this.image_fixed_camera_pos.set(_eye);
          this.image_renderer.camera.lookat(_eye, _tar, _upvec);

        }
      }
    } else {
      local _eye = clone BASE_CAMERA_POS;
      local _tar = Vector3D(0, 0.5, 0);
      local _upvec = Vector3D(0.0, 1.0, 0.0);

      this.fixed_camera_pos.set(_eye);
      this.renderer.camera.lookat(_eye, _tar, _upvec);

      if (image_device_rotate >= 0) {
        local _mat = Matrix.fromHPB(0, 0, image_device_rotate * Math.DTOR);
        _eye.transform0(_mat);
        _tar.transform0(_mat);
        _upvec.transform0(_mat);
      }
      this.image_fixed_camera_pos.set(_eye);
      this.image_renderer.camera.lookat(_eye, _tar, _upvec);
    }
  }

  function calcAcculateDeviceRotation() {
    if (accel_vec.length() < 0.01) return 0.0;
    if (!v_1) v_1 = Vector3D();
    if (!v_2) v_2 = Vector3D();
    v_1.set(accel_vec.x, accel_vec.y, 0.0).normalize();
    v_2.set(1.0, 0.0, 0.0);
    local _flag = v_1.y < 0.0 ? 1.0 : -1.0;

    local cos_theta = v_1.dot(v_2) / (v_1.length() / v_2.length());
    local _dir = Math.acos(cos_theta) * Math.RTOD * _flag;
    if (Math.abs(prev_device_rotation - _dir) > DEVICE_ROTATION_INTERVAL) prev_device_rotation = _dir;

    return prev_device_rotation;
  }

  function update(dt) {
    sk3dview.updateScene(dt);
    image_sk3dview.updateScene(dt);

    local _dir = flushTalkWindowRotation(false, false);
    flushTalkWindowRotation(true, false);
    this.chara_appeal_layer.update(_dir, dt);

    foreach (chara in charas) {
      chara.update(dt);
    }

    foreach (furniture in furnitures) {
      furniture.update(dt);
    }

    updateLayout();

    this.shutter_chance_manager.update(dt);
  }

  function updateLandmarks(landmarks, corners, rectangle) {
    if (landmarks.len() == 0 || corners.len() == 0 || rectangle.len() == 0) return;

    local _cnt = rectangle.len();
    local sub = _cnt - liner.len();
    if (sub > 0) {
      for (local i = 0; i < sub; i++) liner + _createLineParticle();
    } else if (sub < 0) {
      local min = liner.len() + sub;
      for (local i = liner.len() - 1; i >= min; i--) {
        this.scene.removeObject(liner[i]);
        delete liner[i];
      }
    }

    local _sub = 0;
    local last = rectangle.len();
    for (local i = 0; i < last; i++) {
      local _vtx0 = clone rectangle[i];
      local _vtx1 = clone rectangle[(i + 1) % last];

      if (!liner[i - _sub].ptc) {
        this.scene.removeObject(liner[i - _sub]);
        delete liner[i - _sub];
        _sub++;
      } else {
        local _vec1 = _vtx1.getPosition() - _vtx0.getPosition();
        local _half_len = _vec1.length() / 2;
        liner[i - _sub].ptc.groups[0].ptch = _half_len;
        local _rot1 = _aimQuaternion(_vec1.normalize());
        liner[i - _sub].ptc.groups[0].gmat.setSRT(_vtx0.getPosition() + _rot1 * Vector3D(0, 0, _half_len), Vector3D(1.0), _rot1);
        liner[i - _sub].matdirty = true;
      }
    }
  }

  static function _aimQuaternion(v) {
    local h = Math.atan2(v.x, v.z);
    local p = Math.asin(-v.y);
    return Quaternion.fromHPB(h, p, 0.0);
  }

  function _createPerticleEffect() {
    local p = ParticleEffect();
    local pg = ParticleGroup();
    p.gmat = Matrix();
    pg.aimtype = 0;
    pg.emitter = _particleEmitter();

    pg.ptcw = 0.005 * ar_module.getCoodinateSystemScale();
    pg.ptch = 0.005 * ar_module.getCoodinateSystemScale();
    pg.ptcaxis = 1;
    pg.m = Material();
    pg.m.Kd = 0xffffffff;
    pg.m.blend = SK_PMASRCMIX;
    pg.m.depthmask = 0;
    pg.m.cullface = SK_OFF;
    pg.gmat = p.gmat;
    pg.m.tec = skFXFindTechnique("decal.def");
    pg.m.tex0 = texture_landmark;
    p.groups = [pg];

    local _sk3d = SK3DObject(p);
    _sk3d.pos << Vector3D(0.0);
    _sk3d.rot << Quaternion(0.0, 0.0, 0.0, 1.0);
    _sk3d.scale << Vector3D(1.0);
    _sk3d.matdirty = true;
    _sk3d.updateMatrix();

    this.scene.addObject(_sk3d);

    if (!_sk3d.startScript("start")) {
      if (_sk3d.ptc) _sk3d.startParticle(false);
    }

    return _sk3d;
  }

  function _createLineParticle() {
    local p = ParticleEffect();
    local pg = ParticleGroup();
    p.gmat = Matrix();
    pg.aimtype = 0;
    pg.emitter = _particleEmitter();

    pg.ptcw = 0.00125 * ar_module.getCoodinateSystemScale();
    pg.ptch = 0.0025;
    pg.lmat = Matrix().identity();
    pg.ptcaxis = 1;
    pg.m = Material();
    pg.m.Kd = 0xffffffff;
    pg.m.blend = SK_PMASRCMIX;
    pg.m.depthmask = 0;
    pg.m.cullface = SK_OFF;
    pg.gmat = p.gmat;
    pg.m.tec = skFXFindTechnique("decal.def");
    p.groups = [pg];

    local _sk3d = SK3DObject(p);
    _sk3d.pos << Vector3D(0.0);
    _sk3d.rot << Quaternion(0.0, 0.0, 0.0, 1.0);
    _sk3d.scale << Vector3D(1.0);
    _sk3d.matdirty = true;
    _sk3d.updateMatrix();

    this.scene.addObject(_sk3d);

    if (!_sk3d.startScript("start")) {
      if (_sk3d.ptc) _sk3d.startParticle(false);
    }

    return _sk3d;
  }

  function _particleEmitter() {
    local _emit = with ParticleEmitter() {
      num = 1
      start = 0, start_spr = 0
      life = 10000, life_spr = 10000
      posx = 0.0, posy = 0.0, posz = 0.0
      pos_sprx = 0.0, pos_spry = 0.0, pos_sprz = 0.0
      dirx = 0.0, diry = 0.0, dirz = 0.0
      dir_sprx = 0, dir_spry = 0.0, dir_sprz = 0
    };

    return _emit;
  }

  function clearObjects() {
    removed();
    clearCharas();
    clearFurnitures();
    scene.clearObjects();
    select_chara_models.clear();

  }

  function destruct() {
    clearObjects();
    total_move = current_pos = null;
    this.scene = null;
    this.renderer = null;
    this.image_scene = null;
    this.image_renderer = null;

    removeChild(sk3dview);
    this.sk3dview = null;
    this.image_sk3dview = null;

    select_chara_models.clear();
    select_chara_models = null;
    current_chara_id = -1;

    interruptDragRouteThread();
    drag_route_thread = null;
  }

  function clearCharas() {
    foreach (uid, chara in charas) {
      chara.release();
    }

    Table.clear(charas);
    selectAllModels();
  }

  function clearFurnitures() {
    foreach (uid, furniture in furnitures) {
      furniture.disconnectCharas();
      furniture.release();
    }
    Table.clear(furnitures);
  }

  function updateLayout() {
    super.updateLayout();
    repaint();
  }

  function updateRect(rect, lx = 0, ly = 0) {
    this.rect = rect;
    if (this.sk3dview) this.sk3dview.setRect(rect.x, rect.y, rect.w, rect.h, lx, ly);
    if (this.talk_view) {
      this.talk_view.setRect(rect.x, rect.y, rect.w, rect.h, lx, ly);
      this.talk_view.updateLayout();
    }
  }

  function getTappedModel(screen_x, screen_y) {
    local _is_furniture_only = false;

    local _now = skGetTime();

    if (this.last_tap_time + ::SanrioGameScene.FURNITURE_BARRAGE_LIMIT > _now) {
      _is_furniture_only = true;
    }

    local _v = Vector3D(screen_x / ::displayWidth, screen_y / ::displayHeight, 0.0);

    local near = this.renderer.camera.unproject(_v);
    _v.z = 1.0;
    local far = this.renderer.camera.unproject(_v);

    scene.b3world.updateAABBs();

    local b3res = scene.b3world.rayTest(0, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);
    if (b3res.len() < 1) return null;

    foreach (model in furnitures) {
      if (!model.visible) continue;
      if (model.getB3body() == b3res.bodyb) {
        return model;
      }
    }

    if (_is_furniture_only) return null;

    foreach (model in charas) {
      if (!model.visible) continue;
      if (model.getB3body() == b3res.bodyb) {
        return model;
      }
    }
    return null;
  }

  function getTappedFurnitureModel(screen_x, screen_y) {
    local _v = Vector3D(screen_x / ::displayWidth, screen_y / ::displayHeight, 0.0);

    local near = this.renderer.camera.unproject(_v);
    _v.z = 1.0;
    local far = this.renderer.camera.unproject(_v);

    scene.b3world.updateAABBs();

    local b3res = scene.b3world.rayTest(0, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);
    if (b3res.len() < 1) return null;

    foreach (model in furnitures) {
      if (!model.visible) continue;
      if (model.getB3body() == b3res.bodyb) {
        return model;
      }
    }

    return null;
  }

  function addCharaByCostumeId(costume_id = 0, susp = false, rebuild = false) {

    local _attr = null;

    local _chara_id = ::gamesetting.costume_settings[costume_id].getCharaID();
    local _chara = null;
    if (charas[_chara_id]) {
      _chara = charas[_chara_id];
      if (rebuild) {
        _attr = { pos = Vector3D(_chara.getPos()), rot = Quaternion(_chara.getRotation()) }
      }
      _chara.removeShadow();
      scene.removeObject(_chara.sk3d);
      _chara.getCaptureModel().release();

    } else {
      _chara = ::ARCharaModel(this.scene);
      _chara.setModelViewer(this);
      charas[_chara_id] <- _chara;
    }
    _chara.setCostumeID(costume_id);

    local _ccm = ::ARCharaModel(this.image_scene);
    _ccm.setModelViewer(this);
    _ccm.setCostumeID(costume_id);
    _ccm.build(true, null, susp, _attr);

    _chara.build(true, _ccm, susp, _attr);
    _chara.setARModule(ar_module);
    local _pid = _chara.getPropID();
    if (rebuild && _pid != -1) {
      _chara.startProp(::gamesetting.prop_settings[_pid], true);
    }

    if (!::contains(select_chara_models, _chara_id)) select_chara_models + _chara_id;

    _updateCurrentCharaID();

    _chara.startUpdate();

    repaint();

    return _chara;
  }

  function initApproachCharaList() {
    clearApproachCharaList();
    foreach (_cm in this.charas) {
      this.approach_chara_list + _cm;
    }
  }

  function clearApproachCharaList() {
    this.approach_chara_list.clear();
  }

  function replaceApprochList(cm, is_top) {
    local _idx = this.approach_chara_list.indexOf(cm);
    if (_idx < 0) return;
    delete this.approach_chara_list[_idx];
    if (is_top) this.approach_chara_list[0] <- cm;
    else this.approach_chara_list + cm;
  }

  function popApproachChara() {

    local _tmp_list = clone this.approach_chara_list;
    for (local i = 0; i < this.approach_chara_list.len(); i++) {
      local _cm = this.approach_chara_list[i]
      if (_cm.isFurnitureScriptRunning()) continue;
      if (_cm.isInLinkAction()) continue;

      delete this.approach_chara_list[i];
      this.approach_chara_list + _cm;

      return _cm;
    }

    return null;
  }

  function addSanrioCharas() {
    local _reside_charas = ::gamesession.getUserData().getCurrentRoomResideCharas();
    foreach (_cid in _reside_charas) {
      addCharaByCostumeId(_cid);

    }
  }

  function addSanrioCharaByTakingIds(taking_id_table) {
    foreach (_t in taking_id_table) {
      foreach (cid in _t.cids) {
        addCharaByCostumeId(cid);
      }
    }
  }

  function changeSanrioChara(cid) {
    local _current = getCurrentChara();
    if (_current.getCostumeID() == cid) return false;

    local _processing = ::gamesession.processinglayer;
    _processing.startProcess(skGetTime());

    local _ud = ::gamesession.getUserData();
    if (cid in _ud.getCostumeDataTable()) {
      local _cm = addCharaByCostumeId(cid, true, true);
      _cm.clearTasks();
      return true;
    }
    return false;
  }

  function getCurrentCharaModel() {
    return getCurrentChara();
  }

  function getCurrentChara() {
    return getChara(current_chara_id);
  }

  function getCurrentCharaID() {
    return this.current_chara_id;
  }

  function getChara(chara_id, is_capture = false) {
    if (is_capture) {
      return charas[chara_id] ? charas[chara_id].capture_model : null;
    }
    return charas[chara_id] || null;
  }

  function getCharas() {
    return this.charas;
  }

  function getCharaFromCharaKey(chara_key, is_capture = false) {
    local _chara_id = -1;
    foreach (id, setting in ::gamesetting.sanrio_chara_settings) {
      if (setting.getTalkKey() == chara_key) {
        _chara_id = id;
        break;
      }
    }

    return getChara(_chara_id, is_capture);
  }

  function getRandomCharaModel() {
    if (!this.charas || length(this.charas) < 1) return null;
    local _keys = ::getTableKeys(this.charas);
    local _idx = _keys[Math.rndi(_keys.len() - 1)];
    return this.charas[_idx];
  }

  function getNearestCharaModel(p, furniture_check = false, attract_check = false, link_check = false, focus_check = false, tapped_script_check = false) {
    local _dist = 100000;
    local _ret = null;
    foreach (chara in charas) {
      if (furniture_check && chara.isFurnitureScriptRunning()) continue;
      if (attract_check && chara.hasAttractTarget()) continue;
      if (link_check && chara.isInLinkAction()) continue;
      if (focus_check && chara == this.focus_chara) continue;
      if (tapped_script_check && chara.hasTappedScript()) continue;

      local _d = ::getDistance(p, chara.getPos());
      if (_d < _dist) {
        _dist = _d;
        _ret = chara;
      }
    }
    return _ret;
  }

  function getNearRandomActionChara(mine) {
    local _DIST = 20;
    local _list = [];

    foreach (chara in charas) {
      if (chara == mine) continue;
      if (!chara.isPlayRandomAction()) continue;
      if (chara.isFurnitureScriptRunning()) continue;
      if (chara.isInLinkAction()) continue;
      if (chara.hasAttractTarget()) continue;
      if (chara == this.focus_chara) continue;

      local _d = ::getDistance(mine.getPos(), chara.getPos());
      if (_d < _DIST) {
        _list + chara;
      }
    }

    if (_list.len() > 0) {
      return Math.rndPick(_list);
    }
    return null;
  }

  function getLastExecuteMotionID() {
    return this.last_exec_motion_id;
  }

  function startCharasScript(script, scp_args = null, is_turn_front = true) {
    foreach (chara in charas) {
      chara.startCharaScriptAction(script, scp_args, is_turn_front);
    }
  }

  function startCurrentCharaScript(script, scp_args = null, is_turn_front = true) {
    local _chara = getCurrentChara();
    _chara.startCharaScriptAction(script, scp_args, is_turn_front);

  }

  function currentCharaScript(script) {
    local _chara = getCurrentChara();
    if (!_chara) return;
    return _chara.getCurrentScriptName().equals(script);
  }

  function startCharasScripts() {
    foreach (chara in charas) {
      if (!chara.canInterruptAction()) continue;
      if (!chara.isPlayRandomAction() && !chara.isPlayNoMoveAction()) {
        local _tasks = chara.getScriptActionTasks();
        if (_tasks) chara.setupTasks(_tasks);
        else println("tasks is nul.");
      }
    }
  }

  function startCharasScriptCheese() {
    local _DELAY_RATE = 30;
    local _DELAY_TIME_MIN = 1000;
    local _DELAY_TIME_MAX = 3000;

    foreach (chara in charas) {
      if (chara.isFurnitureScriptRunning()) continue;

      if (::PUBLIC_RANDOM.nexti(100) < _DELAY_RATE) {
        local _tasks = chara.createStartCharaScriptActionTasks("multipurpose_kurukuru", null, true);
        local _delay = _DELAY_TIME_MIN + ::PUBLIC_RANDOM.nexti(_DELAY_TIME_MAX - _DELAY_TIME_MIN);
        chara.reserveTasks(_tasks, _delay);
      } else {
        if (!chara.canInterruptAction()) continue;
        chara.startCharaScriptAction("multipurpose_kurukuru", null, true);
      }
    }
  }

  function clearCharaParam() {
    _removeTappedCharaEffect();
    selectAllModels();

    foreach (chara in charas) {
      chara.setPos(Vector3D());
      chara.setAngle(0.0);
      chara.writeToCaptureModel();

      chara.clearAction(true, true);
      chara.clearModifiers();
      chara.setFurnitureScriptRunning(false);
      chara.resetTargetFurnitureUID();
      chara.resetTappedScript();
      chara.resetAttractTarget();
      chara.shadowVisible(true);
    }
  }

  function clearCharasAction() {
    foreach (chara in charas) {
      chara.clearAction();
      chara.setFurnitureScriptRunning(false);
      chara.resetTargetFurnitureUID();
    }
  }

  function setCharasVisible(b) {
    foreach (chara in charas) {
      chara.setVisible(b);
    }
  }

  function initCharasPos(pos_table) {
    if (!pos_table) {
      setCharasRandomPos();
      return;
    }
    local _center = false;
    foreach (chara in charas) {
      if (chara.isFurnitureScriptRunning()) continue;

      if (!_center) {

        setCharaCenterPos(chara);
        _center = true;
      }
      else {

        local _pos = pos_table[chara.getCostumeID()];
        if (!_pos) _pos = Vector3D(0.0, 0.0, 0.0);

        if (inBoundOtherModel(chara, _pos)) setCharaRandomPos(chara);
        else chara.setBothModelPos(_pos);
      }
    }
  }

  function setCharasRandomPos() {
    local _put_center = false;
    foreach (chara in charas) {
      if (chara.isFurnitureScriptRunning()) continue;
      if (!_put_center) {

        setCharaCenterPos(chara);
        _put_center = true;
      } else {

        setCharaRandomPos(chara);
      }
    }
  }

  function setCharaCenterPos(chara) {
    if (chara.isFurnitureScriptRunning()) return;
    local _tmp_pos = Vector3D();
    local _info = this.house_manager.getRoomInfo();
    if (_info) _tmp_pos = _info.getEnabledNodeByVortex(0.0, 0.0);
    else _tmp_pos = getVortexBoundCheckPosition(chara);
    chara.setBothModelPos(_tmp_pos);
  }

  function setCharaRandomPos(chara) {
    if (chara.isFurnitureScriptRunning()) return;

    local _info = this.house_manager.getRoomInfo();
    if (_info) {
      local _grid_pos = _info.getRandomNodePos();
      if (!_grid_pos) _grid_pos = Vector3D();
      for (local i = 0; i < 30; i++) {
        if (!inBoundOtherModel(chara, _grid_pos)) break;
        _grid_pos = _info.getRandomNodePos();
        if (!_grid_pos) _grid_pos = Vector3D();
      }
      chara.setBothModelPos(_grid_pos);
    }
    else {
      local _MAX_FORMULATE_NUM = 10;
      local _rectangle = ar_module.getRectangle(chara.getPos());
      if (!_rectangle) {
        println("can't create rectangle.");
        return;
      }

      local _pos_min = _rectangle.getPosMin();
      local _pos_max = _rectangle.getPosMax();
      local _rect = _rectangle.getVertexes();
      local _in_rectangle = null;
      local _v = Vector3D();
      for (local i = 0; i < _MAX_FORMULATE_NUM * 2; i++) {

        _v.set(::PUBLIC_RANDOM.nextf(_pos_min.x, _pos_max.x), _rect[0].position_.y, ::PUBLIC_RANDOM.nextf(_pos_min.z, _pos_max.z));

        _in_rectangle = _rectangle.isInRectangle(_v);
        if (!_in_rectangle) continue;

        if (i < _MAX_FORMULATE_NUM && inBoundOtherModel(chara, _in_rectangle)) continue;
        chara.setBothModelPos(_in_rectangle);
        break;
      }
    }
  }

  function getVortexBoundCheckPosition(chara) {
    local _a = 0;
    local _d = 1.0;
    local _pos = Vector3D(0.0, 0.0, 0.0);
    for (local i = 0; i < 100; i++) {
      if (!inBoundOtherModel(chara, _pos)) break;
      local _rad = _a * Math.DTOR;
      _pos.x = _d * Math.cos(_rad);
      _pos.z = _d * Math.sin(_rad);
      _a += 45;
      if (_a >= 360) {
        _a = 0;
        _d += 1.0;
      }
    }
    return _pos;
  }

  function setCharasRandomAction() {
    foreach (chara in charas) {
      if (chara.getTargetFurnitureUID() != -1) continue;
      if (!chara.canInterruptAction()) continue;

      chara.setRandomAction(true);
      local _tasks = chara.getScriptActionTasks();
      chara.setupTasks(_tasks);
    }
  }

  function _searchCharas(screen_x, screen_y) {
    local _v = Vector3D(screen_x / ::displayWidth, screen_y / ::displayHeight, 0.0);

    local near = this.renderer.camera.unproject(_v);
    _v.z = 1.0;
    local far = this.renderer.camera.unproject(_v);

    scene.b3world.updateAABBs();
    local b3res = scene.b3world.rayTest(1, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);
    if (b3res.len() < 1) return null;
    foreach (model in charas) {
      if (model.getB3body() == b3res.bodyb) {
        return model;
      }
    }
    return null;
  }

  function selectCurrentChara() {
    local _models = Table.values(charas);
    if (_models.len() <= 0) {
      println("There is no one in this room.");
      return;
    }

    select_chara_models.clear();
    select_chara_models + _models[0].getCharaID();

    _updateCurrentCharaID();
  }

  function setFocusChara(fc) {
    if (fc) {
      this.focus_time = skGetTime();
      if (fc.startCharaScriptAction(::CharaModel.SCRIPT_NAME_FOCUS, null, true)) {
        fc.setCanInterruptAction(true);
        fc.setAutoAction(false);
        if (this.focus_chara && this.focus_chara != fc) this.focus_chara.setAutoAction(false);
        this.focus_chara = fc;
        this.chara_appeal_layer.addNoticeBalloon(fc);
        local _cid = fc.getCostumeID();
        this.talk_window.interruptTalkWindow(_cid)
        this.image_talk_window.interruptTalkWindow(_cid)
      }
    }
    else {
      this.focus_time = -1;
      if (this.focus_chara) this.focus_chara.setAutoAction(false);
      this.focus_chara = fc;
    }
  }
  function updateFocusTime() {
    if (this.focus_chara) this.focus_time = skGetTime();
  }

  function getFocusChara() {
    return this.focus_chara;
  }

  function setFocusLock(b) {
    this.focus_lock = b;
    if (!b) updateFocusTime();
  }
  function getFocusLock() {
    return this.focus_lock;
  }

  function addHapinessBalloon(model) {
    chara_appeal_layer.addHapinessBalloon(model);
  }

  function addShutterChanceBalloon(model) {
    this.chara_appeal_layer.addShutterBalloon(model);
  }

  function releaseAllBalloons() {
    chara_appeal_layer.releaseAllBalloons();
  }

  function startCharaAction(as) {
    if (::ENABLE_AR) {
      local _panel = ::gamesession.getCurrentScene().getUI().getCurrentPanel();
      if (_panel instanceof ARPanel && !_panel.isDetecting()) return false;
    }

    local _cur = getCurrentCharaModel();
    if (!_cur) return false;

    if (!as) {

      local _chara_data = _cur.getCharaData();
      if (!_chara_data) return false;
      local _chara_motion_list = _chara_data.getMotions();
      if (!_chara_motion_list || _chara_motion_list.len() == 0) return false;
      local _rnd_id = Math.rndi(_chara_motion_list.len() - 1);
      as = ::gamesetting.costume_motion_settings[_chara_motion_list[_rnd_id]];
    }

    if (!as) return false;

    local _scp = as.getActionName();
    local _efx_model = ::AREffectModel(this.scene);
    _efx_model.setModelViewer(this);
    _efx_model.build("/res/AR_point/point.pm", "/res/furniture/base.sk3", "/res/furniture/base_efx.sk3");
    _efx_model.setARModule(this.ar_module);
    _efx_model.setPos(Vector3D(this.fixed_camera_pos).add(0.0, -1.5, 0.0));
    _efx_model.setVisible(true);
    _efx_model.startScript("efx_throw", _efx_model, _cur, _scp);

    this.last_exec_motion_id = as.getID();

    this.shutter_chance_manager.challengeShutterChance(_cur);

    interruptDragRouteThread();

    return true;
  }

  function addFurnitureId(fuid = 0, susp = false) {
    local _fd = ::gamesession.getUserData().getFurnitureData(fuid);

    local _furniture = null;
    if (furnitures[fuid]) {
      _furniture = furnitures[fuid];
      _furniture.removeShadow();
      scene.removeObject(_furniture.obj.sk3d);
      _furniture.getCaptureModel().release();
    } else {
      _furniture = ::ARFurnitureModel(this.scene);
      _furniture.setModelViewer(this);
    }

    local _cfm = ::ARFurnitureModel(this.image_scene);
    _cfm.setModelViewer(this);
    _cfm.build(_fd);

    _furniture.build(_fd, _cfm);
    _furniture.setARModule(ar_module);

    current_furniture_id = fuid;

    if (!furnitures[fuid]) {
      furnitures[fuid] <- _furniture;
    }

    if (susp) suspend();

    if (susp) suspend();
    repaint();

    return _furniture;
  }

  function addFurnitures() {
    local _ud = ::gamesession.getUserData();
    local _edit = _ud.getRoomEditDataBySlotIdx(_ud.getCurrentRoomIndex());
    local _layouts = _edit.getFurnitureLayouts();

    foreach (layout in _layouts) {
      local _uid = layout.getUID();
      local _fd = _ud.getFurnitureData(_uid);
      if (_fd.getSetting().getEnableActionNum() > 1) continue;
      addFurnitureId(_uid);
    }
  }

  function addCurrentFurniture() {

    local _table = ::gamesession.getUserData().getFurnitureDataTable();
    foreach (uid, fd in _table) {
      if (fd.getSetting().getEnableActionNum() != 1) continue;
      addFurnitureId(uid);
      break;
    }
  }

  function addFurnitureByTakingIds(taking_id_table) {
    foreach (_t in taking_id_table) {
      if (_t.fuid <= 0) continue;
      addFurnitureId(_t.fuid);
    }
  }

  function setFurnituresVisible(b) {
    foreach (_furniture in furnitures) {
      _furniture.setVisible(b);
    }
  }

  function startFurnituresEffect(effect) {
    foreach (_furniture in furnitures) {
      _furniture.startEffect(effect);
    }
  }

  function setFurnituresRandomPos() {
    local _MAX_FORMULATE_NUM = 10;
    foreach (_furniture in furnitures) {
      local _rectangle = ar_module.getRectangle(_furniture.getPos());
      if (!_rectangle) {
        println("can't create rectangle.");
        return;
      }
      local _pos_min = _rectangle.getPosMin();
      local _pos_max = _rectangle.getPosMax();
      local _rect = _rectangle.getVertexes();
      local _in_rectangle = null;
      local _v = Vector3D();
      for (local i = 0; i < _MAX_FORMULATE_NUM * 2; i++) {

        _v.set(::PUBLIC_RANDOM.nextf(_pos_min.x, _pos_max.x), _rect[0].position_.y, ::PUBLIC_RANDOM.nextf(_pos_min.z, _pos_max.z));

        _in_rectangle = _rectangle.isInRectangle(_v);
        if (!_in_rectangle) continue;

        if (i < _MAX_FORMULATE_NUM && inBoundOtherModel(_furniture, _in_rectangle)) continue;
        _furniture.setPos(_in_rectangle);
        break;
      }
    }
  }

  function setFurnituresLayout() {
    local _ud = ::gamesession.getUserData();
    local _edit = _ud.getRoomEditDataBySlotIdx(_ud.getCurrentRoomIndex());
    local _layouts = _edit.getFurnitureLayouts();

    foreach (_furniture in furnitures) {

      local _layout = _edit.getFurnitureLayoutData(_furniture.getUID());
      _furniture.setBothModelPos(Vector3D(_layout.x, _layout.y, _layout.z));
      _furniture.setBothModelRotation(Quaternion.fromHPB(_layout.angle * Math.DTOR, 0, 0));
    }
  }

  function getNearestFurnitureModel(pos, is_capture = false) {
    local _ret_fm = null;
    local _ret_dist = -1;
    foreach (fm in this.furnitures) {

      if (is_capture) fm = fm.getCaptureModel();

      if (!fm.getFurnitureSetting().canUseFurniture()) continue;
      if (fm.getTargetCharaTable()) continue;
      local _d = ::getDistance(pos, fm.getPos());
      if (!_ret_fm || _ret_dist > _d) {
        _ret_fm = fm;
        _ret_dist = _d;
      }
    }
    return { fm = _ret_fm, dist = _ret_dist };
  }

  function getFurnitureModel(fid, is_capture = false) {
    if (is_capture) {
      local _fm = furnitures[fid] || null;
      return _fm != null ? furnitures[fid].capture_model : null;
    }
    return furnitures[fid];
  }
  function getFurnitureModels() {
    return furnitures;
  }

  function getAttractModel(cm, is_capture = false) {
    if (!this.approach_model) return null;
    local _am = this.approach_model;
    local _cm = cm;
    if (is_capture) {
      _am = this.approach_model.getCaptureModel();
      _cm = cm.getCaptureModel();
    }
    if (_am != _cm) return null;

    if (this.last_tap_time + ::SanrioGameScene.CHARACTER_APPROACH_LIMIT < skGetTime()) return null;
    local _at = this.attract_model;
    if (is_capture) {
      _at = _at.getCaptureModel();
    }
    return _at;

  }

  function startUseFurnitureForce(taking_id_tables = null) {
    if (taking_id_tables) {
      foreach (_t in taking_id_tables) {
        if (_t.fuid <= 0) continue;
        if (_t.cids.len() == 0) continue;
        local _fm = getFurnitureModel(_t.fuid);
        _fm.startUseFurnitureScriptForce(_t.cids);
      }
    } else {

      local _pm = ::gamesession.getCurrentScene().getProductionManager();
      local _f_models = getFurnitureModels();
      local _ud = ::gamesession.getUserData();
      foreach (_fuid, _fm in _f_models) {
        local _fd = _ud.getFurnitureData(_fuid);
        if (!_fd.hasProductData()) continue;

        local _pd = _fd.getProductData();
        _fm.startUseFurnitureScriptForce(_pd.getCostumeIDList(), -1, false);
      }
    }

  }

