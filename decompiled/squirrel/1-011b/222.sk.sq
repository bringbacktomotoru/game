class MotionDropItemsSetting extends ::Setting {
  id = null;
  items = null;

  function loadConfAtServer(t) {
    local _setting = MotionDropItemsSetting();

    foreach (k, v in t) {
      switch (k) {
      case "items":
        _setting[k] = decodeJSON(v);
        break;
      default:
        _setting[k] = v;
      }
    }

    return _setting;
  }
}