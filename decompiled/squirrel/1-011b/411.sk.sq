class GachaPanel extends ::HomeUI.Panel {
  static need_rank_layer = false;
  static need_history_clear = true;
  static unique_bgm = "BGM07";
  static need_hapiness_info = true;

  view = null;

  pnl_gacha_list = null;
  tab_list = null;
  reclist = null;
  scroll = null;

  select_index = 0;
  gacha_list = null;

  gacha_info = null;
  list_dialog = null;

  btn_gacha_list = null;

  jingle_thread = null;

  first_tab_id = -1;

  tab_sound = ::SoundConstants.SOUND_MOVETAB;

  list_dialog_lock = false;

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/ShopGachaPanel.ui");
    addChild(this.view);

    this.jingle_thread = newthread();

    this.gacha_list = makeGachaList();

    this.pnl_gacha_list = this.view.findChild("pnl_gacha_list");
    this.pnl_gacha_list.bnd.w = ::viewWidth;
    this.pnl_gacha_list.bnd.x = -this.pnl_gacha_list.bnd.w / 2.0;
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.pnl_gacha_list.addChild(this.reclist);
    this.pnl_gacha_list.setBuffer(true);
    setGachaTab();

    if (this.first_tab_id >= 0) {
      foreach (idx, gs in this.gacha_list) {
        if (this.first_tab_id == gs.getID()) {
          this.select_index = idx;
          break;
        }
      }
    }

    this.gacha_info = GachaInfo(this);
    setGachaInfo(this.select_index, false);
    _setTabBg();

    local _btn_back = this.view.findChild("btn_back");
    ::TapButton(_btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    local _btn_gacha_list = this.view.findChild("btn_gacha_list");
    _btn_gacha_list.findChild("lbl_gacha_list").setText(::dict.get("gacha_list"));
    ::TapButton(_btn_gacha_list).view.addEventListener(ACTION_EVENT, actionevent_showlist);

    registerMouseEventReceiver(this);
  }

  function removed() {
    super.removed();

    this.list_dialog = null;

  }

  function setPanelParam(param) {
    if ("gid" in param) this.first_tab_id = param.gid;
  }

  static function makeGachaList() {
    local _list = [];

    local _settings = ::gamesetting.gacha_settings;
    local _cs = ::gamesetting.condition_settings;
    foreach (gs in _settings) {

      local _gc = gs.getConditions();
      if (gs.getEnableVisible() == 0 && _gc && !::checkCondition(_gc, _cs)) continue;

      if (gs.getEnableVisible() == 0 && !gs.checkPeriod()) continue;

      local _pri = gs.getPriority();
      local _len = _list.len();
      for (local i = 0; i < _len; i++) {
        if (_list[i].getPriority() < _pri) {
          _list[i] <- gs;
          break;
        }
      }
      if (_len == _list.len()) _list + gs;
    }
    return _list;
  }

  static function hasNewGacha() {
    local _list = ::GachaPanel.makeGachaList();
    local _udl = ::gamesession.getUserDataLocal();
    foreach (gs in _list) {
      if (!_udl.hasSeenGachas(gs.getID(), gs.getGachaVersion())) return true;
    }
    return false;
  }

  function setGachaTab() {
    this.reclist.clearChildren();
    this.tab_list = [];
    local _offset = 0;
    for (local i = 0; i < this.gacha_list.len(); i++) {
      local _tab = GachaTab(this, this.gacha_list[i], i);
      _tab.pos.x = _offset;
      this.reclist.addChild(_tab);
      _tab.matdirty = true;
      _tab.repaint();
      _offset += _tab.bnd.w;
      this.tab_list + _tab;
    }

    this.reclist.setRect(0, 0, _offset, this.pnl_gacha_list.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);
  }

  function setGachaInfo(idx, sound = true) {
    if (idx < 0 || idx >= this.gacha_list.len()) return;
    this.gacha_info.setGachaInfo(this.gacha_list[idx]);

    if (sound) ::playSound(tab_sound);
  }

  function changeGacha(idx) {
    if (this.select_index == idx) return;
    this.select_index = idx;
    setGachaInfo(idx);
    _setTabBg();
  }

  function moveGachaProductionPanel(ri, gid, idx) {

    local _tex = ::gamesetting.gacha_settings[gid].getGachaLoadingBG();
    local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
    _trans.sleeptime = 1000;
    getHomeUI().movePanel(::GachaResultPanel, false, { "reward_items" = ri, "gacha_id" = gid, "index" = idx }, _trans);

  }
  function moveLimitGachaProductionPanel(ri, gid) {
    local _tex = ::gamesetting.gacha_settings[gid].getGachaLoadingBG();
    local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
    _trans.sleeptime = 1000;
    getHomeUI().movePanel(::GachaResultPanel, false, { "reward_items" = ri, "gacha_id" = gid, "limit" = 1 }, _trans);

  }
  function moveStepGachaProductionPanel(ri, gid) {
    local _tex = ::gamesetting.gacha_settings[gid].getGachaLoadingBG();
    local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
    _trans.sleeptime = 1000;
    getHomeUI().movePanel(::GachaResultPanel, false, { "reward_items" = ri, "gacha_id" = gid, "step" = 1 }, _trans);
  }

  function _setTabBg() {
    for (local i = 0; i < this.tab_list.len(); i++) {
      this.tab_list[i].setTabBg(this.tab_list[i].getIndex() == this.select_index);
    }
  }

  function actionevent_back(e) {
    getHomeUI().backPanel();
  }

  function actionevent_showlist(e) {
    e.consume();
    if (this.list_dialog_lock) return;
    this.list_dialog_lock = true;

    if (!this.list_dialog) this.list_dialog = ::GachaListDialog();
    this.list_dialog.setup(this.gacha_list[this.select_index]);
    this.list_dialog.show();
    this.list_dialog_lock = false;
  }
}

class GachaPanel.GachaTab extends SKView {
  pnl_parent = null;
  view = null;

  index = -1;
  press_time = -1;
  press_x = -1;
  press_y = -1;

  img_tab_on = null;
  img_tab_off = null;
  img_icon_new = null;
  pnl_icon = null;

  constructor(p, gs, idx) {
    this.pnl_parent = p;
    this.index = idx;

    this.view = ::loadSKView("/ui/common/PanelTab.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    local _pnl_tab = this.view.findChild("pnl_tab");
    local _lbl_name = _pnl_tab.findChild("lbl_name");
    _lbl_name.setText(gs.getName());

    this.img_tab_on = _pnl_tab.findChild("img_tab_on");
    this.img_tab_off = _pnl_tab.findChild("img_tab_off");

    this.img_icon_new = _pnl_tab.findChild("img_icon_new");
    this.img_icon_new.setVisible(true);

    this.pnl_icon = _pnl_tab.findChild("pnl_icon");
    local _sp = gs.getTabIconSprite();
    if (_sp) {
      local _image_view = ::SKImageView();
      _image_view.setSprite(_sp);
      _image_view.setRect(0.0, 0.0, this.pnl_icon.bnd.w, this.pnl_icon.bnd.w);
      this.pnl_icon.addChild(_image_view);
    }

    _pnl_tab.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function getIndex() {
    return this.index;
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_PRESSED:
      this.press_time = e.time;
      this.press_x = e.x;
      this.press_y = e.y;
      break;
    case MOUSE_RELEASED:
      local _tx = this.press_x - e.x;
      local _ty = this.press_y - e.y;
      local _dist = Math.sqrt(_tx * _tx + _ty * _ty);
      if (e.time - this.press_time < 300 && _dist < 15) {
        this.pnl_parent.changeGacha(this.index);
      }
      break;
    }
  }

  function setTabBg(select) {
    if (select) {
      this.img_tab_on.visible = true;
      this.img_tab_off.visible = false;
    }
    else {
      this.img_tab_on.visible = false;
      this.img_tab_off.visible = true;
    }

    local _id = pnl_parent.gacha_list[index].getID();
    local _version = pnl_parent.gacha_list[index].getGachaVersion();
    local _udl = ::gamesession.getUserDataLocal();

    this.img_icon_new.setVisible(!_udl.hasSeenGachas(_id, _version));

    if (select) {
      local _seen_table = _udl.getHaveSeenGachaTable();
      _seen_table[_id] <- _version;
      ::gamesession.saveUserDataLocal();
      ::gamesession.getCurrentScene().getUI().updateMenuNewMark(::HomeUI.UPDATE_MENU_MARK_GACHA);
    }

  }
}

class GachaPanel.GachaInfo {
  pnl_parent = null;
  view = null;

  lbl_period = null;
  pnl_bg = null;
  pnl_titlelogo = null;
  lbl_gacha_desc = null;

  pnl_item_list = null;
  pnl_item = null;
  chara_view = null;
  furniture_view = null;

  pnl_rare = null;
  lbl_item_name = null;
  lbl_item_desc = null;
  btn_left = null;
  btn_right = null;
  lbl_slide = null;

  item_list = null;
  select_index = 0;

  pnl_btn_area = null;

  gacha_setting = null;

  last_x = null;
  angle = 0;

  constructor(p) {
    this.pnl_parent = p;

    this.view = p.view.findChild("pnl_gacha_info");
    this.pnl_bg = this.view.findChild("pnl_bg");

    this.lbl_period = p.view.findChild("lbl_period");

    this.pnl_item_list = this.view.findChild("pnl_item_list");
    this.pnl_item = this.pnl_item_list.findChild("pnl_item");
    this.pnl_rare = this.pnl_item_list.findChild("pnl_rare");
    this.lbl_item_name = this.pnl_item_list.findChild("lbl_item_name");
    this.lbl_item_desc = this.pnl_item_list.findChild("lbl_item_desc");
    this.lbl_item_name.setVisible(false);
    this.lbl_item_desc.setVisible(false);

    this.lbl_gacha_desc = this.pnl_item_list.findChild("lbl_gacha_desc");

    this.btn_left = this.pnl_item_list.findChild("btn_left");
    ::TapButton(this.btn_left).view.addEventListener(ACTION_EVENT, actionevent_left);
    this.btn_right = this.pnl_item_list.findChild("btn_right");
    ::TapButton(this.btn_right).view.addEventListener(ACTION_EVENT, actionevent_right);

    this.chara_view = Chara3DView();
    this.chara_view.setRect(0, 0, this.pnl_item.bnd.w, this.pnl_item.bnd.h);
    this.furniture_view = Furniture3DView();
    this.furniture_view.setRect(0, 0, this.pnl_item.bnd.w, this.pnl_item.bnd.h);
    this.pnl_item.addChild(this.chara_view);
    this.pnl_item.addChild(this.furniture_view);
    this.chara_view.setVisible(false);
    this.furniture_view.setVisible(false);

    this.pnl_item.addEventListener(MOUSE_EVENT, _mouse_event);

    this.pnl_btn_area = this.view.findChild("pnl_btn_area");

    this.lbl_slide = this.pnl_parent.findChild("lbl_slide");
    this.lbl_slide.setText(dict.get("rewarddialog_slide_desc"));
  }

  function setGachaInfo(gs) {
    this.gacha_setting = gs;

    this.pnl_bg.clearChildren();
    local _img_bg = gs.getBannerImage();
    if (_img_bg) {
      _img_bg.setRect(0, 0, this.pnl_bg.bnd.w, this.pnl_bg.bnd.h);
      this.pnl_bg.addChild(_img_bg);
    }

    this.lbl_period.visible = false;

    this.lbl_gacha_desc.setText(gs.getDesc());

    this.select_index = 0;
    this.item_list = gs.getFuaturedItems();
    if (!this.item_list || this.item_list.len() == 0) {
      this.pnl_item_list.visible = false;
    }
    else if (this.item_list.len() == 1) {
      this.pnl_item_list.visible = true;
      this.btn_left.visible = false;
      this.btn_right.visible = false;
      setItemView(true);
    }
    else {
      this.pnl_item_list.visible = true;
      this.btn_left.visible = true;
      this.btn_right.visible = true;
      setItemView();
    }

    this.pnl_btn_area.clearChildren();
    local _btns = [];
    if (gs.isStepPriceGacha()) {
      local _btn = GachaButton(this.pnl_parent, this.pnl_btn_area);
      _btn.setStepGachaInfo(gs);
      this.pnl_btn_area.addChild(_btn);
      _btns + _btn;
    }
    else {
      if (gs.getPriceInfo(0)) {
        local _btn = GachaButton(this.pnl_parent, this.pnl_btn_area);
        _btn.setGachaInfo(gs, 0);
        this.pnl_btn_area.addChild(_btn);
        _btns + _btn;
      }
      if (gs.getPriceInfo(1)) {
        local _btn = GachaButton(this.pnl_parent, this.pnl_btn_area);
        _btn.setGachaInfo(gs, 1);
        this.pnl_btn_area.addChild(_btn);
        _btns + _btn;
      }
    }
    if (gs.getLimitPriceInfo()) {
      local _btn = GachaButton(this.pnl_parent, this.pnl_btn_area);
      _btn.setLimitGachaInfo(gs);
      this.pnl_btn_area.addChild(_btn);
      _btns + _btn;
    }

    if (_btns.len() == 1) {
      _btns[0].pos.x = this.pnl_btn_area.bnd.w / 2.0 - _btns[0].bnd.w / 2.0;
    }
    else if (_btns.len() == 2) {
      local _offset = 80;
      local _def_x = this.pnl_btn_area.bnd.w / 2.0 - _btns[0].bnd.w - _offset / 2.0;
      for (local i = 0; i < _btns.len(); i++) {
        _btns[i].pos.x = _def_x + i * (_btns[i].bnd.w + _offset);
      }
    }
    else {
      local _offset = 25;
      local _def_x = this.pnl_btn_area.bnd.w / 2.0 - _btns[0].bnd.w / 2.0 - _btns[0].bnd.w - _offset;
      for (local i = 0; i < _btns.len(); i++) {
        _btns[i].pos.x = _def_x + i * (_btns[i].bnd.w + _offset);
      }
    }
  }

  function setItemView(force = false) {
    if (!force && (!this.item_list || this.select_index < 0 || this.select_index >= this.item_list.len())) return;

    local _item = this.item_list[this.select_index];
    local _sp;
    switch (_item.kind) {
    case ITEM_TYPE_COSTUME:
      local _cs = ::gamesetting.costume_settings[_item.id];
      if (!_cs) return;

      this.chara_view.setCostumeId(_cs.getID());
      this.chara_view.build(true);
      this.furniture_view.setVisible(false);
      this.chara_view.setVisible(true);

      break;
    case ITEM_TYPE_FURNITURE:
      local _fs = ::gamesetting.furniture_settings[_item.id];
      if (!_fs) return;

      this.furniture_view.clearObjects();
      this.furniture_view.setFurniture(_fs, 1);
      this.furniture_view.build(true);
      this.chara_view.setVisible(false);
      this.furniture_view.setVisible(true);

      break;
    }
  }

  function changeFuaturedItemView(idx) {
    if (!this.item_list || this.item_list.len() <= 1 || this.select_index == idx) return;

    if (idx < 0) idx = this.item_list.len() - 1;
    else if (idx >= this.item_list.len()) idx = 0;

    this.select_index = idx;
    setItemView();

    this.angle = 0.0;
  }

  function actionevent_left(e) {
    changeFuaturedItemView(this.select_index - 1);
  }
  function actionevent_right(e) {
    changeFuaturedItemView(this.select_index + 1);
  }

  function _mouse_event(e) {
    e.consume();

    local _item = this.item_list[this.select_index];
    switch (e.id) {
    case MOUSE_PRESSED:
      this.last_x = e.x;
      break;
    case MOUSE_DRAGGED:
      local diff = e.x - this.last_x;
      this.angle -= diff;

      local _obj;
      switch (_item.kind) {
      case ITEM_TYPE_COSTUME: _obj = this.chara_view.obj; break;
      case ITEM_TYPE_FURNITURE: _obj = this.furniture_view.obj; break;
      }
      _obj.setAngle(this.angle);

      this.last_x = e.x;
      break;
    }
  }
}

class GachaPanel.GachaInfo.GachaButton extends SKView {
  pnl_parent = null;

  view = null;
  btn_area = null;
  btn_gacha = null;
  img_gm = null;
  img_rm = null;
  lbl_gacha_num = null;
  lbl_price = null;
  pnl_limited = null;

  gacha_setting = null;
  gacha_index = -1;

  constructor(p, ba) {
    this.pnl_parent = p;
    this.btn_area = ba;
    this.view = ::loadSKView("/ui/common/GachaButton.ui");
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    addChild(this.view);

    this.btn_gacha = this.view.findChild("btn_gacha");
    this.img_gm = this.btn_gacha.findChild("img_gm");
    this.img_rm = this.btn_gacha.findChild("img_rm");
    this.lbl_gacha_num = this.btn_gacha.findChild("lbl_gacha_num");
    this.lbl_price = this.btn_gacha.findChild("lbl_price");
    this.pnl_limited = this.view.findChild("pnl_limited");
    this.pnl_limited.pickable = false;
  }

  function setGachaInfo(gs, idx) {
    local _price_info = gs.getPriceInfo(idx);
    if (!_price_info) return;

    _setMoneyType(gs.getType());

    local _num = _price_info.num;
    if (_num > 1) {
      this.lbl_gacha_num.setText(::dict.get("gacha_play_nums", [_num]));
    } else {
      this.lbl_gacha_num.setText(::dict.get("gacha_play_num", [_num]));
    }
    this.lbl_price.setText(::formatNumberString(_price_info.price));

    this.gacha_setting = gs;
    this.gacha_index = idx;
    ::TapButton(this.btn_gacha).view.addEventListener(ACTION_EVENT, actionevent_gacha);
    _buttonColor(this.gacha_setting.canExecuteGacha(idx));

    this.pnl_limited.setVisible(false);
  }

  function setLimitGachaInfo(gs) {
    local _price_info = gs.getLimitPriceInfo();
    if (!_price_info) return;

    _setMoneyType(_price_info.type);

    local _num = _price_info.num;
    if (_num > 1) {
      this.lbl_gacha_num.setText(::dict.get("gacha_play_nums", [_num]));
    } else {
      this.lbl_gacha_num.setText(::dict.get("gacha_play_num", [_num]));
    }
    this.lbl_price.setText(::formatNumberString(_price_info.price));

    this.gacha_setting = gs;
    ::TapButton(this.btn_gacha).view.addEventListener(ACTION_EVENT, actionevent_limit_gacha);
    _buttonColor(this.gacha_setting.canExecuteLimitGacha());

    this.pnl_limited.setVisible(true);
  }

  function setStepGachaInfo(gs) {
    local _price_info = gs.getStepPriceInfoFromUserData();
    if (!_price_info) return;

    _setMoneyType(_price_info.type);

    local _num = _price_info.num;
    if (_num > 1) {
      this.lbl_gacha_num.setText(::dict.get("gacha_play_nums", [_num]));
    } else {
      this.lbl_gacha_num.setText(::dict.get("gacha_play_num", [_num]));
    }
    this.lbl_price.setText(formatNumberString(_price_info.price));

    this.gacha_setting = gs;
    ::TapButton(this.btn_gacha).view.addEventListener(ACTION_EVENT, actionevent_step_gacha);
    _buttonColor(this.gacha_setting.canExecuteStepGacha());

    this.pnl_limited.setVisible(false);
  }

  function _buttonColor(state) {

    if (state == ::GachaSetting.STATE_ENABLE) {
      this.btn_gacha.setDisableColor(false);
    } else if (state == ::GachaSetting.STATE_POVERTY) {
      this.lbl_price.setColor(0xff0000ff);
    } else {
      this.btn_gacha.setDisableColor(true);
    }

  }

  function _setMoneyType(t) {
    switch (t) {
    case PRICE_GM:
      this.img_gm.visible = true;
      this.img_rm.visible = false;
      break;
    case PRICE_RM:
      this.img_gm.visible = false;
      this.img_rm.visible = true;
      break;
    case PRICE_ONEROUS_RM:
      this.img_gm.visible = false;
      this.img_rm.visible = true;
      break;
    default:
      return;
    }
  }

  function _confirmPurchaseDialog(price_info, type, state) {
    local _dlg = ::SimpleDialog2();
    _dlg.lbl_caution.setText("");
    if (price_info.num == 1) {
      _dlg.lbl_msg.setText(::dict.get("gacha_confirm"));
      _dlg.btn_shorten.findChild("lbl_shorten").setText(::dict.get("gacha_confirm_button"));
    } else {
      _dlg.lbl_msg.setText(::dict.get("gachas_confirm", [price_info.num]));
      _dlg.btn_shorten.findChild("lbl_shorten").setText(::dict.get("gachas_confirm_button", [price_info.num]));
    }
    _dlg.setPrice(price_info.price, type);
    if (state == GachaSetting.STATE_ENABLE) {
      _dlg.tapbutton_ok.setTappedJingle(SoundConstants.SOUND_TRY_GACHA, 2000);
    }
    _dlg.show();

    return _dlg.ret;
  }

  function actionevent_gacha(e) {

    local _price_info = this.gacha_setting.getPriceInfo(this.gacha_index);
    local _state = this.gacha_setting.canExecuteGacha(this.gacha_index);
    if (!_price_info) return;

    if (!this.gacha_setting) {
      _popImpossibleMessage(GachaSetting.STATE_OTHERS);
      return;
    }

    if (_state != GachaSetting.STATE_ENABLE) {
      _popImpossibleMessage(_state);
      return;
    }
    if (!_confirmPurchaseDialog(_price_info, this.gacha_setting.getType(), _state)) return;

    local _ri = ::gamesession.executeGacha(this.gacha_setting.getID(), this.gacha_index);
    if (!_ri || _ri.len() < 1) return;

    local _ud = ::gamesession.getUserData();

    if (this.gacha_setting.getLimit() >= 0) _ud.addGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion());

    _ud.addRewardItems(_ri);

    local _pay = this.gacha_setting.getPrice(this.gacha_index);
    _ud.applyPurchase(this.gacha_setting.getType(), _pay, false);

    this.pnl_parent.moveGachaProductionPanel(_ri, this.gacha_setting.getID(), this.gacha_index);
  }

  function actionevent_limit_gacha(e) {

    local _price_info = this.gacha_setting.getLimitPriceInfo();
    local _state = this.gacha_setting.canExecuteLimitGacha();
    if (!_price_info) return;

    if (!this.gacha_setting) {
      _popImpossibleMessage(GachaSetting.STATE_OTHERS);
      return;
    }

    if (_state != GachaSetting.STATE_ENABLE) {
      _popImpossibleMessage(_state);
      return;
    }
    if (!_confirmPurchaseDialog(_price_info, _price_info.type, _state)) return;

    local _ret = ::gamesession.executeLimitGacha(this.gacha_setting.getID());
    if (!_ret || !_ret.ri || _ret.ri.len() < 1) return;

    local _ud = ::gamesession.getUserData();

    if (this.gacha_setting.getLimitGachaLimit() >= 0) {
      if (this.gacha_setting.getLimitGachaDaily() == 1) _ud.addDailyGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion(), _ret.st);
      else _ud.addLimitGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion());
    }

    _ud.addRewardItems(_ret.ri);

    local _pay = this.gacha_setting.getLimitGachaPrice();
    _ud.applyPurchase(this.gacha_setting.getLimitGachaType(), _pay, false);

    this.pnl_parent.moveLimitGachaProductionPanel(_ret.ri, this.gacha_setting.getID());
  }

  function actionevent_step_gacha(e) {

    local _price_info = this.gacha_setting.getStepPriceInfoFromUserData();
    local _state = this.gacha_setting.canExecuteStepGacha();
    if (!_price_info) return;

    if (!this.gacha_setting) {
      _popImpossibleMessage(GachaSetting.STATE_OTHERS);
      return;
    }

    if (_state != GachaSetting.STATE_ENABLE) {
      _popImpossibleMessage(_state);
      return;
    }
    if (!_confirmPurchaseDialog(_price_info, _price_info.type, _state)) return;

    local _ret = ::gamesession.executeStepGacha(this.gacha_setting.getID());
    if (!_ret || !_ret.ri || _ret.ri.len() < 1) return;

    local _ud = ::gamesession.getUserData();

    _ud.addRewardItems(_ret.ri);

    _ud.applyPurchase(_price_info.type, _price_info.price, false);

    _ud.addStepGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion(), _ret.st);

    this.pnl_parent.moveStepGachaProductionPanel(_ret.ri, this.gacha_setting.getID());
  }

  function _popImpossibleMessage(code) {
    local _text = "";
    switch (code) {
    case GachaSetting.STATE_POVERTY:
      _text = ::dict.get("gacha_poverty");
      break;
    case GachaSetting.STATE_PERIOD_OUTSIDE:
      _text = ::dict.get("gacha_period_outside");
      break;
    case GachaSetting.STATE_LIMIT:
      _text = ::dict.get("gacha_limit");
      break;
    case GachaSetting.STATE_OTHERS:
      _text = ::dict.get("gacha_error");
      break;
    }
    ::gamesession.messagelayer.closeAllMessage();
    local _msg = ::Message();
    _msg.setMsec(3 * 1000);
    _msg.setText(_text);
    _msg.setFontSize(32);
    _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
    _msg.show();
  }
}