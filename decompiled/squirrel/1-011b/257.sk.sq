class AREffectModel extends ARModel {
  obj = null;

  interval_id = null;

  v_1 = Vector3D();

  current_effect_name = null;
  current_script_name = null;

  constructor(scene) {
    super(scene);
    this.obj = ::StageObject(this.scene);

    interval_id = -1;

    current_effect_name = null;
    current_script_name = null;
  }

  function build(model_path, scp_path, efx_path = null, shadow_path = null, capture_model = null) {
    local _pos;
    if (this.obj.sk3d) { _pos = clone this.obj.sk3d.pos; }

    this.obj.build(model_path);

    if (shadow_path) {
      this.shadow_obj = SK3DObject(shadow_path);
      this.shadow_obj.pos = Vector3D(0.0, 0.02, 0.0);
      this.shadow_obj.name = "shadow";
      this.shadow_obj.rot.set(Quaternion.fromHPB(0.0, 0.0, 0.0));
      this.shadow_obj.scale.set(0.6);
      this.obj.sk3d.addChild(this.shadow_obj);
      this.obj.sk3d.scn.addObject(this.shadow_obj);
    }

    this.obj.sk3d.scn = null;
    if (_pos) this.obj.sk3d.pos.set(_pos);

    local _res;

    if (scp_path) {
      _res = ::getResource(scp_path);
      if (_res) {
        this.obj.sk3d.setScript(_res);
        this.obj.sk3d.startScript("start");
      }
    }

    if (efx_path) {
      _res = ::getResource(efx_path);
      if (_res) {
        this.obj.setEffectScript(_res);
        this.obj.startEffect("start");
      }
    }

    this.obj.registerModifierParameters();
    this.obj.addToStage();

    this.capture_model = capture_model;
  }

  function release() {
    removeShadow();
    clearInterval(this.interval_id);
    this.interval_id = -1;
    if (this.obj.sk3d.parent) this.sk3d.removeFromParent();
    this.obj.scene.removeObject(this.obj.sk3d);
  }

  function removeShadow() {
    if (this.shadow_obj) {
      obj.sk3d.removeChild(shadow_obj);
      shadow_obj.parent = null;
      scene.removeObject(shadow_obj);
    }

    shadow_obj = null;
  }

  function getPos() {
    return obj.sk3d.pos;
  }

  function getRotation() {
    return obj.sk3d.rot;
  }

  function getScale() {
    return obj.sk3d.scale;
  }

  function setPos(pos) {

    super.setPos(pos);
    obj.sk3d.pos.set(pos);
    obj.sk3d.matdirty = true;
  }

  function setPosXYZ(x, y, z) {

    super.setPosXYZ(x, y, z);
    obj.sk3d.pos.set(x, y, z);
    obj.sk3d.matdirty = true;
  }

  function setAngle(angle) {
    super.setAngle(angle);
    obj.sk3d.rot.set(Quaternion.fromHPB(this.angle, 0, 0));
    obj.sk3d.matdirty = true;

  }

  function setRotation(rot) {
    super.setRotation(rot);
    obj.sk3d.rot.set(rot);
    obj.sk3d.matdirty = true;
  }

  function setScale(sc) {
    obj.sk3d.scale.set(sc);
  }

  function setVisible(visible) {
    super.setVisible(visible);
    this.obj.sk3d.setVisible(this.visible);
    foreach (c in this.obj.sk3d.children) {
      c.setVisible(this.visible);
    }

    if (capture_model) {
      capture_model.setVisible(visible);
    }
  }

  function _swapAttribute() {
    local _tmp_pos = Vector3D(another_pos);
    local _tmp_rot = Vector3D(another_rot);
    local _tmp_sca = Vector3D(another_scale);
    another_pos.set(obj.sk3d.pos);
    another_rot.set(obj.sk3d.rot);
    another_scale.set(obj.sk3d.scale);
    obj.sk3d.pos.set(_tmp_pos);
    obj.sk3d.rot.set(_tmp_rot);
    obj.sk3d.scale.set(_tmp_sca);
  }

  function startEffect(name, ...) {
    if (!this.obj) {
      return;
    }

    this.current_effect_name = name;

    switch (vargc) {
    case 1: return this.obj.startEffect(name, vargv[0]);
    case 2: return this.obj.startEffect(name, vargv[0], vargv[1]);
    case 3: return this.obj.startEffect(name, vargv[0], vargv[1], vargv[2]);
    case 4: return this.obj.startEffect(name, vargv[0], vargv[1], vargv[2], vargv[3]);
    default: return this.obj.startEffect(name);
    }
  }

  function startScript(name, ...) {
    if (!this.obj || !this.obj.sk3d) return;

    this.current_script_name = name;

    switch (vargc) {
    case 1: return this.obj.sk3d.startScript(name, vargv[0]);
    case 2: return this.obj.sk3d.startScript(name, vargv[0], vargv[1]);
    case 3: return this.obj.sk3d.startScript(name, vargv[0], vargv[1], vargv[2]);
    case 4: return this.obj.sk3d.startScript(name, vargv[0], vargv[1], vargv[2], vargv[3]);
    default: return this.obj.sk3d.startScript(name);
    }
  }

  function isScriptRunning() {
    return obj.sk3d.scprunner.running
  }

  function isEffectRunning(key) {
    return obj.isEffectRunning(key);
  }

  function setScriptLock(b) {
    this.obj.sk3d.setScriptLock(b);
  }

  function stopScript() {
    if (this.obj && this.obj.sk3d) this.obj.sk3d.stopScript();
  }

}