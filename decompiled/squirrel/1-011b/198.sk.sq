class ActionSetting extends SanrioSetting {
  static IDLE = 0;
  static ACTION = 1;
  static MOVE = 2;
  static FURNITURE = 3;
  static LINK_ACTION = 4;
  static LINK_MOVE = 5;

  static TYPE_RANDOM = 1;
  static TYPE_NOMOVE = 2;

  id = null;

  action_type = 0;

  action_name = null;
  frequency = 0;

  move_speed = 0.0;

  prev_actions = null;

  desc = null;
  is_use_furniture = null;
  take_picture_time = null;

  can_interrupt = true;

  wait_action_id = null;

  priority = null;

  function loadConfAtServer(t) {
    local _setting = ActionSetting();

    foreach (k, v in t) {
      switch (k) {
      case "prev_actions":
        _setting[k] = decodeJSON(v);
        break;
      case "is_use_furniture":
      case "can_interrupt":
        _setting[k] = v > 0 ? true : false;
        break;
      default:
        _setting[k] = v;
      }
    }

    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (desc) trans + "desc";

    return trans;
  }

  function getDesc() {
    if (!this.desc) return "";
    return this.desc;
  }

  function getID() {
    return id;
  }

  function getActionName() {
    return this.action_name;
  }

  function getFreq() {
    return this.frequency;
  }

  function getIconSprite(type = -1, is_small = false) {
    local _file_name;
    switch (type) {
    case ActionSetting.TYPE_RANDOM:
      _file_name = "motion1/urouro";
      break;
    case ActionSetting.TYPE_NOMOVE:
      _file_name = "motion1/random";
      break;
    default:
      if (is_small) {
        _file_name = "motion_s/" + this.id + "_s";
      }
      else {

        _file_name = "motion" + ((this.id - 1) / 20 + 1) + "/" + this.id;
      }
      break;
    }

    local _path = "/image/icon/motion/" + _file_name + ".png";
    local _sp = ::getSprite(_path);
    if (!_sp) {
      _sp = ::getSprite("/image/icon/motion/motion1/random.png");
      println("[ERROR] motionicon is none !!!!!! motion id = " + id);
      currentthread().printStackTrace();
    }
    _sp.blend = SK_MIX;
    return _sp;
  }

  function isUseFurniture() {
    return this.is_use_furniture;
  }

  function isLinkAction() {
    return this.action_type == LINK_ACTION ? true : false;
  }

  function isMoveAction() {
    return this.action_type == MOVE ? true : false;
  }

  function getTakePictureTime() {
    return this.take_picture_time;
  }

  function canInterrupt() {
    return can_interrupt;
  }

  function getWaitActionSetting() {
    return ::gamesetting.action_settings[this.wait_action_id];
  }
  function getPriority() {
    return this.priority;
  }

}