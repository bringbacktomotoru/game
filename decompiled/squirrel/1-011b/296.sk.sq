class Picture extends SKView {

  view = null;
  lbl_saved = null;
  btn_picture = null;
  frame = null;

  image_view = null;
  texture = null;
  play_button = null;

  constructor(tex) {
    this.view = ::loadSKView("/ui/common/Picture.ui");
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    addChild(view);

    this.frame = this.view.findChild("picture_frame");
    this.frame.setVisible(false);

    this.lbl_saved = this.view.findChild("lbl_saved");
    this.lbl_saved.setText(::dict.get("gallery_panel_saved"));

    this.btn_picture = this.view.findChild("btn_picture");

    setTexImage(tex);
  }

  function removed() {
    super.removed();
    this.texture = null;

  }

  function unloadTexImage() {
    this.btn_picture.clearChildren();
    this.btn_picture.addChild(this.frame);
  }

  function setTexImage(tex) {
    unloadTexImage();
    if (tex) this.texture = tex;

    local _rgba = RGBAImage(this.btn_picture.bnd.w, this.btn_picture.bnd.h, 0xff000000);
    local _bgtex = Texture();
    _bgtex.load(_rgba);
    this.btn_picture.addChild(SKImageView(_bgtex));

    local _iv = SKImageView(this.texture);
    local _w = _iv.bnd.w;
    local _h = _iv.bnd.h;

    if (_w / _h > 1.0) {

      local _rate = this.btn_picture.bnd.w / _w;
      _w = this.btn_picture.bnd.w;
      _h *= _rate;
    }
    else {

      local _rate = this.btn_picture.bnd.h / _h;
      _w *= _rate;
      _h = this.btn_picture.bnd.h;
    }

    _iv.setRect(0, 0, _w, _h);
    _iv.centerize();
    _iv.pos.set(this.btn_picture.bnd.w / 2.0, this.btn_picture.bnd.h / 2.0, 0.0);
    this.btn_picture.addChild(_iv);

    this.image_view = _iv;
  }

  function frameVisible(b) {
    this.frame.setVisible(b);
  }

  function showText() {
    this.view.startMethod("show_text");
  }
  function hideText() {
    this.view.startMethod("hide_text");
  }
  function getImageView() {
    return this.image_view;
  }

  function getAspectW() {
    return this.btn_picture.bnd.w / this.btn_picture.bnd.h;
  }

  function getTexture() {
    return this.texture;
  }

  function setPlayButton() {
    if (!this.play_button) {
      local _v = ::loadSKView("/ui/common/PlayButton.ui");
      _v.scale(0.75);
      _v.centerize();
      _v.pos.set(this.view.bnd.w / 2.0, this.view.bnd.h / 2.0, 0.0);
      this.play_button = _v;
    }
    this.btn_picture.addChild(this.play_button);
  }

  function setPictureBound(w, h) {
    this.btn_picture.bnd.w = w;
    this.btn_picture.bnd.h = h;
    this.btn_picture.centerize();
    this.view.bnd.w = this.btn_picture.bnd.w;
    this.view.bnd.h = this.btn_picture.bnd.h;
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
  }

  function getPicture() {
    return this.btn_picture;
  }

  function saved() {
    this.lbl_saved.centerize();
    this.lbl_saved.pos.set(this.btn_picture.bnd.w / 2.0, this.btn_picture.bnd.h / 2.0, 0.0);
    this.btn_picture.addChild(this.lbl_saved);
  }
}

class PictureButton extends Picture {
  tap_func = null;

  index = -1;

  constructor(tex) {
    super(tex);

    ::TapButton(this.btn_picture, false).view.addEventListener(ACTION_EVENT, _actionevent);
  }

  function setIndex(idx) {
    this.index = idx;
  }

  function getIndex() {
    return this.index;
  }

  function setTapFunc(f) {
    this.tap_func = f;
  }

  function _actionevent(e) {
    e.consume();

    if (this.tap_func) this.tap_func();
  }
}

class PictureMoveLayer extends SKView {
  view = null;
  pnl_picture = null;

  constructor() {
    this.view = ::loadSKView("/ui/common/PictureMove.ui");
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    addChild(this.view);

    this.pnl_picture = this.view.findChild("pnl_picture");
  }

  function setPicture(pic) {
    this.pnl_picture.clearChildren();

    pic.scale(this.pnl_picture.bnd.w / pic.bnd.w);
    pic.matdirty = true;
    this.pnl_picture.addChild(pic);
  }

  function initView() {
    this.pnl_picture.clearChildren();
    this.view.startMethod("init_view");
  }

  function executeMove() {
    this.view.startMethod("move_picture");
  }
}