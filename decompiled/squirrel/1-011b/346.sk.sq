class PropDialog extends ::Dialog {
  static SPACE_X = 5;
  static SPACE_Y = 10;
  static ROW_NUM = 2;

  pnl_prop_list = null;
  reclist = null;
  scroll = null;

  chara_model = null;

  constructor() {
    super(::loadSKView("/ui/dialog/PropDialog.ui"));

    this.pnl_prop_list = this.view.findChild("pnl_prop_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.pnl_prop_list.addChild(this.reclist);
    this.pnl_prop_list.setBuffer(true);

    setup();
  }

  function setup() {
    this.reclist.clearChildren();
    local _prop_list = ::gamesetting.prop_settings;
    local _offset = 0;
    local _size_x = 0;

    local _cnt = 0;

    local _remove = PropCard(this, null);
    _size_x = _remove.bnd.w;
    this.reclist.addChild(_remove);
    _remove.matdirty = true;
    _remove.repaint();
    _cnt++;

    foreach (prop in _prop_list) {
      local _card = PropCard(this, prop);

      if (_cnt > 0 && _cnt % ROW_NUM == 0) _offset += _size_x + SPACE_X;
      _card.pos.x = _offset;
      _card.pos.y = (_cnt % ROW_NUM) * (_card.bnd.h + SPACE_Y);

      this.reclist.addChild(_card);
      _card.matdirty = true;
      _card.repaint();
      _cnt++;
    }

    _offset += _size_x * 2;
    this.reclist.setRect(0, 0, _offset, this.pnl_prop_list.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);
  }

  function setCharaModel(m) {
    this.chara_model = m;
  }

  function selectProp(s) {
    if (!this.chara_model) return;

    if (s) this.chara_model.startProp(s);
    else this.chara_model.endProp();

    close();
  }
}

class PropDialog.PropCard extends SKView {
  pnl_parent = null;
  view = null;

  setting = null;

  constructor(p, s) {
    this.pnl_parent = p;
    this.setting = s;

    this.view = ::loadSKView("/ui/common/PropCard.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    local _btn_prop = this.view.findChild("btn_prop");
    ::TapButton(_btn_prop, false).view.addEventListener(ACTION_EVENT, actionevent_select_prop);
    if (this.setting) _btn_prop.findChild("lbl_name").setText(this.setting.getName());
    else _btn_prop.findChild("lbl_name").setText("外す");
  }

  function actionevent_select_prop(e) {
    e.consume();
    this.pnl_parent.selectProp(this.setting);
  }
}