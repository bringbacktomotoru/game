class LetterSetting extends ::Setting {
  id = 0;

  sender = null;
  message_list = null;
  icon_path = null;

  function loadConfAtServer(t) {
    local _setting = CostumeSetting();
    foreach (k, v in t) {
      switch (k) {
      case "message_list":
        _setting[k] = decodeJSON(v);
        break;
      default:
        _setting[k] = v;
      }
    }
    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (message_list) trans + "message_list";

    return trans;
  }

  function getID() {
    return this.id;
  }

  function getSender() {
    return this.sender;
  }

  function getMessageList() {
    return this.message_list;
  }

  function getIconSprite() {
    if (!this.icon_path) return null;
    local _sp = ::getSprite(this.icon_path);
    if (!_sp) return null;
    _sp.blend = SK_MIX;
    return _sp;
  }
}