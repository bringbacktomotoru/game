class CharaMotionEventPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;
  static need_menu_layer = false;
  static need_panel_name = false;

  motion_info_list = null;
  f_model = null;

  stage = null;

  mask_view = null;
  trans = null;
  timeout_id = null;

  talkwindow_layer = null;

  sprite_capture = null;

  view = null;
  v_1 = Vector3D();

  function added() {
    this.view = ::loadSKView("/ui/CharaMotionEventPanel.ui");
    addChild(this.view);

    this.talkwindow_layer = ::TalkWindowLayer(this.view.findChild("pnl_talkwindow_layer"));

    this.mask_view = SKImageView();
    local _sp = ::getSprite("/ui/image/bg.png");
    this.mask_view.setSprite(_sp);
    this.mask_view.setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    this.mask_view.setVisible(false);
    this.view.addChild(this.mask_view);

    this.trans = ::addedTransition(this.mask_view, ::getTexture("/image/rule/163.jpg"), 5.0, 50);

    this.stage = ::gamesession.getCurrentScene().getStage();
  }

  function removed() {
    setVisibleUnrelatedModel(true, null, null);
    if (this.timeout_id) {
      clearInterval(timeout_id);
      this.timeout_id = null;
    }
  }

  function setPanelParam(param) {
    this.motion_info_list = param["motion_infos"];
    this.f_model = param["f_model"];
  }

  function addTalkWindow(sk3d, talk_key, chara_key, big = false, small = false) {
    talkwindow_layer.addTalk(sk3d, talk_key, chara_key);
  }
  function removeAllTalkWindow() {
    talkwindow_layer.removeAllTalkWindow();
  }

  function startMotionEvent() {
    newthread().start(function() {
      foreach (info in this.motion_info_list) {
        local model = info["chara"] || null;
        local mid = info["mid"] || -1;

        showDisableMask();
        pass(600);
        v_1.set(0, 0, 0);

        local _angle = this.f_model.getAngle();

        if (model) {
          local _sk3d = model.obj.sk3d;
          if (_sk3d.parent) {
            local bone = _sk3d.parentbone;
            local p0 = bone.parts.bindpose;
            v_1.set(p0[12], 0, p0[14]).transform0(_sk3d.parent.gmat);
            v_1.add(_sk3d.parent.pos);
          }

          this.stage.trackModel(model, v_1, 15.0);
          model.setVisible(true);
          setVisibleUnrelatedModel(false, model, this.f_model);
        } else {
          this.stage.trackModel(this.f_model, v_1, 15.0);
          setVisibleUnrelatedModel(false, null, this.f_model);
          local t_cos_table = this.f_model.getTargetCostumeTable();
          foreach (cid, bone in t_cos_table) {
            local _cm = this.stage.getChara(cid);
            _cm.setVisible(true);
          }
        }

        pass(500);
        local _cm = this.stage.camera_work;
        local _p = _angle - _cm.hpb[0] * Math.RTOD;
        this.stage.rotateCameraMove(_p, 0, 0, true);

        _cm.setTrackingPointer();

        hideDisableMask();
        pass(400);
        this.f_model.stopScript();
        this.talkwindow_layer.removeAllTalkWindow();
        if (mid > 0) {
          startMotionScript(model, mid);
        } else {
          startUseFurnitureScript();
        }
        if (this.sprite_capture) _showConfirmCaptureDialog(mid);

      }

      local _tex = ::getTexture("/ui/image/bg.png");
      local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/163.jpg"), 5.0, 50);
      getHomeUI().movePanel(::HomeTopPanel, false, null, _trans);

    }, this)
  }

  function startMotionScript(model, mid) {
    local _setting = ::gamesetting.costume_motion_settings[mid];
    local _scp_name = _setting.getActionName();

    model.setAutoAction(false);

    if (!_setting.isUseFurniture()) {
      local _sk3d = model.obj.sk3d;
      local _bonename = _sk3d.parentbone ? _sk3d.parentbone.name : null;

      v_1.set(this.f_model.calcEndFurniturePos(_bonename));
      model.startScript("end_common_furniture", v_1);

      while (model.isScriptRunning() && model.getCurrentScriptName() == "end_common_furniture") {
        suspend();
      }
      pass(200);

      model.startScript("rotate_to_camera");
      pass(200);
    }

    if (this.timeout_id) {
      clearInterval(timeout_id);
      this.timeout_id = null;
    }
    this.timeout_id = setTimeout(_takePicture.bindenv(this), _setting.getTakePictureTime());

    model.startScript(_scp_name);
    while (true) {
      if (!model.isScriptRunning()) break;
      if (model.getCurrentScriptName() != _scp_name) break;
      suspend();
    }
  }

  function startUseFurnitureScript() {

    if (this.timeout_id) {
      clearInterval(timeout_id);
      this.timeout_id = null;
    }
    local _t = 1000 + ::PUBLIC_RANDOM.nexti(600) - 300;
    this.timeout_id = setTimeout(_takePicture.bindenv(this), _t);

    this.f_model.startUseFurnitureScript();

    local cnt = 0;
    while (true) {
      cnt += 10;
      sleep(10);
      if (cnt > 2000) break;
    }
  }

  function setVisibleUnrelatedModel(b, chara, f_model) {
    local charas = this.stage.getCharacters();
    foreach (cm in charas) {
      if (cm == chara) continue;
      cm.setVisible(b);
    }

    local f_models = this.stage.getFurnitureModels();
    foreach (fm in f_models) {
      if (fm == f_model) continue;
      fm.setVisible(b);
    }
  }

  function _takePicture() {
    local _view = ::gamesession.getCurrentScene().getStage().getView();

    local _idx = this.view.removeChild(this.talkwindow_layer.view);
    _view.addChild(this.talkwindow_layer.view);

    this.sprite_capture = _view.capture();

    _view.removeChild(this.talkwindow_layer.view);
    this.view.insertChild(_idx, this.talkwindow_layer.view);

    _flash();
  }

  function showDisableMask() {
    this.mask_view.visible = true;
    this.trans.showPerform();
  }

  function hideDisableMask() {
    this.trans.hidePerform();
  }
  function _flash() {
    newthread().start(function() {
      local _flash = ::SKImageView();
      local _sp = _flash.sp;
      _sp.color = 0xffffffff;
      _sp.blend = SK_MIX;
      _flash.setRect(0.0, 0.0, this.view.bnd.w, this.view.bnd.h);
      this.view.addChild(_flash);
      local _frames = 30;
      local fdiv = 1.0 / float(_frames - 1);
      for (local l = _frames - 1; l >= 0; l--) {
        local a = ((l * fdiv) * 255.0);
        _sp.color = (_sp.color & 0xffffff00) | a;
        _flash.repaint();
        sleep(16);
      }
      this.view.removeChild(_flash);
    }, this);

  }

  function _rotToDir(q) {
    local _sin = 2 * (q.x * q.z - q.y * q.w) * -1;
    local _dir = Math.asin(_sin);

    return _dir;
  }
  function _showConfirmCaptureDialog(mid) {
    local dlg = ::ConfirmCaptureDialog();
    dlg.setCapture(this.sprite_capture, mid);
    dlg.show();

    this.sprite_capture = null;
  }

  function _showMotionGetRewardDialog(mid, cid) {
    local dlg = ::RewardDialog();
    dlg.setReward(ITEM_TYPE_MOTION, mid, 1, cid);
    dlg.show();
  }
}