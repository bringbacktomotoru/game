class SanrioAppsFlyerInterface {
  static DEV_KEY = "b8HJs3kgfcc25pDMsgXq9d";
  static APPLE_APP_ID = "1439788857";

  static AF_COMPLETE_REGISTRATION = "af_complete_registration";
  static AF_COMPLETE_TUTORIAL = "af_tutorial_completion";
  static AF_PURCHASE = "af_purchase";
  static PARAM_TEST = "{\"test\":\"success\"}";

  uid = null;
  is_init = false;

  constructor() {
    startInit();
    this.uid = getAppsFlyerUID();
  }

  function startInit() {}
  function getAppsFlyerUID() { return ""; }
  function trackEvent(name, param) {}
  function setCurrencyCode(code) {}

  function completeRegistration() {}
  function completeTutorial() {}
  function purchase(order_id) {}
}

class SanrioAppsFlyer extends SanrioAppsFlyerInterface {
  function enableAppsFlyer() {
    return this.is_init;
  }

  function startInit() {
    try {

      skLoadAddon("skappsflyer");
      ::AppsFlyer.startInit(DEV_KEY, APPLE_APP_ID);
      this.is_init = true;
    }
    catch (ex) {}
  }

  function getAppsFlyerUID() {
    if (!this.is_init) return "";
    return ::AppsFlyer.getAppsFlyerUID();
  }

  function trackEvent(name, param) {
    if (!this.is_init) return;
    ::AppsFlyer.trackEvent(name, param);
  }

  function setCurrencyCode(code) {
    if (!this.is_init) return;
    ::AppsFlyer.setCurrencyCode(code);
  }

  function getUID() {
    if (!this.uid) return "";
    return this.uid;
  }

  function completeRegistration() {
    if (!this.is_init) return;
    local _param = "{\"uid\":\"" + this.uid + "\"}";
    trackEvent(AF_COMPLETE_REGISTRATION, _param);
  }

  function completeTutorial() {
    if (!this.is_init) return;
    local _param = "{\"uid\":\"" + this.uid + "\"}";
    trackEvent(AF_COMPLETE_TUTORIAL, _param);
  }

  function purchase(price) {
    if (!this.is_init) return;
    local _param = "{\"uid\":\"" + this.uid + "\",\"af_revenue\":" + price + ",\"af_currency\":\"JPY\"}";
    trackEvent(AF_PURCHASE, _param);
  }
}