with SpinModifier
{
  function modify(o, dt) {
    local len = v.length();
    o.matdirty = true;
    if ((time -= dt) > 0) {
      o.rot.synthesize(Quaternion.fromAxis(len * dt * 0.001, v / len));
      o.dir = ::transformQuaternionToDir(o.rot);
      return true;
    } else {
      o.rot.synthesize(Quaternion.fromAxis(len * (dt + time) * 0.001, v / len));
      o.dir = ::transformQuaternionToDir(o.rot);
      return false;
    }
  }

}

with RotateModifier
{
  function modify(o, dt) {
    if ((time -= dt) > 0) {
      o.rot << q1.slerp(q0, easing(time * w));
      o.dir = ::transformQuaternionToDir(o.rot);
      o.matdirty = true;
      return true;
    } else {
      o.rot << q1;
      o.dir = ::transformQuaternionToDir(o.rot);
      o.matdirty = true;
      return false;
    }
  }
}

class BoneSpinModifier extends SK3DModifier {
  order = 1000;

  bone_id = null;
  v = null;
  time = 300;
  accel = 0;

  constructor(bone_id, v, t, a = 0) {
    this.bone_id = bone_id;
    this.v = v;
    this.time = t;
    this.accel = 0;

    this.order += bone_id;
  }

  function modify(o, dt) {
    local bone = o.findBone(this.bone_id);
    if (!bone.adjust) {
      bone.adjust = Transform();
    }

    if ((time -= dt) > 0) {
      local len = v.length();
      bone.adjust.rotate(Quaternion.fromAxis(len * dt * 0.001, v / len));
      o.calcBonePoses();
      return true;
    }
    else {
      local len = v.length();
      bone.adjust.rotate(Quaternion.fromAxis(len * (dt + time) * 0.001, v / len));
      o.calcBonePoses();

      bone.adjust = null;
      return false;
    }
  }
}

class MoveAccelModifier extends MoveForModifier {
  order = 1001;

  sc1 = 0.0;
  sc2 = 1.0;

  constructor(v, t, sc1, sc2) {
    super(v, t);

    this.sc1 = sc1 + 0.0;
    this.sc2 = sc2 + 0.0;
  }

  function modifyw(o, w1, w2) {
    o.pos = o.pos + (vec * (sc1 + (sc2 - sc1) * w2));
    o.matdirty = true;
  }
}

class MaterialColorFadeModifier extends TimeFadeModifier {
  order = 10;

  mate = null;
  from_mate = null;
  to_mate = null;

  constructor(o, to_mate, t) {
    totaltime = t + 0.0;
    mate = o.getMaterials();
    this.to_mate = to_mate;
  }

  function start(o) {
    from_mate = clone mate;
    println("from_mate[0][Ke]:" + from_mate[0]["Ke"] + " to_mate[0][Ke]:" + to_mate[0]["Ke"]);
  }

  function interrupt(o) {
    modifyw(o, 1.0, 1.0);
  }

  function modifyw(o, w1, w2) {
    local color1, color2;
    local _lighttype = ["Ka", "Kd", "Ks", "Ke", "Kmul"];
    foreach (i, m in mate) {

      for (local l = 0; l < 5; l++) {
        color1 = from_mate[i][_lighttype[l]];
        color2 = to_mate[i][_lighttype[l]];
        local c = Math.lerpcolor(color1, color2, w2);
        m[_lighttype[l]] = c;
      }
    }
  }
}