class ScanLineAlgorithmProcesser {

  function resetAllNode(all_nodes) {
    foreach (x_nodes in all_nodes) {
      foreach (node in x_nodes) {
        if (!node) continue;
        node.reset();
      }
    }
  }

  function findInitialPoint(all_nodes) {
    local find = false;
    local x = 0;
    local z = 0;
    foreach (z_idx, x_nodes in all_nodes) {
      foreach (x_idx, node in x_nodes) {
        if (!node || !node.isValid()) continue;

        x = x_idx;
        z = z_idx;
        find = true;
        break;
      }
      if (find) break;
    }

    return [[x, z]];
  }

  function findLinePoints(all_nodes, left, right, z, out) {
    local line = all_nodes[z];
    if (!line) return;

    local node = null;
    local prev_valid = false;
    local curr_valid = false;
    for (local i = left; i <= right; i++) {
      node = line[i];
      curr_valid = node && node.isValid() && node.cost != 1;
      if (prev_valid && !curr_valid) out + [i - 1, z];

      prev_valid = curr_valid;
    }

    if (curr_valid) out + [right, z];
  }

  function findPoints(all_nodes, space, out) {
    local _findLinePoints = ::ScanLineAlgorithmProcesser.findLinePoints;
    local left = space[0] - 1;
    local right = space[1] + 1;
    local z = space[2];

    _findLinePoints(all_nodes, left, right, z - 1, out);

    _findLinePoints(all_nodes, left, right, z + 1, out);
  }

  function leftFill(line, x) {

    local node = null;
    while (true) {
      x--;
      node = line[x];
      if (!node || !node.isValid()) return x + 1;

      node.cost = 1;
    }
  }

  function rightFill(line, x) {

    local node = null;
    while (true) {
      x++;
      node = line[x];
      if (!node || !node.isValid()) return x - 1;

      node.cost = 1;
    }
  }

  function lineFill(all_nodes, point) {
    local x = point[0];
    local z = point[1];
    local line = all_nodes[z];

    line[x].cost = 1;

    local clazz = ::ScanLineAlgorithmProcesser;

    local left = clazz.leftFill(line, x);

    local right = clazz.rightFill(line, x);

    return [left, right, z];
  }

  function fill(all_nodes) {
    local clazz = ::ScanLineAlgorithmProcesser;

    clazz.resetAllNode(all_nodes);

    local curr = clazz.findInitialPoint(all_nodes);

    local next = [];
    local space = null;
    local point = null;
    local _lineFill = clazz.lineFill;
    local _findPoints = clazz.findPoints;
    local count = 0
    while (length(curr) != 0) {
      while (length(curr) != 0) {
        point = delete curr[0];

        space = _lineFill(all_nodes, point);

        _findPoints(all_nodes, space, next);
      }

      curr = next;
      next = [];
    }
  }
}

class ScanLineAlgorithmProcesser2 {

  function pointFill(all_node, x_idx, z_idx) {
    local start_node = all_nodes[x_idx][z_idx];
    if (!start_node || !start_node.isValid() || start_node.cost == 1) return null;
    start_node.cost = 1;

    local check_line = all_nodes[z_idx];
    local check_node = null;
    local res = [0, length(check_line) - 1, z_idx];

    for (local i = x_idx - 1; i < 0; i--) {
      check_node = check_line[i];
      if (!check_node || !check_node.isValid()) {
        res[0] = i + 1;
        break;
      }

      check_node.cost = 1;
    }

    for (local i = x_idx + 1; i > 0; i++) {
      check_node = check_line[i];
      if (!check_node || !check_node.isValid()) {
        res[1] = i - 1;
        break;
      }

      check_node.cost = 1;
    }

    return res;
  }

  function lineFill(all_node, left, right, z) {
    local res = [];

    local _pointFill = ::ScanLineAlgorithmProcesser2.pointFill;
    for (local i = left; i < right; i++) {
      local fill_res = _pointFill(all_nodes, i, z);
      if (!fill_res) continue;

      res + fill_res;
      i = fill_res[1] + 1;
    }

    if (length(res) == 0) return null;
    return res;
  }

  function fill(all_nodes) {

    foreach (x_nodes in all_nodes) {
      foreach (node in x_nodes) {
        if (!node) continue;
        node.reset();
      }
    }

    local find = false;
    local check_left = 0;
    local check_right = 0;
    local check_z = 0;
    foreach (z_idx, x_nodes in all_nodes) {
      foreach (x_idx, node in x_nodes) {
        if (!node.isValid()) continue;

        check_left = x_idx;
        check_z = z_idx;
        find = true;
        break;
      }
      if (find) break;
    }

    local _pointFill = ::ScanLineAlgorithmProcesser2.pointFill;
    local res = _pointFill(all_nodes, check_left, check_z);
    if (!res) return;

    local check_node = null;
    local curr = [res];
    local next = [];
    local _lineFill = ::ScanLineAlgorithmProcesser2.lineFill;
    do {
      while (length(curr) != 0) {
        check_node = delete curr[0];
        check_left = check_node[0];
        check_right = check_node[1];
        check_z = check_node[2];

        res = _lineFill(all_nodes, check_left - 1, check_right + 1, check_z - 1);
        if (res) next.extend(res);

        res = _lineFill(all_nodes, check_left - 1, check_right + 1, check_z + 1);
        if (res) next.extend(res);
      }

      curr = next;
      next = [];
    } while (length(curr) != 0);
  }
}