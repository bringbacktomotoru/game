class GachaResultPanel extends ::HomeUI.Panel {
  static need_rank_layer = false;
  static need_menu_layer = false;
  static need_panel_name = true;
  static need_hapiness_info = true;
  static unique_bgm = "BGM07";

  view = null;

  btn_retry = null;

  reward_items = null;
  gacha_setting = null;
  index = -1;
  limit_flag = 0;
  step_flag = 0;

  btn_ok = null;

  item_cards = null;

  costume_ids = null;

  function added() {
    if (!this.gacha_setting) getHomeUI().moveTopPanel();

    super.added();

    this.view = ::loadSKView("/ui/GachaResultPanel.ui");
    addChild(this.view);
    item_cards = [];

    this.costume_ids = [];
    local _pnl_list = this.view.findChild("pnl_item_list");
    if (this.reward_items) {
      local _offset = 0;
      local _cnt = 0;
      foreach (r in this.reward_items) {
        local _single = this.reward_items.len() == 1;
        local _item = ItemCard(r, _single);
        _pnl_list.addChild(_item);
        if (_single) {
          _item.pos.x = _pnl_list.bnd.w / 2.0 - _item.bnd.w / 2.0;
          _item.pos.y = _pnl_list.bnd.h / 2.0 - _item.bnd.h / 2.0;
        }
        else {
          local _space = 10;
          local _def_x = _pnl_list.bnd.w / 2.0 - _item.bnd.w * 2 - _space * 2 - _item.bnd.w / 2.0;
          if (_cnt < 5) {
            _item.pos.x = _def_x + _item.bnd.w * _cnt + _space * _cnt;
          }
          else {
            local _c = _cnt - 5;
            if (this.reward_items.len() == 11) _def_x -= _item.bnd.w / 2.0;
            _item.pos.x = _def_x + _item.bnd.w * _c + _space * _c;
            _item.pos.y = _item.bnd.h + 35;
          }
        }
        _item.matdirty = true;
        _item.repaint();
        item_cards + _item;

        if (r.kind == ITEM_TYPE_COSTUME) this.costume_ids + r.id;

        _cnt++;
      }
    }

    this.btn_retry = this.view.findChild("btn_retry");

    if (this.costume_ids.len() > 0) {

      this.btn_retry.visible = false;
      this.btn_ok = this.view.findChild("btn_ok_center");
      this.view.findChild("btn_ok").visible = false;
    }
    else {
      this.btn_ok = this.view.findChild("btn_ok");
      this.view.findChild("btn_ok_center").visible = false;

      local _type;
      local _price;
      local _state;
      if (this.step_flag == 1) {
        local _info = this.gacha_setting.getStepPriceInfoFromUserData();
        _price = _info.price;
        _type = _info.type;
        _state = this.gacha_setting.canExecuteStepGacha();
      }
      else if (this.limit_flag == 1) {
        _price = this.gacha_setting.getLimitGachaPrice();
        _type = this.gacha_setting.getLimitGachaType();
        _state = this.gacha_setting.canExecuteLimitGacha();
      }
      else {
        _price = this.gacha_setting.getPrice(this.index);
        _type = this.gacha_setting.getType();
        _state = this.gacha_setting.canExecuteGacha(this.index);
      }

      ::TapButton(this.btn_retry).view.addEventListener(ACTION_EVENT, actionevent_retry);
      _buttonColor(_state);
      local _lbl_retry = this.btn_retry.findChild("lbl_retry");
      _lbl_retry.setText(::dict.get("gacha_retry"));
      local _img_gm = this.btn_retry.findChild("img_gm");
      local _img_rm = this.btn_retry.findChild("img_rm");

      switch (_type) {
      case PRICE_GM:
        _img_gm.visible = true;
        _img_rm.visible = false;
        break;
      case PRICE_RM:
        _img_gm.visible = false;
        _img_rm.visible = true;
        break;
      case PRICE_ONEROUS_RM:
        _img_gm.visible = false;
        _img_rm.visible = true;
        break;
      }
      local _lbl_price = this.btn_retry.findChild("lbl_price");
      _lbl_price.setText(::formatNumberString(_price));
    }

    ::TapButton(this.btn_ok).view.addEventListener(ACTION_EVENT, actionevent_back);

  }

  function show() {
    ::playSound(SoundConstants.SOUND_GACHA_RESULT_NORMAL);
    foreach (card in item_cards) {
      card.setEvent();
    }

    local _home_ui = getHomeUI();
    _home_ui.updateShopMark(false, true);
    _home_ui.updateShopMark(false, false);

  }

  function setPanelParam(param) {
    if ("reward_items" in param) this.reward_items = param.reward_items;
    if ("gacha_id" in param) {
      local _gid = param.gacha_id;
      this.gacha_setting = ::gamesetting.gacha_settings[_gid];
    }
    if ("index" in param) this.index = param.index;
    if ("limit" in param) this.limit_flag = param.limit;
    if ("step" in param) this.step_flag = param.step;
  }

  function _buttonColor(state) {

    if (state == ::GachaSetting.STATE_ENABLE) {
      this.btn_retry.setDisableColor(false);
    } else if (state == ::GachaSetting.STATE_POVERTY) {
      local _lbl_price = this.btn_retry.findChild("lbl_price");
      _lbl_price.setColor(0xff0000ff);
    } else {
      this.btn_retry.setDisableColor(true);
    }
  }

  function _confirmPurchaseDialog(price_info, type, state) {
    local _dlg = ::SimpleDialog2();
    _dlg.lbl_caution.setText("");
    if (price_info.num == 1) {
      _dlg.lbl_msg.setText(::dict.get("gacha_confirm"));
      _dlg.btn_shorten.findChild("lbl_shorten").setText(::dict.get("gacha_confirm_button"));
    } else {
      _dlg.lbl_msg.setText(::dict.get("gachas_confirm", [price_info.num]));
      _dlg.btn_shorten.findChild("lbl_shorten").setText(::dict.get("gachas_confirm_button", [price_info.num]));
    }
    _dlg.setPrice(price_info.price, type);

    if (state == GachaSetting.STATE_ENABLE) {
      _dlg.tapbutton_ok.setTappedJingle(SoundConstants.SOUND_TRY_GACHA, 2000);
    }
    _dlg.show();

    return _dlg.ret;
  }

  function _retryGacha() {
    local _price_info = this.gacha_setting.getPriceInfo(this.index);
    local _state = this.gacha_setting.canExecuteGacha(this.index);
    if (!_price_info) return;

    if (!this.gacha_setting) {
      _popImpossibleMessage(GachaSetting.STATE_OTHERS);
      return;
    }

    if (_state != GachaSetting.STATE_ENABLE) {
      _popImpossibleMessage(_state);
      return;
    }

    if (!_confirmPurchaseDialog(_price_info, this.gacha_setting.getType(), _state)) return;

    local _ri = ::gamesession.executeGacha(this.gacha_setting.getID(), this.index);
    if (!_ri || _ri.len() < 1) return;

    local _ud = ::gamesession.getUserData();

    if (this.gacha_setting.getLimit() >= 0) _ud.addGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion());

    _ud.addRewardItems(_ri);

    local _pay = this.gacha_setting.getPrice(this.index);
    _ud.applyPurchase(this.gacha_setting.getType(), _pay, false);

    setPanelParam({ "reward_items" = _ri, "gacha_id" = this.gacha_setting.getID(), "index" = this.index });

    local _tex = this.gacha_setting.getGachaLoadingBG();
    local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
    _trans.sleeptime = 1000;
    _trans.rePerformance(_performance.bindenv(this));
    show();

  }

  function _performance() {
    added();
  }

  function _retryLimitGacha() {
    local _price_info = this.gacha_setting.getLimitPriceInfo();
    local _state = this.gacha_setting.canExecuteLimitGacha();
    if (!_price_info) return;

    if (!this.gacha_setting) {
      _popImpossibleMessage(GachaSetting.STATE_OTHERS);
      return;
    }

    if (_state != GachaSetting.STATE_ENABLE) {
      _popImpossibleMessage(_state);
      return;
    }
    if (!_confirmPurchaseDialog(_price_info, _price_info.type, _state)) return;

    local _ret = ::gamesession.executeLimitGacha(this.gacha_setting.getID());
    if (!_ret || !_ret.ri || _ret.ri.len() < 1) return;

    local _ud = ::gamesession.getUserData();

    if (this.gacha_setting.getLimitGachaLimit() >= 0) {
      if (this.gacha_setting.getLimitGachaDaily() == 1) _ud.addDailyGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion(), _ret.st);
      else _ud.addLimitGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion());
    }

    _ud.addRewardItems(_ret.ri);

    local _pay = this.gacha_setting.getLimitGachaPrice();
    _ud.applyPurchase(this.gacha_setting.getLimitGachaType(), _pay, false);

    setPanelParam({ "reward_items" = _ret.ri, "gacha_id" = this.gacha_setting.getID(), "limit" = 1 });

    local _tex = this.gacha_setting.getGachaLoadingBG();
    local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
    _trans.sleeptime = 1000;
    _trans.rePerformance(_performance.bindenv(this));
    show();

  }

  function _retryStepGacha() {
    local _price_info = this.gacha_setting.getStepPriceInfoFromUserData();
    local _state = this.gacha_setting.canExecuteStepGacha();
    if (!_price_info) return;

    if (!this.gacha_setting) {
      _popImpossibleMessage(GachaSetting.STATE_OTHERS);
      return;
    }

    if (_state != GachaSetting.STATE_ENABLE) {
      _popImpossibleMessage(_state);
      return;
    }
    if (!_confirmPurchaseDialog(_price_info, _price_info.type, _state)) return;

    local _ret = ::gamesession.executeStepGacha(this.gacha_setting.getID());
    if (!_ret || !_ret.ri || _ret.ri.len() < 1) return;

    local _ud = ::gamesession.getUserData();

    _ud.addRewardItems(_ret.ri);

    _ud.applyPurchase(_price_info.type, _price_info.price, false);

    _ud.addStepGachaCount(this.gacha_setting.getID(), this.gacha_setting.getGachaVersion(), _ret.st);

    setPanelParam({ "reward_items" = _ret.ri, "gacha_id" = this.gacha_setting.getID(), "step" = 1 });

    local _tex = this.gacha_setting.getGachaLoadingBG();
    local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
    _trans.sleeptime = 1000;
    _trans.rePerformance(_performance.bindenv(this));
    show();
  }

  function _popImpossibleMessage(code) {
    local _text = "";
    switch (code) {
    case GachaSetting.STATE_POVERTY:
      _text = ::dict.get("gacha_poverty");
      break;
    case GachaSetting.STATE_PERIOD_OUTSIDE:
      _text = ::dict.get("gacha_period_outside");
      break;
    case GachaSetting.STATE_LIMIT:
      _text = ::dict.get("gacha_limit");
      break;
    case GachaSetting.STATE_OTHERS:
      _text = ::dict.get("gacha_error");
      break;
    }

    ::gamesession.messagelayer.closeAllMessage();
    local _message = ::Message();
    _message.setMsec(1500);
    _message.setText(_text);
    _message.setFontSize(32);
    _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
    _message.show();
  }

  function actionevent_retry(e) {
    e.consume();

    if (this.step_flag == 1) _retryStepGacha();
    else if (this.limit_flag == 1) _retryLimitGacha();
    else _retryGacha();
  }
  function actionevent_back(e) {
    e.consume();

    if (this.costume_ids.len() > 0) {

      local _ud = ::gamesession.getUserData();

      local _reside_id_table = ::gamesetting.getCharaCostumeTable(_ud.getCurrentRoomResideCharas());

      local _change_id_table = ::gamesetting.getCharaCostumeTable(this.costume_ids);

      local _remove_costumes = [];
      local _add_costumes = [];
      local _udl = ::gamesession.getUserDataLocal();

      foreach (chara_id, cos_id in _change_id_table) {
        if (!_reside_id_table[chara_id]) continue;
        _remove_costumes + _reside_id_table[chara_id];
        _add_costumes + cos_id;
        _udl.deleteNewItem(ITEM_TYPE_COSTUME, cos_id);
      }

      _udl.save();
      getHomeUI().updateMenuNewMark(::HomeUI.UPDATE_MENU_MARK_COSTUME);

      _ud.changeResideChara(_ud.getCurrentRoomIndex(), _remove_costumes, _add_costumes);
      local _scene = ::gamesession.getCurrentScene();
      if (_scene instanceof ::SanrioGameScene) {
        foreach (rcid in _remove_costumes) {
          local _pm = _scene.getProductionManager();
          local _pd = _pm.getProductDataByCostumeID(rcid);
          if (_pd) {
            _pm.cancelProduct(_pd.getProducerID(), false, false);
          }
        }
      }

      local _tex = runsk("/dl/loadingbg/download.sk");
      local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
      _trans.sleeptime = 1000;
      getHomeUI().movePanel(::NewCostumeEventPanel, false, { costume_ids = this.costume_ids }, _trans);
    }
    else {

      getHomeUI().movePanel(::GachaPanel, false, { "gid" = this.gacha_setting.getID() });
    }
  }

}

class GachaResultPanel.ItemCard extends SKView {
  view = null;

  reward_item = null;

  desc_showing = null;

  constructor(r, is_large = false) {
    this.reward_item = r;

    this.view = ::loadSKView(is_large ? "/ui/common/GachaResultCardBig.ui" : "/ui/common/GachaResultCard.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    local _btn_reward = this.view.findChild("btn_reward");
    local _img_gm = _btn_reward.findChild("img_gm");
    local _pnl_rm = _btn_reward.findChild("pnl_rm");
    local _pnl_icon = _btn_reward.findChild("pnl_icon");
    local _img_new = this.view.findChild("img_new");
    local _pnl_bg_rarity = _btn_reward.findChild("pnl_bg_rarity");
    local _pnl_rarity = this.view.findChild("pnl_rarity");

    local _icon;
    local _sp;
    _img_gm.visible = false;
    _pnl_rm.visible = false;
    _img_new.visible = r.newer_obtained;

    local _rank = r["rank"] || 1;
    local _image_view = ::SKImageView();
    _image_view.setSprite(::Setting.getRarityFrame(_rank, is_large));
    _image_view.setRect(0.0, 0.0, _pnl_bg_rarity.bnd.w, _pnl_bg_rarity.bnd.h);
    _pnl_bg_rarity.addChild(_image_view);

    desc_showing = false;

    switch (r.kind) {
    case ITEM_TYPE_FREERM:
      _pnl_rm.visible = true;
      break;

    case ITEM_TYPE_GM:
      _img_gm.visible = true;
      break;

    case ITEM_TYPE_COSTUME:
      _icon = ::SKImageView();
      _icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
      _pnl_icon.addChild(_icon);
      CostumeIcon(r.id, _icon, false, false);
      break;

    case ITEM_TYPE_FURNITURE:

      local _fs = ::gamesetting.furniture_settings[r.id];
      if (!_fs) return;
      _sp = Sprite(::getTexture("/image/icon/furniture/" + r.id + "_" + (_fs.getViewLength() - 1) + ".png"));
      _sp.blend = SK_MIX;
      _icon = SKImageView(_sp);
      _icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
      _pnl_icon.addChild(_icon);
      break;

    case ITEM_TYPE_ROOM:

      break;

    case ITEM_TYPE_ITEM:

      break;

    case ITEM_TYPE_MOTION:

      break;
    }
  }

  function setEvent() {
    local _btn_reward = this.view.findChild("btn_reward");
    ::TapButton(_btn_reward).view.addEventListener(ACTION_EVENT, actionevent_desc);
  }

  function actionevent_desc(e) {
    if (desc_showing) return;
    desc_showing = true;
    local _dlg = RewardDialog();

    _dlg.setReward(this.reward_item.kind, this.reward_item.id, this.reward_item.num);
    _dlg.show();

    desc_showing = false;
  }
}