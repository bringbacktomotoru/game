class ARModuleIOS extends ARModule {

  module = null;
  image = null;
  img_rotation = null;

  result = null;
  capturing = null;

  create_movie_thumbnail = false;
  movie_thumbnail_small = null;

  needSetStillImageSize = true;

  constructor() {
    super();
    module = ARKit.ARModule();
    module.init();
    capturing = false;

    this.zoom = 1.0;
  }

  function removed() {
    super.removed();
    module.stop();
    module = null;
    image = null;
  }

  function create() {
    module.start();

    still_image_size = [1920, 1080];
  }

  function adjustPose(_landmark) {

    local _tmppos = Vector3D();
    local _tmprot = Quaternion();
    return [_tmppos, _tmprot];
  }

  function modifyCoodinateSystem(tmppos) {

    return Vector3D(tmppos.x, tmppos.y, tmppos.z) * 10;
  }

  function changeCamera() {

    first_result = true;
    is_thread_working = false;

    use_front_camera = !use_front_camera;

  }

  function restartCameraDevice(video_state = -1) {

  }

  function changeARMode(is_capture, capture_state) {
    is_armode = !is_armode;

  }

  function saveImage(model_viewer, panel) {
    if (isThreadRunning(save_image_thread)) return true;

    if (!(image && capturing)) return false;

    if (this.needSetStillImageSize) {
      this.still_image_size = [image.getWidth(), image.getHeight()];
      this.needSetStillImageSize = false;
    }
    this.rendering_image = true;
    save_image_thread.start(processCaptureImage.bindenv(this), this, image, model_viewer, panel.displayPicture.bindenv(panel));
    panel.setShot(false);
    return true;
  }

  function saveFrame(model_viewer, is_capture) {
    local _state = super.saveFrame(model_viewer, is_capture);
    if (_state != STATE_RECORDING) return _state;

    local _capture_num = int(60.0 / movie_writer.fps);
    if (update_frame_counter == 0) {
      local _frame_resource = createMovieFrame(first_frame, model_viewer);
      if (_frame_resource) {
        movie_writer.setFrameResource(_frame_resource);

        if (first_frame) {
          this.current_frame = this.begin_frame = skGetTime();
          this.create_movie_thumbnail = true;
        }
        else {
          try {
            movie_writer.process();
          }
          catch (ex) {
            printexception(ex);
            movie_writer = null;
            return STATE_RECORD_INVALID;
          }
        }
      }
      first_frame = false;
    }
    update_frame_counter = (update_frame_counter + 1) % _capture_num;
    return STATE_RECORDING;
  }

  function createMovieFrame(first_frame, model_viewer) {
    if (!this.image || this.img_rotation == null) return null;

    local _img_rotation = this.img_rotation;
    if (first_frame) {
      frame_image_view.pos.set(0, 0, 0);
      frame_image_view.rot.set(0, 0, 0);

      local _param = {
        image = this.image,
        imageview = frame_image_view,
        img_rotation = _img_rotation,
        enable_trimtex = true,
        is_read_texture = false,
      };

      local _imgW, _imgH;
      if (_img_rotation == 90 || _img_rotation == 270) {
        _imgW = this.image.getHeight();
        _imgH = this.image.getWidth();
      }
      else {
        _imgW = this.image.getWidth();
        _imgH = this.image.getHeight();
      }
      _param.render_width <- _imgW;
      _param.render_height <- _imgH;

      local _sprite = pasteImageViewer(_param);
      this.frame_image_view.setRect(0, 0, this.image.getWidth(), this.image.getHeight());

      _img_rotation = calcCurrentDeviceDirection();

      model_viewer.setImageViewerPos(Vector3D(0.0, 0.0, 0.0));
      model_viewer.setImageViewerRot(Vector3D(0.0, 0.0, 0.0));
      this.capture_view.setRect(0, 0, _imgW, _imgH);
      model_viewer.updateImageRect(Rect2D(0, 0, _imgW, _imgH));
      model_viewer.updateSceneBound();
      this.capture_view.repaint();

      this.frame_image_view.matdirty = true;
      this.frame_image_view.setSprite(_sprite);

      deviceRotateView(this.capture_view, this.frame_image_view);
      this.frame_image_view.updateLayout();
    }

    this.frame_image_view.sp.tex0 = sprite_frame.tex0;
    this.frame_image_view.sp.tex1 = sprite_frame.tex1;
    this.frame_image_view.sp.uvmat0 = sprite_frame.uvmat0;
    this.frame_image_view.sp.uvmat1 = sprite_frame.uvmat1;

    this.capture_view.updateMatrixAll();

    return _createFrameResource(capture_view, model_viewer);
  }

  function _createFrameResource(capture_view, model_viewer) {
    model_viewer.updateARImageParam(this.result, this.is_armode, false);
    model_viewer.flushTalkWindowPosition();

    local _bufflags = 3;
    if (!this.load_texture) {
      this.load_texture = Texture();
      this.load_texture.create(capture_view.bnd.w, capture_view.bnd.h, SK_RGBA, _bufflags, 0);
    }

    local _sp = null;
    _sp = Sprite(this.load_texture);
    _sp.blend = SK_OFF;

    skSetViewport();

    local _ret_resource = this.load_texture.id;

    if (!_renderTexture(capture_view, _sp, _bufflags, 1.0)) {
      _ret_resource = null;
    }
    else if (this.create_movie_thumbnail) {

      local _rgbas = [];
      local _rt = skGetRenderTarget();
      skSetRenderTarget(this.load_texture);
      _rgbas + _readPixels(capture_view);

      local _thumbnail_scale = 0.3;
      local _thumbnail_texture = Texture();
      _thumbnail_texture.create(
      capture_view.bnd.w * _thumbnail_scale,
      capture_view.bnd.h * _thumbnail_scale,
      SK_RGBA,
      _bufflags,
      0
      );
      this.movie_thumbnail_small = _thumbnail_texture;

      _sp = Sprite(_thumbnail_texture);
      _sp.blend = SK_OFF;
      if (_renderTexture(capture_view, _sp, _bufflags, _thumbnail_scale)) {

        skSetRenderTarget(_thumbnail_texture);
        _rgbas + _readPixels(capture_view, _thumbnail_scale);
      }
      skSetRenderTarget(_rt);

      _createMovieThumbnail(_rgbas);

      this.create_movie_thumbnail = false;
    }

    if (_ret_resource) {
      local _rt = skGetRenderTarget();
      skSetRenderTarget(this.load_texture);
      _ret_resource = _readPixels(capture_view);
      skSetRenderTarget(_rt);
    }
    return _ret_resource;
  }

  function _createMovieThumbnail(rgbas) {
    this.rendering_image = false;
    local _thumb_path = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_THUMBNAIL, ::FilePathManager.APPLICATION_MODE_NONE);
    if (!_thumb_path) {
      println("can not getFilepath.");
      return;
    }

    local _out_l_thumb = FileRef(_thumb_path + cache_counter + "_m_l_thumb.jpg");
    local _out_s_thumb = FileRef(_thumb_path + cache_counter + "_m_s_thumb.jpg");
    local _env = {
      _rgba_l = rgbas[0];
      _rgba_s = rgbas[1];
      _out_l = _out_l_thumb;
      _out_s = _out_s_thumb;
    }

    try {
      local _worker_id = workerthread.eval(

      "local jpg_image = vargv[0]._rgba_l.encodeJpeg( 90); " +
      "jpg_image.pos = 0; " +
      "vargv[0]._out_l.save( jpg_image); " +
      "jpg_image = vargv[0]._rgba_s.encodeJpeg( 90); " +
      "jpg_image.pos = 0; " +
      "vargv[0]._out_s.save( jpg_image); " +
      "return skGetWorkerID(); ", _env);
    }
    catch (ex) {
      printexception(ex);
    }

    this.cache_counter++;
  }

  function calcCurrentDeviceDirection() {
    local orient = 0;
    if (accel_vec.length() < 0.01) return -1;

    return orient;
  }

  function processCaptureImage(still_image, model_viewer, displayFunc) {

    module.shutterSE();

    local _capture_view = CaptureView();
    _capture_view.matdirty = true;

    local _image_view = SKImageView();
    _image_view.setRect(0, 0, still_image.getWidth(), still_image.getHeight());
    _image_view.setColor(0xffffffff);

    model_viewer.setImageBackView(_image_view);
    model_viewer.addedImageViewer(_capture_view);
    model_viewer.registerDir(calcCurrentDeviceDirection());

    local _img_rotation = image.getImageDir();
    local _sprite = null;
    local _param = {
      image = still_image,
      imageview = _image_view,
      img_rotation = img_rotation,
      enable_trimtex = true,
      is_read_texture = false,
    };

    if (_img_rotation == 90 || _img_rotation == 270) {
      _param.render_width <- still_image.getHeight();
      _param.render_height <- still_image.getWidth();
    }
    else {
      _param.render_width <- still_image.getWidth();
      _param.render_height <- still_image.getHeight();
    }
    _sprite = pasteImageViewer(_param);
    _image_view.setSprite(_sprite);

    model_viewer.rebuildTalk(true);

    _img_rotation = calcCurrentDeviceDirection();

    model_viewer.imageViewerMatdirty();

    local _w = still_image.getWidth();
    local _h = still_image.getHeight();
    if (_img_rotation == 90 || _img_rotation == 270) {
      local _tmp = _w;
      _w = _h;
      _h = _tmp;
    }
    _capture_view.setRect(0, 0, _w, _h);
    model_viewer.updateImageRect(Rect2D(0, 0, _w, _h));
    local _rect = model_viewer.getImageRect();
    model_viewer.setImageViewerPos(Vector3D(
    (_capture_view.bnd.w - _rect.w) / 2.0,
    (_capture_view.bnd.h - _rect.h) / 2.0,
    0.0
    ));

    model_viewer.updateSceneBound();

    deviceRotateView(_capture_view, _image_view);

    _image_view.updateLayout();
    model_viewer.updateARImageParam(result, is_armode, false, _img_rotation);

    for (local i = 0; i < 1; i++) {
      model_viewer.image_sk3dview.updateScene(0);
    }
    _image_view.matdirty = true;

    local _small_bal = ::loadSKView("/ui/Balloon.ui");
    local _big_bal = ::loadSKView("/ui/Balloon_Big.ui");
    local _big_size = still_image.getWidth() * _small_bal.bnd.w / screenWidth;

    local sc = _big_size / _big_bal.bnd.w;

    model_viewer.flushTalkWindowScale(sc);
    model_viewer.flushTalkWindowPosition();
    model_viewer.flushTalkWindowRotation(false, true);

    _capture_view.updateMatrixAll();

    suspend();

    local _bufflags = 3;
    local _load_texture = Texture();
    _load_texture.create(_capture_view.bnd.w, _capture_view.bnd.h, SK_RGBA, _bufflags, 0);
    local _sp = Sprite(_load_texture);
    local _rgbas = [];
    local _rt = skGetRenderTarget();
    if (_renderTexture(_capture_view, _sp, _bufflags)) {

      skSetRenderTarget(_load_texture);
      _rgbas + _readPixels(_capture_view);
    }

    local _thumbnail_scale = 0.1;
    local _thumbnail_texture = Texture();
    _thumbnail_texture.create(
    _capture_view.bnd.w * _thumbnail_scale,
    _capture_view.bnd.h * _thumbnail_scale,
    SK_RGBA,
    _bufflags,
    0
    );
    _sp = Sprite(_thumbnail_texture);
    _sp.blend = SK_OFF;
    if (_renderTexture(_capture_view, _sp, _bufflags, _thumbnail_scale)) {

      skSetRenderTarget(_thumbnail_texture);
      _rgbas + _readPixels(_capture_view, _thumbnail_scale);
    }

    skSetRenderTarget(_rt);
    if (_rgbas) {
      _saveToImage(_rgbas);
      displayFunc(_load_texture, _thumbnail_texture, cache_counter);
    }

    model_viewer.removeImageViewer();
    model_viewer.setImageViewerPos(Vector3D());
    model_viewer.setImageViewerRot(Vector3D());

    model_viewer.getImageTalkWindow().removeAllTalkWindow();
    skCollectGarbage();

    capturing = false;
  }

  function _saveToImage(_rgbas) {
    this.rendering_image = false;
    local _cache_path = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_CACHE_IMAGE, ::FilePathManager.APPLICATION_MODE_NONE);
    local _thumb_path = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_THUMBNAIL, ::FilePathManager.APPLICATION_MODE_NONE);
    if (!_cache_path || !_thumb_path) {
      println("can not getFilepath.");
      return;
    }

    local _out_cache = FileRef(_cache_path + cache_counter + ".jpg");
    local _out_thumb = FileRef(_thumb_path + cache_counter + "_thumb.jpg");

    local _env = {
      _rgba_cache = _rgbas[0];
      _rgba_thumb = _rgbas[1];
      _out_cache = _out_cache;
      _out_thumb = _out_thumb;
    }

    try {
      local _worker_id = workerthread.eval(

      "local jpg_image = vargv[0]._rgba_cache.encodeJpeg( 90); " +
      "jpg_image.pos = 0; " +
      "vargv[0]._out_cache.save( jpg_image); " +
      "jpg_image = vargv[0]._rgba_thumb.encodeJpeg( 90); " +
      "jpg_image.pos = 0; " +
      "vargv[0]._out_thumb.save( jpg_image); " +
      "return skGetWorkerID(); ", _env);
    }
    catch (ex) {
      printexception(ex);
    }

    this.cache_counter++;
  }

  function modifyExposure() {

  }

  function getResult() {
    this.image = module.getImage();

    if (image) {
      this.img_rotation = image.getImageDir();
    }

    local _results = [];
    local _result = module.getResult();
    this.result = _result;

    if (result) {
      _results + clone _result;
    }

    this.landmarks = module.getLandmarks();
    this.landmarks_adjust = false;

    return _results;
  }

  function pasteImage(image_viewer, model_viewer, half_view) {
    if (!image) return;

    local _param = {
      image = image,
      imageview = image_viewer,
      img_rotation = img_rotation,
      render_width = ::screenWidth,
      render_height = ::screenHeight,
      sprite_frame = sprite_frame,
      is_read_texture = false
    };
    sprite_frame = pasteImageViewer(_param);

    image_viewer.setRect(0, 0, ::screenWidth, ::screenHeight);

    model_viewer.updateRect(Rect2D(0, 0, ::screenWidth, ::screenHeight));
    model_viewer.setRect(0, 0, ::screenWidth, ::screenHeight);

    model_viewer.pos.x = half_view.w - model_viewer.rect.w / 2.0;
    model_viewer.pos.y = half_view.h - model_viewer.rect.h / 2.0;

    switch (img_rotation) {
    case 0:
      local _w = half_view.w - model_viewer.rect.w / 2.0;
      image_viewer.rot.set(0.0, 0.0, 0.0);
      image_viewer.pos.set(_w, half_view.h - image_viewer.bnd.h / 2.0, 0);
      break;
    case 90:
      local _h = half_view.h - model_viewer.rect.h / 2.0;
      image_viewer.pos.set(image_viewer.bnd.w / 2.0 + half_view.h, _h, 0);
      break;
    case 180:
      local _w = image_viewer.bnd.w - (image_viewer.bnd.w / 2.0 - half_view.w);
      image_viewer.rot.set(0, 0, sarSmartar.SAR_ROTATION_180 * Math.DTOR);
      image_viewer.pos.set(_w, half_view.h + image_viewer.bnd.h / 2.0, 0);
      break;
    case 270:
      local _h = image_viewer.bnd.h - (image_viewer.bnd.h / 2.0 - half_view.h);
      image_viewer.pos.set(half_view.h - image_viewer.bnd.w / 2.0, _h, 0);
      break;
    }

    image_viewer.matdirty = true;

    if (first_result) {
      local _b = sprite_frame.bnd;
      local _ib = image_viewer.bnd;
      image_viewer.setSprite(sprite_frame);
      println("pasteImage sprite_frame:" + _b.x + "/" + _b.y + "/" + _b.w + "/" + _b.h + " image_viewer:" + _ib.x + "/" + _ib.y + "/" + _ib.w + "/" + _ib.h);
    }

    image_viewer.updateLayout();

    first_result = false;
  }

  function startCaptureImage(accel_vec) {
    super.startCaptureImage(accel_vec);
    local _time = skGetTime();
    capturing = true;
  }

  function startRecordMovie(model_viewer, accel_vec) {
    super.startRecordMovie(model_viewer, accel_vec);

    local _filepath = null;

    if (!movie_writer) movie_writer = ARUtils.MovieWriter();

    local _cache_path = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_CACHE_IMAGE, ::FilePathManager.APPLICATION_MODE_NONE);
    if (!_cache_path) {
      println("can not getFilepath.");
      return false;
    }

    local _path = _cache_path + cache_counter + "." + movie_writer.getFileExtention();
    movie_writer.setFilePath(_path);

    this.capture_view.matdirty = true;

    frame_image_view.setRect(0, 0, image.getWidth(), image.getHeight());
    frame_image_view.setColor(0xffffffff);

    model_viewer.setImageBackView(frame_image_view);

    model_viewer.addedImageViewer(this.capture_view);
    model_viewer.registerDir(calcCurrentDeviceDirection());

    local _frame_resource = createMovieFrame(true, model_viewer);
    if (_frame_resource) {
      movie_writer.setFrameResource(_frame_resource);
      try {
        movie_writer.init();
      }
      catch (ex) {
        printexception(ex);

        local _msg = ::Message();
        _msg.setText(::dict.get("can_not_record"));
        _msg.setFontSize(32);
        _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0, 0);
        _msg.setColor(0xffffffff);
        _msg.stroke();
        _msg.show();
        model_viewer.removeImageViewer();
        return false;
      }
      movie_writer.start();
      update_frame_counter = 0;
      first_frame = true;
      return true;
    }
    return false;
  }

  function calcCameraMatrix(camera_pos, viewmat, flipY, targetMat) {
    local eye = null, f = null, u = null;
    if (img_rotation == null)
    return [Vector3D(0.0, 1.4, -8.0), Vector3D(0, 0.5, 0), Vector3D(0.0, 1.0, 0.0)];

    local _fixmat = Matrix().set(viewmat);
    local _tMat = Matrix().set(targetMat);

    _fixmat[14] *= -1.0;

    eye = Vector3D(_fixmat[12], _fixmat[13], _fixmat[14]);
    local _tPos = Vector3D(_tMat[12], _tMat[13], _tMat[14]);
    eye -= _tPos;
    eye *= coodinate_system_scale / 2.0;

    _fixmat[8] *= -1.0;
    _fixmat[9] *= -1.0;
    f = eye + (Vector3D(_fixmat[8], _fixmat[9], _fixmat[10]).normalize() * 2.0);

    _fixmat[6] *= -1.0;
    u = Vector3D(_fixmat[4], _fixmat[5], _fixmat[6]).normalize();

    return [eye, f, u];
  }

  function calcProjectionMatrix(result, width, height, camera_near, camera_far) {
    result.calcProjectionMatrix(module, width, height, camera_near, camera_far);
  }

  function reset() {
    module.reset();
  }

  function isFlipY() {
    return false;
  }

  function isSupported() {
    return module.isSupported();
  }

  function onResume() {

  }

  function onPause() {

  }

  function isRecognized(result) {
    return result ? result.isRecognized_ : false;
  }

  function isLowerVideoImage() {
    return true;
  }

  function calcRotationFromMagneticGravity(total_gyro_rot) {
    return null;
  }

  function getGravity() {
    return Vector3D();
  }

  function displayMovieThumbnail(func) {
    func(null, this.movie_thumbnail_small, this.cache_counter, true);
  }

  function setZoomRate(zoom) {

  }
}