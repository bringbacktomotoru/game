local linefeed = "\n"

::exception <- function(t = null) { ::logger.exception(t); }
::dumpStack <- function(t = null) { currentthread().printStackTrace(t) };

::error <- function(t) { ::logger.error(t); }
::errorln <- function(t) { ::logger.error(t + linefeed); }

::warn <- function(t) { ::logger.warn(t); }
::warnln <- function(t) { ::logger.warn(t + linefeed); }

::trace <- function(t) { ::logger.trace(t); }
::traceln <- function(t) { ::logger.trace(t + linefeed); }

::debug <- function(t) { ::logger.debug(t); }
::debugln <- function(t) { ::logger.debug(t + linefeed); }

::print <- function(t) { ::logger.print(t); }
::println <- function(t) { ::logger.print(t + linefeed); }

::logger <- class {
  static ERROR = 1;
  static WARNING = 2;
  static TRACE = 3;
  static DEBUG = 4;
  static PRINT = 5;
  level = null;

  constructor(lv) {
    this.level = lv;
  }

  function exception(txt) {
    throw Exception(txt);
  }

  function error(txt) {
    if (!_checkLevel(ERROR)) return;
    print("[ERROR] " + txt);
  }

  function warn(txt) {
    if (!_checkLevel(WARNING)) return;
    print("[WARN] " + txt);
  }

  function trace(txt) {
    if (!_checkLevel(TRACE)) return;
    print("[TRACE] " + txt);
  }

  function debug(txt) {
    if (!_checkLevel(DEBUG)) return;
    print("[DEBUG] " + txt);
  }

  function print(txt) {
    if (!_checkLevel(PRINT)) return;
    print("[PRINT] " + txt);
  }

  function _checkLevel(lv) {
    return lv <= this.level;
  }
}(4);

local createSendLog = function(log, message) {
  local send_log = "";

  if (message != "") send_log + message + "\n";
  send_log = send_log + log;

  return send_log;
}

local createExceptionLog = function(ex) {
  local log = "";

  local _threadstr = "" + ex.thread;
  _threadstr = separateWeakRefLog(_threadstr);
  if (ex.code) {
    log = log + sprintf("\"%S\" in \"%S\": %S(%d)\n", getclassname(ex), _threadstr, ex.message, ex.code);
  } else {
    log = log + sprintf("\"%S\" in %S: \"%S\"\n", getclassname(ex), _threadstr, ex.message);
  }

  foreach (info in ex.getStackInfo()) {
    log = log + sprintf("  at %S(%S:%d)\n", info[0], info[1], info[2]);
    local size = length(info);
    if (size > 0) {
      log = log + sprintf("    [")
      for (local i = 3; i < size; i += 2) {
        local name = info[i];
        local valstr = "" + info[i + 1];
        valstr = separateWeakRefLog(valstr);
        log = log + sprintf("%S=%S", name, valstr);
        if (i < size - 2) log = log + sprintf(", ")
      }
      log = log + sprintf(" ]\n")
    }
  }
  return log;
}

function separateWeakRefLog(str) {
  local _id = str.indexOf(":w");
  if (_id >= 0) {
    str = str.substring(0, _id);
  }
  return str;
}

::crientReportLogger <- class {
  max_report_num = -1;
  report_count = 0;

  constructor(max_report_num) {
    this.max_report_num = max_report_num;
  }

  function resetReportCount() {
    this.report_count = 0;
  }

  function canReport() {
    return this.report_count < this.max_report_num;
  }

  function sendClientReport(log, message = "") {
    if (!canReport()) return;

    this.report_count++;
    ::gamesession.sendReportToServer(createSendLog(log, message));
  }

  function sendClientReportAndMoveTitleScene(log, message = "") {
    if (!canReport()) return;

    this.report_count++;
    local ret = ::gamesession.sendReportToServer(createSendLog(log, message));
    if (ret[0].ret == ::ServletConstants.RESPONSE_SESSION_CLOSED) return;

    ::gamesession.changeTitleSceneByError(ex);
  }

  function sendClientExceptionReport(ex, message = "") {
    if (!canReport()) return;

    this.report_count++;
    local ret = ::gamesession.sendReportToServer(createSendLog(createExceptionLog(ex), message));
    if (!ret || ret[0].ret == ::ServletConstants.RESPONSE_SESSION_CLOSED) return;

    ::gamesession.changeTitleSceneByError(ex);
  }
}(1);

::sendLog <- function(log, message = "") {
  ::crientReportLogger.sendClientReport(log, message);
}

::sendLogAndMoveTitle <- function(log, message = "") {
  ::crientReportLogger.sendClientReportAndMoveTitleScene(log, message);
}

::sendException <- function(ex, message = "") {
  ::crientReportLogger.sendClientExceptionReport(ex, message);
}