class RewardItem extends SKView {

  view = null;
  img_icon = null;
  lbl_name = null;
  lbl_num = null;

  constructor(kind, id, num) {
    this.view = ::loadSKView("/ui/common/RewardItem.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    this.img_icon = this.view.findChild("img_icon");
    this.lbl_name = this.view.findChild("lbl_name");
    this.lbl_num = this.view.findChild("lbl_num");

    this.lbl_name.setText(::Setting.getItemName(kind, id, num));

    local _visiblenum = false;

    local _sp;
    switch (kind) {
    case ITEM_TYPE_FREERM:
      _sp = ::Setting.getRMIconSprite();
      break;
    case ITEM_TYPE_GM:
      _sp = ::Setting.getGMIconSprite();
      break;
    case ITEM_TYPE_COSTUME:
      local _cs = ::gamesetting.costume_settings[id];
      _sp = _cs.getSpriteCostumeIcon();
      break;
    case ITEM_TYPE_FURNITURE:
      local _fs = ::gamesetting.furniture_settings[id];
      _sp = _fs.getIconSpriteByIndex(0);
      _visiblenum = true;
      break;
    case ITEM_TYPE_ROOM:
      local _rs = ::gamesetting.room_settings[id];
      _sp = _rs.getIconSpriteUnacquired();
      break;
    case ITEM_TYPE_MOTION:
      local _ms = ::gamesetting.costume_motion_settings[id];
      _sp = _ms.getIconSprite();
      break;
    }
    this.img_icon.setSprite(_sp);
    this.img_icon.updateLayout();

    if (_visiblenum && num > 1) {
      this.lbl_num.setText(::dict.get("nums_num", [num]));
    } else {
      this.lbl_num.setVisible(false);
    }
  }
}

class LabelItem extends SKView {

  view = null;
  lbl_name = null;

  constructor(pmid) {
    this.view = ::loadSKView("/ui/common/RewardItem.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    this.lbl_name = this.view.findChild("lbl_name");

    this.view.findChild("img_icon").setVisible(false);
    this.view.findChild("lbl_num").setVisible(false);

    local _pms = ::gamesetting.panel_mission_settings[pmid];
    this.lbl_name.setText(_pms.getName());
  }
}