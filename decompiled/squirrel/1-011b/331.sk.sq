class DiaryRewardDialog extends ::Dialog {
  pmid = null;
  rewards = null;

  view = null;
  lbl_title = null;
  pnl_reward_list = null;
  pnl_newevent_list = null;

  constructor() {
    super(::loadSKView("/ui/dialog/DiaryRewardDialog.ui"));

    this.lbl_title = this.view.findChild("lbl_title");

    local _pnl_reward = this.view.findChild("pnl_reward");
    this.pnl_reward_list = _pnl_reward.findChild("pnl_reward_list");

    local _pnl_newevent = this.view.findChild("pnl_newevent");
    this.pnl_newevent_list = _pnl_newevent.findChild("pnl_newevent_list");

    _pnl_reward.findChild("lbl_reward").setText(::dict.get("get"));
    this.btn_close.findChild("lbl_close").setText(::dict.get("close"));
    _pnl_newevent.findChild("lbl_newevent").setText(::dict.get("add_new_panelmission"));
  }

  function setNewPanelMissionIds(pmids) {
    this.pnl_newevent_list.clearChildren();
    local _offset = 0;
    foreach (pmid in pmids) {
      local _lbl = LabelItem(pmid);
      this.pnl_newevent_list.addChild(_lbl);
      _lbl.pos.y = _offset;

      _offset += _lbl.view.bnd.h;
    }
  }

  function setData(pmid, rewards) {
    this.pmid = pmid;
    this.rewards = rewards;

    local _pms = ::gamesetting.panel_mission_settings[this.pmid];

    this.lbl_title.setText(::dict.get("completed_diary", [_pms.getName()]));

    this.pnl_reward_list.clearChildren();
    local _offset = 0;
    foreach (ri in rewards) {
      local _item = RewardItem(ri.kind, ri.id, ri.num);
      this.pnl_reward_list.addChild(_item);
      _item.pos.y = _offset;

      _offset += _item.view.bnd.h + 5;
    }
  }
}

