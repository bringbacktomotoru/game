  function loadFromCache() {

    if (!cachefile.exists()) {
      printf("GameSession.loadFromCache cachefile not exists\n");
      return null;
    }

    try {
      local bb = cachefile.load();
      local r = Random(6366058);
      r.crypt(bb);
      local udjson = decodeJSON(bb);
      local udtxt = udjson["data"];
      local ji = JSONInput(decodeJSON(udtxt));
      local ud = ji.readObject();
      ud.setup();

      userdata = ud;
      return userdata;
    } catch (ex) {
      printexception(ex);
      printf("GameSession.loadFromCache failure ...\n");
      return null;
    }
  }

