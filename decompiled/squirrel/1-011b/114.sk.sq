  function executeGacha(gid, idx) {
    local _param = [gid, idx];
    local _result = [];
    if (con) {
      local _cnt = 0;
      local _ret = con.commandToMain(::ServletConstants.MAIN_CMD_EXECUTE_GACHA, _param);
      if (_ret[0]["ret"] != ::ServletConstants.RESPONSE_SUCCEED) return null;

      local _reward = _ret[0]["reward" + _cnt];
      while (_reward) {
        local _item = { uid = -1, kind = -1, id = -1, num = -1, target_id = -1, rank = -1, newer_obtained = false };
        local _list = decodeJSON(_reward);
        _item.uid = _list[0];
        _item.kind = _list[1];
        _item.id = _list[2];
        _item.num = _list[3];
        _item.target_id = _list[4];
        _item.rank = _list[5];
        _result + _item;
        _cnt++;
        _reward = _ret[0]["reward" + _cnt];
      }
    } else {
      println("ERROR!!!! Connection failed. [executeGacha]");
    }
    return _result;
  }

