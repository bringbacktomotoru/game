  function unlockRoom(sid) {
    if (con) {
      local _ret = con.commandToMain(::ServletConstants.MAIN_CMD_UNLOCK_ROOM, sid);

      if (_ret[0]["ret"] == ::ServletConstants.RESPONSE_SUCCEED) {
        local _ss = ::gamesetting.shop_settings[sid];
        local _rid = _ss.getItemID();

        if (_rid >= 0) {
          _proc_add_room(_rid, _ret[0]);
        } else if ("room_ids" in _ret[0]) {
          _proc_add_rooms(_ret[0]);
        }
        return true;
      }
      if (_ret[0]["ret"] != ::ServletConstants.RESPONSE_SUCCEED) return false;
    } else {
      println("ERROR!!!! Connection failed. [unlockRoom]");
    }
    return true;
  }

  function _proc_add_room(rid, ret) {
    local _ud = getUserData();
    _ud.addRoom(rid);

    if ("new_panel_mission_ids" in ret) {
      local _ids = decodeJSON(ret["new_panel_mission_ids"]);
      _ud.addPanelMissionDatasAtServer(_ids);
    }
    if ("set_panel_mission_id" in ret) {
      local _pmid = ret["set_panel_mission_id"];
      _ud.setPanelMissionID(_pmid);
      local _scene = getCurrentScene();
      if (rid == _ud.getCurrentRoomUID() && _scene instanceof SanrioGameScene) {
        _scene.getPanelMissionManager().chagnePanelMission(_pmid);
      }
    }

    if ("furniture_layouts" in ret) {
      local _fls = decodeJSON(ret["furniture_layouts"]);
      foreach (obj in _fls) {
        local _fid = obj["id"];
        local _uid = obj["uid"];
        local _pos = decodeJSON(obj["pos"]);
        local _angle = obj["angle"];

        _ud.addFurniture(_fid, _uid, true, rid);
        local _red = _ud.getRoomEditData(rid);
        _red.addFurnitureAmount(_fid, _uid, true);
        local _fld = FurnitureLayoutData().create(_uid);
        _fld.setPosXYZ(_pos[0], _pos[1], _pos[2]);
        _fld.setAngle(_angle);
        _red.addFurniture(_fld);
        _red.calcTapHapiness(true);
      }
    }
  }

  function _proc_add_rooms(ret) {
    if (!("room_ids" in ret)) return;

    local room_ids = decodeJSON(ret["room_ids"]);
    local _ud = getUserData();
    foreach (rid in room_ids) {
      _ud.addRoom(rid);
    }

    if ("new_panel_mission_ids" in ret) {
      local _ids = decodeJSON(ret["new_panel_mission_ids"]);
      _ud.addPanelMissionDatasAtServer(_ids);
    }

    if ("set_panel_mission_ids" in ret) {
      local _ids = decodeJSON(ret["set_panel_mission_ids"]);
      foreach (id in _ids) {
        _ud.setPanelMissionID(id);
      }
    }

    if ("furniture_layouts" in ret) {
      local _fls = decodeJSON(ret["furniture_layouts"]);
      foreach (obj in _fls) {
        local _rid = obj["rid"];
        local _fid = obj["id"];
        local _uid = obj["uid"];
        local _pos = decodeJSON(obj["pos"]);
        local _angle = obj["angle"];

        _ud.addFurniture(_fid, _uid, true, _rid);
        local _red = _ud.getRoomEditData(_rid);
        _red.addFurnitureAmount(_fid, _uid, true);
        local _fld = FurnitureLayoutData().create(_uid);
        _fld.setPosXYZ(_pos[0], _pos[1], _pos[2]);
        _fld.setAngle(_angle);
        _red.addFurniture(_fld);
        _red.calcTapHapiness(true);
      }
    }
  }

  function rentalCostume(costume_id, rental_id, rental_price) {
    local _result = { tl = -1, st = -1 };
    local _param = [costume_id, rental_id, rental_price];
