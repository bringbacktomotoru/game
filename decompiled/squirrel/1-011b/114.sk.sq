  function checkAndAddNewResideChara() {
    local _ud = this.getUserData();
    local _rsd = _ud.getCurrentRoomSlotData();

    local _chara_ids = _rsd.getNeedAddResideCharaList();
    if (_chara_ids.len() == 0) return;

    local _scene = getCurrentScene();
    local _shop_check_mrg = _scene.getUI().getShopCheckManager();

    local _param = {};
    _param["room_index"] <- _ud.getCurrentRoomIndex();
    _param["chara_ids"] <- _chara_ids;

    if (con) {
      local _ret = con.commandToMain(::ServletConstants.MAIN_CMD_ADD_ROOM_CHARA, _param);
      _ret = _ret[0];
      if (_ret.ret == ::ServletConstants.RESPONSE_SUCCEED) {
        foreach (chara_id in _chara_ids) {
          local _chara_setting = ::gamesetting.sanrio_chara_settings[chara_id];
          local _cos_id = _chara_setting.getDefaultCostumeID();
          _rsd.addResideChara(_cos_id);
          _ud.addCostumeID(_cos_id, false);
        }

        return true;
      }
    } else {
      println("ERROR!!!! Connection failed. [checkAndAddNewResideChara]");
    }
    return false;
  }

