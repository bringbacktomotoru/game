  function receiveMailItem(mail_id) {
    if (!con) return null;

    local ud = getUserData();
    if (!ud.hasMailItem(mail_id)) return null;

    local param = mail_id;
    local ret = _sendMainServletAPI(::ServletConstants.MAIN_CMD_RECEIVE_MAIL_ITEM, param);
    if (ret.ret == ::ServletConstants.RESPONSE_SUCCEED) {
      local _list = decodeJSON(ret.reward);
      local _item = { uid = -1, kind = -1, id = -1, num = -1, target_id = -1, rank = -1, newer_obtained = false };
      _item.uid = _list[0];
      _item.kind = _list[1];
      _item.id = _list[2];
      _item.num = _list[3];
      _item.target_id = _list[4];

      ud.receiveMailItem(mail_id, _item);
    }

    return ret;
  }

  function receiveMailItems(start_idx, end_idx) {
    if (!con) return null;

    local ud = getUserData();

    local find = false;
    for (local idx = start_idx; idx <= end_idx; idx++) {
      if (!ud.hasMailItemByIdx(idx)) continue;

      find = true;
      break;
    }
    if (!find) return null;

    local param = { start_idx = start_idx, end_idx = end_idx };
    local ret = _sendMainServletAPI(::ServletConstants.MAIN_CMD_RECEIVE_ALL_MAIL_ITEM, param);
    if (ret.ret == ::ServletConstants.RESPONSE_SUCCEED) {

      local _rewards = [];
      foreach (idx, _str_reward in ret.rewards) {
        local _item = { uid = -1, kind = -1, id = -1, num = -1, target_id = -1, rank = -1, newer_obtained = false, idx = -1 };
        local _list = decodeJSON(_str_reward);
        _item.uid = _list[0];
        _item.kind = _list[1];
        _item.id = _list[2];
        _item.num = _list[3];
        _item.target_id = _list[4];
        _item.idx = _list[5];
        _rewards + _item;
      }

      ret.rewards = _rewards;
      ud.receiveMailItems(ret.rewards);
    }

    return ret;
  }

  function setMailReadFlag(mail_id) {
    if (!con) return null;

    local param = mail_id;
