  function finishWork(cos_id) {
    local _result = -1;
    if (con) {
      local _ret = con.commandToMain(::ServletConstants.MAIN_CMD_WORK_UPDATE, cos_id);
      if (_ret[0]["ret"] != ::ServletConstants.RESPONSE_SUCCEED && _ret[0]["ret"] != ::ServletConstants.RESPONSE_INCOMPLETE) return -1;

      _result = _ret[0]["remaining_time"];
    } else {
      println("ERROR!!!! Connection failed. [finishWork]");
    }
    return _result;
  }

  function completeWork(cos_id) {
    local _result = { wid = -1, rri = -1, rewards = [], cr_rewards = [], crd_info = {} };
    if (con) {
      local _ret = con.commandToMain(::ServletConstants.MAIN_CMD_WORK_COMPLETE, cos_id);
      if (_ret[0]["ret"] != ::ServletConstants.RESPONSE_SUCCEED) return null;

      _result.wid = _ret[0]["work_id"];
      _result.rri = _ret[0]["reward_index"];

      local _cnt = 0;
      local _ret_reward = _ret[0]["reward" + _cnt];
      while (_ret_reward) {
        local _item = { uid = -1, kind = -1, id = -1, num = -1, target_id = -1 };
        local _list = decodeJSON(_ret_reward);
        _item.uid = _list[0];
        _item.kind = _list[1];
        _item.id = _list[2];
        _item.num = _list[3];
        _item.target_id = _list[4];
        _result.rewards + _item;
        _cnt++;
        _ret_reward = _ret[0]["reward" + _cnt];
      }

    } else {
      println("ERROR!!!! Connection failed. [completeWork]");
    }
    return _result;
  }

  function cancelWork(cos_id) {
