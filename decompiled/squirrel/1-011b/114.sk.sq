  function newBorderSprite(x, y, w, h) {
    local sp = Sprite();

    sp.tex0 = ::getTexture("/image/outside_bar.png");
    sp.bnd.set(0, 0, w, h);
    sp.pos = Vector3D(x, y, 0.0);
    return sp;
  }

  function fitscreen(r, check = false) {
    local sc = skGetScreenSize([0, 0]);

    if (check && ::displayWidth == sc[0] && ::displayHeight == sc[1]) return;

    ::displayWidth <- sc[0];
    ::displayHeight <- sc[1];

    local _tmp_h = ::displayHeight * (float(::uiWidth) / ::displayWidth);
    if (_tmp_h >= ::viewHeight - 0.01) {

      ::screenHeight = _tmp_h;
    }
    else {

      ::screenWidth = ::displayWidth * (float(::viewHeight) / ::displayHeight);
    }

    root.setRect(0, 0, ::screenWidth, ::screenHeight);
    root.prjmat = Matrix.fromOrtho(0, ::displayWidth, ::displayHeight, 0, -20000, 20000);

    local sx = ::displayWidth / float(::screenWidth), sy = ::displayHeight / float(::screenHeight);
    if (sx > 1.01 || sx < 0.99 || sy > 1.01 || sy < 0.99) {
      local s = Math.min(sx, sy);
      root.scale(s, s, s);
    }

    local _wgap = ::screenWidth - ::uiWidth;
    local _hgap = ::screenHeight - ::viewHeight;
    if (_wgap > 0.01) {
      local _gh = _wgap / 2.0 + 1.0;
      root.bordersp = [
      newBorderSprite(0, 0, _gh, ::screenHeight),
      newBorderSprite(::screenWidth - _gh, 0, _gh, ::screenHeight)
      ];
    }
    else if (_hgap > 0.01) {
      local _gh = _hgap / 2.0 + 1.0;
      root.bordersp = [
      newBorderSprite(0, 0, ::screenWidth, _gh),
      newBorderSprite(0, ::screenHeight - _gh, ::screenWidth, _gh)
      ];
    }

    scenelayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    tapviewlayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    dialoglayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    dialoglayer.setup();
    tutoriallayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    messagelayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    processinglayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    backloglayer.setup();
  }

  function init(root) {
    this.root = root;
    root.addEventListener(APP_EVENT, appevent);

    ::registerIronSourceEvent();

    scenelayer = SKView();
    scenelayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    dialoglayer = DialogLayer();
    messagelayer = MessageLayer();

    tutoriallayer = TutorialLayer();
    tutoriallayer.pickable = false;

    backloglayer = BackLogLayer();

    processinglayer = ProcessingLayer(::loadSKView("/ui/ProcessingLayer.ui"));
    processinglayer.pickable = false;

    loadinglayer = LoadingView();
    loadinglayer.setRect(0, 0, ::screenWidth, ::screenHeight);
    loadinglayer.pickable = false;

    tapviewlayer = TapEffectView();

    root.addChild(scenelayer);
    root.addChild(backloglayer);
    root.addChild(dialoglayer);
    root.addChild(messagelayer);
    root.addChild(tutoriallayer);
    root.addChild(processinglayer);
    root.addChild(loadinglayer);
    root.addChild(tapviewlayer);

    talksystem = TalkSystem();
    talksystem.scriptdirs = [::getResource("/talk")];
    talksystem.viewdirs = [::getResource("/talk/img")];

    local uuidfile = _getUUIDFile();
    if (uuidfile.exists()) {
      uuid = uuidfile.load().asText();

    } else {
      uuid = skCreateUUID();
      local bb = ByteBuffer();
      bb.putText(uuid);
      bb.pos = 0;
      uuidfile.save(bb);

    }

    cachefile = FileRef(skGetCacheDir() + "/tmp");

    if (serverurl) {
      con = GameConnection(serverurl, uuid);
    }
  }

  function _getUUIDFile() {
    return FileRef(skGetDataDir() + "/.prof");
  }

  function appevent(e) {
    switch (e.id) {
    case QUIT_REQUESTED:
      goBackTitleScene(e);
      e.consume();
      break;
    case ACTIVESTATE_CHANGED:
      switch (e.keycode) {
      case AppActiveState.APPACTIVE_ACTIVE:

        skSetFrameFlag(1);
        this.rootupdate_lock = false;
        suspend();
        if (currentscene instanceof ::SanrioGameScene && con) {
          local ret = con.commandToMain(::ServletConstants.MAIN_CMD_SESSION_CHECK);
        }
        break;
      case AppActiveState.APPACTIVE_INACTIVE:

        break;
      case AppActiveState.APPACTIVE_BACKGROUND:
        skSetFrameFlag(0);
        this.rootupdate_lock = true;
        break;
      }
    case SCREEN_RESIZED:
      ::rootview.dorepaintall = true;
      ::rootview.renderViews();
      ::rootview.flipScreen();
      break;
    default:
      break;
    }
  }

  function goBackTitleScene(e) {
    if (currentscene && currentscene["quitRequested"]) {
      currentscene.quitRequested(e);
    } else {
      if (backdialog) {
        backdialog.ret = 0;
        backdialog.close();

        ::stopBGM();
        changePackageCheckScene();
      } else {

        local dlg = backdialog = ::SimpleDialog2();
        dlg.lbl_msg.setText(::dict.get("comfirm_title_message"));
        dlg.lbl_caution.setText(::dict.get("comfirm_title_caution"));
        dlg.show();
        backdialog = null;
        if (dlg.ret) {
          ::stopBGM();
          changePackageCheckScene();
        }
      }
    }
  }

  function start() {
    local time = skGetTime();

    while (!root.quit) {
      local t = skGetTime();
      local dt = t - time;

      if (this.rootupdate_lock) {

        root.updateEvents(dt);
        time = t;
        suspend();
        continue;
      }
      if (currentscene) currentscene.updateScene(dt);

      local updater = realref(this.session_updater_wref);
      if (updater) updater.update(dt);
      root.update(dt);
      time = t;
      suspend();
    }
  }

  function update() {
    local t = skGetTime();
    local dt = t - time;
    if (currentscene) currentscene.updateScene(dt);
    if (this.session_updater && this.currentscene instanceof ::SanrioGameScene) this.session_updater.update(dt);
    root.update(dt);
    time = t;
  }

  function changeScene(scn, trans = null) {
    if (this.tutoriallayer) this.tutoriallayer.hideAll();
    if (this.dialoglayer) this.dialoglayer.closeAllDialog();
    ::tutorial_manager.interruptTutorial();
    ::rootview.callInEventThread(changeSceneBody, this, scn, trans);

  }

  function changeSceneBody(scn, trans) {
    local old = currentscene;
    try {
      scn.setRect(0, 0, root.bnd.w, root.bnd.h);
      scn.setupScene();
      currentscene = scn;
    } catch (ex) {
      printexception(ex);
      print("changeScene setup failure " + scn + "\n");
      return false;
    }
    if (old) old.endScene();
    if (!trans) trans = ImmediateSceneTransition();
    trans.init(this, old, scn);
    trans.perform();
    return true;
  }

  function restartGame() {
  }

  function changePackageCheckScene() {
    userdata_local = getUserDataLocal();
    local _lang = userdata_local.getLanguage();
    if (!_lang && skGetOSName() != "Windows") {

      switch (skGetLanguage()) {
      case "ja":
        _lang = "JP";
        break;
      default:
        _lang = "EN";
      }
    }

    if (_lang) { ::READ_TRANS_FILE = _lang; }
    loadLocalizeFile();
    local pkgscene = PackageCheckScene();
    changeScene(pkgscene);
  }

  function changeDownloadScene(up) {
    local dlscene = PackageDownloadScene(up);
    changeScene(dlscene);
  }

  function loadLocalizeFile() {
    loadGameSetting(::getResource("/conf/gamesetting.conf"));
    if (::READ_TRANS_FILE.equals("JP")) {
      ::loadDictionary();
      ::loadTalk();
      ::gamesetting.runsk("/conf/reply_texts.conf");
    }
    else {

      local dir = ::getResource("/conf/localize/" + ::READ_TRANS_FILE + "/conf/trans");
      foreach (k, file in dir.getList()) {
        ::gamesetting.transRunsk(file.path);
      }

      loadDictionary("/conf/localize/" + ::READ_TRANS_FILE + "/res/dict/trans/dict.conf");

      loadTalk("/conf/localize/" + ::READ_TRANS_FILE + "/res/talk/trans/talk.conf");

      ::gamesetting.runsk("/conf/localize/" + ::READ_TRANS_FILE + "/res/reply_texts/trans/reply_texts.conf");

      ::gamesetting.validate();
    }
  }

  function changeTitleScene() {
    local titlescene = TitleScene();
    changeScene(titlescene, ColorFadeSceneTransition());
  }

  function changeTitleSceneByError(ex) {
    local dlg = ::loadSKView("/ui/dialog/Dialog_s.ui");
    dlg.findChild("lbl_text").setText(::dict.get("move_title_with_error"));
    dlg.findChild("lbl_ok").setText(::dict.get("ok"));
    ::Dialog(dlg).show();

    local titlescene = TitleScene();
    changeScene(titlescene, ColorFadeSceneTransition());
  }

  function changeOpeningScene() {
    local opening = OpeningScene();

    changeScene(opening, ColorFadeSceneTransition());
  }

  function changeCopyRightScene() {
    local copyright = CopyRightScene();
    changeScene(copyright, ColorFadeSceneTransition());
  }

  function changeOpningMovieScene() {
    local opmovie = OpeningMovieScene();
    changeScene(opmovie, ColorFadeSceneTransition());
  }

  function changeSanrioGameScene() {
    local game_scene = ::SanrioGameScene();
    game_scene.setStageID("grassland");

    local ui = runsk("/dl/loadingbg/stageload.sk");

    local trns = UISceneTransition(ui, ::getTexture("/image/rule/111.jpg"), 5.0, 50);
    trns.sleeptime = 2000;
    changeScene(game_scene, trns);

    local updater = UserSessionAutoUpdator();
    this.session_updater_wref = weakref(updater);
  }

  function showErrorDialog(txt, errid = null) {

    local d = loadCocos("/ui/dialog/ErrorDialog.json");
    local msg = d.findChild("lbl_message");
    msg.setText(txt);
    if (errid) {
      local eid = d.findChild("lbl_errorid");
      eid.setText(sprintf("エラーID : %d", errid));
      eid.visible = true;
    } else {
      local eid = d.findChild("lbl_errorid");
      eid.visible = false;
    }
    local dlg = Dialog(d);
    dlg.show();
  }

  function showConfirmDialog(txt, cau = null) {

    if (!cau) cau = "";
    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(txt);
    _dlg.lbl_caution.setText(cau);
    _dlg.show();

    return _dlg.ret;
  }

  function showSimpleConfirmDialog(txt, cau = null) {

    if (!cau) cau = "";
    local _dlg = ::SimpleDialog3();
    _dlg.lbl_msg.setText(txt);
    _dlg.lbl_caution.setText(cau);
    _dlg.show();
  }

  function showErrorRetryDialog(txt, cau = null) {

    if (!cau) cau = "";

    local dlg = ::SimpleDialog2();
    dlg.lbl_msg.setText(txt);
    dlg.lbl_caution.setText(cau);
    dlg.show();
    return dlg.ret;
  }

  function getReward(idx) {

    if (!con) {
      local d = loadCocos("/ui/dialog/SimpleDialog.json");
      local msg = d.findChild("lbl_message");
      msg.setText("エラーが発生しました。")

      local dlg = ::Dialog(d);
      dlg.show();
      return;
    }

    local reward = this.userdata.rewards[idx];
    if (!reward) {
      local d = loadCocos("/ui/dialog/SimpleDialog.json");
      local msg = d.findChild("lbl_message");
      msg.setText("エラーが発生しました。")

      local dlg = ::Dialog(d);
      dlg.show();
      return;
    }

    delete this.userdata.rewards[idx];
    foreach (d in reward.data) {
      _getItem(d);
    }

    local d = loadCocos("/ui/dialog/SimpleDialog.json");
    local msg = d.findChild("lbl_message");
    msg.setText("プレゼントを受け取りました！");

    savewait("get reward");

    local dlg = ::Dialog(d);
    dlg.show();
  }

  function getAllPresents() {

    if (!con) {
      local d = loadCocos("/ui/dialog/SimpleDialog.json");
      local msg = d.findChild("lbl_message");
      msg.setText("エラーが発生しました。")

      local dlg = ::Dialog(d);
      dlg.show();
      return;
    }

    foreach (present in userdata.presents) {
      foreach (data in present.data) {
        _getItem(data);
      }

      removei;
    }
    foreach (reward in userdata.rewards) {
      foreach (data in reward.data) {
        _getItem(data);
      }

      removei;
    }

    local d = loadCocos("/ui/dialog/SimpleDialog.json");
    local msg = d.findChild("lbl_message");
    msg.setText("プレゼントを受け取りました！");

    savewait("get reward");

    local dlg = ::Dialog(d);
    dlg.show();
  }

  function _getItem(data) {

    switch (data[0]) {
    case PRESENT_FREE_MONEY:
      userdata.rmoney += data[1];
      userdata.freerm += data[1];
      break;
    case PRESENT_GAME_MONEY:
      userdata.gmoney += data[1];
      break;
    case PRESENT_COSTUME:
      for (local i = 0; i < data[2]; i++) {
        local setting = ::gamesetting.costume_settings[data[1]];

        userdata.addCostumeData(data);
      }
    }
  }

  function showTalk(ks) {
    local stage = currentscene.stage;

    local talk = SanrioTalkView(talksystem, currentscene.stage);
    talk.setRect(0, 0, ::screenWidth, ::screenHeight);
    scenelayer.addChild(talk);

    talk.jumpscript("define.ks", null, true);
    talk.runscript();

    talk.jumpscript(ks, null, true);
    local talkthread = newthread();
    talkthread.start(
    function() {
      try {
        talk.runscript();
      } catch (ex) {
        printexception(ex);
      }
      talk.destructor();
    }, this);
  }

  function consumeLP(val) {
    if (userdata.lp < val) {
      local d = loadCocos("/ui/dialog/Simple2Dialog.json");
      d.findChild("lbl_message").setText("スタミナが足りません。回復しますか？")
      local dlg = Dialog(d);
      dlg.show();
      if (!dlg.ret) {
        return false;
      }
      else {
        if (!chargeLP()) return false;
      }
    }

    userdata.lp -= val;
    return true;
  }

  function chargeLP() {
    if (userdata.rmoney < LP_RECOVERY_PRICE) {
      showErrorDialog("ニジイロコバンが足りません。");
      return false;
    }

    local d = loadCocos("/ui/dialog/SimpleDialog.json");
    d.findChild("lbl_message").setText("スタミナを回復しました。")
    d.findChild("lbl").setText("確認")
    local dlg = Dialog(d);
    dlg.show();

    userdata.lp = userdata.status.maxlp;
    userdata.usermoney(LP_RECOVERY_PRICE);
    save("LPCharge");

    return true;
  }

  function initSessionUpdater() {
    local updater = realref(this.session_updater_wref);
    if (!updater) return;

    updater.init();
  }

  function rootUpdateLock() {
    return this.rootupdate_lock;
  }

  function clearBackLog() {
    this.backloglayer.clear();
  }

  function showBackLog() {
    this.backloglayer.updateLogs();
    this.backloglayer.visible = true;
  }

  function closeBackLog() {
    this.backloglayer.close();
  }

  function isShowingBackLog() {
    return this.backloglayer.visible;
  }

  function setBackLogCharacter(character_setting) {
    this.backloglayer.setCharacter(character_setting);
  }

  function addBackLog(text) {
    this.backloglayer.addlog(text);
  }

}

class GameRootView extends SKRootView
{
  border_visible = true;
  bordersp = null;
  wait_action_event = false;
  pressed_time = null;

  function renderView() {
    super.renderView();
    if (bordersp && border_visible) {
      skSetMatrix(SK_WORLD, mat);
      skDrawSprites(bordersp);
    }
  }

  function updateEvents(dt) {
    if (dispatchlock) {
      skPeekEvents(deliverEventLocked, this, ev);
    } else {
      skPeekEvents(deliverEvent, this, ev);
    }
    if (dt > 0) {

      if (!::gamesession.rootUpdateLock()) {
        executeInterval(dt);
      }
      eventthread.wakeup(dt);
    }
  }

  function eventloop(modalview) {

    for (;;) {
      local e = length(eventqueue) > 0 ? (delete eventqueue[0]) : null;
      dispatchlock = (e);
      if (!e) { suspend(); continue; }
      try {

        if (e.id == ACTION_PERFORMED) {
          wait_action_event = false;
        }
        if (e.src) e.src.processEvent(e);
      } catch (ex) {
        local _msg = "error in event loop...";
        printf(_msg + "\n");
        printexception(ex);
        sendException(ex, _msg);
      }
      dispatchlock = null;
      if (modalview && (modalview.getRoot() != this || !modalview.modal)) {
        break;
      }
    }
  }

  function deliverMouseEvent(e) {
    local eid = e.id;
    local mid = e.mouseid;
    local m = mouses[mid];
    local x = e.x, y = e.y;
    local v = v_1;
    local target = pick(x, y, true, v);
    local outofmodal = (v_1.z != 0.0);
    local mod = e.modifiers;

    if (skGetOSName() == "iOS") {
      switch (e.id) {
      case MOUSE_PRESSED:
        this.pressed_time = e.time;
        break;
      case MOUSE_RELEASED:
        if (e.time - this.pressed_time < 150) {
          if (m.dragview) {
            postEvent(Event().setMouseEvent(mid, m.dragview, MOUSE_CLICKED, x, y, mod, e.count, false));
          }
        }

        this.pressed_time = -1;
        break;
      }
    }

    super.deliverMouseEvent(e);

    switch (e.id) {
    case MOUSE_RELEASED:
      ::gamesession.getTapViewLayer().addTapEffect(e.x, e.y);
      break;
    }
  }

  function borderVisible(b) {
    border_visible = b;
  }
}

class BackLogLayer extends SKView {
  static SCROLL_END_SPACE = 0;

  view = null;

  pnl_list = null;
  reclist = null;
  scroll = null;
  scroll_bar = null;

  btn_close = null;
  backlog_data = null;
  log_len = null;
  character_setting = null;

  constructor() {
    super();

    this.view = ::loadSKView("/ui/BackLogPanel.ui");
    addChild(this.view);
    this.visible = false;
    this.btn_close = this.view.findChild("btn_close");
    TapButton(this.btn_close).region.addEventListener(ACTION_EVENT, _closeBackLog);
    this.pnl_list = this.view.findChild("pnl_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dxscale = 0.0;
    this.pnl_list.addChild(this.reclist);
    this.pnl_list.setBuffer(true);
    this.scroll_bar = ::ScrollBarV(this.view.findChild("pnl_scroll_bar"));
    this.backlog_data = [];
    this.log_len = 0;
    this.scroll.setScrollRect(this.reclist.bnd);
    this.scroll_bar.setup(this.scroll, this.pnl_list.bnd, true);
  }

  function setup() {
    setRect(0.0, 0.0, ::screenWidth, ::screenHeight, ::screenWidth / 2.0, ::screenHeight / 2.0);
    this.view.pos.x = ::screenWidth / 2;
    this.view.pos.y = ::screenHeight / 2;
    updateLayout();
  }

  function setCharacter(character_setting) {
    this.character_setting = character_setting;
  }

  function addlog(text) {
    backlog_data + { "chara_s" = this.character_setting, "text" = text };
    if (this.visible) updateLogs();
  }

  function clear() {
    backlog_data.clear();
    this.log_len = 0;
    this.reclist.clearChildren();
    this.reclist.setRect(0, 0, this.pnl_list.bnd.w, 0);
    this.scroll.setScrollRect(this.reclist.bnd);
    this.scroll_bar.setup(this.scroll, this.pnl_list.bnd, true);

  }

  function updateLogs() {
    local _len = backlog_data.len()
    local _sub = _len - log_len;
    if (_sub <= 0) return;
    local _offset = 0;
    local _size_y = 0;

    local _i = 0;
    for (; _i < _sub; _i++) {
      local _log = this.log_len;
      local _li = ListItem(backlog_data[_log]["chara_s"], backlog_data[_log]["text"]);
      _offset = _li.bnd.h
      _li.pos.y = this.log_len * _offset;
      this.reclist.addChild(_li);
      this.log_len++;
    }

    _offset = this.log_len * _offset + SCROLL_END_SPACE;
    this.reclist.setRect(0, 0, this.pnl_list.bnd.w, _offset);
    this.scroll.setScrollRect(this.reclist.bnd);
    this.scroll_bar.setup(this.scroll, this.pnl_list.bnd, true);
    local _scrool_end = this.pnl_list.bnd.h - this.reclist.bnd.h;

    if (_scrool_end < 0) {
      this.scroll.moveTo(0, _scrool_end, 0);
    }
  }

  function close() {
    this.visible = false;
  }

  function _closeBackLog(e) {
    close();
  }
}

class BackLogLayer.ListItem extends SKView {
  view = null;
  pnl_chara_icon = null;

  constructor(chara_s, text) {
    this.view = ::loadSKView("/ui/common/BackLogCard.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    this.pnl_chara_icon = this.view.findChild("pnl_character_icon");
    local _size = this.pnl_chara_icon.bnd.h;
    local _sp = chara_s.getIconSprite();
    _sp.bnd.set(0, 0, _size, _size);
    local _img_motion = ::SKImageView(_sp);
    this.pnl_chara_icon.addChild(_img_motion);
    _img_motion.pos.x = 0;
    _img_motion.matdirty = true;

    local _btn = this.view.findChild("btn");
    local _lbl_text = _btn.findChild("lbl_text");
    _lbl_text.setText(text);
  }
}

class DialogLayer extends SKView {
  img_bg = null;

  interval_id = -1;
  dialog_list = null;

  common_view = null;
  pnl_money = null;
  lbl_gm = null;
  lbl_rm = null;
  btn_close = null;

  state = 0;

  constructor() {
    super();

    bnd.set(0, 0, ::screenWidth, ::screenHeight);
    pickable = false;

    local sp = Sprite(::getTexture("/image/bg_dialog.png"));
    sp.blend = SK_MIX;
    this.img_bg = SKImageView(sp);
    this.img_bg.bnd.set(bnd);
    this.img_bg.updateLayout();
    this.img_bg.pickable = false;
    this.img_bg.enabled = true;
    this.img_bg.addEventListener(MOUSE_EVENT, mouseevent_bg);
    this.img_bg.setColor(0xffffff00);
    addChild(this.img_bg);

    dialog_list = [];

    this.common_view = ::loadSKView("/ui/DialogLayer.ui");
    this.common_view.setRect(0, 0, bnd.w, bnd.h);
    this.common_view.pickable = false;

    this.pnl_money = this.common_view.findChild("pnl_topinfo");
    this.lbl_gm = this.pnl_money.findChild("lbl_gm");
    local btn_gm = this.pnl_money.findChild("btn_gm_buy");
    ::TapButton(btn_gm).view.addEventListener(ACTION_EVENT, actionevent_buy_gm);
    this.lbl_rm = this.pnl_money.findChild("lbl_rm");

    this.btn_close = this.common_view.findChild("btn_close");
    ::TapButton(this.btn_close).view.addEventListener(ACTION_EVENT, actionevent_close);
  }

  function setup() {
    this.img_bg.bnd.set(bnd);
    this.common_view.setRect(0, 0, bnd.w, bnd.h);
    updateLayout();
    this.img_bg.updateLayout();
    this.common_view.updateLayout();
  }

  function showDialog(dlg, fade = true, delay = 0) {
    this.dialog_list + dlg;
    local dlg_view = dlg.view;

    if (delay > 0) {
      pickable = true;
      sleep(delay);
      pickable = false;
    }

    removeChild(img_bg);
    if (interval_id != -1) {
      clearInterval(interval_id);
      this.interval_id = -1;
    }

    if (this.common_view.parent) this.common_view.removeFromParent();

    if (state == 0) {
      this.img_bg.setColor(0xffffff00);
      if (fade) {
        _fadeBG(0);
        state = 1;
      }
      else {
        state = 0;
      }
    }
    else {
      this.img_bg.setColor(0xffffffff);
      if (!fade) {
        _fadeBG(2);
        state = 0;
      }
      else {
        state = 1;
      }
    }
    addChild(img_bg);
    updateCommonView(dlg);

    addChild(dlg_view);
    addChild(this.common_view);
  }

  function _fadeBG(fs) {
    local env = {
      self = this,
      time = 0
    }
    switch (fs) {
    case 0:
      this.interval_id = setInterval(fadeinBG.bindenv(env), 16);
      break;
    case 1:
      this.interval_id = setInterval(fadeoutBG.bindenv(env), 16);
      break;
    case 2:
      this.interval_id = setInterval(fadeoutBGNoRemove.bindenv(env), 16);
      break;
    }
  }

  function closeDialog(dlg) {
    foreach (idx, d in this.dialog_list) {
      if (dlg == d) {
        delete this.dialog_list[idx];
        break;
      }
    }

    if (this.common_view.parent) this.common_view.removeFromParent();

    local dlg_view = dlg.view;
    removeChild(dlg_view);

    if (length(children) > 2) {
      removeChild(img_bg);
      insertChild(length(children) - 2, img_bg);
      local ldlg = this.dialog_list.last();
      if (ldlg) updateCommonView(ldlg);
      addChild(this.common_view);

      if (state == 0) {
        this.img_bg.setColor(0xffffff00);
        if (ldlg.isFade()) {
          _fadeBG(0);
          state = 1;
        }
      }
      else {
        this.img_bg.setColor(0xffffffff);
        if (!ldlg.isFade()) {
          _fadeBG(2);
          state = 0;
        }
      }
    }
    else {
      if (interval_id != -1) {
        clearInterval(interval_id);
        this.interval_id = -1;
      }

      if (state == 1) {
        this.img_bg.setColor(0xffffffff);
        _fadeBG(1);
        state = 0;
      }
    }
  }

  function closeAllDialog() {
    foreach (idx, o in this.dialog_list) {
      o.close();
    }
  }

  function fadeinBG(dt) {
    time += dt;
    if (time < 100) {
      self.img_bg.setColor(0xffffff00 + 255 * time / 100.0);
      return null;
    }

    self.img_bg.setColor(0xffffffff);
    self.interval_id = -1;
    return undefined;
  }

  function fadeoutBG(dt) {
    time += dt;
    if (time < 100) {
      self.img_bg.setColor(0xffffffff - 255 * time / 100.0);
      return null;
    }

    self.img_bg.setColor(0xffffff00);
    self.removeChild(self.img_bg);
    self.interval_id = -1;
    return undefined;
  }

  function fadeoutBGNoRemove(dt) {
    time += dt;
    if (time < 100) {
      self.img_bg.setColor(0xffffffff - 255 * time / 100.0);
      return null;
    }

    self.img_bg.setColor(0xffffff00);
    self.interval_id = -1;
    return undefined;
  }

  function updateCommonView(dlg) {
    if (dlg.need_moneylayer) {
      this.pnl_money.setVisible(true);
      updateGMValue();
      updateRMValue();
    } else {
      this.pnl_money.setVisible(false);
    }
    this.btn_close.setVisible(dlg.need_btn_close);
  }

  function updateGMValue() {
    local ud = ::gamesession.getUserData();
    if (!ud) return;
    local gm = ud.getGameMoney();
    this.lbl_gm.setText(gm);
  }
  function updateRMValue() {
    local ud = ::gamesession.getUserData();
    if (!ud) return;
    local rm = ud.getTotalRealMoney();
    this.lbl_rm.setText(rm);
  }

  function mouseevent_bg(e) {
    e.consume();
    if (e.id != MOUSE_RELEASED) return;
    local dlg = this.dialog_list.last() || null;
    if (dlg) closeDialog(this.dialog_list.last());
  }

  function actionevent_buy_gm(e) {
    e.consume();
  }
  function actionevent_buy_rm(e) {
    e.consume();
  }
  function actionevent_close(e) {
    e.consume();
    this.dialog_list.last().close();
  }

  function getFrontDialog() {
    return this.dialog_list.last();
  }
}

class MessageLayer extends SKView {

  interval_id = -1;
  message_list = null;

  static OFFSET = 80;
  static BETWEEN_LINES = 50;
  upper_right_list = null;

  constructor() {
    super();

    bnd.set(0, 0, ::screenWidth, ::screenHeight);
    pickable = false;

    message_list = [];

    upper_right_list = [];
  }

  function showMessage(msg) {
    this.message_list + msg;
    local msg_view = msg.view;
    addChild(msg_view);
  }

  function closeMessage(msg) {
    foreach (idx, m in this.message_list) {
      if (msg == m) {
        delete this.message_list[idx];
        break;
      }
    }
    if (!msg) return;

    local _idx = this.upper_right_list.indexOf(msg);
    if (_idx >= 0) {
      delete this.upper_right_list[_idx];
      local _len = this.upper_right_list.len();
      for (local i = _idx; i < _len; i++) {
        local _msg = this.upper_right_list[i];
        local _y = ::screenHeight / 2.0 - viewHeight / 2.0 + OFFSET + (BETWEEN_LINES * i);
        _msg.setPosition(::screenWidth, _y, 0);
        _msg.view.matdirty = true
      }
      repaint();
    }

    local msg_view = msg.view;
    removeChild(msg_view);
  }

  function showUpperRightMessage(text) {
    local _msg = ::Message();
    _msg.setText(text);
    _msg.setFontSize(32);
    local _length = this.upper_right_list.len();
    local _y = ::screenHeight / 2.0 - viewHeight / 2.0 + OFFSET + (BETWEEN_LINES * _length);
    _msg.setPosition(::screenWidth, _y, 0);
    this.upper_right_list + _msg;
    _msg.show();
  }

  function closeAllMessage() {
    foreach (idx, o in this.message_list) {
      o.close();
    }
    this.upper_right_list.clear();
  }
}

::gamesession <- null;

function setGameSession(s) {
  ::gamesession = s;
}

function getGameSession() {
  return ::gamesession;
}

::timeoffset <- long(0);

::getServerTime <- function() {
  return (Date.currentTime() - time201511 + timeoffset)[0];
}

::getServerDate <- function() {
  return Date(::getServerTime());
}

::serverTimeToDate <- function(t) {
  return Date(time201511 + ::timeoffset + t);
}

class GameSession.UserSessionAutoUpdator {
  static KEEP_SESSION_MILLIS = 20 * 60 * 1000;
  static LAST_UPDATE_TIME = 15 * 1000;

  instance = null;

  timer = 0;
  next_update_time = 0;

  constructor() {
    this.instance = this;
    init();
  }

  function destruct() {
    this.instance = null;
  }

  function update(dt) {
    this.timer += dt;
    check();
  }

  function check() {
    if (this.timer < this.next_update_time) return;

    local ret = ::gamesession.requestIncreaseSessionAliveTime();

    if (ret[0]["ret"] != ::ServletConstants.RESPONSE_SUCCEED) reset();
  }

  function init() {
    this.timer = 0;
    reset();
  }

  function reset() {

    local next = int(this.timer + (KEEP_SESSION_MILLIS - this.timer) / 2.0);
    if (next > KEEP_SESSION_MILLIS - LAST_UPDATE_TIME) {
      destruct();
    }
    else {
      this.next_update_time = next;
      ::debugln("next session update time : " + (this.next_update_time - this.timer) + " msec");
    }
  }
}

class ServerDataLoader {
  idx = 0;
  datas = null;

  constructor(datas, idx = 0) {

    this.datas = datas;
    this.idx = idx;
  }

  function get() {
    if (!(idx in datas)) {
      ::errorln("end of data, idx : " + idx);
      return;
    }

    local data = this.datas[this.idx];
    this.idx++;
    return data;
  }

  function close() {
    if (this.idx != length(this.datas)) {
      ::warnln("data not ended, idx : " + this.idx + ", data length : " + length(this.datas));
    }

    this.idx = 0;
    this.datas = null;
  }
}