  function completeLevelupProduct(furniture_uid) {
    local _param = {};
    _param["uid"] <- furniture_uid;

    if (con) {
      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_PRODUCT_LEVELUP_COMPLETE, _param);

      if (!::DISABLE_TRIAL) {
        if ("reward" in ret[0]) {
          local ri = decodeJSON(ret[0]["reward"]);
          local item = {};
          item.uid <- ri[0];
          item.kind <- ri[1];
          item.id <- ri[2];
          item.num <- ri[3];
          item.target_id <- ri[4];

          local items = [];
          items + item;

          local ud = getUserData();
          ud.addRewardItems(items);

          local dlg = ::RewardDialog();
          dlg.setReward(item.kind, item.id, item.num);
          dlg.show();
        }
      }

      return ret[0];
    } else {
      println("ERROR!!!! Connection failed. [completeLevelupProduct]");
    }
  }

