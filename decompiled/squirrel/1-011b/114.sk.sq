  function completeProduct(furniture_uid) {
    local _param = {};
    _param["uid"] <- furniture_uid;

    if (con) {
      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_PRODUCT_COMPLETE, _param);
      if (ret[0].ret != ::ServletConstants.RESPONSE_SUCCEED) return ret[0];

      local rewards = ret[0].reward;
      local reward_list = [];
      foreach (idx, ri in rewards) {
        local _list = decodeJSON(ri);
        local _item = { kind = -1, id = -1, num = -1, target_id = -1 };
        _item.kind = _list[0];
        _item.id = _list[1];
        _item.num = _list[2];
        _item.target_id = _list[3];

        reward_list + _item;
      }
      ret[0].reward = reward_list;

      return ret[0];
    } else {
      println("ERROR!!!! Connection failed. [completeProduct]");
    }
  }

