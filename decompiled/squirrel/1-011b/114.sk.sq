  function deleteMails(start_idx, end_idx) {
    if (!con) return null;

    local ud = getUserData();
    local find = false;
    for (local idx = start_idx; idx <= end_idx; idx++) {
      if (ud.hasMailItemByIdx(idx)) continue;

      find = true;
      break;
    }
    if (!find) return null;

    local param = { start_idx = start_idx, end_idx = end_idx };
    local ret = _sendMainServletAPI(::ServletConstants.MAIN_CMD_DELETE_MAILS, param);
    if (ret.ret == ::ServletConstants.RESPONSE_SUCCEED) {
      ud.deleteMails(ret.idxes);
    }

    return ret;
  }

  function _sendMainServletAPI(cmd, param) {
    if (con) {
      local ret = con.commandToMain(cmd, param);
      if (ret[0].ret != ::ServletConstants.RESPONSE_SUCCEED) {
        ::errorln("ERROR!!!! server error.");
        _showSeverErrorDialog(ret[0].ret);
        return ret[0];
      }
      else {
        ::traceln("process succeeded");
        return ret[0];
      }
    }
    else {
      _showSeverErrorDialog(ret[0].ret);
      ::errorln("ERROR!!!! Connection failed.");
      return ret[0];
    }
  }

  function _showSeverErrorDialog(error_code) {
    local dlg = SimpleDialog();
    dlg.lbl_msg.setText(::dict.get("server_error", [error_code]));
    dlg.show();
    return;
  }

