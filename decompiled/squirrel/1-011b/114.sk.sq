    local ret = this.con.commandToMain(::ServletConstants.MAIN_CMD_CHARGE_RM, param);

    if (ret[0]["ret"] == ::ServletConstants.RESPONSE_SUCCEED) {
      local _rid = ret[0]["add_room"];
      if (_rid >= 0) {
        _proc_add_room(_rid, ret[0]);
      } else if ("room_ids" in ret[0]) {
        _proc_add_rooms(ret[0]);
      }
    }

    debugPrint(ret[0]);
    return ret[0];
  }

