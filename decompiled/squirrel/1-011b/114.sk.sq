::day201511 <- Date(115, 11 - 1, 1);
::time201511 <- day201511.getTime();

class GameSession
{
  static DAILY_ACROSS_TIME = 60 * 60 * 4;
  static DAY_SECONDS = 60 * 60 * 24;

  static FRIEND_DATA_UPDATE_INTERVAL = 1000 * 60 * 5;
  static HELPER_DATA_UPDATE_INTERVAL = 1000 * 60 * (10 + 1);

  static LP_RECOVERY_PRICE = 0;

  static PRESENT_FREE_MONEY = 0;
  static PRESENT_GAME_MONEY = 1;
  static PRESENT_COSTUME = 2;

  root = null;
  currentscene = null;
  maintenance_info = null;

  session_updater_wref = null;
  iap_manager = null;
  is_iap_initialized = false;

  scenelayer = null;
  dialoglayer = null;
  messagelayer = null;
  processinglayer = null;
  loadinglayer = null;
  tapviewlayer = null;
  tutoriallayer = null;
  backloglayer = null

  sakanaproj = null;
  pkgjson = null;
  pkgversion = "";

  trailmode = false;

  uuid = null;

  userdata = null;
  userdata_local = null;
  friendlist = null;

  loglist = null;

  accountid = null;

  current_chara_id = -1;
  current_closet_index = 0;
  current_chara_index = -1;
  current_helper_costume_params = null;
  current_costumes = null;
  current_course_list_index = -1;

  tmp_command_conditions = null;
  tmp_costumes = null;
  tmp_growing_data = null;

  day = 0;
  ranking = null;

  talksystem = null;

  lasttrystage = null;
  lastresult = null;

  cachefile = null;

  backdialog = null;

  helper_list = null;

  last_friend_data_update_time = -1;
  friends_shortdata = null;

  last_helper_data_update_time = -1;
  helpers_shortdata = null;

  serverurl = null;
  con = null;
  command_sequence = -1;

  rootupdate_lock = false;

  appsflyer = null;

  constructor() {
    local r = ::getResource("/sakana.proj");
    if (r) {
      sakanaproj = decodeJSON(r.getContent());
      trailmode = sakanaproj["trailmode"];
      serverurl = ::SERVER_URL;

    }
    loglist = [];
  }

  function repeatConnect(func) {
    local ret = null;
    for (;;) {
      try {
        ret = func();
        return ret;
      } catch (ex) {
        printexception(ex);
        if (!showErrorRetryDialog(::dict.get("connection_error_message"), ::dict.get("connection_error_caution"))) {
          skRestart();
        }
      }
    }
  }

  function setMaintenanceInfo(info) {
    this.maintenance_info = info;
  }
  function getMaintenanceInfo() {
    return this.maintenance_info;
  }

  function login(options = null) {
    userdata = null;
    userdata_local = getUserDataLocal();
    friendlist = null;
    local _os_name = skGetOSName();

    _createUserDataLocal();

    if (con) {
      local auth_func;
      if (options.force_init) {
        local udl = getUserDataLocal();
        if (udl) udl.resetUserDataLocal();
        auth_func = function() { return con.auth_new_data(); }.bindenv(this);
      }
      else {
        auth_func = function() { return con.auth(); }.bindenv(this);
      }
      local ret = repeatConnect(auth_func)[0];

      local addr = ret["addr"];
      local _loop = 0;
      while (addr) {
        _loop++;
        if (_loop > 10) {
          println("Servers not found.");
          return false;
        }

        con.setURL("http://" + addr);
        ret = repeatConnect(auth_func)[0];
        addr = ret["addr"];
      }

      if (ret["server_time"]) {
        this.adjustTimeOffset(ret["server_time"]);
      }

      if (!::READ_LOCAL_CONF) {
        local ret = repeatConnect(function() { return con.commandToMain(::ServletConstants.MAIN_CMD_LOAD_CONF); }.bindenv(this));
        ::gamesetting.loadConfSetting(ret[0]);
      }

      _initAppsFlyer();

      if (ret["first_login"]) {
        this.userdata_local = ::UserDataLocal();
        this.userdata_local.save();
        this.appsflyer.completeRegistration();
      }

      if (ret["userdata"]) {
        try {
          userdata = UserData();
          userdata.load(::ServerDataLoader(ret["userdata"]));

          userdata.setup();
          userdata_local.setFlFlag();
        } catch (ex) {

          printexception(ex);
          printf("userdata broken.....\n");
        }
      }

      if (!userdata) return false;

      this.command_sequence = -1;

      if (options.debug_all_get) {
        selectFirstCostume(0);
        local ret = con.commandToMain(::ServletConstants.MAIN_CMD_GET_ALL);
        if (ret[0].ret == ::ServletConstants.RESPONSE_SUCCEED) updateUserData();
      }

      ::tutorial_manager.init();

    } else {
      return false;
    }
    if (isSendLog) {

      local _send_text = "";
      local _test_text = null;
      local _filepath = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_LOG, ::FilePathManager.APPLICATION_MODE_NONE);

      local _log_directory = FileRef(_filepath);
      local _file_lists = _log_directory.getList();
      foreach (_file in _file_lists) {
        if (!_file.name.startsWith("client_log_")) continue;

        local _bb = _file.load(null, "r");
        _bb.pos = 0;
        local _txt = _bb.asText();

        _test_text = clone _txt;
        _send_text = _send_text + _txt;

        _file.deleteFile();
      }

      con.commandToMain(::ServletConstants.MAIN_CMD_SEND_LOG, _send_text);

      local _date = ::getServerDate();
      local _dst = sprintf("%04d%02d%02d%02d%02d%02d", _date.tm_year, _date.tm_mon + 1, _date.tm_mday, _date.tm_hour, _date.tm_min, _date.tm_sec);

      local _tmpfile = FileRef(_filepath + "before_login.log");
      local _newfile = FileRef(_filepath + "client_log_" + _dst + ".log");

      changeStdOut(_newfile, "a");

      _tmpfile.copyTo(_newfile);
      _tmpfile.deleteFile();

      println("login sucess. time:" + _dst);
    }

    this.userdata_local.checkRemovedShopSettings();
    ::gamesetting.createShopPriceTables();
    ::gamesetting.createShopSettingTable();

    local _filepath = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_CACHE_IMAGE, ::FilePathManager.APPLICATION_MODE_NONE);
    local _dir = FileRef(_filepath);
    local _file_list = _dir.getList();

    foreach (_file in _file_list) {
      local _b = _file.name.contains(".png") || _file.name.contains(".jpg");
      if (!_b) continue;
      _file.deleteFile();
    }

    _filepath = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_THUMBNAIL, ::FilePathManager.APPLICATION_MODE_NONE);
    local _dir = FileRef(_filepath);
    local _file_list = _dir.getList();

    foreach (_file in _file_list) {
      local _b = _file.name.contains(".png") || _file.name.contains(".jpg");
      if (!_b) continue;
      _file.deleteFile();
    }

    if (userdata_local.getFriendCode() == null) {
      local _code = userdata.getFriendCode();
      if (_code) {
        userdata_local.setFriendCode(_code);
        userdata_local.save();
      }
    }

    if (userdata_local.initFavoriteMotions()) {
      userdata_local.save();
    }

    return true;
  }

  function getDay() {
    local t = getServerTime();
    return
  }

  function getEvents() {
    if (con) {
      return con.getEvents();
    } else {
      return null;
    }
  }

  function _initAppsFlyer() {
    if (::DEBUG_PANEL) {

      this.appsflyer = ::SanrioAppsFlyerInterface();
      return;
    }

    if (this.appsflyer && this.appsflyer.enableAppsFlyer()) return;

    local _os_name = skGetOSName();
    if (_os_name.equals("Android")) {
      this.appsflyer = ::SanrioAppsFlyer();
      if (!this.appsflyer.enableAppsFlyer()) this.appsflyer = ::SanrioAppsFlyerInterface();
      return;
    }
    else if (_os_name.equals("iOS") && skGetVersion() >= 19) {
      this.appsflyer = ::SanrioAppsFlyer();
      if (!this.appsflyer.enableAppsFlyer()) this.appsflyer = ::SanrioAppsFlyerInterface();
      return;
    }

    this.appsflyer = ::SanrioAppsFlyerInterface();
  }

  function checkDaily() {
    if (!con) return;

    local s_time = ::getServerTime();

    local day = (s_time - DAILY_ACROSS_TIME) / DAY_SECONDS - (userdata.last_daily_time - DAILY_ACROSS_TIME) / DAY_SECONDS;
    if (day < 1) return;

    userdata.last_daily_time = s_time;
    savewait(["daily"]);
  }

  function checkPresent() {
    if (!con) return null;

    local present_serialid = userdata.values["present_serialid"] || -1;
    local a = con.getPresents(present_serialid);

    local c = 0;
    foreach (p in a) {
      if (userdata.putPresent(p)) {
        ++c;
        present_serialid = Math.max(p.serialid, present_serialid);
      }
    }
    printf("chcekPresent serialid=%d num=%d\n", present_serialid, c);
    if (c) {
      userdata.values["present_serialid"] <- present_serialid;
    }
    return c;
  }

  function putRecord(rankingid, value, etc) {
    if (!con) return;

    con.putRecord(rankingid, value, etc);
  }

  function getMyRanks(rankingid) {
    if (!con) return {};

    return con.getMyRanks(rankingid);
  }

  function checkProducts(products) {
    local t = skGetTime();

    if (!con) return { ret = "NG", time = -1, result = null };

    local ret = con.checkProducts(products);

    local finish = {};
    foreach (idx, f in ret.finish) {
      finish[int(idx)] <- f;
    }

    ret.finish = finish;
    return ret;
  }

  function updateHelperHistory(helperid) {
    local history = [];

    local file = FileRef(skGetDataDir() + "/helper_history");
    if (file.exists()) {
      try {
        local txt = file.load().asText();
        local ji = JSONInput(decodeJSON(txt));
        history = ji.readObject();
      } catch (ex) {
      }
    }

    history + helperid;
    while (length(history) > 10) {
      delete history[0];
    }

    local jr = JSONOutput();
    jr.writeObject(history);
    local txt = encodeJSON(jr.getObject());
    local bb = ByteBuffer();
    bb.putText(txt);
    bb.pos = 0;
    file.save(bb);

    local heplerfile = FileRef(skGetDataDir() + "/helper");
    local bb = ByteBuffer();
    bb.putText("request update");
    bb.pos = 0;
    heplerfile.save(bb);
  }

  function getHelperListData(force = false) {
    local _debugPrintArray = function(arr) {
      if (!::DEBUG) return;

      print("[")
      foreach (idx, e in arr) {
        print("" + idx + " - " + e + ", ");
      }
      print("]\n")
    }

    local friends = getFriendsShortdata(1).friend;
    local helpers = getHelpersShortdata(1);

    local need_update = force;
    local data = { "friend" = [], "helper" = [] };

    local file = FileRef(skGetDataDir() + "/helper");
    if (!force) {
      if (file.exists()) {
        try {
          local txt = file.load().asText();
          if (txt == "request update") {
            need_update = true;
          }
          else {
            local ji = JSONInput(decodeJSON(txt));
            local list = ji.readObject();

            if (list.helper.time != last_helper_data_update_time) {
              need_update = true;
            }
            else {

              local friend_data = data.friend;
              foreach (id in list.friend.ids) {
                foreach (friend in friends) {
                  if (friend[1] == id) {
                    friend_data + friend;
                    break;
                  }
                }
              }

              local helper_data = data.helper;
              foreach (id in list.helper.ids) {
                foreach (helper in helpers) {
                  if (helper[0] == id) {
                    helper_data + helper;
                    break;
                  }
                }
              }
            }
          }
        } catch (ex) {
          need_update = true;
        }
      }
      else {
        need_update = true;
      }
    }

    if (need_update) {
      if (::DEBUG) print("create new data\n")

      local savedata = { "friend" = { "time" = last_friend_data_update_time, "ids" = [] }, "helper" = { "time" = last_helper_data_update_time, "ids" = [] } };

      local max_num = 10;
      local max_friend_num = 5;

      local _contains = function(arr, a) { foreach (e in arr) if (a == e) return true; return false; };

      local history = [];
      local historyfile = FileRef(skGetDataDir() + "/helper_history");
      if (historyfile.exists()) {
        try {
          local txt = historyfile.load().asText();
          local ji = JSONInput(decodeJSON(txt));
          history = ji.readObject();
        } catch (ex) {
          if (::DEBUG) print("file decode failed ...\n")
        }
        _debugPrintArray(history);
      }

      local friend_candidates = [];
      foreach (friend in friends) {
        if (!friend[3]) continue;
        if (_contains(history, friend[1])) continue;

        friend_candidates + friend;
      }

      foreach (f in friend_candidates) {
        _debugPrintArray(f);
      }

      local friend_num = length(friend_candidates);
      local friend_data = data.friend;
      local save_friend_ids = savedata.friend.ids;
      local count = 0;
      if (friend_num <= max_friend_num) {
        foreach (friend in friend_candidates) {
          friend_data + friend;
          save_friend_ids + friend[1];
        }

        count += friend_num;
      }
      else {
        while (count < max_friend_num) {
          local friend = friend_candidates[::PUBLIC_RANDOM.nexti(friend_num)];
          if (!_contains(friend_data, friend)) {
            friend_data + friend;
            save_friend_ids + friend[1];
            count++;
          }
        }
      }

      foreach (f in friend_data) {
        _debugPrintArray(f);
      }

      local _checkFriend = function(friends, helper) { foreach (f in friends) if (f[1] == helper[0]) return true; return false; };
      local myUserid = userdata.userid;
      local helper_candidates = [];
      foreach (helper in helpers) {
        if (!helper[1]) continue;
        if (_contains(history, helper[0])) continue;

        if (_checkFriend(friends, helper)) continue;

        helper_candidates + helper;
      }

      foreach (f in helper_candidates) {
        _debugPrintArray(f);
      }

      local helper_num = length(helper_candidates);
      local helper_data = data.helper;
      local save_helper_ids = savedata.helper.ids;
      if (count + helper_num <= max_num) {
        foreach (helper in helper_candidates) {
          helper_data + helper;
          save_helper_ids + helper[0];
        }

        count += helper_num;
      }
      else {
        while (count < max_num) {
          local helper = helper_candidates[::PUBLIC_RANDOM.nexti(helper_num)];

          if (!_contains(helper_data, helper)) {
            helper_data + helper;
            save_helper_ids + helper[0];
            count++;
          }
        }
      }

      foreach (h in helper_data) {
        _debugPrintArray(h)
      }

      local jr = JSONOutput();
      jr.writeObject(savedata);
      local txt = encodeJSON(jr.getObject());
      local bb = ByteBuffer();
      bb.putText(txt);
      bb.pos = 0;
      file.save(bb);
    }

    return data;
  }

  function getHelpersShortdata(update = 1) {
    if (update != 0) {
      local curr_time = ::getServerTime();
      if (con && (update == 2 || curr_time - last_helper_data_update_time >= HELPER_DATA_UPDATE_INTERVAL)) {

        local data = con.getHelpersShortdata();
        local list = data.value;
        local time = data.time;
        local myUserid = data.userid;
        local res = [];
        foreach (idx, param in list) {
          if (length(param) == 0) continue;
          if (param[0] == myUserid) continue;

          local dec_param = [];
          dec_param + param[0];
          dec_param + (length(param[1]) > 0 ? decodeUserShortData(param[1]) : null);
          dec_param + param[2];

          res + dec_param;
        }
        this.helpers_shortdata = res;
        this.last_helper_data_update_time = time;
      }
    }
    return helpers_shortdata;
  }

  function getFriendsShortdata(update = 1) {
    if (update != 0) {
      local curr_time = ::getServerTime();
      if (con && (update == 2 || curr_time - last_friend_data_update_time >= FRIEND_DATA_UPDATE_INTERVAL)) {

        local res = { "friend" = [], "receive" = [] };
        local data = con.getFriendsShortdata();
        foreach (k, _ in res) {
          foreach (idx, param in data[k]) {
            local dec_param = [];
            dec_param + param[0];
            dec_param + param[1];
            dec_param + param[2];
            dec_param + (length(param[3]) > 0 ? JSONInput(decodeJSON(param[3])).readObject() : null);

            res[k] + dec_param;
          }
        }
        this.friends_shortdata = res;
        this.last_friend_data_update_time = curr_time;
      }
    }
    return friends_shortdata;
  }

  function searchByFriendCode(f_code) {
    if (!con) return -1;

    local res = con.searchByFriendCode(f_code);
    if (!("shortdata" in res)) return null;

    return { "userid" = res.userid, "shortdata" = decodeUserShortData(res.shortdata) };
  }

  function deliverFriendRequest(target_id) {
    if (!con) return -1;

    return con.deliverFriendRequest(target_id);
  }

  function acceptFriendRequest(target_id) {
    if (!con) return -1;

    local res = con.acceptFriendRequest(target_id);
    if (res == 1) {

      foreach (idx, data in friends_shortdata.receive) {
        if (data[1] == target_id) {
          friends_shortdata.friend + data;
          removei;
        }
      }
    }
    return res;
  }

  function rejectFriendRequest(target_id) {
    if (!con) return -1;

    local res = con.rejectFriendRequest(target_id);
    if (res == 1) {

      foreach (idx, data in friends_shortdata.receive) {
        if (data[1] == target_id) {
          removei;
        }
      }
    }
    return res;
  }

  function dissolveFriend(target_id) {
    if (!con) return -1;

    local res = con.dissolveFriend(target_id);
    if (res == 1) {

      foreach (idx, data in friends_shortdata.friend) {
        if (data[1] == target_id) {
          removei;
        }
      }
    }
    return res;
  }

  function translateDigit(words, w2v, v2w) {
    local digit1 = length(w2v);
    local digit2 = length(v2w);

    local calc = [1];
    local res = [];
    for (local i = length(words) - 1; i >= 0; i--) {
      local t = words[i];

      local v = w2v[t];
      if (!v) continue;

      foreach (d, a in calc) {
        local aa = a * v;

        if (d in res) {
          res[d] += aa;
        }
        else {
          res + aa;
        }

        calc[d] *= digit1;
      }

      local d = 0;
      while (d in calc) {
        local x = calc[d] / digit2;
        calc[d] %= digit2;
        d++;

        if (x == 0) continue;

        if (d in calc) {
          calc[d] += x;
        }
        else {
          calc + x;
        }

      }
    }

    local new_words = "";

    local d = 0;
    while (d in res) {
      local x = res[d] / digit2;
      d++;

      if (x == 0) continue;

      if (d in res) {
        res[d] += x;
      }
      else {
        res + x;
      }

      new_words = v2w[res[d] % digit2] + new_words;
    }

    return new_words;
  }

  function savetofile(log, sud) {
    local udtxt = encodeJSON(sud);

    userdata.savetime = ::getServerTime();

    local bb = ByteBuffer();

    bb.putText(udtxt);
    bb.pos = 0;

    local r = Random(6366058);
    r.crypt(bb);

    if (trailmode) {

      cachefile.deleteFile();
    } else {
      cachefile.save(bb);
    }
    cachefile.refresh();
  }

  function encodeUserShortData(ud) {

    local shortdata = {

      name = ud.name,

      comment = ud.comment,
    }

    local jr = JSONOutput();
    jr.writeObject(shortdata);
    local txt = encodeJSON(jr.getObject());
    return txt;
  }

  function decodeUserShortData(data) {
    return JSONInput(decodeJSON(data)).readObject();
  }

  function encodeUserData(ud) {
    local jr = JSONOutput();
    jr.writeObject(ud);
    local txt = encodeJSON(jr.getObject());
    return txt;
  }

  function getSaveUserData(ud) {

    return encodeUserData(ud);
  }

  function actionlog(t) {
    loglist + t;
  }

  function save(log) {
    local sud = getSaveUserData(userdata);

    printf("[SAVE] " + sud + " [SAVE]\n");
    printf("[SAVE] " + sud.data + " [SAVE]\n");
    printf("[SAVE] " + sud.r_money + " [SAVE]\n");
    printf("[SAVE] " + sud.r_money_free + " [SAVE]\n");
    printf("[SAVE] " + sud.g_money + " [SAVE]\n");
    printf("[SAVE] " + sud.name + " [SAVE]\n");

    savetofile(log, sud);
    if (con) {
      invokesave(sud);
    }
  }

  savethread = null;
  nextsave = null;

  function invokesave(sud) {
    nextsave = sud;
    if (savethread) {
      return;
    }
    savethread = newthread();
    savethread.start(function() {
      while (nextsave) {
        try {
          local t = nextsave;
          nextsave = null;
          con.commandToMain(::ServletConstants.MAIN_CMD_SAVE_USERDATA, t);
          loglist.clear();
          cachefile.deleteFile();
          cachefile.refresh();
        } catch (ex) {
          printexception(ex);
          printf("GameConnection.SaveUserData failure. keep cache.");
        }
        sleep(5000);
      }
      savethread = null;
    }, this);
  }

  function savewait(log) {
    printf("[savewait] " + log + " [savewait]\n");
    local sud = getSaveUserData(userdata);
    if (con) {
      con.commandToMain(::ServletConstants.MAIN_CMD_SAVE_USERDATA, sud);
      loglist.clear();
      cachefile.deleteFile();
      cachefile.refresh();
    } else {

      savetofile(log, sud);
    }
  }

  function decodeUserData(txt) {
    local ji = JSONInput(decodeJSON(txt));
    local ud = ji.readObject();
    return ud;
  }

  function updateUserData() {
    if (con) {
      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_UPDATE_USERDATA);
      if (ret[0].ret == ::ServletConstants.RESPONSE_SUCCEED) {
        this.userdata.load(::ServerDataLoader(ret[0]["userdata"]));
      } else {

      }
    }
  }

  function loadConf() {
    if (con) {
      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_LOAD_CONF);
      ::gamesetting.loadConfSetting(ret[0]);
    }
  }

  function agreedTOS(version) {
    if (!con) return false;

    local _func = function() { return con.agreedTOS(version) }.bindenv({ con = this.con, version = version });
    return repeatConnect(_func);
  }

  function issueTakeoverCode(password) {
    if (!con) return null;

    local _func = function() { return con.issueTakeoverCode(password) }.bindenv({ con = this.con, password = password });
    return repeatConnect(_func);
  }

  function useTakeoverCode(code, password) {
    if (!con) return null;

    local _func = function() { return con.useTakeoverCode(code, password) }.bindenv({ con = this.con, code = code, password = password });
    return repeatConnect(_func);
  }

  function endTutorial(ids) {
    if (con) {
      local _param = {};
      _param.ids <- ids;

      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_END_TUTORIAL, _param);
      if (ret[0].ret == ::ServletConstants.RESPONSE_SUCCEED) {
        local _ud = getUserData();

        if ("new_panel_mission_ids" in ret[0]) {
          local _ids = decodeJSON(ret[0]["new_panel_mission_ids"]);
          _ud.addPanelMissionDatasAtServer(_ids);
        }
        if ("set_panel_mission_id" in ret[0]) {
          local _pmid = ret[0]["set_panel_mission_id"];
          _ud.setPanelMissionID(_pmid);
          local _scene = getCurrentScene();
          if (_scene instanceof SanrioGameScene) {
            _scene.getPanelMissionManager().chagnePanelMission(_pmid);
          }
        }

        return true;
      }
    }
    return false;
  }

