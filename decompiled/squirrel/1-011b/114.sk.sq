      local _ret = con.commandToMain(::ServletConstants.MAIN_CMD_RENTAL_COSTUME, _param);
      if (_ret[0]["ret"] != ::ServletConstants.RESPONSE_SUCCEED) return null;
      _result.tl = _ret[0]["time_limit"];
      _result.st = _ret[0]["server_time"];
    } else {
      println("ERROR!!!! Connection failed. [rentalCostume]");
    }
    return _result;
  }

  function receiveNewMail() {
