    function addCostumeRequestDataListAtLoader(loader, costume_id = -1) {
      local crds_len = loader.get();
      local crds = [];
      for (local i = 0; i < crds_len; i++) {
        local _crd = CostumeRequestData();
        _crd.loadWithCreate(loader);
        crds + _crd;
      }

      if (costume_id == -1) costume_id = crds[0].getCostumeID();

      if (costume_id in this.costume_request_table) {
        this.costume_request_table[costume_id] = crds;
      } else {
        this.costume_request_table[costume_id] <- crds;
      }
    }

