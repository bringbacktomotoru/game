    function getRemainingPurchaseNum(shop_id) {
      local shop_setting = ::gamesetting.shop_settings[shop_id];
      if (!shop_setting) {
        ::errorln("invalid shop id : " + shop_id);
        return { limit = true, num = -1 };
      }

      if (shop_setting.limit != -1) return { limit = true, num = shop_setting.limit - getPurchaseRecordNums(shop_id) };
      else return { limit = false }
    }

    function checkPurchasable(shop_id, num) {
      local shop_setting = ::gamesetting.shop_settings[shop_id];

      if (shop_setting.limit != -1 && shop_setting.limit < getPurchaseRecordNums(shop_id) + num) {
        return { result = false, log = ::dict.get("purchase_limit_over") };
      }

      switch (shop_setting.getPriceType()) {
      case PRICE_GM:
        if (getGameMoney() < shop_setting.getPrice()) {
          return { result = false, log = ::dict.get("no_have_gm") };
        }
        break;
      case PRICE_RM:
        if (getTotalRealMoney() < shop_setting.getPrice()) {
          return { result = false, log = ::dict.get("lack_rm") };
        }
        break;
      case PRICE_ONEROUS_RM:
        if (getRealMoney() < shop_setting.getPrice()) {
          return { result = false, log = ::dict.get("lack_rm") };
        }
      }

      return { result = true, log = ::dict.get("shop_confirm") };
    }

    function purchaseRoom(shop_id, num) {
      local shop_setting = ::gamesetting.shop_settings[shop_id];
      if (!shop_setting) {
        ::errorln("invalid shop id : " + shop_id);
        return false;
      }

      local price = shop_setting.getPrice();
      switch (shop_setting.getPriceType()) {
      case PRICE_GM:
        if (this.getGameMoney() < price) {
          ::errorln("lack of game money");
          return false;
        }
        break;
      case PRICE_RM:
        if (this.getTotalRealMoney() < price) {
          ::errorln("lack of real money");
          return false;
        }
        break;
      case PRICE_ONEROUS_RM:
        if (this.getRealMoney() < price) {
          ::errorln("lack of real money");
          return false;
        }
        break;
      }

      local res = gamesession.purchaseRoom(shop_id, num);
      if (res.ret != ::ServletConstants.RESPONSE_SUCCEED) {
        return false;
      }

      foreach (uid in res.room_uids) {

        addRoom(shop_setting.getItemID());
      }

      applyPurchase(shop_setting.getPriceType(), price);
      addPurchaseRecord(shop_id, num);

      return true;
    }

    function addPurchaseRecord(shop_id, num) {
      if (shop_id in purchase_records) {
        local _oldnum = purchase_records[shop_id];
        purchase_records[shop_id] = _oldnum + num;
      } else {
        purchase_records[shop_id] <- num;
      }
    }

