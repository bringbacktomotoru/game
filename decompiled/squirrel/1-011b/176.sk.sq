    function enableHapinessAction(force = false) {
      local _rule = ::gamesetting.game_rule;
      if (!force && !::tutorial_manager.enableHapinessAction()) return false;
      if (!hasBonusHapinessNum()) return false;
      if (this.next_hapiness_action_time > ::getServerTime()) return false;
      if (this.hasHapinessAction()) return false;
      if (!force && ::PUBLIC_RANDOM.nexti(100) >= ::gamesetting.game_rule.getBonusHeartRate()) return false;

      return true;
    }
    function getHapinessActionCosId() {
      return this.hapiness_action_cos_id;
    }
    function setHapinessActionCosId(cid) {
      this.hapiness_action_cos_id = cid;
    }
    function isHapinessAction(cos_id) {
      return this.hapiness_action_cos_id == cos_id ? true : false;
    }
    function hasHapinessAction() {
      return this.hapiness_action_cos_id > 0;
    }
    function succesHapinessAction(cos_id) {
      if (!isHapinessAction(cos_id)) return false;

      this.next_hapiness_action_time = ::getServerTime() + HAPINESS_ACTION_INTERVAL_SUCCES;
      setHapinessActionCosId(-1);

      return true;
    }

    function resetHapinessAction() {
      this.next_hapiness_action_time = -1;
      setHapinessActionCosId(-1);
    }

    function failHapinessAction(cos_id) {
      if (!isHapinessAction(cos_id)) return false;

      this.next_hapiness_action_time = ::getServerTime() + HAPINESS_ACTION_INTERVAL_FAIL;
      setHapinessActionCosId(-1);

      return true;
    }

    function getTapHapiness(room_id = -1) {

      if (room_id < 0) room_id = getCurrentRoomUID();
      local _red = getRoomEditData(room_id);
      return _red.getTapHapiness();
    }

    function calcBonusHapiness() {

      this.bonus_hapiness = getTapHapiness() * (29 + this.rank);

      local _scene = ::gamesession.getCurrentScene();
      if (_scene instanceof SanrioGameScene) {
        _scene.getUI().updateHapinessValueInfo();
      }
    }
    function getBonusHapiness() {
      return this.bonus_hapiness;
    }
    function getBonusHapinessNum() {
      updateBonusHapinessNum();
      return this.bonus_hapiness_num;
    }

    function addBonusHapinessNum() {
      updateBonusHapinessNum();
      if (!isMaxBonusHapinessNum()) {
        this.bonus_hapiness_num += ::gamesetting.game_rule.getLevelupBonusRecoveryNum();
        this.bonus_hapiness_num = Math.min(this.bonus_hapiness_num, MAX_BONUS_HAPINESS_NUM);
        if (isMaxBonusHapinessNum()) this.next_bonus_hapiness_recover_time = -1;
      }
    }

    function setBonusHapinessNum(num) {
      this.bonus_hapiness_num = num;
    }

    function hasBonusHapinessNum() {
      return this.bonus_hapiness_num > 0 ? true : false;
    }

    function consumeBonusHapinessNum(time = -1) {
      this.bonus_hapiness_num--;
      if (time < 0) {
        if (this.next_bonus_hapiness_recover_time < 0) {
          this.next_bonus_hapiness_recover_time = ::getServerTime() + BONUS_HAPINESS_RECOVER_TIME;
        }
      } else {
        this.next_bonus_hapiness_recover_time = time;
      }
    }
    function getNextBonusHapinessRecoveryTime() {
      return this.next_bonus_hapiness_recover_time;
    }
    function isMaxBonusHapinessNum() {
      return this.bonus_hapiness_num == MAX_BONUS_HAPINESS_NUM ? true : false;
    }
    function updateBonusHapinessNum() {
      if (isMaxBonusHapinessNum()) return;

      local _now = ::getServerTime();
      if (_now <= this.next_bonus_hapiness_recover_time) return;

      local _val = int((_now - this.next_bonus_hapiness_recover_time) / BONUS_HAPINESS_RECOVER_TIME) + 1;
      this.bonus_hapiness_num += _val;
      this.bonus_hapiness_num = Math.min(MAX_BONUS_HAPINESS_NUM, this.bonus_hapiness_num);

      if (isMaxBonusHapinessNum()) {
        this.next_bonus_hapiness_recover_time = -1
      } else {
        this.next_bonus_hapiness_recover_time += _val * BONUS_HAPINESS_RECOVER_TIME;
      }

    }

