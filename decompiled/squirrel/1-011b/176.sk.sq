    function load(loader) {
      this.friend_code = loader.get();
      this.name = loader.get();
      this.sex = loader.get();

      this.rank = loader.get();
      this.rankexp = loader.get();
      this.gmoney = loader.get();
      this.rmoney = loader.get();
      this.freerm = loader.get();
      this.capture_hapiness_time = loader.get();

      local _furniture_nums = loader.get();
      local _tmp_amt_table = {};
      for (local i = 0; i < _furniture_nums; i++) {
        local fd = ::FurnitureData.loadWithCreate(loader);
        addFurnitureData(fd, true);

        local _rid = fd.getRoomID();
        if (!(_rid in _tmp_amt_table)) _tmp_amt_table[_rid] <- [];
        _tmp_amt_table[_rid] + fd;
      }

      local room_slot_num = loader.get();
      this.rooms.resize(room_slot_num, null);
      foreach (idx, _ in this.rooms) {
        local slot_data = ::RoomSlotData();
        slot_data.load(loader);
        this.rooms[idx] = slot_data;
      }

      local unlocked_num = loader.get();
      this.unlocked_slot_ids.resize(unlocked_num, null)
      foreach (idx, _ in this.unlocked_slot_ids) {
        this.unlocked_slot_ids[idx] = loader.get();
      }

      local room_num = loader.get();
      for (local i = 0; i < room_num; i++) {
        local room_edit = ::RoomEditData.loadWithCreate(loader);
        addRoomEditData(room_edit);

        local _list = _tmp_amt_table[room_edit.getUID()];
        foreach (fd in _list) {
          room_edit.addFurnitureAmountAtLoad(fd.getID(), fd.getUID(), false);
        }
        room_edit.calcTapHapiness(true);

      }

      local _room_layout = this.room_layout;
      local size = loader.get();
      _room_layout.resize(size, null);
      foreach (idx, _ in _room_layout) {
        local layout = _room_layout[idx] = array(loader.get());
        foreach (idx, _ in layout) {
          layout[idx] = loader.get();
        }
      }

      local _costume_data_num = loader.get();
      for (local i = 0; i < _costume_data_num; i++) {
        local _costume = ::CostumeData.loadWithCreate(loader);
        addCostumeData(_costume, true);
      }

      local _work_reward_data_num = loader.get();
      for (local i = 0; i < _work_reward_data_num; i++) {
        local _wrd = ::WorkRewardData.loadWithCreate(loader);
        addWorkRewardData(_wrd);
      }

      local _item_nums = loader.get();
      for (local i = 0; i < _item_nums; i++) {
        local id = loader.get();
        local nums = loader.get();
        addItem(id, nums);
      }

      local _purchase_records_num = loader.get();
      for (local i = 0; i < _purchase_records_num; i++) {
        local id = loader.get();
        local nums = loader.get();
        addPurchaseRecord(id, nums);
      }

      local _gacha_data_num = loader.get();
      for (local i = 0; i < _gacha_data_num; i++) {
        local _gd = ::GachaData.loadWithCreate(loader);
        addGachaData(_gd);
      }

      local _end_tutorial_num = loader.get();
      for (local i = 0; i < _end_tutorial_num; i++) {
        this.end_tutorial_ids + loader.get();
      }

      local _costume_request_list_num = loader.get();
      for (local i = 0; i < _costume_request_list_num; i++) {
        local crds_len = loader.get();
        local crds = [];
        for (local j = 0; j < crds_len; j++) {
          local _crd = ::CostumeRequestData.loadWithCreate(loader);
          crds + _crd;
        }
        this.costume_request_table[crds[0].getCostumeID()] <- crds;
      }

      local mail_num = loader.get();
      for (local i = 0; i < mail_num; i++) {
        local mail_data = ::MailData.loadWithCreate(loader);
        this.mails + mail_data;
      }

      local chara_num = loader.get();
      for (local i = 0; i < chara_num; i++) {
        local chara_data = ::CharacterData.loadWithCreate(loader);
        this.character_table[chara_data.getID()] <- chara_data;
      }

      this.bonus_hapiness_num = loader.get();
      this.next_bonus_hapiness_recover_time = loader.get();

      this.last_ad_video_watch_time = loader.get();
      this.ad_video_watch_count = loader.get();

      local _pmd_num = loader.get();
      for (local i = 0; i < _pmd_num; i++) {
        local _pmd = ::PanelMissionData().loadWithCreate(loader);
        this.panel_mission_table[_pmd.getID()] <- _pmd;
      }

      local _reply_num = loader.get();
      for (local i = 0; i < _reply_num; i++) {
        local _key = loader.get();
        local _val = loader.get();
        this.reply_record[_key] <- _val;
      }

      loader.close();

      if (getCharacterNums() == 0) {
        foreach (fid, _ in this.furniture_amount_table) {
          ::gamesession.getUserDataLocal().addNewItem(ITEM_TYPE_FURNITURE, fid);
        }
        ::gamesession.saveUserDataLocal();
      }

      foreach (_chara_data in this.character_table) {
        _chara_data.setupEnableCharaSentenceList(true);
      }

      ::gamesession.getUserDataLocal().setupRoomMotion();
    }

    function forARTest() {
      local _cosId = 101004;

      local _cd = ::CostumeData.createCostumeData(_cosId, true);
      addCostumeData(_cd, true, false);
      addRoom(1);
      rooms[0].addResideChara(_cosId);
    }
  }

}