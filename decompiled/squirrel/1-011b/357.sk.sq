class ConfirmProductDialog extends ::Dialog {
  product_data = null;

  img_fur_icon = null;
  img_cos_icons = null;

  timelabel = null;

  view = null;
  lbl_name = null;
  lbl_remain = null;
  btn_shorten = null;
  btn_interrupt = null;
  btn_cancel = null;

  gauge_time = null;
  pnl_mouseevent = null;

  constructor() {
    super(::loadSKView("/ui/dialog/ConfirmProductDialog.ui"));

    this.pnl_mouseevent = this.view.findChild("pnl_mouseevent");
    this.pnl_mouseevent.addEventListener(MOUSE_EVENT, mouseevent);

    this.lbl_name = this.view.findChild("lbl_name");
    this.lbl_remain = this.view.findChild("pnl_info").findChild("lbl_time");

    this.btn_shorten = this.view.findChild("btn_shorten");
    ::TapButton(this.btn_shorten).view.addEventListener(ACTION_EVENT, actionevent_product);

    this.btn_interrupt = this.view.findChild("btn_interrupt");
    ::TapButton(this.btn_interrupt).view.addEventListener(ACTION_EVENT, actionevent_product);

    this.view.findChild("lbl_title").setText(::dict.get("room_member_producting"));
    this.view.findChild("lbl_product_cos").setText(::dict.get("producting_costume"));

    timelabel = null;
    gauge_time = null;
  }

  function setProductData(data) {
    this.product_data = data;

    local fd = ::gamesession.getUserData().getFurnitureData(this.product_data.getProducerID());

    this.lbl_name.setText(fd.getCurrentName());

    local _remain = this.product_data.getRemainTime(::getServerTime());
    local max_time = this.product_data.getProductTime();
    this.gauge_time = ::ValueGauge(this.view.findChild("pnl_info").findChild("gauge_time"));
    this.gauge_time.init(max_time - _remain, max_time);

    this.timelabel = ::TimeLabel(this.lbl_remain, _remain);
    this.timelabel.setEndFunc(setTimeEnd.bindenv(this));
    this.timelabel.setRepeatFunc(updateTimeGauge.bindenv(this), 1000);
    this.timelabel.startCountDown();

    local _pnl = this.view.findChild("pnl_icon");
    local _sp = ::getSprite(fd.getCurrentIconPath());
    _sp.blend = SK_MIX;
    this.img_fur_icon = SKImageView(_sp);
    this.img_fur_icon.setRect(0, 0, _pnl.bnd.w, _pnl.bnd.h);
    _pnl.addChild(this.img_fur_icon);

    this.img_cos_icons = [];

    local _pnl_cos = this.view.findChild("pnl_cos_icon");
    local cos_ids = this.product_data.getCostumeIDList();
    local offset = 0;
    foreach (idx, cos_id in cos_ids) {
      local icon = SKImageView();
      icon.setRect(offset, 0, 80, 80);
      ::CostumeIcon(cos_id, icon);

      this.img_cos_icons + icon;
      _pnl_cos.addChild(icon);

      offset += 90;
    }
  }

  function setTimeEnd() {
    this.lbl_remain.setText(::dict.get("product_finished"));
    this.timelabel.resetRepeatFunc();
    this.gauge_time.setCurrentValue(this.gauge_time.max_value);
  }

  function updateTimeGauge() {
    local max_time = this.product_data.getProductTime();
    local remain = this.timelabel.getRemainTime();
    this.gauge_time.setCurrentValue(remain);
  }

  function actionevent_product(e) {
    e.consume();

    local scene = ::gamesession.getCurrentScene();
    local pm = scene.getProductionManager();

    if (this.product_data.isFinishedAtState()) {
      local dlg = ::SimpleDialog2();
      dlg.lbl_msg.textbox.wrapmode = 1;
      dlg.lbl_msg.setText(::dict.get("product_finished_tohome"));
      dlg.lbl_caution.setText("");
      dlg.show();

      while (!dlg.isClosing()) {
        suspend();
      }
      if (dlg.ret > 0) {
        _moveFurnitureFocusPanel();
      }
      return;
    }

    switch (e.src) {
    case this.btn_shorten:
      local dlg = ::SimpleDialog2();
      local _complete_text = null;
      switch (product_data.getType()) {
      case ::ProductData.TYPE_PRODUCT:
        dlg.lbl_msg.setText(::dict.get("confirm_shortentime_product"));
        dlg.lbl_caution.setText(::dict.get("confirm_caution_product"));
        _complete_text = ::dict.get("product_shorten");
        break;
      case ::ProductData.TYPE_LEVELUP:
        dlg.lbl_msg.setText(::dict.get("confirm_shortentime_levelup"));
        dlg.lbl_caution.setText(::dict.get("confirm_caution_levelup"));
        _complete_text = ::dict.get("product_shorten_levelup");
        break;
      case ::ProductData.TYPE_DELIVER:
        dlg.lbl_msg.setText(::dict.get("confirm_shortentime_deliver"));
        dlg.lbl_caution.setText(::dict.get("confirm_caution_deliver"));
        _complete_text = ::dict.get("product_shorten_deliver");
        break;
      }
      local remaining = this.product_data.getRemainTime(::getServerTime());
      dlg.setShorten(remaining, ::SimpleDialog2.TYPE_PRODUCT);
      dlg.show();
      if (!dlg.ret) return;

      while (!dlg.isClosing()) {
        suspend();
      }
      if (dlg.ret > 0) {
        local is_succes = pm.shortenProductTime(this.product_data.getProducerID());
        if (!is_succes) return;

        _moveFurnitureFocusPanel();
        ::gamesession.messagelayer.closeAllMessage();

        local _message = ::Message();
        _message.setMsec(4 * 1000);
        _message.setText(_complete_text);
        _message.setFontSize(32);
        _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
        _message.show();
      }

      break;
    case this.btn_interrupt:
      local dlg = ::SimpleDialog2();
      dlg.lbl_msg.setText(::dict.get("product_cancel"));
      dlg.lbl_caution.setText(::dict.get("product_cancel_caution"));
      dlg.show();

      while (!dlg.isClosing()) {
        suspend();
      }
      if (dlg.ret > 0) {
        local is_succes = pm.cancelProduct(this.product_data.getProducerID());
        if (is_succes) {
          this.ret = 1;
          close();

          local _message = ::Message();
          _message.setMsec(4 * 1000);

          switch (product_data.getType()) {
          case ::ProductData.TYPE_PRODUCT: _message.setText(::dict.get("product_interrupted")); break;
          }
          _message.setFontSize(32);
          _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
          _message.show();
        }
      }

      break;
    }
  }

  function _moveFurnitureFocusPanel() {
    local _ud = ::gamesession.getUserData();
    local scene = ::gamesession.getCurrentScene();
    if (getclass(scene) != ::SanrioGameScene) return;
    if (this.product_data.getRoomIndex() != _ud.getCurrentRoomIndex()) {
      scene.selectRoom(this.product_data.getRoomIndex());
    }

    local model = scene.getStage().house_manager.getFurnitureLayoutManager().getFurnitureModel(this.product_data.getProducerID());
    scene.getUI().movePanel(::FurnitureFocusPanel, false, { "model" = model });
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_RELEASED:
      close();
      break;
    }
  }
}