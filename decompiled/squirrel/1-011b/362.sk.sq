class CostumeRequestDialog extends ::Dialog {
  static GAUGE_TIMELIMIT_MAX = 10 * 60;
  static INTERVAL_COUNT1 = 1 * 60 * 60;
  static INTERVAL_COUNT2 = 30 * 60;
  static INTERVAL_COUNT3 = 10 * 60;

  data = null;
  time_label = null;
  gauge_limit = null;

  last_interval_count = null;

  view = null;
  img_icon = null;

  constructor() {
    super(::loadSKView("/ui/dialog/CostumeRequestDialog.ui"));

    this.img_icon = this.view.findChild("img_icon");

    local _pnl_mouseevent = this.view.findChild("pnl_mouseevent");
    _pnl_mouseevent.addEventListener(MOUSE_EVENT, mouseevent);

    this.btn_close.findChild("lbl_close").setText(::dict.get("close"));
    this.view.findChild("pnl_reward").findChild("lbl_reward").setText(::dict.get("costumerequest_reward"));

    this.last_interval_count = -1;
  }

  function setCostumeRequestData(data) {
    this.data = data;

    local now = ::getServerTime();

    local cos_setting = ::gamesetting.costume_settings[this.data.getCostumeID()];
    local chara_setting = ::gamesetting.sanrio_chara_settings[cos_setting.getCharaID()];
    local chara_name = chara_setting.getName();

    this.img_icon.setSprite(chara_setting.getIconSprite());
    this.img_icon.updateLayout();

    this.view.findChild("lbl_title").setText(::dict.get("costumerequest_chara", [chara_name]));

    if (this.data.isStartedRequest(now)) {
      local _need_time = true;
      if (this.data.isStateNew()) {
        this.view.startMethod("setNew");

        this.view.findChild("pnl_unknown").findChild("lbl_desc").setText(::dict.get("costumerequest_tellchara", [chara_name]));

      } else {
        if (this.data.isStateCleared()) {
          this.view.startMethod("setCleared");
          local _pnl = this.view.findChild("pnl_cleared");
          _pnl.findChild("lbl_txt").setText(::dict.get("costumerequest_cleared"));
          local _pnl_icon = _pnl.findChild("pnl_icon");
          local _oyugi = _pnl_icon.findChild("quest_oyugi");
          local _work = _pnl_icon.findChild("quest_work");
          switch (this.data.getRequestType()) {
          case ::CostumeRequestSetting.TYPE_OYUGI: _work.setVisible(false); break;
          case ::CostumeRequestSetting.TYPE_WORK: _oyugi.setVisible(false); break;
          }

          _need_time = false;
        } else {
          this.view.startMethod("setRecieved");
        }
        local cr_setting = ::gamesetting.costume_request_settings[this.data.getID()];
        this.view.findChild("pnl_desc").findChild("lbl_desc").setText(cr_setting.getDesc());
      }
      if (_need_time) {

        local _remain = this.data.getRemainTimeLimit(now);
        local _pnl = this.view.findChild("pnl_timelimit");
        this.time_label = ::TimeLabel(_pnl.findChild("lbl_time"), _remain, 2);

        this.gauge_limit = ::ValueGauge(_pnl.findChild("gauge_time"));
        if (_remain > GAUGE_TIMELIMIT_MAX) {
          this.gauge_limit.init(0, GAUGE_TIMELIMIT_MAX);
        } else {
          local _elapse = this.data.getTimeLimitMin() * 60 - _remain;
          this.gauge_limit.init(_elapse, GAUGE_TIMELIMIT_MAX);
        }
        this.time_label.setRepeatFunc(_updateTimelimitGauge.bindenv(this), 1000);
        this.time_label.startCountDown();

        _pnl.findChild("lbl_txt").setText(::dict.get("costumerequest_timelimit_made"));
      }

      _setRewardItemList();

    } else {
      this.view.startMethod("setInterval");
      local _pnl = this.view.findChild("pnl_interval");

      local _remain = this.data.getRemainInterval(now);
      this.time_label = ::TimeLabel(_pnl.findChild("lbl_time"), _remain, 2);
      this.time_label.setRepeatFunc(_updateIntervalCount.bindenv(this), 1000);
      this.time_label.startCountDown();

      _updateIntervalCount();

      this.view.findChild("lbl_no_request").setText(::dict.get("costumerequest_interval_now"));
      _pnl.findChild("lbl_txt").setText(::dict.get("costumerequest_nextrequest_made"));

    }
  }

  function _setRewardItemList() {
    local _pnl = this.view.findChild("pnl_reward");
    local _pnl_list = _pnl.findChild("pnl_reward_list");

    local offset = 0;
    foreach (reward in this.data.getRewards()) {
      local icon = ::RewardIcon(reward.kind, reward.id, reward.num);
      icon.setRect(0, 0, 60, 60);
      icon.view.pos.x = offset;
      _pnl_list.addChild(icon.view);

      offset += icon.view.bnd.w + 10;
    }

  }

  function _updateTimelimitGauge() {
    local now = ::getServerTime();
    local _remain = this.data.getRemainTimeLimit(now);
    if (_remain > GAUGE_TIMELIMIT_MAX) return;

    local _elapse = this.data.getTimeLimitMin() * 60 - _remain;
    this.gauge_limit.init(_elapse, GAUGE_TIMELIMIT_MAX);
  }

  function _updateIntervalCount() {
    local now = ::getServerTime();
    local cnt = _getIntervalCount(this.data.getRemainInterval(now));
    if (cnt != this.last_interval_count) {
      this.last_interval_count = cnt;
      this.view.startMethod("setIntervalImage", this.last_interval_count);
    }
  }
  function _getIntervalCount(_remain) {
    if (_remain <= INTERVAL_COUNT3) {
      return 3;
    } else if (_remain <= INTERVAL_COUNT2) {
      return 2;
    } else if (_remain <= INTERVAL_COUNT1) {
      return 1;
    }
    return 0;
  }

  function mouseevent(e) {
    e.consume();
    if (e.id == MOUSE_RELEASED) close();
  }
}