class OutputSelectDialog extends ::Dialog {
  static TYPE_WORK = 0;
  static TYPE_PRODUCT = 1;

  lbl_msg = null;
  lbl_caution = null;
  btn_post = null;
  btn_save = null;
  lbl_rm_val = null;

  showed_func = null;

  constructor() {
    super(::loadSKView("/ui/dialog/OutputSelectDialog.ui"));
    lbl_msg = this.view.findChild("lbl_text_title");
    lbl_caution = this.view.findChild("lbl_text");

    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("cancel"));
    this.btn_post = this.view.findChild("btn_post");
    ::TapButton(this.btn_post).view.addEventListener(ACTION_EVENT, actionevent);
    this.btn_save = this.view.findChild("btn_save");
    ::TapButton(this.btn_save).view.addEventListener(ACTION_EVENT, actionevent);

    this.view.findChild("lbl_captured").setText(::dict.get("captured"));
    this.view.findChild("lbl_select_output").setText(::dict.get("select_output"));
    this.btn_post.findChild("lbl_post").setText(::dict.get("post_image"));
    this.btn_save.findChild("lbl_save").setText(::dict.get("save_image"));
    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("do_not_save"));

  }

  function setShowedFunc(func) {
    this.showed_func = func;
  }

  function actionevent(e) {
    switch (e.src) {
    case btn_post: this.ret = 1; break;
    case btn_save: this.ret = 2; break;
    }
    close();
    if (this.func) this.func(this.ret);
  }

  function showed() {
    if (showed_func) showed_func();
  }
}