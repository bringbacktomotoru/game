class SanrioSetting extends ::Setting {
  static PERMISSION_DENY = 0;
  static PERMISSION_ALLOW = 1;
  static PERMISSION_LIMIT = 2;
  permission = 0;

  function getPermission() {
    return this.permission;
  }

  function isDeny() {
    return this.permission == PERMISSION_DENY ? true : false;
  }

  function isAllow() {
    return this.permission == PERMISSION_ALLOW ? true : false;
  }
}