class FlickChecker {

  static FLICK_RIGHT = 1;
  static FLICK_LEFT = 2;

  start_time = null;
  startx = null;
  starty = null;
  lastx = null;
  lasty = null;
  flick_direct = null;

  constructor() {
    this.start_time = skGetTime();
    this.startx = 0;
    this.starty = 0;
    this.flick_direct = 0;
  }

  function pressed(e) {
    this.startx = e.x;
    this.starty = e.y;
    this.flick_direct = 0;
  }

  function dragged(e) {
    if (this.flick_direct == 0) {
      if (e.x < this.startx - 10) {
        this.flick_direct = 2;
        this.start_time = skGetTime();
      }
      else if (e.x > this.startx + 10) {
        this.flick_direct = 1;
        this.start_time = skGetTime();
      }
    }
  }

  function released(e) {
    local _angle = Math.atan2(e.x - this.startx, e.y - this.starty) * 180 / Math.PI;
    if (start_time + 200 > skGetTime()) {
      if (this.flick_direct == 1 && ((this.startx + 150) < e.x) && (60 < _angle && _angle < 120)) {
        return FLICK_LEFT;
      }
      else if (this.flick_direct == 2 && (this.startx - 150 > e.x) && ((-120) < _angle && _angle < (-60))) {
        return FLICK_RIGHT;
      }
    }
    return -1;
  }

}