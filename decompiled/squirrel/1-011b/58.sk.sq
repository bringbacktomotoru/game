class ResTranslater {
  static TYPE_DICT = 0;
  static TYPE_TALK = 1;

  jp = null;
  diff = null;
  trans = null;

  type = null;
  type_name = null;

  constructor(type) {

    this.type = type;
    switch (type) {
    case TYPE_DICT:
      type_name = "dict";

      jp = Dict();
      jp.runsk("tool_translater/res/dict/jp_new/dict.conf");

      diff = Dict();
      if (::getResource("tool_translater/res/dict/diff/dict.conf")) {
        diff.runsk("tool_translater/res/dict/diff/dict.conf");
      }
      trans = Dict();
      if (::getResource("tool_translater/res/dict/trans/dict.conf")) {
        trans.runsk("tool_translater/res/dict/trans/dict.conf");
      }
      break;
    case TYPE_TALK:
      type_name = "talk";

      jp = Talk();
      jp.runsk("tool_translater/res/talk/jp_new/talk.conf");

      diff = Talk();
      if (::getResource("tool_translater/res/talk/diff/talk.conf")) {
        diff.runsk("tool_translater/res/talk/diff/talk.conf");
      }
      trans = Talk();
      if (::getResource("tool_translater/res/talk/trans/talk.conf")) {
        trans.runsk("tool_translater/res/talk/trans/talk.conf");
      }
    }
  }

  function translate() {
    _createTransFile();
    _createDiffFile();
  }

  function _createTransFile() {
    local file = FileRef(skGetCurrentDir() + "/project/tool_translater/res/" + type_name + "/trans/" + type_name + ".conf");
    local sbuf = StringBuffer();

    switch (type) {
    case TYPE_DICT:
      sbuf = _makeDictTextBuffer(sbuf);
      break;
    case TYPE_TALK:
      sbuf = _makeTalkTextBuffer(sbuf);
      break;
    }

    local bb = ByteBuffer();
    bb.putText(string(sbuf));
    bb.pos = 0;
    file.save(bb);
  }

  function _makeDictTextBuffer(sbuf) {
    local keys = [];
    foreach (key, val in jp.dict_table) {
      keys + key;
    }
    keys = ::sortBy(keys, function(key) { return key });
    for (local i = 0; i < keys.len(); i++) {
      local key = keys[i];
      local txt = "\tdict_table[\"" + key + "\"] <-";
      if (_checkValue(jp.dict_table[key], diff.dict_table[key])) {
        txt = txt + "\"" + trans.dict_table[key] + "\"\n";
      } else {
        txt = "#N" + txt + "\"" + jp.dict_table[key] + "\"\n";
      }
      sbuf + txt;
    }
    return sbuf;
  }

  function _makeTalkTextBuffer(sbuf) {
    local keys = [];
    foreach (key, val in jp.talk_table) {
      keys + key;
    }
    keys = ::sortBy(keys, function(key) { return key });

    for (local i = 0; i < keys.len(); i++) {
      local key = keys[i];

      local txt = "talk_table[\"" + key + "\"] <- {\n";
      sbuf + txt;

      foreach (name, list in jp.talk_table[key]) {
        local c_txt = "\t\"" + name + "\" = [\n";
        sbuf + c_txt;

        for (local j = 0; j < list.len(); j++) {
          local t_txt = "\t\t";
          if (_checkValue(jp.talk_table[key][name][j], diff.talk_table[key][name][j])) {
            t_txt = t_txt + "\"" + trans.talk_table[key][name][j] + "\",\n";
          } else {
            t_txt = "#N" + t_txt + "\"" + jp.talk_table[key][name][j] + "\",\n";
          }
          sbuf + t_txt;
        }
        sbuf + "\t]\n"
      }
      sbuf + "}\n\n"
    }
    return sbuf;
  }

  function _createDiffFile() {
    local file = FileRef(skGetCurrentDir() + "/project/tool_translater/res/" + type_name + "/diff/" + type_name + ".conf");
    local sbuf = StringBuffer();

    if (type == TYPE_DICT) {
      local keys = [];
      foreach (key, val in jp.dict_table) {
        keys + key;
      }
      keys = ::sortBy(keys, function(key) { return key });
      for (local i = 0; i < keys.len(); i++) {
        local key = keys[i];
        local txt = "\tdict_table[\"" + key + "\"] <-";
        txt = txt + "\"" + jp.dict_table[key] + "\"\n";
        sbuf + txt;
      }
    } else {
      local keys = [];
      foreach (key, val in jp.talk_table) {
        keys + key;
      }
      keys = ::sortBy(keys, function(key) { return key });
      for (local i = 0; i < keys.len(); i++) {
        local key = keys[i];

        local txt = "talk_table[\"" + key + "\"] <- {\n";
        sbuf + txt;

        foreach (name, list in jp.talk_table[key]) {
          local c_txt = "\t\"" + name + "\" = [\n";
          sbuf + c_txt;

          for (local i = 0; i < list.len(); i++) {
            local t_txt = "\t\t";
            t_txt = t_txt + "\"" + jp.talk_table[key][name][i] + "\",\n";
            sbuf + t_txt;
          }
          sbuf + "\t]\n"
        }
        sbuf + "}\n\n"
      }
    }
    local bb = ByteBuffer();
    bb.putText(string(sbuf));
    bb.pos = 0;
    file.save(bb);
  }

  function _checkValue(val1, val2) {
    return val1 == val2 ? true : false;
  }

}

class ResTranslater.Dict {
  dict_table = null;

  constructor() {
    dict_table = {};
  }

  function getTable() {
    return dict_table;
  }
  function getTableName() {
    return "dict_table";
  }
}

class ResTranslater.Talk {
  talk_table = null;

  constructor() {
    talk_table = {};
  }

  function getTable() {
    return talk_table;
  }
  function getTableName() {
    return "talk_table";
  }
}