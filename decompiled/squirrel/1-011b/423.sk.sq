class FilePathManager {
  static FILE_TYPE_LOG = 1;
  static FILE_TYPE_IMAGE = 2;
  static FILE_TYPE_VIDEO = 3;
  static FILE_TYPE_CACHE_IMAGE = 4;
  static FILE_TYPE_THUMBNAIL = 5;

  static APPLICATION_MODE_NONE = 0;
  static APPLICATION_MODE_GAME = 1;
  static APPLICATION_MODE_AR = 2;

  function getFilePath(file_type, app_mode) {
    local _path = "";
    local _os_name = skGetOSName();

    switch (file_type) {
    case ::FilePathManager.FILE_TYPE_LOG:

      _path = _path + skGetDataDir();
      break;
    case ::FilePathManager.FILE_TYPE_CACHE_IMAGE:
      _path = _path + skGetDataDir() + "/image_cache";
      local _ref = FileRef(_path);
      if (!_ref.exists()) _ref.mkdirs();
      break;
    case ::FilePathManager.FILE_TYPE_THUMBNAIL:
      _path = _path + skGetDataDir() + "/thumbnail";
      local _ref = FileRef(_path);
      if (!_ref.exists()) _ref.mkdirs();
      break;
    case ::FilePathManager.FILE_TYPE_IMAGE:
    case ::FilePathManager.FILE_TYPE_VIDEO:
      if (_os_name.equals("iOS") || _os_name.equals("Android")) _path = _path + ARUtils.getSaveImageDirectory();
      else {
        _path = "image/";
        local _ref = FileRef(_path);
        if (!_ref.exists()) _ref.mkdirs();
      }

      break;
    }
    _path = _path + "/";

    if (app_mode != ::FilePathManager.APPLICATION_MODE_NONE) {
      _path = _path + "Tomotoru/";

      local _ref = FileRef(_path);
      if (!_ref.exists()) _ref.mkdirs();

      switch (app_mode) {
      case ::FilePathManager.APPLICATION_MODE_GAME:
        _path = _path + "gamemode/";
        break;
      case ::FilePathManager.APPLICATION_MODE_AR:
        _path = _path + "armode/";
        break;
      }

      _ref = FileRef(_path);
      if (!_ref.exists()) _ref.mkdirs();
    }

    return _path;
  }

}

function makeFilename(extension) {
  local date = ::getServerDate();
  local dst = sprintf("%04d%02d%02d%02d%02d%02d.%s", date.tm_year, date.tm_mon + 1, date.tm_mday, date.tm_hour, date.tm_min, date.tm_sec, extension);
  return dst;
}