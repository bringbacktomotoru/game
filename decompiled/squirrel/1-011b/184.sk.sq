class FurnitureLayouter {
  static house_base_pos = ::HouseManager.getHouseBasePos();
  static DRAGGING_FREQUENCY = 6;
  static CAN_MOVE_DIRECTION = 50;

  house_manager = null;

  room_uid = -1;
  room_info = null;

  stage = null;
  camera = null;

  editing_furniture = null;
  start_view_index = -1;
  is_same_dir_dragging = false;
  offset_move_x = 0;
  offset_move_y = 0;

  camera_extent_rect = null;
  tapped_screen_x = 0.0;
  tapped_screen_y = 0.0;
  tap_offset = null;
  last_dragging_time = 0;
  dragging_distance = 0;

  v_1 = Vector3D();

  constructor(stage) {
    this.stage = stage;
    this.camera = stage.renderer.camera;
    this.house_manager = stage.getHouseManager();

    setupRoomInfo(-1);

    camera_extent_rect = Rect2D(0, 0, ::viewWidth * 0.8, ::viewHeight * 0.8);

    camera_extent_rect.x = -camera_extent_rect.w / 2.0 + ::screenWidth / 2.0;
    camera_extent_rect.y = -camera_extent_rect.h / 2.0 + ::screenHeight / 2.0;

    dragging_distance = ::FurnitureLayoutManager.FURNITURE_MODE_DIST / 2.0;
  }

  function setupRoomInfo(room_idx = -1) {
    local room = this.house_manager.rooms[room_idx];
    if (!room) room = this.house_manager.getCurrentRoom();
    if (!room) {
      this.room_uid = -1;
      return;
    }

    this.room_uid = room.room_uid;
    this.room_info = room.getRoomInfo();
  }

  function setEditFurniture(edit_model) {
    if (this.editing_furniture == edit_model) return;
    if (this.editing_furniture) {

      _toStartCondition();
    }

    this.editing_furniture = edit_model;
    this.start_view_index = edit_model.model.getFurnitureData().getCurrentViewIndex();
  }

  function enableAddFurniture() {
    if (!this.room_info) return false;
    return this.room_info.enableAddFurniture();
  }

  function resetFurniture() {
    setEditFurniture(null);
  }

  function resetDraggingFurniture() {
    is_same_dir_dragging = false;
  }

  function canFixFurniture(furniture_model) {

    local layout_data = furniture_model.getLayoutData();
    local furniture_id = furniture_model.getFurnitureSettingId();
    this.room_info.addFurniture(layout_data, furniture_id);
    this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_INVALIDATE + ::RoomInfo.SETUP_CONNECT);
    local res = this.room_info.checkAllNodeConnected();
    this.room_info.removeFurniture(layout_data.getUID());
    this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_INVALIDATE + ::RoomInfo.SETUP_CONNECT);

    return res;
  }

  function _applyFurnitureLayout(edit_model) {
    local model = edit_model.model;
    local layout_data = model.getLayoutData();
    if (this.room_info.hasFurnitureInfo(layout_data.getUID())) {
      this.room_info.updateFurnitureInfo(layout_data);

      this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_INVALIDATE + ::RoomInfo.SETUP_CONNECT);
    }
    else {
      local furniture_id = model.getFurnitureSettingId();
      this.room_info.addFurniture(layout_data, furniture_id);

      this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_INVALIDATE + ::RoomInfo.SETUP_CONNECT);
    }
  }

  function fixFurnitureLayout(edit_model) {
    _applyFurnitureLayout(edit_model);
    return true;
  }
  function fixEditingFurnitureLayout() {
    if (!this.editing_furniture) return false;
    return fixFurnitureLayout(this.editing_furniture);
  }

  function cancelFurnitureLaout(edit_model) {
    _applyFurnitureLayout(edit_model);
  }
  function cancelEditingFurnitureLayout() {
    if (!this.editing_furniture) return;
    cancelFurnitureLaout(this.editing_furniture);
  }

  function changeFurnitureView(edit_model) {

  }

  function removeFurniture(edit_model) {
    local model = edit_model.model;
    local layout_data = model.getLayoutData();

    local furniture_uid = layout_data.getUID();
    local removed = this.room_info.removeFurniture(furniture_uid);
    if (removed) {
      this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_INVALIDATE + ::RoomInfo.SETUP_CONNECT);
    }
    else {
      this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_CONNECT);
    }
  }

  function updateDraggingFurniture() {
    if (!is_same_dir_dragging) return;

    if (skGetTime() - last_dragging_time < (1.0 / 60) * 1000 * (60.0 / DRAGGING_FREQUENCY)) {
      return;
    }

    local o = this.house_base_pos;

    this.v_1.set(_s2wPos(tapped_screen_x + offset_move_x, tapped_screen_y + offset_move_y, o.y)).sub(o.x, o.y, o.z);

    local _mx = v_1.x;
    local _mz = v_1.z;
    if (tap_offset) {
      _mx -= tap_offset.x;
      _mz -= tap_offset.z;
    }
    moveFurniture(editing_furniture, _mx, _mz, true);

  }

  function moveFurniture(edit_model, x, z, is_auto_update = false) {
    setEditFurniture(edit_model);
    if (!this.room_info || !this.editing_furniture) return false;

    local grid_length = ::RoomInfo.Grid.GRID_LENGTH;
    local model = this.editing_furniture.model;
    local pos = model.getPos();
    local init_x = pos.x;
    local init_z = pos.z;

    local _ld = model.getLayoutData();
    if (_ld) {
      local furniture_uid = _ld.getUID();
      local removed = this.room_info.removeFurniture(furniture_uid);
      if (removed) {
        this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_INVALIDATE);
      }
    }

    local _oldpos = clone model.getPos();
    local moved = this.room_info.calcFurniturePos(edit_model, x, z, model.getAngle());
    local apply_pos = true;
    if (!moved) {

      moved = true;
      local start_x = pos.x;
      local start_z = pos.z;
      local is_x_plus = start_x < x;
      local is_z_plus = start_z < z;
      local curr_x = start_x;
      local curr_z = start_z;
      local calc_x, calc_z;
      local calcsq;
      local distsq = (x - curr_x) * (x - curr_x) + (z - curr_z) * (z - curr_z);
      while (moved) {
        calc_z = is_z_plus ? curr_z + grid_length : curr_z - grid_length;
        calcsq = (x - curr_x) * (x - curr_x) + (z - calc_z) * (z - calc_z);
        if (distsq < calcsq) break;

        distsq = calcsq;

        moved = this.room_info.calcFurniturePos(edit_model, curr_x, calc_z, model.getAngle());
        if (moved) {
          curr_z = calc_z;
        }
        else if (curr_x != x) {
          calc_x = is_x_plus ? curr_x + grid_length : curr_x - grid_length;

          moved = this.room_info.calcFurniturePos(edit_model, calc_x, curr_z, model.getAngle());
          if (moved) {
            curr_x = calc_x;
          }
        }
      }
      local end_x = curr_x;
      local end_z = curr_z;

      curr_x = start_x;
      curr_z = start_z;
      distsq = (x - curr_x) * (x - curr_x) + (z - curr_z) * (z - curr_z);
      while (moved) {
        calc_x = is_x_plus ? curr_x + grid_length : curr_x - grid_length;
        calcsq = (x - calc_x) * (x - calc_x) + (z - curr_z) * (z - curr_z);
        if (distsq < calcsq) break;

        distsq = calcsq;

        moved = this.room_info.calcFurniturePos(edit_model, calc_x, curr_z, model.getAngle());
        if (moved) {
          curr_x = calc_x;
        }
        else if (curr_z != z) {
          calc_z = is_z_plus ? curr_z + grid_length : curr_z - grid_length;

          moved = this.room_info.calcFurniturePos(edit_model, curr_x, calc_z, model.getAngle());
          if (moved) {
            curr_z = calc_z;
          }
        }
      }

      local vertical_move = (x - end_x) * (x - end_x) + (z - end_z) * (z - end_z) < (x - curr_x) * (x - curr_x) + (z - curr_z) * (z - curr_z);
      if (vertical_move) {
        this.room_info.calcFurniturePos(edit_model, end_x, end_z, model.getAngle());
      }
      else {
        this.room_info.calcFurniturePos(edit_model, curr_x, curr_z, model.getAngle());
      }
    }

    local half_gl = grid_length / 2.0;
    if (pos.x > init_x - half_gl && pos.x < init_x + half_gl && pos.z > init_z - half_gl && pos.z < init_z + half_gl) return false;

    if (apply_pos) model.applyPos();

    local _pos = model.getPos();

    local _tapped_pos = Vector3D(tapped_screen_x * getViewScale(), tapped_screen_y * getViewScale(), 0.0);
    local _moved_pos = Vector3D((tapped_screen_x + offset_move_x * getDisplayScale()) * getViewScale(), (tapped_screen_y + offset_move_y * getDisplayScale()) * getViewScale(), 0.0);
    local _v2 = _moved_pos - _tapped_pos;

    local _flag = _bndcheck(_moved_pos);
    if (_flag) {
      is_same_dir_dragging = false;
      offset_move_x = 0;
      offset_move_y = 0;
      return true;
    }

    if (!is_auto_update) {

      local _o = Vector3D(stage.camera_work.target.pos);
      local _p = _o + Vector3D(0, 0, dragging_distance);
      local _q = Vector3D(stage.camera_work.camera.pos);
      local _sc_o = this.camera.project(_o);
      local _sc_p = this.camera.project(_p);
      local _sc_q = this.camera.project(_q);
      _sc_o.x *= ::screenWidth; _sc_o.y *= ::screenHeight;
      _sc_p.x *= ::screenWidth; _sc_p.y *= ::screenHeight;
      _sc_q.x *= ::screenWidth; _sc_q.y *= ::screenHeight;
      local _dist = (_sc_o - _sc_p).length();
      local _dist2 = (_sc_o - _sc_q).length();

      local _len = (stage.camera_work.target.pos - stage.camera_work.camera.pos).length();

      offset_move_x = _moved_pos.x < camera_extent_rect.x ? -_dist * 1.15 : _moved_pos.x > camera_extent_rect.x + camera_extent_rect.w ? _dist * 1.1 : 0;
      offset_move_y = _moved_pos.y < camera_extent_rect.y ? -_dist * 0.75 : _moved_pos.y > camera_extent_rect.y + camera_extent_rect.h ? _dist * 1.25 : 0;
      is_same_dir_dragging = true;
    } else {
      local _v1 = _pos - _oldpos;
      if (_v1.length() < 0.05) {

        return true;
      }

      local _sc_old_pos = this.camera.project(_oldpos);
      local _sc_pos = this.camera.project(_pos);
      _sc_pos.x *= ::screenWidth;
      _sc_pos.y *= ::screenHeight;
      _sc_old_pos.x *= ::screenWidth;
      _sc_old_pos.y *= ::screenHeight;
      local _v3 = _sc_pos - _sc_old_pos;
      local _cos = _v2.dot(_v3) / (_v2.length() * _v3.length());

      if (Math.acos(_cos) * Math.RTOD >= CAN_MOVE_DIRECTION) {

        return true;
      }

      stage.camera_work.moveTargetXYZ(_v1.x, _v1.y, _v1.z, true);
      last_dragging_time = skGetTime();
    }

    return true;
  }

  function moveFurnitureToPuttablePlace(edit_model, x, z) {
    local model = edit_model.model;
    if (model.getFurnitureSetting().isOverlaid()) return;

    if (!model.layout_data) {
      local _origin = this.stage.getHouseManager().getHouseBasePos();
      local model_pos = model.getPos();
      local tmp_fld = ::FurnitureLayoutData.create(-1);
      tmp_fld.setAngle(model.getAngle());
      tmp_fld.setPosXYZ(model_pos.x + _origin.x, model_pos.y - _origin.y, model_pos.z + _origin.z);
      model.setupLayout(_origin, tmp_fld);
    }

    local total_node_num = this.house_manager.getCurrentRoom().getRoomInfo().getTotalNodeNum();
    local mover = class {
      static grid_length = ::RoomInfo.Grid.GRID_LENGTH;

      init_x = 0.0;
      init_z = 0.0;

      add_x = 0;
      add_z = 0;

      limit_x = 0;
      limit_z = 0;

      count_up = true;
      move_num = 1;
      move_count = 0;

      total_move_count = 0;
      total_move_limit = 99999;

      move_dist_idx = 0;
      move_dist = [[-1, 0], [0, 1], [1, 0], [0, -1]];

      edit_model = null;

      move_func = null;

      constructor(edit_model, x, z, all_nodes, move_func, move_limit = 99999) {
        this.edit_model = edit_model;
        this.init_x = x;
        this.init_z = z;
        this.limit_x = length(all_nodes[0]);
        this.limit_z = length(all_nodes);
        this.move_func = move_func;
        this.total_move_limit = move_limit;
      }
      function move() {
        if (this.total_move_count >= this.total_move_limit) return true;
        this.total_move_count++;

        local dist = this.move_dist[this.move_dist_idx];
        add_x += dist[0];
        add_z += dist[1];
        this.move_count++;
        if (this, move_count == this.move_num) {
          this.move_count = 0;
          this.count_up = !this.count_up;
          if (this.count_up) {
            this.move_num++;
          }
          this.move_dist_idx = (this.move_dist_idx + 1) % length(this.move_dist);
        }

        move_func(edit_model, x + add_x * grid_length, z + add_z * grid_length);
        return add_x > limit_x && add_z > limit_z;
      }
    }(edit_model, x, z, room_info.grid.all_nodes, moveFurniture.bindenv(this), total_node_num);

    local limit_time = skGetTime() + 2000;
    local time_check_count = 0;
    while (!mover.move()) {
      if (time_check_count++ % 6 == 0 && skGetTime() > limit_time) break;
      if (mover.edit_model.canFix() && canFixFurniture(mover.edit_model.model)) break;
    }
  }

  function _bndcheck(_pos) {

    return _pos.x < camera_extent_rect.x + camera_extent_rect.w && _pos.x > camera_extent_rect.x && _pos.y < camera_extent_rect.y + camera_extent_rect.h && _pos.y > camera_extent_rect.y;
  }

  function getTapScreenPosition(sx, sy) {
    local o = this.house_base_pos;
    this.v_1.set(_s2wPos(sx, sy, o.y)).sub(o.x, o.y, o.z);
    return { x = this.v_1.x, z = this.v_1.z };
  }

  function moveFurnitureToScreenPosition(edit_model, sx, sy, offset = null) {
    local o = this.house_base_pos;
    this.v_1.set(_s2wPos(sx, sy, o.y)).sub(o.x, o.y, o.z);

    local _mx = v_1.x;
    local _mz = v_1.z;
    if (offset) {
      _mx -= offset.x;
      _mz -= offset.z;
    }

    tapped_screen_x = sx;
    tapped_screen_y = sy;
    tap_offset = offset;

    moveFurniture(edit_model, _mx, _mz);
  }

  function rotateFurniture(edit_model, angle) {
    setEditFurniture(edit_model);
    if (!this.room_info || !this.editing_furniture) return;

    local model = this.editing_furniture.model;

    local _ld = model.getLayoutData();
    if (_ld) {
      local furniture_uid = _ld.getUID();
      local removed = this.room_info.removeFurniture(furniture_uid);
      if (removed) {
        this.room_info.setup(this.room_uid, ::RoomInfo.SETUP_INVALIDATE);
      }
    }

    local model_pos = model.getPos();
    local model_angle = model.getAngle();
    this.room_info.calcFurnitureRotate(edit_model, model_pos.x, model_pos.z, model_angle + angle);

    model.applyAngle();
  }

  function _s2wPos(x, y, d) {

    local _sk3dview = this.stage.sk3dview;
    local _ratex = (x - (_sk3dview.pos.x + _sk3dview.bnd.x)) / (_sk3dview.bnd.w * ::getDisplayScale());
    local _ratey = (y - (_sk3dview.pos.y + _sk3dview.bnd.y)) / (_sk3dview.bnd.h * ::getDisplayScale());
    local _v = Vector3D(_ratex, _ratey, 0.0);
    local _pos_near = this.camera.unproject(_v);

    _v.z = 1.0;
    local _pos_far = this.camera.unproject(_v);

    local _r = (d - _pos_near.y) / (_pos_far.y - _pos_near.y);
    local _world_x = _pos_near.x + (_pos_far.x - _pos_near.x) * _r;
    local _world_z = _pos_near.z + (_pos_far.z - _pos_near.z) * _r;

    return Vector3D(_world_x, d, _world_z);
  }

  function _toStartCondition() {
    local model = this.editing_furniture.model;
    model.resetLayout();

    local furniture_data = model.getFurnitureData();
    if (furniture_data.getCurrentViewIndex() != this.start_view_index) {
      furniture_data.setCurrentViewIndex(this.start_view_index);
      model.rebuild();
    }
  }
}