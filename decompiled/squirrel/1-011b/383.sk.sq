  function tutorialARCamera(setting) {
    local _scene = ::gamesession.getCurrentScene();
    local _stage = _scene.getStage();
    local _home_ui = _scene.getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();
    local _ud = ::gamesession.getUserData();

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.getSlideMenu().getButtonLayout().enabled = false;
    _home_ui.getSlideMenu().getButtonProperty().enabled = false;
    _home_ui.getSlideMenu().setEnabledBottomButton(false);

    _home_ui.setVisibleCameraRotateButton(false);
    _home_ui.showSlideMenu(false);
    _scene.setLockTapScene(true);

    _self.setCharaAppealLayerVisible(false);
    _self.setVisibleDiaryButton(false);

    sleep(1000);

    local _trans = MaskPanelTransition(::getTexture(::getLoadImagePath()), ::getTexture("/image/black.jpg"), 5.0, 50);
    _self.getHomeUI().movePanel(::LetterPanel, false, { "setting" = ::gamesetting.letter_settings[::TutorialSetting.TUTORIAL_LETTER_THIRD_ID] }, _trans);

    while (!(_self instanceof LetterPanel)) {
      suspend();
      _self = _home_ui.getCurrentPanel();
    }

    while (!(_self instanceof HomeTopPanel)) {
      suspend();
      _self = _home_ui.getCurrentPanel();
    }

    _self.setCharaAppealLayerVisible(false);
    _self.setVisibleDiaryButton(false);
    sleep(2000);

    local _dlg = ::ImageViewDialogNoTitle();
    _dlg.setNoReadFlag(false);
    _dlg.setImagePathList(setting.getImagePathList());
    _dlg.show();

    while (!_dlg.is_closing) {
      suspend();
    }

    sleep(500);

    _tl.showText(_texts[0]);
    sleep(750);
    _tl.waitTap();

    _tl.updateText(_texts[1]);
    sleep(250);
    _tl.waitTap();

    _tl.updateText(_texts[2], 4);

    local _btn = _home_ui.getButtonSlide();
    _tl.focusView(_btn, _home_ui, 300, 1.2, 1.2);
    _home_ui.setShowSlideMenuReservationLock(true);
    _home_ui.scroll.view.pos.y = 0;
    _home_ui.setLockScrollSlideMenu(true);

    sleep(250);
    _btn.setEnabled(true);

    this.setWaitActionEvent(_home_ui.getButtonSlide());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (_home_ui.isShowSlideMenu()) break;
    }

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setShowSlideMenuReservationLock(false);
    _tl.focusOut();
    sleep(500);

    _tl.updateText(_texts[3], 0);
    _btn = _home_ui.getSlideMenu().getButtonShop();
    _tl.focusView(_btn, _home_ui);

    this.setWaitActionEvent(_btn);
    while (this.isWaitingActionEvent()) {
      suspend();
      if (!(_home_ui.getCurrentPanel() instanceof HomeTopPanel)) break;
    }
    _home_ui.setShowSlideMenuLock(false);

    _tl.focusOut();
    _tl.hideText();

    while (!(_self instanceof ShopPanel)) {
      suspend();
      _self = _home_ui.getCurrentPanel();
    }

    sleep(500);

    _home_ui.getSlideMenu().setEnabledBottomButton(true);
    _home_ui.getSlideMenu().getButtonLayout().enabled = true;
    _home_ui.getSlideMenu().getButtonProperty().enabled = true;
    _home_ui.setLockScrollSlideMenu(false);
    _home_ui.getBackButton().setEnabled(false);
    _scene.setLockTapScene(false);

    _self.setEnabledButtonBack(false);
    _self.setTutorialLock2();

    local _tab = _self.getCostumeTab();
    _tl.showText(_texts[4], 5);
    _tl.focusView(_tab, _home_ui, 300, 1.2, 1.3);
    sleep(500);
    _tab.enabled = true;
    while (_self.getSelectTabIndex() != ::ShopPanel.TAB_COSTUME) {
      suspend();
    }

    _tl.focusOut();
    sleep(500);

    _tl.updateText(_texts[5]);
    _self.setTutorialLock();
    local _sc = _self.getShopCardFirst();
    _tl.focusView(_sc.getButtonView(), _home_ui, 300, 1.2, 1.3);

    sleep(500);
    _self.setCardListLock(false);

    this.setWaitActionEvent(_sc.getButtonView());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (_ud.getCostumeNum() > 1) break;
    }
    _tl.focusOut();
    _tl.hideText();

    local _dlg = ::gamesession.getFrontDialog();
    if (_dlg) {
      local _cancel = _dlg.getButtonCancel();
      if (_cancel) _cancel.enabled = false;
    }

    while (_ud.getCostumeNum() == 1) {
      suspend();
    }

    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.getBackButton().setEnabled(true);
    _home_ui.getSlideMenu().setEnabledBottomButton(true);
  }
}