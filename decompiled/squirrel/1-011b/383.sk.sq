class HomeTopPanel extends ::HomeUI.Panel {

  static need_panel_name = false;
  static need_history_clear = true;
  static need_camera = true;
  static need_camera_rotate = true;
  static need_camera_default = false;
  static need_ui_onoff = true;
  static need_back_layer = false;

  static need_money_layer = true;
  static need_rank_layer = true;

  static show_tapfloor_particle = true;
  static need_camera_record = true;
  static need_show_production_layer = true;
  static need_movear_button = true;

  static need_hapiness_info = false;
  static need_bonus_hapiness_info = true;

  static unique_move_sound = "";

  pnl_mouseevent_layer = null;
  pnl_lock_layer = null;
  chara_appeal_layer = null;
  talkballoon_layer = null;
  talkwindow_layer = null;

  lbl_event = null;
  btn_diary = null;
  pnl_clear_num = null;
  img_pm_clear = null;

  btn_help = null;

  function create() {
    return ::loadSKView("/ui/HomeTopPanel.ui", ::HomeTopPanel);

  }

  function loadFinished() {
    this.pnl_mouseevent_layer = findChild("pnl_mouseevent_layer");
    this.pnl_mouseevent_layer.pickable = false;
    this.pnl_lock_layer = findChild("pnl_lock_layer");
    setMouseEventLock(false);

    this.chara_appeal_layer = CharaAppealLayer(this.pnl_mouseevent_layer);

    local pnl_talkwindow_layer = findChild("pnl_talkwindow_layer");
    pnl_talkwindow_layer.pickable = false;
    this.talkwindow_layer = TalkWindowLayer(pnl_talkwindow_layer);
    this.talkwindow_layer.setScale(0.7);
    this.talkwindow_layer.setOffset(0, 2.0, 0);

    this.btn_help = findChild("btn_help");
    ::TapButton(this.btn_help).view.addEventListener(ACTION_EVENT, actionevent_help);
    local _ud = ::gamesession.getUserData();
    this.btn_help.visible = false;

    this.btn_diary = findChild("btn_diary");
    ::TapButton(this.btn_diary).view.addEventListener(ACTION_EVENT, actionevent_panelmission);

    this.pnl_clear_num = findChild("pnl_clear_num");
    this.pnl_clear_num.setVisible(false);

    this.img_pm_clear = findChild("img_pm_clear");
    this.img_pm_clear.setVisible(false);

    local _rule = ::gamesetting.game_rule;
    if (!_rule.disableTutorial()) {
      local _limit_id = TutorialSetting.TUTORIAL_LIMIT_PANEL_MISSION;
      if (_limit_id >= 0 && !_ud.isEndTutorialId(_limit_id)) this.btn_diary.visible = false;
    }
  }

  function added() {
    super.added();
    startMethod("show");
    registerMouseEventReceiver(this);

    local _stage = parent.parent.getStage();
    local _fm_table = _stage.getFurnitureModels();
    foreach (fuid, fm in _fm_table) {
      local _pd = fm.getProductData();
      if (!_pd) continue;

      if (_pd.isRewardStateBonus() && !_pd.isEndBonusHapiness()) {
        this.addHapinessProductBalloon(_pd);
      } else if (_pd.isRewardStateTap() && _pd.enableTapHapiness()) {
        this.addTapHapinessBalloon(_pd);
      }
    }

    local _cm_table = _stage.getCharacters();
    foreach (cid, cm in _cm_table) {
      if (cm.hasTappedScript()) {
        this.addHapinessBalloon(cm);
        continue;
      }
    }

    local _udl = ::gamesession.getUserDataLocal();
    if (!_udl.isShowedOPMovie()) {
      _udl.setShowedOPMovie();
      _udl.save();
    }

    local _ud = ::gamesession.getUserData();
    local _pmd = _ud.getCurrentPanelMission() || null;
    if (_pmd && _pmd.isShowEventSceneForce()) {
      setVisiblePanelMissionClearImage(true);
    } else {
      setVisiblePanelMissionClearImage(false);
    }
  }

  function removed() {
    super.removed();
    startMethod("hide");
    this.chara_appeal_layer.releaseAllBalloons();

    removeMouseEventReceiver(this);
  }

  function show() {
  }

  function showed() {
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _pmm = _scene.getPanelMissionManager();
      _pmm.updateNoSetMissionClearNumAtHomeTop();
    }
  }

  function setMouseEventLock(b) {
    this.pnl_lock_layer.visible = b;
  }
  function getMouseEventLock() {
    return this.pnl_lock_layer.visible;
  }

  function updateViewPanelMissionClearNum(num) {
    if (num <= 0) {
      this.pnl_clear_num.setVisible(false);
    } else {
      this.pnl_clear_num.findChild("lbl_num").setText(num);
      this.pnl_clear_num.setVisible(true);
      ::tutorial_manager.checkAndStartTutorialAtMissionMark(this);
    }

    local _udl = ::gamesession.getUserDataLocal();
    if (_udl.checkMissionEffect(num)) {
      if (!isMethodRunning()) startMethod("clear_mission");
      ::playSound(::SoundConstants.SOUND_MISSION_CLEAR);
    }
  }

  function setVisiblePanelMissionClearImage(b) {
    this.img_pm_clear.setVisible(b);
  }

  function setVisibleDiaryButton(b) {
    this.btn_diary.visible = b;
  }
  function setEnabledDiaryButton(b) {
    this.btn_diary.setEnabled(b);
  }

  function actionevent_resetcamera(e) {
    e.consume();

    local stage = ::gamesession.getCurrentScene().getStage();
    stage.setCameraDefault();
  }

  function actionevent_help(e) {
    e.consume();
    getHomeUI().movePanel(::HelpPanel);
  }

  function actionevent_panelmission(e) {
    e.consume();
    ::tutorial_manager.checkWaitingActionEvent(this.btn_diary);
    getHomeUI().movePanel(::PanelMissionPanel);
  }

  function mousePressed(event) {
    super.mousePressed(event);
    event.consume();

  }

  function mouseReleased(x, y) {
    super.mouseReleased(x, y);
    local game_scene = ::gamesession.getCurrentScene();
    if (game_scene instanceof SanrioGameScene) game_scene.sceneTapped(x, y);
  }
  function mouseDragged(vec_x, vec_y) {
    super.mouseDragged(vec_x, vec_y);
    if (!this.is_camerarotate) {
      local game_scene = ::gamesession.getCurrentScene();
      if (game_scene instanceof SanrioGameScene) game_scene.moveCamera_byScreenDist(vec_x, vec_y);
    }

  }
  function mousePinched(rate) {
    local game_scene = ::gamesession.getCurrentScene();
    game_scene.zoomCamera(Math.clamp(rate, 0.0, 2.0), true);
  }

  function longTapped(x, y) {
    super.longTapped(x, y);
    local game_scene = ::gamesession.getCurrentScene();
    if (game_scene instanceof SanrioGameScene) game_scene.sceneTapped(x, y, true);
  }
  function doubleTapped() {
    local game_scene = ::gamesession.getCurrentScene();
    if (game_scene instanceof SanrioGameScene) {
      local stage = game_scene.getStage();
      stage.zoomNextFixedRate();
    }
  }

  function addTalkWindow(sk3d, talk_key, chara_key, big = false, small = false) {

  }

  function addTalkWindowForce(sk3d, talk_key, chara_key, big = false, small = false) {

  }
  function removeAllTalkWindow() {
    talkwindow_layer.removeAllTalkWindow();
  }
  function removeTalkQueue(sk3d) {
    this.talkwindow_layer.removeQueue(sk3d);
  }

  function addAttractBalloon(cm) {
    this.chara_appeal_layer.addAttractBalloon(cm);
  }

  function addAttractApproachBalloon(cm) {
    this.chara_appeal_layer.addAttractApproachBalloon(cm);
  }

  function addNoticeBalloon(cm) {
    this.chara_appeal_layer.addNoticeBalloon(cm);
  }

  function addNoteBalloon(cm) {
    this.chara_appeal_layer.addNoteBalloon(cm);
  }

  function addFailuerBalloon(cm) {
    this.chara_appeal_layer.addFailuerBalloon(cm);
  }

  function addHapinessBalloon(cm) {
    this.chara_appeal_layer.addHapinessBalloon(cm);
  }

  function addHapinessProductBalloon(pd) {
    local _cid = pd.getCostumeIDList()[0];
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _stage = _scene.getStage();
      local _cm = _stage.getChara(_cid);
      this.chara_appeal_layer.addHapinessProductBalloon(_cm, pd);
    }
  }

  function addSelectFurnitureBalloon(cm) {
    this.chara_appeal_layer.addSelectFurnitureBalloon(cm);
  }

  function addApproachFurnitureBalloon(cm) {
    this.chara_appeal_layer.addApproachFurnitureBalloon(cm);
  }

  function addTapHapinessBalloon(pd) {
    local _cid = pd.getCostumeIDList()[0];
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _stage = _scene.getStage();
      local _cm = _stage.getChara(_cid);
      this.chara_appeal_layer.addTapHapinessBalloon(_cm, pd);

    }
  }

  function addWannaUseFurnitureBalloon(cm, tutorial_mode = false) {
    this.chara_appeal_layer.addWannaUseFurnitureBalloon(cm, tutorial_mode);
  }

  function getAppealBalloon(model) {
    return this.chara_appeal_layer.getBalloon(model);
  }
  function getHapinessBalloon(model) {
    return this.chara_appeal_layer.getHapinessBalloon(model);
  }
  function getHapinessBalloonByCostumeID(cid) {
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _stage = _scene.getStage();
      local _cm = _stage.getChara(cid);
      return this.chara_appeal_layer.getHapinessBalloon(_cm);
    }
    return null;
  }
  function getTapHapinessBalloon(pd) {
    local _cid = pd.getCostumeIDList()[0];
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _stage = _scene.getStage();
      local _cm = _stage.getChara(_cid);
      return this.chara_appeal_layer.getTapHapinessBalloon(_cm);
    }
    return null;
  }
  function getTapHapinessBalloonByCostumeID(cid) {
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _stage = _scene.getStage();
      local _cm = _stage.getChara(cid);
      return this.chara_appeal_layer.getTapHapinessBalloon(_cm);
    }
    return null;
  }
  function getTapHappinessBalloonByModel(cm) {
    return this.chara_appeal_layer.getTapHapinessBalloon(cm);
  }

  function getHapinessProductBalloon(pd) {
    local _cid = pd.getCostumeIDList()[0];
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _stage = _scene.getStage();
      local _cm = _stage.getChara(_cid);
      return this.chara_appeal_layer.getHapinessProductBalloon(_cm);
    }
    return null;
  }

  function getHapinessProductBalloonByModel(model) {
    return this.chara_appeal_layer.getHapinessProductBalloon(model);
  }

  function getWannaUseFurnitureBalloonByModel(model) {
    return this.chara_appeal_layer.getWannaUseFurnitureBalloon(model);
  }

  function getRecentlyAddedBalloonType() {
    return this.chara_appeal_layer.getRecentlyAddedType();
  }

  function hasCharaAppealBalloon(type) {
    return this.chara_appeal_layer.hasBalloon(type);
  }

  function setCharaAppealLayerVisible(b) {
    this.chara_appeal_layer.setVisible(b);
  }

  function setCharaAppealLayerEnabled(b) {
    this.chara_appeal_layer.setEnabled(b);
  }

  function tutorialWelcomTomotoru(setting) {

    local _self = ::gamesession.getCurrentScene().getUI().getCurrentPanel();
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _home_ui.getButtonSlide().setEnabled(false);

    sleep(1000);

    _tl.showText(_texts[0]);

    _tl.waitTap();
    sleep(200);
    _tl.updateText(_texts[1]);
    _tl.waitTap();

    _tl.hideText();

    local dlg = ::ImageViewDialogNoTitle();
    dlg.setNoReadFlag(false);
    dlg.setImagePathList(setting.getImagePathList());
    dlg.show();

    sleep(500);

    _home_ui.getButtonSlide().setEnabled(true);
  }
  function tutorialFirstCharaCome(setting) {
    local _self = ::gamesession.getCurrentScene().getUI().getCurrentPanel();
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _home_ui.getButtonSlide().setEnabled(false);
    _self.btn_help.setVisible(false);

    _tl.showText(_texts[0]);
    _tl.waitTap();
    _tl.hideText();
    _self.btn_help.setVisible(true);
    sleep(500);
    _home_ui.getButtonSlide().setEnabled(true);
  }

  function tutorialUseFurniture(setting) {
    local _scene = ::gamesession.getCurrentScene();
    local _stage = _scene.getStage();
    local _home_ui = _scene.getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _scene.setLockTapChara(true);
    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.showSlideMenu(false);
    _home_ui.setVisibleCameraRotateButton(false);

    local _cm = _stage.getChara(::TutorialSetting.TUTORIAL_KITTY_EVENT1_COSTUME);

    _cm.setAutoAction(false);
    _cm.clearTasks();

    sleep(1000);

    _tl.showText(_texts[0]);
    sleep(750);
    _tl.waitTap();

    sleep(500);

    _stage.setCameraDefault(false, false);
    _stage.camera_work.zoomFixedRate(28.5);
    _stage.setCameraLock(true);
    sleep(1000);

    _tl.focusModel(_cm);
    _tl.hideText();
    _scene.setLockTapChara(false);

    local _bl;
    while (!_bl) {
      suspend();
      _bl = _self.getAppealBalloon(_cm);
    }
    _scene.setLockTapChara(true);
    sleep(500);

    _tl.focusView(_bl.getView(), _home_ui);
    sleep(1000);

    _tl.showText(_texts[1]);
    sleep(750);
    _tl.waitTap();
    _tl.hideText();
    sleep(500);

    _tl.showText(_texts[2]);
    sleep(500);
    _tl.waitTap();

    _tl.hideText();
    _scene.setLockTapChara(false);
    sleep(500);
    _tl.focusModel(_cm);

    while (!_cm.isStateApproachFurniture()) {
      suspend();
    }

    _tl.focusOut();

    _stage.setCameraLock(false);

    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.setVisibleCameraRotateButton(true);
  }

  function tutorialTapProduct(setting) {
    local _stage = ::gamesession.getCurrentScene().getStage();
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setVisibleCameraRotateButton(false);
    _home_ui.showSlideMenu(false);

    _stage.setCameraDefault(false, false);
    _stage.camera_work.zoomFixedRate(28.5);
    _stage.setCameraLock(true);

    sleep(1700);

    local _bl = _self.getTapHapinessBalloonByCostumeID(109001);
    _tl.focusView(_bl.view, _home_ui, 300, 1.8, 1.8);
    sleep(500);
    _tl.showText(_texts[0]);
    sleep(750);
    _tl.waitTap();
    _tl.updateText(_texts[1]);
    sleep(250);
    _tl.waitTap();
    _tl.updateText(_texts[2]);
    sleep(250);
    _tl.waitTap();
    _tl.focusOut();
    _tl.hideText();

    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.setVisibleCameraRotateButton(true);
    _stage.setCameraLock(false);
  }

  function tutorialShop(setting) {
    local _ud = ::gamesession.getUserData();
    if (_ud.getRoomFurnitureAmount() > 2) return;

    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();
    local _idx = 0;

    local _scene = ::gamesession.getCurrentScene();
    _scene.setLockTapScene(true);
    _self.setCharaAppealLayerVisible(false);

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.showSlideMenu(false);
    _home_ui.getSlideMenu().setEnabledBottomButton(false);

    _tl.showText(_texts[_idx++], 1);
    sleep(750);
    _tl.waitTap();
    _tl.hideText();

    sleep(300);

    local dlg = ::ImageViewDialogNoTitle();
    dlg.setNoReadFlag(false);
    dlg.setImagePathList(setting.getImagePathList());
    dlg.show();

    sleep(300);

    local _btn = _home_ui.getButtonSlide();
    _tl.focusView(_btn, _home_ui, 300, 1.2, 1.2);
    _tl.showText(_texts[_idx++], 4);
    _home_ui.setShowSlideMenuReservationLock(true);
    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.scroll.view.pos.y = 0;
    _home_ui.setLockScrollSlideMenu(true);

    this.setWaitActionEvent(_home_ui.getButtonSlide());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (_home_ui.isShowSlideMenu()) break;
    }
    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setShowSlideMenuReservationLock(false);
    _tl.focusOut();
    sleep(500);

    _tl.updateText(_texts[_idx++], 0);

    _btn = _home_ui.getSlideMenu().getButtonShop();
    _tl.focusView(_btn, _home_ui);

    this.setWaitActionEvent(_btn);
    while (this.isWaitingActionEvent()) {
      suspend();
      if (!(_home_ui.getCurrentPanel() instanceof HomeTopPanel)) break;
    }
    _home_ui.setShowSlideMenuLock(false);

    _tl.focusOut();
    _tl.hideText();

    _home_ui.getSlideMenu().setEnabledBottomButton(true);
    _home_ui.setLockScrollSlideMenu(false);
    _self = _home_ui.getCurrentPanel();

    _home_ui.getBackButton().setEnabled(false);
    _scene.setLockTapScene(false);

    _self.setEnabledButtonBack(false);
    _self.setTutorialLock();
    local _sc = _self.getShopCardFirst();
    _sc.enabled = false;

    _tl.showText(_texts[_idx++], 1);
    sleep(750);
    _tl.waitTap();
    _tl.updateText(_texts[_idx++], 1);

    _tl.focusView(_sc.getButtonView(), _home_ui, 300, 1.2, 1.3);

    _sc.enabled = true;
    this.setWaitActionEvent(_sc.getButtonView());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (_ud.getRoomFurnitureAmount() > 2) break;
    }
    _tl.focusOut();
    _tl.hideText();

    local _dlg = ::gamesession.getFrontDialog();
    if (_dlg) {
      local _cancel = _dlg.getButtonCancel();
      if (_cancel) _cancel.enabled = false;
    }

    while (_ud.getRoomFurnitureAmount() == 2) {
      suspend();
    }

    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.getBackButton().setEnabled(true);
  }

  function tutorialProductFurnitureSelect(setting) {
    local _stage = ::gamesession.getCurrentScene().getStage();
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setVisibleCameraRotateButton(false);
    _self.btn_help.setVisible(false);

    local _cm = _stage.getChara(109001);

    _tl.showText(_texts[0]);
    _tl.waitTap();
    _tl.updateText(_texts[1]);
    _tl.waitTap();

    _cm.setAutoAction(false);
    _cm.clearTasks();

    _stage.setCameraDefault(false, false);
    _stage.camera_work.zoomFixedRate(28.5);
    _stage.setCameraLock(true);
    sleep(1000);

    _tl.focusModel(_cm);
    _tl.hideText();

    while (!_cm.isStateSelectFurniture()) {
      suspend();
    }
    _tl.focusOut();

    _tl.showText(_texts[2]);
    _tl.waitTap();
    _tl.updateText(_texts[3]);
    _tl.waitTap();

    local _tfm = _cm.getTargetFurniture();
    local _fm_table = _stage.getFurnitureModels();
    local _fm = null;
    foreach (fm in _fm_table) {
      if (_tfm == fm) continue;
      _fm = fm;
      break;
    }
    _cm.setDisableApproachFurniture(true);

    _tl.hideText();
    _tl.focusModel(_fm);

    while (_cm.getTargetFurniture() == _tfm) {
      suspend();
    }
    _cm.setDisableApproachFurniture(false);
    _tl.focusOut();
    _tl.showText(_texts[4]);

    while (!_cm.isStateApproachFurniture()) {
      suspend();
    }

    _tl.hideText();

    _stage.setCameraLock(false);

    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.setVisibleCameraRotateButton(true);
    _self.btn_help.setVisible(true);
  }

  function tutorialToRoomEdit(setting) {
    local _ud = ::gamesession.getUserData();
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    local _scene = ::gamesession.getCurrentScene();
    _scene.setLockTapScene(true);
    _self.setCharaAppealLayerVisible(false);
    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setShowSlideMenuReservationLock(true);

    _home_ui.setLockScrollSlideMenu(true);
    _home_ui.getSlideMenu().setEnabledBottomButton(false);
    _home_ui.setVisibleCameraRotateButton(false);
    _home_ui.getSlideMenu().propertyLimit(true);

    _tl.showText(_texts[0]);
    sleep(750);
    _tl.waitTap();

    local _btn = _home_ui.getButtonSlide();
    _tl.focusView(_btn, _home_ui, 300, 1.2, 1.2);
    _tl.updateText(_texts[1], 4);

    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.getSlideMenu().getButtonShop().enabled = false;
    _home_ui.getSlideMenu().getButtonLayout().enabled = false;

    this.setWaitActionEvent(_home_ui.getButtonSlide());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (_home_ui.isShowSlideMenu()) break;
    }
    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setShowSlideMenuReservationLock(false);
    _tl.focusOut();
    sleep(500);

    _tl.updateText(_texts[2], 0);
    _btn = _home_ui.getSlideMenu().getButtonProperty();
    _tl.focusView(_btn, _home_ui);
    this.setWaitActionEvent(_btn);
    while (this.isWaitingActionEvent()) {
      suspend();
      _self = _home_ui.getCurrentPanel();
      if (!(_self instanceof HomeTopPanel)) break;
    }
    _home_ui.setShowSlideMenuLock(false);
    _tl.focusOut();
    _tl.hideText();
    while (_self instanceof HomeTopPanel) {
      suspend();
      _self = _home_ui.getCurrentPanel();
    }

    sleep(300);

    _home_ui.setLockScrollSlideMenu(false);
    _tl.showText(_texts[3], 2);
    _self.setButtonAllOff(::PropertyPanel.TAB_FURNITURE);

    local _card = _self.getCard(::PropertyPanel.TAB_FURNITURE, TutorialSetting.TUTORIAL_FIRST_BUY_FURNITURE_ID);
    _card.getButtonDetail().pickable = false;
    local _btn = _card.getButtonFurniture();
    _btn.pickable = true;
    _tl.focusView(_btn, _home_ui, 300, 1.2, 1.3);

    this.setWaitActionEvent(_btn);
    while (this.isWaitingActionEvent()) {
      suspend();
      if (!(_home_ui.getCurrentPanel() instanceof PropertyPanel)) break;
    }

    _home_ui.getSlideMenu().getButtonShop().enabled = true;
    _home_ui.getSlideMenu().getButtonLayout().enabled = true;
    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.setVisibleCameraRotateButton(true);
    _home_ui.getSlideMenu().setEnabledBottomButton(true);

    _scene.setLockTapScene(false);

    _tl.focusOut();
    _tl.hideText();
  }

  function tutorialFriendHapiness(setting) {
    local _scene = ::gamesession.getCurrentScene();
    local _stage = _scene.getStage();
    local _home_ui = _scene.getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _stage.setCameraLock(true);
    _scene.setLockTapChara(true);

    _home_ui.showSlideMenu(false);
    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setVisibleCameraRotateButton(false);
    _self.setCharaAppealLayerEnabled(false);

    local _cm = _stage.getChara(::TutorialSetting.TUTORIAL_KITTY_EVENT1_COSTUME);

    _tl.showText(_texts[0]);
    sleep(750);
    _tl.waitTap();

    _stage.setCameraLock(false);
    _stage.setCameraDefault(false, false);
    _stage.camera_work.zoomFixedRate(28.5);
    _stage.setCameraLock(true);
    _tl.hideText();
    sleep(800);

    local _bl = _self.getHapinessBalloon(_cm);
    if (!_bl) _bl = _self.getHapinessProductBalloonByModel(_cm);

    if (_bl) _tl.focusView(_bl.getView(), _home_ui, 300, 1.2, 1.4);
    sleep(2000);
    _tl.showText(_texts[1], 0);
    sleep(750);
    _tl.waitTap();
    sleep(250);
    _tl.updateText(_texts[2], 0);
    _tl.waitTap();
    _tl.hideText();

    if (_bl) _tl.focusView(_bl.getView(), _home_ui, 300, 2.5, 2.9, { x = 0.0, y = 75.0 });

    sleep(500);

    _scene.setLockTapChara(false);
    _self.setCharaAppealLayerEnabled(true);

    while (_home_ui.getCurrentPanel() == _self) {
      suspend();
    }
    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.setVisibleCameraRotateButton(true);
    _stage.setCameraLock(false);
    _scene.setLockTapChara(false);

    _tl.focusOut();
  }

  function tutorialShopCostume(setting) {
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();
    local _ud = ::gamesession.getUserData();

    _self.btn_help.setVisible(false);

    local dlg = ::ImageViewDialogNoTitle();
    dlg.setNoReadFlag(false);
    dlg.setImagePathList(setting.getImagePathList());
    dlg.show();

    sleep(300);

    _home_ui.setLockScrollSlideMenu(true);
    _home_ui.getSlideMenu().setEnabledBottomButton(false);
    _home_ui.getSlideMenu().getButtonProperty().enabled = false;
    _home_ui.getSlideMenu().getButtonLayout().enabled = false;

    local _btn = _home_ui.getButtonSlide();
    _tl.focusView(_btn, _home_ui, 300, 1.2, 1.2);
    _tl.showText(_texts[0], 4);

    this.setWaitActionEvent(_home_ui.getButtonSlide());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (!(_home_ui.getCurrentPanel() instanceof HomeTopPanel)) break;
    }
    _home_ui.setShowSlideMenuLock(true);
    _tl.focusOut();
    sleep(500);

    _tl.updateText(_texts[1], 0);
    _btn = _home_ui.getSlideMenu().getButtonShop();
    _tl.focusView(_btn, _home_ui);
    this.setWaitActionEvent(_btn);
    while (this.isWaitingActionEvent()) {
      suspend();
      if (!(_home_ui.getCurrentPanel() instanceof HomeTopPanel)) break;
    }
    _home_ui.setShowSlideMenuLock(false);

    _tl.focusOut();
    _tl.hideText();

    sleep(500);
    _home_ui.setLockScrollSlideMenu(false);
    _home_ui.getSlideMenu().getButtonProperty().enabled = true;
    _home_ui.getSlideMenu().getButtonLayout().enabled = true;
    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.getBackButton().setEnabled(false);
    _self.btn_help.setVisible(true);

    _self = _home_ui.getCurrentPanel();
    _self.tapShopTab(::ShopPanel.TAB_COSTUME);
    _self.setTutorialLock();
    _self.setEnabledButtonBack(false);

    local _sc = _self.getShopCardFirst();
    _tl.focusView(_sc, _home_ui, 300, 1.2);
    _tl.showText(_texts[2]);

    this.setWaitActionEvent(_sc.getButtonView());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (_ud.hasCostume(1509001)) break;
    }
    _tl.focusOut();
    _tl.hideText();

    sleep(200);

    local _dlg = ::gamesession.getFrontDialog();
    if (_dlg) {
      local _cancel = _dlg.getButtonCancel();
      if (_cancel) _cancel.enabled = false;

      _btn = _dlg.getButtonOK();
      if (_btn) {

        this.setWaitActionEvent(_btn);
        while (this.isWaitingActionEvent()) {
          suspend();
          if (_ud.hasCostume(1509001)) break;
        }
      }
    }

    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.getBackButton().setEnabled(true);
    _home_ui.getSlideMenu().setEnabledBottomButton(true);
  }

  function tutorialMoveMissionPanelLetter(setting) {
    local _scene = ::gamesession.getCurrentScene();
    local _stage = _scene.getStage();
    local _home_ui = _scene.getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setVisibleCameraRotateButton(false);
    _home_ui.showSlideMenu(false);
    _home_ui.setCameraButtonEnabled(false);
    _stage.setCameraLock(true);
    _scene.setLockTapScene(true);
    _self.setCharaAppealLayerVisible(false);
    _self.setVisibleDiaryButton(false);

    sleep(1000);

    local _trans = MaskPanelTransition(::getTexture(::getLoadImagePath()), ::getTexture("/image/black.jpg"), 5.0, 50);
    _self.getHomeUI().movePanel(::LetterPanel, false, { "setting" = ::gamesetting.letter_settings[::TutorialSetting.TUTORIAL_LETTER_SECOND_ID] }, _trans);

    while (!(_self instanceof LetterPanel)) {
      suspend();
      _self = _home_ui.getCurrentPanel();
    }

    while (!(_self instanceof HomeTopPanel)) {
      suspend();
      _self = _home_ui.getCurrentPanel();
    }
    _self.setCharaAppealLayerVisible(false);
    sleep(1000);

    _tl.showText(_texts[0]);
    sleep(750);
    _tl.waitTap();
    _tl.updateText(_texts[1]);
    sleep(250);
    _tl.waitTap();
    _tl.updateText(_texts[2]);
    sleep(250);
    _tl.waitTap();
    _tl.updateText(_texts[3]);

    _tl.focusView(_self.btn_diary, _home_ui, 300, 1.2, 1.2);
    this.setWaitActionEvent(_self.btn_diary);
    while (this.isWaitingActionEvent()) {
      suspend();
      _self = _home_ui.getCurrentPanel();
      if (!(_self instanceof HomeTopPanel)) break;
    }
    if (_self instanceof PanelMissionPanel) {
      _self.setTutorialLock(false);
    }
    _tl.focusOut();
    _tl.hideText();
    while (_self instanceof HomeTopPanel) {
      suspend();
      _self = _home_ui.getCurrentPanel();
    }

    _self.setTutorialLock(false);
    _home_ui.getButtonSlide().setEnabled(false);
    sleep(800);

    _tl.showText(_texts[4], 2);

    local _item = _self.getFirstNoncompletionPiece();
    _item.setEnabled(true);
    _tl.focusView(_item.getButtonView(), _home_ui, 300, 1.2, 1.2);

    local _info = _self.getMissionInfo();

    this.setWaitActionEvent(_item.getButtonView());
    while (this.isWaitingActionEvent()) {
      suspend();
      if (_info.visible) break;
    }

    _tl.hideText();
    sleep(300);
    _tl.focusView(_info, _home_ui, 300, 1.1, 1.3);
    sleep(500);
    _tl.showText(_texts[5], 5);
    sleep(750);
    _tl.waitTap();

    _tl.updateText(_texts[6]);
    sleep(250);
    _tl.waitTap();
    _tl.updateText(_texts[7]);
    sleep(250);
    _tl.waitTap();

    _tl.focusOut();
    _tl.hideText();
    _self.setTutorialLock(true);
    _home_ui.getButtonSlide().setEnabled(true);
    _scene.setLockTapScene(false);
    _home_ui.setCameraButtonEnabled(true);
    _stage.setCameraLock(false);
  }

  function tutorialFurnitureAttract(setting) {
    local _scene = ::gamesession.getCurrentScene();
    local _stage = _scene.getStage();
    local _home_ui = _scene.getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.setVisibleCameraRotateButton(false);
    _home_ui.showSlideMenu(false);
    _home_ui.setCameraButtonEnabled(false);
    _scene.setLockTapScene(true);
    _self.setVisibleDiaryButton(false);

    _stage.setCameraDefault(false, false);
    _stage.camera_work.zoomFixedRate(28.5);
    _stage.setCameraLock(true);

    local _cm = _stage.getChara(::TutorialSetting.TUTORIAL_KITTY_EVENT1_COSTUME);
    _cm.setAutoAction(false);
    _cm.clearTasks();
    ::gamesession.getUserData().resetHapinessAction();

    sleep(1000);

    _tl.showText(_texts[0], 0);
    sleep(750);
    _tl.waitTap();

    _tl.updateText(_texts[1]);
    sleep(250);
    _tl.waitTap();

    local _fm = null;
    foreach (fm in _stage.getFurnitureModels()) {
      if (fm.getFurnitureSettingId() == ::TutorialSetting.TUTORIAL_FIRST_BUY_FURNITURE_ID) {
        _fm = fm;
        break;
      }
    }

    _tl.focusModel(_fm);

    _scene.setLockTapChara(true);
    _scene.setLockTapSpace(true);
    _scene.setLockTapAttractTutorial(true);
    _scene.setLockTapScene(false);

    while (_cm.getTargetFurniture() != _fm) {
      suspend();
    }

    _scene.setLockTapScene(true);
    _tl.focusOut();
    _tl.hideText();

    local _bl;
    while (!_bl) {
      suspend();
      _bl = _self.getAppealBalloon(_cm);
    }
    sleep(500);

    _tl.focusView(_bl.getView(), _home_ui);
    sleep(1000);

    _tl.showText(_texts[2], 0);
    sleep(750);
    _tl.waitTap();

    _tl.updateText(_texts[3]);
    sleep(250);

    _tl.focusModel(_fm);
    _scene.setLockTapScene(false);

    while (!_cm.isStateApproachFurniture()) {
      suspend();
    }

    _tl.focusOut();
    _tl.hideText();

    _stage.setCameraLock(false);
    _home_ui.getButtonSlide().setEnabled(true);
    _home_ui.setVisibleCameraRotateButton(true);
    _home_ui.setCameraButtonEnabled(true);
    _scene.setLockTapChara(false);
    _scene.setLockTapSpace(false);
    _scene.setLockTapAttractTutorial(false);
    _self.setCharaAppealLayerVisible(true);
    _self.setVisibleDiaryButton(true);
  }

