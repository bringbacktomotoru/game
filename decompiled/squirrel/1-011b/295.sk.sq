class MovieView extends SKView
{
  player = null;
  videotex = null;
  videosp = null;

  paused_lock = false;
  end_func = null;

  initTex = true;

  constructor() {
    videosp = Sprite();
    videosp.color = 255;
  }

  function removed() {
    super.removed();
    player = null;
    videotex = null;
  }

  function updateLayout() {
    local w = bnd.w, h = bnd.h;
    videosp.bnd.set(0, 0, w, h);
    repaint();
  }

  function setSource(src, offset = 0, length = 0) {
    player = MoviePlayer();
    if (offset == 0 && length == 0) player.setSource(src);
    else player.setSource(src, offset, length);

    while (player.getState() == MoviePlayerState.STATE_INIT) {
      suspend();
    }
  }

  function prepare() {
    player.prepare();
    while (player.getState() == MoviePlayerState.STATE_LOAD) {
      suspend();
    }
    local t = player.getMovieInfo();
    videotex = Texture();
    videotex.create(t.width, t.height, SK_RGBA, 1, 0);
    videosp.tex0 = videotex;
    videosp.color = 0xffffffff;
  }

  function play() {

    this.paused_lock = false;
    player.play();
    setUpdateFunc(updateMovie);
    repaint();
  }

  function pause() {
    this.paused_lock = true;
    player.pause();
    setUpdateFunc(null);
  }

  function setEndFunc(func) {
    this.end_func = func;
  }

  function updateMovie(dt) {
    local _osname = skGetOSName();
    if (_osname == "iOS") {
      if (player.captureRGBA(videotex, initTex)) {
        initTex = false;
        repaint();
      }
    }
    else {
      if (player.capture(videotex)) {
        repaint();
      }
    }
    if (!paused_lock && player.getState() != MoviePlayerState.STATE_PLAY) {
      if (this.end_func) this.end_func();
      player.pause();
      if (_osname != "Windows") seek(0);
      setUpdateFunc(null);
    }
  }

  function render() {
    skDrawSprite(videosp);
  }

  function tell() {
    return player.tell();
  }

  function seek(t) {
    player.seek(t);
    while (player.getState() == MoviePlayerState.STATE_LOAD) {
      suspend();
    }
  }

  function getTextureSize() {
    return [this.videotex.width, this.videotex.height];
  }
}