  function tv_start_set(
  fur, num,
  tv_com1, tv_com2, tv_com3, tv_com4,
  tv_com5, tv_com6, tv_com7, tv_com8,
  tv_cry1, tv_cry2, tv_cry3, tv_cry4,
  tv_hor1, tv_hor2, tv_hor3, tv_hor4, tv_hor5
  ) {

    local ri = PUBLIC_RANDOM.nexti(num);
    if (ri == 0) {

      tv_sit();
      tv_rimokon("def");
      fur.startScript("morph_comedy");
      startTalk("tv_com1");
      tv_watching_yure_set(4, "yaa");
      startTalk("tv_com2");
      tv_comedy_set(3, 1);
      chair_patapata_set(3, "smile3_cheek");
      startTalk("tv_com3");
      tv_comedy_set(3, 2);
      tv_rimokon("bakusho2");
      fur.startScript("end");
      tv_standup();
      startTalk("tv_com4");
      nobi();

      pyonpyon_set(0, "smile", "kya");
    }
    else if (ri == 1) {

      tv_sit();
      tv_rimokon("def");
      fur.startScript("morph_drama");
      tv_watching_set(2);
      tv_watching_mae_set(2, "kyomi", "kyomi_blink");
      startTalk("tv_cry1");
      tv_watching_mae_set(3, "sad", "mu2");
      startTalk("tv_cry2");
      tv_watching_te_set(3, "gu", "namida_blink");
      tv_watching_te_set(2, "namida_smile", "namida_smile_blink");
      startTalk("tv_cry3");
      tv_watching_yure_set(4, "namida_smile2");
      tv_rimokon("smile2");
      fur.startScript("end");
      tv_standup();
      startTalk("tv_cry4");
      picture_kansou1_set("smile3");
      picture_kansou2_set(2, "smile3");
    }
    else if (ri == 2) {

      tv_sit();
      tv_rimokon("smile4");
      fur.startScript("morph_comedy");
      tv_watching_set(2);
      startTalk("tv_com5");
      chair_patapata_set(3, "yaa");
      tv_watching_yure_set(3, "smile3_cheek");
      tv_standup();
      yokopatapata_set(2, "kya");
      kurukuru_set(2, "kiraniko", "kirasmile");
      startTalk("tv_com6");

      pyonpyon_set(1, "wink_r", "wink_r");
      startTalk("tv_com7");;
      tv_watching_usiro_set(3, "manzoku");
      tv_rimokon("smile3_cheek");
      fur.startScript("end");
      tv_standup();
      startTalk("tv_com8");
      picture_kansou1_set("tehepero", 1);
      picture_kansou2_set(1, "tehepero");
    }
    else {

      tv_sit();
      tv_rimokon("def");
      fur.startScript("morph_horror");
      tv_watching_set(1);
      tv_watching_usiro_set(2, "mu");
      startTalk("tv_hor1");
      tv_watching_mae_set(2, "sad2", "kyomi_blink");
      tv_watching_mae_set(2, "sad", "mu2");
      startTalk("tv_hor2");
      tv_watching_mae_set(2, "sad", "mu2");
      tv_watching_mae_set(1, "sad", "mu2");
      startTalk("tv_hor3");
      tv_odoroku(6);
      startTalk("tv_hor4");
      tv_rimokon("beso");
      fur.startScript("end");
      tv_standup();
      startTalk("tv_hor5");
      gakkari_set(2, "yaba");
    }

    end_common();
  }

