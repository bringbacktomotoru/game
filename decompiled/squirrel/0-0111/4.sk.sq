  function ar_keirei() {
    setMotionFile("scene01");
    anime(335, 335, 0, false, 0.15);
    morphFace("smile4", 0);
    changeHand("pa", "pa");
    pass(150);
    anime(335, 335.9, 8, false);
    pass(113);
    anime(335.9, 336.1, 0.4, false);
    pass(500);
    anime(336.1, 336.9, 4, false);
    pass(200);

    anime(336.9, 337.1, 1, false);

    pass(200);
    anime(337.1, 337.9, 10, false);
    morphFace("wink_r", 0);
    pass(80);
    playSound("odekake/jingle_3.wav");
    generate({ view = "/res/efx/ptd/throw_hit.ptd", pos = [-0.4, 1, 0] });
    anime(337.9, 338, 1, false);
    pass(100);

    for (local i = 0; i < 3; i++) {
      anime(338, 338.1, 0.4, false);
      pass(250);
      anime(338.1, 338.9, 1, false);
      pass(800);

      anime(338.9, 339.1, 0.4, false);
      pass(250);
      anime(339.1, 339.9, 1.5, false);
