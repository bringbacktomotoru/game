  function chair_wait(fur) {
    connectObject(fur, 500);
    while (true) {
      chair_sit_set(1, "def");
      chair_patapata_set(2, "def");
      chair_sit_set(1, "smile");
      chair_patapata_set(3, "def");
    }
  }

  function chair_end() {
    end_common();
  }

  function chair_set(
  fur,
  num,
  chair_1_1,
  chair_1_2, chair_1_3, chair_1_4,
  chair_2_1, chair_2_2, chair_2_3,
  chair_2_4, chair_2_5, chair_2_6
  ) {
    local ri = PUBLIC_RANDOM.nexti(num);

    if (ri == 0) {

      chair_sit_set(1, "def");
      chair_patapata_set(2, "def");
      startTalk("chair_1_1");
      chair_sit_set(1, "smile");
      chair_patapata_set(3, "def");
    }
    else if (ri == 1) {

      chair_sit_set(1, "def");
      startTalk("chair_1_2");
      chair_patapata_set(2, "smile");
      startTalk("chair_1_3");
      chair_sit_set(2, "manzoku");
      startTalk("chair_1_4");
      chair_patapata_set(2, "smile3");
      end_common();
      hokori();
    }
    else if (ri == 2) {

      chair_sit_set(1, "def");
      chair_patapata_set(7, "smile2");
      chair_nobi();
      chair_sit_set(5, "blink")
      chair_sit_set(1, "biku");
      end_common();
      nobi();
    }
    else if (ri == 3) {

      chair_sit_set(1, "def");
      chair_patapata_set(2, "smile2");
      startTalk("chair_2_1");
      chair_nobi();
      startTalk("chair_2_2");
      chair_sit_set(4, "blink")
      startTalk("chair_2_3");
      chair_sit_set(1, "biku");
      end_common();
      nobi();
    }
    else if (ri == 4) {

      chair_sit_set(1, "def");
      chair_patapata_set(7, "smile");
      chair_sit_set(2, "manzoku");
      chair_patapata_set(7, "smile3");
      end_common();
      hokori();
    }
    else {

      chair_sit_set(1, "def");
      startTalk("chair_2_4");
      chair_patapata_set(2, "nukui");
      startTalk("chair_2_5");
      chair_sit_set(2, "smile");
      startTalk("chair_2_6");
      chair_patapata_set(2, "smile3");
    }
    end_common();
  }

