  function sofa_wait(fur, bone) {
    connectObject(fur, 500, bone);
    while (true) {
      chair_sit_set(1, "def");
      chair_patapata_set(2, "def");
      chair_sit_set(1, "smile");
      chair_patapata_set(3, "def");
    }
  }

  function sofa_set(
  fur, num,
  sofa_1_1, sofa_1_2, sofa_1_3,
  sofa_1_4, sofa_1_5, sofa_1_6,
  sofa_2_1, sofa_2_2, sofa_2_3, sofa_2_4,
  sofa_2_5, sofa_2_6, sofa_2_7
  ) {
    local ri = PUBLIC_RANDOM.nexti(num);

    if (ri == 0) {

      connectObject(fur, 500);
      sofa_sit_set(1, "def");
      startTalk("sofa_1_1");
      sofa_patapata_set(3, "manzoku");
      startTalk("sofa_1_2");
      sofa_sit_set(2, "biku");
      startTalk("sofa_1_3");
      sofa_patapata_set(3, "smile3");
    }
    else if (ri == 1) {

      connectObject(fur, 500);
      sofa_sit_set(1, "def");
      sofa_patapata_set(5, "smile3");
      sofa_sit_set(1, "def");
      sofa_patapata_set(5, "manzoku");
    }
    else if (ri == 2) {

      connectObject(fur, 500);
      sofa_sit_set(1, "def");
      startTalk("sofa_2_1");
      sofa_nobi();
      sofa_sit_set(1, "sagasu");
      startTalk("sofa_2_2");
      sofa_sit_set(4, "blink");
      startTalk("sofa_2_3");
      sofa_patapata_set(1, "biku");
      sofa_9_end();
      startTalk("sofa_2_4");
      hokori();
    }
    else if (ri == 3) {

      startTalk("sofa_1_4");
      nobi();
      stand_kagu("def", 1000);
      connectObject(fur, 500);
      sofa_sit_set(1, "def");
      startTalk("sofa_1_5");
      sofa_patapata_set(2, "def");
      sofa_sit_set(1, "sagasu");
      startTalk("sofa_1_6");
      sofa_sit_set(4, "blink");
      sofa_nobi();
    }
    else {

      connectObject(fur, 500);
      sofa_sit_set(1, "def");
      startTalk("sofa_2_5");
      sofa_patapata_set(2, "smile3");
      startTalk("sofa_2_6");
      tv_watching_yure_set(4, "tere");
      startTalk("sofa_2_7");
      sofa_patapata_set(3, "manzoku");
    }

    end_common();
  }

