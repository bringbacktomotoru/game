    changeHand("pa", "pa");
    morphFace(face, 0);
    pass(200);
    anime(701, 702, 0.5, false);

    local ri = randomi(99);
    if (ri < 70) {
      morphFace(face, 0);
      pass(150);
      morphFace("blink", 0);
      pass(150);
      morphFace(face, 0);
      pass(200);
    }

    else if (ri < 30) {
      morphFace(face, 0);
      pass(100);
      morphFace("blink", 0);
      pass(100);
      morphFace(face, 0);
      pass(100);
      morphFace("blink", 0);
      pass(100);
      morphFace(face, 0);
      pass(100);
    }

    else {
      pass(500);
    }

    pass(1500);
    for (local i = 0; i < num; i++) {
      anime(702, 704, 4, false);

      local ri = randomi(99);

      if (ri < 40) {
        morphFace(face, 0);
        pass(150);
        morphFace("blink", 0);
        pass(150);
        morphFace(face, 0);
        pass(200);

      } else if (ri < 20) {
        morphFace(face, 0);
        pass(100);
        morphFace("blink", 0);
        pass(100);
        morphFace(face, 0);
        pass(100);
        morphFace("blink", 0);
        pass(100);
        morphFace(face, 0);
        pass(100);
      } else {
        pass(500);
      }

      anime(704, 704.5, 1, false);
      pass(500);
      anime(704.5, 705, 1, false);
      pass(500);
      anime(705, 705.5, 1, false);
      pass(500);
      anime(705.5, 706, 1, false);
      pass(500);
