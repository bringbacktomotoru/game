  function balloon_set(num) {
    setMotionFile("scene01");
    anime(441, 441, 0, false, 0.2);
    changeHand("pa", "pa");
    morphFace("yaa", 0);
    pass(200);
    anime(441, 442.5, 5, false);
    pass(300);
    anime(442.5, 443, 1, false);

    add_goods("balloon", generate({ view = "/res/goods/goods_1/balloon.pm", parts = "hand_item_R", connect = true }));
    pass(100);
    morphFace("blink", 0);
    pass(150);
    morphFace("def", 0);
    pass(250);
    anime(443, 444, 2, false);
    moveAccel(0, 0.2, 0, 2000, 0, 0.03);

    local ri = randomi(2);
    if (ri == 2) {

      pass(200);
      morphFace("blink", 0);
      pass(100);
      morphFace("def", 0);
      pass(100);
      morphFace("blink", 0);
      pass(100);
      anime(444, 446, 4, false);
      morphFace("def", 0);
      pass(500);
      morphFace("smile", 0);
    } else if (ri == 1) {

      pass(500);
      anime(444, 446, 4, false);
      morphFace("smile3", 0);
      pass(500);
    } else {

      pass(500);
      anime(444, 446, 4, false);
      morphFace("warau", 0);
      pass(500);
    }

    anime(446, 450, 2.5, true);
    pass(1000);
    moveAccel(0, 0.2, 0, 2000, 0.03, 0);

    if (ri < 2) {
      morphFace("nikawink", 0);
    }
    pass(2000);

    for (local i = 0; i < num; i++) {

      local ri2 = randomi(1);
      if (ri2 == 0) {
        anime(451, 455, 2.5, true, 0.3);
      } else {
        anime(446, 450, 2.5, true, 0.3);
      }

      moveAccel(0, 0.15, 0, 1500, 0, -0.03);

      local ri = randomi(2);

      if (ri == 2) {
        morphFace("blink", 0);
        pass(100);
        morphFace("def", 0);
        pass(100);
        morphFace("blink", 0);
        pass(100);
        morphFace("def", 0);
        pass(500);
        morphFace("smile", 0);
        pass(200);
      } else if (ri == 1) {
        pass(500);
        morphFace("smile3", 0);
        pass(500);
      } else {
        pass(500);
        morphFace("warau", 0);
        pass(500);
      }

      pass(500);
      moveAccel(0, 0.15, 0, 1500, -0.03, 0);
      pass(1500);

      moveAccel(0, 0.15, 0, 1500, 0, 0.03);
      pass(1500);
      moveAccel(0, 0.15, 0, 1500, 0.03, 0);
      pass(1500);
    }

    moveAccel(0, 0.2, 0, 2000, 0, -0.03);
    pass(2000);
    moveAccel(0, 0.2, 0, 2000, -0.03, 0);
    pass(2000);
    moveTo(0, 0, 0, 0);
  }

