  function levelupend_dance() {
    setMotionFile("scene01");
    anime(765, 765, 0, false, 0.1);
    morphFace("smile");
    pass(100);
    anime(765, 766, 10, false);
    pass(100);

    while (true) {
      for (local i = 0; i < randomi(1, false); i++) {
        levelupend_dance_l();
        levelupend_dance_r();
      }

      anime(770, 770.8, 12, false);
      pass(67);
      anime(770.8, 771, 5, false);
      pass(40);

      anime(771, 771.2, 2, false);
      pass(100);
      anime(771.2, 772.9, 15, false);

      local randomface1 = randomi(2);
      if (randomface1 < 2) {
        morphFace("warau");
      }
      if (randomface1 < 1) {
        morphFace("nikawink");
      }
      else {
        morphFace("kya");
      }

      pass(113);
      anime(772.9, 773, 0.5, false);
      pass(200);

      anime(773, 773.2, 2, false);
      pass(100);
      anime(773.2, 774.8, 12, false);
      morphFace("smile");
      pass(133);
      anime(774.8, 775, 2, false);
      pass(100);

      for (local i = 0; i < randomi(1, false); i++) {
        levelupend_dance_r();
        levelupend_dance_l();
      }

      anime(775, 775.8, 12, false);
      pass(67);
      anime(775.8, 776, 5, false);
      pass(40);

      anime(776, 776.2, 2, false);
      pass(100);
      anime(776.2, 777.9, 15, false);

      local randomface2 = randomi(2);
      if (randomface2 < 2) {
        morphFace("warau");
      }
      if (randomface2 < 1) {
        morphFace("nikawink");
      }
      else {
        morphFace("kya");
      }

      pass(113);
      anime(777.9, 778, 0.5, false);
      pass(200);

      anime(778, 778.2, 2, false);
      pass(100);
      anime(778.2, 779.8, 12, false);
      morphFace("smile");
      pass(133);
      anime(779.8, 780, 2, false);
      pass(100);
    }
  }

