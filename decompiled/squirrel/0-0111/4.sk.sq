  function tefuri() {

    setMotionFile("scene01");
    morphFace("def", 0);
    changeHand("pa", "pa");
    anime(10, 18, 4, true);
    pass(randomi(400));

    anime(655, 663, 8, true, 0.1);
    local time2 = rotateToCameraSpd(0.3);
    pass(time2);
    switch (randomi(2)) {
    case 0:
      tefuri_set(2 + randomi(3), randomArray(["ooi", "yaa", "smile", "nikawink"]));
      stand_end();
      break;
    case 1:
      ryoutefuri_set(1 + randomi(2), randomArray(["ooi", "yaa", "smile", "nikawink"]));
      break;
    default:
      ryoutefuri_yokoyure_set(1 + randomi(1), ["ooi", "yaa", "smile", "nikawink"]);
      break;
    }
  }

