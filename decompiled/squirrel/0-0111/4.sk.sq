        morphFace(face1, 0);
        pass(100);
        morphFace(face2, 0);
        pass(100);
        morphFace(face1, 0);
        pass(200);
      }

      else if (ri < 30) {
        morphFace(face1, 0);
        pass(100);
        morphFace(face2, 0);
        pass(50);
        morphFace(face1, 0);
        pass(100);
        morphFace(face2, 0);
        pass(50);
        morphFace(face1, 0);
        pass(100);
      }
      anime(901, 901.2, 0.5, false);
      pass(400);
      anime(901.2, 901.9, 2, false);
      pass(350);
      anime(901.9, 902, 0.25, false);
      pass(400);
