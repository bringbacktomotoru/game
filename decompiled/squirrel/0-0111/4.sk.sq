  function bookshelf_set(
  num,
  book_1_1, book_1_2, book_1_3, book_1_4,
  book_1_5, book_1_6, book_1_7, book_1_8, book_1_9,
  book_2_1, book_2_2,
  book_2_3, book_2_4, book_2_5,
  book_2_6, book_2_7, book_2_8,
  book_2_9, book_2_10, book_2_11, book_2_12
  ) {
    local ri = PUBLIC_RANDOM.nexti(num);

    if (ri == 0) {

      lampstand_manzoku_set(2, "def", "kyomi");
      stand_kagu("def", 1000);
      startTalk("book_1_1");
      bookshelf_nozoku_set(2, "def");
      startTalk("book_1_2");
      bookshelf_mitsuketa();
      bookshelf_gosogoso_set(4, "smile");
      bookshelf_toru_set("def", "smile");
      bookshelf_hiraku();
      startTalk("book_1_3");
      bookshelf_yomu(2, "yaa");
      startTalk("book_1_4");
      bookshelf_kansou_set(3, "smile3", "kya");
      bookshelf_simau("blink", "def");
    }
    else if (ri == 1) {

      startTalk("book_1_5");
      bookshelf_nayamu_set(2, "blink", "def");
      bookshelf_nozoku_set(2, "sagasu");
      startTalk("book_1_6");
      bookshelf_sagasu_set(2);
      startTalk("book_1_7");
      bookshelf_mitsuketa();
      bookshelf_gosogoso_set(4, "def");
      bookshelf_toru_set(4, "def", "smile");
      bookshelf_hiraku();
      startTalk("book_1_8");
      bookshelf_yomu(2, "kyomi");
      startTalk("book_1_9");
      bookshelf_kansou_set(3, "kyomi_blink", "warau");
      bookshelf_simau("blink", "def");
    }
    else if (ri == 2) {

      bookshelf_nayamu_set(2, "kyomi_blink", "kyomi");
      startTalk("book_2_1");
      bookshelf_nozoku_set(2, "smile");
      bookshelf_sagasu_set(1);
      startTalk("book_2_2");
      bookshelf_mitsuketa();
      bookshelf_gosogoso_set(4, "def");
      bookshelf_toru_set(4, "smile", "smile3");
      bookshelf_hiraku();
      startTalk("book_2_3");
      bookshelf_yomu(1, "kyomi");
      startTalk("book_2_4");
      bookshelf_kansou_set(2, "biku", "bikkuri");
      bookshelf_simau("biku", "yaba");
      startTalk("book_2_5");
      gakkari_set(1, "yaba");
    }
    else if (ri == 3) {

      startTalk("book_2_1");
      bookshelf_nayamu_set(2, "blink", "def");
      bookshelf_nozoku_set(2, "sagasu");
      startTalk("book_2_2");
      bookshelf_mitsuketa();
      bookshelf_gosogoso_set(4, "def");
      bookshelf_toru_set(4, "def", "yaa");
      bookshelf_hiraku();
      startTalk("book_2_6");
      bookshelf_yomu(2, "kyomi");
      startTalk("book_2_7");
      bookshelf_yomu(2, "mu2");
      bookshelf_kansou_set(3, "mu2", "mu");
      bookshelf_simau("mu", "mu2");
      startTalk("book_2_8");
      lampstand_manzoku_set(2, "mu2", "fuman_blink");
    }
    else {

      startTalk("book_2_1");
      bookshelf_nozoku_set(2, "kyomi");
      bookshelf_mitsuketa();
      bookshelf_gosogoso_set(4, "yaa");
      startTalk("book_2_2");
      bookshelf_toru_set(4, "def", "smile3");
      bookshelf_hiraku();
      startTalk("book_2_9");
      bookshelf_yomu(1, "kyomi");
      startTalk("book_2_10");
      bookshelf_yomu(1, "sagasu");
      bookshelf_yomu(2, "kando");
      startTalk("book_2_11");
      bookshelf_yomu(2, "namida_smile2");
      bookshelf_kansou_set(3, "tear_smile", "tear_smile");
      bookshelf_simau("smile2", "blink");
      startTalk("book_2_12");
      picture_kansou1_set("smile3");
      picture_kansou2_set(2, "smile3");
    }

    end_common();
  }

