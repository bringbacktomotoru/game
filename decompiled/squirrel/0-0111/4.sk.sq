  function loupe_stand() {

    add_goods("loupe", generate(efx_loupe));

    while (true) {
      local ri = randomi(3);

      if (ri == 0) {
        loupe_sinken_set(2, "sagasu_loupe");
      } else if (ri == 1) {
        loupe_sagasu_set(2, "wink_l");
      } else {
        loupe_normal_set(2);
      }
    }
  }

