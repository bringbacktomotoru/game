  function clock_nayamu_set(num, face) {
    setMotionFile("scene01");
    anime(550, 550, 0, false, 0.17);
    morphFace(face, 0);
    changeHand("pa", "yubisashi");
    pass(170);
    anime(550, 550.6, 6, false);
    pass(100);
    anime(550.6, 550.8, 2, false);
    pass(100);
    anime(550.8, 551, 0.8, false);
    pass(250);
    for (local i = 0; i < num; i++) {
      anime(551, 553, 2, false);
      pass(1000);
    }
    changeHand("pa", "pa");
  }

  function sentence_clock_nayamu(args) {
    setMotionFile("scene01");

    local face = args["face"];
    local face = face[0];
    local num = args["loop_num"];

    anime(550, 550, 0, false, 0.17);
    morphFace(face, 0);
    changeHand("pa", "yubisashi");
    pass(170);
    anime(550, 550.6, 6, false);
    pass(100);
    anime(550.6, 550.8, 2, false);
    pass(100);
    anime(550.8, 551, 0.8, false);
    pass(250);
    for (local i = 0; i < num; i++) {
      anime(551, 553, 2, false);
      pass(1000);
    }
    changeHand("pa", "pa");
  }

  function clock_yubisashi_set(num, face) {
    setMotionFile("scene01");
    anime(554, 554, 0, false, 0.2);
    morphFace(face, 0);
    changeHand("pa", "yubisashi");
    pass(200);
    anime(554, 555, 5, false);
    pass(200);

    for (local i = 0; i < num; i++) {

      anime(555, 557.8, 12, false);
      pass(233);
      anime(557.8, 558, 2, false);
