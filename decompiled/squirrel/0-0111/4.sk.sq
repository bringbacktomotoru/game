  }

  function ar_dance_rotation_set(num, face1, face2) {

    generate({ view = "/res/efx/ptd/levelupstart.ptd", pos = [0, 1.5, 0] });
    anime(153, 153, 0, false, 0.2);
    morphFace(face1);
    pass(200);
    anime(153, 155, 10, false);
    pass(200);

    for (local i = 0; i < num; i++) {
      anime(155, 158, 12, false);
      pass(250);
    }

    anime(159, 160.2, 5, false);
    pass(240);
    anime(160.2, 160.5, 2.5, false);
    morphFace(face2);
    pass(120);
    anime(160.5, 160.7, 1.2, false);
    pass(167);
    anime(474, 474, 0, false, 0.1);
    pass(100);

  }

  function ar_dance_jump_r_set(face1, face2) {

    anime(740, 740, 0, false, 0.12);
    morphFace(face1);
    pass(120);
    changeHand("pa", "pa");
    anime(740, 740.2, 4, false);
    pass(50);
    anime(740.2, 741.8, 20, false);

    local _time = moveForSpd(0.6, 0.9, 0, 0.007);
    pass(_time);

    anime(742.2, 742.2, 0, false, 0.1);

    local _time = moveForSpd(0.1, 0.1, 0, 0.003);
    pass(_time);
    local _time = moveForSpd(0.1, -0.1, 0, 0.003);
    pass(_time);

    local _time = moveForSpd(0.3, -0.9, 0, 0.0065);
    pass(_time);

    anime(743.5, 743.5, 0, false, 0.05);

    pass(50);
    morphFace(face2, 0);
    anime(745, 745, 0, false, 0.08);
    pass(80);
    anime(10, 10, 0, false, 0.25);
    pass(250);
  }

