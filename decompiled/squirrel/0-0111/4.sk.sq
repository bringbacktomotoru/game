  function lag_0() {
    lag_set(
    2,
    "rug_1_1", "rug_1_2", "rug_1_3",
    "rug_1_4", "rug_1_5", "rug_1_6"
    );
  }
  function lag_9() {
    lag_set(
    4,
    "rug_1_1", "rug_1_2", "rug_1_3",
    "rug_1_4", "rug_1_5", "rug_1_6",
    "rug_2_1", "rug_2_2", "rug_2_3", "rug_2_4",
    "rug_2_5", "rug_2_6", "rug_2_7"
    );
  }

  function lag_set(
  num,
  rug_1_1, rug_1_2, rug_1_3,
  rug_1_4, rug_1_5, rug_1_6,
  rug_2_1, rug_2_2, rug_2_3, rug_2_4,
  rug_2_5, rug_2_6, rug_2_7
  ) {

    local ri = PUBLIC_RANDOM.nexti(num);

    if (ri == 0) {

      startTalk("rug_1_1");
      nobi();
      lag_neru_set("def");
      startTalk("rug_1_2");
      lag_utouto1();
      lag_neteru_set("blink", 1);
      startTalk("rug_1_3");
      lag_neteru_set("blink", 2);
      lag_utouto2();
    }
    else if (ri == 1) {

      lag_neru_set("def");
      lag_neteru_set("def", 1);
      startTalk("rug_1_4");
      lag_utouto2();
      startTalk("rug_1_5");
      lag_neteru_set("biku", 1);
      startTalk("rug_1_6");
      chair_sit_set(2, "smile3");
      end_common();
      hokori();
    }
    else if (ri == 2) {

      chair_sit_set(1, "def");
      startTalk("rug_2_5");
      chair_patapata_set(3, "def");
      tv_watching_usiro_set(3, "smile");
      startTalk("rug_2_6");
      chair_sit_set(1, "smile2");
      startTalk("rug_2_7");
      chair_nobi();
      end_common();
      hokori();
    }
    else {

      lag_neru_set("def");
      lag_neteru_set("def", 2);
      startTalk("rug_2_1");
      lag_utouto1();
      startTalk("rug_2_2");
      lag_neteru_set("blink", 3);
      startTalk("rug_2_3");
      lag_utouto2();
      end_common();
      startTalk("rug_2_4");
      nobi();
      hokori();
    }

    end_common();
  }

  function lag_0_end() {
    lag_tatu();
    end_common();
  }
  function lag_9_end() {
    lag_tatu();
    end_common();
  }

