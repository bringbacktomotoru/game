  function clock_set(
  num,
  clock_1_1, clock_1_2, clock_1_3,
  clock_1_4, clock_1_5,
  clock_2_1, clock_2_2, clock_2_3, clock_2_4,
  clock_2_5, clock_2_6, clock_2_7, clock_2_8, clock_2_9
  ) {
    local ri = PUBLIC_RANDOM.nexti(num);

    if (ri == 0) {

      startTalk("clock_1_1");
      clock_nayamu_set(3, "mu");
      startTalk("clock_1_2");
      clock_yubisashi_set(4, "def");
      startTalk("clock_1_3");
      clock_nayamu_set(2, "smile");
    }
    else if (ri == 1) {

      picture_miteru_set(2, "def");
      picture_kansou1_set("smile");
      startTalk("clock_1_4");
      picture_kansou2_set(2, "manzoku");
      startTalk("clock_1_5");
      picture_miteru_set(1, "smile2");
    }
    else if (ri == 2) {

      startTalk("clock_2_1");
      clock_nayamu_set(2, "mu");
      startTalk("clock_2_2");
      clock_yubisashi_set(3, "def");
      startTalk("clock_2_3");
      clock_nayamu_set(1, "biku");
      startTalk("clock_2_4");
      yokopatapata_set(1, "bikkuri");
    }
    else {

      startTalk("clock_2_5");
      picture_miteru_set(1, "kyomi");
      startTalk("clock_2_6");
      clock_nayamu_set(4, "mu2");
      startTalk("clock_2_7");
      clock_yubisashi_set(4, "def");
      startTalk("clock_2_8");
      clock_nayamu_set(2, "smile3");
      startTalk("clock_2_9");
      ketsui();
    }

    end_common();
  }

  function clock_0_end() {
    end_common();
  }
  function clock_9_end() {
    end_common();
  }

