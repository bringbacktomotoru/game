  function otetsudai_success() {
    while (true) {
      local ri = PUBLIC_RANDOM.nexti(100);

      if (ri < 20) {

        pyonpyon_set(0, "smile", "kya");
      }
      else if (ri < 40) {

        pyonpyon_set(1, "smile", "kya");
      }
      else if (ri < 60) {
        kurukuru_set(0, "smile");
      }
      else if (ri < 80) {
        kurukuru_set(3, "smile");
      }
      else {
        yokopatapata_set(1, "smile");
      }
    }
  }

  function otetsudai_failure() {
    while (true) {
      local ri = PUBLIC_RANDOM.nexti(100);

      if (ri < 70) {
        gakkari_set(5, "smile");
      }
      else {
        gakkari_set(3, "smile");
      }
    }
  }

