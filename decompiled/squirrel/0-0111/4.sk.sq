  function stand_kagu(face, time) {
    setMotionFile("scene01");
    local ri = PUBLIC_RANDOM.nexti(100);
    morphFace(face, 0);

    if (ri < 50) {

      anime(10, 10, 0, false, 0.25);
      changeHand("pa", "pa");
      pass(250);
      anime(10, 18, 4, true);
      pass(2000 + time);
    }
    else {

      anime(620, 620, 0, false, 0.25);
      changeHand("pa", "pa");
      pass(250);
      anime(620, 630, 5, false);
      pass(2000);
      anime(630, 646, 5, true);
      pass(time);
    }
  }

