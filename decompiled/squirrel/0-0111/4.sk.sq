  function emotion_sit() {
    tv_sit();
    tv_watching_set(1, "def");

    switch (randomi(1)) {
    case 0:

      tv_watching_yure_set(2 + randomi(2), "smile");
      break;
    default:

      playVoice("e24");
      tv_watching_usiro_set(3 + randomi(2), "meisou");
      break;
    }

    tv_watching_set(1, "def");

    switch (randomi(1)) {
    case 0:

      tv_watching_yure_set(2 + randomi(2), "manzoku");
      break;
    default:

      playVoice("e24");
      tv_watching_usiro_set(3 + randomi(2), "smile3");
      break;
    }

    tv_watching_set(1, "def");
    tv_standup();
    setAREnableMotions(::ARPanel.UI_STATE_ENABLE);
  }

  function emotion_sleep_up() {
    switch (randomi(1)) {

    case 0:

      playVoice("e79");
      nobi();
      tv_sit();
      bed_sit_dainoji_set("blink");

      bed_dainoji(2, "blink");
      bed_dainoji_mune();
      bed_mune(3, "blink");
      bed_nobi("akubi");
      bed_dainoji(1, "sagasu");

      bed_dainoji_sit_set("blink");
      break;
    default:

      playVoice("e27_1");
      nobi();
      tv_sit();
      bed_sit_dainoji_set("blink");

      bed_dainoji(1, "blink");
      playVoice("e27_2");
      bed_munyamunya_set(randomi(3, false));
      bed_dainoji(1, "blink");

      bed_dainoji_sit_set("blink");
      tv_watching_munyamunya_set(2);
      break;
    }
    tv_standup();
    setAREnableMotions(::ARPanel.UI_STATE_ENABLE);
  }

  function emotion_sleep_down() {

    switch (1) {

    case 0:

      playVoice("e27_1");
      nobi();
      lag_neru_set("meisou");
      lag_neteru_set("blink", 2 + randomi(2));

      lag_tatu();
      stand_set("meisou", 400);
      hokori();
      playVoice("e24");
      nobi();
      break;
    default:

      playVoice("e27_1");
      nobi();
      lag_neru_set("sagasu");
      lag_utouto1();
      lag_neteru_set("blink", 1);
      lag_utouto2();

      lag_tatu();
      stand_set("sagasu", 800);
      playVoice("e24");
      nobi();
      break;
    }

    stand_end();
  }

