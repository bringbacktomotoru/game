  function ar_hanikami() {
    playVoice("ar_hanikami");
    morphFace("smile4_cheek", 0);
    setMotionFile("scene01");
    anime(47, 47, 0, false, 0.15);
    pass(150);
    anime(47, 48, 5, false);
    pass(200);
    anime(48, 49, 3, false);
    pass(333);
    morphFace("smile2", 25);
    anime(49, 49.8, 3, false);
    pass(100);
    morphFace("smile4_cheek", 25);
