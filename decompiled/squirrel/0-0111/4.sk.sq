model =
{

  body = { pm = "../clothes/default/mymelo.pm" }
  face = { pm = "../facial/mymelo_face.pm" parentname = "body" shadowbones = "body" }
  r_hand = { pm = "../hand/mymelo/guR.pm" parentname = "body" shadowbones = "body" }
  l_hand = { pm = "../hand/mymelo/guL.pm" parentname = "body" shadowbones = "body" }

}

scriptclass = "SK3DScriptRunner"

script =
{

  function setup() {

    setCharaSetting(::gamesetting.sanrio_chara_settings[2]);

    changeHand("pa", "pa");

    sk3d.setMotion(getMotionData(::getResource("/res/anime/scene01.mot")));
  }

  goods = null;

  efx_papercup = { view = "/res/goods/goods_1/papercup.pm", parts = "hand_item_R", connect = true }
  efx_loupe = { view = "/res/goods/goods_1/loupe.pm", parts = "hand_item_R", connect = true }
  efx_tambourine = { view = "/res/goods/goods_1/tambourine.pm", parts = "hand_item_R", connect = true }

  function startTalk(talk) {
    startTalk(talk);
  }
  function playVoice(key) {
    playVoice(key);
  }

  function startTalkForce(talk, small = false) {
    startTalkForce(talk, small);
  }

  function start() {
    stand();
  }

  function def_stand() {
    stand_set("def", 1500);
  }

  function stand_set(face, time) {
    setMotionFile("scene01");
    anime(10, 10, 0, false, 0.15);
    pass(150);
    anime(10, 18, 3, true);
    morphFace(face, 0);
    changeHand("pa", "pa");
    pass(time);
  }

  function all_goods_cleaer() {
    if (goods) {
      foreach (v in goods) {
        if (v) v.kill();
      }
    }
    goods = {};
  }

  function goods_cleaer(key) {
    if (goods && goods[key]) goods[key].kill();
  }

  function add_goods(key, obj) {
    if (!goods) {
      goods = {};
    }
    else {
      if (goods[key]) goods[key].kill();
    }
    goods[key] <- obj;
  }

  function get_goods(key) {
    if (!goods) return null;
    return goods[key];
  }

  function end_common() {
    all_goods_cleaer();

    disconnectObject();

    setMotionFile("scene01");
    anime(10, 10, 0, false, 0.25);
    pass(250);
    morphFace("def", 0);
    changeHand("pa", "pa");
    setAREnableMotions(::ARPanel.UI_STATE_ENABLE);
  }

  function stand_end() {
    all_goods_cleaer();

    stand_set("def", 800);

    setAREnableMotions(::ARPanel.UI_STATE_ENABLE);
  }

  function stand_end2(face) {
    all_goods_cleaer();

    stand_set(face, 800);

  }

  function sentence_stand_end() {
    all_goods_cleaer();
    setMotionFile("scene01");
    anime(10, 10, 0, false, 0.15);
    pass(150);
    anime(10, 18, 3, true);
    changeHand("pa", "pa");
    pass(800);
  }

  function end_common_furniture(pos) {
    disableTapChara(true);
    end_common();
    setMotionFile("scene01");
    local _time = rotateToPosSpd(pos.x, pos.z, 0.1);
    anime(655, 663, 8, true);
    pass(_time);
    local _time2 = moveForSpd(pos.x, pos.y, pos.z, 0.0015);
    pass(_time2 + 200);
    disableTapChara(false);
  }

  function end_common_furniture_trampoline(pos) {

    disableTapChara(true);
    setMotionFile("sit02");
    morphFace("def", 0);
    changeHand("pa", "pa");
    anime(90, 98, 6, true, 0.4);
    pass(100);
    local _time = rotateToPosSpd(pos.x, pos.z, 0.06);
    if (_time >= 100) {
      pass(_time);
    } else {
      pass(100);
    }

    local _time2 = moveForSpd(pos.x * 0.7, 0, pos.z * 0.7, 0.00075);

    switch (randomi(2)) {
    case 0:
      pass(50);
      morphFace("blink", 0);
      pass(100);
      morphFace("def", 0);
      pass(150);
      morphFace("blink", 0);
      pass(100);
      morphFace("def", 0);
      break;
    case 1:
      pass(150);
      morphFace("blink", 0);
      pass(250);
      morphFace("def", 0);
      break;
    default:
      pass(400);
    }

    if (_time2 - 400 >= 0) {
      pass(_time);
    } else {
      pass(_time2 - 400);
    }

    anime(99.8, 99.8, 0, false, 0.2);
    pass(200);
    anime(99.8, 100 1, false);
    morphFace(randomArray(["def", "smile", "smile"]), 0);
    pass(200);
    anime(100, 101, 8, false);
    moveFor(pos.x * 0.3, pos.y, pos.z * 0.3, 300);

    pass(125);
    anime(101, 102, 5, false);
    pass(200);
    anime(102, 102.6, 6, false);
    pass(100);
    anime(102.6, 103, 4, false);
    pass(100);
    anime(103, 103.8, 5, false);
    pass(160);
    anime(103.8, 104.2, 1.3, false);
    pass(308);
    anime(104.2, 105, 7, false);
    morphFace("def", 0);
    pass(114);
    disableTapChara(false);
  }

  function end_common_furniture_chair(pos) {
    disableTapChara(true);
    setMotionFile("sit02");
    anime(36, 36, 0, false, 0.2);
    morphFace("def", 0);
    changeHand("pa", "pa");
    pass(200);
    anime(36, 40, 9, false);

    local _time2 = moveForSpd(pos.x, pos.y, pos.z, 0.004);
    local _time = rotateToPosSpd(pos.x, pos.z, 0.1);

    if (_time + _time2 >= 444) {
      pass(_time + _time2);
    } else {
      pass(444);
    }
    disableTapChara(false);
  }

  function end_common_furniture_dresser(pos) {
    disableTapChara(true);
    setMotionFile("sit02");

    anime(36, 36, 0, false, 0.2);
    morphFace("def", 0);
    changeHand("pa", "pa");
    rotateToPos(pos.x, pos.z, 200);

    pass(200);

    anime(118, 118, 0, false, 0.07);
    moveFor(pos.x, pos.y, pos.z, 250);
    pass(70);
    anime(38, 39, 1, false, 0.18);
    pass(180);
    anime(39, 40, 4, false, 0.05);
    pass(250);
    disableTapChara(false);
  }

  function end_common_furniture_rockinganimal(pos) {
    disableTapChara(true);

    setMotionFile("sit02");
    anime(110, 110, 0, false, 0.3);
    morphFace("def", 0);
    changeHand("pa", "pa");
    local _time = rotateToPosSpd(pos.x, pos.z, 0.2);

    pass(300);

    anime(110, 111, 5, false);
    moveFor(pos.x * 0.5, pos.y * 0.1, pos.z * 0.5, 343);
    pass(200);
    anime(111, 112, 12, false);
    pass(83);

    anime(107, 107, 0, false, 0.2);
    local _time2 = moveForSpd(pos.x * 0.5, pos.y * 0.9, pos.z * 0.5, 0.007);
    pass(_time2);

    anime(107, 105, 4, false);
    pass(500);
    disableTapChara(false);
  }

  function end_common_furniture_bed(pos, state) {
    disableTapChara(true);

    if (state == 0) {

      setMotionFile("sit02");
      anime(49, 52.8, 6, false);
      morphFace("blink", 0);
      changeHand("pa", "pa");
      pass(633);
      anime(52.8, 53, 2, false);
      pass(100);
      anime(53, 53.2, 1, false);
      pass(200);
      anime(53.2, 54, 4, false);
      pass(200);

      pass(200);
    } else {

    }

    setMotionFile("sit02");
    morphFace("def", 0);
    changeHand("pa", "pa");
    anime(66, 66, 0, false, 0.2);
    pass(200);

    rotateToPos(pos.x, pos.z, 500);
    moveFor(pos.x * 0.3, 0, pos.z * 0.3, 500);
    anime(66, 67, 4, false);
    pass(250);
    anime(67, 65, 4, false);
    pass(500);
    anime(65, 66, 6, false);
    pass(167);

    anime(56, 58, 5, false, 0.06);
    local _time = moveForSpd(pos.x * 0.7, pos.y, pos.z * 0.7, 0.007);

    if (_time >= 400) {
      pass(_time);
    } else {
      pass(400);
    }
    anime(59, 59, 0, false, 0.15);
    pass(150);
    disableTapChara(false);
  }

  function rotate_to_camera(time = 200) {
    print("~~~~~~~~~rotate_to_camera~~~~~~~~");
    rotateToCamera(time);
    setMotionFile("scene01");
    anime(655, 655, 0, false, 0.05);
    morphFace("def", 0);
    changeHand("pa", "pa");
    pass(50);
    anime(655, 663, 8, true);
    pass(time - 50);
  }

  function rotate_to_camera_spd() {
    setMotionFile("scene01");
    anime(655, 655, 0, false, 0.1);
    morphFace("def", 0);
    changeHand("pa", "pa");

    local time = rrotateToCameraSpd(0.3);
    pass(100);
    anime(655, 663, 8, true);
    pass(time - 100);
  }

  function link_test(cms) {
    local cm = cms[0];

    for (local i = 0; i < 3; i++) {
      cm.startScript("multipurpose_tefuri");
      multipurpose_pyonpyon();

      cm.startScript("stand_end");
      pass(1000);
    }
  }

  function appeal_ar() {
    setMotionFile("scene01");
    anime(264, 264, 0, false, 0.2);
    morphFace("kirasmile");
    startTalk("appeal_ar");
    pass(200);
    anime(264, 268, 8, false);
    pass(500);
    for (local i = 0; i < 2; i++) {
      anime(268, 280, 8, false);
      pass(1500);
    }
    anime(268, 270, 8, false);
    pass(250);
    stand_end();
  }

  function link_aisatsu(cms) {
    local cm = cms[0];

    cm.startScript("link_aisatsu_l_set");
    link_aisatsu_h_set();
  }

  function link_aisatsu_h_set() {
    teage_set("ooi");
    morphFace("meisou", 0);
    tere_set("tere");
    stand_end();
  }

  function link_aisatsu_l_set() {
    teage_set("ooi");
    morphFace("smile", 0);
    yokoyure_set(0, true);

    stand_end();
  }

  function ar_action_1() {
    playVoice("e13_1");
    tefuri_set(2, "warau");
    ar_dance_burabura_set(2, "smile");
    ar_dance_jump_set("def", "blink", "kya");
    ar_dance_l_set("smile3", "smile");
    ar_dance_r_set("smile", "smile3");
    playSound("chara/1000_11.wav");
    ar_dance_jump_r_set("kya", "smile");
    playSound("chara/1000_11.wav");
    ar_dance_jump_l_set("kya", "smile");
    playSound("chara/1000_11.wav");
    ar_dance_jump_l_set("kya", "smile");
    playSound("chara/1000_11.wav");
    ar_dance_jump_r_set("kya", "smile");
    playSound("odekake/jingle_3.wav");
    ar_dance_rotation_set(3, "smile", "blink");
    playSound("odekake/jingle_9.wav");
    ar_dance_jump_high_set("smile", "tere", "blink");
    ar_dance_kime_set(1, "nikawink");
    stand_end();
  }

  function ar_action_2() {
    tefuri_set(2, "smile3");
    playVoice("e13_1");
    ar_balloon_set(5);
    all_goods_cleaer();
    playVoice("e23");
    ar_balloon_fall_set();
    tv_standup2("yaba", "sad");
    setAREnableMotions(::ARPanel.UI_STATE_ENABLE);
  }

  function ar_arere() {
    playVoice("e25");
    clock_nayamu_set(4, "biku");
    stand_end();
  }

  function ar_balloon_set(num) {
    setMotionFile("scene01");
    anime(441, 441, 0, false, 0.2);
    changeHand("pa", "pa");
    morphFace("yaa", 0);
    pass(200);
    anime(441, 442.5, 5, false);
    pass(300);
    anime(442.5, 443, 1, false);

    add_goods("balloon", generate({ view = "/res/goods/goods_1/balloon.pm", parts = "hand_item_R", connect = true }));
    pass(100);
    morphFace("blink", 0);
    pass(150);
    morphFace("def", 0);
    pass(250);
    anime(443, 444, 2, false);
    setARShadowVisible(false);
    moveForSpd(10, 5, 0, 0.001);

    local ri = randomi(2);
    if (ri == 2) {

      pass(200);
      morphFace("blink", 0);
      pass(100);
      morphFace("def", 0);
      pass(100);
      morphFace("blink", 0);
      pass(100);
      anime(444, 446, 4, false);
      morphFace("def", 0);
      pass(500);

      morphFace("smile", 0);
    } else if (ri == 1) {

      pass(500);
      anime(444, 446, 4, false);
      morphFace("smile3", 0);
      pass(500);

    } else {

      pass(500);
      anime(444, 446, 4, false);
      morphFace("warau", 0);
      pass(500);

    }

    anime(446, 450, 2.5, true);
    pass(1000);

    if (ri < 2) {
      morphFace("nikawink", 0);
    }
    pass(2000);

    for (local i = 0; i < num; i++) {

      local ri2 = randomi(1);
      if (ri2 == 0) {
        anime(451, 455, 2.5, true, 0.3);
      } else {
        anime(446, 450, 2.5, true, 0.3);
      }

      local ri = randomi(2);

      if (ri == 2) {
        morphFace("blink", 0);
        pass(100);
        morphFace("def", 0);
        pass(100);
        morphFace("blink", 0);
        pass(100);
        morphFace("def", 0);
        pass(500);
        morphFace("smile", 0);
        pass(200);
      } else if (ri == 1) {
        pass(500);
        morphFace("smile3", 0);
        pass(500);
      } else {
        pass(500);
        morphFace("warau", 0);
        pass(500);
      }

      pass(500);

    }

  }

  function ar_balloon_fall_set() {
    setMotionFile("sit01");
    anime(855, 855, 0, false 0.1);
    changeHand("pa", "pa");
    pass(100);
    anime(855, 856, 5, false);
    morphFace("bikkuri", 0);
    moveForSpd(0, -5, 0, 0.01);
    pass(200);
    morphFace("bikkuri", 0);
    anime(856, 858, 10, true);
    pass(400);

    moveAccel(0.3, 1, 0, 600, 0.1, -0.1);
    pass(200);
    moveAccel(-0.3, 1, 0, 600, -0.1, 0.1);
    pass(200);
    moveAccel(0.1, 0.5, 0, 300, 0.1, -0.1);
    pass(100);
    moveAccel(-0.1, 0.5, 0, 150, -0.05, 0.05);
    pass(100);

    setARShadowVisible(true);
    anime(858, 859, 4, false);
    pass(250);
    anime(859, 860, 5, false);
    pass(200);
    anime(860, 861, 5, false);
    pass(200);
    morphFace("blink", 0);
    pass(100);
    morphFace("bikkuri", 0);
    pass(100);
    anime(859, 861, 4, true);
    pass(500);
    morphFace("blink", 0);
    pass(100);
    morphFace("bikkuri", 0);
    pass(100);
    morphFace("blink", 0);
    pass(150);
    morphFace("bikkuri", 0);
    pass(150);
    anime(861, 861.2, 2, false);
    pass(100);
    anime(861.2, 862, 5, false);
    morphFace("mu", 0);
    pass(160);
    anime(862, 863, 4, false);
    pass(250);
    anime(863, 863, 4, false);
    pass(250);

  }

  function ar_bikkuri() {
    playVoice("e17");
    pyonpyon_set(3, "bikkuri", "bikkuri");
  }

  function ar_dance_kime_set(num, face) {
    setMotionFile("scene01");
    anime(100, 100, 0, false, 0.18);
    morphFace(face, 0);
    pass(180);
    anime(100, 106, 20, false);
    pass(300);
    generate({ view = "/res/efx/ptd/levelupstart.ptd", pos = [0, 1.5, 0] });

    anime(106, 110, 16, false);
    pass(250);

    anime(110, 114, 3, false);
    pass(1333);

    for (local i = 0; i < num; i++) {
      anime(114, 118, 8, false);
      pass(500);
    }
  }

  function ar_doya() {
    playVoice("ar_doya");
    setMotionFile("scene01");
    anime(256, 256, 0, false, 0.15);
    morphFace("blink", 0);
    changeHand("gu", "gu");
    pass(150);
    anime(256, 257, 5, false);
    pass(200);
    anime(257, 258, 6.5, false);
    pass(154);

    for (local i = 0; i < 3; i++) {
      anime(258, 258.1, 0.5, false);
      pass(200);
      anime(258.1, 258.9, 1.4, false);
      pass(574);

      anime(258.9, 259.1, 0.8, false);
      pass(250);

      anime(259.1, 259.9, 2, false);
      pass(400);
      anime(259.9, 260, 1, false);
      pass(100);
    }
    anime(256, 256, 0, false, 0.15);
    pass(150);
    end_common();
  }

  function ar_ehhen() {
    morphFace("def", 0);
    setMotionFile("scene01");
    anime(284, 284, 0, false, 0.1);
    pass(500);
    playVoice("e8");
    anime(284, 285, 10, false);
