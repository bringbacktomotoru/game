    setMotionFile("scene01");
    anime(768.5, 768.5, 0, false, 0.2);
    morphFace(face1);
    pass(200);
    anime(768.5, 770, 5, false);
    pass(300);

    levelupend_dance_l();
    levelupend_dance_r();

    anime(770, 770.8, 12, false);
    pass(67);
    anime(770.8, 771, 5, false);
    pass(40);
    anime(771, 771.2, 2, false);
    pass(100);
    anime(771.2, 772.9, 15, false);

    local randomface1 = randomi(2);
    if (randomface1 < 2) {
      morphFace("warau");
    }
    if (randomface1 < 1) {
      morphFace("nikawink");
    }
    else {
      morphFace("kya");
    }

    pass(113);
    anime(772.9, 773, 0.5, false);
    pass(200);
    anime(773, 773.2, 1, false);
    pass(200);
    anime(773.2, 774.8, 12, false);
    morphFace(face2);
    pass(133);
    anime(774.8, 775, 2, false);
    pass(100);

  }

  function ar_dance_r_set(face1, face2) {
    setMotionFile("scene01");
    anime(775, 775, 0, false, 0.1);
