printf("Start of KittyEditor\n");

::DEBUG <- true;

::viewWidth <- 720.0;
::viewHeight <- 1280.0;

::screenWidth <- 720.0;

::screenHeight <- 1280.0;

::displayWidth <- 0.0;
::displayHeight <- 0.0;

::DISPLAY_SCALE <- 0.8;

skCreateScreen("uuaaa", 980, 644, 2);

skInitializeSound();

skBeginRender();
local cp = ClearParam();
cp.R = 1.0; cp.G = 1.0; cp.B = 1.0;
cp.depth = 1.0;
skClearParam(cp);

loadUI("ui.silver");

runsk("load.sk");

local f = FileRef(skGetBinBaseDir());
local r = createResource(f);
::resroot.install(r);
runsk("/util/sk3viewer/load.sk");

skSetFPS(60.0);

local time = skGetTime();
::rootview = SKRootView();
::rootview.autoresize = true;

local sk3v = SK3Viewer();
sk3v.setRect(0, 0, 980, 644);
sk3v.stageenv = ::gamesetting.stageenv["grassland"];
::rootview.addChild(sk3v);

if (length(::arguments) > 0) {
  sk3v.openFile(FileRef(::arguments[0]));
}

while (!::rootview.quit) {
  local t = skGetTime();
  ::rootview.update(t - time);

  time = t;
  suspend();
}

printf("OWARI!!!!!!\n");
skEndRender();

printf("End of KittyEditor\n");