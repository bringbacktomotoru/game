scriptclass = "SK3DScriptRunner"

script =
{

  function start(x, y, z) {

    generate({ view = "/res/efx/ptd/bubble.ptd", scale = 0.15, connect = true });

    for (local i = 1; i <= 2; i++) {
      local h = ::PUBLIC_RANDOM.nexti(90) - 45;
      generate({ view = "/res/efx/ptd/efx_gm.sk3", scale = 0.15, hpb = [0, 0, h], connect = true, script = "start" });
    }
    for (local i = 1; i <= 2; i++) {
      local h = ::PUBLIC_RANDOM.nexti(90) - 135;
      generate({ view = "/res/efx/ptd/efx_gm.sk3", scale = 0.15, hpb = [0, 0, h], connect = true, script = "start" });
    }
    for (local i = 1; i <= 2; i++) {
      local h = ::PUBLIC_RANDOM.nexti(90) - 225;
      generate({ view = "/res/efx/ptd/efx_gm.sk3", scale = 0.15, hpb = [0, 0, h], connect = true, script = "start" });
    }
    for (local i = 1; i <= 2; i++) {
      local h = ::PUBLIC_RANDOM.nexti(90) - 315;
      generate({ view = "/res/efx/ptd/efx_gm.sk3", scale = 0.15, hpb = [0, 0, h], connect = true, script = "start" });
    }

    pass(1700 + Math.rndi(300, false));
    moveAccel(x, y, z, 900, 0, 0.01);
    pass(900);
    moveAccel(x, y, z, 1000, 0.01, 0.07);
    pass(1000);
  }
}