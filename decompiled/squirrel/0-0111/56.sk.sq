scriptclass = "SK3DScriptRunner"

script =
{
  function start() {
    generate({ view = "/res/efx/ptd/TapHapiness3_ring.ptd", scale = 1, connect = true });

    local efxs = [];

    for (local i = 1; i <= randomi(1, false); i++) {
      local h = randomi(120, false);
      efxs + generate({ view = "/res/efx/ptd/TapHapiness3_tap.ptd", scale = 1.1, hpb = [0, 0, h], connect = true });
    }
    for (local i = 1; i <= randomi(1, false); i++) {
      local h = randomi(120, false) + 120;
      efxs + generate({ view = "/res/efx/ptd/TapHapiness3_tap.ptd", scale = 1.1, hpb = [0, 0, h], connect = true });
    }
    for (local i = 1; i <= randomi(1, false); i++) {
      local h = randomi(120, false) - 120;
      efxs + generate({ view = "/res/efx/ptd/TapHapiness3_tap.ptd", scale = 1.1, hpb = [0, 0, h], connect = true });
    }
  }
}