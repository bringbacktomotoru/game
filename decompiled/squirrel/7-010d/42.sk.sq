model =
{
  root = {
  }
  punch = {
    pm = "genkotsu.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function start() {
    setScale(0.9);
    $punch.setScale(0.6)
    $punch.moveFor(0.0, 0.0, 1.0, 300);
    $punch.zoomTo(1.0, 1.0, 1.0, 130)

    $punch.generate({ view = "../efxline/efxline.sk3", pos = [0, 0, 0], scale = [1.3, 1.3, 2.5], connect = 1 });
    $punch.generate({ view = "../restart/genkotsu_sw.sk3", pos = [0, 0, -0.5], scale = [2, 2, -2], connect = 1 });
    pass(150);
    setBlend(SK_MIX);
    fadeAlpha(0, 50);
    pass(50);
    kill();
  }
}