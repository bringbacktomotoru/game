model =
{
  root = {
  }
  punch = {
    pm = "genkotsu.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{

  function start() {
    setScale(0.8);
    $punch.setScale(0.6)
    $punch.zoomTo(1.0, 1.0, 1.0, 80)
    $punch.moveFor(0.0, 2.0, 1.0, 80);
    pass(80)
    $punch.moveFor(0.0, -3.0, 0.0, 60);
    $punchgenerate({ view = "../efxline/efxline.sk3", hpb = [0, 90, 0], scale = [1.3, 1.3, 2], pos = [0, 0.5, -0.2], connect = 1 });
    pass(100);
    attack();
  }

  function end() {
  }

  function attack() {
    setBlend(SK_MIX);
    vibe(0.05, 1000);
    $punch.generate({ view = "../../ptc/genkotsu_hammer.ptd", pos = [0, -2.2, 0] });
    pass(400);
    fadeAlpha(0, 100);
    pass(100);
    kill();
  }
}