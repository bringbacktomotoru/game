model =
{
  root = {
    pm = "sw_pyramid.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
    setBlend(SK_ADD);
    setScale(0.5);
  }

  function start() {
    spin(0, 400, 0, 800);
    uvscroll(0, 8);
    zoomTo(1.2, 0.3, 1.2, 50);
    pass(50);
    zoomTo(0.7, 0.8, 0.7, 50);
    pass(50);
    zoomTo(0.0, 0.3, 0.0, 150);
    pass(150);
    kill();
  }
}