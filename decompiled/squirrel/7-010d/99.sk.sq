scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
  }

  pass1 = 200
  pos1 = 1

  function start() {
    generate({ view = "windcutter_sl.sk3", pos = [0, pos1, 0], hpb = [-10, 0, 40], scale = [5, 5, 5], connect = 1 });
    pass(pass1);
    generate({ view = "windcutter_sr.sk3", pos = [0, pos1, 0], hpb = [-50, 20, 20], scale = [3, 3, 3], connect = 1 });
    pass(pass1);
    generate({ view = "windcutter_sl.sk3", pos = [0, pos1, 0], hpb = [0, 20, 10], scale = [5, 5, 5], connect = 1 });
    pass(pass1);
    generate({ view = "windcutter_sr.sk3", pos = [0, pos1, 0], hpb = [0, -25, 30], scale = [4.5, 4.5, 4.5], connect = 1 });
  }
}