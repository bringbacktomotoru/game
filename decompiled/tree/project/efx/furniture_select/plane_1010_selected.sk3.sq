model =
{
  root = {
    pm = "plane_1010.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
  }

  function start() {
    setBlend(SK_ADD);
    fadeColor(32512, 0);
    for (;;) {
      fadeColor(52992, 800);
      pass(800);
      fadeColor(32512, 800);
      pass(800);
    }
  }
}