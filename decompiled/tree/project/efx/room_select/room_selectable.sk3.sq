model =
{
  root = {
    pm = "room_select.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
  }

  function start() {
    deselect();
  }

  function select() {
    setBlend(SK_ADD);
    fadeColor(0xcf000000, 0);
    for (;;) {
      fadeColor(0xcf000000, 800);
      pass(800);
      fadeColor(1056964608, 800);
      pass(800);
    }
  }

  function deselect() {
    setBlend(SK_ADD);
    fadeColor(52992, 0);
    for (;;) {
      fadeColor(52992, 800);
      pass(800);
      fadeColor(16128, 800);
      pass(800);
    }
  }
}