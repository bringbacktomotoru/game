model =
{
  root = {
    pm = "lightning.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
    setScale(2.0, 2.0, 2.0);
  }

  function start() {
    setBlend(SK_ADD);

    spin(0, 150, 0, 10);
    fadeColor(1153171455, 30);
    generate({ view = "../../ptc/lightning_hit.ptd" });

    pass(65);
    spin(0, -80, 0, 10);
    pass(65);

    spin(0, 300, 0, 10);
    fadeColor(255, 30);
    pass(65);

    spin(0, -100, 0, 10);
    fadeColor(0xffff22ff, 30);
    pass(65);
    spin(0, 150, 0, 10);
    pass(65);

    spin(0, 300, 0, 10);
    fadeColor(255, 30);
    pass(65);

    kill();
  }
}