model =
{
  root = {
    pm = "lstraight.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
  }

  function start() {
    setBlend(SK_ADD);
    uvscroll(0, 6);
    for (;;) {
      fadeColor(1153171455, 30);
      spin(0, 0, 100, 100);
      setPivot(0, 0, -0.3);
      setScale(1.4);
      pass(65);
      pass(65);
      fadeColor(255, 30);
      pass(65);

      fadeColor(0xffff22ff, 30);
      spin(0, 0, 100, 100);
      setPivot(0.25, 0, 0.3);
      setScale(1.8);
      pass(65);
      pass(65);
      fadeColor(255, 30);
      pass(65);
    }

  }
}