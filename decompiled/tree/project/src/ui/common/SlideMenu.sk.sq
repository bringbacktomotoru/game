class SlideMenu_H {
  static ANIMATION_TIME = 200;

  elems = null;
  btn = null;
  back = null;

  is_open = false;

  curr_time = 0;

  constructor(btn) {
    this.elems = [];
    this.btn = btn;

    ::TapButton(btn, false);
    btn.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function addBack(back) {
    this.back = back;

    backAnime(back);
  }

  function _findElem(view) {
    foreach (elem in elems) {
      if (elem[0] == view) return elem;
    }

    return undefined;
  }

  function addElem(view) {
    local elem = _findElem(view);
    if (elem) return;

    this.elems + [view, view.pos.x];
    elemAnime(view, view.pos.x);
  }

  function removeElem(view) {
    local ret = null;
    foreach (elem in elems) {
      if (elem[0] == view) {
        ret = elem;
        removei;
        break;
      }
    }

    return ret[0];
  }

  function changeElemView(old_view, new_view) {
    local elem = _findElem(old_view);
    if (!elem) return;

    elem[0] = new_view;
    new_view.setPosition(elem[1].x, elem[1].y);
    new_view.matdirty = true;
  }

  function updateElemPos(view) {
    local elem = _findElem(view);
    elem[1] = view.pos.x;
  }

  function clearElems() {
    this.elems.clear();
  }

  function backAnime(back) {
    back.setColor(0xffffff00 + 255 * Math.min(1, float(curr_time) / ANIMATION_TIME));
    back.matdirty = true;
  }

  function elemAnime(e, pos) {
    e.setColor(0xffffff00 + 255 * Math.min(1, curr_time / (ANIMATION_TIME / 2.0)));
    e.pos.x = pos * curr_time / ANIMATION_TIME;
    e.enabled = curr_time == ANIMATION_TIME;
    e.matdirty = true;
  }

  function updateFrame(dt) {
    this.curr_time = this.is_open ? Math.min(curr_time + dt, ANIMATION_TIME) : Math.max(curr_time - dt, 0);

    if (back) backAnime(back);
    foreach (elem in this.elems) {
      elemAnime(elem[0], elem[1]);
    }

    if (this.curr_time % ANIMATION_TIME == 0) this.btn.updateFunc = null;
  }

  function mouseevent(e) {
    if (e.id == MOUSE_PRESSED) {
      slide();
    }

    e.consume();
  }

  function slide() {
    if (this.is_open) {
      this.is_open = false;
      this.btn.setUpdateFunc(this.updateFrame.bindenv(this));
    }
    else {
      this.is_open = true;
      this.btn.setUpdateFunc(this.updateFrame.bindenv(this));
    }
  }

}