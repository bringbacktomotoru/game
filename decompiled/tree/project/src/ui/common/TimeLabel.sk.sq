class TimeLabel {
  remain = 0;
  label = null;

  is_cd = false;
  is_end = false;
  elapse_ms = 0;
  repeat_interval = 0;
  last_repeat_func_time = 0;
  update_count = 0;

  end_func = null;
  repeat_func = null;

  timeslice = -1;

  static D_SCALE = 60 * 60 * 24;
  static H_SCALE = 60 * 60;
  static M_SCALE = 60;

  constructor(label, time, slice = -1) {
    this.label = label;
    remain = time;
    if (remain < 0) remain = 0;

    is_cd = false;
    this.end_func = null;
    this.repeat_func = null;

    timeslice = slice;

    calcAndSetText(remain);
  }

  function setRemainTime(_remain) {
    this.remain = _remain;
    if (remain < 0) remain = 0;

    calcAndSetText(remain);
  }

  function getDay() {
    local param = calc(this.remain);
    return param.day;
  }

  function calc(remain) {
    local param = {};
    param.day <- remain / D_SCALE;
    param.hour <- (remain - param.day * D_SCALE) / H_SCALE;
    param.minute <- (remain - param.day * D_SCALE - param.hour * H_SCALE) / M_SCALE;
    param.sec <- (remain - param.day * D_SCALE - param.hour * H_SCALE - param.minute * M_SCALE);

    return param;
  }
  function calcAndSetText(remain) {

    if (label) {
      this.label.setText(::getTimeText(remain, this.timeslice));
      label.matdirty = true;
      label.repaint();
    }
  }

  function getRemainTime() {
    return remain;
  }
  function isEnd() {
    return is_end;
  }

  function setEndFunc(_func) {
    this.end_func = _func;
  }

  function setRepeatFunc(_func, interval) {
    this.repeat_func = _func;
    this.repeat_interval = interval;
    last_repeat_func_time = 0;
  }
  function resetRepeatFunc() {
    this.repeat_func = null;
  }

  function startCountDown(force = false) {
    if (!force && is_cd) return;
    if (!label) return;

    is_cd = true;

    if (remain > 0) {
      this.label.setUpdateFunc(updateFrame.bindenv(this));

      elapse_ms = 0;
      update_count = 0;
      is_end = false;
    } else {
      is_end = true;
      if (end_func) end_func();
    }

  }
  function stopCountDown() {
    this.is_cd = false;
  }

  function updateFrame(dt) {
    if (is_end) return;
    if (!is_cd) return;

    elapse_ms += dt;
    update_count += dt;

    if (update_count > 1000) {
      this.remain--;
      calcAndSetText(remain);

      if (remain <= 0) {
        is_end = true;
        if (end_func) end_func();
      }

      update_count -= 1000;
    }

    if (repeat_func) {
      if (elapse_ms - last_repeat_func_time > repeat_interval) {
        repeat_func();
        last_repeat_func_time = elapse_ms;
      }
    }
  }
}