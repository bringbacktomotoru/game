import SKViewPropertyID;

class BaseIcon extends SKView {
  static LONG_TAP_TIME = 1;

  data = null;
  setting = null;

  tap_pressed = false;
  start_tap_time = 0;
  tap_func = null;
  long_tap_func = null;
  mouse_func = null;

  view = null;
  btn = null;

  constructor() {}

  function setData(_data) {
    this.data = _data;
  }
  function setSetting(_setting) {
    this.setting = _setting;
  }
  function reset() {
    setting = null;
    data = null;
  }

  function getSetting() {
    return setting;
  }
  function getData() {
    return data;
  }

  function setTapFunc(_func) {
    tap_func = _func;
  }

  function setLongTapFunc(_func) {
    long_tap_func = _func;
  }

  function setMouseFunc(_func) {
    mouse_func = _func;
  }

  function setPos(x, y) {
    this.matdirty = true;
    view.pos.set(x, y, 0);
  }
  function setVisible(b) {
    this.view.visible = b;

  }

  function _setIconImage(cmp, path) {
    local sp = ::getSprite(path);
    sp.blend = SK_MIX;
    cmp.setSprite(sp);
  }

  function actionevent(e) {
    e.consume();

    switch (e.actioncmd) {
    case "pressed":
      tap_pressed = true;
      start_tap_time = ::getServerTime();
      break;
    case "canceled":
    case "swipein":
    case "swipeout":
    case "dropped":
    case "swiped":
      tap_pressed = false;
      start_tap_time = -1;
      break;
    case "released":
      if (tap_pressed) {
        if (::getServerTime() - start_tap_time > LONG_TAP_TIME) {
          processLongTap();
          return;
        }
        else {
          processTap();
          return;
        }

      }

      tap_pressed = false;
      start_tap_time = -1;
      break;
    }
  }

  function processLongTap() {
  }

  function processTap() {
  }
}

class CostumeIcon extends BaseIcon {
  setting = null;

  lbl_name = null;
  lbl_level = null;
  lbl_icon = null;
  cmp_grade = null;
  img_equip = null;
  img_current = null;

  constructor(id, view = null, consume = true, tap = true) {
    super();

    this.view = view;
    this.setting = ::gamesetting.costume_settings[id];

    local sp = ::getSprite(this.setting.getCostumeIconPath());
    sp.blend = SK_MIX;

    if (this.view) {
      this.view.setSprite(sp);
      this.view.updateLayout();
    } else {
      this.view = SKImageView(sp);
      addChild(view);
    }
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    if (tap) {
      local btn = ::TapButton(this.view, consume);
      btn.view.addEventListener(ACTION_EVENT, actionevent);
      btn.setPressedPostAction(true);
      btn.setEnabledPullAction(false);
      btn.view.addEventListener(MOUSE_EVENT, mouseevent);
    }
  }

  function setSetting(_setting) {
    super.setSetting(_setting);

    this.data = ::gamesession.getUserData().getCostumeData(setting.id);
    _setupIcon();
  }

  function setData(_data) {
    super.setData(_data);

    this.setting = ::game_setting.costume_settings[data.id];
    _setupIcon();
  }

  function _setupIcon() {

    if (setting) {
      this.lbl_name.setText(setting.name);
      _setIconImage(lbl_icon, setting.getCostumeIconPath());
      _setGradeImage(setting.grade);
    }

    if (data) {
      this.lbl_level.setText(data.getLevel());
      lbl_icon.setColor(0xffffffff);
    } else {

      this.lbl_level.setText("");
      lbl_icon.setColor(COLOR_DISABLE);
    }
  }

  function _setGradeImage(grade) {
    for (local i = 1; i <= COSTUME_MAX_RARITY; i++) {
      local _img_path = "img_grade" + i;
      local _img = cmp_grade.findChild(_img_path);
      _img.visible = i <= grade ? true : false;
    }
  }

  function setVisibleEquipImage(b) {
    img_equip.visible = b;
  }
  function setVisibleCurrentImage(b) {
    img_current.visible = b;
  }

  function actionevent(e) {
    super.actionevent(e);
  }

  function mouseevent(e) {

    if (e.id == MOUSE_DRAGGED) this.tap_pressed = false;
  }

  function processLongTap() {
    super.processLongTap();

    if (long_tap_func) {
      long_tap_func(this);
    }
    else {
      local home_ui = ::gamesession.getCurrentScene().getUI();
      home_ui.movePanel(::CharaCostumePanel, false, { "id" = this.setting.id });
    }
  }

  function processTap() {
    super.processTap();
    if (tap_func) tap_func(this);
  }
}

class CharaIcon extends BaseIcon {
  btn = null;
  setting = null;

  constructor(chara_id, cmp = null, tap = true) {
    super();

    this.setting = ::gamesetting.sanrio_chara_settings[chara_id];

    this.btn = SKImageView(::getSprite(this.setting.getIconPath()));
    this.btn.setEnabled(true);

    addChild(this.btn);
    setRect(0, 0, this.btn.bnd.w, this.btn.bnd.h);

    if (tap) ::TapButton(this.btn, false).view.addEventListener(ACTION_EVENT, actionevent);
    this.btn.addEventListener(MOUSE_EVENT, mouseevent);

  }

  function setIconImage(path) {
    super._setIconImage(this.btn, path);
  }

  function actionevent(e) {
    super.actionevent(e);

    tap_func(setting.chara_id);
  }

  function getCharaID() {
    return this.setting.getID();
  }

  function mouseevent(e) {
    if (!mouse_func) return;
    mouse_func(e);
  }
}

class FurnitureIcon extends BaseIcon {
  item_data = null;

  pnl_furniture = null;
  lbl_using = null;
  img_bg = null;

  function setup(data) {
    this.item_data = data;
  }

  function build(parent) {
    if (!this.item_data) return;

    this.view = loadSKView("/ui/common/FurnitureItem.ui");

    addChild(view);
    setRect(0, 0, view.bnd.w, view.bnd.h);

    this.btn = view.findChild("btn_furniture");
    this.img_bg = btn.findChild("img_decoration_furniturebg");
    this.pnl_furniture = btn.findChild("pnl_furnitureicon");

    this.lbl_using = this.view.findChild("lbl_using");

    setIconImage();

    this.lbl_using.visible = false;

    parent.addChild(this);

  }

  function setIconImage() {

    local path = "/image/icon/furniture/" + item_data.getID() + "_" + item_data.getCurrentViewIndex() + ".png"
    local sp = Sprite(::getTexture("/image/icon/furniture/" + item_data.getID() + "_0.png"));
    sp.blend = SK_MIX;
    local _tmp = SKImageView();
    _tmp.setSprite(sp);
    pnl_furniture.addChild(_tmp);
  }

  function release() {
    if (!view) return;
    removeChild(this.view);

    this.view = null;
    this.btn = null;
    this.img_bg = null;
    this.pnl_furniture = null;
    this.lbl_using = null;

    this.swipe_view = null;

    parent.removeChild(this);
  }

  function putUsingMarker() {
    this.lbl_using.visible = true;
    this.img_bg.setColor(0x999999ff);

  }

  function enableUsingMarker(enable) {
    if (enable) putUsingMarker();
    else {
      this.lbl_using.visible = false;
      this.img_bg.setColor(0xffffffff);

    }
  }

  function _dummyPressButton(x, y) {

    local tap = ::SwipeButton(this.btn);

    tap.sound = null;
    tap.pressed(x, y);
    tap.released(x, y);
    tap.remove();
  }

  function getEditPanel() {
    return this.parent.parent.parent.parent;
  }
}

class ShopFurnitureIcon extends BaseIcon {
  shop_id = -1;

  pnl_furniture = null;

  lbl_price = null;
  img_gm = null;
  img_rm = null;

  function create(shop_id = -1) {
    if (shop_id != -1) {
      local shop_setting = ::gamesetting.shop_settings[shop_id];
      if (!shop_setting) {

        ::debugPrint("shop setting is not found...  id : " + shop_id + "\n");
        return null;
      }

      if (!shop_setting.isAvailable()) {
        return null;
      }

      if (shop_setting.visible_conditions && !::checkCondition(shop_setting.visible_conditions, ::gamesetting.condition_settings)) {
        return null;
      }

      local view = ::loadSKView("/ui/common/FurnitureSellItem.ui", ::ShopFurnitureIcon);
      view.createView(shop_id);
      return view;
    }
    else {
      return ::loadSKView("/ui/common/FurnitureSellItem.ui", ::ShopFurnitureIcon);
    }
  }
  function loadFinished() {
    this.btn = findChild("btn_furniture");
    this.pnl_furniture = findChild("pnl_furnitureicon");
    this.lbl_price = findChild("lbl_price");
    this.img_gm = findChild("img_gm");
    this.img_rm = findChild("img_rm");
  }

  function createView(shop_id) {
    if (this.shop_id != -1) {
      removeView();
    }

    if (shop_id != -1) {
      this.shop_id = shop_id;
      local shop_setting = ::gamesetting.shop_settings[this.shop_id];
      if (!shop_setting) {

        ::debugPrint("shop setting is not found...  id : " + this.shop_id + "\n");
        removeView();
        return;
      }
      _applySetting(shop_setting);
    }

    if (parent) {
      parent.addChild(this);
    }
  }
  function removeView() {

    ::debugPrint("released. id : " + this.shop_id + "\n");

    this.shop_id = -1;
  }

  function _applySetting(shop_setting) {

    switch (shop_setting.getPriceType()) {
    case PRICE_GM:
      this.img_gm.setVisible(true);
      this.img_rm.setVisible(false);
      break;
    case PRICE_RM:
      this.img_gm.setVisible(false);
      this.img_rm.setVisible(true);
      break;
    case PRICE_ONEROUS_RM:
      this.img_gm.setVisible(false);
      this.img_rm.setVisible(true);
      break;
    }

    this.lbl_price.setText(shop_setting.price);

    local sp = Sprite(::getTexture("/image/icon/furniture/" + shop_setting.item_id + "_0.png"));
    sp.blend = SK_MIX;
    local item_view = SKImageView(sp);
    this.pnl_furniture.addChild(item_view);
  }

  function putUsingMarker() {
  }

  function enableUsingMarker(enable) {
  }

  function _dummyPressButton(x, y) {

    local tap = ::SwipeButton(this.btn);

    tap.sound = null;
    tap.pressed(x, y);
    tap.released(x, y);
    tap.remove();
  }
}

class MotionIcon extends BaseIcon {
  chara = null;

  state = -1;

  constructor(view = null, consume = true, chara = null) {
    super();

    this.view = view;
    this.chara = chara;

    addChild(view);

    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    local btn = ::TapButton(this.view, consume);
    btn.view.addEventListener(ACTION_EVENT, actionevent);
    btn.setPressedPostAction(true);
    btn.setEnabledPullAction(false);
    btn.view.addEventListener(MOUSE_EVENT, mouseevent);
    this.state = -1;
  }

  function setCostumeMotion(id) {
    this.setting = ::gamesetting.costume_motion_settings[id];
    local _pnl_icon = view.findChild("pnl_icon");

    local _sp = setting.getIconSprite(-1, true);
    view.setSprite(_sp);
    view.setRect(0, 0, _sp.bnd.w, _sp.bnd.h);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    updateLayout();
  }

  function setRandomMotion(is_nomove = false) {
    state = is_nomove ? ::ActionSetting.TYPE_NOMOVE : ::ActionSetting.TYPE_RANDOM;
    local _sp = ::ActionSetting.getIconSprite(state, true);
    view.setSprite(_sp);
    view.setRect(0, 0, _sp.bnd.w, _sp.bnd.h);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    updateLayout();
  }

  function actionevent(e) {
    super.actionevent(e);
  }

  ux = null;
  uy = null;
  dx = null;
  dy = null;
  function mouseevent(e) {

    switch (e.id) {
    case MOUSE_DRAGGED:
      local view_scale = ::getDisplayScale();
      dx += e.x - ux;
      dy += e.y - uy;
      tap_pressed = _inBound();
      ux = e.x;
      uy = e.y;
      break;
    case MOUSE_PRESSED:
      ux = e.x;
      uy = e.y;
      dx = dy = 0.0;
      break;
    }
  }

  function getState() {
    return state;
  }

  function _inBound() {
    return Vector3D(dx, dy, 0).length() < Vector3D(view.bnd.w / 2.0, view.bnd.h / 2.0, 0).length();
  }

  function processLongTap() {
    super.processLongTap();

  }

  function processTap() {
    super.processTap();
    if (tap_func) tap_func(this);
  }

  function getChara() { return chara; }
}

class RewardIcon {
  kind = null;
  id = null;
  num = null;

  base_w = null;
  base_h = null;

  view = null;
  img_frame = null;
  img_icon = null;
  lbl_num = null;

  constructor(kind, id, num) {
    this.view = ::loadSKView("/ui/common/RewardCard2.ui");
    this.img_frame = this.view.findChild("img_frame");
    this.img_icon = this.view.findChild("img_icon");
    this.lbl_num = this.view.findChild("lbl_num");

    this.base_w = this.view.bnd.w;
    this.base_h = this.view.bnd.h;

    this.kind = kind;
    this.id = id;
    this.num = num;

    _setupFrame();
    _setupIcon();
    _setupNum();
  }

  function setRect(x, y, w, h) {
    this.view.setRect(x, y, w, h);

    local rate_w = w / this.base_w;
    local rate_h = h / this.base_h;

    foreach (c in this.view.children) {
      c.pos.x = c.pos.x * rate_w;
      c.pos.y = c.pos.y * rate_h;
      c.bnd.w = c.bnd.w * rate_w;
      c.bnd.h = c.bnd.h * rate_h;

      if (c instanceof SKLabelView) {
        c.fontattr.size = c.fontattr.size * rate_w;
      }

      c.updateLayout();
    }

  }

  function _setupFrame() {
    local _sp = ::Setting.getItemFrame(this.kind);
    if (_sp) {
      this.img_frame.setSprite(_sp);
      this.img_frame.updateLayout();
    } else {
      this.img_frame.setVisible(false);
    }
  }

  function _setupIcon() {
    local _sp = null;
    switch (this.kind) {
    case ITEM_TYPE_ONEROUSRM:
    case ITEM_TYPE_FREERM:
      _sp = ::Setting.getRMIconSprite();
      break;
    case ITEM_TYPE_GM:
      _sp = ::Setting.getGMIconSprite();
      break;
    case ITEM_TYPE_MOTION:
      local _setting = ::gamesetting.costume_motion_settings[this.id];
      _sp = _setting.getIconSprite(-1, true);
      break;
    case ITEM_TYPE_HEALTH:
      _sp = ::getSprite("/ui/image/icon/icon/icon_health.png");
      _sp.blend = SK_MIX;
      break;
    }

    if (_sp) {
      this.img_icon.setSprite(_sp);
      this.img_icon.updateLayout();
    } else {
      this.img_icon.setVisible(false);
    }
  }
  function _setupNum() {
    if (this.num > 0) {
      this.lbl_num.setText(::dict.get("nums_kakeru", [this.num]));
    } else {
      this.lbl_num.setVisible(false);
    }
  }
}