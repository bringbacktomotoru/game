class TutorialLayer extends SKView {
  cmv = null;
  tw = null;
  wait = null;

  v_1 = Vector3D();

  constructor() {
    bnd.set(0, 0, ::screenWidth, ::screenHeight);

    this.cmv = ::CircleMaskView();
    addChild(this.cmv);
    this.cmv.pickable = false;

    this.tw = null;

    this.addEventListener(MOUSE_EVENT, mousenevent)
    this.wait = false;
  }

  function setRect(x, y, w, h, px = 0, py = 0) {
    super.setRect(x, y, w, h, px, py);
    this.cmv.setRect(x, y, w, h, px, py);
    updateLayout();
  }

  function focusOver(time) {
    this.cmv.focusover(time);
  }
  function focusIn(x, y, sx, sy, time) {
    local ax = (::screenWidth - ::viewWidth) / 2;
    local ay = (::screenHeight - ::viewHeight) / 2;

    x -= ax;
    y -= ay;

    this.cmv.focusin(x, y, sx, sy, time);
  }
  function focusOut(time = 200) {
    this.cmv.focusout(time);
  }
  function focusView(view, p = null, time = 300, sx_scale = 1.0, ay_scale = 1.0, offset = null) {
    local pos;
    if (p) {
      pos = ::getViewCenterPosGlobal(view, p);
    } else {
      pos = view.pos;
      pos.x += view.bnd.x + view.bnd.w / 2 + (::screenWidth - ::viewWidth) / 2.0;
      pos.y += view.bnd.y + view.bnd.h / 2 + (::screenHeight - ::viewHeight) / 2.0;
    }

    if (offset) {
      pos.x += offset.x;
      pos.y += offset.y;
    }

    local bnd = view.bnd;
    focusIn(pos.x, pos.y, bnd.w / 2 * sx_scale, bnd.h / 2 * ay_scale, time);
  }

  function focusModel(mdl, time = 300) {
    v_1.set(0, 0, 0);
    local sk3d = mdl.obj.sk3d;
    if (sk3d.parent) {
      local bone = sk3d.parentbone;
      local p0 = bone.parts.bindpose;
      v_1.set(p0[12], 0, p0[14]).transform0(sk3d.parent.gmat);
      v_1.add(sk3d.parent.pos);
    }
    v_1.add(mdl.getPos());
    v_1.add(0, 0.8, 0);
    local _stage = ::gamesession.getCurrentScene().getStage();
    local _v = _stage.renderer.camera.project(v_1);

    local _x = (::screenWidth - ::viewWidth) / 2.0 + ::screenWidth * _v.x;
    local _y = (::screenHeight - ::viewHeight) / 2.0 + ::screenHeight * _v.y;

    focusIn(_x, _y, 100, 100, time);
  }

  function hideAll() {
    if (this.tw) this.tw.removeView();
    focusOut();
  }

  function showText(txt, pos_type = -1, tap = true, snd = true) {
    this.tw = TextWindow(this);
    if (pos_type >= 0) this.tw.setPosSet(pos_type);
    this.tw.setText(txt);
    this.tw.show(tap);
    if (snd) ::playSound(::SoundConstants.SOUND_TUTORIAL_SHOW_TEXT);
  }
  function updateText(txt, pos_type = -1) {
    if (!tw) {
      showText(txt, pos_type);
      return;
    }
    if (pos_type >= 0) this.tw.setPosSet(pos_type);
    this.tw.setText(txt);
    ::playSound(::SoundConstants.SOUND_TUTORIAL_UPDATE_TEXT);
  }
  function hideText() {
    if (!this.tw) return;
    this.tw.hide();
  }

  function mousenevent(e) {
    e.consume();
    switch (e.id) {
    case MOUSE_RELEASED:
      this.wait = false;
      break;
    }
  }

  function waitTap() {
    this.pickable = true;
    this.wait = true;

    while (this.wait) {
      suspend();
    }
    this.pickable = false;
  }
}

class TutorialLayer.TextWindow {
  pos_set = null;
  pos_type = null;
  layer = null;

  view = null;
  lbl_txt = null;

  constructor(layer) {
    this.layer = layer;

    this.view = ::loadSKView("/ui/common/TutorialWindow.ui");
    this.lbl_txt = this.view.findChild("lbl_txt");

    local _left = (::screenWidth - ::viewWidth) / 2 + this.view.bnd.w / 2;
    local _right = (::screenWidth - ::viewWidth) / 2 + ::screenWidth - this.view.bnd.w / 2;
    local _top = (::screenHeight - ::viewHeight) / 2 + this.view.bnd.h / 2;
    local _bottom = (::screenHeight - ::viewHeight) / 2 - this.view.bnd.h / 2;
    local _center_x = ::screenWidth / 2;
    local _center_y = ::screenHeight / 2;

    this.pos_set = [];
    this.pos_set + { x = _left + 50, y = _top + 50 };
    this.pos_set + { x = _center_x, y = _top + 50 };
    this.pos_set + { x = _right - 50, y = _top + 50 };
    this.pos_set + { x = _left + 50, y = _center_y };
    this.pos_set + { x = _center_x, y = _center_y };
    this.pos_set + { x = _right - 50, y = _center_y };
    this.pos_set + { x = _left + 50, y = _bottom - 50 };
    this.pos_set + { x = _center_x, y = _bottom - 50 };
    this.pos_set + { x = _right - 50, y = _bottom - 50 };

    setPosSet(1);
  }

  function setPos(x, y) {
    this.view.pos.x = x;
    this.view.pos.y = y;
    this.view.matdirty = true;
    this.view.repaint();

    this.pos_type = -1;
  }

  function setPosSet(type) {
    this.pos_type = type;
    local _pos = this.pos_set[this.pos_type];
    this.view.pos.x = _pos.x;
    this.view.pos.y = _pos.y;
    this.view.matdirty = true;
    this.view.repaint();
  }

  function setText(txt) {
    this.lbl_txt.setText(txt);
  }

  function show(tap) {
    this.layer.addChild(this.view);
    if (tap) this.view.startMethod("show");
    else this.view.startMethod("show_notap");
  }

  function hide() {
    this.view.startMethod("hide");
    while (this.view.isMethodRunning()) {
      suspend();
    }
    this.view.removeFromParent();
  }

  function removeView() {
    this.view.removeFromParent();
  }
}