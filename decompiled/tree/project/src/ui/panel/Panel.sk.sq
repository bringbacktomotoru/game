class HomeUI.Panel extends SKView {
  static need_camera_default = false;
  static need_money_layer = true;
  static need_rank_layer = true;
  static need_hint_layer = false;
  static need_camera = false;
  static need_camera_rotate = false;
  static need_ui_onoff = false;
  static need_menu_layer = true;

  static need_back_layer = false;
  static need_history_clear = false;
  static need_param_history_noadd = false;
  static need_panel_name = true;
  static need_camera_record = false;
  static need_show_production_layer = false;
  static need_movear_button = false;
  static need_hapiness_info = false;
  static need_bonus_hapiness_info = false;
  static need_push_animation = true;

  static show_tapfloor_particle = false;
  static disable_long_tap = false;

  static show_play_ad_video = false;

  static unique_bgm = null;

  mouseevent_manager = null;

  is_dragged = null;

  enable_release_action = null;
  interval = null;
  drag_interval = null;

  static LONG_TAP_TIME = 500;
  static DOUBLE_TAP_TIME = 300;
  last_tap_time = null;

  dragged_dist = null;

  multi_tap_state = 0;
  static MULTI_TAP_NONE = 0;
  static MULTI_TAP_PINCH = 1;
  static MULTI_TAP_DRAG = 2;

  is_camerarotate = null;

  pressed_x = 0;
  pressed_y = 0;
  static UNABLE_DRAG_DIST = 10.0;

  is_animating = null;

  remaining_mouse_wheel_count = 0.0;
  v_1 = Vector3D();

  flick_check = FlickChecker();
  flick_enabled = true;

  function create() {
    return null;
  }

  function loadFinished() {}

  function added() {
    super.added();
    _toFullScreen();

    if (skGetOSName() == "Windows") {
      setUpdateFunc(updateAtWindows.bindenv(this));
    }
    last_tap_time = -1;
    dragged_dist = Vector3D();

  }

  function show() {
  }

  function showed() {

  }

  function getHomeUI() {
    return this.parent;
  }

  function checkBackable() {
    return true;
  }

  function isAnimating() {

    return is_animating;
  }

  function _toFullScreen() {
    setRect(0.0, 0.0, this.parent.bnd.w, this.parent.bnd.h);
    toCenter(0.5, 0.5);
  }

  function toCenter(ax = 0.5, ay = 0.5) {

    centerize(ax, ay);
    this.pos.x = this.parent.bnd.w * ax;
    this.pos.y = this.parent.bnd.h * ay;
    this.matdirty = true;
    repaint();
  }

  function setPanelParam(param) {
  }

  function addTalkWindow(sk3d, talk_key, chara_key, big = false, small = false) {
  }
  function addTalkWindowForce(sk3d, talk_key, chara_key, big = false, small = false) {
  }
  function removeAllTalkWindow() {
  }
  function removeTalkQueue(sk3d) {
  }

  function updateAtWindows(dt) {
    local delta = this.remaining_mouse_wheel_count * 0.01 * dt;
    this.remaining_mouse_wheel_count -= delta;
    if (delta > -0.01 && delta < 0.01) return;

    local rate = 1.0 - delta * 0.05;
    local game_scene = ::gamesession.getCurrentScene();
    game_scene.zoomCamera(Math.clamp(rate, 0.0, 2.0), true);
  }

  function pushed() {
    local target_pos = Vector3D().set(this.pos);
    this.pos.set(this.pos.x, this.pos.y + this.bnd.h, this.pos.z);

    startMethod(_showanime.bindenv({
      self = this,
      time_limit = 200,
      timer = 0,
      target_pos = target_pos,
      animebody = _animebody,
    }));
  }

  function popped() {
    local target_pos = Vector3D().set(this.pos.x, this.pos.y + this.bnd.h, this.pos.z);

    startMethod(_hideanime.bindenv({
      self = this,
      time_limit = 200,
      timer = 0,
      target_pos = target_pos,
      animebody = _animebody,
    }));
  }

  function _showanime(cmd = null) {
    local delt = 16;
    self.is_animating = true;
    for (local i = 0; i < time_limit; i += delt) {
      timer += delt;
      animebody(this, delt);
      sleep(delt);
    }
    self.is_animating = false;
  }

  function _hideanime(cmd = null) {
    local delt = 16;
    self.is_animating = true;
    for (local i = 0; i < time_limit; i += delt) {
      timer += delt;
      animebody(this, delt);
      sleep(delt);
    }
    self.is_animating = false;
  }

  function _animebody(param, dt) {
    local posy = timer >= time_limit ? target_pos.y : self.pos.y + (target_pos.y - self.pos.y) / (time_limit - timer) * dt;
    posy = target_pos.y > 0 ? Math.max(target_pos.y, posy) : Math.min(target_pos.y, posy);

    self.pos.y = posy;
    self.matdirty = true;
    self.repaint();
  }

  function backTapped() {
    local home_ui = this.parent;
    home_ui.backPanel();
  }

  function registerMouseEventReceiver(sender) {
    this.mouseevent_manager = this.parent.mouseevent_manager;
    this.mouseevent_manager.refreshAll();

    sender.multitouch = true;
    sender.addEventListener(MOUSE_EVENT, this.mouseevent_manager.mouseevent, this.mouseevent_manager);
    sender.addEventListener(MOUSE_EVENT, this.mouseevent_panel, this);
  }

  function removeMouseEventReceiver(sender) {
    this.mouseevent_manager.refreshAll();
    sender.removeEventListener(MOUSE_EVENT, this.mouseevent_manager.mouseevent);
    sender.removeEventListener(MOUSE_EVENT, this.mouseevent_panel);
  }

  function _isMultiTapped() {
    return this.mouseevent_manager.isMultiTapped()
  }

  function mouseevent_panel(e) {

    local last_event = this.mouseevent_manager.getLastEvent();

    if (!last_event) return;

    local game_scene = ::gamesession.getCurrentScene();

    if (_isMultiTapped()) {

      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
        _killLongTapEffect();
      }
      if (this.drag_interval) {
        clearInterval(this.drag_interval);
        this.drag_interval = null;
      }

      local _pinch_rate = this.mouseevent_manager.getPinchRate();
      if (this.mouseevent_manager.isPinched() && Math.abs(1 - _pinch_rate) > 0.02) {
        local rate = 2.0 - _pinch_rate;

        rate = 1.0 + (rate - 1.0) * 0.33;
        mousePinched(rate);
      }
      multi_tap_state = MULTI_TAP_PINCH;

      this.enable_release_action = false;

      return;
    } else {

    }
    switch (last_event.id) {
    case MOUSE_PRESSED:
      mousePressed(last_event);
      this.flick_check.pressed(e);
      break;
    case MOUSE_DRAGGED:

      this.v_1.set(last_event.x, last_event.y, 0).sub(this.pressed_x, this.pressed_y, 0);
      if (this.v_1.length() < UNABLE_DRAG_DIST) return;

      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
        _killLongTapEffect();
      }
      local dragVec = this.mouseevent_manager.getDragVec();
      mouseDragged(dragVec.x, dragVec.y);
      this.dragged_dist.set(dragVec.x, dragVec.y, 0);
      this.is_dragged = this.mouseevent_manager.isDraggedLastKeeper();
      this.flick_check.dragged(e);
      break;
    case MOUSE_RELEASED:
      local _flick_ret = this.flick_check.released(e);
      if (flick_enabled && _flick_ret == FlickChecker.FLICK_LEFT) {
        flickLeft();
      }
      else if (flick_enabled && _flick_ret == FlickChecker.FLICK_RIGHT) {
        flickRight();
      }

      if (this.interval) {
        clearInterval(this.interval);
        this.interval = null;
        _killLongTapEffect();
      }
      if (this.drag_interval) {
        clearInterval(this.drag_interval);
        this.drag_interval = null;
      }

      this.is_camerarotate = false;
      this.dragged_dist.set(0, 0, 0);

      if (is_dragged || !this.enable_release_action) {
        this.is_dragged = false;
        if (!multi_tap_state == MULTI_TAP_NONE) this.enable_release_action = true;
        return;
      }

      mouseReleased(last_event.x, last_event.y);

      break;
    case MOUSE_WHEEL_MOVED:
      this.remaining_mouse_wheel_count += e.count;
      break;
    }

    multi_tap_state = MULTI_TAP_NONE;
  }

  function _callLongTapEvent() {
    clearInterval(this.interval);
    this.interval = null;
    this.enable_release_action = false;

    _killLongTapEffect(1000);

    local last_event = this.mouseevent_manager.getLastEvent();
    if (!last_event) return;
    longTapped(last_event.x, last_event.y);
  }

  function mousePressed(event) {

    if (this.interval) {
      clearInterval(this.interval);
      this.interval = null;
      ::gamesession.getTapViewLayer().killLongTapEffect();
    }
    if (this.drag_interval) {
      clearInterval(this.drag_interval);
      this.drag_interval = null;
    }

    if (multi_tap_state != MULTI_TAP_NONE) return;
    local tap_layer = ::gamesession.getTapViewLayer();
    this.enable_release_action = true;
    this.pressed_x = event.x;
    this.pressed_y = event.y;

    if (!disable_long_tap) {
      if (_checkEnableLongTap(event)) {
        this.interval = setTimeout(_callLongTapEvent.bindenv(this), LONG_TAP_TIME);
        tap_layer.addLongTapEffect(this.pressed_x, this.pressed_y);
      }
    }

    this.dragged_dist.set(0, 0, 0);

  }

  function _checkEnableLongTap(event) {
    local _ud = ::gamesession.getUserData();
    local _rule = ::gamesetting.game_rule;
    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof SanrioGameScene)) return false;

    local _model = _scene.getStage().getTappedModel_atScreenPos(event.x, event.y);
    local _condition = _ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_ROOM_EDIT_SC) || ::TutorialSetting.TUTORIAL_LIMIT_ROOM_EDIT_SC < 0 || _rule.disableTutorial();
    if (!_condition) return false;

    if (_model instanceof ::FurnitureModel) {
      return true;

    }

    return false;
  }

  function mouseReleased(x, y) {
    local scene = ::gamesession.getCurrentScene();
    if (!(scene instanceof SanrioGameScene)) return;

    local home_ui = scene.getUI();
    home_ui.showSlideMenu(false);

    local stage = scene.getStage();
    if (show_tapfloor_particle) {
      local _model = stage.getTappedModel_atScreenPos(x, y);
      local _b = _model instanceof FurnitureModel && _model.isOverlaidModel();
      if (!_model || _b) {
        local _cp = scene.getUI().getCurrentPanel();
        if (_cp instanceof HomeTopPanel && !_cp.getMouseEventLock()) {
          local ret = stage.addTapFloorEffect(x, y);
          if (ret) ::gamesession.getTapViewLayer().killTapEffect();
        }
      }
    }
  }
  function mouseDragged(vec_x, vec_y) {
    if (skGetOSName() == "Windows") {
      if (this.is_camerarotate) {
        local _scene = ::gamesession.getCurrentScene();
        if (_scene instanceof SanrioGameScene) _scene.getStage().rotateCamera_byScreenDist(vec_x, vec_y);
        local last_event = this.mouseevent_manager.getLastEvent();

      }
    }
  }
  function mousePinched(rate) {
  }
  function mouseMultiDragged(vec_x, vec_y) {
    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof SanrioGameScene)) return;
    _scene.getStage().rotateCamera_byScreenDist(-vec_x, -vec_y);
  }
  function longTapped(x, y) {
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof SanrioGameScene) {
      local stage = _scene.getStage();
      local model = stage.getTappedModel_atScreenPos(x, y);
      if (!model) {
        if (skGetOSName() == "Windows") {
          this.is_camerarotate = true;
          if (this.drag_interval) clearInterval(this.drag_interval);
          this.drag_interval = setInterval(_rotateCameraDragDist.bindenv(this), 16);
        }
      }
    }
  }
  function doubleTapped() {
  }

  function _draggedRotateCamera(drag_angle) {
    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof SanrioGameScene)) return;

    local stage = _scene.getStage();

    local _h = 0;
    local _p = 0;

    local _abs = Math.abs(drag_angle);

    if (_abs < 20) {
      _p = 20;
    } else if (160 < _abs) {
      _p = -20;
    } else if (0 < drag_angle) {
      _h = 45;
    } else if (drag_angle < 0) {
      _h = -45;
    }

    stage.rotateCameraMove(_h, _p, 0);
  }

  function _killLongTapEffect(dt = 0) {
    ::gamesession.getTapViewLayer().killLongTapEffect(dt);
  }

  function _rotateCameraDragDist(dt) {

  }

  function flickRight() {
    println("flick Right");
  }

  function flickLeft() {
    println("flick Left");
  }

}