class RoomMemberPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;
  static need_hint_layer = false;
  static need_history_clear = true;
  static need_panel_name = true;

  static CARD_SPACE_X = 20;

  view = null;

  pnl_item_list = null;
  reclist = null;
  scroll = null;
  scroll_bar = null;

  btn_back = null;

  current_cos_ids = null;

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/ItemListPanelWide.ui");
    addChild(this.view);

    this.pnl_item_list = this.view.findChild("pnl_item_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.pnl_item_list.addChild(this.reclist);
    this.pnl_item_list.setBuffer(true);

    this.current_cos_ids = [];

    this.scroll_bar = ::ScrollBarH(this.view.findChild("pnl_scroll_bar"));

    this.btn_back = this.view.findChild("btn_back");
    ::TapButton(this.btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    this.view.findChild("btn_restore").visible = false;

    this.view.findChild("pnl_sale").visible = false;

    _setupMemberList();

    this.view.startMethod("init");
  }

  function show() {
    this.view.startMethod("show");
  }

  function _setupMemberList() {

    this.reclist.clearChildren();
    local _ud = ::gamesession.getUserData();
    local _red = _ud.getCurrentRoomEditData();
    if (!_red) return;
    local _rs = ::gamesetting.room_settings[_red.getRoomID()];
    if (!_rs) return;

    local _room_chara_ids = _rs.getCharaIDs();
    if (!_room_chara_ids || _room_chara_ids.len() == 0) return;

    local _reside_costume_ids = _ud.getCurrentRoomResideCharas();
    if (!_reside_costume_ids) _reside_costume_ids = [];

    local _reside_charas = {};
    local _costume_settings = ::gamesetting.costume_settings;
    foreach (cos_id in _reside_costume_ids) {
      local _setting = _costume_settings[cos_id];
      if (!_setting) continue;
      _reside_charas[_setting.getCharaID()] <- cos_id;
    }

    local _offset = 10;
    local _chara_settings = ::gamesetting.sanrio_chara_settings;
    foreach (idx, chara_id in _room_chara_ids) {
      local _cos_id;
      local _exist;
      if (_reside_charas[chara_id]) {

        _cos_id = _reside_charas[chara_id];
        _exist = true;
        this.current_cos_ids + _cos_id;
      }
      else {

        _cos_id = _chara_settings[chara_id].getDefaultCostumeID();
        _exist = false;
      }

      local _card = CharaCard(this);
      if (!_card.setup(_cos_id, _exist, _rs.getReleaseCharaConditionText(idx), idx)) continue;
      _card.pos.x = _offset;
      this.reclist.addChild(_card);

      _offset += _card.bnd.w + CARD_SPACE_X;
    }

    _offset += 100;
    this.reclist.setRect(0, 0, _offset, this.pnl_item_list.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);
    this.scroll_bar.setup(this.scroll, this.pnl_item_list.bnd, true);
  }

  function moveSelectPanel(index) {
    getHomeUI().movePanel(::CharaProfilePanel, false,
    { "index" = index, "costume_ids" = this.current_cos_ids });
  }

  function actionevent_back(e) {
    getHomeUI().backPanel();
  }
}

class RoomMemberPanel.CharaCard extends SKView {
  view = null;
  pnl_parent = null;

  img_cos_icon = null;
  img_chara_icon = null;
  lbl_chara_name = null;

  pnl_lock = null;
  img_lock = null;
  lbl_condition = null;

  list_index = -1;
  costume_id = -1;

  constructor(p) {
    this.pnl_parent = p;

    this.view = ::loadSKView("/ui/common/RoomCharaCard.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    this.img_cos_icon = this.findChild("img_cos_icon");

    local _btn_chara = this.findChild("btn_chara");
    ::TapButton(_btn_chara).view.addEventListener(ACTION_EVENT, actionevent_select);
    this.img_chara_icon = _btn_chara.findChild("img_chara_icon");
    this.lbl_chara_name = _btn_chara.findChild("lbl_chara_name");

    this.pnl_lock = this.view.findChild("pnl_lock");
    this.img_lock = this.pnl_lock.findChild("img_lock");
    this.lbl_condition = this.pnl_lock.findChild("lbl_condition");
  }

  function setup(cos_id, exist, _condtion_text, idx) {
    this.costume_id = cos_id;
    this.list_index = idx;

    local _cos_setting = ::gamesetting.costume_settings[cos_id];
    if (!_cos_setting) return false;
    local _chara_setting = ::gamesetting.sanrio_chara_settings[_cos_setting.getCharaID()];
    if (!_chara_setting) return false;

    this.img_cos_icon.setSprite(_cos_setting.getSpriteCostumeIcon());
    this.img_cos_icon.updateLayout();

    this.img_chara_icon.setSprite(_chara_setting.getIconSprite());
    this.img_chara_icon.updateLayout();

    this.lbl_chara_name.setText(_chara_setting.getName());

    if (exist) {
      this.pnl_lock.visible = false;
    }
    else {
      this.pnl_lock.visible = true;

      this.img_lock.setSprite(_chara_setting.getLockIconSprite());
      this.img_lock.updateLayout();

      this.lbl_condition.setText(_condtion_text);
    }

    return true;
  }

  function actionevent_select(e) {
    e.consume();
    this.pnl_parent.moveSelectPanel(this.list_index);
  }
}