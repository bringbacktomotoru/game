class RoomSlotPanel extends ::HomeUI.Panel {
  static SLOT_HEIGHT = 555;
  static SLOT_WIDHT = 512;
  static SLOT_SPACE = 0;

  unlocked_slots = null;
  locked_slots = null;

  scroll_panel = null;
  reclist = null;
  scroll_bar = null;

  constructor() {
    this.unlocked_slots = [];
    this.locked_slots = [];

    this.reclist = SKMaskView();
    this.reclist.bnd.w = SLOT_WIDHT;
    this.scroll_panel = ScrollPanel(reclist, true);
    this.scroll_panel.dyscale = 0.0;
    this.scroll_panel.block = [SLOT_WIDHT + SLOT_SPACE, SLOT_HEIGHT];
  }

  function create() {
    return ::loadSKView("/ui/RoomSlotPanel.ui", ::RoomSlotPanel);
  }

  function loadFinished() {
    local ud = ::gamesession.getUserData();
    ud.updateRoomSlot();
    ::gamesession.getCurrentScene().getStage().getHouseManager().extendRooms();

    ::TapButton(findChild("btn_back")).view.addEventListener(ACTION_EVENT, actionevent_back);

    local pnl_list = findChild("pnl_list");
    pnl_list.setBuffer(true);
    pnl_list.addChild(this.reclist);

    this.scroll_bar = ::ScrollBarH(findChild("pnl_scroll_bar"));
    scroll_bar.setup(this.scroll_panel, pnl_list.bnd, true);

    buildItems();
    updatePosition();
  }

  function added() {
    setupSlotScenes();
  }

  function removed() {
    super.removed();

  }

  function popped() {
    super.popped();

    local ud = ::gamesession.getUserData();
    local game_scene = getHomeUI().getGameScene();
    game_scene.selectRoom(ud.getCurrentRoomIndex(), true);

  }

  function buildItems() {
    this.unlocked_slots.clear();
    this.locked_slots.clear();

    local ud = ::gamesession.getUserData();
    foreach (idx, slot_data in ud.getRooms()) {
      local slot = Slot.create();
      slot.setupUnlocked(idx);
      this.unlocked_slots + slot;
    }
    foreach (id in ud.getLockedRoomSlotSettingIds()) {
      local slot = Slot.create();
      slot.setupLocked(id);
      this.locked_slots + slot;
    }
  }

  function updatePosition() {
    this.reclist.clearChildren();

    local pos_x = 0;
    local reclist = this.reclist;
    foreach (slot in this.unlocked_slots) {
      slot.pos.x = pos_x;
      reclist.addChild(slot);

      pos_x += SLOT_WIDHT + SLOT_SPACE;
    }

    foreach (slot in this.locked_slots) {
      slot.pos.x = pos_x;
      reclist.addChild(slot);

      pos_x += SLOT_WIDHT + SLOT_SPACE;
    }

    reclist.setRect(0, 0, pos_x - SLOT_SPACE, SLOT_HEIGHT);
    reclist.repaint();
    this.scroll_panel.setScrollRect(reclist.bnd);
    this.scroll_bar.update();
  }

  function setupSlotScenes() {
    local thread = newthread();
    thread.start(_setupSlotSceneProcess, this);
  }
  function _setupSlotSceneProcess() {
    foreach (slot in this.unlocked_slots) {
      if (slot.is_empty_slot) continue;
      slot.setupRoomScene();
      suspend();
    }
  }

  function unlockSlot(setting_id, room_uid) {

  }

  function actionevent_back(e) {
    e.consume();

    local home_ui = getHomeUI();
    home_ui.backTapped();
  }
}

class RoomSlotPanel.Slot extends SKView {
  idx = -1;
  tap_func = null;

  is_empty_slot = true;

  room_detail_dialog = null;
  scene_load_thread = null;

  pnl_frame = null;
  pnl_room = null;
  pnl_room_index = null;
  btn_detail = null;
  img_room_plus = null;
  pnl_room_lock = null;
  pnl_seriesicon = null;
  pnl_charaicon = null;
  pnl_furnitureicon = null;

  lbl_size = null;
  lbl_name = null;
  lbl_maxcharas = null;
  lbl_maxfurnitures = null;
  lbl_maxcharanum = null;
  lbl_maxfurniturenum = null;
  lbl_canadd = null;
  lbl_condition = null;
  img_charaicon = null;
  img_furnitureicon = null;

  btn_roomslot = null;

  constructor() {}

  function create() {
    return ::loadSKView("/ui/common/RoomSlotItem_2.ui", ::RoomSlotPanel.Slot);
  }

  function loadFinished() {

    btn_roomslot = findChild("btn_roomslot");
    TapButton(btn_roomslot, false).view.addEventListener(ACTION_EVENT, actionevent_unlockedslot);

    this.pnl_frame = this.btn_roomslot.findChild("pnl_frame");
    this.pnl_room = this.btn_roomslot.findChild("pnl_room");
    this.pnl_room_index = this.btn_roomslot.findChild("pnl_room_index");
    this.btn_detail = ::TapButton(this.btn_roomslot.findChild("btn_detail")).view;
    this.btn_detail.addEventListener(ACTION_EVENT, actionevent_detail);
    this.img_room_plus = this.btn_roomslot.findChild("img_room_plus");
    this.pnl_room_lock = this.btn_roomslot.findChild("pnl_room_lock");
    this.pnl_seriesicon = this.btn_roomslot.findChild("pnl_seriesicon");
    this.pnl_charaicon = this.btn_roomslot.findChild("pnl_charaicon");
    this.pnl_furnitureicon = this.btn_roomslot.findChild("pnl_furnitureicon");

    this.lbl_size = this.btn_roomslot.findChild("lbl_size");
    this.lbl_name = this.btn_roomslot.findChild("lbl_name");
    this.lbl_maxcharas = this.btn_roomslot.findChild("lbl_maxcharas");
    this.lbl_maxfurnitures = this.btn_roomslot.findChild("lbl_maxfurniture");
    this.lbl_maxcharanum = this.btn_roomslot.findChild("lbl_maxcharanum");
    this.lbl_maxfurniturenum = this.btn_roomslot.findChild("lbl_maxfurniturenum");
    this.lbl_canadd = this.btn_roomslot.findChild("lbl_canadd");
    this.lbl_canadd.setText(::dict.get("room_slot_canadd"));
    this.lbl_condition = this.btn_roomslot.findChild("lbl_condition");

    this.lbl_maxfurnitures.visible = false;
    this.lbl_maxfurniturenum.visible = false;
    this.pnl_furnitureicon.visible = false;

    local _sp = ::gamesetting.sanrio_chara_settings[1].getIconSprite();
    _sp.bnd.set(0, 0, pnl_charaicon.bnd.w, pnl_charaicon.bnd.h);
    this.img_charaicon = ::SKImageView(_sp);
    this.pnl_charaicon.addChild(img_charaicon);

    _sp = ::gamesetting.title_settings[10].getIconSprite();
    _sp.bnd.set(0, 0, pnl_furnitureicon.bnd.w, pnl_furnitureicon.bnd.h);
    this.img_furnitureicon = ::SKImageView(_sp);
    this.pnl_furnitureicon.addChild(img_furnitureicon);

    this.lbl_maxcharas.setText(::dict.get("roomslot_maxcharas"));
    this.lbl_maxfurnitures.setText(::dict.get("roomslot_maxfurnitures"));

  }

  function setupUnlocked(slot_idx) {
    this.idx = slot_idx;

    this.pnl_frame.clearChildren();
    this.pnl_room_index.clearChildren();
    this.lbl_condition.visible = false;

    this.pnl_frame.setVisible(true);
    local frame_sp = ::Setting.getRoomFrameSprite(this.idx + 1);
    frame_sp.blend = SK_MIX;
    local _sca = 0.83587;
    frame_sp.bnd.set(0, 0, frame_sp.bnd.w * _sca, frame_sp.bnd.h * _sca);

    this.pnl_frame.addChild(::SKImageView(frame_sp));
    local icon_sp = ::Setting.getRoomIconSprite(this.idx + 1);
    icon_sp.blend = SK_MIX;
    local _sca = this.pnl_room_index.bnd.h / icon_sp.bnd.h;

    icon_sp.bnd.set(0, 0, icon_sp.bnd.w * _sca, icon_sp.bnd.h * _sca);
    this.pnl_room_index.addChild(::SKImageView(icon_sp));

    local ud = ::gamesession.getUserData();
    local room_uid = ud.getRoomSlotData(this.idx).getRoomUID();
    if (room_uid == -1) {

      this.is_empty_slot = true;

      this.btn_detail.setVisible(false);

      this.img_room_plus.setVisible(true);
      this.pnl_room_lock.setVisible(false);

      _hideRoomInfo();
      this.lbl_canadd.setVisible(true);
      this.tap_func = _unlockedSlotTapFunc;
    }
    else {
      local _edit_data = ud.getRoomEditDataBySlotIdx(this.idx);
      local _setting = ::gamesetting.room_settings[_edit_data.getRoomID()];

      local _sp = _setting.getSeriesSetting().getIconSprite();
      this.pnl_seriesicon.addChild(::SKImageView(_sp));

      this.is_empty_slot = false;

      local room_level = _edit_data.getLevel();
      this.btn_detail.setVisible(true);

      this.img_room_plus.setVisible(false);
      this.pnl_room_lock.setVisible(false);

      this.lbl_size.setText(_setting.getSizeText());
      this.lbl_name.setText(_setting.getName());

      local _param = _setting.getMaxParameters();

      this.lbl_maxcharanum.setText(::dict.get("nums_chara", [_param.chara]));
      this.lbl_maxfurniturenum.setText(::dict.get("nums_amount", [_param.furniture]));

      this.lbl_canadd.setVisible(false);
      this.tap_func = _useSlotTapFunc;
    }
  }

  function _hideRoomInfo() {
    this.pnl_seriesicon.setVisible(false);

    this.img_furnitureicon.setColor(0xffffff44);
    this.img_charaicon.setColor(0xffffff44);

    local _color = lbl_maxfurnitures.fontattr.color;
    this.lbl_maxcharas.setColor(_color & 0xffffff00 + 68);
    _color = lbl_maxfurnitures.fontattr.color;
    this.lbl_maxfurnitures.setColor(_color & 0xffffff00 + 68);

    this.lbl_size.setVisible(false);

    this.lbl_name.setText(::dict.get("roomslot_defaultname"));
    _color = lbl_name.fontattr.color;
    this.lbl_name.setColor(_color & 0xffffff00 + 68);

    this.lbl_maxcharanum.setText(::dict.get("roomslot_defaultnum"));
    _color = lbl_maxcharanum.fontattr.color;
    this.lbl_maxcharanum.setColor(_color & 0xffffff00 + 68);

    this.lbl_maxfurniturenum.setText(::dict.get("roomslot_defaultnum"));
    _color = lbl_maxfurniturenum.fontattr.color;
    this.lbl_maxfurniturenum.setColor(_color & 0xffffff00 + 68);
  }

  function setupLocked(setting_id) {
    this.idx = setting_id;
    this.is_empty_slot = true;

    this.pnl_frame.setVisible(false);

    this.btn_detail.setVisible(false);

    this.img_room_plus.setVisible(false);
    this.pnl_room_lock.setVisible(true);

    local _rs = ::gamesetting.room_slot_settings[setting_id];
    this.lbl_condition.setText(_rs.getUnlockText());
    this.lbl_condition.visible = true;

    this.setEnabled(false);
    this.tap_func = _lockedSlotTapFunc;

    _hideRoomInfo();
    this.lbl_canadd.setVisible(false);
  }

  function setupRoomScene() {
    this.pnl_room.clearChildren();

    this.scene_load_thread = newthread();
    this.scene_load_thread.start(_setupRoomSceneProcess, this, _setupRoomSceneFinished);

  }

  function _setupRoomSceneProcess(callback_func = null) {
    local game_scene = ::gamesession.getCurrentScene();
    local stage_id = game_scene.getStageID();
    local stage = ::StageScene();
    this.pnl_room.addChild(stage.view);
    stage.viewAdded();

    stage.setNextStageID(stage_id);
    stage.loadStageScene(false);
    stage.startStageScene();
    stage.showStageScene();

    local ud = ::gamesession.getUserData();
    local room_uid = ud.getRoomSlotData(this.idx).getRoomUID();
    stage.changeCurrentRoom(room_uid, true);
    stage.setViewRect(0, 0, this.pnl_room.bnd.w, this.pnl_room.bnd.h);
    stage.updateScene(0);

    if (callback_func) callback_func();
  }
  function _setupRoomSceneFinished() {
    stopThread();
  }
  function stopThread() {
    if (!scene_load_thread) return;

    this.scene_load_thread = null;
  }

  function tapped() {
    if (!this.tap_func) return;

    this.tap_func();
  }

  function getRoomSlotPanel() {
    return this.parent.parent.parent;
  }

  function _useSlotTapFunc() {
    _unlockedSlotTapFunc(true);
  }
  function _unlockedSlotTapFunc(confirm = false) {
    local home_ui = getRoomSlotPanel().getHomeUI();
    local game_scene = home_ui.getGameScene();
    if (!game_scene.canChangeRoom(this.idx)) {
      local dlg = SimpleDialog();
      dlg.lbl_msg.setText(::dict.get("alart_cannot_change_room"));
      dlg.show();
      return;
    }

    if (confirm) {
      local dlg = SimpleDialog2();
      dlg.lbl_msg.setText(::dict.get("room_slot_change_confirm"));
      dlg.lbl_caution.setText(::dict.get("room_slot_change_caution"));
      dlg.show();
      if (!dlg.ret) return;
    }
    home_ui.movePanel(::RoomListPanel, false, { slot_idx = this.idx });

  }

  function _lockedSlotTapFunc() {

  }

  function actionevent_unlockedslot(e) {
    e.consume();
    local room_uid = ::gamesession.getUserData().getRoomSlotData(this.idx).getRoomUID();
    _unlockedSlotTapFunc(room_uid != -1);
  }

  function actionevent_detail(e) {
    e.consume();

    if (!this.room_detail_dialog) {
      this.room_detail_dialog = ::RoomDetailDialog(::loadSKView("/ui/dialog/RoomChangeDetailDialog.ui"));
    }
    local ud = ::gamesession.getUserData();
    this.room_detail_dialog.setRoomSetting(ud.getRoomEditDataBySlotIdx(this.idx), ::RoomDetailDialog.MODE_CHANGE);
    this.room_detail_dialog.show();
  }
}