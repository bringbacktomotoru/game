class RoomListPanel extends ::HomeUI.Panel {
  static need_money_layer = false;

  static COLUMN_NUM = 2;
  static ITEM_SPACE_X = 20;
  static ITEM_SPACE_Y = 0;

  edit_slot_idx = -1;
  items = null;

  scroll_panel = null;
  reclist = null;
  scroll_bar = null;

  pnl_item_list = null;

  constructor() {
    this.items = [];

    this.reclist = SKMaskView();
    this.scroll_panel = ScrollPanel(reclist, true);
    this.scroll_panel.dyscale = 0.0;
  }

  function create() {
    return ::loadSKView("/ui/RoomListPanel.ui", ::RoomListPanel);
  }
  function loadFinished() {
    this.pnl_item_list = findChild("pnl_item_list");
    this.pnl_item_list.setBuffer(true);
    pnl_item_list.addChild(this.reclist);

    this.scroll_bar = ::ScrollBarH(findChild("pnl_scroll_bar"));
    this.scroll_bar.setup(this.scroll_panel, this.pnl_item_list.bnd, true);

    ::TapButton(findChild("btn_back")).view.addEventListener(ACTION_EVENT, actionevent_back);
    ::TapButton(findChild("btn_sort")).view.addEventListener(ACTION_EVENT, actionevent_sort);
    ::TapButton(findChild("btn_performance")).view.addEventListener(ACTION_EVENT, actionevent_performance);

    findChild("btn_sort").visible = false;;

    local list_height = this.pnl_item_list.bnd.h;
    this.scroll_panel.block = [294 + ITEM_SPACE_Y, list_height];
    buildItems();
    updatePosition();
  }

  function buildItems() {
    local ud = ::gamesession.getUserData();
    local _new_items = ::gamesession.getUserDataLocal().getNewItem(ITEM_TYPE_ROOM);
    if (!_new_items) _new_items = [];
    foreach (uid, edit_data in ud.getRoomEditDataTable()) {
      local item = Item.create();
      item.setup(edit_data, _new_items.indexOf(uid) >= 0);
      this.items + item;
    }
  }

  function updatePosition() {
    this.reclist.clearChildren();

    local pos_x = 0.0;
    local pos_y = 0.0;
    local has_val = false;
    local item_bnd_w = 0.0;
    local item_bnd_h = 0.0;
    local reclist = this.reclist;
    foreach (idx, item in this.items) {
      if (!has_val) {
        item_bnd_w = item.bnd.w;
        item_bnd_h = item.bnd.h;
        has_val = true;
      }

      item.pos.x = pos_x;
      item.pos.y = pos_y;
      if (idx % COLUMN_NUM) item.hideUnderline();
      reclist.addChild(item);

      if ((idx + 1) % COLUMN_NUM == 0) {

        pos_y = 0;
        pos_x += item_bnd_w + ITEM_SPACE_X;
      }
      else {

        pos_y += item_bnd_h + ITEM_SPACE_Y;
      }
    }

    reclist.setRect(0, 0, pos_x + (length(this.items) % COLUMN_NUM == 0 ? 0 : item_bnd_w), pnl_item_list.bnd.h);
    reclist.repaint();
    this.scroll_panel.setScrollRect(reclist.bnd);
    this.scroll_bar.update();
  }

  function itemSelected(room_uid) {
    local gamesession = ::gamesession;

    local res = gamesession.editRoomSlot(this.edit_slot_idx, room_uid);
    if (res.ret != ::ServletConstants.RESPONSE_SUCCEED) {
      return;
    }

    local ud = gamesession.getUserData();
    ud.removeRoomFurnitures(this.edit_slot_idx);
    ud.setRoom(this.edit_slot_idx, room_uid);
  }

  function setPanelParam(param) {
    this.edit_slot_idx = param.slot_idx;
  }

  function actionevent_back(e) {
    e.consume();

    getHomeUI().backTapped();
  }
  function actionevent_sort(e) {
    e.consume();
  }
  function actionevent_performance(e) {
    e.consume();
  }
}

class RoomListPanel.Item extends SKView {
  room_uid = -1;
  is_using = false;

  room_detail_dialog = null;

  btn_room = null;
  pnl_view = null;
  pnl_lv = null;

  pnl_using = null;
  lbl_using = null;
  pnl_room_index = null;

  lbl_charanum = null;
  lbl_furniturenum = null;
  pnl_charaicon = null;
  pnl_furnitureicon = null;

  img_underline = null;

  is_new = false;
  img_new = null;

  function create() {
    return ::loadSKView("/ui/common/RoomListItem.ui", ::RoomListPanel.Item);
  }
  function loadFinished() {

    this.btn_room = findChild("btn_room");
    ::TapButton(this.btn_room, false).view.addEventListener(ACTION_EVENT, _actionevent_tapped);

    this.pnl_view = this.btn_room.findChild("pnl_view");

    this.pnl_lv = this.btn_room.findChild("pnl_lv");
    this.pnl_lv.setVisible(false);
    this.pnl_lv.setEnabled(false);

    this.pnl_using = this.btn_room.findChild("pnl_using");
    this.lbl_using = this.pnl_using.findChild("lbl_using");
    this.lbl_using.setText(::dict.get("roomlist_using"));
    this.pnl_room_index = this.pnl_using.findChild("pnl_room_index");

    this.lbl_charanum = this.btn_room.findChild("lbl_charanum");
    this.lbl_furniturenum = this.btn_room.findChild("lbl_furniturenum");
    this.pnl_charaicon = this.btn_room.findChild("pnl_charaicon");
    this.pnl_furnitureicon = this.btn_room.findChild("pnl_furnitureicon");

    local _sp = ::gamesetting.sanrio_chara_settings[1].getIconSprite();
    _sp.bnd.set(0, 0, pnl_charaicon.bnd.w, pnl_charaicon.bnd.h);
    this.pnl_charaicon.addChild(::SKImageView(_sp));

    _sp = ::gamesetting.title_settings[10].getIconSprite();
    _sp.bnd.set(0, 0, pnl_furnitureicon.bnd.w, pnl_furnitureicon.bnd.h);
    this.pnl_furnitureicon.addChild(::SKImageView(_sp));

    this.img_underline = this.findChild("img_underline");

    ::TapButton(this.btn_room.findChild("btn_detail")).view.addEventListener(ACTION_EVENT, actionevent_detail);

    this.img_new = this.btn_room.findChild("img_new");
  }

  function setup(edit_data, mark) {
    this.pnl_room_index.clearChildren();
    this.is_using = false;

    this.room_uid = edit_data.getUID();

    local ud = ::gamesession.getUserData();
    local room_idx = ud.getRoomSlotIndexByRoomUID(this.room_uid);
    if (room_idx != -1) {
      local sp = ::Setting.getRoomIconSprite(room_idx + 1);
      sp.blend = SK_MIX;
      local _sca = this.pnl_room_index.bnd.h / sp.bnd.h;
      sp.bnd.set(0, 0, sp.bnd.w * _sca, sp.bnd.h * _sca);
      this.pnl_room_index.addChild(::SKImageView(sp));

      this.is_using = true;

      this.pnl_using.setVisible(true);
    } else {
      this.pnl_using.setVisible(false);
    }

    local _rs = ::gamesetting.room_settings[edit_data.getRoomID()];
    local _sp = _rs.getIconSpriteUnacquired();
    local _icon = SKImageView(_sp);
    _icon.setColor(is_using ? 0xffffff44 : 0xffffffff);
    _icon.setRect(0, 0, this.pnl_view.bnd.w, this.pnl_view.bnd.h);
    this.pnl_view.addChild(_icon);

    local _param = _rs.getMaxParameters();
    this.lbl_charanum.setText(::dict.get("nums_chara", [_param.chara]));
    this.lbl_furniturenum.setText(::dict.get("nums_amount", [_param.furniture]));

    this.is_new = mark;
    this.img_new.visible = mark;
  }

  function setupRoomScene() {
    this.pnl_view.clearChildren();

    local game_scene = ::gamesession.getCurrentScene();
    local stage_id = game_scene.getStageID();

    local stage = ::StageScene();

    this.pnl_view.addChild(stage.view);
    stage.viewAdded();

    stage.setNextStageID(stage_id);
    stage.loadStageScene(false);
    stage.startStageScene();
    stage.showStageScene();

    stage.changeCurrentRoom(this.room_uid, true);
    stage.updateScene(0);
  }

  function getRoomListPanel() {
    return this.parent.parent.parent;
  }

  function hideUnderline() {
    this.img_underline.setVisible(false);
  }

  function actionevent_detail(e) {
    e.consume();

    if (this.is_new) {
      this.img_new.visible = false;
      this.is_new = false;
      repaint();
      ::gamesession.getUserDataLocal().deleteNewItem(ITEM_TYPE_ROOM, this.room_uid);
      ::gamesession.saveUserDataLocal();
      ::gamesession.getCurrentScene().getUI().updateMenuNewMark(::HomeUI.UPDATE_MENU_MARK_ROOM);
    }

    if (!this.room_detail_dialog) {
      this.room_detail_dialog = ::RoomDetailDialog(::loadSKView("/ui/dialog/RoomChangeDetailDialog.ui"));
    }
    local _ud = ::gamesession.getUserData();
    this.room_detail_dialog.setRoomSetting(_ud.getRoomEditData(this.room_uid), ::RoomDetailDialog.MODE_CHANGE);
    this.room_detail_dialog.show();
  }

  function _actionevent_tapped(e) {
    tapped();
  }

  function tapped() {

    if (this.is_new) {
      this.img_new.visible = false;
      this.is_new = false;
      repaint();
      ::gamesession.getUserDataLocal().deleteNewItem(ITEM_TYPE_ROOM, this.room_uid);
      ::gamesession.saveUserDataLocal();
      ::gamesession.getCurrentScene().getUI().updateMenuNewMark(::HomeUI.UPDATE_MENU_MARK_ROOM);
    }

    if (this.is_using) {
      local dlg = SimpleDialog();
      dlg.lbl_msg.setText(::dict.get("alart_using_room"));
      dlg.show();
      return;
    }

    local room_list_panel = getRoomListPanel();
    room_list_panel.itemSelected(this.room_uid);

    local home_ui = room_list_panel.getHomeUI();
    home_ui.backPanel();
  }

}