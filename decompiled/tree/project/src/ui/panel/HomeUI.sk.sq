class HomeUI extends SKView {

  panel_history = null;
  panel_param_history = null;
  current_panel = null;

  mouseevent_manager = null;
  production_layer = null;

  auto_scroll_panel = null;

  view = null;
  pnl_rank = null;
  pnl_player_info = null;
  pnl_bottom_menu = null;
  pnl_slidecloser = null;

  lbl_panelname = null;
  pnl_pageicon = null;

  lbl_gm = null;
  lbl_rm = null;
  btn_gm_buy = null;
  btn_rm_buy = null;
  btn_screen_shot = null;
  btn_screen_shot_camera = null;
  btn_screen_shot_video = null;

  btn_menu_chara = null;
  img_menu_new_mark = null;
  img_menu_newitem_mark = null;

  btn_slide = null;
  btn_back = null;
  pnl_capturing = null;
  pnl_eventstopper = null;
  pnl_mode = null;

  btn_ar = null;
  btn_focus = null;

  btn_debug = null;

  play_ad_video = null;

  slidemenu = null;

  scroll = null;
  reclist = null;
  pnl_slide = null;
  is_show_bottom_btn = -1;
  is_show_slide = false;
  is_capture = null;

  bonus_hapiness_info = null;
  hapiness_value_info = null;

  camera_stick = null;

  shop_check_manager = null;

  show_slide_menu_lock = false;
  show_slide_menu_reservation_lock = false;

  constructor() {
    super();

    setRect(0.0, 0.0, ::screenWidth, ::screenHeight, ::screenWidth / 2.0, ::screenHeight / 2.0);
    this.panel_history = [];
    this.panel_param_history = [];
    this.mouseevent_manager = ::MouseEventManager(2);

    this.shop_check_manager = ::ShopCheckManager(this);
  }

  function create() {
    return ::loadSKView("/ui/HomeUI_2.ui", ::HomeUI);
  }
  function loadFinished() {
    centerize();

    this.pnl_slidecloser = findChild("pnl_mouseevent");
    this.pnl_slidecloser.enabled = false;
    this.pnl_slidecloser.addEventListener(MOUSE_EVENT, mouseevent_slideclose);

    local _pnl_mode = findChild("pnl_mode");
    _pnl_mode.pickable = false;
    this.lbl_panelname = _pnl_mode.findChild("lbl_mode");
    this.pnl_pageicon = _pnl_mode.findChild("pnl_pageicon");

    this.pnl_rank = findChild("pnl_rank");

    this.pnl_player_info = findChild("pnl_topinfo");
    this.lbl_gm = this.pnl_player_info.findChild("lbl_gm");
    this.lbl_rm = this.pnl_player_info.findChild("lbl_rm");
    this.btn_gm_buy = this.pnl_player_info.findChild("btn_gm_buy");
    this.btn_gm_buy.visible = false;

    this.btn_rm_buy = this.pnl_player_info.findChild("btn_rm_buy");
    local _tap_button = ::TapButton(this.btn_rm_buy);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_buy_rm);
    this.btn_rm_buy.setEnabled(::tutorial_manager.isUnlockShopRM());

    this.btn_screen_shot = findChild("btn_capture");
    _tap_button = ::TapButton(this.btn_screen_shot);
    _tap_button.setTappedSE(SoundConstants.SOUND_CAMERA_SHUTTER);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_screen_shot);
    this.pnl_capturing = findChild("pnl_capturing");
    this.pnl_capturing.pickable = false;
    this.pnl_capturing.setVisible(false);
    this.is_capture = false;

    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(reclist);
    this.scroll.dxscale = 0.0;

    this.pnl_slide = findChild("pnl_bottom_slide").findChild("pnl_bottom_menu");
    this.pnl_slide.setBuffer(true);
    this.pnl_slide.addChild(this.reclist);

    this.slidemenu = SlideMenu(this);
    this.slidemenu.updateButton();
    this.reclist.addChild(this.slidemenu);
    this.reclist.setRect(0, 0, this.slidemenu.bnd.w, this.slidemenu.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd)

    local _pnl_bottom = findChild("pnl_bottom_slide");
    this.btn_slide = findChild("btn_slide");
    _tap_button = ::TapButton(this.btn_slide);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_slide);
    this.is_show_bottom_btn = -1;
    this.img_menu_new_mark = btn_slide.findChild("img_new");
    this.img_menu_newitem_mark = btn_slide.findChild("img_newitem");
    updateMenuNewMark();

    updateNewItemMark(this.shop_check_manager.checkShopMarkedAny());

    this.btn_back = findChild("btn_back");
    ::TapButton(this.btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    this.pnl_eventstopper = SKView();
    this.pnl_eventstopper.setRect(0, 0, this.bnd.w, this.bnd.h);
    pnl_eventstopper.setEnabled(false);
    pnl_eventstopper.pickable = false;
    this.addChild(pnl_eventstopper);

    local _ud = ::gamesession.getUserData();
    local _rule = ::gamesetting.game_rule;
    if (!_rule.disableTutorial()) {
      if (::TutorialSetting.TUTORIAL_LIMIT_SHOP_BUY >= 0) {
        this.slidemenu.shopLimit(_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_SHOP_BUY));
      }
      if (::TutorialSetting.TUTORIAL_LIMIT_PROPERTY >= 0) {
        this.slidemenu.propertyLimit(_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_PROPERTY));
      }

      if (::TutorialSetting.TUTORIAL_LIMIT_ROOM_EDIT >= 0) {
        this.slidemenu.layoutLimit(_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_ROOM_EDIT));
      }

      if (::TutorialSetting.TUTORIAL_LIMIT_EDIT_COSTUME >= 0) {
        this.slidemenu.teamLimit(_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_EDIT_COSTUME));
      }

      if (::TutorialSetting.TUTORIAL_LIMIT_DIARY >= 0) {
        this.slidemenu.diaryLimit(_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_DIARY));
      }

      if (::TutorialSetting.TUTORIAL_LIMIT_ROOM_SELECT >= 0) {
        this.slidemenu.roomLimt(_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_ROOM_SELECT));
      }
    }

    this.btn_ar = findChild("btn_ar");
    ::TapButton(this.btn_ar).view.addEventListener(ACTION_EVENT, actionevent_movear);

    this.bonus_hapiness_info = BonusHapinessInfo(findChild("pnl_bonus_hapiness"));

    this.hapiness_value_info = HapinessValueInfo(findChild("pnl_hapiness_info"));

    this.play_ad_video = ::PlayAdVideoButton(findChild("pnl_play_ad_video"));

    this.camera_stick = CameraRotateUI(findChild("pnl_camera_rotate"));

    this.pnl_mode = findChild("pnl_mode");
  }

  function updateScene(dt) {
    this.camera_stick.update(dt);
    this.bonus_hapiness_info.update(dt);
  }

  function added() {
    super.added();
    local _ud = ::gamesession.getUserData();
    if (::gamesetting.game_rule.disableTutorial()) {

      moveTopPanel();
    }
    else if (!_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_FIRST_LOGIN)) {

      movePanel(::OpeningMoviePanel, true);
    }
    else if (!_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LETTER_FIRST_MOVE)) {

      movePanel(::LetterPanel, false, { "setting" = ::gamesetting.letter_settings[::TutorialSetting.TUTORIAL_LETTER_FIRST_LOGIN] });
    }
    else {

      moveTopPanel();
    }

    this.camera_stick.setStage(parent.getStage());

    updateRankValue();
    updateGMValue(true);
    updateRMValue(true);
    this.shop_check_manager.setupShopCheckManager();
    local _room_idx = _ud.getCurrentRoomIndex();
    local _room_id = _ud.getRooms()[_room_idx].getRoomUID();
  }

  function removed() {
    super.removed();
    removeChild(this.pnl_eventstopper);
    removeChild(this.view);
    this.pnl_eventstopper = null;
    this.view = null;
  }

  function getGameScene() {
    return this.parent;
  }

  function getGameMoneyIconPos() {
    return this.player_info.img_gm.pos();
  }

  function getCurrentPanel() {
    return this.current_panel;
  }

  function getPageIcon() {
    return this.pnl_pageicon;
  }

  function getSlideMenu() {
    return this.slidemenu;
  }

  function getButtonSlide() {
    return this.btn_slide;
  }

  function getBackButton() {
    return this.btn_back;
  }
  function getButtonRMBuy() {
    return this.btn_rm_buy;
  }

  function getScreenShotButton() {
    return this.btn_screen_shot;
  }

  function getProductInfo() {
    return this.product_info;
  }

  function getSlideMenu() {
    return this.slidemenu;
  }

  function popHistory(popnum) {
    local history_num = length(this.panel_history);

    if (history_num < popnum) {
      this.panel_history.clear();
      this.panel_param_history.clear();
      return false;
    }

    this.panel_history.resize(history_num - popnum);
    this.panel_param_history.resize(history_num - popnum);
    return true;
  }

  function moveTopPanel(trans = null) {
    if (this.current_panel && !this.current_panel.checkBackable()) return;

    local game_scene = ::gamesession.getCurrentScene();
    game_scene.closeupChara(-1);

    movePanel(::HomeTopPanel, false, null, trans);
  }

  function backPanel(popnum = 1, is_clear_history = true) {
    if (this.current_panel && !this.current_panel.checkBackable()) return;

    popHistory(popnum);
    if (length(this.panel_history) > 0) {
      local clazz = this.panel_history.pop();
      local param = this.panel_param_history.pop();
      if (is_clear_history) clearPanelHistory();
      movePanel(clazz, true, param);
    }
    else {
      if (is_clear_history) clearPanelHistory();
      movePanel(::HomeTopPanel, true);
    }
  }

  function isBackToHomeTopPanel(popnum = 1) {
    popnum++;
    local len = length(this.panel_history);
    if (len >= popnum) {
      if (getclassname(this.panel_history[len - popnum]) != "HomeTopPanel") return false;
    }
    return true;
  }

  function getBackToPanelName(popnum = 1) {
    popnum++;
    local len = length(this.panel_history);
    if (len >= popnum) {
      return getclassname(this.panel_history[len - popnum]);
    }
    return null;
  }

  function clearPanelHistory() {
    this.panel_history.clear();
    this.panel_param_history.clear();
  }

  function movePanel(clazz, pop = false, param = null, trans = null) {
    if (getclass(this.current_panel) == clazz) return;
    if (!this.parent) return;

    this.parent.resetSelectModel();
    this.parent.resetSelectCharaModel();
    local prev_panel = this.current_panel;
    local prev_clazz = getclass(prev_panel) || null;

    if (clazz.need_history_clear) {
      clearPanelHistory();
    }

    local stage = this.parent.getStage();
    local _cw = stage.getCameraWork();
    if (prev_clazz && prev_clazz.need_camera_record) {
      _cw.setTempRecordCamera(getclassname(prev_clazz));
    }

    this.panel_history + clazz;
    if (!clazz.need_param_history_noadd) {
      this.panel_param_history + param;
    } else {
      this.panel_param_history + null;
    }

    ::gamesession.dialoglayer.closeAllDialog();
    ::gamesession.messagelayer.closeAllMessage();

    newthread().start(function() {
      setEventStopper(true);

      setARButtonImage(null);

      local _panel_name = getclassname(clazz);
      this.current_panel = clazz.create.bindenv(clazz)() || clazz();

      if (trans) {
        trans.perform(pop, prev_panel, this.current_panel, clazz, param);
      } else {

        local _title_settings = ::gamesetting.title_settings;
        local _title_setting;
        foreach (_setting in _title_settings) {
          if (!_setting.getKey().equals(_panel_name)) continue;
          _title_setting = _setting;
          break;
        }
        if (_title_setting) setPanelModeSetting(_title_setting);
        else {
          setPanelNameBackground(false);
          setPanelNameText(::dict.get(_panel_name));
        }
        if (_panel_name == "HomeTopPanel" || _panel_name == "RoomMemberPanel") {
          ::gamesession.checkAndAddNewResideChara();
        }

        switch (_panel_name) {
        case "RoomEditPanel":
        case "RoomMemberPanel":
        case "NewCostumeEventPanel":
          parent.removeAllSanrioChara();
          break;
        default:
          parent.updateActiveSanrioCharas();
        }

        setVisibleHomeUIItem(clazz);
        if (clazz.need_camera_record) {
          local ret = _cw.restoreCameraAtTempRecord(getclassname(clazz), true);
        }
        if (param) current_panel.setPanelParam(param);

        if (pop) {

          insertChild(1, this.current_panel);
          if (prev_panel) {
            prev_panel.popped();
            while (prev_panel.isAnimating()) {
              suspend();
            }
          }
          removeChild(prev_panel);
        }
        else {

          local insert_idx = prev_panel ? 2 : 1;
          insertChild(insert_idx, this.current_panel);
          if (clazz.need_push_animation) this.current_panel.pushed();
          while (this.current_panel.isAnimating()) {
            suspend();
          }
          removeChild(prev_panel);
        }
      }
      local _snd = clazz["unique_move_sound"] || ::SoundConstants.SOUND_MOVEPANEL;

      if (!_snd.equals("")) ::playSound(_snd);
      if (clazz.need_menu_layer) showBottomMenu(true);
      if (clazz.need_money_layer) showMoneyUI(true);
      if (clazz.need_panel_name) showPanelMode(true);
      this.btn_ar.setVisible(clazz.need_movear_button);
      if (_panel_name == "HomeTopPanel") updateCameraButtonVisible();

      setVisibleHapinessValueInfo(clazz.need_hapiness_info);
      setVisibleBonusHapinessInfo(clazz.need_bonus_hapiness_info);

      this.slidemenu.setSelectImageVisible(_panel_name);
      this.slidemenu.updateButton();

      if (clazz.unique_bgm) {

        if (!clazz.unique_bgm.equals("none")) ::playBGM(::gamesetting.bgm[clazz.unique_bgm]);
      }
      else {

        local _scene = ::gamesession.getCurrentScene();
        if (getclass(_scene) != ::SanrioGameScene) return;
        _scene.playStageBGM(prev_clazz["unique_bgm"] != null);
      }

      current_panel.show();
      ::tutorial_manager.checkAndStartTutorialAtMovePanel(current_panel);
      current_panel.showed();

      setEventStopper(false);
    }, this)

  }

  function updateRankValue() {
    local ud = ::gamesession.getUserData();
    this.pnl_rank.findChild("lbl_rank").setText(ud.getRank())
  }

  last_update_gm = -1;
  last_update_rm = -1;
  update_gm_thread = null;
  update_rm_thread = null;
  function updateGMValue(reset = false) {
    local ud = ::gamesession.getUserData();
    local _gm = ud.getGameMoney();

    if (_gm == this.last_update_gm) return;

    if (this.last_update_gm < 0 || reset) {

      this.lbl_gm.setText(::formatNumberString(_gm));
      this.last_update_gm = _gm;
    } else {

      if (this.update_gm_thread) this.update_gm_thread.interruptGoto("END");
      this.update_gm_thread = newthread();
      this.update_gm_thread.start(_animeUpdateHapinessValue.bindenv({
        lbl = this.lbl_gm,
        old_val = this.last_update_gm,
        new_val = _gm,
        thread = this.update_gm_thread,
        is_gm = true,
        self = this })
      , this);
    }
  }
  function updateRMValue(reset = false) {
    local ud = ::gamesession.getUserData();
    local _rm = ud.getTotalRealMoney();

    if (_rm == this.last_update_rm) return;

    if (this.last_update_rm < 0 || reset) {
      this.lbl_rm.setText(::formatNumberString(_rm));
      this.last_update_rm = _rm;
    } else {

      if (this.update_rm_thread) this.update_rm_thread.interruptGoto("END");
      this.update_rm_thread = newthread();
      this.update_rm_thread.start(_animeUpdateHapinessValue.bindenv({
        lbl = this.lbl_rm,
        old_val = this.last_update_rm,
        new_val = _rm,
        thread = this.update_rm_thread,
        is_gm = false,
        self = this })
      , this);
    }
  }

  function _animeUpdateHapinessValue() {
    local et = 500.0;
    local el = 0;
    local dt = 16;
    local diff = new_val - old_val;
    local cur_val = old_val;
    local dlt_val = diff / et;

    if (is_gm) {
      self.last_update_gm = new_val;
    } else {
      self.last_update_rm = new_val;
    }

    local _animLbl = self.AnimationMoneyLabel(diff, lbl);
    _animLbl.pos.x = -50;
    _animLbl.pos.y = 40;
    _animLbl.show();

    while (et >= el) {
      cur_val += (int)(dlt_val * dt);
      cur_val = Math.clamp(cur_val, 0, new_val);
      lbl.setText(::formatNumberString(cur_val));
      if (cur_val == new_val) {
        break;
      }

      sleep(dt);
      el += dt;
    }

    END:
    thread = null;
    lbl.setText(::formatNumberString(new_val));
  }

  function updateHapinessValueInfo() {
    this.hapiness_value_info.updateHapinessValue();
  }

  function setPanelModeSetting(setting) {

    this.pnl_pageicon.clearChildren();

    switch (setting.getPanelType()) {
    case ::TitleSetting.TYPE_CLEAR_CHILD:
      setPanelNameText(setting.getName());

      break;
    case ::TitleSetting.TYPE_DEFAULT:

      setPanelNameText(setting.getName());

      setPageIcon(setting.getIconSprite());
      break;
    }

    setPanelNameBackground(setting.largeBackground());
  }

  function setPanelNameAndSprite(txt, sp) {
    setPanelNameText(txt);
  }

  function setPanelNameBackground(b) {
    local _l = this.pnl_mode.findChild("title_bg_l");
    local _s = this.pnl_mode.findChild("title_bg_s");
    _l.setVisible(b);
    _s.setVisible(!b);
  }

  function setCurrentPanelName() {
    local _panel_name = getclassname(current_panel);

    local _title_settings = ::gamesetting.title_settings;
    local _title_setting;
    foreach (_setting in _title_settings) {
      if (!_setting.getKey().equals(_panel_name)) continue;
      _title_setting = _setting;
      break;
    }
    if (_title_setting) setPanelModeSetting(_title_setting);
    else setPanelNameText(::dict.get(_panel_name));
  }
  function setPanelNameText(txt) {
    this.lbl_panelname.setText(txt);
  }
  function setPageIcon(sp) {
    this.pnl_pageicon.clearChildren();
    local _icon = SKImageView();
    _icon.setSprite(sp);
    _icon.setRect(0, 0, this.pnl_pageicon.bnd.w, this.pnl_pageicon.bnd.h);
    this.pnl_pageicon.addChild(_icon);
  }

  function setVisibleHomeUIItem(clazz) {
    this.pnl_rank.setVisible(clazz.need_rank_layer);

    setVisibleCameraRotateButton(clazz.need_camera_rotate);

    this.btn_screen_shot.setVisible(clazz.need_camera);
    this.btn_back.setVisible(clazz.need_back_layer);

    setVisibleScreenshotButton(clazz.need_camera);

    if (!clazz.need_menu_layer) showBottomMenu(false);
    if (!clazz.need_money_layer) showMoneyUI(false);
    if (!clazz.need_panel_name) showPanelMode(false);

    this.btn_ar.setVisible(clazz.need_movear_button);

    local _panel_name = getclassname(this.current_panel);
    if (_panel_name == "HomeTopPanel") updateCameraButtonVisible();

    this.play_ad_video.setVisible(clazz.show_play_ad_video);

    setVisibleHapinessValueInfo(clazz.need_hapiness_info);
    setVisibleBonusHapinessInfo(clazz.need_bonus_hapiness_info);
  }

  function updateCameraButtonVisible() {
    if (!::tutorial_manager.isUnlockCamera()) {
      this.btn_ar.setVisible(false);
      this.btn_screen_shot.setVisible(false);
      return;
    }

    if (parent.getStage().getCharaNum() > 0) {
      this.btn_ar.setVisible(true);
      this.btn_screen_shot.setVisible(true);
    }
    else {
      this.btn_ar.setVisible(false);
      this.btn_screen_shot.setVisible(false);
    }
  }

  function setLockScrollSlideMenu(b) {
    this.scroll.dyscale = b ? 0.0 : 1.0;
  }

  function shopRmLimit(b) {
    this.btn_rm_buy.setEnabled(b);
  }

  function addSanrioChara(chara_id) {
    addSearchCharaButton(chara_id);
  }

  function removeSanrioChara(chara_id) {
    removeSearchCharaButton(chara_id);
  }

  function _callAnimeVisibleCameraButton() {
    clearInterval(this.camera_btn_timeout);
    this.camera_btn_timeout = null;

    this.pnl_camera.anime(0, 5, 20);
  }

  function showMoneyUI(b) {

    if (b) {
      this.startMethod("show_money");
    } else {
      this.startMethod("hide_money");
    }
  }
  function showBottomMenu(b) {

    showSlideMenu(false);
    if (b) {

      if (this.is_show_bottom_btn > 0) return
      this.startMethod("show_bottom");
      $pnl_bottom_slide.pickable = true;
      this.is_show_bottom_btn = 1;
    } else {
      if (this.is_show_bottom_btn == 0) return;
      this.startMethod("hide_bottom");
      $pnl_bottom_slide.pickable = false;
      is_show_slide = false;
      this.is_show_bottom_btn = 0;
    }
  }

  function setShowSlideMenuLock(b) {
    this.show_slide_menu_lock = b;
  }
  function setShowSlideMenuReservationLock(b) {
    this.show_slide_menu_reservation_lock = b;
  }
  function isShowSlideMenu() {
    return this.is_show_slide;
  }

  function showSlideMenu(b) {
    if (this.show_slide_menu_lock) return;

    if (is_show_slide == b) {
      $pnl_bottom_slide.enabled = b;
      return;
    }
    this.reclist.repaint();
    is_show_slide = b;
    if (is_show_slide) {
      $pnl_bottom_slide.enabled = true;
      this.pnl_slidecloser.enabled = true;
      this.startMethod("show_slide");

      if (this.show_slide_menu_reservation_lock) {
        this.show_slide_menu_reservation_lock = false;
        this.show_slide_menu_lock = true;
      }

    } else {
      $pnl_bottom_slide.enabled = false;
      this.pnl_slidecloser.enabled = false;
      this.startMethod("hide_slide");
    }
  }

  function showPanelMode(b) {
    this.pnl_mode.enabled = this.pnl_mode.visible = b;
  }

  function setVisibleScreenshotButton(b) {
    this.btn_screen_shot.setVisible(b);
  }
  function setVisibleCameraRotateButton(b) {

    this.camera_stick.setVisible(b);
  }

  function setVisibleBackButton(b) {
    this.btn_back.setVisible(b);
  }

  function setVisibleBonusHapinessInfo(b) {
    this.bonus_hapiness_info.setVisible(b);
  }
  function setVisibleHapinessValueInfo(b) {
    this.hapiness_value_info.setVisible(b);
  }
  function setEventStopper(b) {
    pnl_eventstopper.setEnabled(b);
    pnl_eventstopper.pickable = b;
  }
  function setCameraButtonEnabled(b) {
    this.btn_ar.setEnabled(b);
    this.btn_screen_shot.setEnabled(b);
  }

  function showBonusHapiness(val, recover_time = -1) {
    newthread().start(function() {
      local _ud = ::gamesession.getUserData();

      _ud.consumeBonusHapinessNum(rec_time);

      self.showMoneyUI(true);

      local _view = ::loadSKView("/ui/common/BonusHapinessEffect.ui");
      _view.findChild("lbl_title").setText(::dict.get("get_bonus_hapiness"));
      _view.findChild("lbl_num").setText(::formatNumberString(val));
      _view.pos.x = self.bnd.w / 2;
      _view.pos.y = self.bnd.h / 2;

      self.addChild(_view);
      _view.startMethod("anim");
      ::playSound(::SoundConstants.SOUND_BONUS_HAPINESS);
      sleep(1500);
      _view.startMethod("hide");
      sleep(500);
      _ud.addGameMoney(val);
      self.updateShopMark(true, true);

      _view.removeFromParent();
      sleep(500);

      local _clazz = getclass(self.getCurrentPanel());
      if (!_clazz.need_money_layer) self.showMoneyUI(false);

    }.bindenv({ self = this, val = val, rec_time = recover_time }), this);
  }

  function getShopCheckManager() {
    return this.shop_check_manager;
  }

  function updateShopMark(add_money, is_gm) {
    this.shop_check_manager.checkMark(add_money);
  }

  function openedShopTable(id) {
    this.shop_check_manager.writeToCheckedShopIdTable(id);
  }

  function checkShopMarked(kind) {
    return this.shop_check_manager.checkShopMarked(kind);
  }

  function isMarkedSetting(ss) {
    return this.shop_check_manager.isMarkedSetting(ss);
  }

  function actionevent_buy(e) {
    e.consume();

    local ud = ::gamesession.getUserData();
    switch (e.src) {
    case this.btn_gm_buy:

      break;
    case this.btn_rm_buy:

      clearPanelHistory();
      movePanel(::ShopPanel, false, { "tab" = ::ShopPanel.TAB_RM });
      break;
    }
  }

  function actionevent_buy_rm(e) {
    if (!::gamesession.isIAPInitializeSuccess()) {
      local _dlg = ::IAPCautionDialog();
      _dlg.show();

      return;
    }

    clearPanelHistory();
    movePanel(::ShopPanel, false, { "tab" = ::ShopPanel.TAB_RM });
    if (getclass(this.current_panel) == ::ShopPanel) {
      this.current_panel.tapShopTab(::ShopPanel.TAB_RM);
    }
  }

  function actionevent_ui_visible(e) {
    e.consume();

    this.pnl_player_info.repaint();
  }

  function actionevent_slide(e) {
    e.consume();
    ::tutorial_manager.checkWaitingActionEvent(getButtonSlide());

    showSlideMenu(!is_show_slide);
  }

  function actionevent_camera_rotate(e) {
    e.consume();

    local stage = getGameScene().getStage();

    switch (e.src) {
    case this.btn_camera_rotateR:
      stage.rotateCameraMove(-45, 0, 0, true);
      break;
    case this.btn_camera_rotateL:
      stage.rotateCameraMove(45, 0, 0, true);
      break;
    case this.btn_camera_rotateU:
      stage.rotateCameraMove(0, 35, 0, true);
    }
  }
  function actionevent_menu(e) {
    e.consume();

    switch (e.src) {
    case btn_menu_chara:
      movePanel(::CharacterPanel);
      break;
    case btn_menu_team:
      movePanel(::RoomMemberPanel)
      break;
    case btn_menu_shop:
      movePanel(::RoomEditPanel);
      break;
    case btn_menu_friend:
      movePanel(::FriendListPanel);
      break;
    case btn_menu_option:
      movePanel(::HelpPanel);
      break;
    }
  }

  function actionevent_screen_shot(e) {
    e.consume();

    if (skGetOSName() == "Android") {
      local _permission = ARUtils.sarCheckStoragePermission();
      if (!_permission) {
        ARUtils.sarConfirmStoragePermission();
        return;
      }
    }

    execScreenShot();
  }

  function execScreenShot() {
    if (is_capture) return;
    this.btn_screen_shot.setVisible(false);
    this.pnl_capturing.setVisible(true);
    this.startMethod("capturing");

    newthread().start(function() {
      this.is_capture = true;
      local _flash = ::SKImageView();
      local _sp = _flash.sp;
      _sp.color = 0xffffffff;
      _sp.blend = SK_MIX;
      _flash.setRect(0.0, 0.0, this.bnd.w, this.bnd.h);
      addChild(_flash);
      local _frames = 30;
      local fdiv = 1.0 / float(_frames - 1);
      for (local l = _frames - 1; l >= 0; l--) {
        local a = ((l * fdiv) * 255.0);
        _sp.color = (_sp.color & 0xffffff00) | a;
        _flash.repaint();
        sleep(16);
      }
      this.removeChild(_flash);
      this.btn_screen_shot.pickable = true;
      this.is_capture = false;
    }, this);
    captureScreen(this.btn_screen_shot, this.pnl_capturing);

    skCollectGarbage();
  }

  function actionevent_movear(e) {
    e.consume();

    if (skGetOSName() == "Android") {
      local _permission = ARUtils.sarCheckARPermission();
      if (!_permission) {
        ARUtils.sarConfirmARPermission();
        return;
      }
    }

    local _charas = parent.getStage().getCharacters();
    if (length(_charas) < 1) return;
    local _costume_list = [];
    foreach (c in _charas) {
      _costume_list + c.getCostumeID();
    }
    local _dlg = ::ARCharaSelectDialog(_costume_list);
    _dlg.show();
    local _select = _dlg.getResult();
    if (_select < 0) return;

    local _param = {};
    _param["taking_id_table"] <- [{ cids = [_select], fuid = -1 }];
    local _pos = parent.getStage().getChara(_select).getPos();
    local _pos_table = {};
    _pos_table[_select] <- Vector3D(_pos.x, _pos.y, _pos.z);
    _param["chara_pos_table"] <- _pos_table;

    movePanel(::ARPanel, false, _param);
  }

  function actionevent_movefocus(e) {
    e.consume();
    this.parent.moveCharaFocusPanelAtSelectModel();
  }

  function mouseevent_slideclose(e) {
    if (e.id == MOUSE_RELEASED) {
      showSlideMenu(false);
    }
  }

  function setARButtonImage(cm = null) {

    local _icon = this.btn_ar.findChild("img_icon");
    if (cm) {
      local chara_setting = ::gamesetting.sanrio_chara_settings[cm.getCharaID()];
      _icon.setSprite(chara_setting.getIconSprite());
      _icon.updateLayout();
      _icon.setVisible(true);
    } else {
      _icon.setVisible(false);
    }
  }

  function captureScreen(btn_ss, view_cap) {
    local _view = getGameScene().getStage().getView();

    local _a = getclass(this.current_panel) == CharaFocusPanel;

    local _b = false;
    local _c = getclass(this.current_panel) == HomeTopPanel;
    local _d = getclass(this.current_panel) == TalkViewPanel;
    local _twl = null;
    local _idx = -1;
    if (_a) {
      _twl = this.current_panel.talkwindow_layer.view;
      _idx = this.current_panel.view.removeChild(_twl);
      _view.addChild(_twl);
    } else if (_d) {
      _twl = this.current_panel.talkwindow_layer.view;
      _idx = this.current_panel.baseview.removeChild(_twl);
      _view.addChild(_twl);
    } else if (_b || _c) {
      _twl = this.current_panel.talkwindow_layer.view;
      _idx = this.current_panel.removeChild(_twl);
      _view.addChild(_twl);
    }

    local _sprite = _view.capture();

    if (_twl) {
      _view.removeChild(_twl);
      if (_a) {
        this.current_panel.view.insertChild(_idx, _twl);
      } else if (_b || _c) {
        this.current_panel.insertChild(_idx, _twl);
      } else if (_d) {
        this.current_panel.baseview.insertChild(_idx, _twl);
      }
    }

    local buf = ::makeFilename("jpg");

    local _filepath = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_IMAGE, ::FilePathManager.APPLICATION_MODE_GAME);
    if (!_filepath) {

      _filepath = "image/";
      local _ref = FileRef(_filepath);
      if (!_ref.exists()) _ref.mkdirs();
    }

    newthread().start(function() {
      local _log = true;
      local _sucess = false;

      if (false) {

        local _picture = SKView();
        local _padding = 80;
        _picture.setRect(0, 0, _sprite.bnd.w + _padding, _sprite.bnd.h + _padding);
        local _frame_path = "/ui/image/bg/picture_frame.png";
        local _frame = SKImageView(::getSprite(_frame_path));
        _frame.setRect(0, 0, _picture.bnd.w, _picture.bnd.h);
        _picture.addChild(_frame);
        local _imageview = ::SKImageView(_sprite);
        _imageview.centerize();
        _imageview.pos.x = _picture.bnd.w / 2.0;
        _imageview.pos.y = _picture.bnd.h / 2.0;
        _picture.addChild(_imageview);

        self.current_panel.addChild(_picture);
        _picture.bnd.x -= 50;
        _picture.bnd.y -= 50;
        _picture.pos.x += 50;
        _picture.pos.y += 50 + (this.current_panel.bnd.h - ::screenHeight) / 2.0;
        local _model = this.current_panel.getCharaModel();
        local _scp = "has_been_shot";

        _model.startCharaScriptAction(_scp);
        _scaleAnime(_picture);
        sleep(500);
        while (_model.isScriptRunning() && _model.getCurrentScriptName() == _scp) { suspend() };

        local _dlg = ::OutputSelectDialog();
        _dlg.setShowedFunc(function() {
          self.current_panel.removeChild(_picture);
          _dlg.view.addChild(_picture);
        }.bindenv(this));
        _dlg.show();
        if (_dlg.ret > 0) {
          _sucess = saveImage(_sprite, _filepath + buf, ::displayWidth, ::displayHeight);
          switch (_dlg.ret) {
          case 1:
            if (_sucess) {
              local _osname = skGetOSName();

              if (_osname.equals("Android")) {
                local _external_str = replaceNewLine(::dict.get("external_text_picture"));
                ARUtils.startExternalIntent(_filepath + buf, _external_str);
              }
            }
            break;
          }
        } else {
          _log = false;
        }
      } else {
        _sucess = self.saveImage(_sprite, _filepath + buf, ::displayWidth, ::displayHeight);
      }

      if (_log) {
        ::gamesession.messagelayer.closeAllMessage();
        local _msg = ::Message();
        _msg.setText(_sucess ? ::dict.get("capture_completed") : ::dict.get("can_not_capture"));
        _msg.setFontSize(32);
        _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0, 0);
        _msg.show();
      }
      if (btn_ss) btn_ss.setVisible(true);
      if (view_cap) view_cap.setVisible(false);
    }, {
      self = this,
      btn_ss = btn_ss,
      view_cap = view_cap
    });
  }

  function _scaleAnime(view, diff = 2, end = 1000.0) {
    for (local i = 0; i < int(end / diff); i++) {
      local _f = Math.lerp(1.0, 0.3, (diff / end) * i);
      view.scale.set(_f);
      view.matdirty = true;
      sleep(diff);
    }
  }

  function saveImage(sprite, path, width, height) {
    local rgba_image = RGBAImage(width, height);
    local x = 0;
    local y = 0;
    local w = getGameScene().getStage().sk3dview.bnd.w;
    local h = getGameScene().getStage().sk3dview.bnd.h;
    local old = skGetRenderTarget();

    skSetRenderTarget(sprite.tex0);
    skSetViewport();
    skReadPixels(x, y, w, h, rgba_image);
    skSetRenderTarget(old);

    local _outres = FileRef(path);

    local _env = {
      _rgba_image = rgba_image;
      _outres = _outres;
    }
    local _sucess = true;
    try {
      local _worker_id = workerthread.eval(
      "println(\"_rgba_image:\"+vargv[0]._rgba_image+\" _outres:\"+vargv[0]._outres); " +
      "local jpg_image = vargv[0]._rgba_image.encodeJpeg( 90); " +
      "jpg_image.pos = 0; " +
      "vargv[0]._outres.save( jpg_image); " +
      "return skGetWorkerID(); ", _env);

      local _osname = skGetOSName();
      if (_osname.equals("iOS") || _osname.equals("Android")) ARUtils.savePhotoGallery(path);
    } catch (ex) {
      printexception(ex);
      sendException(ex, "error in save image ....");
      _sucess = false;
    }
    return _sucess;
  }

  function actionevent_back(e) {
    e.consume();
    backTapped();
  }

  function backTapped() {
    if (this.current_panel) {
      this.current_panel.backTapped();
    }
  }

  is_debug_visible = true;
  function actionevent_debug(e) {
    e.consume();

    is_debug_visible = !is_debug_visible;
    foreach (ins, val in getclass(this)) {
      if (this[ins] instanceof SKImageView
      || this[ins] instanceof SKGroupView
      || this[ins] instanceof SKLabelView)
      {
        this[ins].visible = is_debug_visible;
        this[ins].matdirty = true;
        this[ins].repaint();
      }
    }
    if (this.current_panel instanceof ARPanel) {
      foreach (child in this.current_panel.view.children) {
        if (child.name.startsWith("btn_")) {
          child.visible = is_debug_visible;
        }
      }
    } else {
      this.current_panel.visible = is_debug_visible;
    }
    this.current_panel.matdirty = true;
    this.current_panel.repaint();

    this.btn_debug.visible = true;
    btn_debug.matdirty = true;
    btn_debug.repaint();
  }

  static UPDATE_MENU_MARK_ALL = -1;
  static UPDATE_MENU_MARK_COSTUME = 0;
  static UPDATE_MENU_MARK_FURNITURE = 1;
  static UPDATE_MENU_MARK_ROOM = 2;
  static UPDATE_MENU_MARK_GACHA = 3;
  gacha_new_mark = false;
  function updateMenuNewMark(kind = -1) {

    switch (kind) {
    case UPDATE_MENU_MARK_COSTUME:
      this.slidemenu.updateTeamButton();
      break;
    case UPDATE_MENU_MARK_FURNITURE:
      this.slidemenu.updatePropertyButton();
      break;
    case UPDATE_MENU_MARK_ROOM:
      this.slidemenu.updatePropertyButton();
      break;
    case UPDATE_MENU_MARK_GACHA:
      this.gacha_new_mark = this.slidemenu.updateGachaButton();
      break;
    case -1:
      this.slidemenu.updateTeamButton();
      this.slidemenu.updatePropertyButton();
      break;
    }

    this.img_menu_new_mark.visible = (::gamesession.getUserDataLocal().hasNewItems(-1) | this.gacha_new_mark);
  }

  function updateNewItemMark(b) {
    this.slidemenu.updateShopButton(b);
    this.img_menu_newitem_mark.setVisible(b);
  }

  function resetSelectInfo() {
    getGameScene().resetSelectModel();
    this.setCurrentPanelName();
  }
}

class HomeUI.SlideMenu extends SKView {
  static LIGHT_ALPHA = 64;
  view = null;

  btn_team = null;
  btn_shop = null;
  btn_layout = null;
  btn_property = null;
  btn_room = null;
  btn_diarycontents = null;
  btn_option = null;

  btn_home = null;
  btn_reset = null;
  btn_mail = null;
  btn_chara_list = null;

  home_ui = null;

  select_images = null;

  constructor(home) {
    this.home_ui = home;
    this.select_images = {};

    view = ::loadSKView("/ui/common/HomeSlideMenu.ui");
    view.pos.y += 20;
    addChild(view);

    local _h = view.bnd.h + 200;
    setRect(0, 0, view.bnd.w, _h, view.bnd.w / 2, 0);

    local _pnl = this.view.findChild("pnl_bottom_menu");

    local _btn = _pnl.findChild("btn_menu_team");
    this.btn_team = _btn.findChild("btn");
    ::TapButton(this.btn_team, false).view.addEventListener(ACTION_EVENT, actionevent_menu);
    _setupButton(_btn);

    _btn = _pnl.findChild("btn_menu_shop");
    this.btn_shop = _btn.findChild("btn");
    ::TapButton(this.btn_shop, false).view.addEventListener(ACTION_EVENT, actionevent_menu);
    _setupButton(_btn);

    _btn = _pnl.findChild("btn_menu_layout");
    this.btn_layout = _btn.findChild("btn");
    ::TapButton(this.btn_layout, false).view.addEventListener(ACTION_EVENT, actionevent_menu);
    _setupButton(_btn);

    _btn = _pnl.findChild("btn_menu_property");
    this.btn_property = _btn.findChild("btn");
    ::TapButton(this.btn_property, false).view.addEventListener(ACTION_EVENT, actionevent_menu);
    _setupButton(_btn);

    _btn = _pnl.findChild("btn_menu_room");
    this.btn_room = _btn.findChild("btn");
    ::TapButton(this.btn_room, false).view.addEventListener(ACTION_EVENT, actionevent_menu);
    _setupButton(_btn);

    _btn = _pnl.findChild("btn_menu_diarycontents");
    this.btn_diarycontents = _btn.findChild("btn");
    ::TapButton(this.btn_diarycontents, false).view.addEventListener(ACTION_EVENT, actionevent_menu);
    _setupButton(_btn);

    _btn = _pnl.findChild("btn_menu_option");
    this.btn_option = _btn.findChild("btn");
    ::TapButton(this.btn_option, false).view.addEventListener(ACTION_EVENT, actionevent_menu);
    _setupButton(_btn);

    local _pnl_slide = this.home_ui.findChild("pnl_bottom_slide");
    this.btn_home = _pnl_slide.findChild("btn_slide_home");
    ::TapButton(this.btn_home).view.addEventListener(ACTION_EVENT, actionevent_menu);
    this.btn_reset = _pnl_slide.findChild("btn_slide_reset");
    ::TapButton(this.btn_reset).view.addEventListener(ACTION_EVENT, actionevent_menu);
    this.btn_mail = _pnl_slide.findChild("btn_slide_mail");
    ::TapButton(this.btn_mail).view.addEventListener(ACTION_EVENT, actionevent_menu);

    this.btn_chara_list = _pnl_slide.findChild("btn_chara_list");

    this.btn_chara_list.visible = false;

    _pnl_slide.findChild("region").addEventListener(MOUSE_EVENT, mouseevent_consume);
  }

  function shopLimit(b) {
    _menuLimit(this.btn_shop, b);
  }

  function propertyLimit(b) {
    _menuLimit(this.btn_property, b);
  }

  function layoutLimit(b) {
    _menuLimit(this.btn_layout, b);
  }

  function gachaLimit(b) {
  }

  function teamLimit(b) {
    _menuLimit(this.btn_team, b);
  }

  function roomLimt(b) {
    _menuLimit(this.btn_room, b);
  }

  function diaryLimit(b) {
    _menuLimit(this.btn_diarycontents, b);
  }

  function _menuLimit(btn, b) {
    btn.enabled = b;

    local _a = 255;
    local _b = LIGHT_ALPHA;

    local _text = btn.findChild("lbl_name");
    local _mask = _text.fontattr.color & 0xffffff00;
    _text.setColor(_mask + (b ? _a : _b));
  }

  function updateButton() {
    if (getclassname(getclass(this.home_ui.current_panel)) == "HomeTopPanel") {
      this.btn_home.visible = false;
      this.btn_reset.visible = true;
    }
    else {
      this.btn_home.visible = true;
      this.btn_reset.visible = false;
    }
  }

  function _getSetting(btn) {
    foreach (s in ::gamesetting.menu_button_settings) {
      if (btn.name == s.getKey()) return s;
    }
    return null;
  }

  function _setupButton(btn) {
    local _setting = _getSetting(btn);
    if (!_setting) return;

    btn.findChild("lbl_name").setText(_setting.getName());

    local _pnl_icon = btn.findChild("img_icon");
    local _icon = SKImageView();
    _icon.setSprite(_setting.getIconSprite());
    _icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(_icon);

    local _pnl_bg = btn.findChild("img_bg");
    local _bg = SKImageView();
    _bg.setSprite(_setting.getBackGroundSprite());
    _bg.setRect(0, 0, _pnl_bg.bnd.w, _pnl_bg.bnd.h);
    _pnl_bg.addChild(_bg);

    local _img_select_bg = btn.findChild("img_select_bg");
    _img_select_bg.visible = false;
    if (_setting.getPanelKey()) this.select_images[_setting.getPanelKey()] <- _img_select_bg;

    btn.findChild("img_new").visible = false;
    btn.findChild("img_newitem").visible = false;
  }

  function mouseevent_consume(e) {
    e.consume();
  }

  function actionevent_menu(e) {

    switch (e.src) {
    case btn_team:
      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::RoomMemberPanel)
      break;
    case btn_layout:
      ::tutorial_manager.checkWaitingActionEvent(this.btn_layout);

      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::RoomEditPanel);
      break;
    case btn_shop:
      ::tutorial_manager.checkWaitingActionEvent(this.btn_shop);

      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::ShopPanel);
      break;
    case btn_property:
      ::tutorial_manager.checkWaitingActionEvent(this.btn_property);

      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::PropertyPanel);
      break;
    case btn_room:
      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::RoomSelectPanel);
      break;
    case btn_diarycontents:
      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::DiaryContentsPanel);
      break;
    case btn_option:
      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::HelpPanel);
      break;
    case btn_home:
      this.home_ui.clearPanelHistory();
      this.home_ui.movePanel(::HomeTopPanel);
      break;
    case btn_reset:
      local stage = ::gamesession.getCurrentScene().getStage();
      stage.setCameraDefault(false, false);
      this.home_ui.showSlideMenu(false);
      break;
    case btn_mail:
      this.home_ui.movePanel(::MailPanel);
      break;
    case btn_chara_list:
      this.home_ui.clearPanelHistory();
      local _kitty_setting = ::gamesetting.getSanrioCharaSettingByNameKey("kitty");
      this.home_ui.movePanel(::CharaProfilePanel, false, { "setting" = _kitty_setting });
      break;
    }
  }

  function setSelectImageVisible(key) {
    foreach (k, img in this.select_images) {
      if (k == key) img.visible = true;
      else img.visible = false;
    }
  }

  function updateTeamButton() {
    local _v = ::gamesession.getUserDataLocal().hasNewItems(ITEM_TYPE_COSTUME);
    this.btn_team.findChild("img_new").visible = _v;
    return _v;
  }
  function updatePropertyButton() {
    local _lud = ::gamesession.getUserDataLocal();
    local _v = (_lud.hasNewItems(ITEM_TYPE_FURNITURE) | _lud.hasNewItems(ITEM_TYPE_ROOM));
    this.btn_property.findChild("img_new").visible = _v;
    return _v;
  }
  function updateRoomButton() {
    local _v = ::gamesession.getUserDataLocal().hasNewItems(ITEM_TYPE_ROOM);
    this.btn_room.findChild("img_new").visible = _v;
    return _v;
  }
  function updateGachaButton() {
    return false;
  }

  function updateShopButton(_b) {

    this.btn_shop.findChild("img_newitem").visible = _b;
    this.btn_shop.repaint();
  }

  function setEnabledBottomButton(b) {
    this.btn_reset.setEnabled(b);
    this.btn_mail.setEnabled(b);
    this.btn_chara_list.setEnabled(b);
  }

  function getButtonShop() {
    return this.btn_shop;
  }
  function getButtonLayout() {
    return this.btn_layout;
  }
  function getButtonProperty() {
    return this.btn_property;
  }
  function getButtonDiaryContents() {
    return this.btn_diarycontents;
  }
}

class HomeUI.AnimationMoneyLabel extends SKView {
  parent_view = null;

  view = null;

  constructor(val, p) {
    this.parent_view = p;

    this.view = ::loadSKView("/ui/common/AnimationAddValue.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    this.pickable = false;

    this.view.findChild("lbl_val").setText(::dict.get("nums_plus", [::formatNumberString(val)]));
  }

  function show() {
    newthread().start(function() {
      this.parent_view.addChild(this);
      this.view.startMethod("show");
      while (this.view.isMethodRunning()) {
        suspend();
      }
      this.removeFromParent();
    }.bindenv(this));
  }
}

class HomeUI.CameraRotateUI {
  static MAX_DISTANCE = 75;
  static RESET_CAMERA_TIME = 120;

  base_x = null;
  base_y = null;
  pressed_time = null;

  stage = null;

  view = null;
  img_btn = null;
  btn = null;

  vec = null;

  constructor(view) {
    this.view = view;
    this.img_btn = this.view.findChild("btn_stick");
    this.btn = ::TapButton(this.img_btn, false);
    this.btn.setPressedPostAction(true);
    this.btn.view.addEventListener(MOUSE_EVENT, mouse_event);

    this.base_x = this.img_btn.pos.x;
    this.base_y = this.img_btn.pos.y;

    this.vec = Vector3D();
    this.pressed_time = -1;
  }

  function setStage(stage) {
    this.stage = stage;
  }

  function setVisible(b) {
    this.view.setVisible(b);
  }

  function update(dt) {
    if (this.vec.length() > 0) {
      local _rate = 0.05;
      this.stage.rotateCamera_byScreenDist(this.vec.x * _rate, this.vec.y * _rate * -1);
    }
  }

  function _updateButtonPos(x, y) {
    this.vec.set(x, y, 0).sub(this.view.pos.x, this.view.pos.y, 0);

    if (this.vec.length() >= MAX_DISTANCE) {
      local _rate = MAX_DISTANCE / this.vec.length();
      this.vec.x *= _rate;
      this.vec.y *= _rate;
    }
    this.vec.y *= -1;

    this.img_btn.pos.x = this.base_x + this.vec.x;
    this.img_btn.pos.y = this.base_y - this.vec.y;
    this.img_btn.matdirty = true;
  }

  function _resetButtonPos() {
    this.img_btn.pos.x = this.base_x;
    this.img_btn.pos.y = this.base_y;
    this.vec.set(0, 0, 0);
    this.img_btn.matdirty = true;
  }

  function mouse_event(e) {
    local _ds = getDisplayScale();
    local epx = e.x / _ds + ::uiWidth / 2.0 - ::screenWidth / 2.0;
    local epy = e.y / _ds + ::uiHeight / 2.0 - ::screenHeight / 2.0;

    e.consume();
    switch (e.id) {
    case MOUSE_PRESSED:
      _updateButtonPos(epx, epy);
      this.pressed_time = skGetTime();
      break;
    case MOUSE_DRAGGED:
      _updateButtonPos(epx, epy);
      break;
    case MOUSE_RELEASED:
      _resetButtonPos();
      if (this.pressed_time + RESET_CAMERA_TIME > skGetTime() &&
      ::gamesession.getCurrentScene().getUI().getCurrentPanel() instanceof HomeTopPanel) {
        this.stage.setCameraDefault(false, false);
      }
      this.pressed_time = -1;
      break;
    }
  }
}

class HomeUI.CostumeInfo {
  costume_data = null;
  costume_model = null;

  view = null;
  exp_bar = null;
  lbl_costume_func = null;
  costume_func = null;

  constructor(v) {
    this.view = v;

    this.exp_bar = ExpBar(v.findChild("pnl_level"));

    local _btn_func = v.findChild("btn_costume_func");
    ::TapButton(_btn_func).view.addEventListener(ACTION_EVENT, actionevent_costume_func);
    this.lbl_costume_func = _btn_func.findChild("lbl_costume_func");
  }

  function setVisible(b) {
    this.view.visible = b;
  }

  function setModel(cm) {
    if (!cm) return;

    this.costume_model = cm;
    local _cd = cm.getCostumeData();
    this.costume_data = _cd;
    this.exp_bar.setData(_cd);
    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != ::SanrioGameScene) return;

    this.costume_func = moveCharaFocusPanel.bindenv(this);
    if (_cd.enableLevelUp()) this.lbl_costume_func.setText(::dict.get("levelup"));
    else this.lbl_costume_func.setText(::dict.get("focus"));
  }

  function updateInfo() {
    if (!this.costume_data) return;
    this.exp_bar.updateView();
  }

  function actionevent_costume_func(e) {
    e.consume();
    if (costume_func) costume_func();
  }

  function moveCharaFocusPanel() {
    this.view.parent.resetSelectInfo();
    this.view.parent.movePanel(::CharaFocusPanel, false, { "model" = costume_model });
  }
}

class HomeUI.CostumeInfo.ExpBar {
  bar = null;
  lbl_exp = null;
  lbl_level = null;
  costume_data = null;

  constructor(v) {
    this.lbl_exp = v.findChild("lbl_exp");
    this.lbl_level = v.findChild("lbl_lv");
    this.bar = Bar(v.findChild("img_bar"));
  }

  function setData(cd) {
    this.costume_data = cd;
    updateView();
  }

  function updateView() {
    local _exp = this.costume_data.getExp();
    local _max_exp = this.costume_data.getMaxExp();
    local _lv = this.costume_data.getLevel();
    local _ratio = int(this.costume_data.getExpRatio() * 100.0);
    if (_ratio > 100) _ratio = 100;
    this.lbl_exp.setText(_ratio + ::dict.get("update_prepare"));
    this.lbl_level.setText(::dict.get("nums_level", [_lv]));
    this.bar.setMaxValue(_max_exp);
    this.bar.setValue(_exp);
  }
}

class HomeUI.CostumeInfo.ExpBar.Bar {
  img_bar = null;

  pos = null;
  max_width = 0;
  max_value = -1;

  constructor(bar) {
    this.img_bar = bar;
    this.max_width = float(bar.bnd.w);
    this.pos = { x = 0, y = 0 };
    this.pos.x = bar.pos.x - this.max_width / 2.0;
    this.pos.y = bar.pos.y - bar.bnd.h / 2.0;
  }

  function setMaxValue(v) {
    this.max_value = float(v);
  }

  function setValue(v) {
    if (this.max_value <= 0 || v <= 0) {
      this.img_bar.visible = false;
      return;
    }
    local _ratio = float(v) / this.max_value;
    local _w = this.max_width * _ratio;
    if (_w <= 0) {
      this.img_bar.visible = false;
    }
    else {
      this.img_bar.visible = true;
      if (_w < 20) _w = 20.0;
      if (_w > this.max_width) _w = this.max_width;

      this.img_bar.setRect(this.pos.x, this.pos.y, _w, this.img_bar.bnd.h);
    }
  }
}

class HomeUI.BonusHapinessInfo {
  user_data = null;
  last_bonus_num = null;
  last_recover_remain = null;
  last_next_recovery = null;
  el_time = null;
  stop_update = null;

  setuped = null;

  view = null;
  img_heart_list = null;
  lbl_min = null;
  lbl_sec = null;
  lbl_colon = null;

  constructor(view) {
    this.setuped = false;

    this.view = view.findChild("BonusHapinessInfo");
    this.view.pickable = false;

    this.img_heart_list = [];
    for (local i = 1; i <= ::UserData.MAX_BONUS_HAPINESS_NUM; i++) {
      local _str = "img_heart" + i;
      this.img_heart_list + this.view.findChild(_str);
    }

    this.lbl_min = this.view.findChild("lbl_min");
    this.lbl_sec = this.view.findChild("lbl_sec");
    this.lbl_colon = this.view.findChild("lbl_colon");

    this.last_bonus_num = -1;
    this.last_recover_remain = -1;
    this.last_next_recovery = 0;
    this.user_data = ::gamesession.getUserData();
    _updateBonusNum(this.user_data.getBonusHapinessNum(), true);
    _updateRecoveryTime(this.user_data.getNextBonusHapinessRecoveryTime());

    this.el_time = 0;
    this.stop_update = false;

    this.lbl_colon.setText(::dict.get("colon_only"));
    this.setuped = true;
  }

  function update(dt) {
    if (!this.setuped) return;

    this.el_time += dt;
    if (this.stop_update) return;

    if (this.el_time >= 1000) {
      _updateBonusNum(this.user_data.getBonusHapinessNum());
      _updateRecoveryTime(this.user_data.getNextBonusHapinessRecoveryTime());
      this.el_time = this.el_time % 1000;
    }
  }

  function _updateBonusNum(num, is_init = false) {
    if (!is_init && this.last_bonus_num == num) return;

    if (is_init) {
      foreach (idx, img in img_heart_list) {
        local _b = num >= idx + 1 ? true : false;
        img.setVisible(_b);
      }
      this.last_bonus_num = num;
      return;
    }

    if (this.last_bonus_num > num) {
      this.view.startMethod("consume_heart", this.last_bonus_num);
    } else {
      this.view.startMethod("recovery_heart", this.last_bonus_num + 1, num);
    }
    this.last_bonus_num = num;
  }

  function _updateRecoveryTime(next_rec_time) {
    if (next_rec_time < 0) {
      if (this.last_next_recovery == next_rec_time) return;

      this.lbl_min.setVisible(false);
      this.lbl_sec.setVisible(false);
      this.lbl_colon.setVisible(false);
    } else {
      if (this.last_next_recovery < 0) {
        this.lbl_min.setVisible(true);
        this.lbl_sec.setVisible(true);
        this.lbl_colon.setVisible(true);
      }

      local _rem = next_rec_time - ::getServerTime();
      if (_rem < 0) _rem = 0;
      local _param = { minute = -1, sec = -1 };
      _param = ::calcTimePart(_rem, _param);

      local _min_txt = _param.minute >= 10 ? _param.minute : "0" + _param.minute;
      local _sec_txt = _param.sec >= 10 ? _param.sec : "0" + _param.sec;

      this.lbl_min.setText(_min_txt);
      this.lbl_sec.setText(_sec_txt);
    }

    this.last_next_recovery = next_rec_time;
  }

  function setVisible(b) {
    this.view.setVisible(b);
    this.stop_update = !b;
  }
}

class HomeUI.HapinessValueInfo {

  view = null;
  lbl_tap = null;

  constructor(view) {
    this.view = view;
    this.view.pickable = false;

    this.lbl_tap = this.view.findChild("lbl_tap");

    updateHapinessValue();
  }

  function updateHapinessValue() {
    local _ud = ::gamesession.getUserData();
    this.lbl_tap.setText(::formatNumberString(_ud.getTapHapiness()));
  }

  function setVisible(b) {
    this.view.setVisible(b);
  }
}