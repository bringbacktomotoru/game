class RoomSelectPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;

  static sale_flag = true;
  static unique_bgm = "BGM07";

  static HEADER_X = 10;
  static SPACE_X = 15;

  item_list = null;
  room_slot_list = null;

  scroll = null;
  reclist = null;
  scroll_bar = null;

  view = null;
  pnl_item_list = null;
  btn_back = null;
  btn_restore = null;

  select_tap_lock = false;

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/ItemListPanelWide.ui");
    addChild(this.view);

    this.pnl_item_list = this.view.findChild("pnl_item_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.pnl_item_list.addChild(this.reclist);
    this.pnl_item_list.setBuffer(true);

    local sale_pnl = this.view.findChild("pnl_sale");
    sale_pnl.visible = sale_flag;
    if (sale_flag) sale_pnl.findChild("lbl_desc").setText(::dict.get("shop_sale"));

    this.scroll_bar = ::ScrollBarH(this.view.findChild("pnl_scroll_bar"));

    this.btn_back = this.view.findChild("btn_back");
    ::TapButton(this.btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    this.btn_restore = this.view.findChild("btn_restore");
    if (skGetOSName() == "iOS"
    && skGetVersion() >= 19
    && (::gamesetting.game_rule.disableTutorial()
    || ::gamesession.getUserData().isEndTutorialId(::TutorialSetting.TUTORIAL_FIRST_LOGIN))) {
      this.btn_restore.findChild("lbl_restore").setText(::dict.get("purchase_restore"));
      ::TapButton(this.btn_restore).view.addEventListener(ACTION_EVENT, actionevent_restore);
    }
    else {
      this.btn_restore.visible = false;
    }

    this.room_slot_list = ::gamesession.getUserData().getRooms();
    _setupRoomIcon();

    this.view.startMethod("init");
  }

  function show() {
    this.view.startMethod("show");
  }

  function _setupRoomIcon() {
    this.reclist.clearChildren();
    this.item_list = [];

    local _last = this.room_slot_list.len() - 1;
    local _offset = HEADER_X;

    local _shop_rooms = ::gamesetting.getShopSettings(SHOP_ITEM_TYPE_ROOM);
    local _sort_list = [];
    foreach (ss in _shop_rooms) {
      if (!ss) continue;
      local _pri = ss.getPriority();
      local _in = false;
      foreach (idx, slss in _sort_list) {
        if (_pri > slss.getPriority()) {
          _sort_list[idx] <- ss;
          _in = true;
          break;
        }
      }
      if (!_in) _sort_list + ss;
    }
    foreach (ss in _sort_list) {
      local _item = RoomItem(this);
      if (!_item.setup(ss)) continue;

      _item.pos.x = _offset;
      this.reclist.addChild(_item);
      this.item_list + _item;

      _offset += _item.bnd.w + SPACE_X;
    }
    _offset += 100;

    this.reclist.setRect(0, 0, _offset, this.pnl_item_list.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);
    this.scroll_bar.setup(this.scroll, this.pnl_item_list.bnd, true);
  }

  function showConfirmChangeRoom(idx) {
    local _rsd = this.room_slot_list[idx];

    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(::dict.get("go_other_room", [_rsd.getRoomName()]));
    _dlg.lbl_caution.setVisible(false);
    _dlg.show();

    if (_dlg.ret > 0) {
      local _scene = ::gamesession.getCurrentScene();
      if (_scene instanceof ::SanrioGameScene) {
        local _idx = ::gamesession.getUserData().getRoomIndexByRoomID(_rsd.getRoomUID());

        _scene.selectRoom(_idx);
        _scene.getUI().movePanel(::HomeTopPanel);
      }
    }
  }

  function setTutorialLock() {
    foreach (idx, item in this.item_list) {
      item.enabled = false;
    }

    this.btn_back.setEnabled(false);

  }

  function setTutorialUnlock() {
    foreach (idx, item in this.item_list) {
      item.enabled = true;
    }
  }

  function getFirstListItem() {
    return this.item_list[0];
  }

  function actionevent_back(e) {
    getHomeUI().backPanel();
  }

  function actionevent_restore(e) {

    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(::dict.get("purchase_restore_desc"));
    _dlg.lbl_caution.setText(::dict.get("purchase_restore_caution"));
    _dlg.show();

    if (!_dlg.ret) return;

    ::gamesession.getCurrentScene().setEnabled(false);
    ::gamesession.restorePurchaseRMItems(this, restoreCallback);
  }

  function restoreCallback(pnl, restore) {

    local _dlg = ::SimpleDialog();
    if (restore) {
      pnl._setupRoomIcon();
      _dlg.lbl_msg.setText(::dict.get("purchase_restore_success"));
    }
    else {
      _dlg.lbl_msg.setText(::dict.get("purchase_restore_nothing"));
    }
    _dlg.show();
    ::gamesession.getCurrentScene().setEnabled(true);
  }

  function tutorialRoomSelect(setting) {
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();
    local _ud = ::gamesession.getUserData();

    _home_ui.getButtonSlide().setEnabled(false);
    _home_ui.showSlideMenu(false);
    _self.setTutorialLock();
    local _item = _self.getFirstListItem();

    sleep(500);

    _tl.showText(_texts[0], 1);
    sleep(750);
    _tl.waitTap();

    _tl.hideText();
    _self.setTutorialUnlock();

    while (_item.getTutorialState() < 2) {
      suspend();
    }

    while (_item.getTutorialState() < 3) {
      suspend();
    }

    _home_ui.getButtonSlide().setEnabled(true);
  }
}

class RoomSelectPanel.RoomItem extends SKView {
  pnl_parent = null;
  view = null;

  static ICON_OFFSET_X = 0;

  static BG_IMAGE_DEF = 1;
  static BG_IMAGE_BUY = 2;
  static BG_IMAGE_FREE = 3;
  img_bg = null;
  btn_bg = null;

  lbl_size = null;
  lbl_name = null;

  lbl_select = null;
  lbl_gm = null;

  img_icon = null;

  btn_detail = null;
  btn_dialy = null;
  btn_select = null;

  lbl_story_name = null;

  pnl_chara_icon = null;

  img_clear = null;

  pnl_nopurchase = null;

  room_setting = null;
  shop_setting = null;

  static BUY_STATE_OK = 0;
  static BUY_STATE_CONDITION = 1;
  static BUY_STATE_TUTORIAL = 2;
  buy_state = 0;

  tutorial_state = 0;

  detail_item_table = null;

  pnl_sale = null;
  sale_flag = false;

  constructor(p) {
    this.view = ::loadSKView("/ui/common/SelectRoomItem.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    this.pnl_parent = p;

    this.img_bg = {};
    this.img_bg["def"] <- this.view.findChild("img_bg_def");
    this.img_bg["buy"] <- this.view.findChild("img_bg_buy");
    this.img_bg["free"] <- this.view.findChild("img_bg_free");

    this.lbl_size = this.view.findChild("lbl_size");
    this.lbl_name = this.view.findChild("lbl_name");
    this.lbl_story_name = this.view.findChild("lbl_story_name");

    this.img_icon = this.view.findChild("img_icon");

    this.btn_detail = this.view.findChild("btn_detail");
    ::TapButton(this.btn_detail, false).view.addEventListener(ACTION_EVENT, actionevent_detail);
    this.btn_dialy = this.view.findChild("btn_dialy");
    ::TapButton(this.btn_dialy, false).view.addEventListener(ACTION_EVENT, actionevent_dialy);
    this.btn_select = this.view.findChild("btn_select");
    ::TapButton(this.btn_select, false).view.addEventListener(ACTION_EVENT, actionevent_select);
    this.lbl_select = this.btn_select.findChild("lbl_select");

    this.pnl_sale = this.view.findChild("pnl_sale_desc");

    this.btn_bg = {};
    this.btn_bg["def"] <- this.btn_select.findChild("btn_bg_select_def");
    this.btn_bg["buy"] <- this.btn_select.findChild("btn_bg_select_buy");
    this.btn_bg["free"] <- this.btn_select.findChild("btn_bg_select_free");

    this.pnl_chara_icon = this.view.findChild("pnl_chara_icon");

    this.img_clear = this.view.findChild("img_clear");

    this.view.findChild("lbl_roomdetail").setText(::dict.get("roomdetail_chara"));
    this.detail_item_table = null;
    this.view.findChild("lbl_story").setText(::dict.get("event"));

    this.lbl_gm = this.view.findChild("lbl_gm");

    this.pnl_nopurchase = this.view.findChild("pnl_nopurchase");
    this.pnl_nopurchase.visible = false;

  }

  function setup(ss) {
    if (!ss || ss.getType() != SHOP_ITEM_TYPE_ROOM) return false;

    local _rs = ::gamesetting.room_settings[ss.getSellRoomId()];
    if (!_rs) return false;

    this.shop_setting = ss;
    this.room_setting = _rs;

    this.lbl_size.setText(this.room_setting.getSizeText());
    this.lbl_name.setText(this.room_setting.getName());

    this.img_icon.setSprite(_rs.getIconSpriteUnacquired());
    this.img_icon.updateLayout();

    local _ds = ::gamesetting.diary_settings[_rs.getFirstDiaryID()];
    this.lbl_story_name.setText(_ds.getName());

    local _ud = ::gamesession.getUserData();
    local _rsID = _rs.getID();
    local _gm = _ud.getGameMoney(_rsID);
    this.lbl_gm.setText(::formatNumberString(_gm));

    this.pnl_chara_icon.clearChildren();
    local _chara_ids = this.room_setting.getCharaIDs();
    local _chara_list = [];
    if (_chara_ids) {
      local _w = this.pnl_chara_icon.bnd.w;
      local _size = this.pnl_chara_icon.bnd.h;

      local _cnt = 0;
      local _len = _chara_ids.len();
      local _hlen = _len / 2;
      local _start_x = _w / 2.0 - ((_size + ICON_OFFSET_X) * _hlen) - _size / 2.0;
      if (_len % 2 == 0) _start_x += (_size + ICON_OFFSET_X) / 2.0;
      foreach (chara_id in _chara_ids) {
        local _chara_setting = ::gamesetting.sanrio_chara_settings[chara_id];
        local _sp = _chara_setting.getIconSprite();
        _sp.bnd.set(0, 0, _size, _size);
        local _img_motion = ::SKImageView(_sp);
        this.pnl_chara_icon.addChild(_img_motion);

        _img_motion.pos.x = _start_x + (_size + ICON_OFFSET_X) * _cnt;

        _img_motion.matdirty = true;
        _img_motion.repaint();

        _cnt++
      }
    }

    if (_rsID == ::TutorialSetting.TUTORIAL_FIRST_ROOM_ID &&
    !::gamesetting.game_rule.disableTutorial() &&
    !_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_FIRST_LOGIN)) {
      this.tutorial_state = 1;
    }

    local _sss = this.shop_setting.getSaleSetting();

    local _check_conditions = ss.checkConditions();
    if (!_check_conditions) {
      this.pnl_nopurchase.visible = true;
      this.img_clear.setVisible(false);
      this.pnl_nopurchase.findChild("lbl_condition").setText(ss.getConditionDesc());
    }

    if (!_isTutorial() && _ud.hasRoomByRoomID(_rsID)) {

      this.lbl_select.setText(::dict.get("room_select"));
      this.pnl_sale.visible = false;
      _hideSaleInfo();
      _setBgImg(BG_IMAGE_DEF);

      local _b = true;
      foreach (pms in ::gamesetting.panel_mission_settings) {
        if (pms.getRoomID() != _rsID) continue;
        local _pmd = _ud.getPanelMissionData(pms.getID());
        if (!_pmd || !_pmd.isReceivedReward()) {
          _b = false;
          break;
        }
      }
      this.img_clear.setVisible(_b);
    }
    else {

      this.btn_dialy.visible = false;

      if (!_sss) {
        this.pnl_sale.visible = false;
      }
      else if (!_check_conditions) {
        this.pnl_sale.visible = false;
      }
      _setupBuyButton(_sss);

      if (_checkTutorialLimit()) {
        this.buy_state = BUY_STATE_TUTORIAL;
      }

      if (!this.shop_setting.checkConditions()) {
        this.buy_state = BUY_STATE_CONDITION;
      }

      this.img_clear.setVisible(false);
    }

    return true;
  }

  function _setBgImg(bg_type) {
    this.img_bg["def"].visible = false;
    this.img_bg["buy"].visible = false;
    this.img_bg["free"].visible = false;
    this.btn_bg["def"].visible = false;
    this.btn_bg["buy"].visible = false;
    this.btn_bg["free"].visible = false;

    switch (bg_type) {
    case BG_IMAGE_DEF:
      this.img_bg["def"].visible = true;
      this.btn_bg["def"].visible = true;
      break;
    case BG_IMAGE_BUY:
      this.img_bg["buy"].visible = true;
      this.btn_bg["buy"].visible = true;
      break;
    case BG_IMAGE_FREE:
      this.img_bg["free"].visible = true;
      this.btn_bg["free"].visible = true;
      break;
    }
  }

  function _setupBuyButton(sale_setting) {
    local _lbl;
    if (sale_setting) {
      if (sale_setting.hasOriginalPrice()) {

        _lbl = this.btn_select.findChild("lbl_sale");
        this.btn_select.findChild("lbl_original").setText(this.shop_setting.getPrice());
        this.lbl_select.visible = false;
      }
      else {

        _hideSaleInfo()
        _lbl = this.lbl_select;
      }
      this.pnl_sale.findChild("lbl_desc").setText(sale_setting.getText());
    }
    else {

      _hideSaleInfo()
      _lbl = this.lbl_select;
    }
    local _price = this.shop_setting.getPrice(true);
    local _txt = "";
    if (_price == 0) {
      _setBgImg(BG_IMAGE_FREE);
      _txt = ::dict.get("purchase_free");
    }
    else if (!::gamesession.isIAPInitializeSuccess() && this.shop_setting.getPriceType() == PRICE_CASH) {
      _setBgImg(BG_IMAGE_BUY);
      _txt = ::dict.get("disable_purchase_error");
    }
    else {
      _setBgImg(BG_IMAGE_BUY);
      _txt = _price;
      if (!sale_setting) _txt + "/n" + ::dict.get("purchase");
    }
    _lbl.setText(_txt);
  }

  function _setSaleInfo(shop_sale_setting) {

    if (shop_sale_setting) {
      local _btn_select = this.btn_select;
      this.lbl_select.visible = false;
      this.lbl_select = _btn_select.findChild("lbl_sale");
      _btn_select.findChild("lbl_original").setText(this.shop_setting.getPrice(true));
      this.pnl_sale.findChild("lbl_desc").setText(shop_sale_setting.getText());
    }
    else {
      _hideSaleInfo();
    }
  }

  function _hideSaleInfo() {
    local _btn_select = this.btn_select;
    _btn_select.findChild("lbl_sale").visible = false;
    _btn_select.findChild("lbl_original").visible = false;
    _btn_select.findChild("img_sale").visible = false;
  }

  function _setPanelMissonName(pmn) {
    if (pmn) {
      this.lbl_title.setText(pmn);
    }
    else {
      this.lbl_story.visible = false;
      this.lbl_title.visible = false;
    }
  }

  function _getFirstPanelMissionName() {
    local _ret = null;
    local _setid = -1;

    local _missions = ::gamesetting.panel_mission_settings;
    local _rid = this.room_setting.getID();
    foreach (ms in _missions) {
      if (!ms) continue;

      local _mid = ms.getID();
      if (ms.getRoomID() == _rid) {
        if (_setid < 0) {
          _ret = ms.getDiaryName();
          _setid = _mid;
        }
        else if (_setid > _mid) {
          _ret = ms.getDiaryName();
          _setid = _mid;
        }
      }
    }
    return _ret;
  }

  function getButtonView() {
    return this.btn_select;
  }

  function _showConfirmDialog() {
    if (!this.shop_setting) return 0;

    local _dlg = SimpleDialog2();
    _dlg.lbl_msg.setText(this.shop_setting.getItemName());
    _dlg.lbl_caution.setText(::dict.get("shop_buy_confirm"));
    if (_isTutorial()) _dlg.btn_cancel.setEnabled(false);
    _dlg.show();
    return _dlg.ret;
  }

  function _showFailDialog() {
    local _dlg = ::SimpleDialog();
    _dlg.lbl_msg.setText(::dict.get("shop_buy_rm_fail"));
    _dlg.show();
  }

  function _showBoughtenDialog() {

    local _lbl_key = ::tutorial_manager.isEndFirstLetterTutorial() ? "room_select" : "ok";

    local _dlg = SimpleDialog4();
    _dlg.lbl_msg.setText(this.shop_setting.getItemName());
    _dlg.lbl_caution.setText(::dict.get("shop_buy_room"));
    _dlg.lbl_ok.setText(::dict.get(_lbl_key));
    _dlg.show();
  }

  function _showBuyStateDialog() {
    local _dlg = ::SimpleDialog();
    _dlg.lbl_msg.setText(getBuyStateMessage(this.buy_state));
    _dlg.show();
  }
  static function getBuyStateMessage(state) {
    switch (state) {
    case ::RoomSelectPanel.RoomItem.BUY_STATE_CONDITION: return ::dict.get("purchase_condition");
    case ::RoomSelectPanel.RoomItem.BUY_STATE_TUTORIAL: return ::dict.get("purchase_tutorial");
    }
    return "";
  }

  function _confirmMoveDialog() {
    if (!this.shop_setting) return 0;

    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(::dict.get("go_other_room", [this.shop_setting.getItemName()]));
    _dlg.lbl_caution.setVisible(false);
    _dlg.show();
    return _dlg.ret;
  }

  function _proc_buy() {

    if (this.buy_state != BUY_STATE_OK) {
      _showBuyStateDialog();
      return false;
    }

    if (!_isTutorial()) {
      if (!::gamesession.unlockRoom(this.shop_setting.getID())) {
        return false;
      }
      ::gamesession.getCurrentScene().getStage().getHouseManager().extendRooms();
      ::gamesession.getUserData().addBonusHapinessNum();
    }
    else {
      sleep(1000);
    }

    _showBoughtenDialog();

    if (_isTutorial()) this.tutorial_state = 3;
    return true;
  }

  function _proc_move(is_new = false) {
    local _scene = ::gamesession.getCurrentScene();
    local _ud = ::gamesession.getUserData();
    if (_scene instanceof ::SanrioGameScene) {
      if (_isTutorial()) {
        if (!_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LETTER_FIRST_MOVE)) {
          _scene.getUI().movePanel(::LetterPanel, false, { "setting" = ::gamesetting.letter_settings[::TutorialSetting.TUTORIAL_LETTER_FIRST_LOGIN] }, _getTrans());
        }
        else {
          _scene.getUI().movePanel(::HomeTopPanel, false, null, _getTrans());
        }
      }
      else {
        local _idx = _ud.getRoomIndexByRoomID(this.room_setting.getID());

        _scene.selectRoom(_idx, true);
        if (!is_new || !this.room_setting.hasFirstDiaryID()) {
          _scene.getUI().movePanel(::HomeTopPanel, false, null, _getTrans());
        } else {
          ::event_manager.startEventSceneDiary(this.room_setting.getFirstDiaryID(), null, null, null, false);
        }

        ::gamesetting.createShopPriceTables();
        local _shop_check_mrg = _scene.getUI().getShopCheckManager();
        _shop_check_mrg.setupShopCheckManager();
      }
    }
  }

  function _getTrans() {
    return MaskPanelTransition(::getTexture(::getLoadImagePath()), ::getTexture("/image/black.jpg"), 5.0, 50);;
  }

  function _isTutorial() {
    return this.tutorial_state > 0 ? true : false;
  }

  function getTutorialState() {
    return this.tutorial_state;
  }

  function _checkTutorialLimit() {
    if (::gamesetting.game_rule.disableTutorial()) return false;
    local _tid = TutorialSetting.TUTORIAL_LIMIT_BUY_NEXT_ROOM;
    if (_tid < 0 || ::gamesession.getUserData().isEndTutorialId(_tid)) return false;
    if (this.room_setting.getID() == ::TutorialSetting.TUTORIAL_ROOM_ID) return false;
    return true;
  }

  function actionevent_detail(e) {
    e.consume();

    if (!this.detail_item_table) {
      this.detail_item_table = { pmid = -1, cos_list = [], fur_list = [], orn_list = [], mot_list = [] };

      foreach (setting in ::gamesetting.panel_mission_settings) {
        if (this.room_setting.getID() != setting.getRoomID()) continue;

        if (this.detail_item_table.pmid < 0) {
          this.detail_item_table.pmid = setting.getID();
        } else {
          local _pms = ::gamesetting.panel_mission_settings[this.detail_item_table.pmid];
          if (_pms.getPriority() < setting.getPriority()) this.detail_item_table.pmid = setting.getID();
        }
      }

      foreach (setting in ::gamesetting.shop_setting_table[SHOP_ITEM_TYPE_COSTUME]) {
        if (this.room_setting.getID() != setting.getRoomID()) continue;
        this.detail_item_table.cos_list + setting.getItemID();
      }

      foreach (setting in ::gamesetting.shop_setting_table[SHOP_ITEM_TYPE_FURNITURE]) {
        if (this.room_setting.getID() != setting.getRoomID()) continue;

        local _fs = ::gamesetting.furniture_settings[setting.getItemID()];
        if (_fs.isProductionize()) {
          this.detail_item_table.fur_list + setting.getItemID();
        } else {
          this.detail_item_table.orn_list + setting.getItemID();
        }
      }

      foreach (setting in ::gamesetting.shop_setting_table[SHOP_ITEM_TYPE_MOTION]) {
        if (this.room_setting.getID() != setting.getRoomID()) continue;
        this.detail_item_table.mot_list + setting.getItemID();
      }
    }

    local _dlg = ::RoomDetailDialog();
    _dlg.setScroll(this.room_setting.getID(), this.detail_item_table.pmid, this.detail_item_table.cos_list, this.detail_item_table.fur_list, this.detail_item_table.orn_list, this.detail_item_table.mot_list);
    _dlg.show();
  }

  function actionevent_dialy(e) {
    e.consume();
    this.pnl_parent.getHomeUI().movePanel(::PanelMissionPanel, false, { room_id = this.room_setting.getID() })
  }

  function actionevent_select(e) {
    e.consume();
    if (this.pnl_parent.select_tap_lock) return;
    if (!this.room_setting || !this.shop_setting) return;

    this.pnl_parent.select_tap_lock = true;

    local _ud = ::gamesession.getUserData();
    local _is_bought = false;

    if (_isTutorial()) {

      if (this.buy_state == BUY_STATE_OK) this.tutorial_state = 2;
      if (!_proc_buy()) {
        this.pnl_parent.select_tap_lock = false;
        return;
      }

      _proc_move(_is_bought);
    }
    else if (_ud.hasRoomByRoomID(this.room_setting.getID())) {

      if (!_confirmMoveDialog()) {
        this.pnl_parent.select_tap_lock = false;
        return;
      }

      _proc_move(_is_bought);
    }
    else {

      if (this.shop_setting.getPriceType() == PRICE_CASH) {

        if (!::gamesession.isIAPInitializeSuccess()) {
          local _dlg = ::IAPCautionDialog();
          _dlg.show();

          return;
        }

        ::gamesession.getCurrentScene().setEnabled(false);
        try {

          ::gamesession.purchaseRMItem(this, this.shop_setting, buyRoomCallback);
        }

        catch (ex) {
          printexception(ex);
          sendException(ex, "error in purchase room ....");

          local _dlg = SimpleDialog3();
          _dlg.lbl_msg.setText(this.shop_setting.getItemName());
          _dlg.lbl_caution.setText(::dict.get("shop_buy_rm_failure"));
          _dlg.show();

          ::gamesession.getCurrentScene().setEnabled(true);
        }
      }
      else {

        if (!_proc_buy()) {
          this.pnl_parent.select_tap_lock = false;
          return;
        }
        _is_bought = true;

        _proc_move(_is_bought);
      }
    }
  }

  function buyRoomCallback(info, pnl, ss) {
    local _ud = ::gamesession.getUserData();
    _ud.addRealMoney(info.add_rm);
    _ud.addFreeRealMoney(info.bonus_rm);

    if (info.purchase_result) {
      if (info.server_result) {

        ::gamesession.getCurrentScene().getStage().getHouseManager().extendRooms();
        _ud.addBonusHapinessNum();

        pnl._showBoughtenDialog();
        ::gamesession.getCurrentScene().setEnabled(true);

        ::gamesession.appsflyer.purchase(ss.getIapPriceValue());

        pnl._proc_move(true);

        return;
      }

      else {
        local _dlg = SimpleDialog();
        _dlg.lbl_msg.setText(::dict.get("shop_buy_rm_failure"));
        _dlg.show();

        pnl.pnl_parent.select_tap_lock = false;
      }
    }

    else {
      local _dlg = SimpleDialog3();
      _dlg.lbl_msg.setText(ss.getItemName());
      _dlg.lbl_caution.setText(::dict.get("shop_buy_rm_cancel"));
      _dlg.show();

      pnl.pnl_parent.select_tap_lock = false;
    }

    ::gamesession.getCurrentScene().setEnabled(true);
  }
}