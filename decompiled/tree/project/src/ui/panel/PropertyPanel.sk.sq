class PropertyPanel.TargetListDialog.ConfirmUseShortenDialog extends ItemListPanel.TargetListDialog.ConfirmUseItemDialog {
  data = null;

  lbl_name = null;
  img_icon = null;

  lbl_remain = null;
  lbl_remain_new = null;

  constructor(item_id, target, target_id) {
    super(::loadSKView("/ui/dialog/ConfirmUseItemShortenDialog.ui"), item_id);

    this.target = target;
    this.target_id = target_id;

    this.lbl_name = this.view.findChild("lbl_target_name");
    this.lbl_remain = this.view.findChild("lbl_remain_now");
    this.lbl_remain_new = this.view.findChild("lbl_remain_new");

    local now = ::getServerTime();
    local shorten = this.item_setting.getTimeSec();
    local remain = 0;
    local remain_new = 0;

    local _pnl_icon = this.view.findChild("img_icon_target");
    local _sp = null;

    local ud = ::gamesession.getUserData();
    if (target == ITEM_TYPE_COSTUME) {
      this.data = ud.getCostumeData(target_id);
      this.lbl_name.setText(this.data.getName());
      _sp = ::getSprite(this.data.getSetting().getCostumeIconPath());

      local wd = this.data.getWorkData();
      remain = wd.getRemainingTime(now);
      remain_new = wd.getRemainingTime(now + shorten);
    } else if (target == ITEM_TYPE_FURNITURE) {
      this.data = ud.getFurnitureData(target_id);
      this.lbl_name.setText(this.data.getCurrentName());
      _sp = ::getSprite(this.data.getCurrentIconPath());

      local pd = this.data.getProductData();
      remain = pd.getRemainTime(now);
      remain_new = pd.getRemainTime(now + shorten);
    }
    _sp.blend = SK_MIX;
    this.img_icon = SKImageView();
    this.img_icon.setSprite(_sp);
    this.img_icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(this.img_icon);

    local tl_now = ::TimeLabel(lbl_remain, remain);
    tl_now.setEndFunc(setFinishTextAtNow.bindenv(this));
    tl_now.startCountDown();
    local tl_new = ::TimeLabel(lbl_remain_new, remain_new);
    tl_new.setEndFunc(setFinishTextAtNew.bindenv(this));
    tl_new.startCountDown();
  }

  function actionevent(e) {
    super.actionevent(e);

    if (ret > 0) {
      local res = ::gamesession.useOnceItem(this.item_setting.id, this.target, this.target_id);

      if (res.ret == ::ServletConstants.RESPONSE_SUCCEED) {
        if (this.target == ITEM_TYPE_COSTUME) {
          this.data.getWorkData().start_time -= this.item_setting.getTimeSec();
        } else if (this.target == ITEM_TYPE_FURNITURE) {
          this.data.getProductData().start_time -= this.item_setting.getTimeSec();
        }
        ::gamesession.getUserData().addItem(this.item_setting.id, -1);
      }
    }
  }

  function setFinishTextAtNow() {
    this.lbl_remain.setText(::dict.get("product_finished"));
  }
  function setFinishTextAtNew() {
    this.lbl_remain_new.setText(::dict.get("product_finished"));
  }
}

