class TalkViewPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;

  static need_camera = false;
  static need_camera_rotate = false;
  static need_camera_default = false;

  static need_menu_layer = false;
  static need_search_layer = false;

  static need_panel_name = false;
  static need_camera_record = false;

  static need_history_clear = true;

  static TEST_VISIBLE_FLAG = false;

  static unique_move_sound = "";
  static unique_bgm = "none";

  talksystem = TalkSystem();
  talk_view = null;

  baseview = null;
  pnl_view = null;
  btn_skip = null;
  skip_enable = true;
  btn_backlog = null;

  talkwindow_layer = null;

  ks_list = null;
  cos_id_list = null;
  motion_id_list = null;

  is_capturing = false;
  img_capturing = null;
  btn_capture = null;

  function added() {
    super.added();

    this.talksystem.scriptdirs = [::getResource("/talk")];
    this.talksystem.viewdirs = [::getResource("/talk/img")];

    this.baseview = ::loadSKView("/ui/TalkViewPanel.ui");
    addChild(this.baseview);

    getHomeUI().updateCameraButtonVisible();
    getHomeUI().setVisibleScreenshotButton(false);
    this.btn_capture = this.baseview.findChild("btn_capture");
    if (::tutorial_manager.isUnlockCamera()) {
      local _tap_button = ::TapButton(this.btn_capture);
      _tap_button.setTappedSE(SoundConstants.SOUND_CAMERA_SHUTTER);
      _tap_button.view.addEventListener(ACTION_EVENT, actionevent_screen_shot);
    }
    else {
      this.btn_capture.visible = false;
    }
    this.img_capturing = this.baseview.findChild("img_capturing");
    this.img_capturing.visible = false;

    this.pnl_view = this.baseview.findChild("pnl_view");
    this.btn_skip = this.baseview.findChild("btn_skip");

    if (this.skip_enable) {
      ::TapButton(this.btn_skip).view.addEventListener(ACTION_EVENT, actionevent_skip);
    }
    else {
      setVisibleSkip(false);
    }

    this.btn_backlog = this.baseview.findChild("btn_backlog");
    this.btn_backlog.findChild("lbl_backlog").setText(::dict.get("backlog"));
    ::TapButton(this.btn_backlog).view.addEventListener(ACTION_EVENT, actionevent_backlog);

    local stage = getHomeUI().getGameScene().stage;
    stage.setCameraDefault(true, false);
    this.talk_view = ::SanrioTalkView(talksystem, stage);
    this.talk_view.jumpscript("define.ks", null, true);
    this.talk_view.runscript();
    this.pnl_view.addChild(this.talk_view);

    local pnl_talkwindow_layer = this.baseview.findChild("pnl_talkwindow_layer");
    pnl_talkwindow_layer.pickable = false;
    this.talkwindow_layer = TalkWindowLayer(pnl_talkwindow_layer);
    this.talkwindow_layer.setOffset(0, 2.0, 0)

    if (TEST_VISIBLE_FLAG) {
      getHomeUI().btn_screen_shot.visible = false;
      getHomeUI().btn_ar.visible = false;
      this.btn_backlog.visible = false;
      btn_skip.visible = false;
    }
  }

  function removed() {
    super.removed();

    this.pnl_view.removeChild(this.talk_view);

    this.baseview = null;
    this.pnl_view = null;
    this.talk_view = null;
  }

  function setDiaryID(id) {
    if (this.talk_view) this.talk_view.setDiaryId(id);
  }

  function setPanelMask(mask) {
    if (this.talk_view) this.talk_view.setPanelMask(mask);
  }

  function setVisibleSkip(b) {
    if (TEST_VISIBLE_FLAG) return;
    this.btn_skip.setVisible(b);
  }

  function setPanelParam(param) {
    if ("skip_enable" in param) this.skip_enable = param.skip_enable;
  }

  function startTalk(ks, cos_id = -1) {
    ::gamesession.clearBackLog();
    this.talk_view.setMainCostume(cos_id);
    this.talk_view.jumpscript(ks, null, true);
    local talkthread = newthread();
    talkthread.start(
    function() {
      try {
        this.talk_view.runscript();
      } catch (ex) {
        printexception(ex);
        sendException(ex, "error in talk....");
      }
      _endEventSceneFunc();
      this.talk_view.destructor();
      _talkFinished();
    }, this);
  }

  function startTalks(ks_list, cos_id_list = null, motion_id_list = null) {
    this.ks_list = ks_list;
    this.cos_id_list = cos_id_list;
    this.motion_id_list = motion_id_list;

    local talkthread = newthread();
    talkthread.start(
    function() {
      foreach (idx, ks in this.ks_list) {
        this.talk_view.setInvisibleModels();

        local cos_id = this.cos_id_list[idx] || null;
        if (cos_id) this.talk_view.setMainCostume(cos_id);

        local mid = this.motion_id_list[idx] || null;
        if (mid) this.talk_view.setCharaMotionId(mid);

        this.talk_view.jumpscript(ks, null, true);

        try {
          this.talk_view.runscript();
        } catch (ex) {
          printexception(ex);
          sendException(ex, "error in talk....");
        }
        _endEventSceneFunc();
      }
      this.talk_view.destructor();
      _talkFinished();
      this.ks_list = null;
      this.cos_id_list = null;
    }, this)
  }

  function _talkFinished() {

    event_manager.endEventScene();
  }

  function actionevent_skip(e) {
    e.consume();
    this.talk_view.stopscript();
    ::gamesession.clearBackLog();
  }

  function actionevent_backlog(e) {
    e.consume();
    ::gamesession.showBackLog();
  }

  function actionevent_screen_shot(e) {
    e.consume();

    execScreenShot();
  }

  function execScreenShot() {
    if (this.is_capturing) return;

    this.is_capturing = true;
    this.img_capturing.visible = true;
    this.btn_capture.visible = false;
    this.startMethod("capturing");

    newthread().start(function() {
      local _flash = ::SKImageView();
      local _sp = _flash.sp;
      _sp.color = 0xffffffff;
      _sp.blend = SK_MIX;
      _flash.setRect(0.0, 0.0, this.bnd.w, this.bnd.h);
      addChild(_flash);
      local _frames = 30;
      local fdiv = 1.0 / float(_frames - 1);
      for (local l = _frames - 1; l >= 0; l--) {
        local a = ((l * fdiv) * 255.0);
        _sp.color = (_sp.color & 0xffffff00) | a;
        _flash.repaint();
        sleep(16);
      }
      this.removeChild(_flash);
      this.btn_capture.pickable = true;
      this.is_capturing = false;
    }, this);

    getHomeUI().captureScreen(this.btn_capture, this.img_capturing);
    skCollectGarbage();
  }

  function _endEventSceneFunc() {
    ::stopBGM();
    newthread().start(function() {
      local _tex = runsk("/dl/loadingbg/download.sk");
      local _trans = MaskPanelTransition(_tex, ::getTexture("/image/rule/gacha.jpg"), 5.0, 50);
      _trans.sleeptime = 1000;
      _trans.rePerformance();
    }, this)

    event_manager.endEventSceneFunc();
    sleep(1000);
  }

  function getTalkView() {
    return this.talk_view;
  }

  function addTalkWindow(sk3d, talk_key, chara_key, big = false, small = false) {
    this.talkwindow_layer.addTalk(sk3d, talk_key, chara_key);
  }
  function removeAllTalkWindow() {
    this.talkwindow_layer.removeAllTalkWindow();
  }
}