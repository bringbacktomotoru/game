class ItemListPanel extends ::HomeUI.Panel {

  reclist = null;
  scroll = null;
  item_list = null;

  dlg = null

  view = null;
  pnl_list = null;

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/ItemListPanel.ui");
    addChild(this.view);

    local _btn_back = this.view.findChild("btn_back");
    ::TapButton(_btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    local _btn_change = this.view.findChild("btn_performance");
    ::TapButton(_btn_change).view.addEventListener(ACTION_EVENT, actionevent_change);

    this.pnl_list = this.view.findChild("pnl_item_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dxscale = 0.0;
    this.pnl_list.addChild(this.reclist);
    this.pnl_list.setBuffer(true);

    _createItemIconList();
  }

  function _createItemIconList() {
    this.reclist.clearChildren();
    this.item_list = [];

    local items = ::gamesession.getUserData().getItems();

    local offset = 0;
    local cnt = 0;

    foreach (setting_id, nums in items) {
      if (nums <= 0) continue;

      local item = ItemCard(setting_id, nums, tappedItemCard.bindenv(this));

      if (cnt == 3) {
        cnt = 0;
        offset += item.bnd.h + 10;
      }

      item.pos.x = (item.bnd.w + 10) * cnt;
      item.pos.y = offset;
      this.reclist.addChild(item);

      this.item_list + item;
      cnt++;
    }

    if (this.item_list.len() > 0) offset += this.item_list[0].bnd.h;

    this.reclist.setRect(0, 0, this.pnl_list.bnd.w, offset);
    this.scroll.setScrollRect(this.reclist.bnd);

    local _scroll_bar = ::ScrollBarV(this.view.findChild("pnl_scroll_bar"));
    _scroll_bar.setup(this.scroll, this.pnl_list.bnd, false);
  }

  function tappedItemCard(id) {
    if (this.dlg) return;

    local setting = ::gamesetting.item_settings[id];

    switch (setting.kind) {
    case ItemSetting.SHORTEN_TIME:
    case ItemSetting.ADD:
      this.dlg = TargetListDialog(id, this);
      break;
    case ItemSetting.BOOST:
      this.dlg = ConfirmUseItemBoostDialog(id);
      break;
    }
    this.dlg.show();

    while (!this.dlg.isClosing()) {
      suspend();
    }

    if (this.dlg.ret > 0) updateItemNums(id);

    this.dlg = null;
  }

  function updateItemNums(item_id) {
    foreach (idx, card in this.item_list) {
      if (card.id == item_id) {
        card.updateItemNums();
        break;
      }
    }
  }

  function actionevent_back(e) {
    e.consume();
    getHomeUI().movePanel(::HomeTopPanel);
  }
  function actionevent_change(e) {
    e.consume();
  }
}

class ItemListPanel.ItemCard extends SKView {
  func = null;
  id = null;

  view = null;
  lbl_name = null;
  lbl_nums = null;
  img_icon = null;

  constructor(item_id, nums, func) {
    this.func = func;
    this.id = item_id;

    this.view = ::loadSKView("/ui/common/UseItemCard.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    local _btn = this.view.findChild("btn");
    ::TapButton(_btn, false).region.addEventListener(ACTION_EVENT, actionevent);

    this.lbl_name = _btn.findChild("lbl_name");
    this.lbl_nums = _btn.findChild("pnl_nums").findChild("lbl_nums");

    local setting = ::gamesetting.item_settings[item_id];
    this.lbl_name.setText(setting.name);
    this.lbl_nums.setText(::dict.get("nums_amount", [::formatNumberString(nums)]));

    local _pnl_item_icon = _btn.findChild("pnl_icon");
    local _sp = ::getSprite(setting.getIconPath());
    _sp.blend = SK_MIX;

    this.img_icon = SKImageView();
    this.img_icon.setSprite(_sp);
    this.img_icon.setRect(0, 0, _pnl_item_icon.bnd.w, _pnl_item_icon.bnd.h);
    _pnl_item_icon.addChild(this.img_icon);
  }

  function updateItemNums() {
    local nums = ::gamesession.getUserData().getItemNums(this.id);
    this.lbl_nums.setText(::dict.get("nums_amount", [::formatNumberString(nums)]));
  }

  function actionevent(e) {
    e.consume();
    func(this.id);
  }
}

class ItemListPanel.ConfirmUseItemBoostDialog extends ::Dialog {
  item_setting = null;
  overlap = null;

  view = null;
  lbl_name = null;
  lbl_desc = null;
  img_icon = null;

  constructor(item_id) {
    super(::loadSKView("/ui/dialog/ConfirmUseItemBoostDialog.ui"));

    this.item_setting = ::gamesetting.item_settings[item_id];

    this.lbl_name = this.view.findChild("lbl_item_name");
    this.lbl_name.setText(item_setting.name);
    this.lbl_desc = this.view.findChild("lbl_desc");
    this.lbl_desc.setText(this.item_setting.desc);

    local _pnl_item_icon = this.view.findChild("img_icon_item");
    local _sp = ::getSprite(this.item_setting.getIconPath());
    _sp.blend = SK_MIX;

    this.img_icon = SKImageView();
    this.img_icon.setSprite(_sp);
    this.img_icon.setRect(0, 0, _pnl_item_icon.bnd.w, _pnl_item_icon.bnd.h);

    _pnl_item_icon.addChild(this.img_icon);

    local ud = ::gamesession.getUserData();
    local lbl_nums = this.view.findChild("lbl_nums");
    lbl_nums.setText(::dict.get("nums_amount", [ud.getItemNums(item_id)]));

    local boost_data = ud.getItemBoostData(this.item_setting.slot);
    this.overlap = boost_data ? true : false;

    local lbl_error = this.view.findChild("lbl_error");
    local lbl_remain = this.view.findChild("lbl_remain");

    if (this.overlap) {
      lbl_error.visible = true;
      lbl_remain.visible = true;
      this.view.findChild("lbl_remain_text").visible = true;

      switch (this.item_setting.slot) {
      case ItemSetting.SLOT_WORK:
        lbl_error.setText(::dict.get("useitem_unable_boost_work"));
        break;
      case ItemSetting.SLOT_PRODUCT:
        lbl_error.setText(::dict.get("useitem_unable_boost_product"));
        break;
      }

      switch (this.item_setting.type) {
      case ItemSetting.TYPE_PERIOD:
        local now = ::getServerTime();
        local tl = ::TimeLabel(lbl_remain, boost_data.getRemainTime(now));
        tl.startCountDown();
        break;
      case ItemSetting.TYPE_COUNT:
        lbl_remain.setText(::dict.get("nums_count", [boost_data.getRemainCount()]));
        break;
      }
    } else {
      lbl_error.visible = false;
      lbl_remain.visible = false;
      this.view.findChild("lbl_remain_text").visible = false;
    }

  }

  function actionevent(e) {
    super.actionevent(e);

    if (ret > 0) {

      local res = ::gamesession.useBoostItem(this.item_setting.id);
      if (res.ret == ::ServletConstants.RESPONSE_SUCCEED) {
        local ud = ::gamesession.getUserData();
        ud.useBoostItem(this.item_setting.id);
      }

    }
  }
}

class ItemListPanel.TargetListDialog extends ::Dialog {
  parent_panel = null;
  item_setting = null;

  tab = null;

  reclist = null;
  scroll = null;
  target_list = null;

  view = null;
  lbl_title = null;
  pnl_list = null;

  constructor(item_id, parent_panel) {
    super(::loadSKView("/ui/dialog/UseItemTargetListDialog.ui"));

    this.parent_panel = parent_panel;
    this.item_setting = ::gamesetting.item_settings[item_id];

    this.lbl_title = this.view.findChild("lbl_title");
    this.lbl_title.setText(::dict.get("useitem_select_target"));

    this.pnl_list = this.view.findChild("pnl_item_list");

    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dxscale = 0.0;
    this.pnl_list.addChild(this.reclist);
    this.pnl_list.setBuffer(true);

    _createIconList();
  }

  function _createIconList() {
    this.reclist.clearChildren();
    this.target_list = [];

    local offset = 0;
    local cnt = 0;

    local data_table = _getDataTable();

    foreach (type, id_list in data_table) {
      foreach (idx, id in id_list) {
        local item = TargetCard(this.item_setting.kind, type, id, showDialog.bindenv(this));

        if (cnt == 3) {
          cnt = 0;
          offset += item.bnd.h + 10;
        }

        item.pos.x = (item.bnd.w + 10) * cnt;
        item.pos.y = offset;
        this.reclist.addChild(item);

        this.target_list + item;
        cnt++;
      }
    }

    if (this.target_list.len() > 0) offset += this.target_list[0].bnd.h;

    this.reclist.setRect(0, 0, this.pnl_list.bnd.w, offset);
    this.scroll.setScrollRect(this.reclist.bnd);
  }

  function _getDataTable() {
    local table = {};
    foreach (idx, target_type in this.item_setting.targets) {
      table[target_type] <- [];
    }

    local ud = ::gamesession.getUserData();

    switch (this.item_setting.kind) {
    case ItemSetting.SHORTEN_TIME:
      foreach (idx, target in this.item_setting.targets) {
        if (target == ITEM_TYPE_COSTUME) {
          foreach (id, cd in ud.getCostumeDataTable()) {
            if (!cd.hasWorkData()) continue;
            table[target] + id;
          }
        } else if (target == ITEM_TYPE_FURNITURE) {
          foreach (uid, fd in ud.getFurnitureDataTable()) {
            if (!fd.hasProductData()) continue;
            table[target] + uid;
          }
        }
      }

      break;
    case ItemSetting.ADD:
      foreach (idx, target in this.item_setting.targets) {
        if (target == ITEM_TYPE_COSTUME_EXP || target == ITEM_TYPE_HEALTH) {
          foreach (id, cd in ud.getCostumeDataTable()) {
            table[target] + id;
          }
        } else if (target == ITEM_TYPE_FURNITURE_EXP) {
          foreach (uid, fd in ud.getFurnitureDataTable()) {
            if (!fd.hasProductID()) continue;
            table[target] + uid;
          }
        } else if (target == ITEM_TYPE_ROOM_EXP) {
          foreach (uid, rd in ud.getRoomEditDataTable()) {
            table[target] + uid;
          }
        }
      }
      break;
    }

    return table;
  }

  function showDialog(target_card) {
    local target_id = target_card.id;
    local kind = target_card.kind;
    local type = target_card.type;

    local dlg = null;
    if (kind == ::ItemSetting.SHORTEN_TIME) {
      dlg = ConfirmUseShortenDialog(this.item_setting.id, type, target_id);
    } else {
      switch (type) {
      case ITEM_TYPE_HEALTH:
        dlg = ConfirmUseAddHealthDialog(this.item_setting.id, type, target_id);
        break;
      case ITEM_TYPE_COSTUME_EXP:
      case ITEM_TYPE_FURNITURE_EXP:
      case ITEM_TYPE_ROOM_EXP:
        dlg = ConfirmUseAddExpDialog(this.item_setting.id, type, target_id);
        break;
      }
    }
    dlg.show();
    while (!dlg.isClosing()) {
      suspend();
    }
    if (dlg.ret > 0) {
      this.parent_panel.updateItemNums(this.item_setting.id);
      target_card.updateInfo();
    }
  }
}

class ItemListPanel.TargetListDialog.TargetCard extends SKView {
  kind = null;
  type = null;
  id = null;

  useable = null;
  timelabel = null;

  func = null;

  view = null;
  img_bg = null;
  lbl_name = null;
  lbl_error = null;
  pnl_exp = null;
  pnl_health = null;
  pnl_time = null;
  img_icon = null;

  constructor(kind, type, id, func) {
    this.view = ::loadSKView("/ui/common/UseItemTargetCard.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    local _btn = this.view.findChild("btn");
    ::TapButton(_btn, false).region.addEventListener(ACTION_EVENT, actionevent);

    this.img_bg = _btn.findChild("img_bg");

    this.lbl_name = _btn.findChild("lbl_name");
    this.lbl_error = _btn.findChild("lbl_msg_error");

    this.pnl_exp = _btn.findChild("pnl_exp");
    this.pnl_health = _btn.findChild("pnl_health");
    this.pnl_time = _btn.findChild("pnl_time");

    this.kind = kind;
    this.type = type;
    this.id = id;
    this.func = func;

    this.useable = true;
    this.timelabel = null;

    local ud = ::gamesession.getUserData();
    local _sp = null;

    switch (type) {
    case ITEM_TYPE_COSTUME:
    case ITEM_TYPE_COSTUME_EXP:
    case ITEM_TYPE_HEALTH:
      local cd = ud.getCostumeData(id);
      _sp = ::getSprite(cd.getSetting().getCostumeIconPath());

      break;
    case ITEM_TYPE_FURNITURE:
    case ITEM_TYPE_FURNITURE_EXP:
      local fd = ud.getFurnitureData(id);
      _sp = ::getSprite(fd.getCurrentIconPath());

      break;
    case ITEM_TYPE_ROOM_EXP:
      break;
    }
    _sp.blend = SK_MIX;

    local _pnl_icon = _btn.findChild("pnl_icon");
    this.img_icon = SKImageView();
    this.img_icon.setSprite(_sp);
    this.img_icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(this.img_icon);

    updateInfo();
  }

  function updateInfo() {
    local ud = ::gamesession.getUserData();

    if (this.kind == ::ItemSetting.SHORTEN_TIME) {
      this.pnl_time.visible = true;
      this.pnl_exp.visible = false;
      this.pnl_health.visible = false;

      this.lbl_error.setText(::dict.get("useitem_unable_shorten"));

      local lbl_time = this.pnl_time.findChild("lbl_time");

      local now = ::getServerTime()
      local remain = 0;

      switch (this.type) {
      case ITEM_TYPE_COSTUME:
        local cd = ud.getCostumeData(this.id);
        local wd = cd.getWorkData();

        this.lbl_name.setText(cd.getName());
        remain = wd.getRemainingTime(now);
        if (!wd.isWorking() || remain <= 0) {
          this.useable = false;
        } else {
          this.useable = true;
        }
        break;
      case ITEM_TYPE_FURNITURE:
        local fd = ud.getFurnitureData(id);
        local pd = fd.getProductData();

        this.lbl_name.setText(fd.getCurrentName());
        remain = pd.getRemainTime(now);
        if (pd.isFinishedAtState() || remain <= 0) {
          this.useable = false;
        } else {
          this.useable = true;
        }
        break;
      }

      if (this.useable) {
        if (!this.timelabel) this.timelabel = ::TimeLabel(lbl_time, 0);
        this.timelabel.setRemainTime(remain);
        this.timelabel.startCountDown();

        this.useable = true;
      } else {
        if (this.timelabel) {
          this.timelabel.stopCountDown();
          this.timelabel = null;
        }
        this.useable = false;
        lbl_time.setText(::dict.get("product_finished"));
      }

    } else {
      if (this.type == ITEM_TYPE_HEALTH) {
        this.pnl_health.visible = true;
        this.pnl_time.visible = false;
        this.pnl_exp.visible = false;

        this.lbl_error.setText(::dict.get("useitem_unable_health"));

        local cd = ud.getCostumeData(id);
        local max = cd.getMaxHealth();
        local now = cd.getHealth(false);

        this.lbl_name.setText(cd.getName());
        local lbl_health = this.pnl_health.findChild("lbl_health");
        lbl_health.setText(::dict.get("nums_slash", [now, max]));
        this.useable = now < max ? true : false;

      } else {
        this.pnl_exp.visible = true;
        this.pnl_health.visible = false;
        this.pnl_time.visible = false;

        this.lbl_error.setText(::dict.get("useitem_unable_exp"));

        local lbl_exp = this.pnl_exp.findChild("lbl_exp");
        local max = 0;
        local now = 0;

        switch (this.type) {
        case ITEM_TYPE_COSTUME_EXP:
          local cd = ud.getCostumeData(id);
          max = cd.getMaxExp();
          now = cd.getExp();
          this.lbl_name.setText(cd.getName());

          break;
        case ITEM_TYPE_FURNITURE_EXP:
          local fd = ud.getFurnitureData(id);

          max = fd.getMaxExp();
          now = fd.getExp();
          this.lbl_name.setText(fd.getCurrentName());
          break;
        case ITEM_TYPE_ROOM_EXP:
          local rd = ud.getRoomEditData(id);
          max = rd.getMaxExp();
          now = rd.getExp();
          break;
        }
        lbl_exp.setText(::dict.get("nums_slash", [now, max]));
        this.useable = now < max ? true : false;
      }
    }
    this.img_bg.setDisableColor(!this.useable);
  }

  function actionevent(e) {
    e.consume();

    if (this.useable) {
      func(this);
    } else {
      startMethod(shorErrorMessage.bindenv(this));
    }
  }

  function shorErrorMessage() {
    this.lbl_error.anime(5, 5, 0);
    sleep(1000);
    this.lbl_error.anime(5, 0, 20);
  }
}

class ItemListPanel.TargetListDialog.ConfirmUseItemDialog extends ::Dialog {
  target = null;
  target_id = null;
  item_setting = null;

  view = null;
  lbl_item_name = null;
