class CharaListPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;

  static SPACE_X = 5;
  static SPACE_Y = 10;

  view = null;
  pnl_list = null;
  reclist = null;
  scroll = null;
  chara_list = null;

  scroll_bar = null;

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/CharaListPanel.ui");
    addChild(this.view);

    this.chara_list = [];
    this.pnl_list = this.view.findChild("pnl_item_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.pnl_list.addChild(this.reclist);
    this.pnl_list.setBuffer(true);

    this.scroll_bar = ::ScrollBarH(this.view.findChild("pnl_scroll_bar"));

    local _btn_back = this.view.findChild("btn_back");
    ::TapButton(_btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    _initCharaList();
  }

  function _initCharaList() {
    local _ud = ::gamesession.getUserData();
    local _chara_list = ::gamesetting.sanrio_chara_settings;
    this.reclist.clearChildren();

    local _cnt = 0;
    local _offset = 0;
    local _size_x = 0;

    foreach (chara in _chara_list) {
      local _card = CharaCard(this, chara, _ud.getCharacterData(chara.getID()), _cnt);
      if (_cnt > 0 && _cnt % 2 == 0) _offset += _card.bnd.w + SPACE_X;

      _card.pos.x = _offset;
      _size_x = _card.bnd.h;
      _card.pos.y = (_cnt % 2) * (_size_x + SPACE_Y);
      this.reclist.addChild(_card);
      _card.matdirty = true;
      _card.repaint();

      this.chara_list + _card;
      _cnt++;

    }

    _offset += _size_x;
    this.reclist.setRect(0, 0, _offset, this.pnl_list.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);

    this.scroll_bar.setup(this.scroll, this.pnl_list.bnd, true);

    newthread().start(_setupCardViews, this);
  }

  function _setupCardViews() {
    local t = skGetTime();
    foreach (card in chara_list) {
      card.setupViews();

      local t2 = skGetTime();
      if (t + 16 < t2) {
        t = t2;
        suspend();
      }
    }
  }

  function show() {
    this.view.startMethod("show");
    while (this.view.isMethodRunning()) { suspend(); }
  }

  function actionevent_back(e) {
    e.consume();
    getHomeUI().backPanel();
  }
}

class CharaListPanel.CharaCard extends SKView {
  view = null;
  pnl_parent = null;
  pnl_icon = null;

  setting = null;
  data = null;

  constructor(p, cs, cd, idx) {
    this.pnl_parent = p;
    this.setting = cs;
    this.data = cd;

    this.view = ::loadSKView("/ui/common/CharaCard.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    local _btn_chara = this.view.findChild("btn_chara");
    if (this.data) ::TapButton(_btn_chara, false).view.addEventListener(ACTION_EVENT, actionevent_select);

    this.pnl_icon = _btn_chara.findChild("pnl_icon");
    this.view.findChild("pink_line_under").visible = (idx % 2 == 0);

    local _lbl_name = _btn_chara.findChild("lbl_name");
    _lbl_name.setText(this.setting.getName());

    local _lbl_level = _btn_chara.findChild("lbl_level");
    if (this.data) {

      _lbl_level.visible = false;
    }
    else {
      _lbl_level.setText(::dict.get("not_possession"));
    }
  }

  function setupViews() {

    this.pnl_icon.clearChildren();
    local _sp = this.setting.getIconSprite();
    _sp.bnd.set(0, 0, this.pnl_icon.bnd.w, this.pnl_icon.bnd.h);
    this.pnl_icon.addChild(::SKImageView(_sp));
  }

  function actionevent_select(e) {
    e.consume();

    if (!this.data) return;
    this.pnl_parent.getHomeUI().movePanel(::CharaProfilePanel, false, { "setting" = this.setting });
  }
}