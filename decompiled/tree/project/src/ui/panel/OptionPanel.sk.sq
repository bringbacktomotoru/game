class OptionPanel extends ::HomeUI.Panel {
  static need_camera = false;

  static history_clear = true;

  baseview = null;

  btn_announce = null;
  btn_contact = null;
  btn_setting = null;
  btn_tos = null;
  btn_takeover = null;
  btn_title = null;

  function added() {
    super.added();

    this.baseview = loadCocos("/ui/OptionPanel.json");
    addChild(baseview);

    ::TapButton(this.baseview.findChild("btn_announce")).view.addEventListener(ACTION_EVENT, actionevent_announce);
    ::TapButton(this.baseview.findChild("btn_contact")).view.addEventListener(ACTION_EVENT, actionevent_contact);
    ::TapButton(this.baseview.findChild("btn_setting")).view.addEventListener(ACTION_EVENT, actionevent_setting);
    ::TapButton(this.baseview.findChild("btn_tos")).view.addEventListener(ACTION_EVENT, actionevent_tos);
    ::TapButton(this.baseview.findChild("btn_takeover")).view.addEventListener(ACTION_EVENT, actionevent_takeover);
    ::TapButton(this.baseview.findChild("btn_title")).view.addEventListener(ACTION_EVENT, actionevent_title);
  }

  function removed() {
    this.baseview = null;
  }

  function actionevent_announce(e) {
    e.consume();
  }

  function actionevent_contact(e) {
    e.consume();

  }

  function actionevent_setting(e) {
    e.consume();

    local d = loadCocos("/ui/dialog/GameSettingDialog.json");
    local dlg = GameSettingDialog(d);
    dlg.show();
  }

  function actionevent_tos(e) {
    e.consume();
  }

  function actionevent_takeover(e) {
    e.consume();

    ::gamesession.requestTakeover();
  }

  function actionevent_title(e) {
    ::gamesession.goBackTitleScene(e);
  }
}

class OptionPanel.GameSettingDialog extends ::Dialog {
  pnl_bgm = null;
  pnl_se = null;

  bgm_slider = null;
  se_slider = null;

  lbl_bgm_volume = null;
  lbl_se_volume = null;

  btn_bgm_mute = null;
  btn_se_mute = null;

  bgm_mute = false;
  se_mute = false;

  constructor(v) {
    super(v);

    this.pnl_bgm = v.findChild("pnl_bgm");
    this.pnl_se = v.findChild("pnl_se");

    this.bgm_slider = ::SliderH(pnl_bgm.findChild("pnl_slider"), 300);
    this.se_slider = ::SliderH(pnl_se.findChild("pnl_slider"), 300);

    this.bgm_slider.view.addEventListener(ACTION_EVENT, actionevent);
    this.se_slider.view.addEventListener(ACTION_EVENT, actionevent);

    this.lbl_bgm_volume = pnl_bgm.findChild("lbl_volume");
    this.lbl_se_volume = pnl_se.findChild("lbl_volume");

    this.btn_bgm_mute = pnl_bgm.findChild("btn_mute");
    this.btn_se_mute = pnl_se.findChild("btn_mute");
    ::TapButton(this.btn_bgm_mute);
    ::TapButton(this.btn_se_mute);

    this.bgm_slider.setValue(::soundmanager.bgmvol);
    this.se_slider.setValue(::soundmanager.sevol);
    this.lbl_bgm_volume.setText(int(this.bgm_slider.getValue() * 100));
    this.lbl_se_volume.setText(int(this.se_slider.getValue() * 100));
    _setupBGMMute();
    _setupSEMute();

    ::playBGM(::gamesetting.bgm["sushisong"]);
  }

  function _setupBGMMute() {
    this.bgm_mute = ::soundmanager.bgmmute;
    if (bgm_mute) {
      this.btn_bgm_mute.findChild("img_off").visible = false;
      this.btn_bgm_mute.findChild("img_on").visible = true;
    }
    else {
      this.btn_bgm_mute.findChild("img_off").visible = true;
      this.btn_bgm_mute.findChild("img_on").visible = false;
    }
  }

  function _setupSEMute() {
    this.se_mute = ::soundmanager.semute;
    if (se_mute) {
      this.btn_se_mute.findChild("img_off").visible = false;
      this.btn_se_mute.findChild("img_on").visible = true;
    }
    else {
      this.btn_se_mute.findChild("img_off").visible = true;
      this.btn_se_mute.findChild("img_on").visible = false;
    }
  }

  function actionevent(e) {
    switch (e.src) {
    case bgm_slider.view:
      switch (e.actioncmd) {
      case "dragged":
        local value = bgm_slider.getValue();
        ::soundmanager.setupBGMVolume(value);
        this.lbl_bgm_volume.setText(int(value * 100));

        e.consume();
        break;
      }

      break;
    case se_slider.view:
      switch (e.actioncmd) {
      case "dragged":
        local value = se_slider.getValue();
        ::soundmanager.setupSEVolume(value);
        this.lbl_se_volume.setText(int(value * 100));

        e.consume();
        break;
      }

      break;
    case btn_bgm_mute:
      ::soundmanager.setupBGMMute(!bgm_mute);
      _setupBGMMute();

      e.consume();
      break;
    case btn_se_mute:
      ::soundmanager.setupSEMute(!se_mute);
      _setupSEMute();

      e.consume();
      break;

    case btn_ok:
      _saveOption();
      e.consume();
      break;
    case btn_cancel:
      ::soundmanager.loadOption();

      close();
      e.consume();
      break;
    default:
      super.actionevent(e);
    }
  }

  function _saveOption() {
    local data = {
      bgmvol = ::soundmanager.bgmvol,
      bgmmute = ::soundmanager.bgmmute,
      sevol = ::soundmanager.sevol,
      semute = ::soundmanager.semute,
    }

    local file = FileRef(skGetDataDir() + "/sound_option");
    local jr = JSONOutput();
    jr.writeObject(data);
    local txt = encodeJSON(jr.getObject());
    local bb = ByteBuffer();
    bb.putText(txt);
    bb.pos = 0;
    file.save(bb);

    close();
  }

  function close() {
    ::soundmanager.fadeoutBGM();
    super.close();
  }
}