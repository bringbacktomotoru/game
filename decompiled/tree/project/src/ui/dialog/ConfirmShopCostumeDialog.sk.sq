class ConfirmShopCostumeDialog extends ::Dialog {
  lbl_price = null;
  lbl_name = null;
  lbl_desc = null;

  pnl_gm = null;
  lbl_shortage = null;

  img_ok = null;
  img_ng = null;

  component = null;

  buy_state = 0;

  constructor() {
    super(::loadSKView("/ui/dialog/ConfirmShopCostumeDialog.ui"));

    local _pnl_info = this.view.findChild("pnl_info");
    local _pnl_tap_hapiness = this.view.findChild("pnl_tap_hapiness");
    local _pnl_slide = this.view.findChild("pnl_slide");

    this.lbl_price = this.view.findChild("lbl_price");
    this.lbl_name = this.view.findChild("lbl_name");
    this.lbl_desc = this.view.findChild("lbl_desc");

    this.component = CostumeComponent(this.view.findChild("pnl_view"));
    this.img_ok = this.btn_ok.findChild("img_ok");
    this.img_ng = this.btn_ok.findChild("img_ng");

    this.pnl_gm = this.view.findChild("pnl_gm");
    this.lbl_shortage = this.view.findChild("lbl_shortage");

    this.btn_ok.findChild("lbl_ok").setText(::dict.get("decide"));
    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("cancel"));
    this.view.findChild("lbl_confirm").setText(::dict.get("shop_confirm_costume"));

    _pnl_slide.findChild("lbl_slide").setText(::dict.get("rewarddialog_slide_desc"));

    this.pnl_gm.findChild("lbl_old").setText(::dict.get("have_hapiness"));
    this.pnl_gm.findChild("lbl_new").setText(::dict.get("purchased_hapiness"));
  }

  function setShopCostume(ss, state) {
    local _cid = ss.getItemID();
    local _ud = ::gamesession.getUserData();
    local _cs = ::gamesetting.costume_settings[_cid];
    this.buy_state = state;

    this.lbl_name.setText(ss.getItemName());
    this.lbl_desc.setText(_cs.getDesc());

    local _key = "";
    switch (ss.getPriceType()) {
    case PRICE_GM:
      _key = "shop_confirm_gm_price";
      break;
    case PRICE_RM:
    case PRICE_ONEROUS_RM:
      _key = "shop_confirm_rm_price";
      break;
    }
    local _price = ss.getPrice();
    this.lbl_price.setText(::dict.get(_key, [::formatNumberString(_price)]));

    this.component.setCostume(_cid);

    local _gm = _ud.getGameMoney();
    local _rm = _ud.getTotalRealMoney();

    if (canBuy()) {
      this.img_ok.visible = true;
      this.img_ng.visible = false;

      this.lbl_shortage.setVisible(false);

      this.pnl_gm.findChild("lbl_gm_old").setText(::formatNumberString(_gm));
      this.pnl_gm.findChild("lbl_rm_old").setText(::formatNumberString(_rm));
      local _sub = _gm - _price;
      local _newgm = Math.clamp(_sub, 0, _gm);
      local _newrm = _sub >= 0 ? _rm : _rm + _sub;

      this.pnl_gm.findChild("lbl_gm_new").setText(::formatNumberString(_newgm));
      this.pnl_gm.findChild("lbl_rm_new").setText(::formatNumberString(_newrm));
    }
    else {
      this.img_ok.visible = false;
      this.img_ng.visible = true;
      this.pnl_gm.setVisible(false);

      if (this.buy_state == ::ShopPanel.ShopCard.BUY_STATE_HAD) {
        this.lbl_shortage.setText(::dict.get("bought_costume"));
      }
      else {
        local _shortage = _price - (_gm + _rm);
        this.lbl_shortage.setText(::dict.get("no_have_gm_val", [::formatNumberString(_shortage)]));
      }
    }
  }

  function canBuy() {
    return this.buy_state == ::ShopPanel.ShopCard.BUY_STATE_OK ? true : false;
  }

  function actionevent(e) {
    switch (e.src) {
    case btn_ok:
      if (canBuy()) {
        ret = 1;
        ::tutorial_manager.checkWaitingActionEvent(this.btn_ok);
        close();
      }
      else {
        showBuyStateDialog();
      }
      break;
    case btn_cancel:
    case btn_close: ret = 0; close(); break;
    }

    if (func) func(ret);
  }

  function showBuyStateDialog() {
    local _dlg = ::SimpleDialog();
    _dlg.lbl_msg.setText(::ShopPanel.ShopCard.getBuyStateMessage(this.buy_state));
    _dlg.show();
  }
}

class CostumeComponent {
  sk3dview = null;

  obj = null;
  last_x = null;
  angle = null;

  constructor(pnl_view) {
    this.sk3dview = ::Chara3DView();
    this.sk3dview.setRect(0, 0, pnl_view.bnd.w, pnl_view.bnd.h);
    pnl_view.addChild(this.sk3dview);

    pnl_view.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function setCostume(cid) {
    this.angle = 0;

    this.sk3dview.setCostumeId(cid);
    this.sk3dview.build(true);
    this.obj = this.sk3dview.obj;
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_PRESSED:
      this.last_x = e.x;
      break;
    case MOUSE_DRAGGED:
      local diff = e.x - this.last_x;
      this.angle -= diff;
      this.obj.setAngle(angle);
      this.last_x = e.x;
      break;
    case MOUSE_RELEASED:
      break;
    }
  }
}