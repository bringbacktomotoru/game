class TextInputDialog extends ::Dialog {
  input = null;
  max_input_length = 10;

  btn_input = null;
  lbl_input = null;

  constructor(v) {
    super(v);

    this.btn_input = v.findChild("btn_input");
    TapButton(btn_input);

    this.lbl_input = v.findChild("lbl_input");
    this.lbl_input.setText("");

    v.addEventListener(TEXTINPUT_EVENT, textinputevent);
  }

  function textinputevent(e) {
    if (e.id != TEXTINPUT_DONE) return;
    local s = string(e.actioncmd);
    if (length(s) > this.max_input_length) {
      s = s.substring(0, this.max_input_length);
    }
    lbl_input.setText(s);

    this.input = s;
  }

  function startinput() {
    view.requestFocus();
    skStartTextEdit({ text = lbl_input.getText(), maxlen = this.max_input_length });
  }

  function actionevent(e) {
    switch (e.src) {
    case btn_input:
      startinput();
      break;
    case btn_ok:
      if (!input) return;

      close();
      break;
    default:
      super.actionevent(e);
      break;
    }
  }
}