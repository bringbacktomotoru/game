class ConfirmWorkDialog extends ::Dialog {
  need_moneylayer = true;

  pnl_chara_icon = null;
  pnl_work = null;
  lbl_rm_val = null;
  lbl_time = null;

  timelabel = null;
  gauge_time = null;

  reward_dialog = null;

  costume_data = null;

  img_shorten = null;
  img_shorten_ng = null;

  constructor() {
    super(::loadSKView("/ui/dialog/ConfirmWorkDialog.ui"));

    local _pnl_ar = this.view.findChild("pnl_ar");
    local _lbl_ar_tap = _pnl_ar.findChild("lbl_ar_tap");
    _lbl_ar_tap.setText(::dict.get("work_confirm_ar_tap"));
    local _lbl_ar_start = _pnl_ar.findChild("lbl_ar_start");
    _lbl_ar_start.setText(::dict.get("work_confirm_ar_start"));

    local _lbl_title = this.view.findChild("lbl_title");
    _lbl_title.setText(::dict.get("work_confirm_working"));
    local _lbl_confirm = this.view.findChild("lbl_confirm");
    _lbl_confirm.setText(::dict.get("work_confirm_shorten"));

    local _lbl_remain = this.view.findChild("lbl_remain");
    _lbl_remain.setText(::dict.get("remain"));

    local _pnl_item = this.view.findChild("pnl_item");
    ::TapButton(_pnl_item, false).view.addEventListener(ACTION_EVENT, actionevent_item);
    local _lbl_item = _pnl_item.findChild("lbl_item");
    _lbl_item.setText(::dict.get("use_item"));

    local _pnl_reward = this.view.findChild("pnl_reward");
    ::TapButton(_pnl_reward, false).view.addEventListener(ACTION_EVENT, actionevent_reward);
    local _lbl_reward = _pnl_reward.findChild("lbl_reward");
    _lbl_reward.setText(::dict.get("work_confirm_reward"));

    local _lbl_close = this.btn_close.findChild("lbl_close");
    _lbl_close.setText(::dict.get("close"));

    local _btn_interrupt = this.view.findChild("btn_interrupt");
    ::TapButton(_btn_interrupt, false).view.addEventListener(ACTION_EVENT, actionevent_interrupt);
    local _lbl_interrupt = _btn_interrupt.findChild("lbl_interrupt");
    _lbl_interrupt.setText(::dict.get("work_confirm_btn_interrupt"));

    local _btn_shorten = this.view.findChild("btn_shorten");
    local _btn = ::TapButton(_btn_shorten, false);
    _btn.setTappedSE(SoundConstants.SOUND_DECIDE);
    _btn.view.addEventListener(ACTION_EVENT, actionevent_shorten);
    this.img_shorten = _btn_shorten.findChild("img_shorten");
    this.img_shorten_ng = _btn_shorten.findChild("img_shorten_ng");
    local _lbl_shorten = _btn_shorten.findChild("lbl_shorten");

    _lbl_shorten.setText(::dict.get("shorten"));

    this.reward_dialog = WorkRewardsDialog();

    this.lbl_rm_val = _btn_shorten.findChild("lbl_rm_val");
    this.pnl_chara_icon = this.view.findChild("pnl_chara_icon");

    local _pnl_work = this.view.findChild("pnl_work");
    ::TapButton(_pnl_work, false).view.addEventListener(ACTION_EVENT, actionevent_ar);
    this.pnl_work = WorkCard(_pnl_work);

    this.lbl_time = this.view.findChild("lbl_time_val");
    this.gauge_time = ::ValueGauge(this.view.findChild("gauge_time"));

    local _pnl_event = this.view.findChild("pnl_actionevent");
    _pnl_event.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function setData(cd) {
    this.costume_data = cd;

    local _wd = cd.getWorkData();
    local _ws = _wd.getSetting();

    this.reward_dialog.setData(_ws, cd);

    local _idx = cd.getSetting().getCostumeActionIndex(_ws.getID());
    this.pnl_work.setWork(cd, _ws, _idx);

    local _remain = _wd.getRemainingTime(::getServerTime());
    local _max_time = _ws.getWorkTime();
    this.gauge_time.init(_remain, _max_time);
    this.timelabel = ::TimeLabel(this.lbl_time, _remain);
    this.timelabel.setRepeatFunc(updateTimeGauge.bindenv(this), 1000);
    this.timelabel.setEndFunc(setTimeEnd.bindenv(this));
    this.timelabel.startCountDown();

    local _remain = _wd.getRemainingTime(::getServerTime());
    local _need_rm = ::gamesetting.game_rule.calcShortenRMWork(_remain);
    this.lbl_rm_val.setText(_need_rm);
    if (::gamesession.getUserData().getTotalRealMoney() >= _need_rm) {
      this.img_shorten.visible = true;
      this.img_shorten_ng.visible = false;
    }
    else {
      this.img_shorten.visible = false;
      this.img_shorten_ng.visible = true;
    }

    this.pnl_chara_icon.clearChildren();
    local _sp = cd.getCharaSetting().getIconSprite();
    local _icon = SKImageView(_sp);
    _icon.setRect(0, 0, this.pnl_chara_icon.bnd.w, this.pnl_chara_icon.bnd.h);
    this.pnl_chara_icon.addChild(_icon);
  }

  function updateTimeGauge() {
    local _wd = this.costume_data.getWorkData();
    if (!_wd) return;
    local _ws = _wd.getSetting();
    local _remain = this.timelabel.getRemainTime();
    local _max_time = _ws.getWorkTime();

    this.gauge_time.setCurrentValue(_remain);

    local _remain = _wd.getRemainingTime(::getServerTime());
    local _need_rm = ::gamesetting.game_rule.calcShortenRMWork(_remain);
    this.lbl_rm_val.setText(_need_rm);
    if (::gamesession.getUserData().getTotalRealMoney() >= _need_rm) {
      this.img_shorten.visible = true;
      this.img_shorten_ng.visible = false;
    }
    else {
      this.img_shorten.visible = false;
      this.img_shorten_ng.visible = true;
    }
  }
  function setTimeEnd() {
    this.lbl_time.setText(::dict.get("product_finished"));
    this.timelabel.resetRepeatFunc();
    this.gauge_time.setCurrentValue(this.gauge_time.max_value);
  }

  function setTitleTextAtHome() {
    local _lbl_title = this.view.findChild("lbl_title");
    _lbl_title.setText(::dict.get("work_confirm_working_athome"));
  }

  function _moveHomeTopPanel() {
    local _wd = this.costume_data.getWorkData();
    local _ud = ::gamesession.getUserData();
    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != ::SanrioGameScene) return;
    if (_wd.getRoomID() != _ud.getCurrentRoomIndex()) {
      _scene.selectRoom(_wd.getRoomID());
    }

    ::gamesession.getCurrentScene().getUI().movePanel(::HomeTopPanel);
  }

  function _checkWorking() {
    local _scene = ::gamesession.getCurrentScene();

    if (!this.costume_data.getWorkData().isWorking()) {
      local _dlg = ::SimpleDialog2();
      _dlg.lbl_msg.textbox.wrapmode = 1;
      _dlg.lbl_msg.setText(::dict.get("work_finished_tohome"));
      _dlg.lbl_caution.setText("");
      _dlg.show();

      while (!_dlg.isClosing()) {
        suspend();
      }
      if (_dlg.ret > 0) {
        _moveHomeTopPanel();
      }
      return true;
    }
    return false;
  }

  function mouseevent(e) {
    e.consume();
    if (e.id == MOUSE_RELEASED) close();
  }

  function actionevent_item(e) {

    ::gamesession.messagelayer.closeAllMessage();
    local _message = ::Message();
    _message.setMsec(3 * 1000);
    _message.setText(::dict.get("unimplemented"));
    _message.setFontSize(32);
    _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
    _message.show();
  }

  function actionevent_reward(e) {
    e.consume();

    this.reward_dialog.show();
  }

  function actionevent_interrupt(e) {
    e.consume();

    local _b = _checkWorking();
    if (_b) return;

    local _scene = ::gamesession.getCurrentScene();
    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(::dict.get("work_cancel"));
    _dlg.lbl_caution.setText(::dict.get("work_cancel_caution"));
    _dlg.show();

    while (!_dlg.isClosing()) {
      suspend();
    }
    if (_dlg.ret > 0) {
      if (!_scene.getWorkManager().cancelWork(this.costume_data.getID())) return;
      _scene.updateActiveSanrioCharas();
      this.ret = 1;
      close();

      local _message = ::Message();
      _message.setMsec(3 * 1000);
      _message.setText(::dict.get("work_interrupted"));
      _message.setFontSize(32);
      _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
      _message.show();
    }
  }

  function actionevent_shorten(e) {
    e.consume();

    local _b = _checkWorking();
    if (_b) return;

    local _wd = this.costume_data.getWorkData();
    local _scene = ::gamesession.getCurrentScene();
    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(::dict.get("work_confirm_shorten"));
    _dlg.lbl_caution.setText(::dict.get("work_shorten_caution"));
    _dlg.setShorten(_wd.getRemainingTime(::getServerTime()), ::SimpleDialog2.TYPE_WORK);
    _dlg.show();
    while (!_dlg.isClosing()) {
      suspend();
    }
    if (_dlg.ret > 0) {
      if (!_scene.getWorkManager().shorteningTime(this.costume_data.getID())) return;
      close();
      _moveHomeTopPanel();
      ::gamesession.messagelayer.closeAllMessage();
      local _message = ::Message();
      _message.setMsec(4 * 1000);
      _message.setText(::dict.get("work_shorten"));
      _message.setFontSize(32);
      _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
      _message.show();
    }
  }

  function actionevent_ar(e) {
    ::gamesession.getCurrentScene().getUI().movePanel(::ARPanel, false, { "costume_id" = this.costume_data.getID() });
  }
}

class ConfirmWorkDialog.WorkCard {
  layer = null;
  view = null;

  btn_work = null;
  lbl_health = null;
  lbl_work_name = null;
  pnl_complete = null;

  costume_data = null;
  work_setting = null;
  work_index = -1;

  img_bg1 = null;
  img_bg2 = null;
  img_bg3 = null;
  img_icon_quest = null;

  constructor(v) {
    this.layer = v;
    this.view = ::loadSKView("/ui/common/WorkCard.ui");
    this.view.scale(0.75);
    this.layer.addChild(this.view);

    this.btn_work = this.view.findChild("btn_work");
    this.pnl_complete = this.btn_work.findChild("pnl_complete");
    this.btn_work.findChild("pnl_lock").visible = false;

    this.img_bg1 = this.btn_work.findChild("img_bg1");
    this.img_bg2 = this.btn_work.findChild("img_bg2");
    this.img_bg3 = this.btn_work.findChild("img_bg3");

    this.lbl_health = this.btn_work.findChild("lbl_health");
    this.lbl_work_name = this.btn_work.findChild("lbl_work_name");

    this.view.startMethod("setNameOnly");

    this.img_icon_quest = this.view.findChild("img_icon_quest");
  }

  function setWork(cd, ws, idx) {
    this.costume_data = cd;
    this.work_setting = ws;
    this.work_index = idx;
    if (!cd || !ws) return;

    local _wrd = ::gamesession.getUserData().getWorkRewardData(cd.getID());
    local _rate = 0.0;
    if (_wrd) _rate = _wrd.getRewardRate(ws.getID());
    if (_rate >= 1.0) {
      this.pnl_complete.visible = true;
    }
    else if (ws.getUseHealth() > cd.getHealth() || ws.getLevel() > cd.getLevel()) {
      this.pnl_complete.visible = false;
    }
    else {
      this.pnl_complete.visible = false;
    }

    this.lbl_work_name.setText(ws.getName());

    this.lbl_health.setText(ws.getUseHealth());

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != ::SanrioGameScene) return;
    local _request_manager = _scene.getCostumeRequestManager();

    this.img_icon_quest.setVisible(_request_manager.hasValidRequest(cd.getID(), ::CostumeRequestSetting.TYPE_WORK));

    _setWorkBg();
  }

  function _setWorkBg() {
    switch (this.work_index) {
    case 0:
      this.img_bg1.visible = true;
      this.img_bg2.visible = false;
      this.img_bg3.visible = false;
      break;
    case 1:
      this.img_bg1.visible = false;
      this.img_bg2.visible = true;
      this.img_bg3.visible = false;
      break;
    case 2:
      this.img_bg1.visible = false;
      this.img_bg2.visible = false;
      this.img_bg3.visible = true;
      break;
    default:
      this.img_bg1.visible = false;
      this.img_bg2.visible = false;
      this.img_bg3.visible = false;
      break;
    }
  }

  function setViewVisible(v) {
    this.layer.visible = v;
    this.layer.matdirty = true;
    this.layer.repaint();
  }
}

class ConfirmWorkDialog.WorkRewardsDialog extends ::Dialog {
  lbl_gm_val = null;
  pnl_reward_items = null;
  reclist = null;
  scroll = null;

  constructor() {
    super(::loadSKView("/ui/dialog/WorkRewardsDialog.ui"));

    this.lbl_gm_val = this.view.findChild("lbl_gm_val");

    local _pnl_reward = this.view.findChild("pnl_reward");
    this.pnl_reward_items = _pnl_reward.findChild("pnl_reward_items");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.pnl_reward_items.addChild(this.reclist);
    this.pnl_reward_items.setBuffer(true);

    _pnl_reward.findChild("lbl_reward_item").setText(::dict.get("work_randomrewards_list"));
    local _lbl_gm = this.view.findChild("lbl_gm");
    _lbl_gm.setText(::dict.get("work_select_gm"));
    this.btn_close.findChild("lbl_close").setText(::dict.get("close"));
  }

  function setData(ws, cd) {

    this.lbl_gm_val.setText(ws.getRewardGM());

    this.reclist.clearChildren();
    local _rt = ws.getRewardTable();
    local _offset = 0;
    local _cid = cd.getID();
    local _wrd = ::gamesession.getUserData().getWorkRewardData(_cid);
    if (_rt) {
      for (local i = 0; i < _rt.len(); i++) {
        local _mark = false;
        if (_wrd && _wrd.contain(ws.getID(), i)) _mark = true;
        local _item = ItemCard(_rt[i], _mark, _cid);
        this.reclist.addChild(_item);
        _item.pos.set(_offset, 0);
        _item.matdirty = true;
        _item.repaint();
        _offset += _item.bnd.w + 10;
      }
    }
    this.reclist.setRect(0, 0, _offset, this.pnl_reward_items.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);
  }
}

class ConfirmWorkDialog.WorkRewardsDialog.ItemCard extends SKView {
  static REWARD_ROTATE = 0;
  static MONEY_ROTATE = 35;
  static MOTION_ROTATE = 25;

  view = null;

  reward = null;
  costume_id = -1;

  constructor(reward, mark, cid) {
    this.reward = reward;
    this.costume_id = cid;
    this.view = ::loadSKView("/ui/common/WorkRewardCard.ui");
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    addChild(this.view);

    local _btn_item = this.view.findChild("btn_item");
    ::TapButton(_btn_item, false).view.addEventListener(ACTION_EVENT, actionevent_desc);

    local _pnl_get = _btn_item.findChild("pnl_get");
    if (mark) _pnl_get.visible = true;
    else _pnl_get.visible = false;

    local _pnl_rank = _btn_item.findChild("pnl_rank");
    if (reward.rank) _pnl_rank.visible = true;
    else _pnl_rank.visible = false;

    local _pnl_icon = _btn_item.findChild("pnl_icon");
    local _lbl_value = _btn_item.findChild("lbl_value");
    local _icon;
    local _sp;

    local _frame_sp = ::Setting.getItemFrame(reward.kind);
    if (_frame_sp) {
      local _frame = SKImageView(_frame_sp);
      _frame.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
      ::rotateSKView(_frame, REWARD_ROTATE, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
      _pnl_icon.addChild(_frame);
    }

    local icon_rate = 0.6;
    local offset_x = _pnl_icon.bnd.w * (1 - icon_rate) / 2;
    local offset_y = _pnl_icon.bnd.h * (1 - icon_rate) / 2;

    switch (reward.kind) {
    case ITEM_TYPE_GM:
      _sp = ::Setting.getGMIconSprite();
      _icon = SKImageView(_sp);
      _icon.setRect(offset_x, offset_y, _pnl_icon.bnd.w * icon_rate, _pnl_icon.bnd.h * icon_rate);
      ::rotateSKView(_icon, MONEY_ROTATE, _pnl_icon.bnd.w * icon_rate, _pnl_icon.bnd.h * icon_rate);
      _pnl_icon.addChild(_icon);

      _lbl_value.visible = true;
      _lbl_value.setText(::dict.get("nums_kakeru", [reward.num]));
      break;

    case ITEM_TYPE_FREERM:
      _sp = ::Setting.getRMIconSprite();
      _icon = SKImageView(_sp);
      _icon.setRect(offset_x, offset_y, _pnl_icon.bnd.w * icon_rate, _pnl_icon.bnd.h * icon_rate);
      ::rotateSKView(_icon, MONEY_ROTATE, _pnl_icon.bnd.w * icon_rate, _pnl_icon.bnd.h * icon_rate);
      _pnl_icon.addChild(_icon);

      _lbl_value.visible = true;
      _lbl_value.setText(::dict.get("nums_kakeru", [reward.num]));
      break;

    case ITEM_TYPE_COSTUME:
      _lbl_value.visible = false;
      _icon = ::SKImageView();
      _icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
      _pnl_icon.addChild(_icon);
      CostumeIcon(reward.id, _icon, false, false);
      break;

    case ITEM_TYPE_FURNITURE:
      _lbl_value.visible = false;

      local _fs = ::gamesetting.furniture_settings[reward.id];
      if (!_fs) return;
      _sp = _fs.getIconSpriteUnacquired();
      _icon = SKImageView(_sp);
      _icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
      _pnl_icon.addChild(_icon);
      break;

    case ITEM_TYPE_ITEM:
      _lbl_value.visible = false;

      break;

    case ITEM_TYPE_MOTION:
      _lbl_value.visible = false;
      local _ms = ::gamesetting.costume_motion_settings[reward.id];
      _sp = _ms.getIconSprite();
      _icon = SKImageView(_sp);
      _icon.setRect(offset_x, offset_y, _pnl_icon.bnd.w * icon_rate, _pnl_icon.bnd.h * icon_rate);
      ::rotateSKView(_icon, MOTION_ROTATE, _pnl_icon.bnd.w * icon_rate, _pnl_icon.bnd.h * icon_rate);
      _pnl_icon.addChild(_icon);
      break;
    }
  }

  function actionevent_desc(e) {
    local dlg = ::RewardDialog();
    dlg.setReward(this.reward.kind, this.reward.id, this.reward.num, this.costume_id);
    dlg.show();
  }
}