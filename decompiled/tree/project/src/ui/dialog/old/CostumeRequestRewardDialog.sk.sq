class CostumeRequestRewardDialog extends ::Dialog {
  static REWARD_SPACE = 20;
  static REWARD_ICON_SIZE = 100;

  costume_id = null;
  request_id = null;
  rewards = null;

  view = null;
  lbl_title = null;
  img_icon = null;
  lbl_desc = null;
  pnl_reward_list = null;

  constructor() {
    super(::loadSKView("/ui/dialog/CostumeRequestRewardDialog.ui"));

    this.lbl_title = this.view.findChild("lbl_title");
    this.img_icon = this.view.findChild("img_icon");
    this.lbl_desc = this.view.findChild("pnl_desc").findChild("lbl_desc");

    local _pnl = this.view.findChild("pnl_reward");
    this.pnl_reward_list = _pnl.findChild("pnl_reward_list");

    _pnl.findChild("lbl_reward").setText(::dict.get("get"));
    this.btn_close.findChild("lbl_close").setText(::dict.get("close"));
  }

  function setData(cos_id, request_id, rewards) {
    this.costume_id = cos_id;
    this.request_id = request_id;
    this.rewards = rewards;

    local cos_setting = ::gamesetting.costume_settings[this.costume_id];
    local chara_setting = ::gamesetting.sanrio_chara_settings[cos_setting.getCharaID()];
    local cr_setting = ::gamesetting.costume_request_settings[this.request_id];

    this.lbl_title.setText(::dict.get("costumerequest_chara", [chara_setting.getName()]));

    this.img_icon.setSprite(chara_setting.getIconSprite());
    this.img_icon.updateLayout();

    this.lbl_desc.setText(cr_setting.getDesc());

    this.pnl_reward_list.clearChildren();
    local cx = this.pnl_reward_list.bnd.w / 2.0;
    local sx = cx - ((this.rewards.len() - 1) * (REWARD_ICON_SIZE + REWARD_SPACE) / 2 + REWARD_ICON_SIZE / 2);
    local offset = sx;
    foreach (ri in this.rewards) {
      local icon = ::RewardIcon(ri.kind, ri.id, ri.num);
      icon.setRect(0, 0, REWARD_ICON_SIZE, REWARD_ICON_SIZE);
      icon.view.pos.x = offset;
      this.pnl_reward_list.addChild(icon.view);

      offset += REWARD_ICON_SIZE + REWARD_SPACE;
    }
  }
  function show() {
    this.view.startMethod("init");
    super.show();
  }
  function showed() {
    this.view.startMethod("show");
  }
}