class GachaSetting extends Setting {

  static STATE_ENABLE = 0;
  static STATE_POVERTY = 1;
  static STATE_PERIOD_OUTSIDE = 2;
  static STATE_LIMIT = 3;
  static STATE_OTHERS = 4;

  static FILE_NAME_BANNER = "banner";
  static FILE_NAME_LOGO = "logo";
  static FILE_PATH = "/gacha";

  static STEP_RESET_NONE = 0;
  static STEP_RESET_DAILY = 1;
  static STEP_RESET_WEEKLY = 2;
  static STEP_RESET_MONTHLY = 3;

  id = 0;
  gacha_version = 0;
  name = null;
  desc = null;
  type = 0;

  image_url = null;
  banner = null;
  title_logo = null;
  desc_banner = null;

  price = null;
  limit_price = null;
  step_price = null;

  step_reset_type = 0;

  period = null;

  limit = -1;
  enable_visible = 0;
  conditions = null;

  priority = 0;

  can_use_ticket = 0;

  items_id = -1;
  bonus = null;

  tab_icon = null;
  loading_bg = null;

  function loadConfAtServer(t) {
    local _setting = GachaSetting();

    foreach (k, v in t) {
      switch (k) {
      case "price":
      case "limit_price":
      case "step_price":
      case "period":
      case "conditions":
      case "bonus":
        _setting[k] = decodeJSON(v);
        break;
      default:
        _setting[k] = v;
      }

    }
    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (name) trans + "name";
    if (desc) trans + "desc";

    return trans;
  }

  function getID() {
    return this.id;
  }

  function getGachaVersion() {
    return this.gacha_version;
  }

  function getName() {
    return this.name;
  }

  function getDesc() {
    return this.desc;
  }

  function getEnableVisible() {
    return this.enable_visible;
  }

  function getConditions() {
    return this.conditions;
  }

  function getType() {
    return this.type;
  }

  function getLimit() {
    return this.limit;
  }

  function getPriority() {
    return this.priority;
  }

  function getPeriod() {
    return this.period;
  }

  function getStartPeriod() {
    if (!this.period || this.period.len() < 1) return null;
    return this.period[0];
  }

  function getEndPeriod() {
    if (!this.period || this.period.len() < 2) return null;
    return this.period[1];
  }

  function getPriceInfo(idx) {
    if (!this.price || idx < 0 || idx >= this.price.len()) return null;
    return this.price[idx];
  }

  function getPrice(idx) {
    local _p = getPriceInfo(idx);
    if (!_p) return 0;
    return _p.price;
  }

  function getDirectoryPath() {
    return "/ui/image/gacha/" + ::READ_TRANS_FILE + "/";
  }

  function getBannerImage() {
    local _sp = Sprite(::getTexture(getDirectoryPath() + this.banner));
    local _skiv;
    if (_sp) {
      _sp.blend = SK_MIX;
      _skiv = ::SKImageView(_sp)
    }
    return _skiv;
  }
  function getTestBannerImage() {
    if (!this.image_url || !this.banner) return null;
    return _getServerImage(FILE_NAME_BANNER, this.banner);
  }

  function getTitleLogoImage() {
    local _sp = Sprite(::getTexture(this.title_logo));
    local _skiv;
    if (_sp) {
      _sp.blend = SK_MIX;
      _skiv = ::SKImageView(_sp)
    }
    return _skiv;
  }
  function getTestTitleLogoImage() {
    if (!this.image_url || !this.title_logo) return null;
    return _getServerImage(FILE_NAME_LOGO, this.title_logo);
  }

  function _getServerImage(def_name, file_name) {
    local _file_path = skGetDataDir() + FILE_PATH;
    local _def_name = def_name + this.id;
    local _file_name = _file_path + "/" + _def_name + "_" + file_name;
    local _server_file_name = this.image_url + file_name;

    local _cache_dir = FileRef(_file_path);
    local _image_data = null;
    if (!_cache_dir.exists()) {
      _cache_dir.mkdirs();
    }
    else {
      local _cache = FileRef(_file_name);
      if (_cache.exists()) {
        _image_data = _cache.load();
      }
      else {
        local _file_list = _cache_dir.getList();
        foreach (file in _file_list) {
          if (file && file.name && file.name.indexOf(_def_name)) {
            file.deleteFile();
          }
        }
      }
    }

    if (!_image_data) {
      local _http = HTTPClient();
      try {
        _image_data = _http.get(_file_name, HTTPByteBufferReceiver());
        local _cache = FileRef(_file_name);
        _cache.save(_image_data);
      }
      catch (ex) {
        return null;
      }
    }

    if (!_image_data) return null;

    local _rgba_image = contentloaders[0](null, "jpg", _image_data, null);
    local _sp = Sprite(_rgba_image);
    local _skiv;
    if (_sp) {
      _sp.blend = SK_MIX;
      _skiv = ::SKImageView(_sp)
    }
    return _skiv;
  }

  function getTabIconSprite() {
    local path = "/image/icon/gacha/" + tab_icon;
    local sp = ::getSprite(path);
    if (sp) sp.blend = SK_MIX;
    return sp;
  }

  function getGachaLoadingBG() {
    local _path = "/dl/loadingbg/gacha/" + loading_bg;
    local _tex = ::getTexture(_path);
    if (!_tex) {

      local a = [
      "/dl/loadingbg/pop/1.png",
      "/dl/loadingbg/pop/2.png",
      "/dl/loadingbg/pop/3.png",
      "/dl/loadingbg/pop/4.png",
      "/dl/loadingbg/pop/5.png",
      "/dl/loadingbg/pop/6.png",
      "/dl/loadingbg/pop/7.png",
      "/dl/loadingbg/pop/8.png",
      "/dl/loadingbg/pop/9.png",
      "/dl/loadingbg/pop/10.png",
      "/dl/loadingbg/pop/11.png",
      "/dl/loadingbg/pop/12.png"
      ];

      local _path = a[skGetTime() % length(a)];
      _tex = ::getTexture(_path);
    }
    return _tex;
  }

  function getGachaItems() {
    return ::gamesetting.gacha_items_settings[this.items_id];
  }

  function getFuaturedItems() {
    local _items = getGachaItems();
    if (!_items) return null;
    return _items.getFuaturedItems();
  }

  function getLimitPriceInfo() {
    return this.limit_price;
  }

  function getLimitGachaType() {
    if (!this.limit_price) return -1;
    return this.limit_price.type;
  }

  function getLimitGachaPrice() {
    if (!this.limit_price) return -1;
    return this.limit_price.price;
  }

  function getLimitGachaNum() {
    if (!this.limit_price) return -1;
    return this.limit_price.num;
  }

  function getLimitGachaLimit() {
    if (!this.limit_price) return -1;
    return this.limit_price.limit;
  }

  function getLimitGachaDaily() {
    if (!this.limit_price) return -1;
    return this.limit_price.daily;
  }

  function isStepPriceReset(st) {
    switch (step_reset_type) {
    case STEP_RESET_NONE: return false;
    case STEP_RESET_DAILY: return ::isOtherDay(st);
    case STEP_RESET_WEEKLY: return ::acrossWeek(st);
    case STEP_RESET_MONTHLY: return ::isOtherMonth(st);
    }
    return false;
  }

  function isStepPriceGacha() {
    return this.step_price ? true : false;
  }

  function getStepPriceInfoFromUserData() {
    return getStepPriceInfo(::gamesession.getUserData().getStepGachaCount(this.id, this.gacha_version));
  }
  function getStepPriceInfo(gacha_count) {
    if (gacha_count < 0) return null;
    if (!this.step_price || this.step_price.len() == 0) return null;
    local _step = gacha_count >= this.step_price.len() ? this.step_price.len() - 1 : gacha_count;
    return this.step_price[_step];
  }

  function canExecuteGacha(idx) {
    if (!this.price || idx < 0 || idx >= this.price.len()) return STATE_OTHERS;
    local _ud = ::gamesession.getUserData();

    if (!checkPeriod) return STATE_PERIOD_OUTSIDE;

    if (this.limit >= 0 && _ud.getGachaCount(this.id, this.gacha_version) >= this.limit) return STATE_LIMIT;

    if (conditions && !::checkCondition(conditions, ::gamesetting.condition_settings)) return false;

    if (!_ud.hasMoney(this.type, this.price[idx].price)) return STATE_POVERTY;

    return STATE_ENABLE;
  }

  function canExecuteLimitGacha() {
    if (!this.limit_price) return STATE_OTHERS;
    local _ud = ::gamesession.getUserData();

    if (!checkPeriod) return STATE_PERIOD_OUTSIDE;

    if (this.limit_price.limit >= 0) {
      local _cnt;
      if (this.limit_price.daily == 1) _cnt = _ud.getDailyGachaCount(this.id, this.gacha_version);
      else _cnt = _ud.getLimitGachaCount(this.id, this.gacha_version);

      if (_cnt >= this.limit_price.limit) return STATE_LIMIT;
    }

    if (conditions && !::checkCondition(conditions, ::gamesetting.condition_settings)) return false;

    if (!_ud.hasMoney(this.limit_price.type, this.limit_price.price)) return STATE_POVERTY;

    return STATE_ENABLE;
  }

  function canExecuteStepGacha() {
    if (!this.step_price || this.step_price.len() == 0) return STATE_OTHERS;
    local _ud = ::gamesession.getUserData();

    if (!checkPeriod) return STATE_PERIOD_OUTSIDE;

    local _gacha_count = _ud.getStepGachaCount(this.id, this.gacha_version);
    if (this.limit >= 0 && _gacha_count >= this.limit) return STATE_LIMIT;

    if (conditions && !::checkCondition(conditions, ::gamesetting.condition_settings)) return false;

    local _info = getStepPriceInfo(_gacha_count);
    if (!_info) return STATE_OTHERS;
    if (!_ud.hasMoney(_info.type, _info.price)) return STATE_POVERTY;

    return STATE_ENABLE;
  }

  function checkPeriod() {
    if (!this.period) return true;

    local _p = ::getDateTableFromYYYYMMDDhh(getStartPeriod());
    if (_p && !::checkDateFromYMDh(_p.year, _p.mon, _p.day, _p.hour)) {
      return false;
    }

    local _p = ::getDateTableFromYYYYMMDDhh(getEndPeriod());
    if (_p && ::checkDateFromYMDh(_p.year, _p.mon, _p.day, _p.hour)) {
      return false;
    }
    return true;
  }

  function getRewardItems(idxes) {
    local _gis = getGachaItems();
    if (!_gis) return null;
    return _gis.getRewardItems(idxes);
  }

  function getAllItems() {
    local _gis = getGachaItems();
    if (!_gis) return null;
    return _gis.getAllItems();
  }
}