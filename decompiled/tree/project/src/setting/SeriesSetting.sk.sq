class SeriesSetting extends ::Setting {
  id = null;
  name = null;

  function loadConfAtServer(t) {
    local _setting = SeriesSetting();
    foreach (k, v in t) {
      _setting[k] = v;
    }
    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (name) trans + "name";
    return trans;
  }

  function getID() {
    return this.id;
  }

  function getName() {
    return this.name;
  }

  function getIconSprite() {
    local _path = "/image/icon/series/" + this.id + ".png";
    local _sp = ::getSprite(_path);
    if (!_sp) _sp = ::getSprite("/image/icon/series/none.png");
    _sp.blend = SK_MIX;

    return _sp;
  }
}