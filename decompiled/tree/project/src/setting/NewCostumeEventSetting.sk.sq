class NewCostumeEventSetting extends ::Setting {
  id = 0;
  sentences = null;

  function getTranslateTarget() {
    local trans = [];

    if (sentences) trans + TranslateTextInfo(this, "sentences", TranslateTextInfo.WILD_CARD, "sentence");

    return trans;
  }

  function getSentenceList(key = null) {
    return this.sentences;
  }
}