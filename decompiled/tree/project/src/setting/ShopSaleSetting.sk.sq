class ShopSaleSetting extends Setting {

  id = -1;
  text = null;
  price = -1;
  price_type = -1;
  iap_id = -1;

  function getTranslateTarget() {
    local trans = [];
    if (text) trans + "text";
    return trans;
  }

  function getText() {
    return this.text;
  }

  function getIapID() {
    return this.iap_id;
  }

  function getSettingPrice() {
    return this.price;
  }

  function getPriceType() {
    return this.price_type;
  }

  function hasOriginalPrice() {
    return price >= 0 || iap_id >= 0 ? true : false;
  }
}