class TutorialSetting extends Setting {
  static TYPE_UNIQUE = 0;
  static TYPE_MOVEPANEL = 1;
  static TYPE_PUT_FURNITURE = 2;
  static TYPE_PRODUCT = 3;
  static TYPE_WORK = 4;
  static TYPE_ROOMEDIT = 5;
  static TYPE_SHOP_BUY = 6;
  static TYPE_ADD_APPEAL_BALLOON = 7;
  static TYPE_TAP_BALLOON = 8;
  static TYPE_MISSION_MARK = 9;
  static TYPE_APPROACH_FURNITURE = 10;

  static TUTORIAL_ROOM_ID = 1;
  static TUTORIAL_FIRST_LOGIN = 1;
  static TUTORIAL_FIRST_ROOM_ID = 1;
  static TUTORIAL_LETTER_FIRST_MOVE = 2;
  static TUTORIAL_LETTER_FIRST_LOGIN = 1;
  static TUTORIAL_KITTY_EVENT1 = 50;
  static TUTORIAL_KITTY_EVENT1_COSTUME = 109001;
  static TUTORIAL_LETTER_SECOND_ID = 2;
  static TUTORIAL_LETTER_THIRD_ID = 3;
  static TUTORIAL_FIRST_FOCUS_TALK_ID = 10000;
  static TUTORIAL_CHARA_TAP_LOCK1 = 4;
  static TUTORIAL_CHARA_TAP_LOCK2 = 5;
  static TUTORIAL_FIRST_FURNITURE_ID = 8401;
  static TUTORIAL_FIRST_BUY_FURNITURE_ID = 10806;
  static TUTORIAL_APPS_FLYER_EVENT_ID = 16;

  static TUTORIAL_LIMIT_PANEL_MISSION = 8;
  static TUTORIAL_LIMIT_SHOP_BUY = 5;
  static TUTORIAL_LIMIT_PROPERTY = 7;
  static TUTORIAL_LIMIT_ROOM_EDIT = 7;
  static TUTORIAL_LIMIT_ROOM_EDIT_SC = 12;
  static TUTORIAL_LIMIT_FRUTNITURE_SELECT = 2;
  static TUTORIAL_LIMIT_FURNITURE_AUTO_USE = 12;
  static TUTORIAL_LIMIT_FURNITURE_ATTRACT = 11;
  static TUTORIAL_LIMIT_SHOP_COSTUME = 15;
  static TUTORIAL_LIMIT_SHOP_MOTION = 15;
  static TUTORIAL_LIMIT_SHOP_RM = 14;
  static TUTORIAL_LIMIT_DIARY = 14;
  static TUTORIAL_LIMIT_FOCUS_TALK = 4;
  static TUTORIAL_LIMIT_FOCUS_TALK1 = 5;
  static TUTORIAL_LIMIT_FOCUS_TALK2 = 12;
  static TUTORIAL_LIMIT_FOCUS_TALK_SKIP = 6;
  static TUTORIAL_LIMIT_CAMERA = 15;
  static TUTORIAL_LIMIT_FURNITURE_TALK = 5;
  static TUTORIAL_LIMIT_EDIT_COSTUME = 1001;
  static TUTORIAL_LIMIT_BUY_NEXT_ROOM = 14;
  static TUTORIAL_LIMIT_ROOM_SELECT = 14;

  static TUTORIAL_LIMIT_CANCEL_USE_FURNITURE1 = 4;
  static TUTORIAL_LIMIT_CANCEL_USE_FURNITURE2 = 12;
  static TUTORIAL_LIMIT_CANCEL_USE_FURNITURE3 = 13;

  static CHECK_TUTORIAL_FIRSTFOCUSTALK = 5;
  static CHECK_TUTORIAL_SHOWED_ONEROUS_RM = 1002;

  static SPECIAL_FLAG_FURNITURE_PURIN = 20001;

  static TUTORIAL_LETTER_DIARY = 11;
  static TUTORIAL_LETTER_CAMERA = 15;

  id = null;
  title = null;
  desc = null;
  clazz = null;
  type = null;
  conditions = null;
  image_list = null;
  image_path_list = null
  text_list = null;

  next_id = -1;
  time = 0;

  event_id = -1;
  event_costume_id = -1;

  with_end_ids = null;

  guide_func = null;

  function loadConfAtServer(t) {
    local _setting = TutorialSetting();

    foreach (k, v in t) {
      switch (k) {
      case "conditions":
      case "image_list":
      case "text_list":
      case "with_end_ids":
        _setting[k] = decodeJSON(v);
        break;
      default:
        _setting[k] = v;
      }
    }

    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (title) trans + "title";
    if (desc) trans + "desc";
    if (text_list) trans + "text_list"

    return trans;
  }

  function getID() {
    return this.id;
  }
  function getTitle() {
    return this.title;
  }
  function getDesc() {
    return this.desc;
  }
  function getType() {
    return this.type;
  }
  function getImagePathList() {
    if (!this.image_list) return null;

    if (!this.image_path_list) {
      this.image_path_list = [];
      foreach (image in this.image_list) {
        this.image_path_list + ("/image/tutorial/" + ::READ_TRANS_FILE + "/" + image);
      }
    }
    return this.image_path_list;
  }

  function getTextList() {
    return this.text_list;
  }

  function getConditions() {
    return this.conditions;
  }
  function getNextId() {
    return next_id;
  }
  function getTime() {
    return this.time;
  }
  function getEventId() {
    return this.event_id;
  }
  function hasEvent() {
    return this.event_id >= 0 ? true : false;
  }
  function getEventCostumeId() {
    return this.event_costume_id;
  }

  function checkConditions() {
    local c_settings = ::gamesetting.tutorial_condition_settings;
    local ret = ::checkCondition(conditions, c_settings);
    return ret;
  }
  function hasNext() {
    return this.next_id != -1;
  }

  function getWithEndIDs() {
    return this.with_end_ids;
  }

}