class GameRuleSetting extends ::Setting {
  initial_gm = null;
  initial_rm = null;
  initial_tap_gm = null;
  shorten_product_per_sec = null;
  shorten_work_per_sec = null;
  first_costume_ids = null;

  default_chara_actions = null;
  costume_request_intervals = null;
  furniture_use_favorite_rates = null;
  motion_rewards = null;

  bonus_hapiness_rate = null;
  furniture_bonus_hapiness_rate = null;
  levelup_bonus_recovery_num = null;

  chara_sentence_special_rate = null;

  capture_time = 60;
  next_capture_time = 0;
  capture_hapinnes_rate = 0;
  pop_capture_time = null;

  ad_video_rewards = null;

  enable_push_hour = null;
  push_costume_request_intervals = null;
  push_language = null;
  furniture_lvmax_rm = null;
  motion_drop_favorite_rates = null;

  disable_tutorial = null;

  room_motions = null;
  initial_motions = null;

  function loadConfAtServer(t) {
    local _setting = GameRuleSetting();
    foreach (k, v in t) {
      switch (k) {
      case "first_costume_ids":
      case "default_chara_actions":
      case "costume_request_intervals":
      case "furniture_use_favorite_rates":
      case "motion_rewards":
      case "pop_capture_time":
      case "room_motions":
      case "initial_motions":
        _setting[k] = decodeJSON(v);
        break;
      case "disable_tutorial":
        _setting[k] = (v >= 1);
        break;
      default:
        _setting[k] = v;
      }

    }
    return _setting;
  }

  function getFirstCostumeIDs() {
    return this.first_costume_ids;
  }

  function getDefaultCharaActions() {
    return this.default_chara_actions;
  }

  function calcShortenRMProduct(time) {
    if (time <= 0) return 0;
    local rm = time / this.shorten_product_per_sec + 1;
    return rm;
  }

  function calcShortenRMWork(time) {
    if (time <= 0) return 0;
    local rm = time / this.shorten_work_per_sec + 1;
    return rm;
  }

  function getFavoriteRateFurnitureUse(favorite) {
    if (this.furniture_use_favorite_rates.len() <= favorite) return 0;
    return this.furniture_use_favorite_rates[favorite];
  }

  function getMotionRewardInfo(idx) {
    if (!this.motion_rewards || idx < 0 || idx >= this.motion_rewards.len()) return null;
    return this.motion_rewards[idx];
  }

  function getCaptureRandomTime() {
    if (!this.pop_capture_time || this.pop_capture_time.len() < 1) return 0;
    return this.pop_capture_time[Math.rndi(this.pop_capture_time.len() - 1)];
  }

  function getCaptureTime() {
    return this.capture_time;
  }

  function getInitialTapGM() {
    return this.initial_tap_gm;
  }

  function getMaxAdVideoRewardCount() {
    return this.ad_video_rewards.len();
  }

  function canWatchAdVideo() {
    local _cnt = 0;
    return _cnt < this.ad_video_rewards.len();
  }

  function getWatchAdVideoReward(idx) {
    return this.ad_video_rewards[idx];
  }

  function getCharaSentenceSpecialRate() {
    return this.chara_sentence_special_rate;
  }

  function getBonusHeartRate() {
    return this.bonus_hapiness_rate
  }
  function getLevelupBonusRecoveryNum() {
    return this.levelup_bonus_recovery_num;
  }

  function disableTutorial() {
    return disable_tutorial;
  }

  function getRoomMotions() {
    return this.room_motions;
  }

  function getInitialMotions() {
    return this.initial_motions;
  }
}