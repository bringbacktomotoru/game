class CharaSentenceListSetting extends ::Setting {

  static PRIORITY_NORMAL = 0;
  static PRIORITY_HIGH = 1;
  static PRIORITY_HIGHEST = 2;
  static PRIORITY_SPECIAL = 10;

  static DEFAULT_NEXT_TIME = 2000;

  id = null;
  sentence_table = null;

  conditions = null;
  priority = null;

  prev_action = null;
  disable_skip = false;

  function getTranslateTarget() {
    local trans = [];

    if (sentence_table) trans + TranslateTextInfo(this, "sentence_table", TranslateTextInfo.WILD_CARD, TranslateTextInfo.WILD_CARD, "sentence");

    return trans;
  }

  function getID() {
    return this.id;
  }

  function getPrevAction() {
    return this.prev_action;
  }

  function getSentenceList(chara_key) {
    return this.sentence_table[chara_key] || null;
  }

  function checkCondition() {
    if (!conditions) return true;
    return ::checkCondition(this.conditions, ::gamesetting.chara_sentence_list_condition_settings);
  }

  function getPriority() {
    return this.priority;
  }

  function isDisableSkip() {
    return this.disable_skip;
  }
}