class HelpSetting extends Setting {
  id = null;
  title = null;
  desc = null;
  image_list = null;
  image_path_list = null
  tutorial_id = -1;

  function loadConfAtServer(t) {
    local _setting = TutorialSetting();

    foreach (k, v in t) {
      switch (k) {
      case "image_list":
        _setting[k] = decodeJSON(v);
        break;
      default:
        _setting[k] = v;
      }
    }

    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (title) trans + "title";
    if (desc) trans + "desc";

    return trans;
  }

  function getID() {
    return this.id;
  }
  function getTitle() {
    return this.title;
  }
  function getDesc() {
    return this.desc;
  }
  function getImagePathList() {
    if (!this.image_list) return [];

    if (!this.image_path_list) {
      this.image_path_list = [];
      foreach (image in this.image_list) {
        this.image_path_list + ("/image/tutorial/" + ::READ_TRANS_FILE + "/" + image);
      }
    }
    return this.image_path_list;
  }

  function canAdd() {
    if (this.tutorial_id < 0) return true;
    return ::gamesession.getUserData().isEndTutorialId(this.tutorial_id);
  }
}