class MenuButtonSetting extends ::Setting {
  id = 0;

  key = null;
  panel_key = null;
  name = null;
  icon_id = 0;
  back_ground_id = 0;

  function loadConfAtServer(t) {
    local _setting = HomeMenuSetting();

    foreach (k, v in t) {
      _setting[k] = v;
    }
    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (name) trans + "name";
    return trans;
  }

  function getID() {
    return this.id;
  }

  function getKey() {
    return this.key;
  }

  function getName() {
    if (!this.name) return "no text";
    return this.name;
  }

  function getPanelKey() {
    return this.panel_key;
  }

  function getIconSprite() {
    local _path = "/image/icon/menu/menu/icon_" + this.icon_id + ".png";
    local _sp = ::getSprite(_path);
    _sp.blend = SK_MIX;
    return _sp;
  }

  function getBackGroundSprite() {
    local _path = "/image/icon/menu/menu/bg_" + this.back_ground_id + ".png";
    local _sp = ::getSprite(_path);
    _sp.blend = SK_MIX;
    return _sp;
  }
}