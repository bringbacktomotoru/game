::KSRightPanel <- class extends ::KSRightPanel {
  lbl_pnl_name = null;
  f_pnl_name = null;

  f_cos_id = null;
  f_pms_id = null;
  f_room_id = null;

  constructor(v) {
    super(v);

    local lbl_ui = SKLabelView("-- UI --------------------", FontAttribute(Fonts.ui, 16, 255, 2));
    lbl_ui.setRect(10, 220, 10, 10);
    addChild(lbl_ui);

    lbl_pnl_name = SKLabelView("PANEL :", FontAttribute(Fonts.ui, 12, 255, 0));
    lbl_pnl_name.setRect(14, 245, 10, 10);
    addChild(lbl_pnl_name);

    f_pnl_name = SKTextField("");
    f_pnl_name.setRect(70, 245, 150, 20);
    addChild(f_pnl_name);
    f_pnl_name.addEventListener(ACTION_EVENT, actionevent2);

    local lbl_cos_id = SKLabelView("COS ID :", FontAttribute(Fonts.ui, 12, 255, 0));
    lbl_cos_id.setRect(14, 275, 10, 10);
    addChild(lbl_cos_id);

    f_cos_id = SKTextField("109001");
    f_cos_id.setRect(70, 275, 150, 20);
    addChild(f_cos_id);
    f_cos_id.addEventListener(ACTION_EVENT, actionevent2);

    local lbl_pms_id = SKLabelView("PMS ID :", FontAttribute(Fonts.ui, 12, 255, 0));
    lbl_pms_id.setRect(14, 305, 10, 10);
    addChild(lbl_pms_id);

    f_pms_id = SKTextField("");
    f_pms_id.setRect(70, 305, 150, 20);
    addChild(f_pms_id);
    f_pms_id.addEventListener(ACTION_EVENT, actionevent2);
  }

  function actionevent(e) {
    switch (e.src) {
    case reloadbtn:
      editor.reloadFile();
      break;
    case savebtn:
      editor.saveFile();
      break;
    case testbtn:
      ::screenWidth = ::HDWidth;
      editor.startTest(::screenWidth, ::screenHeight);
      break;
    case testbtn_i:
      ::screenWidth = ::iPadWidth;
      editor.startTest(::iPadWidth, ::screenHeight);
      break;
    }
  }

  function actionevent2(e) {
    e.consume();
  }
}