with PMRightPanel {
  rectedit <- null;

  constructor <- function(e) {

    pos = Vector3D();
    scale = Vector3D(1, 1, 1);
    rot = Vector3D();
    bnd = Rect2D(0, 0, 10, 10);
    mat = Matrix();

    editor = e;
    bnd.w = 300;

    local filepanel = SKImageView();
    filepanel.setColor(0xebeff3ff);
    filepanel.setRect(2, 2, 256, 66);
    filepanel.setBuffer(true);
    filepanel.enabled = true;
    addChild(filepanel);

    reloadbtn = SKLabelButton("RELOAD");
    reloadbtn.setRect(8, 4, 80, 24);
    filepanel.addChild(reloadbtn);

    savebtn = SKLabelButton("SAVE");
    savebtn.setRect(172, 4, 80, 24);
    filepanel.addChild(savebtn);

    tabs = SKTabView();
    tabs.flags = 0;
    tabs.setRect(0, 38, 300, 26);
    addChild(tabs);
    tabs.addTab("Material");
    tabs.addTab("Parts");
    tabs.addTab("Shapes");
    tabs.addTab("Rect");

    scroll = SKScrollPane();
    scroll.setClipAreaColor(0xebeff3ff);
    scroll.setRect(0, 134, 260, 216);
    addChild(scroll);

    materialedit = PMMaterialEditor(editor);
    scroll.setContent(materialedit);

    shapeedit = PMShapeEditor(editor);

    partsedit = PMPartsEditor(editor);
    rectedit = PMRectEditor(editor);

    addEventListener(ACTION_EVENT, actionevent);
    addEventListener(ITEM_EVENT, actionevent);

  }

  function setPolygonMesh(p) {
    materialedit.setPolygonMesh(p);
    shapeedit.setPolygonMesh(p);
    partsedit.setPolygonMesh(p);
    rectedit.setPolygonMesh(p);
  }

  function setVisibleRectWire(b) {
    rectedit.setVisibleRectWire(b);
  }

  function actionevent(e) {
    switch (e.src) {
    case savebtn:
      savePolygonMesh();
      break;
    case reloadbtn:
      reloadPolygonMesh();
      break;
    case tabs:
      switch (tabs.getSelectedIndex()) {
      case 0:
        scroll.setContent(materialedit);
        scroll.repaint();
        break;
      case 1:
        scroll.setContent(partsedit);
        scroll.repaint();
        break;
      case 2:
        scroll.setContent(shapeedit);
        scroll.repaint();
        break;
      case 3:
        scroll.setContent(rectedit);
        scroll.repaint();
      }
      break;
    }
  }
}