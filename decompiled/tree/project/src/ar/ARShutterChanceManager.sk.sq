class ARShutterChanceManager extends SKView {
  viewer = null;
  ar_panel = null;

  static SHUTTER_CHANCE_STATE_NONE = 0;
  static SHUTTER_CHANCE_STATE_WAIT = 1;
  static SHUTTER_CHANCE_STATE_START_IN = 2;
  static SHUTTER_CHANCE_STATE_START_OUT = 3;
  shutter_chance_state = 0;

  shutter_chance_chara = null;
  shutter_chance_start = -1;

  add_game_money = -1;

  target_chara_model = null;

  static STATE_CHANGE_INTERVAL = 2500;
  state_interval = -1;

  constructor(viewer) {
    this.viewer = viewer;
    _updateShutterChanceTime();
  }

  function setARPanel(pnl) {
    this.ar_panel = pnl;
  }

  function getShutterChanceState() {
    return this.shutter_chance_state;
  }

  function getShutterChanceModel() {
    return this.shutter_chance_chara;
  }

  function isShutterChance(m) {
    if (!m || this.shutter_chance_chara != m) return false;
    if (this.shutter_chance_state != SHUTTER_CHANCE_STATE_WAIT &&
    this.shutter_chance_state != SHUTTER_CHANCE_STATE_START_IN &&
    this.shutter_chance_state != SHUTTER_CHANCE_STATE_START_OUT) return false;
    return true;
  }

  function isShutterChanceStarting() {
    if (this.shutter_chance_state != SHUTTER_CHANCE_STATE_START_IN &&
    this.shutter_chance_state != SHUTTER_CHANCE_STATE_START_OUT) return false;
    return true;
  }

  function getAddGameMoney() {
    return this.add_game_money;
  }

  function resetAddGameMoney() {
    this.add_game_money = -1;
  }

  function executeCapture() {
    if (this.shutter_chance_state != SHUTTER_CHANCE_STATE_START_IN) return false;

    local _result = ::gamesession.executeCaptureHapiness(0);
    if (!_result) {

      _captureFail();
      return false;
    }

    ::gamesession.getUserData().setCaptureHapinessTime(_result.next);
    this.add_game_money = _result.reward

    _updateShutterChanceTime();
    this.shutter_chance_state = SHUTTER_CHANCE_STATE_NONE;

    return true;
  }

  function enableShutterChanceTime() {
    return ::gamesession.getUserData().getCaptureHapinessTime() < ::getServerTime();
  }

  function challengeShutterChance(m) {

    if (!m ||
    this.target_chara_model ||
    this.shutter_chance_state != SHUTTER_CHANCE_STATE_NONE ||
    !enableShutterChanceTime()
    ) return;

    if (Math.rndi(100) > 50) return;

    this.target_chara_model = m;
    this.shutter_chance_start = ::getServerTime() + 5;
  }

  function update(dt) {

    switch (this.shutter_chance_state) {
    case SHUTTER_CHANCE_STATE_NONE: _updateNone(); break;
    case SHUTTER_CHANCE_STATE_WAIT: _updateWait(); break;
    case SHUTTER_CHANCE_STATE_START_IN: _updateStartIn(); break;
    case SHUTTER_CHANCE_STATE_START_OUT: _updateStartOut(); break;
    }
  }

  function _updateNone() {
    local _st = ::getServerTime();

    if (this.shutter_chance_start < _st) {

      if (!enableShutterChance()) {
        _updateShutterChanceTime();
        return;
      }

      local _cm = this.target_chara_model ? this.target_chara_model : this.viewer.getRandomCharaModel();
      this.target_chara_model = null;
      if (!_cm) {

        _updateShutterChanceTime();
        return;
      }
      this.shutter_chance_start = _st;
      this.shutter_chance_state = SHUTTER_CHANCE_STATE_WAIT;
      this.shutter_chance_chara = _cm;
    }
  }

  function _updateWait() {

    if (!enableShutterChance()) {
      _resetShutterChance();
      return;
    }

    if (!this.shutter_chance_chara) {
      _captureFail();
      return;
    }

    if (this.shutter_chance_chara.isInBroadCenter()) {
      this.shutter_chance_state = SHUTTER_CHANCE_STATE_START_IN;
      this.state_interval = skGetTime() + STATE_CHANGE_INTERVAL;
      this.ar_panel.showShutterFrame();
      this.ar_panel.showShutterChanceDesc();
      return;
    }
  }

  function _updateStartIn() {

    if (!this.shutter_chance_chara) {
      _captureFail();
      return;
    }

    if (this.state_interval < skGetTime() && !this.shutter_chance_chara.isInBroadCenter()) {
      this.shutter_chance_state = SHUTTER_CHANCE_STATE_START_OUT;
      this.state_interval = skGetTime() + STATE_CHANGE_INTERVAL;
      this.ar_panel.hideShutterFrame();
    }

    if (this.shutter_chance_start + ::gamesetting.game_rule.getCaptureTime() < ::getServerTime() && this.state_interval < skGetTime()) {
      this.ar_panel.hideShutterFrame();
      _captureFail();
    }
  }

  function _updateStartOut() {

    if (!this.shutter_chance_chara) {
      _captureFail();
      return;
    }

    if (this.state_interval < skGetTime() && this.shutter_chance_chara.isInBroadCenter()) {
      this.shutter_chance_state = SHUTTER_CHANCE_STATE_START_IN;
      this.state_interval = skGetTime() + STATE_CHANGE_INTERVAL;
      this.ar_panel.showShutterFrame();
    }

    if (this.shutter_chance_start + ::gamesetting.game_rule.getCaptureTime() < ::getServerTime()) {
      this.ar_panel.hideShutterFrame();
      _captureFail();
    }
  }

  function _captureFail() {

    local _next_time = ::gamesession.updateCaptureHapinessTime();
    if (_next_time < 0) {

      _updateShutterChanceTime();
      this.shutter_chance_state = SHUTTER_CHANCE_STATE_NONE;
      return;
    }
    this.ar_panel.setShutterChanceDescVisible(false);
    ::gamesession.getUserData().setCaptureHapinessTime(_next_time);
    _updateShutterChanceTime();
    this.shutter_chance_state = SHUTTER_CHANCE_STATE_NONE;
  }

  function _resetShutterChance() {
    this.shutter_chance_state = SHUTTER_CHANCE_STATE_NONE;
    _updateShutterChanceTime();
  }

  function _updateShutterChanceTime() {
    if (this.ar_panel) this.ar_panel.setShutterChanceDescVisible(false);
    local _ct = ::gamesession.getUserData().getCaptureHapinessTime();
    local _st = ::getServerTime();
    if (_ct < _st) _ct = _st;
    this.shutter_chance_start = _ct + ::gamesetting.game_rule.getCaptureRandomTime();
  }

  function enableShutterChance() {
    if (this.ar_panel) {
      if (!this.ar_panel.isDetecting() ||
      this.ar_panel.isCapture() ||
      this.ar_panel.getCaptureState() == ::ARPanel.CAPTURE_STATE_VIDEO ||
      this.ar_panel.reachedCaptureLimit()
      )
      return false;
    }
    return true;
  }
}