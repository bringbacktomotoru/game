class MouseEventManager {
  event_limit = null;
  keepers = null;

  v_1 = Vector3D();
  v_2 = Vector3D();

  static PINCH_ANGLE = 30;

  constructor(limit) {
    this.event_limit = limit;
    this.keepers = [];
  }

  function mouseevent(event) {

    switch (event.id / 100) {
    case MOUSE_EVENT:
      _putMouseEvent(event);
      break;

    default:
      break;
    }
  }

  function refresh() {

    foreach (idx, k in this.keepers) {
      if (k.isReleased()) delete this.keepers[idx];
    }
  }

  function refreshAll() {
    this.keepers.clear();
  }

  function isMultiTapped() {
    local count = 0;
    foreach (k in this.keepers) {
      if (k.isReleased() || !k.enableMultitouch()) continue;

      count++;
      if (count >= 2) return true;
    }
    return false;
  }

  function getLastEvent() {

    local last_keeper = this.keepers[length(keepers) - 1];
    if (!last_keeper) return null;

    return last_keeper.getLastEvent();
  }

  function _getEventKeeperIdx(mouseid) {
    foreach (idx, k in keepers) {
      if (k.getID() != mouseid) continue;

      return idx;
    }
    return -1;
  }

  function isDragged() {
    foreach (keeper in keepers) {
      if (keeper.isReleased()) continue;
      if (keeper.isDragged()) return true;
    }
    return false;
  }

  function isDraggedLastKeeper() {
    local last_keeper = this.keepers[length(this.keepers) - 1];
    if (!last_keeper) return false;

    return last_keeper.isDragged();
  }

  function getDragVec() {

    local last_keeper = this.keepers[length(this.keepers) - 1];
    if (!last_keeper) return Vector3D(0.0, 0.0, 0.0);

    return _createDragDistVec(last_keeper);
  }

  function isPinched(pinch_angle = -1) {
    if (pinch_angle == -1) pinch_angle = PINCH_ANGLE;
    local keeper0 = this.keepers[0];
    local keeper1 = this.keepers[1];
    if (!keeper0 || !keeper1) return false;

    local ret = _isPinched(keeper0, keeper1, pinch_angle);

    return ret;
  }

  function getPinchRate() {

    local keeper0 = this.keepers[0];
    local keeper1 = this.keepers[1];
    if (!keeper0 || !keeper1) return 1.0;

    return _calcPinchRate(keeper0, keeper1);
  }

  function isMultiDragged(pinch_angle = -1) {
    if (pinch_angle == -1) pinch_angle = PINCH_ANGLE;
    if (!isMultiTapped()) return false;

    local keeper0 = this.keepers[0];
    local keeper1 = this.keepers[1];
    if (!keeper0 || !keeper1) return false;

    if (!_isDragged(keeper0, keeper1, pinch_angle)) return false;
    if (!keeper0.isMultiDragDist()) return false;
    if (!keeper1.isMultiDragDist()) return false;

    return true;
  }

  function getMultiDraggedVec() {
    if (!isMultiTapped()) return null;
    local vec = Vector3D(0, 0, 0);
    local keeper_vec = Vector3D();

    foreach (keeper in keepers) {
      keeper_vec.set(keeper.getMultiDragVec());
      if (vec.length() < keeper_vec.length()) vec.set(keeper_vec);
    }

    return vec;
  }

  function _putMouseEvent(event) {
    local idx = _getEventKeeperIdx(event.mouseid);
    local keeper = this.keepers[idx];
    if (keeper) {
      this.keepers + delete this.keepers[idx];
    }
    else {
      if (idx == -1) while (length(this.keepers) >= this.event_limit) {
        delete this.keepers[0];
      }

      keeper = Keeper(event.mouseid);
      this.keepers + keeper;
    }

    keeper.putEvent(event);
  }

  function _popMouseEvent(event) {
    local idx = _getEventKeeperIdx(event.mouseid);
    if (idx == -1) return;

    delete this.keepers[idx];
  }

  function _createDragDistVec(keeper) {
    local prev = keeper.event_history[length(keeper.event_history) - 2];
    local last = keeper.event_history[length(keeper.event_history) - 1];
    if (!prev || !last) return Vector3D(0.0, 0.0, 0.0);

    return Vector3D(last.x - prev.x, last.y - prev.y, 0.0);
  }

  function _isPinched(keeper0, keeper1, pinch_angle) {
    local prev0 = keeper0.event_history[length(keeper0.event_history) - 2];
    local prev1 = keeper1.event_history[length(keeper1.event_history) - 2];
    local last0 = keeper0.event_history[length(keeper0.event_history) - 1];
    local last1 = keeper1.event_history[length(keeper1.event_history) - 1];

    if (!prev0 || !prev1 || !last0 || !last1) return false;

    v_1.set(last0.x, last0.y, 0).sub(prev0.x, prev0.y, 0);
    v_2.set(last1.x, last1.y, 0).sub(prev1.x, prev1.y, 0);

    local _len1 = v_1.length();
    local _len2 = v_2.length();

    if (_len1 == 0 && _len2 == 0) return false;
    if (_len1 == 0 || _len2 == 0) {

      return true;
    }

    local dot = v_1.x * v_2.x + v_1.y * v_2.y;
    local _len = _len1 * _len2;
    local _cos = Math.clamp((dot / _len), -1, 1);
    local _angle = Math.acos(_cos) * 180 / Math.PI;

    return _angle > pinch_angle ? true : false;
  }

  function _isDragged(keeper0, keeper1, pinch_angle) {
    local prev0 = keeper0.event_history[length(keeper0.event_history) - 2];
    local prev1 = keeper1.event_history[length(keeper1.event_history) - 2];
    local last0 = keeper0.event_history[length(keeper0.event_history) - 1];
    local last1 = keeper1.event_history[length(keeper1.event_history) - 1];

    if (!prev0 || !prev1 || !last0 || !last1) return false;

    v_1.set(last0.x, last0.y, 0).sub(prev0.x, prev0.y, 0);
    v_2.set(last1.x, last1.y, 0).sub(prev1.x, prev1.y, 0);

    local _len1 = v_1.length();
    local _len2 = v_2.length();

    if (_len1 == 0 && _len2 == 0) return false;
    if (_len1 == 0 || _len2 == 0) {

      return false;
    }

    local dot = v_1.x * v_2.x + v_1.y * v_2.y;
    local _len = _len1 * _len2;
    local _cos = Math.clamp((dot / _len), -1, 1);
    local _angle = Math.acos(_cos) * 180 / Math.PI;

    return _angle < pinch_angle ? true : false;
  }

  function _calcMultiDraggAngle(keeper0, keeper1) {
    local prev0 = keeper0.event_history[length(keeper0.event_history) - 2];
    local prev1 = keeper1.event_history[length(keeper1.event_history) - 2];
    local last0 = keeper0.event_history[length(keeper0.event_history) - 1];
    local last1 = keeper1.event_history[length(keeper1.event_history) - 1];

    if (!prev0 || !prev1 || !last0 || !last1) return -1;

    v_1.set(last0.x, last0.y, 0).sub(prev0.x, prev0.y, 0);
    v_2.set(last1.x, last1.y, 0).sub(prev1.x, prev1.y, 0);
  }

  function _calcPinchRate(keeper0, keeper1) {
    local prev0 = keeper0.event_history[length(keeper0.event_history) - 2];
    local prev1 = keeper1.event_history[length(keeper1.event_history) - 2];
    local last0 = keeper0.event_history[length(keeper0.event_history) - 1];
    local last1 = keeper1.event_history[length(keeper1.event_history) - 1];
    if (!prev0 || !prev1 || !last0 || !last1) return 1.0;

    local p_dist = Math.sqrt((prev1.x - prev0.x) * (prev1.x - prev0.x) + (prev1.y - prev0.y) * (prev1.y - prev0.y)) * ::getDisplayScale();
    local l_dist = Math.sqrt((last1.x - last0.x) * (last1.x - last0.x) + (last1.y - last0.y) * (last1.y - last0.y)) * ::getDisplayScale();

    return l_dist / p_dist;
  }

  function __debugPrint() {
    if (!::DEBUG) return;

    print("==== debug print ====================================================\n")
    print("multi tap num " + length(this.keepers) + "\n");
    foreach (idx, k in keepers) {
      print(" >> keeper" + idx + "\n");
      foreach (idx, eh in k.event_history) {
        print("\t" + idx + " >> (e(" + eh + ") " + __getEventLog(eh) + ")\n")
      }
    }
    print("====================================================================\n\n\n")
  }

  function __debugPrintEvent(e) {
    local log = __getEventLog(e);
    print(log + "\n");
  }

  function __getEventLog(e) {
    local log = "src:" + e.src + ", mouseid:" + e.mouseid + ", event:";
    switch (e.id) {
    case MOUSE_PRESSED: log = log + "MOUSE_PRESSED  "; break;
    case MOUSE_RELEASED: log = log + "MOUSE_RELEASED  "; break;
    case MOUSE_DRAGGED: log = log + "MOUSE_DRAGGED  "; break;
    case MOUSE_MOVED: log = log + "MOUSE_MOVED  "; break;
    default: log = log + "unknown event, id:" + e.id + "  "; break;
    }
    log = log + "e.x:" + e.x + ", e.y:" + e.y;

    return log;
  }

  function __getEventIDString(e) {
    switch (e.id) {
    case MOUSE_PRESSED: return "MOUSE_PRESSED  "; break;
    case MOUSE_RELEASED: return "MOUSE_RELEASED  "; break;
    case MOUSE_DRAGGED: return "MOUSE_DRAGGED  "; break;
    case MOUSE_MOVED: return "MOUSE_MOVED  "; break;
    default: return "unknown event, id:" + e.id + "  "; break;
    }
  }
}

class MouseEventManager.Keeper {
  static history_limit = 4;
  static SWITCH_DRAG_DIST = 10.0;
  static MULTI_DRAG_DIST = 50.0;
  static LONG_TAP_TIME = 1500;

  mouseid = null;
  start_event = null;
  event_history = null;

  is_dragged = false;

  constructor(mouseid) {
    this.mouseid = mouseid;
    this.event_history = [];
  }

  function putEvent(event) {
    if (this.isReleased()) {

      clearHistory();
    }
    else {
      while (length(this.event_history) >= this.history_limit) {
        delete this.event_history[0];
      }
    }

    if (!this.start_event || this.isPressed()) {
      this.start_event = event;
      this.is_dragged = false;
    }

    local last_event = getLastEvent();
    local is_add_event = true;
    if (last_event && last_event.id == MOUSE_PRESSED) {
      if (event.id == MOUSE_DRAGGED
      && last_event.x == event.x
      && last_event.y == event.y) {
        is_add_event = false;
      }
    }

    if (is_add_event) this.event_history + event;

    if (::MouseEventManager.Keeper.isDragDist(start_event.x, start_event.y, event.x, event.y)) {
      this.is_dragged = true;
    }
  }

  function getID() {
    return mouseid;
  }

  function getLastEvent() {
    return this.event_history[length(this.event_history) - 1] || null;
  }

  function isPressed() {
    local last_event = this.event_history[length(this.event_history) - 1];
    return last_event && last_event.id == MOUSE_PRESSED;
  }

  function isReleased() {
    local last_event = this.event_history[length(this.event_history) - 1];
    return last_event && last_event.id == MOUSE_RELEASED;
  }

  function enableMultitouch() {
    local last_event = this.event_history[length(this.event_history) - 1];
    return last_event && last_event.src.multitouch;
  }

  function isDragged() {
    return this.is_dragged;
  }

  function clearHistory() {
    this.start_event = null;
    this.event_history.clear();
  }

  function getMultiDragVec() {
    if (!start_event) return Vector(0, 0, 0);

    local last_event = this.getLastEvent();
    return Vector3D(start_event.x, start_event.y, 0.0).sub(last_event.x, last_event.y, 0.0);
  }

  static function isDragDist(start_x, start_y, current_x, current_y) {
    return Vector3D(start_x, start_y, 0.0).sub(current_x, current_y, 0.0).length() > ::MouseEventManager.Keeper.SWITCH_DRAG_DIST;
  }

  function isMultiDragDist() {
    if (!start_event) return false;

    local last_event = this.getLastEvent();
    return getMultiDragVec().length() > ::MouseEventManager.Keeper.MULTI_DRAG_DIST;
  }
}