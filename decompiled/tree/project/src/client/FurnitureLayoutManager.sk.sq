class FurnitureLayoutManager {
  static FURNITURE_MODE_DIST = 1.0;

  stage = null;

  furniture_models = null;

  editor = null;

  constructor() {}

  function changeStage(stage) {
    this.stage = stage;
    this.furniture_models = {};
    this.editor = null;
  }

  function putAllFurnitures() {
    local ud = ::gamesession.getUserData();
    local room_layout = ud.room_layout;
    foreach (floor, layout in room_layout) {
      foreach (room, uid in layout) {
        if (uid == 0) continue;
        putFurnitures(floor, room);
      }
    }
  }

  function putFurnitures(floor, room) {
    local ud = ::gamesession.getUserData();
    local room_edit_data = ud.getRoomEditData_byRoomAddress(floor, room);
    _putFurnituresByRoomEditData(room_edit_data);

  }

  function _putFurnituresByRoomEditData(room_edit_data) {
    local origin = this.stage.getHouseManager().getHouseBasePos();
    foreach (layout in room_edit_data.getFurnitureLayouts()) {
      _putFurnitureProcess(origin, layout);
    }
  }

  function putFurnituresByRoomSlotIndex(slot_idx) {
    local ud = ::gamesession.getUserData();
    local edit_data = ud.getRoomEditDataBySlotIdx(slot_idx);
    _putFurnituresByRoomEditData(edit_data);
  }

  function putFurniture(uid, floor, room, layout) {
    local origin = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();
    _putFurnitureProcess(origin, layout);
  }

  function removeAllFurnitures() {
    local removed_uids = [];
    foreach (uid, _ in this.furniture_models) {
      local removed = _removeFurnitureProcess(uid);
      if (!removed) continue;

      removed_uids + uid;
    }
    foreach (uid in removed_uids) {
      delete this.furniture_models[uid];
    }
  }

  function removeFurniture(uid) {
    local removed = _removeFurnitureProcess(uid);
    if (!removed) return;

    delete this.furniture_models[uid];
  }

  function addFurnitureModel(m) {
    this.furniture_models[m.getFurnitureData().getUID()] <- m;
  }
  function removeFurnitureModel(uid) {
    delete this.furniture_models[uid];
  }

  function removeFurnituresIn(room_model) {
    foreach (uid, model in this.furniture_models) {
      if (!room_model.inBounds(model.getPos())) continue;

      model.release();
      removei;
    }
  }

  function updateFurnitures(floor, room) {
    local ud = ::gamesession.getUserData();
    local room_edit_data = ud.getRoomEditData_byRoomAddress(floor, room);
    local origin = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();
    foreach (layout in room_edit_data.getFurnitureLayouts()) {
      _updateFurnitureProcess(origin, layout);
    }
  }

  function getFurnitureModels() {
    return this.furniture_models;
  }

  function getFurnitureModel(uid) {
    if (uid in furniture_models) return furniture_models[uid];
    return null;
  }

  function existFurnitureModel(fm, can_product_check = false) {
    if (!fm) return false;
    if (!this.furniture_models) return false;
    if (!(fm.getFurnitureUID() in this.furniture_models)) return false;
    if (can_product_check && (!fm.getFurnitureData().canProduct() || !fm.canSelectedProduct())) return false;
    return true;
  }

  function getNearestModel(p, can_product_check = false, need_dist = -1, ignore_fm = null, furniture_type = null) {
    local _ret_fm = null;
    local _ret_dist = -1;
    foreach (fm in this.furniture_models) {
      if (ignore_fm && ignore_fm == fm) continue;
      if (can_product_check && (!fm.getFurnitureData().canProduct() || !fm.canSelectedProduct())) continue;
      if (furniture_type && furniture_type.indexOf(fm.getFurnitureSetting().getType()) < 0) continue;
      local _d = ::getDistance(p, fm.getPos());
      if (!_ret_fm || _ret_dist > _d) {
        _ret_fm = fm;
        _ret_dist = _d;
      }

      if (need_dist > _d) break;
    }
    return { fm = _ret_fm, dist = _ret_dist };
  }

  function getRandomModel(can_product_check = false, furniture_type = null) {
    local _list = [];
    foreach (fm in this.furniture_models) {
      if (can_product_check && (!fm.getFurnitureData().canProduct() || !fm.canSelectedProduct())) continue;
      if (furniture_type && furniture_type.indexOf(fm.getFurnitureSetting().getType()) < 0) continue;
      _list + fm;
    }
    if (_list.len() == 0) return null;
    return _list[Math.rndi(_list.len() - 1)];
  }

  function update(dt) {
    foreach (model in this.furniture_models) {
      model.update(dt);
    }
  }

  function startEdit(stage = null) {
    if (this.editor) revertEdit();

    if (stage) {
      local _room_edit = ::gamesession.getUserData().getCurrentRoomEditData();
      this.editor = Editor(stage, _room_edit);
      editor.stage_id = stage.getStageID();
    }
    else {
      this.editor = Editor.buildVirtual();
    }

    ::traceln("start house edit, editor : " + editor + ", stage : " + stage);
    return this.editor;
  }

  function setEditTmpGrids() {
    if (!this.editor) return;

    local floor = 0;
    local room = 0;
    local ud = ::gamesession.getUserData();
    local room_data = ud.getCurrentRoomEditData();
    this.stage.setEditTmpGrids(floor, room, this.editor.selected_furniture, this.editor.prev_layout_data != null);
  }

  function enableEditFurniture() {
    if (!this.editor) return true;

    local floor = 0;
    local room = 0;
    local ud = ::gamesession.getUserData();
    local room_data = ud.getCurrentRoomEditData();

    local _edit_info = [null, null];
    if (this.editor.prev_layout_data) {
      local _fm = getFurnitureModel(this.editor.prev_layout_data.getUID());
      if (_fm) _edit_info[0] = [this.editor.prev_layout_data, _fm.getFurnitureSetting()];
    }
    if (this.editor.selected_furniture) {
      _edit_info[1] = this.editor.selected_furniture;
    }
    return this.stage.enableEditFurniture(floor, room, _edit_info);
  }

  function applyEdit() {
    if (!this.editor) return;

    local floor = 0;
    local room = 0;
    local ud = ::gamesession.getUserData();
    local room_data = ud.getCurrentRoomEditData();

    local readies = {};
    foreach (layout in room_data.getFurnitureLayouts()) {
      local uid = layout.getUID();
      if (uid == -1) continue;

      local model = this.furniture_models[uid];
      if (!model) continue;

      model.setReady();
      readies[uid] <- model;
    }
    if (room_data.apply(this.editor.cloned_edit_data)) {
      putFurnitures(floor, room);

      local _edit_info = [null, null];
      if (this.editor) {
        if (this.editor.prev_layout_data) {
          local _fm = getFurnitureModel(this.editor.prev_layout_data.getUID());
          if (_fm) _edit_info[0] = [this.editor.prev_layout_data, _fm.getFurnitureSetting()];
        }
        if (this.editor.selected_furniture) _edit_info[1] = this.editor.selected_furniture;
      }
      this.stage.roomUpdated(floor, room, _edit_info);
    }

    foreach (uid, model in readies) {
      if (!model.isReady()) continue;

      model.release();
      delete this.furniture_models[uid];
    }
  }

  function revertEdit() {
    if (!this.editor) return;

    this.editor.revert();
  }

  function finishEdit() {
    if (!this.editor) return;

    this.revertEditor();
    this.editor = null;
    ::traceln("finish house edit")
  }

  function cancelEdit() {
    if (!this.editor) return;

    this.editor = null;
    ::traceln("cancel house edit")
  }

  function _putFurnitureProcess(base_pos, layout) {
    local uid = layout.getUID();
    local model = getFurnitureModel(uid);
    if (!model) {
      model = _createFurnitureModel(uid);
      this.furniture_models[uid] <- model;
    }
    model.setupLayout(base_pos, layout);
  }
  function _createFurnitureModel(uid) {
    local model = ::FurnitureModel(this.stage.scene);

    if (uid == -1) {

      local furniture_data = this.editor.shop_furniture_data;
      model.build(furniture_data);
    }
    else {

      local ud = ::gamesession.getUserData();
      local furniture_data = ud.getFurnitureData(uid);
      if (furniture_data) {
        local product_data = furniture_data.getProductData();
        if (product_data instanceof ::FurnitureDeliverData) {
          model.build(furniture_data, product_data.shop_id);
        }
        else {
          model.build(furniture_data);
        }
      }
    }

    return model;
  }

  function _removeFurnitureProcess(uid) {
    local model = getFurnitureModel(uid);
    if (!model) return false;
    if (contains(UIFurnitures, model.getFurnitureSettingId())) return false;

    model.release();
    return true;
  }

  function _updateFurnitureProcess(base_pos, layout) {
    local uid = layout.getUID();
    local model = getFurnitureModel(uid);
    if (!model) return;

    model.setupLayout(base_pos, layout);
  }
}

class FurnitureLayoutManager.Editor {

  static BOUND_FRONT = 1.0;

  stage = null;
  house_manager = null;
  furniture_models = null;
  selected_furniture = null;

  cloned_edit_data = null;
  stage_id = 0;

  room_info = null;

  shop_furniture_data = null;
  prev_layout_data = null;

  constructor(stage, edit_data) {
    this.stage = stage;
    this.house_manager = stage.house_manager;
    this.cloned_edit_data = clone edit_data;
    this.furniture_models = {};
    this.room_info = house_manager.getCurrentRoom();
  }

  static function buildVirtual() {
    local virtual_stage = ::StageScene();
    virtual_stage.renderer.camera.perspective(30.0, ::displayWidth / ::displayHeight, 1.0, 100.0);

    local camera_work = virtual_stage.getCameraWork();

    local ud = ::gamesession.getUserData();
    local edit_data = ud.getCurrentRoomEditData();

    local editor = ::FurnitureLayoutManager.Editor(virtual_stage, edit_data);

    editor.stage_id = virtual_stage.getStageID();

    foreach (layout in edit_data.getFurnitureLayouts()) {
      editor.addFurniture(layout.getUID(), layout.x, layout.y, layout.z, layout.angle);
    }

    return editor;
  }

  function setCameraTest() {
    local camera_work = stage.getCameraWork();
    local origin = ::HouseManager.Factory.getRoomPartOrigin(0, 0);
    camera_work.moveTo(origin.x, origin.y + 19.0, origin.z - 0.5);
    camera_work.rotateTo(0.0, Math.PI / 2.001, 0.0);
  }

  function _isInFurnitureBound(model, v) {
    local layout_data = model.getLayoutData();
    local setting = model.getFurnitureSetting();

    if (v.x < layout_data.x + setting.size_origin_x - setting.size_w / 2.0) return false;
    if (v.z < layout_data.z + setting.size_origin_z - setting.size_d / 2.0) return false;

    if (v.x > layout_data.x + setting.size_origin_x + setting.size_w / 2.0) return false;
    if (v.z > layout_data.z + setting.size_origin_z + setting.size_d / 2.0) return false;

    return true;
  }

  function _inBoundsPos(bnd, pos) {
    return bnd.x - bnd.r < pos.x && bnd.x + bnd.r > pos.x
    && bnd.y - bnd.s < pos.y && bnd.y + bnd.s > pos.y
    && bnd.z - bnd.t < pos.z && bnd.z + bnd.t > pos.z;
  }

  function getTappedFurniture(screen_x, screen_y) {
    local furniture_origin = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();
    foreach (model in this.furniture_models) {
      local layout_data = model.getLayoutData();
      local furniture_setting = model.getFurnitureSetting();

      local v = _s2wPos(this.stage.renderer.camera, screen_x, screen_y, furniture_origin.y + layout_data.y);
      v.sub(furniture_origin.x, furniture_origin.y, furniture_origin.z);

      if (!_isInFurnitureBound(model, v)) continue;

      return model;
    }
  }

  function selectTappedFurniture(screen_x, screen_y) {
    deselectFurniture();

    local furniture = getTappedFurniture(screen_x, screen_y);
    if (furniture) {
      local furniture_uid = furniture.getFurnitureData().getUID();
      selectFurniture(furniture_uid);
      _setupPreviousLayoutData(furniture_uid);
    }

  }

  function selectFurniture(furniture_uid) {
    local furniture = this.furniture_models[furniture_uid];
    if (!furniture) return;

    this.selected_furniture = furniture;
    this.selected_furniture.select();
    local furniture_uid = this.selected_furniture.getFurnitureData().getUID();
  }

  function deselectFurniture() {
    if (this.selected_furniture) {
      this.selected_furniture.deselect();
      this.selected_furniture = null;

      _clearPreviousLayoutData();
    }
  }

  function editFurniture_byScreen(start_x, start_y, x, y) {
    if (!this.selected_furniture) return;

    local furniture_uid = this.selected_furniture.getFurnitureData().getUID();
    switch (this.selected_furniture.getLayoutMode()) {
    case ::FurnitureModel.MODE_MOVE:
      moveFurnitureTo_screenPos(furniture_uid, x, y);
      break;
    case ::FurnitureModel.MODE_ROTATE:
      rotateFurniture_screenPos(furniture_uid, start_x, x);
      break;
    default:
      break;
    }
  }

  function getFurnitureScreenPosByUID(furniture_uid) {
    local model = this.furniture_models[furniture_uid];
    if (!model) return null;

    return _w2sPos(this.stage.renderer.camera, model.getPos());
  }

  function putShopFurniture_screenPos(shop_id, screen_x, screen_y) {

    local furniture_origin = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();
    local v = _s2wPos(this.stage.renderer.camera, screen_x, screen_y, furniture_origin.y).sub(furniture_origin.x, furniture_origin.y, furniture_origin.z);

    local shop_setting = ::gamesetting.shop_settings[shop_id];
    if (!shop_setting || shop_setting.type != SHOP_ITEM_TYPE_FURNITURE) return;

    if (this.shop_furniture_data) {
      this.shop_furniture_data = null;
      removeFurniture(-1);
    }

    this.shop_furniture_data = ::FurnitureData().init(-1, shop_setting.item_id, shop_setting.getRoomID());
    addFurniture(shop_furniture_data.uid, v.x, v.y, v.z, 0);
  }

  function putFurniture_screenPos(furniture_uid, screen_x, screen_y) {

    local furniture_origin = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();
    local v = _s2wPos(this.stage.renderer.camera, screen_x, screen_y, furniture_origin.y).sub(furniture_origin.x, furniture_origin.y, furniture_origin.z);
    addFurniture(furniture_uid, v.x, v.y, v.z, 0);
  }

  function moveFurnitureTo_screenPos(furniture_uid, screen_x, screen_y) {

    local furniture_origin = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();
    local v = Vector3D(0, 0, 0);

    v = _s2wPos(this.stage.renderer.camera, screen_x, screen_y, furniture_origin.y);
    v.sub(furniture_origin.x, furniture_origin.y, furniture_origin.z);
    moveFurnitureTo(furniture_uid, v.x, v.y, v.z);
  }

  function rotateFurniture_screenPos(furniture_uid, start_x, x) {
    local angle = (start_x - x) / 2.0;
    rotateUIDsFurniture(furniture_uid, angle);
  }

  function removeSelectedFurniture() {
    if (!this.selected_furniture) return -1;

    _clearPreviousLayoutData();
    local furniture_uid = this.selected_furniture.getFurnitureData().getUID();
    removeFurniture(furniture_uid);
    return furniture_uid;
  }

  function _createFurniture(furniture_uid, layout_data) {

    local ud = ::gamesession.getUserData();
    local uid = layout_data.getUID();
    local floor = 0;
    local room = 0;
    this.house_manager.furniture_layout_manager.putFurniture(uid, floor, room, layout_data);

    local furniture_data = ud.getFurnitureData(uid);

    local _builts = this.house_manager.furniture_layout_manager.furniture_models;
    this.furniture_models[furniture_uid] <- _builts[furniture_uid];
  }
  function addFurniture(furniture_uid, posx, posy, posz, angle) {
    local layout_data = this.cloned_edit_data.getFurnitureLayoutData(furniture_uid);
    if (!layout_data) {
      layout_data = ::FurnitureLayoutData.create(furniture_uid);
      this.cloned_edit_data.addFurniture(layout_data);
    }
    moveFurnitureTo(furniture_uid, posx, posy, posz);
    rotateUIDsFurniture(furniture_uid, angle);

    local furniture_model = this.furniture_models[furniture_uid];
    if (!furniture_model) {
      _createFurniture(furniture_uid, layout_data);
    }

    revertFurnitureLayout();
    ::traceln("furniture added, uid : " + furniture_uid);
  }

  function addBuiltFurnitures() {
    local _builts = this.house_manager.furniture_layout_manager.furniture_models;
    foreach (built in _builts) {
      local _uid = built.getFurnitureData().getUID();
      if (!this.furniture_models[_uid]) this.furniture_models[_uid] <- built;
    }
  }

  function moveFurnitureTo(furniture_uid, posx, posy, posz) {
    local layout_data = this.cloned_edit_data.getFurnitureLayoutData(furniture_uid);
    if (!layout_data) {
      ::errorln("layout_data not found : " + furniture_uid)
      return;
    }

    local furniture_model = this.furniture_models[furniture_uid];
    if (!furniture_model) {
      ::errorln("furniture_model not found : " + furniture_uid)
      return;
    }

    local ud = ::gamesession.getUserData();
    local furniture_data = null;
    if (furniture_uid == -1) {

      furniture_data = this.shop_furniture_data;
    }
    else {
      furniture_data = ud.getFurnitureData(furniture_uid);

    }
    local furniture_setting = ::gamesetting.furniture_settings[furniture_data.getID()];
    local _gl = ::FurnitureLayoutManager.FURNITURE_MODE_DIST;
    posx = posx - (posx % _gl);
    posy = posy - (posx % _gl);
    posz = posz - (posx % _gl);
    local _fpos = { x = posx, z = posz };

    calcFurniturePos(layout_data, furniture_setting, posx, posy, posz);

    furniture_model.setupLayout(furniture_model.base_pos, layout_data);
    furniture_model.applyLayout();

  }

  function calcFurniturePos(layout_data, furniture_setting, posx, posy, posz) {

    switch (furniture_setting.place) {
    case ::FurnitureSetting.PLACE_WALL:
      local room_half_width = ::RoomModel.ROOM_WIDTH / 2.0;
      local room_thickness = ::RoomModel.WALL_THICKNESS;
      local room_depth_space = ::RoomModel.ROOM_DEPTH - FurnitureLayoutManager.Editor.BOUND_FRONT;
      local a = room_depth_space / (room_half_width - room_thickness);
      local b1 = a * room_half_width;
      local b2 = FurnitureLayoutManager.Editor.BOUND_FRONT;
      if (posz >= Math.abs(a * posx - b1) + b2) {

        layout_data.x = posx;
        layout_data.z = ::RoomModel.ROOM_DEPTH;
        layout_data.angle = 0;
      }
      else {

        local d = furniture_setting.size_d / 2.0;
        layout_data.x = posx < ::RoomModel.ROOM_WIDTH / 2.0 ? ::RoomModel.WALL_THICKNESS + d : ::RoomModel.ROOM_WIDTH - ::RoomModel.WALL_THICKNESS - d;
        layout_data.z = posz;
        layout_data.angle = posx > ::RoomModel.ROOM_WIDTH / 2.0 ? 90 : 270;
      }
      layout_data.y = posy;

      break;
    case ::FurnitureSetting.PLACE_BACK_WALL:
      layout_data.x = 0.0;
      layout_data.y = 0.0;
      layout_data.z = ::RoomModel.ROOM_DEPTH;
      break;
    case ::FurnitureSetting.PLACE_FLOOR:
    case ::FurnitureSetting.PLACE_CEILING:
      layout_data.x = posx;
      layout_data.y = posy;
      layout_data.z = posz;
      break;
    default:
      break;
    }
  }

  function rotateUIDsFurniture(furniture_uid, angle) {
    local furniture_model = this.furniture_models[furniture_uid];
    if (!furniture_model) return;

    local setting = furniture_model.getFurnitureSetting();
    local layout_data = this.cloned_edit_data.getFurnitureLayoutData(furniture_uid);
    if (!layout_data) return;

    layout_data.addAngle(angle);

    furniture_model.setupLayout(furniture_model.base_pos, layout_data);
    furniture_model.applyLayout();

    ::debugPrint("furniture rotated\n")
  }

  function rotateFurniture(angle) {
    local f_uid = this.selected_furniture.getFurnitureData().getUID();
    rotateUIDsFurniture(f_uid, angle);
  }

  function removeFurniture(furniture_uid) {
    this.cloned_edit_data.removeFurniture_byUID(furniture_uid);

    local furniture_model = this.furniture_models[furniture_uid];
    if (furniture_model) {
      delete this.furniture_models[furniture_uid];

      if (furniture_model == this.selected_furniture) {
        this.selected_furniture = null;
      }

      this.house_manager.furniture_layout_manager.applyEdit();
      this.house_manager.furniture_layout_manager.removeFurniture(furniture_uid);
    }

    ::debugPrint("furniture removed\n")
  }

  function replaceFurniture(furniture_uid, posx, posy) {

  }

  function purchaseFurniture(shop_id) {
    if (!this.selected_furniture || this.selected_furniture.getFurnitureData().getUID() != -1 || !_isLayoutEdited()) return;

    local sel_furniture = this.selected_furniture;

    local furniture_id = ::gamesetting.shop_settings[shop_id].item_id;
    local ud = ::gamesession.getUserData();
    local furniture_uid = ud.addFurniture(furniture_id);
    local furniture_data = ud.getFurnitureData(furniture_uid);

    removeFurniture(-1);

    local layout = sel_furniture.getLayoutData();

    layout.uid = furniture_uid;
    sel_furniture.build(furniture_data, shop_id);
    sel_furniture.release();

    this.house_manager.furniture_layout_manager.removeFurniture(furniture_uid);

    _createFurniture(furniture_uid, layout);
    local pos = Vector3D().add(sel_furniture.getPos());
    local furniture_origin = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();
    pos.sub(furniture_origin.x, furniture_origin.y, furniture_origin.z);
    addFurniture(furniture_uid, pos.x, pos.y, pos.z, layout.getAngle());
  }

  function setEditTmpGrids() {
    if (!this.selected_furniture) return;

    return this.house_manager.furniture_layout_manager.setEditTmpGrids();
  }

  function enableEditFurniture() {
    if (!this.selected_furniture || !_isLayoutEdited()) return true;

    return this.house_manager.furniture_layout_manager.enableEditFurniture();
  }

  function applyFurnitureLayout() {
    if (!this.selected_furniture || !_isLayoutEdited()) return;

    local furniture_uid = this.selected_furniture.getFurnitureData().getUID();

    this.house_manager.furniture_layout_manager.applyEdit();
  }

  function revertFurnitureLayout() {
    if (this.prev_layout_data) {
      if (this.selected_furniture) {
        local furniture_uid = this.selected_furniture.getFurnitureData().getUID();
        local furniture_layout = cloned_edit_data.getFurnitureLayoutData(furniture_uid);
        furniture_layout.apply(this.prev_layout_data);

        this.selected_furniture.applyLayout();
      }
    }
    else {
      if (this.selected_furniture) {
        local furniture_uid = this.selected_furniture.getFurnitureData().getUID();
        removeFurniture(furniture_uid);
        return furniture_uid;
      }
    }

    return -1;
  }

  function revert() {
    local ud = ::gamesession.getUserData();
    local room_data = ud.getCurrentRoomEditData();

    this.cloned_edit_data.apply(room_data);
    _clearPreviousLayoutData();
  }

  function removeAllFurnitures() {
    while (length(this.furniture_models)) {
      foreach (uid, _ in this.furniture_models) {
        removeFurniture(uid);
      }
    }
    _clearPreviousLayoutData();
  }

  function getSelectedFurniture() {
    return this.selected_furniture;
  }

  function getSelectedFurnitureUID() {
    return this.selected_furniture ? this.selected_furniture.getFurnitureData().getUID() : -1;
  }

  function _w2sPos(camera, pos) {
    local v = camera.project(pos);
    return [v.x * ::viewWidth, v.y * ::viewHeight];
  }

  function _s2wPos(camera, x, y, d) {

    local sk3dview = this.stage.sk3dview;
    local ratex = (x - (sk3dview.pos.x + sk3dview.bnd.x)) / (sk3dview.bnd.w * ::getDisplayScale());
    local ratey = (y - (sk3dview.pos.y + sk3dview.bnd.y)) / (sk3dview.bnd.h * ::getDisplayScale());
    local v = Vector3D(ratex, ratey, 0.0);
    local pos_near = camera.unproject(v);

    v.z = 1.0;
    local pos_far = camera.unproject(v);

    local r = (d - pos_near.y) / (pos_far.y - pos_near.y);
    local world_x = pos_near.x + (pos_far.x - pos_near.x) * r;
    local world_z = pos_near.z + (pos_far.z - pos_near.z) * r;

    return Vector3D(world_x, d, world_z);
  }

  function _s2wPosHorizontal(camera, x, y, d) {

    local sk3dview = this.stage.sk3dview;
    local ratex = (x - (sk3dview.pos.x + sk3dview.bnd.x)) / (sk3dview.bnd.w * ::getDisplayScale());
    local ratey = (y - (sk3dview.pos.y + sk3dview.bnd.y)) / (sk3dview.bnd.h * ::getDisplayScale());
    local v = Vector3D(ratex, ratey, 0.0);
    local pos_near = camera.unproject(v);

    v.z = 1.0;
    local pos_far = camera.unproject(v);

    local _r = (d - pos_near.z) / (pos_far.z - pos_near.z);
    local world_x = pos_near.x + (pos_far.x - pos_near.x) * _r;
    local world_y = pos_near.y + (pos_far.y - pos_near.y) * _r;

    return Vector3D(world_x, world_y, d);
  }

  function _s2wPos_t(camera, x, y, cameraobj) {

    local sk3dview = this.stage.sk3dview;
    local ratex = (x - (sk3dview.pos.x + sk3dview.bnd.x)) / (sk3dview.bnd.w * ::getDisplayScale());
    local ratey = (y - (sk3dview.pos.y + sk3dview.bnd.y)) / (sk3dview.bnd.h * ::getDisplayScale());
    local v = Vector3D(ratex, ratey, 0.0);
    local _w = camera.unproject(v);

    local _q = cameraobj.pos;
    local _t = (0.5 - _q.y) / _w.y;
    local _tmp = Vector3D(_w);

    return Vector3D(0, 0, 0);
  }

  function _adjustFurniturePos(layout, furniture_setting) {

    local room_info = this.house_manager.getCurrentRoom();
    local house_model = this.house_manager.getHouseModel();

    local left = house_model.WALL_THICKNESS;
    local front = 0;
    local right = house_model.getFloorMaxNumsX() * house_model.FLOOR_LENGTH;
    local back = front + house_model.getFloorMaxNumsZ() * house_model.FLOOR_LENGTH;

    local _gl = FURNITURE_MODE_DIST;
    layout.x = int(layout.x / _gl) * _gl + (layout.x % _gl < _gl / 2.0 ? 0.0 : _gl);
    layout.z = int(layout.z / _gl) * _gl + (layout.z % _gl < _gl / 2.0 ? 0.0 : _gl);

  }

  function _setupPreviousShopLayoutData(shop_id) {

    local shop_setting = ::gamesetting.shop_settings[shop_id];
    if (!shop_setting || shop_setting.type != SHOP_ITEM_TYPE_FURNITURE) return;

    if (this.selected_furniture && this.selected_furniture.getFurnitureSetting().getID() != shop_setting.item_id) {
      _crearPreviousLayoutData();
    }

    _setupPreviousLayoutData(-1);
  }

  function _setupPreviousLayoutData(furniture_uid) {
    if (!this.prev_layout_data || this.prev_layout_data.getUID() != furniture_uid) {
      local layout_data = cloned_edit_data.getFurnitureLayoutData(furniture_uid);
      if (layout_data) {
        this.prev_layout_data = ::FurnitureLayoutData.create(furniture_uid);
        this.prev_layout_data.apply(layout_data);
      }
    }
  }

  function _clearPreviousLayoutData() {
    this.prev_layout_data = null;
  }

  function _isLayoutEdited() {
    if (!this.selected_furniture) return false;
    if (!this.prev_layout_data) return true;

    local furniture_uid = this.selected_furniture.getFurnitureData().getUID();
    local layout_data = this.cloned_edit_data.getFurnitureLayoutData(furniture_uid);
    if (!layout_data) return false;

    return !layout_data.isEqual(this.prev_layout_data);
  }

  static function putFurniture(stage, floor, room, layout) {

  }

  static function removeAllFurniture(room_edit_data) {

  }
}