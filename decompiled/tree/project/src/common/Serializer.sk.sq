class Serializable
{
  table = null;

  constructor() {
    table = getcaller(2);
  }

  function _newslot(i, v, flag) {
    if (typeof(v) == SS_CLASS) {
      registerSerializable(v);
    }
    table[i] <- v;
  }
}

local sermap_id = {}
local sermap_cls = {}

class Serializer
{
  cls = null;
  classid = 0;

  serialver = 0;
  fieldmap = null;
  makechunk = false;

  readfunc = null;
  writefunc = null;

  constructor(c = null) {
    if (!c) return;
    cls = c;
    classid = cls["SerialUID"] || getclassname(cls);
    if (c["readObject"] && c["writeObject"]) {
      readfunc = c["readObject"];
      writefunc = c["writeObject"];
    } else {
      fieldmap = c["SerialFieldMap"] || createFieldMap(c);
      serialver = c["SerialVersion"] || calcSerialVersion(fieldmap);
      readfunc = defReadObject;
      writefunc = defWriteObject;

    }
  }

  function createFieldMap(c) {
    local a = [];
    foreach (i, v in c) {
      if (v >= 2 && v <= 6 && typeof(i) == SS_STRING) {
        a + i;
      }
    }
    return a;
  }

  function calcSerialVersion(a) {
    local i = 0;
    foreach (v in a) {
      i = (i << 1) ^ hashcode(v);
    }
    return i;
  }

  function defReadObject(oi) {
    local ser = sermap_cls[getclass(this)];
    local ver = oi.readInt();
    if (ver != ser.serialver) throw Exception("serialver mismatch. read=%S class=%S", ver, ser.serialver);
    local t = oi.readTable();
    foreach (v in ser.fieldmap) {
      if (v in t) this[v] = t[v];
    }
  }

  function defWriteObject(oo) {
    local ser = sermap_cls[getclass(this)];
    oo.writeInt(ser.serialver);
    local t = {};
    foreach (fid in ser.fieldmap) {
      t[fid] <- this[fid];
    }
    oo.writeTable(t);
  }
}

function registerSerializable(ser) {
  if (typeof(ser) == SS_CLASS) {
    ser = Serializer(ser);
  }
  local id = ser.classid;
  local cls = ser.cls;
  if (id in sermap_id) {
    if (sermap_id[id].cls == cls) return;
    throw Exception("duplicated SerialUID : " + id + " : " + cls + " , " + sermap_id[id].cls);
  }
  sermap_id[id] <- ser;
  sermap_cls[cls] <- ser;
  printf("serializable %S, id=%S\n", cls, id);
}

class ObjectIOChunk {
  header = "AAAA";
  size = 0;
  checksum = 0;
  startpos = 0;
}

class BinaryOutput {

  bbuf = null;
  chunk = null;
  chunkstack = null;
  idtable = null;
  nextid = 0;

  constructor(bb) {
    bbuf = bb;
    idtable = {}
  }

  function writeBoolean(b) {
    bbuf.putb(b ? 1 : 0);
  }

  function writeByte(b) {
    bbuf.putb(b);
  }

  function writeShort(s) {
    bbuf.puts(s);
  }

  function writeInt(i) {
    bbuf.puti(i);
  }

  function writePackedInt(i) {
    bbuf.putp(i);
  }

  function writeFloat(f) {
    bbuf.putf(f);
  }

  function writeHalf(h) {
    bbuf.puth(h);
  }

  function writeUTF(s) {
    bbuf.putt(s);
  }

  function writeBytes(bb) {
    bbuf.putBuffer(bb);
  }

  function beginChunk(head4) {
  }

  function endChunk() {
  }

  function writeObject(o) {
    if (o in idtable) {
      bbuf.putb(-5);
      bbuf.putp(idtable[o]);
    } else {
      local type = typeof(o);
      bbuf.putb(type);
      switch (type) {
      case SS_NULL:
      case SS_UNDEFINED:
        break;
      case SS_INTEGER:
        bbuf.putp(o);
        break;
      case SS_FLOAT:
        bbuf.putf(o);
        break;
      case SS_BOOL:
        bbuf.putb(o);
        break;
      case SS_ARRAY:
        bbuf.putp(nextid);
        idtable[o] <- nextid;
        nextid++;
        writeArray(o);
        break;
      case SS_TABLE:
        bbuf.putp(nextid);
        idtable[o] <- nextid;
        nextid++;
        writeTable(o);
        break;
      case SS_STRING:
        bbuf.putp(nextid);
        idtable[o] <- nextid;
        nextid++;
        bbuf.putUTF(o);
        break;
      case SS_WEAKREF:
        writeObject(getref(o));
        break;
      case SS_INSTANCE:
        local ser = sermap_cls[getclass(o)];
        if (ser) {
          writeObject(ser.classid);
          bbuf.putp(nextid);
          idtable[o] <- nextid;
          nextid++;
          ser.writeFunc.call(o, this);
        } else {
          throw Exception("can not writeObject : " + o);
        }
        break;
      default:
        throw Exception("can not writeObject : " + o);
      }
    }
  }

  function writeArray(a) {
    bbuf.putp(length(a));
    foreach (v in a) {
      writeObject(v);
    }
  }

  function writeTable(t) {
    bbuf.putp(length(t));
    foreach (i, v in t) {
      writeObject(i);
      writeObject(v);
    }
  }
}

class BinaryInput {

  bbuf = null;
  chunk = null;
  chunkstack = null;
  idtable = null;

  constructor(bb) {
    bbuf = bb;
    idtable = {};
  }

  function readBoolean() {
    return bbuf.getb() != 0;
  }

  function readByte() {
    return bbuf.getb();
  }

  function readShort() {
    return bbuf.gets();
  }

  function readInt() {
    return bbuf.geti();
  }

  function readPackedInt() {
    return bbuf.getp();
  }

  function readFloat() {
    return bbuf.getf();
  }

  function readHalf() {
    return bbuf.geth();
  }

  function readUTF() {
    return bbuf.gett();
  }

  function readBytes(bb) {
    bb.putBuffer(bb);
  }

  function beginChunk(head4) {
  }

  function endChunk() {
  }

  function readObject() {
    local type = bbuf.getb();
    switch (type) {
    case -5: return idtable[bbuf.getp()];
    case SS_NULL: return null;
    case SS_UNDEFINED: return undefined;
    case SS_INTEGER: return bbuf.getp();
    case SS_FLOAT: return bbuf.getf();
    case SS_BOOL: return bbuf.get(98) != 0;
    case SS_ARRAY: return idtable[bbuf.getp()] <- readArray();
    case SS_TABLE: return idtable[bbuf.getp()] <- readTable();
    case SS_WEAKREF: return readObject();
    case SS_INSTANCE:
      local classid = readObject();
      local ser = sermap_id[classid];
      if (ser) {
        local o = ser.cls();
        idtable[bbuf.getp()] <- (o);
        ser.readfunc.call(o, this);
      } else {
        throw Exception("can not readObject classid:" + classid);
      }
      break;
    default:
      throw Exception("can not readObject :" + type);
    }
  }

  function readArray() {
    local num = bbuf.getp();
    local a = array(num);
    for (local l = 0; l < num; l++) {
      a[l] = readObject();
    }
    return a;
  }

  function readTable(t) {
    local num = bbuf.getp();
    local t = {};
    for (local l = 0; l < num; l++) {
      local id = readObject();
      local val = readObject();
      t[id] <- val;
    }
    return t;
  }
}

class JSONOutput
{
  obj = null;
  objstack = null;
  chunk = null;
  chunkstack = null;
  idtable = null;
  nextid = 0;

  constructor() {
    objstack = [obj = []];
    idtable = {};
  }

  function getObject() {
    return objstack[0];
  }

  function encode() {
    return encodeJSON(objstack[0]);
  }

  function writeByte(b) {
    obj + b;
  }

  function writeShort(s) {
    obj + s;
  }

  function writeInt(i) {
    obj + i;
  }

  function writePackedInt(i) {
    obj + i;
  }

  function writeFloat(f) {
    obj + f;
  }

  function writeHalf(h) {
    obj + h;
  }

  function writeUTF(s) {
    obj + s;
  }

  function writeBytes(bb) {
    local s = encodeBASE64(bb);
    bb.pos = bb.size;
    obj + s;
  }

  function writeNextID(o) {
    obj + ["*newid*", nextid];
    idtable[o] <- nextid;
    nextid++;
  }

  function pushStack(o) {
    objstack + (obj = o);
  }

  function popStack() {
    local o = objstack.last();
    objstack.pop();
    obj = objstack.last();
    return o;
  }

  function beginChunk(head4) {
  }

  function endChunk() {
  }

  function writeObject(o) {
    if (o in idtable) {
      local a = ["*ref*", idtable[o]];
      obj + a;
      return a;
    } else {
      local type = typeof(o);
      switch (type) {
      case SS_NULL:
      case SS_INTEGER:
      case SS_FLOAT:
      case SS_BOOL:
      case SS_STRING:
        obj + o;
        return o;
      case SS_UNDEFINED:
        obj + null;
        return null;
      case SS_WEAKREF:
        return writeObject(getref(o));
      case SS_ARRAY:
        return writeArray(o);
      case SS_TABLE:
        return writeTable(o);
      case SS_INSTANCE:
        local ser = sermap_cls[getclass(o)];
        if (ser) {
          local a = [];
          pushStack(a);
          obj + "*class*";
          writeObject(ser.classid);
          ser.writefunc.call(o, this);
          popStack();
          obj + a;
          return a;
        } else {
          throw Exception("can not writeObject : " + o);
        }
      default:
        throw Exception("can not writeObject : " + o);
      }
    }
  }

  function writeArray(a) {
    local _a = [];
    pushStack(_a);
    foreach (v in a) {
      writeObject(v);
    }
    popStack();
    obj + _a;
  }

  function writeTable(t) {
    local _t = {};
    local a = [];
    pushStack(a);
    foreach (i, v in t) {
      writeObject(i);
      writeObject(v);
      _t[a[0]] <- a[1];
      a.resize(0);
    }
    popStack();
    obj + _t;
  }
}

class JSONInput
{
  obj = null;
  curs = 0;
  objstack = null;
  cursstack = null;
  chunk = null;
  chunkstack = null;
  idtable = null;
  nextid = 0;

  constructor(o) {
    objstack = [obj = o];
    cursstack = [];
    idtable = {};
  }

  function readByte() {
    local o = obj[curs];++curs;
    return o;
  }

  function readShort() {
    local o = obj[curs];++curs;
    return o;
  }

  function readInt() {
    local o = obj[curs];++curs;
    return o;
  }

  function readPackedInt() {
    local o = obj[curs];++curs;
    return o;
  }

  function readFloat() {
    local o = obj[curs];++curs;
    return o;
  }

  function readHalf() {
    local o = obj[curs];++curs;
    return o;
  }

  function readUTF() {
    local o = obj[curs];++curs;
    return o;
  }

  function readBytes() {
    local o = obj[curs];++curs;
    local bb = decodeBASE64(o);
    return bb;
  }

  function pushStack(o) {
    objstack + (obj = o);
    cursstack + curs;
    curs = 0;
  }

  function popStack() {
    objstack.pop();
    obj = objstack.last();
    curs = cursstack.last();
    cursstack.pop();
  }

  function beginChunk(head4) {
  }

  function endChunk() {
  }

  function readObject() {
    local o = readObjectBody(obj[curs]);++curs;
    return o;
  }

  function readObjectBody(o) {
    local type = typeof(o);
    switch (type) {
    case SS_NULL:
    case SS_INTEGER:
    case SS_FLOAT:
    case SS_BOOL:
    case SS_STRING:
      return o;
    case SS_TABLE:
      return readTable(o);
    case SS_ARRAY:
      if (length(o) >= 1) {
        switch (o[0]) {
        case "*class*":
          {
            local classid = readObjectBody(o[1]);
            local ser = sermap_id[classid];
            if (ser) {
              pushStack(o);
              curs += 2;
              local so = ser.cls();
              ser.readfunc.call(so, this);
              popStack();
              return so;
            } else {
              throw Exception("can not readObject classid:" + classid);
            }
          }
        }
      }
      return readArray(o);
    default:
      throw Exception("can not readObject : " + o);
    }
  }

  function readArray(a = null) {
    if (!a) { a = obj[curs];++curs; }
    local _a = array(length(a));
    pushStack(a);
    foreach (i, v in a) {
      _a[i] = readObjectBody(v);
    }
    popStack();
    return _a;
  }

  function readTable(t = null) {
    if (!t) { t = obj[curs];++curs; }
    local _t = {};
    foreach (i, v in t) {
      local id = readObjectBody(i);
      local val = readObjectBody(v);
      _t[id] <- val;
    }
    return _t;
  }
}