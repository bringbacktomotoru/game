class Rectangle {
  vertexes = null;
  corners = null;
  base_vtx = null;
  pos_min = null;
  pos_max = null;

  constructor(vertexes, corners, base_vtx) {
    set(vertexes, corners, base_vtx);
  }

  function set(vertexes, corners, base_vtx) {
    this.vertexes = vertexes.slice(0);
    this.corners = corners.slice(0);
    this.base_vtx = base_vtx;
    _setRectangle();
  }

  function remove() {
    vertexes.clear();
    pos_min = pos_max = null;
  }

  function _setRectangle() {
    if (vertexes.len() < 4 || corners.len() < 4) return null;
    local max_id_x = -1;
    local max_id_z = -1;
    local min_id_x = -1;
    local min_id_z = -1;
    foreach (i, vtx in vertexes) {
      if (vtx.id_ == corners[2]) { max_id_x = i; }
      if (vtx.id_ == corners[1]) { max_id_z = i; }
      if (vtx.id_ == corners[0]) { min_id_x = i; }
      if (vtx.id_ == corners[3]) { min_id_z = i; }
    }
    pos_min = Vector3D(vertexes[min_id_x].position_.x, vertexes[0].position_.y, vertexes[min_id_z].position_.z);
    pos_max = Vector3D(vertexes[max_id_x].position_.x, vertexes[0].position_.y, vertexes[max_id_z].position_.z);
  }

  function getPosMin() {
    return pos_min ? pos_min : Vector3D(0.0, 0.0, 0.0);
  }
  function getPosMax() {
    return pos_max ? pos_max : Vector3D(0.0, 0.0, 0.0);
  }

  function getVertexes() {
    return vertexes;
  }

  function getCorners() {
    return corners;
  }

  function getBaseVtx() {
    return base_vtx;
  }

  function isInRectangle(point) {
    local _length = vertexes.len();

    local _original_y = vertexes[0].position_.y;
    local _count_crossing = 0;
    local _prev = vertexes[0];
    local _prev_relation_x = point.x <= _prev.position_.x;
    local _prev_relation_z = point.z <= _prev.position_.z;

    local _ret_point = clone point;
    local _near_length = 99999.0;

    for (local i = 1; i < _length + 1; i++) {
      local _vertex = vertexes[i % _length];

      local _relation_x = point.x <= _vertex.position_.x;
      local _relation_z = point.z <= _vertex.position_.z;

      if ((point - _vertex.position_).length() < _near_length) {
        _ret_point.y = _vertex.y;
        _near_length = (point - _vertex.position_).length();
      }
      if (_relation_z == _prev_relation_z) {
        _prev = _vertex;
        _prev_relation_x = _relation_x;
        _prev_relation_z = _relation_z;
        continue;
      }

      if (_relation_x && _prev_relation_x) _count_crossing += _prev_relation_z ? -1 : 1;
      else if (_prev_relation_x != _relation_x) {
        local _result = _prev.position_.x + (_vertex.position_.x - _prev.position_.x) * (point.z - _prev.position_.z) / (_vertex.position_.z - _prev.position_.z);
        if (point.x <= _result) _count_crossing += _prev_relation_z ? -1 : 1;
      }
      _prev = _vertex;
      _prev_relation_x = _relation_x;
      _prev_relation_z = _relation_z;
    }

    return _count_crossing != 0 ? _ret_point : null;
  }
}