function checkCondition(id_list, condition_settings) {
  if (!id_list) return true;

  local ret = false;

  foreach (id in id_list) {
    local setting = condition_settings[id];
    local is_and = setting.is_and;

    foreach (key, param in setting.condition) {
      ret = ::check(key, param);
      if (is_and) {
        if (!ret) break;
      } else {
        if (ret) break;
      }
    }

    if (ret) break;
  }

  return ret;
}

function check(key, param) {
  local ret = false;
  local ud = ::gamesession.getUserData();
  local _udl = ::gamesession.getUserDataLocal();

  switch (key) {
  case "rank":
    local rank = ud.getRank()
    if (rank >= param[0]) ret = true;
    if (param.len() > 1 && rank > param[1]) ret = false;

    break;
  case "has_chara":
    ret = true;
    foreach (chara_id in param) {
      if (!ud.hasCharacter(chara_id)) {
        ret = false;
        break;
      }
    }
    break;
  case "has_costume":
    ret = true;
    foreach (cid in param) {
      if (!ud.hasCostume(cid)) {
        ret = false;
        break;
      }
    }
    break;
  case "has_not_costume_all":
    ret = true;
    foreach (cid in param) {
      if (ud.hasCostume(cid)) {
        ret = false;
        break;
      }
    }
    break;
  case "has_furniture_amount":
    ret = true;
    for (local i = 0; i < param.len(); i = i + 2) {
      local _fid = param[i];
      local _amount = param[i + 1];

      if (ud.getFurnitureAmount(_fid) < _amount) {
        ret = false;
        break;
      }
    }
    break;
  case "has_furniture_amount_atroom":
    ret = true;
    local _fid = param[0];
    local _amount = param[2];
    local _rid = param[3];

    if (ud.getFurnitureAmount(_fid, _rid) < _amount) ret = false;

    break;
  case "has_room_furniture_amount":
    ret = true;
    local _rid = param[0];
    local _amount = param[1];

    if (ud.getRoomFurnitureAmount(_rid) < _amount) ret = false;

    break;
  case "has_not_furniture":
    ret = true;
    if (ud.getFurnitureAmount(param[0]) > 0) ret = false;
    break;
  case "has_room":
    if (ud.hasRoomByRoomID(param[0])) ret = true;
    break;
  case "cos_lv":
    local cos_data = ud.getCostumeData(param[0]);
    if (cos_data && cos_data.getLevel() >= param[1]) ret = true;
    break;
  case "purchase_num":
    if (ud.getPurchaseRecordNums(param[0]) >= param[1]) ret = true;
    break;
  case "end_event":

    break;
  case "friendship":

    break;

  case "tutorial":
    foreach (tid in param) {
      if (ud.isEndTutorialId(tid)) {
        ret = true;
        break;
      }
    }
    break;
  case "tutorial_not_end":
    local tutorial_id = param[0];
    ret = !ud.isEndTutorialId(tutorial_id);
    break;
  case "tutorial_any":
    if (param.len() < 2) {
      ret = false;
      break;
    }
    local need_num = param[0];
    local cnt = 0;
    for (local i = 1; i < param.len(); i++) {
      local tutorial_id = param[1];
      if (ud.isEndTutorialId(tutorial_id)) cnt++;
    }
    if (cnt >= need_num) ret = true;
    break;
  case "product":

    break;
  case "work":

    break;
  case "can_costume_levelup":

    break;
  case "reside_cos_lv":

    break;
  case "costume_request":

    break;
  case "product_complete":
  case "work_complete":
    if (_udl.getLocalFlag(key)) ret = true;
    _udl.setLocalFlag(key, false);
    break;
  case "use_room_slot_num":
    local _num = param[0];
    local _rooms = ud.getRooms();
    local _cnt = 0;
    foreach (_room in _rooms) {
      if (_room.getRoomUID() == -1) continue;
      _cnt++;
    }
    ret = (_cnt >= _num);
    break;

  case "can_levelup_furniture":

    break;

  case "furniture_layout_num":
    local _num = param[0];
    local _layout = ud.getCurrentRoomEditData().getFurnitureLayouts();
    ret = _layout.len() >= _num;
    break;
  case "hour":

    break;
  case "add_chara_appeal_balloon":

    local _cp = ::gamesession.getCurrentScene().getUI().getCurrentPanel();
    if (_cp instanceof HomeTopPanel) {
      foreach (t in param) {
        if (_cp.getRecentlyAddedBalloonType() == t) {
          ret = true;
          break;
        }
      }
    }
    break;
  case "shop_buy":
    local _type = param[0];
    local _cp = ::gamesession.getCurrentScene().getUI().getCurrentPanel();
    if (_cp instanceof ShopPanel && _cp.hasTypeBougthList(_type)) ret = true;
    break;
  case "focus_talk":
    if (::gamesession.getUserDataLocal().getFocusTalkFlag()) ret = true;
    break;
  case "have_gm":
    local _gm = ud.getGameMoney();
    ret = _gm >= param[0];
    break;
  case "end_panelmission":
    local _pmid = param[0];
    local _pmd = ud.getPanelMissionData(_pmid);
    if (_pmd && _pmd.isReceivedReward()) ret = true;
    break;
  case "end_panelmission_event":
    local _pmid = param[0];
    local _pmd = ud.getPanelMissionData(_pmid);
    if (_pmd && _pmd.hasClearDate()) ret = true;
    break;
  case "doing_mission":
    local _mid = param[0];
    local _pmd = ud.getCurrentPanelMission();
    if (!_pmd) break;
    local _md = _pmd.getMissionData(_mid);
    if (_md && !_md.isCleared()) ret = true;
    break;
  case "doing_panelmission":
    local _mid = param[0];
    local _pmd = ud.getCurrentPanelMission();
    if (!_pmd) break;
    if (_mid == _pmd.getID()) return true;
    break;
  }

  return ret;
}