SK3DScriptRunner.chara_setting <- null;
SK3DScriptRunner.costume_setting <- null;
SK3DScriptRunner.target_obj <- null;

with SK3DScriptRunner {
  v_1 <- Vector3D();
  v_2 <- Vector3D();
  rnd <- null;
  move_func_lock <- false;

  function spin_bone(name, x, y, z, time, accel = 0) {
    local s = sel || sk3d; sel = null;
    local v = Vector3D(x, y, z);

    sk3d.clearModifiers();

    foreach (o in s) {
      local bone = o.findBone(name);
      if (!bone) {
        print("bone not found... search >> " + name + "\n");
        continue;
      }
      o.addModifier(::BoneSpinModifier(bone.parts.id, v, time, accel));
    }
  }

  function rotate(from, to, time, clear_modifiers = true) {
    local s = sel || sk3d; sel = null;

    if (clear_modifiers) sk3d.clearModifiers();

    foreach (o in s) {
      o.addModifier(::RotateModifier(from, to, time));
    }
  }

  function rotateHeadTo(h, time = 0) {
    local _hpb = this.sk3d.rot.toMatrix().getHPB();
    local _h = _hpb.x * Math.RTOD;
    h += _h;

    rotateHeadAdd(h, time);
  }

  function rotateHeadAdd(add, time) {

    local _hpb = this.sk3d.rot.toMatrix().getHPB();

    local _h = _hpb.x * -1 * Math.RTOD;
    local _p = _hpb.y * -1 * Math.RTOD;
    local _b = _hpb.z * -1 * Math.RTOD;

    this.sk3d.rot.setHPB(_h * Math.DTOR, _p * Math.DTOR, _b * Math.DTOR);

    _h += add;
    rotateTo(_h, _p, _b, time);
  }

  function rotateToPos(x, z, time) {
    if (x == 0 && z == 0) return;

    local _h = Math.atan2(z, x) * Math.RTOD * -1.0 + 270.0;
    if (Math.abs(_h) > 180) {
      _h += _h > 0 ? -360 : 360;
    }

    rotateTo(_h, 0, 0, time);
  }

  function rotateToPosSpd(x, z, spd = 0.1) {
    if (x == 0 && z == 0) return 0;

    local _h = Math.atan2(z, x) * Math.RTOD * -1.0 + 270.0;
    local _diff = (this.sk3d.rot.toMatrix().getHPB().x * -1) - _h;

    _diff = _diff % 360;
    if (Math.abs(_diff) > 180) {
      _diff += _diff > 0 ? -360 : 360;
    }
    local _time = Math.abs(_diff) * 1.0 / spd;

    if (Math.abs(_h) > 180) {
      _h += _h > 0 ? -360 : 360;
    }

    rotateTo(_h, 0, 0, _time);
    return _time;
  }

  function rotateToCamera(time) {
    local scene = ::gamesession.getCurrentScene();
    if (scene instanceof ::SanrioGameScene) {
      local _h = _getCameraHead(scene);

      if (Math.abs(_h) > 180) {
        _h += _h > 0 ? -360 : 360;
      }

      rotateTo(_h, 0, 0, time);
    }
  }
  function rotateToCameraSpd(spd = 0.1) {
    local scene = ::gamesession.getCurrentScene();
    if (scene instanceof ::SanrioGameScene) {
      local _h = _getCameraHead(scene);
      local _diff = (this.sk3d.rot.toMatrix().getHPB().x * Math.RTOD * -1) - _h;

      _diff = _diff % 360;
      if (Math.abs(_diff) > 180) {
        _diff += _diff > 0 ? -360 : 360;
      }
      local _time = Math.abs(_diff) * 1.0 / spd;

      if (Math.abs(_h) > 180) {
        _h += _h > 0 ? -360 : 360;
      }

      rotateTo(_h, 0, 0, _time);
      return _time;
    }

    return 0;
  }

  function _getCameraHead(scene) {
    local _panel = scene.getUI().getCurrentPanel();
    local _h;
    if (_panel instanceof ARPanel) {
      local _icm = Matrix(_panel.getModelViewer().renderer.camera[SK_MATRIX_VIEW]);

      _icm[8] *= -1.0;
      _icm[9] *= -1.0;
      _icm[10] *= -1.0;

      _icm[12] = _icm[13] = _icm[14] = 0.0;
      local _hpb = _icm.getHPB() * -1.0 * Math.RTOD;
      local _rot = _icm.getRotation();

      _h = int(_hpb.x + 0.0) % 360;
    } else {

      local co = scene.getStage().renderer.cameraobj;
      _h = co.gmat.getHPB().x * -Math.RTOD;
    }

    return _h;
  }

  function morph(t, time = 0) {
    local s = sel || sk3d; sel = null;
    foreach (o in s) {
      o.morph(t, time);

      foreach (c in o.children) {
        c.morph(t, time);
      }
    }
  }
  function morphFace(t, time = 0) {
    local s = sel || sk3d; sel = null;
    local face = s.findByName(::CharaModel.FACE_SK3D_NAME);
    if (face) {
      face.morph(t, time);
    }
  }

  function setCharaSetting(cset) {
    chara_setting = cset;
  }

  function setCostumeSetting(cset) {
    costume_setting = cset;
  }

  function setMotion(mot) {

    if (mot instanceof SS_STRING) {
      local res = ::getResource("/action/anime/l_ghoul.mot");
      if (!res) println("WARNING!! motion file is not found. path=" + mot);
      mot = ::getMotionData(res);
    }
    local s = sel || sk3d; sel = null;
    foreach (o in s) {
      o.setMotion(mot);
    }
  }
  function setMotionFile(file) {
    local path = "";
    if (chara_setting.motion_key) {
      path = "/res/anime/" + file + "_" + chara_setting.motion_key + ".mot";
    } else {
      path = "/res/anime/" + file + ".mot";
    }

    local mot = ::getMotionData(::getResource(path));
    setMotion(mot);
  }

  function setMoveFuncLock(b) {
    this.move_func_lock = b;
  }

  function move(x, y, z, time = 0) {
    if (this.move_func_lock) return;
    local dir = _rotToDir(this.sk3d.rot);

    moveFor(x * Math.sin(dir), y, z * Math.cos(dir), time);
  }

  function moveTo(x, y, z, time = 0) {
    if (this.move_func_lock) return;
    sk3d.clearModifiers();

    v_1.set(x, y, z);
    if (!sk3d.parent) v_1.y += ::HouseModel.FLOOR_DEPTH;

    local s = sel || sk3d; sel = null;
    foreach (o in s) {
      o.addModifier(MoveToModifier(s.pos, v_1, time, null));
    }
  }

  function moveToGlobal(x, y, z, time = 0) {
    if (this.move_func_lock) return;
    if (x == 0 && y == 0 && z == 0) return;

    v_1.set(sk3d.pos).add(x, y, z);

    local s = sel || sk3d; sel = null;
    foreach (o in s) {
      o.addModifier(MoveToModifier(s.pos, v_1, time, Easing.easeIn(1.5).easing));
    }
  }

  function moveForSpd(x, y, z, spd = 0.0015) {
    if (this.move_func_lock) return;
    if (x == 0 && y == 0 && z == 0) return 0;

    v_1.set(x, y, z);
    local _time = v_1.length() * 1.0 / spd;
    moveFor(x, y, z, _time);

    return _time;
  }

  function moveAccel(x, y, z, acceltime, sc1 = 0.0, sc2 = 1.0) {
    if (this.move_func_lock) return;
    sk3d.clearModifiers();

    local s = sel || sk3d; sel = null;
    foreach (o in s) {
      o.addModifier(MoveAccelModifier(Vector3D(x, y, z), acceltime, sc1, sc2));
    }
  }
  function moveAccelRot(x, y, z, acceltime, sc1 = 0.0, sc2 = 1.0) {
    if (this.move_func_lock) return;
    local v = Vector3D(x, y, z);
    v.transform0(this.sk3d.gmat);

    moveAccel(v.x, v.y, v.z, acceltime, sc1, sc2);
  }

  function waitAction(model) {
    if (!model) return;

    if (model instanceof ::CharaModel || model instanceof ::ARCharaModel) {
      while (model.isScriptRunning()) {
        suspend();
      }
    } else {
      while (model.scprunner.isScriptRunning()) {
        suspend();
      }
    }
  }
  function isScriptRunning() {
    return running
  }

  function randomi(max, inc_zero = true) {
    return Math.rndi(max, inc_zero, rnd);
  }

  function randomir(min, max, inc_zero = true) {
    return Math.rndir(min, max, inc_zero, rnd);
  }

  function randomic(val, inc_zero = true) {
    return Math.rndic(val, inc_zero, rnd);
  }

  function randomf(max, inc_zero = true) {
    return Math.rndf(max, inc_zero, rnd);
  }

  function randomfr(min, max, inc_zero = true) {
    return Math.rndfr(min, max, inc_zero, rnd);
  }

  function randomfc(val, inc_zero = true) {
    return Math.rndfc(val, inc_zero, rnd);
  }

  function randomb(prop = 0.5) {
    return Math.rndb(prop, rnd);
  }

  function randomArray(arr) {
    return Math.rndArray(arr, rnd);
  }

  function randomPick(arr) {
    return Math.rndPick(arr, rnd);
  }

  function setSeed(idx) {
    rnd = Random(idx);
  }

  function changeRandomSeed(is_static) {
    local seed = -1;
    if (is_static) {
      seed = Math.rndi(10000);
      setSeed(seed);
    } else {
      rnd = null;
    }
    return seed;
  }

  function changeHand(left = null, right = null) {
    local _path = "";
    local _baseDir = chara_setting.handdir + "/";

    if (!this.costume_setting) this.costume_setting = ::gamesetting.costume_settings[chara_setting.getDefaultCostumeID()];
    local _tex = null;
    _tex = ::getTexture(this.costume_setting.hand_tex);

    if (left) {
      local _oldsk3d = sk3d.findByName("l_hand");
      local visible = true;
      if (_oldsk3d) {
        visible = _oldsk3d.isVisible();
        sk3d.removeChild(_oldsk3d);
      }

      _path = _baseDir + left + "L.pm";
      local _leftsk3d = SK3DObject(_path);
      _leftsk3d.setVisible(visible);
      _leftsk3d.name = "l_hand";
      sk3d.addChild(_leftsk3d);
      _leftsk3d.shadowBonesTo(sk3d);

      if (_tex) _leftsk3d.mesh.face[0].m.tex0 = _tex;
    }

    if (right) {
      local _oldsk3d = sk3d.findByName("r_hand");
      local visible = true;
      if (_oldsk3d) {
        visible = _oldsk3d.isVisible();
        sk3d.removeChild(_oldsk3d);
      }

      _path = _baseDir + right + "R.pm";
      local _rightsk3d = SK3DObject(_path);
      _rightsk3d.setVisible(visible);
      _rightsk3d.name = "r_hand";
      sk3d.addChild(_rightsk3d);
      _rightsk3d.shadowBonesTo(sk3d);

      if (_tex) _rightsk3d.mesh.face[0].m.tex0 = _tex;
    }
  }

  function startTalk(key, small = false) {
    if (!::gamesession) return;

    local scn = ::gamesession.getCurrentScene();
    if (scn instanceof SanrioGameScene) {
      local _panel = scn.getUI().getCurrentPanel();

      local _charakey = chara_setting.talk_key;
      _panel.addTalkWindow(sk3d, key, _charakey, false, small);
    }
  }
  function startTalkForce(key, small = false) {
    if (!::gamesession) return;

    local scn = ::gamesession.getCurrentScene();
    if (scn instanceof SanrioGameScene) {
      local _panel = scn.getUI().getCurrentPanel();

      local _charakey = chara_setting.talk_key;
      _panel.addTalkWindowForce(sk3d, key, _charakey, false, small);
    }
  }

  function connectObject(fm, time = 5000, bone = "chara1") {
    if (this.sk3d.parent) return;

    local dis = Vector3D();
    local q_1 = Quaternion();

    local f_sk3d = null;
    if (fm instanceof ::FurnitureModel || fm instanceof ::ARFurnitureModel) {
      f_sk3d = fm.obj.sk3d;
    } else {
      f_sk3d = fm;
    }

    local _b = f_sk3d.findBone(bone);
    if (!_b) return;

    local p0 = _b.parts.bindpose;
    v_1.set(p0[12], p0[13], p0[14]).transform0(f_sk3d.gmat);

    dis.set(this.sk3d.pos).sub(f_sk3d.pos).sub(v_1);
    local _xz_len = Math.sqrt(dis.x * dis.x + dis.z * dis.z);

    local dir = f_sk3d.rot.toMatrix().getHPB().x * -1 + _b.mat.getHPB().x * -1;;
    local dis_r = Math.atan2(dis.x, dis.z);
    local _bdir = _b.mat.getHPB().x * -1;
    local diff = dis_r - dir;

    local x = _xz_len * Math.sin(diff);
    local y = dis.y;
    local z = _xz_len * Math.cos(diff);

    local _h = sk3d.rot.toMatrix().getHPB().x * -1;
    local _diff_h = _h - dir;

    this.sk3d.scn.removeObject(this.sk3d);
    this.sk3d.pos.set(x, y, z);
    this.sk3d.rot.setHPB(_diff_h, 0, 0);
    this.sk3d.matdirty = true;
    f_sk3d.addChild(this.sk3d, bone);
    this.sk3d.disablePhysicalBones();
    f_sk3d.enablePhysicalBones();

    local _t = {};
    _t["pos"] <- { x = -x, y = -y, z = -z };
    local _h = this.sk3d.rot.toMatrix().getHPB().x * -1 * Math.RTOD;

    if (Math.abs(_h) > 180) {
      _h += _h > 0 ? -360 : 360;
    }
    _t["head"] <- _h;

    return _t;

  }
  function disconnectObject(time = 500) {
    if (!this.sk3d.parent) return;
    local parent = this.sk3d.parent;

    local f_sk3d = this.sk3d.parent;
    local _b = this.sk3d.parentbone;
    local p0 = _b.parts.bindpose;
    v_1.set(p0[12], p0[13], p0[14]).transform0(f_sk3d.gmat);

    this.sk3d.removeFromParent();
    this.sk3d.parent = null;
    this.sk3d.parentbone = null;
    this.sk3d.pos.set(parent.pos).add(v_1);

    local _h = this.sk3d.gmat.getHPB().x * -1;
    this.sk3d.rot.setHPB(_h, 0, 0);
    this.sk3d.matdirty = true;
    this.sk3d.scn.addObject(this.sk3d);
    f_sk3d.resetPhysicalBones();

    local dis = 1.0;
    local dir = _rotToDir(parent.rot);

    this.sk3d.matdirty = true;

  }

  function _rotToDir(q) {

    return q.toMatrix().getHPB().x * -1;
  }

  function showProductRewardUI(data, offset = null) {
    local scene = ::gamesession.getCurrentScene();
    if (scene instanceof SanrioGameScene) {
      local home_ui = scene.getUI();
      local cos_id = costume_setting.getID();
      local old_value = data.old_values[cos_id];
      home_ui.showProductRewardCostume(costume_setting.getID(), data.exp, data.health, old_value.exp, old_value.health, offset);
    }

  }

  function showWorkRewardUI(data, offset = null) {
    local scene = ::gamesession.getCurrentScene();
    if (scene instanceof SanrioGameScene) {
      local home_ui = scene.getUI();
      local cos_id = costume_setting.getID();
      home_ui.showWorkRewardCostume(cos_id, data.exp, data.old_exp, offset);
    }
  }

  function setTappedScript(scp_name) {
    if (sk3d.isCaptureModel()) return;
    local _cm = _getCurrentSceneCharaModel();
    if (!_cm) return;
    _cm.setTappedScript(scp_name);
  }

  function disableTapChara(b) {
    local _cm = _getCurrentSceneCharaModel();
    if (!_cm) return;

    _cm.setDisableTap(b);
  }

  function isEndBonusHapinessTutorial() {
    if (::gamesetting.game_rule.disableTutorial()) return false;

    local _ud = ::gamesession.getUserData();
    if (::TutorialSetting.CHECK_TUTORIAL_FIRSTFOCUSTALK >= 0 && !_ud.isEndTutorialId(::TutorialSetting.CHECK_TUTORIAL_FIRSTFOCUSTALK)) {
      return true;
    }
    return false;
  }

  function showGetHapinessEffectAndAddGM(addgm, charamodel = null) {
    if (addgm <= 0) return;
    if (sk3d.isCaptureModel()) return;

    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      if (!charamodel && costume_setting) {
        local _cid = costume_setting.getID();
        charamodel = _scene.getStage().getChara(_cid) || null;
      }
      local camera = null;
      local _cp = _scene.getUI().getCurrentPanel();
      if ((_cp instanceof ARPanel)) {
        if (charamodel && charamodel.isCaptureModel()) {
          println("showGetHapinessEffectAndAddGM capturemodel can't get gm.");
          return;
        }
        local _viewer = _cp.getModelViewer();

        if (costume_setting) {
          local _chara_id = costume_setting.getCharaID();
          charamodel = _viewer.getChara(_chara_id) || null;
          if (!charamodel) return;
        }
        camera = _viewer.renderer.camera;
      }

      _scene.showGetHapinessEffectAndAddGM(charamodel, addgm, camera, true, true);
    }
  }

  function playVoice(key) {
    if (!chara_setting) return;
    chara_setting.playVoice(key);
  }

  function playSound(param) {
    ::playSound(param);
  }

  function resetCharaModelState(auto = true) {
    local _cm = _getCurrentSceneCharaModel();
    if (!_cm) return;
    _cm.resetWaitingProduct();
    _cm.resetState();
    _cm.setAutoAction(auto);
  }

  function addFailuerBalloon() {
    if (!this.costume_setting) return;
    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof ::SanrioGameScene)) return;

    local _panel = _scene.getUI().getCurrentPanel();
    if (_panel instanceof ::HomeTopPanel) {
      local _cm = _scene.getStage().getChara(this.costume_setting.getID());
      if (_cm) _panel.addFailuerBalloon(_cm);
    }
  }

  function showMessage(dict_key, top_panel_check = false) {
    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof ::SanrioGameScene)) return;
    if (top_panel_check && !(_scene.getUI().getCurrentPanel() instanceof ::HomeTopPanel)) return;

    ::gamesession.messagelayer.closeAllMessage();
    local _message = ::Message();
    _message.setMsec(4 * 1000);
    _message.setText(::dict.get(dict_key));
    _message.setFontSize(28);
    _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
    _message.show();
  }

  function _getCurrentSceneCharaModel() {
    local _cm = null;
    local _cid = costume_setting.getID();
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _panel = _scene.getUI().getCurrentPanel();
      if (_panel instanceof ARPanel) {
        _cm = _panel.getARCharaModelByCostumeId(_cid);
      }
      else {
        _cm = _scene.getStage().getChara(_cid) || null;
      }
    }
    return _cm;
  }

  function setAREnableMotions(b, chara_id = -1) {
    local _panel = _getARPanel();
    if (!_panel) return;

    if (chara_id < 0) chara_id = chara_setting.getID();
    _panel.setEnableMotions(b, chara_id);
  }

  function setARShadowVisible(b, chara_id = -1) {

    local _panel = _getARPanel();
    if (!_panel) return;

    if (chara_id < 0) chara_id = chara_setting.getID();
    _panel.setCharaShadowVisible(b, chara_id);
  }

  function _getARPanel() {

    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof SanrioGameScene)) return null;

    local _panel = _scene.getUI().getCurrentPanel();
    if (!(_panel instanceof ARPanel)) return null;
    return _panel;
  }

  function isDoingMission(mid) {
    local _ud = ::gamesession.getUserData();
    local _pmd = _ud.getCurrentPanelMission();
    if (!_pmd) return false;
    local _md = _pmd.getMissionData(mid);
    if (!_md || _md.isCleared()) return false;

    return true;
  }
}

class SK3DEffectRunner extends SK3DScriptRunner {
  modifier_param = null;
  running_effect_table = null;

  function registerModifierParameters(param) {
    this.modifier_param = param;
  }

  function addModifierParameters(child) {
    if (getclass(child.scprunner) != SK3DEffectRunner) return;
    child.scprunner.registerModifierParameters(this.modifier_param);
  }

  function flushModifierParameters(time = 1000) {
    this.sk3d.clearModifiers();

    this.sk3d.addModifier(ZoomModifier(clone this.sk3d.scale, this.modifier_param.scale, time));
    this.sk3d.addModifier(MaterialColorFadeModifier(this.sk3d, this.modifier_param.materials, time));
  }

  function registerRunningEffectTable(key, gen) {
    if (!running_effect_table) running_effect_table = {};

    running_effect_table[key] <- gen;
  }

  function removeEffectTable(key) {

    delete running_effect_table[key];

  }

  function generate(gen) {
    local _parents = sel || sk3d;
    local _obj = super.generate(gen);
    foreach (_parent in _parents) {
      _obj.setVisible(_parent.visible);
      break;
    }
    return _obj;
  }

  function anime(st, en = null, spd = null, lp = false, ft = 0.0) {

  }

  function passAnime(...) {

  }

  function animespd(spd) {

  }
}