class StageObject {
  scene = null;
  sk3d = null;

  visible = true;

  angle = 0.0;
  scale = null;

  modifier_param = null;
  effect_runner = null;

  constructor(scene) {
    this.scene = scene;

    this.scale = Vector3D(1.0, 1.0, 1.0);
  }

  function build(path) {
    if (this.sk3d) {
      removeFromStage();
    }

    this.sk3d = ::SK3DObject(path);
    this.sk3d.setVisible(visible);
    _applyPos();
    _applyAngle();
    _applyScale();
  }

  function update(dt) {
    if (effect_runner) effect_runner.update(dt);
  }

  function addToStage() {
    if (this.sk3d) {
      this.scene.addObject(this.sk3d);
    }
  }

  function removeFromStage() {
    if (this.sk3d) {
      this.sk3d.kill();
      this.sk3d = null;
    }
  }

  function isVisible() {
    return this.visible;
  }

  function setVisible(v) {
    this.visible = v;
    if (this.sk3d) {
      this.sk3d.setVisible(v);
    }
  }

  function applyPos() {
    _applyPos();
  }

  function _applyPos() {
    if (this.sk3d) {

      this.sk3d.matdirty = true;
    }
  }

  function setPos(pos) {

    this.sk3d.pos.set(pos);
    _applyPos()
  }

  function setPosXYZ(x, y, z) {

    this.sk3d.pos.set(x, y, z);
    _applyPos();
  }

  function getPos() {
    if (!this.sk3d) return Vector3D(0, 0, 0);
    return this.sk3d.pos;

  }

  function _applyAngle() {
    if (this.sk3d) {
      this.sk3d.rot.setHPB(this.angle * Math.DTOR, 0, 0);
      this.sk3d.dir = ::transformQuaternionToDir(this.sk3d.rot);
      this.sk3d.matdirty = true;
    }
  }

  function setAngle(angle) {
    this.angle = angle;
    _applyAngle();
  }

  function getAngle() {
    return this.angle;
  }

  function getSK3DObject() {
    return this.sk3d;
  }

  function _applyScale() {
    if (this.sk3d) {
      this.sk3d.scale.set(scale);
    }
  }

  function setScale(scale) {
    this.scale.set(scale);
    _applyScale();
  }

  function setScaleXYZ(x, y, z) {
    this.scale.set(x, y, z);
    _applyScale();
  }

  function inBounds(pos) {
    return inBoundsXYZ(pos.x, pos.y, pos.z);
  }
  function inBoundsXYZ(x, y, z) {
    if (this.sk3d) {
      local bnd = this.sk3d.bnd;
      local cx = this.sk3d.pos.x + bnd.x;
      local cy = this.sk3d.pos.y + bnd.y;
      local cz = this.sk3d.pos.z + bnd.z;

      return cx - bnd.r < x && cx + bnd.r > x
      && cy - bnd.s < y && cy + bnd.s > y
      && cz - bnd.t < z && cz + bnd.t > z;
    }

    return false;
  }

  function disablePhysicalBones() {
    if (this.sk3d) {
      this.sk3d.disablePhysicalBones();
    }
  }

  function resetPhysicalBones() {
    if (this.sk3d) {
      this.sk3d.resetPhysicalBones();
    }
  }

  function enablePhysicalBones() {
    if (this.sk3d) {
      this.sk3d.enablePhysicalBones();
    }
  }

  function registerModifierParameters() {
    if (!modifier_param) modifier_param = {};

    local _materials = sk3d.getMaterials();
    local _temp_materials = [];
    foreach (_mate in _materials) {
      _temp_materials + clone _mate;
    }
    modifier_param["materials"] <- clone _temp_materials;
    modifier_param["scale"] <- clone sk3d.scale;

    if (effect_runner instanceof SK3DEffectRunner) effect_runner.registerModifierParameters(modifier_param);
  }

  function setEffectScript(r) {
    local sk3 = r.getContent();
    local clsstr = sk3.scriptclass || "SK3DEffectRunner";
    local cls = getroottable()[clsstr];
    effect_runner = cls(sk3.clonescp ? clone sk3.script : sk3.script);
    effect_runner.setSK3DObject(this.sk3d);
    if ("setup" in effect_runner) effect_runner._exec_("setup");
  }

  function startEffect(fname, ...) {
    return effect_runner ? effect_runner._starta_(fname, varguments()) : false;
  }

  function isEffectRunning(key) {
    if (!effect_runner || !effect_runner.running_effect_table) return false;
    return this.effect_runner.running_effect_table[key];
  }

}