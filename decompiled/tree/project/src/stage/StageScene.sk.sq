class StageScene {
  static CAMERA_LOG = false;

  static STATE_NONE = 0;
  static STATE_LOAD = 1;
  static STATE_START = 2;
  static STATE_SHOW = 3;
  state = 0;

  scene = null;
  renderer = null;
  camera_work = null;

  view = null;
  sk3dview = null;
  back_view = null;

  next_stage_id = -1;
  stage_id = -1;

  bg_obj = null;
  ground_obj = null;
  part_objs = null;

  charas = null;
  ui_models = null;
  house_manager = null;

  need_update = false;

  b3body = null;
  camera_lock = null;

  v_1 = Vector3D();

  constructor() {
    this.scene = SK3DScene();
    this.scene.getB3World();
    this.renderer = createSceneRenderer();
    this.scene.dropshadow.cullfilterfunc = this.renderer.cullfilterfunc;

    local cameraobj = SK3DObject();
    this.renderer.setCameraObject(cameraobj);

    this.view = SKView();
    this.sk3dview = SK3DView(this.scene, this.renderer);
    this.sk3dview.setAutoUpdate(false);
    this.view.addChild(this.sk3dview);
    this.back_view = SKImageView();

    this.camera_work = CameraWork(this.renderer.cameraobj, 0.0, 0.0, 0.0);
    this.camera_work.addUpdateListener(this);

    this.part_objs = [];
    this.charas = {};
    this.ui_models = {};

    this.house_manager = ::HouseManager(this);
    this.house_manager.extendRooms();

    this.camera_lock = false;

  }

  function updateScene(dt) {
    if (!this.need_update) return;

    this.sk3dview.updateScene(dt);
    this.sk3dview.repaint();
    this.camera_work.update(dt);
    this.house_manager.update(dt);

    foreach (chara in charas) {
      chara.update(dt);
    }
  }

  function cameraUpdated(type = 1, force = false) {
    _cameraUpdateProcess(type, force);
  }
  function _cameraUpdateProcess(type = 1, force = false) {
    local cw = this.camera_work;
    this.house_manager.cameraUpdated(cw.camera.pos, cw.hpb[0], cw.hpb[1], cw.hpb[2], force);
    if (type == this.camera_work.UPDATE_TYPE_ROTATE || force) {
      _updateEnvLights();
    }
  }

  function _updateEnvLights() {
    local lights = this.scene.env.envlights;
    if (!lights || lights.len() == 0) return;

    local cam_h = int(this.camera_work.hpb[0] * Math.RTOD);
    cam_h = cam_h % 360;
    cam_h = cam_h > 180 ? cam_h - 360 : cam_h;

    foreach (li in lights) {
      local li_h = (li.hpb[0] < -180 ? li.hpb[0] + 360 : li.hpb[0]) % 360;
      li_h = li_h > 180 ? li_h - 360 : li_h;
      local dif = (cam_h - li_h) % 360;

      if (dif > 180) {
        dif -= 360;
      } else if (dif < -180) {
        dif += 360;
      }

      if (dif == 0) {
        li.enabled = false;
        continue;
      }

      li.enabled = Math.abs(dif) <= 45 ? true : false;
    }
  }

  function clearScene() {
    this.scene.clearObjects();

    this.state = STATE_NONE;
  }

  function loadStageScene(need_build_room = true, is_login = false, rid = -1) {
    clearScene();
    stopUpdate();

    initEnvironment();

    local ud = ::gamesession.getUserData();

    if (is_login) {
      local _udl = ::gamesession.getUserDataLocal();
      ud.selectRoom(_udl.getRoomIndex(), false);
    }

    if (need_build_room) {

      local show_room_idx = ud.getCurrentRoomIndex();
      local _rsd = ud.getRooms()[show_room_idx];
      if (_rsd) {
        changeCurrentRoom(_rsd.getRoomUID(), false, rid);

      }

    }

    this.state = STATE_LOAD;
  }

  function startStageScene() {
    startUpdate();

    ::charaActionListFactory.initCommonActionSetting();

    trackChara(-1);
    this.camera_work.input_lock = false;

    this.camera_work.setCameraDefault(true);

    this.camera_work.input_lock = false;
    this.camera_work.rotateTo(::CAMERA_ROTATE_H * Math.DTOR, ::CAMERA_ROTATE_P * Math.DTOR, ::CAMERA_ROTATE_B * Math.DTOR, true, true, true);

    _cameraUpdateProcess();
    this.state = STATE_START;
  }

  function showStageScene() {
    foreach (chara in charas) {
      chara.startUpdate();
    }

    this.state = STATE_SHOW;
  }

  function releaseStageScene() {
    this.need_update = false;
    clearScene();

    this.stage_id = -1;
    this.bg_obj = null;

    this.state = STATE_NONE;
  }

  function setCullFilterFunc(func = null) {
    this.renderer.setCullFilterFunc(func);
    this.scene.dropshadow.cullfilterfunc = this.renderer.cullfilterfunc;
  }

  function _setupUIModels() {
    this.ui_models = {};

  }

  function getStageID() {
    return this.stage_id;
  }

  function getScene() {
    return this.scene;
  }

  function getCameraWork() {
    return this.camera_work;
  }

  function getHouseManager() {
    return this.house_manager;
  }

  function getFurnitureModels() {
    return this.house_manager.getFurnitureLayoutManager().getFurnitureModels();
  }
  function getNearestFurnitureModel(p, can_product_check = false, need_dist = -1, ignore_fm = null, furniture_type = null) {
    return this.house_manager.getFurnitureLayoutManager().getNearestModel(p, can_product_check, need_dist, ignore_fm, furniture_type);
  }
  function getRandomFurnitureModel(can_product_check = false, furniture_type = null) {
    return this.house_manager.getFurnitureLayoutManager().getRandomModel(can_product_check, furniture_type);
  }
  function getFurnitureModel(uid) {
    return this.house_manager.getFurnitureLayoutManager().getFurnitureModel(uid);
  }
  function removeFurnitureModel(uid) {
    this.house_manager.getFurnitureLayoutManager().removeFurniture(uid);
  }
  function existFurnitureModel(fm, can_product_check = false) {
    return this.house_manager.getFurnitureLayoutManager().existFurnitureModel(fm, can_product_check);
  }

  function getView() {
    return this.view;
  }

  function addTapFloorEffect(x, y) {
    local _v = getTapFloorPos(x, y);
    if (!_v) return false;
    local p_efx = getParticleEffect(::getResource("/res/efx/ptd/tap_floor.ptd"));
    local ptd = ::SK3DObject();

    ptd.pos.set(_v);
    ptd.scale.set(2, 2, 2);
    ptd.matdirty = true;
    ptd.updateMatrix();

    this.scene.addObject(ptd);

    ptd.setParticle(p_efx);
    ptd.startParticle();
    return true;
  }

  function getTapFloorPos(x, y) {
    this.v_1.set(x / ::displayWidth, y / ::displayHeight, 0.0)
    local near = this.renderer.camera.unproject(v_1);
    this.v_1.z = 1.0;
    local far = this.renderer.camera.unproject(v_1);

    scene.b3world.updateAABBs();

    local b3res = scene.b3world.rayTest(1, near, far, 0 | 128, 4096);

    v_1.set(0, 0, 0);
    if (b3res.len() == 0) return null;

    v_1.set(b3res.pointb.x, 0, b3res.pointb.z);

    local _bnd = b3res.bodyb.getBounds();
    v_1.add(_bnd.x, 0, _bnd.z);
    v_1.add(_bnd.r / 2, 0, _bnd.t / 2);

    local _base = house_manager.getHouseBasePos();
    v_1.add(_base);
    v_1.add(0, 0.1, 0);

    if (!this.house_manager.isNode(v_1.x, v_1.z)) return null;

    return Vector3D(v_1);
  }

  function getTappedFurnitureModelAtScreenPosition(sx, sy) {
    this.v_1.set(sx / ::displayWidth, sy / ::displayHeight, 0.0)
    local near = this.renderer.camera.unproject(this.v_1);
    this.v_1.z = 1.0;
    local far = this.renderer.camera.unproject(this.v_1);

    scene.b3world.updateAABBs();
    local b3res = scene.b3world.rayTest(0, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);

    local _ret_model = null;
    if (b3res.len() > 0) {
      local furniture_models = this.house_manager.getFurnitureLayoutManager().getFurnitureModels();
      foreach (model in furniture_models) {
        if (model.disableTouch()) continue;
        foreach (res in b3res) {
          if (model.getB3body() == res.bodyb) {

            if (!model.isOverlaidModel()) return model;
            _ret_model = model;
          }
        }
      }
    }
    return _ret_model;
  }

  function getTappedFurnitureModelsAtScreenPosition(sx, sy) {
    this.v_1.set(sx / ::displayWidth, sy / ::displayHeight, 0.0)
    local near = this.renderer.camera.unproject(this.v_1);
    this.v_1.z = 1.0;
    local far = this.renderer.camera.unproject(this.v_1);

    scene.b3world.updateAABBs();
    local b3res = scene.b3world.rayTest(0, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);
    local _models = null;

    if (b3res.len() > 0) {
      local furniture_models = this.house_manager.getFurnitureLayoutManager().getFurnitureModels();
      foreach (model in furniture_models) {
        if (model.disableTouch()) continue;
        foreach (res in b3res) {
          if (model.getB3body() == res.bodyb) {
            if (!_models) _models = [];
            if (!(::contains(_models, model))) _models + model;
          }
        }
      }
    }
    return _models;
  }

  function getTappedCharaModelAtScreenPosition(sx, sy) {
    this.v_1.set(sx / ::displayWidth, sy / ::displayHeight, 0.0)
    local near = this.renderer.camera.unproject(this.v_1);
    this.v_1.z = 1.0;
    local far = this.renderer.camera.unproject(this.v_1);

    scene.b3world.updateAABBs();
    local b3res = scene.b3world.rayTest(0, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);
    if (b3res.len() > 0) {
      local furniture_models = this.house_manager.getFurnitureLayoutManager().getFurnitureModels();
      foreach (model in this.charas) {
        foreach (res in b3res) {
          if (model.getB3body() == res.bodyb) {
            return model;
          }
        }
      }
    }
    return null;
  }

  function getTappedModel_atScreenPos(screen_x, screen_y) {
    this.v_1.set(screen_x / ::displayWidth, screen_y / ::displayHeight, 0.0)
    local near = this.renderer.camera.unproject(v_1);
    this.v_1.z = 1.0;
    local far = this.renderer.camera.unproject(v_1);

    scene.b3world.updateAABBs();
    local b3res = scene.b3world.rayTest(1, near, far, ::ViewFactory.RAYTEST_MASK, ::ViewFactory.RAYTEST_GROUP);

    local _ret_model = null;
    if (b3res.len() > 0) {
      foreach (model in this.charas) {
        if (model.getB3body() == b3res.bodyb) {
          return model;
        }
      }

      local furniture_models = this.house_manager.getFurnitureLayoutManager().getFurnitureModels();
      foreach (model in furniture_models) {
        if (model.disableTouch()) continue;
        if (model.getB3body() == b3res.bodyb) {

          if (!model.isOverlaidModel()) return model;
          _ret_model = model;
        }
      }
    }
    return _ret_model;
  }

  function getUIModels() {
    return this.ui_models;
  }

  function setNextStageID(stage_id) {
    this.next_stage_id = stage_id;
  }

  function viewAdded() {
    local w = this.view.parent.bnd.w;
    local h = this.view.parent.bnd.h;

    local a = ::CAMERA_ANGLE_OF_VIEW * ::screenWidth / w * h / ::screenHeight;
    local _w = ::screenWidth;
    this.view.setRect(0.0, 0.0, ::screenWidth, ::screenHeight);
    this.sk3dview.setRect(0, 0.0, ::screenWidth, ::screenHeight);
    this.renderer.camera.perspective(a, w / h, 4.0, 1000.0);
    this.camera_work.setupPerspective(a, w / h, 4.0, 1000.0);
  }

  function stopUpdate() {
    this.view.visible = false;

    this.need_update = false;
  }
  function setNeedUpdate(b) {
    this.need_update = b;
  }

  function startUpdate() {
    this.view.visible = true;

    this.need_update = true;
  }

  function setupCameraBound() {
    local stage_env = ::gamesetting.stageenv[this.stage_id];
    if (stage_env["camera_bound"]) {
      local bound = stage_env["camera_bound"];
      local room_layout = ::gamesession.getUserData().getRoomLayout();
      local max_floor = ::HouseManager.Getter.getMaxFloorIdx(room_layout);
      local max_room = ::HouseManager.Getter.getMaxRoomIdx(room_layout);
      local room_pos = ::HouseManager.Factory.getRoomPos(max_floor + 1, max_room + 1);
      this.camera_work.setCameraBound(bound.left, bound.bottom, bound.front, room_pos.x + bound.right, room_pos.y + bound.top, bound.back - bound.front);
    }
  }

  function _setupCameraBoundAtCurrentRoom() {
    local _fr = this.house_manager.getCurrentRoomFloorRect();
    local _addy = 2.0;
    this.camera_work.setCameraBound(_fr.x - _fr.w / 2, ::HouseModel.FLOOR_DEPTH + _addy, _fr.y - _fr.h / 2, _fr.w, 15, _fr.h);
  }

  function changeBGImage(path) {
    local sp = ::getSprite(path);
    sp.blend = SK_PMAMIX;
    this.back_view.setSprite(sp);
    this.back_view.setRect((::screenWidth - sp.bnd.w) / 2, (::screenHeight - sp.bnd.h) / 2,
    sp.bnd.w, sp.bnd.h);
  }

  function initEnvironment() {

    local env = SK3DEnvironment(::gamesetting.scnenv["morning"]);
    this.scene.setEnvironment(env);
    local renderset = ::createRenderSetting(env["postfx"]);
    renderer.setRenderSetting(renderset);

    local sp = ::getSprite("/ui/image/bg.png");
    sp.blend = SK_PMAMIX;
    this.back_view.setSprite(sp);
    this.back_view.setRect(0, 0, ::screenWidth, ::screenHeight);
    renderer.setBackView(this.back_view);
    renderer.setOffsetMatrix(::rootview.mat);

    this.stage_id = this.next_stage_id;
    if (this.stage_id == -1) return;

    local stage_env = ::gamesetting.stageenv[this.stage_id];

    if (stage_env["camera_bound"]) {
      local bound = stage_env["camera_bound"];
    }

    local obj_origin = ::HouseManager.Factory.getRoomPartOrigin(0, 0);

    local pm = ::PrimitiveMeshes.createBox(50, 0.5, 50);
    local shp = b3Shape.createMesh(pm.vtx.getStream(SK_POSITION), [pm.face[0].idx]);
    this.b3body = b3Body(0.0, shp, Matrix(), 4096, 0 | 128);
    this.b3body.setTransform(Matrix.fromTranslate(-25, -0.01, -25));
    this.b3body.updateAABB();
    this.scene.b3world.addBody(this.b3body);

    updateStageParts();
  }

  function clearStageParts() {
    foreach (part in this.part_objs) {
      part.removeFromStage();
    }
    this.part_objs.clear();
  }

  function updateStageParts() {
    clearStageParts();

    local stage_parts = ::gamesetting.stageenv[this.stage_id]["parts"];
    if (!stage_parts) return;

    local ud = ::gamesession.getUserData();
    local max_room_idx = ::HouseManager.Getter.getMaxRoomIdx(ud.getRoomLayout());
    local origin = ::HouseManager.Factory.getRoomPartOrigin(0, 0);
    foreach (name, param in stage_parts) {
      if (param["from"] && param.from > max_room_idx + 1) continue;
      if (param["to"] && param.to <= max_room_idx) continue;

      local obj = ::StageObject(this.scene);
      obj.build(param.path);
      obj.sk3d.name = name;
      obj.setPosXYZ(origin.x + (param["posx"] || 0.0) * TEST_ROOM_SCALE_X, origin.y, origin.z);
      obj.addToStage();
      this.part_objs + obj;
    }
  }

  function changeCurrentRoom(uid, isUI = false, rid = -1) {

    local _scene = ::gamesession.getCurrentScene();
    _scene.clearApproachCharaList();
    foreach (cos_id, chara in this.charas) {
      chara.release();
    }
    Table.clear(this.charas);
    local ud = ::gamesession.getUserData();
    local room_idx = ud.getRoomSlotIndexByRoomUID(uid);

    local room_edit_data = ud.getRoomEditData(uid);
    local room_setting = ::gamesetting.room_settings[room_edit_data.getRoomID()];
    changeBGImage(room_setting.getBGImagePath());
    this.house_manager.initRoom(room_idx, uid, true);
    this.house_manager.changeRoom(room_idx, true, rid);

    local _room_idx = ud.getRoomSlotIndexByRoomUID(uid);
    local curr_charas = ud.getResideCharas(_room_idx);
    foreach (costume_id in curr_charas) {
      if (ud.getCostumeData(costume_id).hasWorkData()) continue;
      this.addChara(costume_id);
    }

    if (!isUI) {
      _scene.restartProductFurnitureAction();
      _setupCameraBoundAtCurrentRoom();
      _cameraUpdateProcess();
    }

    _scene.getProductionManager().cancelProductAll();
    _scene.getPanelMissionManager().changePanelMissionByRoomId(uid);
  }

  function setRoomModel(rid) {

    local room_setting = ::gamesetting.room_settings[rid];
    changeBGImage(room_setting.getBGImagePath());
    this.house_manager.changeRoom(-1, true, rid);
    _cameraUpdateProcess();
  }

  function setViewRect(vx, vy, vw, vh) {
    this.view.setRect(vx, vy, vw, vh);
    this.sk3dview.setRect(vx, vy, vw, vh);
    this.back_view.setRect(vx, vy, vw, vh);
  }

  function setCameraLock(b) {
    this.camera_lock = b;
  }

  function zoomCamera(rate, immediate = false) {
    if (this.camera_lock) return;

    this.camera_work.zoom(rate, immediate);

    cameraTestPrint();
  }
  function zoomNextFixedRate(immediate = false) {
    if (this.camera_lock) return;

    this.camera_work.input_lock = false;
    this.camera_work.zoomNextFixedRate(immediate);
  }

  function moveCamera_byScreenDist(move_sx, move_sy) {
    if (this.camera_lock) return;

    local v = Vector3D();
    local point1 = this.renderer.camera.unproject(v.set(0.0, 0.0, 0.0));
    local point2 = this.renderer.camera.unproject(v.set(1.0, 1.0, 1.0));
    local point3 = this.renderer.camera.unproject(v.set(0.0, 0.0, 1.0));

    local rate = 0.0135;
    local _dir = Math.atan2(move_sy, move_sx);
    local _dis = Math.sqrt(move_sx * move_sx + move_sy * move_sy);
    local _h = camera_work.hpb[0] + _dir;

    local dis_p = _dis * Math.cos(_dir);
    local dis_h = _dis * Math.sin(_dir);

    local dis_cos = dis_h * Math.cos(camera_work.hpb[1]);
    local dis_sin = dis_h * Math.sin(camera_work.hpb[1]);

    local x = rate * (dis_p * Math.cos(camera_work.hpb[0]) - dis_sin * Math.sin(camera_work.hpb[0]));
    local z = rate * (dis_p * Math.sin(camera_work.hpb[0]) + dis_sin * Math.cos(camera_work.hpb[0]));
    local y = rate * dis_cos;

    this.camera_work.moveTargetXYZ(-x, y, z, true);

    cameraTestPrint();
  }

  function rotateCamera_byScreenDist(move_sx, move_sy) {
    if (this.camera_lock) return;

    local _dir = Math.atan2(move_sy, move_sx);
    local rate = 0.25;
    local _dis = Math.sqrt(move_sx * move_sx + move_sy * move_sy) * rate;

    _dis = Math.min(_dis, 20);

    local _add_h = _dis * Math.cos(_dir);
    local _add_p = _dis * Math.sin(_dir);

    local _h = this.camera_work.hpb[0] / Math.DTOR + _add_h;
    local _p = this.camera_work.hpb[1] / Math.DTOR + _add_p;

    _p = Math.clamp(_p, this.camera_work.MIN_PITCH, this.camera_work.MAX_PITCH);

    _h *= Math.DTOR;
    _p *= Math.DTOR;

    this.camera_work.input_lock = true;

    this.camera_work.rotateMoveToImmediate(_h, _p, this.camera_work.hpb[2]);

    cameraTestPrint();
  }

  function cameraTestPrint() {
    if (!CAMERA_LOG) return;
    if (!this.camera_work || !this.camera_work.camera) return;
    local _pos = this.camera_work.camera.pos;
    local _hpb = this.camera_work.hpb;
    if (!_pos || !_hpb) return;
    println(
    "x:" + int(_pos.x)
    +"  y:" + int(_pos.y)
    +"  z:" + int(_pos.z)
    +"    "
    +"  h:" + int(_hpb[0] * Math.RTOD)
    +"  p:" + int(_hpb[1] * Math.RTOD)
    );
  }

  function rotateCameraMove(h, p, b, immediate = false) {
    if (this.camera_lock) return;
    if (this.camera_work.is_rollcamera) return;

    local _h = this.camera_work.hpb[0] / Math.DTOR + h;
    local _p = this.camera_work.hpb[1] / Math.DTOR + p;
    local _b = this.camera_work.hpb[2] / Math.DTOR + b;

    if (p != 0) {
      if (_p > this.camera_work.MAX_PITCH) {
        println("movePitch is OverMax !!! p = " + _p + ", MAX = " + this.camera_work.MAX_PITCH)
        _p = ::CAMERA_ROTATE_P;
      } else if (_p < this.camera_work.MIN_PITCH) {
        println("movePitch is UnderMin !!! p = " + _p + ", MIN = " + this.camera_work.MAX_PITCH)
        _p = this.camera_work.MAX_PITCH;
      }
    }

    this.camera_work.input_lock = true;
    if (immediate) {
      this.camera_work.rotateMoveToImmediate(_h * Math.DTOR, _p * Math.DTOR, _b * Math.DTOR);
    } else {
      this.camera_work.rotateMoveTo(_h * Math.DTOR, _p * Math.DTOR, _b * Math.DTOR, false, false);
    }

  }

  function trackChara(cos_id) {
    if (this.camera_lock) return;
    local chara = getChara(cos_id);

    if (chara) {
      this.camera_work.input_lock = false;
      this.camera_work.setTrackingTarget(chara);

      local _h = this.camera_work.hpb[0];
      local _p = 10 * Math.DTOR;
      local _b = this.camera_work.hpb[2];

      this.camera_work.input_lock = false;
      this.camera_work.rotateMoveTo(_h, _p, _b, true);
      this.camera_work.zoomFixedRate(5.0);
    }

  }

  function trackModel(model, target_offset = null, zoom_rate = 10.3) {
    if (this.camera_lock) return;
    this.camera_work.input_lock = false;
    this.camera_work.setTrackingTarget(model);

    this.camera_work.input_lock = false;

    local _h = this.camera_work.hpb[0];
    local _p = 7 * Math.DTOR;
    local _b = this.camera_work.hpb[2];

    this.camera_work.zoomFixedRate(zoom_rate);
    this.camera_work.input_lock = false;
    this.camera_work.rotateMoveTo(_h, _p, _b, false);

    if (target_offset && target_offset.length() > 0.001) setTargetOffset(target_offset);
  }

  function setTargetOffset(target_offset) {
    if (this.camera_lock) return;
    this.camera_work.setTargetOffset(target_offset);
  }

  function addTargetOffset(target_offset) {
    if (this.camera_lock) return;
    this.camera_work.addTargetOffset(target_offset);
  }

  function stopTrackModel() {
    if (this.camera_lock) return;

    this.camera_work.input_lock = false;
    this.camera_work.setTrackingPointer();
    this.camera_work.setCameraDefault();

    this.camera_work.input_lock = false;

    this.camera_work.rotateMoveTo(::CAMERA_ROTATE_H * Math.DTOR, ::CAMERA_ROTATE_P * Math.DTOR, ::CAMERA_ROTATE_B * Math.DTOR, true);

    camera_work.active = true;
  }

  function setCameraDefault(immediate = false, is_trace_rate_default = true) {
    if (this.camera_lock) return;

    this.camera_work.input_lock = false;
    this.camera_work.setCameraDefault(immediate, is_trace_rate_default);
    this.camera_work.input_lock = false;

    if (immediate) {
      this.camera_work.rotateTo(::CAMERA_ROTATE_H * Math.DTOR, ::CAMERA_ROTATE_P * Math.DTOR, ::CAMERA_ROTATE_B * Math.DTOR, is_trace_rate_default, true, immediate);
    } else {
      this.camera_work.rotateMoveTo(::CAMERA_ROTATE_H * Math.DTOR, ::CAMERA_ROTATE_P * Math.DTOR, ::CAMERA_ROTATE_B * Math.DTOR);
    }
  }

  function addChara(cos_id) {
    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof SanrioGameScene)) return;

    local chara = ::CharaModel(this.scene, this);
    chara.build(cos_id, true, true);

    this.charas[cos_id] <- chara;
    _scene.addApproachList(chara);

    if (this.state == STATE_SHOW) chara.startUpdate();
  }

  function removeChara(cos_id) {
    local chara = getChara(cos_id);
    if (!chara) return;

    ::gamesession.getCurrentScene().removeApproachList(chara);
    chara.release();
    delete charas[cos_id];
  }

  function getChara(cos_id) {
    return this.charas[cos_id];
  }

  function getFirstChara() {
    foreach (cm in this.charas) {
      return cm;
    }
    return null;
  }

  function getCharacters() {
    return this.charas;
  }

  function getCharaNum() {
    return length(this.charas);
  }

  function getNearestCharacter(p, can_product_check = false, can_attract_check = false) {
    local _ret_cm = null;
    local _ret_dist = -1;
    local _pmanager = ::gamesession.getCurrentScene().getProductionManager();
    foreach (cm in this.charas) {
      if (can_product_check && _pmanager.isProducting(cm.getCostumeID())) continue;
      if (can_attract_check && cm.hasAttractTarget()) continue;
      local _d = ::getDistance(p, cm.getPos());
      if (!_ret_cm || _ret_dist > _d) {
        _ret_cm = cm;
        _ret_dist = _d;
      }
    }
    return { cm = _ret_cm, dist = _ret_dist };
  }

  function processCharasDeliverScript() {
    foreach (_chara in charas) {
      if (_chara.getCostumeData().hasWorkData()) continue;
      if (_chara.getTargetFurnitureUID() && _chara.getTargetFurnitureUID() != -1) continue;

      _chara.startCharaScriptAction("furniture_deliverd");
    }
  }

  function reloadGlobals() {
    runsk("/src/globals/reload.sk");
    viewAdded();
    this.camera_work.input_lock = false;
    this.camera_work.setCameraDefault(true);
    this.camera_work.rotateTo(::CAMERA_ROTATE_H * Math.DTOR, ::CAMERA_ROTATE_P * Math.DTOR, ::CAMERA_ROTATE_B * Math.DTOR);
  }

  function houseUpdated() {

  }

  function setEditTmpGrids(floor, room, fm, is_del) {

  }

  function enableEditFurniture(floor, room, edit_info) {

  }

  function roomUpdated(floor, room, edit_info = null) {

  }

  function setVisibleGridWire(b) {
    this.house_manager.setVisibleGridWire(b);
  }

  function getEnableUseFurnitureList(f) {
    local _ufl = room_info_manager.getEnableUseFurnitureList(f);

    return _ufl;

  }
}

class StageScene.CameraWork extends ::CameraWork {
  static MIN_ZOOM_DIST = 4.0;
  static MAX_ZOOM_DIST = 55.0;

  static RELEASE_LOCK_DIST = 0.4;
  static MAX_LOCK_TIME = 2500;

  static MAX_TRACKING_SPPED = 1.0;
  static MOVE_TRACKING_RATE = 0.05;
  static MOVE_TRACKING_RATE_FAST = 0.28;

  static ROTATE_SPEED_RATE = 0.003;
  static ROTATE_SPEED_RATE_SLOW = 0.0008;
  rotate_spd = null;

  static MAX_PITCH = 90;
  static MIN_PITCH = 10;

  dist = null;
  target = null;
  target_offset = null;
  pointer = null;

  tracing_rate = null;

  input_lock = false;
  lock_timer = 0;

  camera_bound = null;
  rotate_limit = null;

  goal_hpb = null;
  is_rollcamera = null;

  fovy = 0.0;
  aspect = 0.0;

  static FIXED_ZOOM_RATES = [10, 33.24154, 65];

  update_listener_map = null;
  static UPDATE_TYPE_MOVE = 1;
  static UPDATE_TYPE_ROTATE = 2;

  scroll_lock = null;

  v_1 = Vector3D();
  v_2 = Vector3D();
  v_3 = Vector3D();

  camera_records = null;

  min_zoom_dist = null;
  max_zoom_dist = null;

  constructor(camera, h, p, b) {
    super(camera, h, p, b);

    this.update_listener_map = {};

    is_rollcamera = false;

    this.dist = Vector3D();
    this.pointer = TrackingPointer();

    this.tracing_rate = MOVE_TRACKING_RATE;

    camera_records = {};
    this.target_offset = Vector3D();

    min_zoom_dist = MIN_ZOOM_DIST;
    max_zoom_dist = MAX_ZOOM_DIST;

    this.scroll_lock = false;
  }

  function setTrackingTarget(target, is_trace_rate_default = true, offset = null) {
    this.tracing_rate = is_trace_rate_default ? MOVE_TRACKING_RATE : MOVE_TRACKING_RATE_FAST;
    this.target = target;
    if (offset) target_offset.set(offset);
    else target_offset.set(0.0, 0.0, 0.0);
  }

  function addTargetOffset(offset) {
    this.target_offset = this.target_offset + offset;
  }

  function setTargetOffset(offset) {
    this.target_offset.set(offset);
  }
  function getTrackingTarget() {
    return this.target;
  }

  function setInputLock(b) {
    this.input_lock = b;
  }

  function setScrollLock(b) {
    this.scroll_lock = b;
  }

  function addUpdateListener(ins) {
    if (!("cameraUpdated" in ins)) return;
    this.update_listener_map[ins] <- true;
  }
  function removeUpdateListener(ins) {
    delete this.update_listener_map[ins];
  }

  function setCameraDefault(immediate = false, is_trace_rate_default = true) {
    setTrackingPointer();
    input_lock = false;
    setTargetXYZ(::TARGET_DEFAULT_X, ::TARGET_DEFAULT_Y, ::TARGET_DEFAULT_Z, immediate);
    input_lock = false;

    this.tracing_rate = is_trace_rate_default ? MOVE_TRACKING_RATE : MOVE_TRACKING_RATE_FAST;

    setDefaultDist(immediate);

  }

  function setTrackingPointer() {
    setTrackingTarget(pointer);

    return pointer;
  }

  function setTargetXYZ(x, y, z, immediate = false, is_trace_rate_default = true) {

    if (this.input_lock) return;
    if (!(this.target instanceof TrackingPointer)) return;

    this.tracing_rate = is_trace_rate_default ? MOVE_TRACKING_RATE : MOVE_TRACKING_RATE_FAST;

    if (this.camera_bound) {

      local _clamp = Math.clamp, bnd = this.camera_bound;
      x = _clamp(x, bnd.x, bnd.x + bnd.r);
      y = _clamp(y, -5.0, 13);
      z = _clamp(z, bnd.z, bnd.z + bnd.t);

    }
    this.target.setPosXYZ(x, y, z);
    this.target_offset.set(0.0, 0.0, 0.0);

    this.input_lock = !immediate;
    if (immediate) immediateTrack();
  }

  function moveTargetXYZ(x, y, z, immediate = false, is_trace_rate_default = true) {
    local tp = this.target.getPos();

    local nx = tp.x + x;
    local ny = tp.y + y;
    local nz = tp.z + z;

    setTargetXYZ(nx, ny, nz, immediate, is_trace_rate_default);
  }

  function setTrackingRate(is_trace_rate_default = true) {
    this.tracing_rate = is_trace_rate_default ? MOVE_TRACKING_RATE : MOVE_TRACKING_RATE_FAST;
  }

  function setDist(vec, immediate = false, is_trace_rate_default = true) {
    if (this.input_lock) return false;

    this.tracing_rate = is_trace_rate_default ? MOVE_TRACKING_RATE : MOVE_TRACKING_RATE_FAST;

    local dist = Math.max(vec.length(), min_zoom_dist);
    local scale = Math.clamp(vec.length(), min_zoom_dist, max_zoom_dist);
    this.dist.set(vec.normalize().scale(scale));

    this.input_lock = !immediate;
    if (immediate) immediateTrack();

    return true;
  }

  function setMinZoomDist(min_dist, update = false, immediate = false) {
    this.min_zoom_dist = min_dist;

    if (update) {
      setDist(this.dist, immediate);
    }
  }

  function setMaxZoomDist(max_dist, update = false, immediate = false) {
    this.max_zoom_dist = max_dist;

    if (update) {
      setDist(this.dist, immediate);
    }
  }

  function getDistLength() {
    return this.dist.length();
  }

  function setDistXYZ(x, y, z, immediate = false, is_trace_rate_default = true) {
    setDist(v_1.set(x, y, z), immediate, is_trace_rate_default);
  }
  function setDistXYZTransRot(x, y, z, immediate = false, is_trace_rate_default = true) {
    v_1.set(x, y, z);
    v_1.transform0(this.camera.gmat);
    setDist(v_1, immediate, is_trace_rate_default);
  }

  function setDefaultDist(immediate = false, is_trace_rate_default = true) {
    v_1.set(::CAMERA_DEFAULT_X, ::CAMERA_DEFAULT_Y, ::CAMERA_DEFAULT_Z);
    v_1.transform0(this.camera.gmat);
    setDist(v_1, immediate, is_trace_rate_default);
  }

  function zoom(rate, immediate = false, is_trace_rate_default = true) {
    v_1.set(this.dist).scale(rate);
    if (this.camera_bound) {
      local tp_y = this.target.getPos().y;
      local cm_y = tp_y + v_1.y;

      if (cm_y < this.camera_bound.y) return;
    }

    setDist(v_1, immediate, is_trace_rate_default);
  }

  function zoomFixedRate(rate, immediate = false, is_trace_rate_default = true) {
    v_1.set(this.dist).normalize().scale(rate);
    if (this.camera_bound) {
      local tp_y = this.target.getPos().y;
      local cm_y = tp_y + v_1.y;

      if (cm_y < this.camera_bound.y) return;
    }
    setDist(v_1, immediate, is_trace_rate_default);
  }

  function zoomNextFixedRate(immediate = false, is_trace_rate_default = false) {
    local len = this.dist.length();
    local idx = -1;
    for (local i = 0; i < FIXED_ZOOM_RATES.len(); i++) {
      if (len <= FIXED_ZOOM_RATES[i]) {
        idx = i - 1;
        break;
      }
    }

    local rate = idx != -1 ? FIXED_ZOOM_RATES[idx] : FIXED_ZOOM_RATES[FIXED_ZOOM_RATES.len() - 1];

    v_1.set(this.dist).normalize().scale(rate);
    setDist(v_1, immediate, is_trace_rate_default);
  }

  function immediateTrack() {
    local tp = this.target.getPos() + target_offset;
    if (this.target instanceof ::CharaModel) {
      local _sk3d = this.target.obj.sk3d;
      if (_sk3d.parent) {
        tp.add(_sk3d.parent.pos);
      }
    }

    moveTo(tp.x + dist.x, tp.y + dist.y, tp.z + dist.z);
    this.input_lock = false;
  }

  function setupPerspective(fovy, aspect, znear, zfar) {

    this.fovy = fovy;
    this.aspect = aspect;

  }

  function setCameraBound(x, y, z, r, s, t) {
    this.camera_bound = Rect3D(x, y, z, r, s, t);

  }

  function setRotateLimit(h, p, b) {

  }

  function rotateTo(h, p, b, is_trace_rate_default = true, force = false, immediate = false) {
    if (!super.rotateTo(h, p, b, force)) return false;

    this.camera.updateMatrix();

    if (this.dist) {

      v_1.set(::CAMERA_DEFAULT_X, ::CAMERA_DEFAULT_Y, ::CAMERA_DEFAULT_Z).transform0(this.camera.gmat);

      local _rate = this.dist.length() / v_1.length();
      local ret = setDist(v_1.scale(_rate), immediate, is_trace_rate_default);

    }

    return true;
  }
  elapse_time = 0;

  function rotateMoveTo(h, p, b, speed_slow = false, not_accel = true) {

    goal_hpb = [h, p, b];
    is_rollcamera = true;
    this.rotate_spd = speed_slow ? ROTATE_SPEED_RATE_SLOW : ROTATE_SPEED_RATE;
    elapse_time = not_accel ? 1000 : 0;
  }

  function rotateMoveToImmediate(h, p, b) {
    _rt(h, p, b);

    is_rollcamera = false;

    local cam = clone this.camera;
    cam.updateMatrix();
    v_2.set(::CAMERA_DEFAULT_X, ::CAMERA_DEFAULT_Y, ::CAMERA_DEFAULT_Z).transform0(cam.gmat)
    v_2.normalize().scale(this.dist.length());

    this.dist.set(v_2);
    v_1.set(this.target.getPos() + target_offset).add(this.dist).sub(this.camera.pos);
    if (this.target instanceof ::CharaModel) {
      local _sk3d = this.target.obj.sk3d;
      if (_sk3d.parent) {
        v_1.add(_sk3d.parent.pos);
      }
    }

    move(v_1.x, v_1.y, v_1.z);
    this.camera.updateMatrix();
  }

  function moveToModel(model) {
    local cam = clone this.camera;
    cam.updateMatrix();
    v_2.set(::CAMERA_DEFAULT_X, ::CAMERA_DEFAULT_Y, ::CAMERA_DEFAULT_Z).transform0(cam.gmat)
    v_2.normalize().scale(this.dist.length());

    this.dist.set(v_2);
    v_1.set(model.getPos()).add(this.dist).sub(this.camera.pos);
    if (model instanceof ::CharaModel) {
      local _sk3d = model.obj.sk3d;
      if (_sk3d.parent) {
        v_1.add(_sk3d.parent.pos);
      }
    }

    move(v_1.x, v_1.y, v_1.z);
    this.camera.updateMatrix();
  }

  function hasCameraRecordsFromClassname(classname) {
    return classname in this.camera_records;
  }

  function setTempRecordCamera(classname) {
    if (this.target) {
      v_1.set(this.target.getPos());
    } else {
      this.v_1.set(::TARGET_DEFAULT_X, ::TARGET_DEFAULT_Y, ::TARGET_DEFAULT_Z);
    }

    if (!(classname in this.camera_records)) {
      this.camera_records[classname] <- null;
    }
    this.camera_records[classname] = {
      target = Vector3D().set(v_1),
      distlen = this.dist.length(),
      hpb = clone this.hpb,
      target_offset = Vector3D().set(this.target_offset)
    }
  }

  function restoreCameraAtTempRecord(classname, immediate = false) {
    if (!(classname in this.camera_records)) return false;

    local record = this.camera_records[classname];

    this.pointer.setPos(record.target);
    setTrackingPointer();
    target_offset.set(this.target_offset);

    zoomFixedRate(record.distlen, immediate);

    if (immediate) {
      rotateMoveToImmediate(record.hpb[0], record.hpb[1], record.hpb[2]);
    } else {
      rotateMoveTo(record.hpb[0], record.hpb[1], record.hpb[2]);
    }

    return true;
  }

  function update(dt) {
    this.camera.update(dt);
    if (!this.target) return;

    if (is_rollcamera) {
      elapse_time += dt;
      local _rate = Math.min(1.0, elapse_time / 500.0);
      local dr = rotate_spd * dt * _rate;
      local dh = goal_hpb[0] - hpb[0];
      local dp = goal_hpb[1] - hpb[1];
      local db = goal_hpb[2] - hpb[2];

      local pi = Math.PI;

      if (Math.abs(dh) > pi) dh += dh < 0 ? pi * 2 : pi * -2;
      if (Math.abs(dp) > pi) dp += dp < 0 ? pi * 2 : pi * -2;
      if (Math.abs(db) > pi) db += db < 0 ? pi * 2 : pi * -2;

      dh = dh > 0 ? Math.min(dh, dr) : Math.max(dh, -dr);
      dp = dp > 0 ? Math.min(dp, dr / 2) : Math.max(dp, -dr / 2);
      db = db > 0 ? Math.min(db, dr) : Math.max(db, -dr);

      if (dh == 0 && dp == 0 && db == 0) {
        is_rollcamera = false;
        return;
      }

      _rt(hpb[0] + dh, hpb[1] + dp, hpb[2] + db);

      local cam = clone this.camera;
      cam.updateMatrix();

      v_2.set(::CAMERA_DEFAULT_X, ::CAMERA_DEFAULT_Y, ::CAMERA_DEFAULT_Z).transform0(cam.gmat)
      v_2.normalize().scale(this.dist.length());

      v_3.set(this.dist).sub(v_2);

      this.dist.set(v_2);

      v_1.set(this.target.getPos()).add(target_offset).add(this.dist).sub(this.camera.pos);
      if (this.target instanceof ::CharaModel) {
        local _sk3d = this.target.obj.sk3d;
        if (_sk3d.parent) {
          v_1.add(_sk3d.parent.pos);
        }
      }

      if (!input_lock) {
        local dist = v_1.length();
        local _r = MAX_TRACKING_SPPED;
        if (dist > _r) {
          v_1.scale(_r / dist);
        }
      }

      move(v_1.x, v_1.y, v_1.z);
      this.camera.updateMatrix();
    }

    v_1.set(this.target.getPos()).add(target_offset);
    if (this.target instanceof ::CharaModel) {
      local _sk3d = this.target.obj.sk3d;
      if (_sk3d.parent) {
        v_1.add(_sk3d.parent.pos);
      }
    }
    if (!(this.target instanceof TrackingPointer)) this.pointer.pos.set(v_1);
    v_1.add(this.dist).sub(this.camera.pos);

    if (this.input_lock) {

      if (v_1.length() < RELEASE_LOCK_DIST) {
        this.input_lock = false;
      }
      else {
        this.lock_timer += dt;
        if (this.lock_timer > MAX_LOCK_TIME) {
          this.input_lock = false;
          this.lock_timer = 0;
        }
      }
    }

    v_1.scale(this.tracing_rate);

    local dist = v_1.length();
    if (dist > MAX_TRACKING_SPPED) {
      v_1.scale(MAX_TRACKING_SPPED / dist);
    }
    move(v_1.x, v_1.y, v_1.z);

  }

  function _mv(x, y, z) {
    if (!this.active) return false;

    if (this.camera_bound && this.fovy > 0.0) {

    }

    if (super._mv(x, y, z)) {
      _callUpdateListenersFunc(UPDATE_TYPE_MOVE);
      return true;
    }

    return false;
  }

  function _rt(h, p, b, force = false) {
    if (!this.active) return false;

    if (this.rotate_limit) {
      local _clamp = Math.clamp, lmt = this.rotate_limit;
      h = _clamp(h, -lmt[0], lmt[0]);
      p = _clamp(p, -lmt[1], lmt[1]);
      b = _clamp(b, -lmt[2], lmt[2]);
    }

    if (super._rt(h, p, b, force)) {
      _callUpdateListenersFunc(UPDATE_TYPE_ROTATE);
      return true;
    }

    return false;
  }

  function _callUpdateListenersFunc(type) {
    foreach (listener, _ in this.update_listener_map) {
      listener.cameraUpdated(type);
    }
  }

}

class StageScene.CameraWork.TrackingPointer {
  pos = null;

  constructor() {
    this.pos = Vector3D();
  }

  function setPos(vec) {
    this.pos.set(vec);
  }

  function setPosXYZ(x, y, z) {
    this.pos.set(x, y, z);
  }

  function getPos() {
    return pos;
  }
}