class TalkWindow extends SKView {
  state = -1;
  static STATE_STAY = 0;
  static STATE_STARTED = 1;
  static STATE_END = 2;

  talk_list = [];
  sentence_list = [];
  start_time = -1;
  talk_index = -1;

  thread = null;
  icon = null;

  layer = null;

  view = null;
  lbl_text = null;

  camera = null;
  sk3d = null;
  scene = null;

  v_1 = null;
  offset = null;
  bone_offset = null;
  furniture_offset = null;

  scene_bnd = null;
  big_size = false;
  talk_key = null;
  chara_key = null;

  updater = null;

  has_rootview = true;

  small_size = false;

  showtime_default = -1;
  showtime_strlen = -1;

  constructor(talk_key, chara_key, big_size = false, small_size = false, use_talk_bal = false) {

    this.talk_key = talk_key;
    this.chara_key = chara_key;

    state = STATE_STAY;

    sentence_list = [];

    _setupView(big_size, small_size, use_talk_bal);

    this.matdirty = true;
    this.repaint();

    _setupTalkList();

    v_1 = Vector3D();
    bone_offset = Vector3D(0, 0, 0);
    this.furniture_offset = [0, 0];
    setOffset(0, 3.5, 0);
    scene = ::gamesession.getCurrentScene();
    scene_bnd = clone scene.bnd;
    this.big_size = big_size;

    this.showtime_default = 1000;
    this.showtime_strlen = 300;
  }

  function _setupView(big_size = false, small_size = false, use_talk_bal = false) {
    this.small_size = small_size;
    view = ::loadSKView(use_talk_bal ? "/ui/common/TalkBalloon.ui" : big_size ? "/ui/Balloon_Big.ui" : "/ui/Balloon.ui");
    view.enabled = false;
    view.pickable = false;

    local _pnl = this.view.findChild("pnl");
    local pnl_icon;
    if (use_talk_bal) {
      lbl_text = _pnl.findChild("txt_talk");
      lbl_text.visible = true;
      pnl_icon = _pnl.findChild("pnl_charaicon");
    }
    else if (big_size) {
      lbl_text = _pnl.findChild("txt_talk");
      lbl_text.visible = true;
      pnl_icon = _pnl.findChild("pnl_charaicon");
    }
    else if (small_size) {
      lbl_text = _pnl.findChild("txt_talk_s");
      lbl_text.visible = true;
      _pnl.findChild("txt_talk").visible = false;
      _pnl.findChild("img_balloon_bg").visible = false;
      _pnl.findChild("img_balloon_s").visible = true;
      pnl_icon = _pnl.findChild("pnl_charaicon_s");
    }
    else {
      lbl_text = _pnl.findChild("txt_talk");
      lbl_text.visible = true;
      _pnl.findChild("txt_talk_s").visible = false;
      _pnl.findChild("img_balloon_bg").visible = true;
      _pnl.findChild("img_balloon_s").visible = false;
      pnl_icon = _pnl.findChild("pnl_charaicon");
    }
    lbl_text.textbox.wrapmode = 1;
    lbl_text.setText("");
    if (!::READ_TRANS_FILE.equals("JP")) lbl_text.fontattr.size = big_size ? 55 : 32;
    view.pickable = false;
    addChild(view);

    pnl_icon.setVisible(false);

    view.centerize(0.5, 0.5);
  }
  function _setupTalkList() {
    talk_list = [];
    talk_list = ::talk.get(talk_key, chara_key);
    if (!talk_list) print("[ERROR] no talk data!!!! talk = " + talk_key + " , chara = " + chara_key + "\n");
  }

  function setSceneBound(bnd) {
    scene_bnd = bnd;
  }

  function setLayer(layer) {
    this.layer = layer;
  }
  function removeToSKView() {
    if (this.layer) this.layer.removeTalkWindow(this);
  }

  function getState() {
    return state;
  }

  function setShowTime(def_time, add_time) {
    if (def_time > 0) this.showtime_default = def_time;
    if (add_time >= 0) this.showtime_strlen = add_time;
  }

  function getTalkParam() {
    return {
      talk = this.talk_key,
      chara = chara_key,
      sk3d = this.sk3d,
      offset = this.offset,
      camera = this.camera,
      bound = this.scene_bnd,
      bone_offs = this.bone_offset,
      talk_index = this.talk_index,
      has_rootview = this.has_rootview,
      state = this.state
    };
  }

  function setScale(s) {
    view.scale.set(s);
    view.matdirty = true;
    view.repaint();
  }
  function setPos(x, y) {
    view.pos(x, y);
    view.matdirty = true;
    view.repaint();
  }

  function setRotation(x, y, z) {
    view.rot.set(x, y, z);
    view.matdirty = true;
    view.repaint();
  }

  function setOffset(x, y, z) {
    offset = [x, y, z];
  }
  function getBoneOffset() {
    return bone_offset;
  }
  function setBoneOffset(vec) {
    this.bone_offset.set(vec);
  }

  function setFurnitureOffset(x, y) {
    this.furniture_offset = [x, y];
  }

  function setSK3D(sk3d) {
    this.sk3d = sk3d;
  }
  function setRendererCamera(camera) {
    this.camera = camera;
  }

  function updateFrame(dt) {
    flushPosition();
  }

  function flushPosition() {
    this.view.visible = this.sk3d.visible;

    if (getState() == STATE_STARTED) {
      v_1.set(sk3d.pos);
      if (sk3d.parent) v_1.add(sk3d.parent.pos);
      v_1.add(bone_offset);
      v_1.add(offset[0], offset[1], offset[2]);
      local v = this.camera.project(v_1);
      local _px = scene_bnd.w * v.x + this.furniture_offset[0];
      local _py = scene_bnd.h * v.y + this.furniture_offset[1];
      setPos(_px, _py);
    }

    this.view.matdirty = true;
  }

  function startRandomTalk() {
    if (!talk_list) return;

    local _idx = ::PUBLIC_RANDOM.nexti(talk_list.len());
    return startTalk(_idx);
  }

  function startTalk(idx) {
    local _talk = talk_list[idx];
    if (!_talk) return;

    sentence_list = _getSentenceList(talk_list[idx]);

    this.talk_index = idx;
    thread = newthread();
    thread.start(_startTalk, this);
    if (sk3d) setUpdateFunc(updateFrame.bindenv(this));

    return idx;
  }

  function interruptTalk() {
    if (this.thread && state != STATE_END) {
      this.thread.interruptGoto("END");
    }
  }

  function _getSentenceList(_res) {
    local _list = [];

    local i = _res.indexOf("<ns>");
    while (i != -1) {
      local _s = _res.slice(0, i);
      _list + _s;
      _res = _res.slice(i + 4, _res.len());

      i = _res.indexOf("<ns>");
    }
    _list + _res;

    return _list;
  }

  function _startTalk() {
    state = STATE_STARTED;
    local _local_state = 0;

    if (!big_size) {
      _local_state = 1;
      sleep(500);

      if (has_rootview) {
        this.view.startMethod("show");
        sleep(200);
      } else {
        _toScale(1, 200);
      }

      for (local i = 0; i < sentence_list.len(); i++) {
        local len = length(sentence_list[i]);
        this.lbl_text.setText(sentence_list[i]);
        sleep(this.showtime_default + len * this.showtime_strlen);
      }

      _local_state = 0;
      if (has_rootview) {
        this.view.startMethod("hide");
        sleep(200);
      } else {
        _toScale(0, 200);
        state = STATE_END;
      }
    } else {
      this.lbl_text.textbox.setAttribute(lbl_text.fontattr);
      local _bnd = this.lbl_text.textbox.bnd;
      local len = length(sentence_list[0]);
      this.lbl_text.setText(sentence_list[0]);
    }
    sleep(1000);

    END:
    state = STATE_END;
    if (_local_state == 1) {
      _local_state = 0;
      if (has_rootview) {
        this.view.startMethod("hide");
        sleep(200);
      } else {
        _toScale(0, 200);
      }
    }
    thread = null;
    this.updateFunc = null;
    removeToSKView();
  }

  function isSmallSize() {
    return this.small_size;
  }

  function _toScale(goal, time) {
    local _pnl = view.findChild("pnl");
    local _start = _pnl.scale.x;

    local to_scale = goal - _start;
    local _t = 0.0;

    while (_t < time) {
      local _s = _start + to_scale * _t / time;
      _pnl.scale.set(_s, _s, _s);

      this.matdirty = true;
      this.repaint();
      sleep(10);
      _t += 10;
    }

    _pnl.scale.set(goal, goal, goal);
    this.matdirty = true;
  }
}

class Talk {
  talk_table = {};

  constructor() {
    talk_table = {};
  }

  function get(talk_key, chara_key) {
    if (talk_key in talk_table) {
      local _chara = talk_table[talk_key];
      if (chara_key in _chara) {
        return _chara[chara_key];
      } else {
        return null;
      }

    } else {
      return null;
    }
  }

}

::talk <- null;

function loadTalk(path = null) {
  local _talk = Talk();

  if (!path) {
    if (::READ_TRANS_FILE.equals("EN")) path = "conf/localize/EN/res/talk/trans/talk.conf";
    else path = "conf/talk.conf";
  }
  local res = getResource(path);
  if (!res) {
    print("[ERROR ]talk file not fount \n");
  } else {
    res.getContent().call(_talk);
    ::talk = _talk;
    res.pres.flush();
  }
}