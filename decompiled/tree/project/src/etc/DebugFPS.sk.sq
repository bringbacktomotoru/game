GameSession.debug_layer <- null;

with HomeUI {
  function actionevent_buy(e) {
    e.consume();

    local ud = ::gamesession.getUserData();
    switch (e.src) {
    case this.btn_gm_buy:

      ::gamesession.debugGetGM(10000);
      break;
    case this.btn_rm_buy:

      break;
    }
  }
}

with DialogLayer {
  function actionevent_buy_gm(e) {
    e.consume();
    ::gamesession.debugGetGM(10000);
  }
  function actionevent_buy_rm(e) {
    e.consume();

  }
}

with GameSession {

  function debugGetAll() {
    if (con) {
      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_GET_ALL);
      return ret[0];
    }
  }
  function debugGetRM(val) {
    local param = { "val" = val };
    if (con) {
      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_GET_RM, param);
      ::gamesession.getUserData().setRealMoney(-1, ret[0].free_rm);

      local _scene = ::gamesession.getCurrentScene();
      if (!(_scene instanceof SanrioGameScene)) return;
      _scene.getUI().updateShopMark(true, false);

      return ret[0];
    }
  }
  function debugGetGM(val) {
    local param = { "val" = val };
    if (con) {
      local ret = con.commandToMain(::ServletConstants.MAIN_CMD_GET_GM, param);
      ::gamesession.getUserData().setGameMoney(ret[0].gm);
      local _scene = ::gamesession.getCurrentScene();
      if (!(_scene instanceof SanrioGameScene)) return;
      _scene.getUI().updateShopMark(true, true);

      return ret[0];
    }
  }
}

local bgm_list = ["M-1", "M-3", "M-4", "M-5", "M-7", "M-11", "M-12", "M-14", "M-17", "M-18", "M-23a", "M-23b", "M-24", "M-25"]
class DebugLayer extends SKView {
  fps_count = 0;
  fps_timer = 0;
  prev_time = 0;
  time = null;

  charamodel = null;
  script = null;

  view = null;
  lbl_fps = null;
  lbl_script = null;
  lbl_bgm = null;
  btn_bgm = null;
  btn_full = null;
  btn_hide = null;
  btn_furniture = null;

  constructor() {
    view = ::loadCocos("ui/DebugPanel.json");
    addChild(view);

    setRect(20, 300, view.bnd.w, 200);

    lbl_fps = view.findChild("lbl_fps");
    lbl_fps.setText("");

    prev_time = skGetTime();
    fps_count = 0;
    fps_timer = 0;

    view.setUpdateFunc(updateFrame.bindenv(this));
    btn_furniture = view.findChild("btn");
    btn_furniture.setEnabled(true);
    ::TapButton(btn_furniture).view.addEventListener(ACTION_EVENT, actionevent);

    lbl_script = view.findChild("lbl_script");

    btn_bgm = view.findChild("btn_bgm");
    btn_bgm.setEnabled(true);
    ::TapButton(btn_bgm).view.addEventListener(ACTION_EVENT, actionevent_bgm);
    this.lbl_bgm = this.view.findChild("lbl_bgm");

    btn_full = view.findChild("btn_full");
    btn_full.setEnabled(true);
    ::TapButton(btn_full).view.addEventListener(ACTION_EVENT, actionevent_fulldebug);

    btn_hide = view.findChild("btn_hide");
    btn_hide.setEnabled(true);
    ::TapButton(btn_hide).view.addEventListener(ACTION_EVENT, actionevent_hide);

    charamodel = null;
    script = null;
  }

  function updateFrame(dt) {
    fps_count++;
    time = skGetTime();
    fps_timer += time - prev_time;
    if (fps_timer >= 1000) {
      lbl_fps.setText(fps_count * 1000 / fps_timer);
      fps_count = 0;
      fps_timer = 0;
    }
    prev_time = time;

    if (::gamesession.getCurrentScene() instanceof SanrioGameScene) {
      local current = ::gamesession.getCurrentScene().getUI().getCurrentPanel();

      if (script != getclassname(getclass(current))) {
        script = getclassname(getclass(current));
        lbl_script.setText(script);
      }

    }

  }

  function setCharaModel(cm) {
    this.charamodel = cm;
  }

  function actionevent(e) {
    e.consume();

    if (charamodel) charamodel.forceUseFurnitureAction();
  }

  function actionevent_bgm(e) {
    e.consume();

    local curr_bgm = this.lbl_bgm.getText();
    local next_idx = 0;
    foreach (idx, s in bgm_list) {
      if (s != curr_bgm) continue;

      next_idx = idx + 1;
      break;
    }

    local bgm = bgm_list[next_idx % length(bgm_list)];
    this.lbl_bgm.setText(bgm);
    ::playBGM(::gamesetting.bgm[bgm]);
  }

  function actionevent_fulldebug(e) {
    e.consume();
    local ud = ::gamesession.getUserData();
    if (!ud) return;

    local ret = null;
    ret = ::gamesession.debugGetAll();
    while (!ret) {
      suspend();
    }

    foreach (k, v in ret) {
      println(k + " - " + v)
    }

    if (ret.ret == ::ServletConstants.RESPONSE_SUCCEED) {
      ::gamesession.updateUserData();
    }

    btn_full.setEnabled(false);
  }

  function actionevent_hide(e) {
    e.consume();
    this.visible = false;
  }
}