class PanelMissionData {
  id = null;
  mission_data_list = null;
  all_cleared = null;
  clear_date = null;
  received_reward = null;
  prev_mid_list = null;

  function loadWithCreate(loader) {
    local _pmd = PanelMissionData();
    local _ud = ::gamesession.getUserData();

    _pmd.id = loader.get();

    local _len = loader.get();
    _pmd.mission_data_list = [];
    for (local i = 0; i < _len; i++) {
      local _md = MissionData();
      _md.loadWithCreate(loader);
      _ud.addMissionData(_md);
      _pmd.mission_data_list + _md;
    }

    local _b = loader.get();
    _pmd.all_cleared = _b > 0 ? true : false;
    _pmd.clear_date = loader.get();
    _b = loader.get();
    _pmd.received_reward = _b > 0 ? true : false;

    _len = loader.get();
    _pmd.prev_mid_list = [];
    for (local i = 0; i < _len; i++) {
      local _mid = loader.get();
      _pmd.prev_mid_list + _mid;
      local _md = ::MissionData.createMissionData(_mid);
      _md.cleared = true;
      _ud.addMissionData(_md);
    }

    return _pmd;
  }

  function createPanelMissionData(pmid) {
    local _pmd = PanelMissionData();
    _pmd.id = pmid;

    local _list = [];
    local _mids = ::gamesetting.panel_mission_settings[pmid].getMissionIDList();
    for (local i = 0; i < _mids.len(); i++) {
      for (local j = 0; j < _mids[i].len(); j++) {
        if (_mids[i][j] < 0) continue;
        _list + ::MissionData().createMissionData(_mids[i][j]);
      }
    }
    _pmd.mission_data_list = _list;
    _pmd.all_cleared = false;
    _pmd.clear_date = -1;
    _pmd.received_reward = false;
    _pmd.prev_mid_list = [];

    return _pmd;
  }

  function changeNextMission(old_id, next_id) {
    local _ud = ::gamesession.getUserData();
    foreach (idx, md in this.mission_data_list) {
      if (md.getID() != old_id) continue;
      local _md = ::MissionData().createMissionData(next_id);
      this.mission_data_list[idx] = _md;
      _ud.addMissionData(_md);
      this.prev_mid_list + old_id;
      return _md;
    }
  }

  function getID() {
    return this.id;
  }

  function getPanelMissionSetting() {
    return ::gamesetting.panel_mission_settings[this.id];
  }

  function getMissionData(mid) {
    if (mid < 0) return null;

    foreach (md in this.mission_data_list) {
      if (md.getID() != mid) continue;
      return md;
    }
    return null;
  }

  function getMissionDataList() {
    return this.mission_data_list;
  }

  function getNumNotClearMission() {
    local _num = this.mission_data_list.len();
    foreach (md in this.mission_data_list) {
      if (md.isCleared() && !md.hasNext()) _num--;
    }
    return _num;
  }

  function isAllCleared() {
    return this.all_cleared;
  }

  function checkAllCleared() {
    foreach (md in this.mission_data_list) {
      if (!md.isCleared()) return;
      if (md.hasNext()) return;
    }
    this.all_cleared = true;
  }

  function isAllSetPiece() {
    foreach (md in this.mission_data_list) {
      if (!md.isSetPiece()) return false;
    }
    return true;
  }

  function setClearDateAtServer(val) {
    this.clear_date = val;
  }
  function hasClearDate() {
    return this.clear_date > 0 ? true : false;
  }
  function convertDateClearDate() {
    if (this.clear_date < 0) return null;

    local _y = this.clear_date / 10000;
    local _m = (this.clear_date - _y * 10000) / 100;
    local _d = (this.clear_date - _y * 10000 - _m * 100);

    local _date = Date(_y - 1900, _m - 1, _d);
    return _date;
  }

  function canReceiveReward() {
    if (this.received_reward) return false;
    if (!hasClearDate()) return false;
    if (!isAllCleared()) return false;
    if (!isAllSetPiece()) return false;

    return true;
  }

  function isShowEventSceneForce() {

    if (hasClearDate()) return false;
    if (!isAllCleared()) return false;
    if (!isAllSetPiece()) return false;

    return true;
  }

  function setReceivedRewardAtServer() {
    this.received_reward = true;
  }
  function isReceivedReward() {
    return this.received_reward;
  }
}