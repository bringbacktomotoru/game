with Serializable() {

  class FurnitureData {
    static SerialVersion = 1;

    uid = -1;
    furniture_id = 0;

    level = null;
    exp = null;

    product_data = null;

    current_view_index = null;
    room_id = null;

    constructor() {
    }

    function init(uid, id, room_id = -1) {
      this.uid = uid;
      this.furniture_id = id;

      this.level = 1;
      this.exp = 0;
      this.current_view_index = 0;
      this.room_id = room_id;

      return this;
    }

    function loadWithCreate(loader) {
      local fd = ::FurnitureData();
      fd.furniture_id = loader.get();
      fd.uid = loader.get();
      fd.exp = loader.get();
      fd.level = loader.get();
      fd.current_view_index = loader.get();

      local _product_type = loader.get();
      if (_product_type > 0) {
        local _p_uid = loader.get();
        local _type = loader.get();
        local _id = loader.get();
        local _start_time = loader.get();
        local _product_time = loader.get();
        local _state = loader.get();
        local _cos_len = loader.get();
        local _cos_ids = [];
        for (local i = 0; i < _cos_len; i++) {
          _cos_ids + loader.get();
        }
        local _room_idx = loader.get();
        local has_motionreward = loader.get() > 0 ? true : false;
        local _rs_len = loader.get();
        local _rss = [];
        for (local i = 0; i < _rs_len; i++) {
          _rss + loader.get();
        }
        local _tappednum = loader.get();

        switch (_product_type) {
        case ::ProductData.TYPE_PRODUCT:
          fd.createProductData(_cos_ids, _room_idx);
          local _pd = fd.getProductData();
          _pd.setRewardStateListAtServer(_rss);
          _pd.setTappedNumAtServer(_tappednum);
          break;
        case ::ProductData.TYPE_LEVELUP:
          fd.createLevelupProductData();
          break;
        case ::ProductData.TYPE_DELIVER:
          fd.createDeliverProductData(_id);
          break;
        }
        local _pd = fd.getProductData();
        _pd.setStartTimeAtServer(_start_time);
        _pd.setProductTimeAtServer(_product_time);
        _pd.setState(_state);
        _pd.setMotionRewardFlag(has_motionreward);
      }
      fd.room_id = loader.get();

      return fd;
    }

    function start_build(time) {

    }

    function getUID() {
      return this.uid;
    }

    function getID() {
      return furniture_id;
    }

    function getName() {
      println("!!!!!!!!!!!!!!!!!!!!!! このfunctionはもう使っちゃダメ")
      currentthread().printStackTrace();

    }
    function getCurrentName() {
      local setting = ::gamesetting.furniture_settings[furniture_id];

      return setting.getName(0);
    }
    function getCurrentDesc() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.getDesc(this.getCurrentViewIndex());
    }
    function getCurrentViewPath() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.getViewPath(this.getCurrentViewIndex());
    }

    function getCurrentIconPath() {
      local path = "/image/icon/furniture/" + this.furniture_id + "_" + this.getCurrentViewIndex() + ".png";
      return path;
    }

    function getCurrentIconSprite() {
      local _path = getCurrentIconPath();
      local _sp = ::getSprite(_path);
      if (!_sp) _sp = ::getSprite("/image/icon/furniture/" + this.furniture_id + "_0.png");
      _sp.blend = SK_MIX;
      return _sp;
    }

    function setCurrentViewIndex(idx) {
      this.current_view_index = idx;
    }
    function getCurrentViewIndex() {

      return this.current_view_index;
    }

    function getFurnitureType() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.type;
    }

    function getFurnitureSeries() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return ::gamesetting.series_settings[setting.series];
    }

    function getFurnitureActionList() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.getActionSettingList();
    }

    function getLevel() {
      return this.level;
    }
    function getMaxLevel() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.getMaxLevel();
    }
    function addLevel(num) {
      this.exp -= getMaxExp();
      this.level += num;
    }

    function setLevel(level) {
      this.level = level;
    }

    function getMaxExp() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.getMaxExp(this.level);
    }
    function getExp() {
      return this.exp;
    }

    function getExpRatio(is_max100 = true) {
      local now = getExp();
      local max = getMaxExp();
      local ratio = int(now * 1.0 / max * 100);
      if (is_max100) ratio = Math.min(100, ratio);
      return ratio;
    }

    function addExp(val) {

      if (isMaxLevel()) return;
      if (this.exp >= getMaxExp()) return;

      this.exp += val;
    }
    function isEnableLevelUp() {
      if (isMaxLevel()) return false;
      return getExp() >= getMaxExp() ? true : false;
    }
    function isMaxLevel() {
      return getMaxLevel() == level ? true : false;
    }

    function getNextLevelGM() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.getLevelupGM(this.level);
    }

    function getNextLevelTime() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      return setting.getLevelupTime(this.level);
    }

    function getModelPath() {
      return ::gamesetting.furniture_settings[furniture_id].getPath();
    }

    function getProductData() {
      return this.product_data;
    }

    function hasProductData() {
      return this.product_data != null;
    }

    function canProduct() {
      return getSetting().canUseFurniture() && !hasProductData();
    }

    function _setProductData(data) {
      this.product_data = data;
    }
    function clearProductData() {
      this.product_data = null;
    }

    function hasProductID() {
      local setting = ::gamesetting.furniture_settings[this.furniture_id];
      return setting.production_id > 0 ? true : false;
    }
    function createProductData(costume_id_list, room_index) {
      local setting = ::gamesetting.furniture_settings[this.furniture_id];

      local pd = ::FurnitureProductData.createProductData(setting.production_id, this, costume_id_list, room_index);
      _setProductData(pd);

      return pd;
    }
    function createLevelupProductData() {
      local setting = ::gamesetting.furniture_settings[furniture_id];
      local ld = ::FurnitureLevelupData.createLevelupData(setting.leveltable_id, this);
      _setProductData(ld);

      return ld;
    }
    function createDeliverProductData(shop_id) {
      local pd = ::FurnitureDeliverData.createFurnitureDeliverData(this, shop_id);
      _setProductData(pd);

      return pd;
    }

    function getProductReward(lv = -1) {
      local setting = ::gamesetting.furniture_settings[this.furniture_id];
      local product_setting = ::gamesetting.furniture_item_production_settings[setting.production_id];

      if (lv < 0) {
        return product_setting.getProductByLevel(level);
      } else {
        return product_setting.getProductByLevel(lv);
      }
    }

    function getProductTime(level = -1) {
      local setting = ::gamesetting.furniture_settings[this.furniture_id];
      local product_setting = ::gamesetting.furniture_item_production_settings[setting.production_id];

      return product_setting.getProductByLevel(level >= 0 ? level : this.level).time;
    }

    function getProductByLevel() {
      local setting = ::gamesetting.furniture_settings[this.furniture_id];
      local product_setting = ::gamesetting.furniture_item_production_settings[setting.production_id];

      return product_setting.getProductByLevel(this.level)
    }

    function getProductFurnitureAddExp() {
      local setting = ::gamesetting.furniture_settings[this.furniture_id];
      local product_setting = ::gamesetting.furniture_item_production_settings[setting.production_id];

      return product_setting.getFurnitureAddExp();
    }

    function getSetting() {
      return ::gamesetting.furniture_settings[this.furniture_id];
    }

    function getSeries() {
      local _fs = getSetting();
      if (!_fs) return -1;
      return _fs.getSeries();
    }

    function getFurnitureType() {
      local _fs = getSetting();
      if (!_fs) return -1;
      return _fs.getType();
    }

    function getRoomID() {
      return this.room_id;
    }
  }

}