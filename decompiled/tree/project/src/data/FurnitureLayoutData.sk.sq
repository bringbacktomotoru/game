with Serializable() {

  class FurnitureLayoutData {
    uid = null;

    x = 0.0;
    y = 0.0;
    z = 0.0;

    angle = 0;

    constructor() {
    }

    static function create(uid) {
      local data = ::FurnitureLayoutData();

      data.uid = uid;

      return data;
    }

    static function loadWithCreate(loader) {
      local uid = loader.get();
      local data = ::FurnitureLayoutData.create(uid);

      data.x = loader.get();
      data.y = loader.get();
      data.z = loader.get();

      data.angle = loader.get();

      return data;
    }

    function getUID() {
      return this.uid;
    }

    function setPosXYZ(x, y, z) {
      this.x = float(x);
      this.y = float(y);
      this.z = float(z);
    }

    function getPosXYZ() {
      return [x, y, z];
    }

    function setAngle(angle) {
      this.angle = int(angle);
    }
    function addAngle(angle) {
      setAngle(this.angle + angle);
    }
    function getAngle() {
      return this.angle;
    }

    function isEqual(that) {
      if (this.uid != that.uid) return false;

      if (this.x != that.x) return false;
      if (this.y != that.y) return false;
      if (this.z != that.z) return false;
      if (this.angle != that.angle) return false;

      return true;
    }

    function apply(that) {
      if (this.uid != that.uid) return;

      this.x = that.x;
      this.y = that.y;
      this.z = that.z;
      this.angle = that.angle;
    }
  }

}