runsk("/res/anime/base.sk");

model =
{

  body = { pm = "../clothes/default/lala.pm" }
  face = { pm = "../facial/lala_face.pm" parentname = "body" shadowbones = "body" }
  r_hand = { pm = "../hand/lala/guR.pm" parentname = "body" shadowbones = "body" }
  l_hand = { pm = "../hand/lala/guL.pm" parentname = "body" shadowbones = "body" }

}

with script {

  function setup() {

    setCharaSetting(::gamesetting.sanrio_chara_settings[3]);
    morphFace("def", 0);
    sk3d.setMotion(getMotionData(::getResource("/res/anime/scene01.mot")));
  }

  function first_chara_select() {
    kurukuru_set(1, "smile", "def");

    first_chara_select_lala();

  }

}