model =
{
  root = {
    ptc = "complete_product_efx.ptd"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{

  function start() {
    startParticle();
    local scale = this.sk3d.scale;
    local spd = 0.1 * 5;

    moveAccelRot(0 * scale.x, spd * scale.y, 0 * scale.z, 100, 0, 0);
    pass(100);

    moveAccelRot(0 * scale.x, spd * scale.y, 0 * scale.z, 120, 2.6, 0.5);

    pass(120);
    moveAccelRot(0 * scale.x, spd * 0.5 * scale.y, 0 * scale.z, 300, 0.5, 0.1);

    pass(300);
    moveAccelRot(0 * scale.x, spd * 0.5 * scale.y, 0 * scale.z, 1180, 0.1, 0.01);

    pass(1180);

  }

  function start2() {
    local scale = this.sk3d.scale;
    local spd = -0.05 * 3;

    moveAccelRot(0 * scale.x, spd * scale.y, 0 * scale.z, 1000, 0, 1.25);
    pass(1000);

  }

  function end() {
  }
}