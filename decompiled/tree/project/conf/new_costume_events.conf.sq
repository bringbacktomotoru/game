new_costume_event_settings[1] <- NewCostumeEventSetting({
  sentences = [
  { sentence = "聞いて！新しい写真を/nもらったのよ♪",
    motion = "sentence_pyonpyon", args = { face = ["smile", "smile"], loop_num = 4 }
  },
  { sentence = "うふふ、わたしの宝物は/nアルバムなの！",
    motion = "sentence_hatena2", args = { face = ["meisou_cheek"], loop_num = 2 }
  },
  { sentence = "この子達もアルバムに/n貼らなくちゃ！",
    motion = "sentence_ketsui2", args = { face = ["kirasmile"], loop_num = 3 }
  },
  { sentence = "アルバムに宝物が/nまた増えたわ｡",
    motion = "sentence_kurukuru", args = { face = ["tere", "tere"], loop_num = 4 }
  },
  ];
})

