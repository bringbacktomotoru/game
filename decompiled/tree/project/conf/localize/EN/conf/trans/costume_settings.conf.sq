costume_settings[101004].name = "Wish me mell"
costume_settings[101004].desc = "A little girl rabbit from France. Innocent and honest, she has a kind heart. She enjoys hotcakes and omelette rice, but is scared of thunder."

costume_settings[101102].name = "Cinnamoroll"
costume_settings[101102].desc = "The cute Cinamoroll has a noteworthy curled tail./nHe's always energetic and bustling about./nI'm a puppy, so not even the cold can stop me#e1#"

costume_settings[102104].name = "Pocchaco"
costume_settings[102104].desc = "A lively and inquisitive boy who can also be scatterbrained and just a touch nosy. He is a fan of going on walks and banana ice cream."

costume_settings[106103].name = "Kiki"
costume_settings[106103].desc = "The younger brother of the twin stars born on the Omoiyari Star in the Yume Star-Cloud. Full of curiosity and energy, he can be a little hasty. Loves to invent things and fish for stars."

costume_settings[108002].name = "My Melody"
costume_settings[108002].desc = "She treasures the darling hood/nher grandmother made for her./nShe likes it so much that /nshe wears it all the time./nIt's MyMelody's#h1#/ntrademark#o1#"

costume_settings[108003].name = "Lala"
costume_settings[108003].desc = "The older sister of the twin stars born on the Omoiyari Star in the Yume Star-Cloud. She has traveled a long way to Earth to learn how to shine like the brightest of stars."

costume_settings[108007].name = "Bonbonribbon"
costume_settings[108007].desc = "A pink bunny with a love for fashion, her charm point is a large ribbon that her mother made for her. She adores dancing and singing."

costume_settings[109001].name = "Hello Kitty"
costume_settings[109001].desc = "Her sky blue overalls show /noff her energetic style./nThe pop of yellow makes for a cute accent color./nEveryone has/ntheir favorite outfit, right#o1#"

costume_settings[109107].name = "Melo"
costume_settings[109107].desc = "Melody's second cousin, he treasures the red hood she gave him. His favorite hobbies include collecting buttons and playing with My Melody."

costume_settings[111101].name = "Pompompurin"
costume_settings[111101].desc = "The trademark brown beret/nis key to Purin's style./nOut of all of the hats in the world,/nthis one is his favorite./nWhat do you think#q1#The hat really/nmakes me me, right#o1#"

costume_settings[112105].name = "Kerokerokeroppi"
costume_settings[112105].desc = "The red and white stripes make for a distinctive outfit,/nand the embroidered bowtie is the proof of Keroppi's fashionable style./nHeh heh heh, I feel#o1#like a million bucks#e1# wearing this#e1#"

