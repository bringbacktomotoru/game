sanrio_chara_settings[1] <- SanrioCharaSetting({
  permission = 1;
  name = "ハローキティ";
  nick_name = "キティ";
  name_key = "kitty";
  desc = "明るくて、優しい女のコ。/nクッキーを作ったり、/nピアノをひくのが大好きで、/n夢はピアニストか、/n詩人になること。/n音楽と英語が得意。/n好きな食べ物は、/nママが作ったアップルパイ。";
  birth = "1101";

  def_costume_id = 109001;
  icon = "icon_kitty.png";

  face = "/res/facial/kitty_face.pm";
  body = "/res/clothes/default/kitty.pm";
  action = "/res/anime/base.sk3";
  efx_script = "/res/efx/chara_effects.sk3";
  handdir = "/res/hand/kitty";
  talk_key = "kitty";
  first_event_id = 1;
  voice_channel = 1001;

  chara_sentence_list = [-1];

  favorite_series = [
  { id = 1, favorite = FAVORITE_BEST },
  { id = 8, favorite = FAVORITE_BEST },
  { id = 60, favorite = FAVORITE_BEST },
  ];

  text_color = 0xc85c78ff;
})

