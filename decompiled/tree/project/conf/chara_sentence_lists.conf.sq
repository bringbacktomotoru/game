chara_sentence_list_settings[1] <- ::CharaSentenceListSetting({
  prev_action = "previewaction_tefuri";

  sentence_table = {

    "kitty" = [
    { sentence = "今日はクッキーでも/n焼こうかしら#q1#",
      motion = "sentence_uun", args = { face = ["def"], loop_num = 1 }, voice = "1"
    },
    { sentence = "わたしクッキーを/n作るのが得意なの#h1#",
      motion = "sentence_munehari", args = { face = ["tere"], loop_num = 4 }
    },
    { sentence = "#playernameにも/n食べてもらいたいな#o1#",
      motion = "sentence_pyonpyon", args = { face = ["smile", "smile"], loop_num = 6 }
    },
    ],
    "mymelo" = [
    { sentence = "きょうは メロディが/nおやつ つくってあげる#o1#",
      motion = "sentence_uun", args = { face = ["smile"], loop_num = 4 }, voice = "1"
    },
    { sentence = "アーモンドパウンドケーキ/nを やこうかなあ#o1#",
      motion = "sentence_clock_nayamu", args = { face = ["meisou"], loop_num = 1 }
    },
    { sentence = "じょうずにつくれたら/nい～っぱいほめてね#h1#",
      motion = "sentence_kurukuru", args = { face = ["smile", "tere"], loop_num = 2 }
    },
    ],
    "cinnamon" = [
    { sentence = "えへへ～#h1#/n今日のおやつ/n楽しみだなぁ#o1#",
      motion = "sentence_yokopatapata", args = { face = ["kya"], loop_num = 2 }, voice = "1"
    },
    { sentence = "今日の/n#playernameの/nおやつはなぁに#q1#",
      motion = "sentence_uun", args = { face = ["smile"], loop_num = 5 }
    },
    { sentence = "ぼくはね、ロールケーキ#e1#/nぼくのしっぽに似てるんだ#o1#",
      motion = "sentence_hyahho", args = { face = ["tere", "smile3_cheek"], loop_num = 3 }
    },
    ],
    "purin" = [
    { sentence = "う～、/n今日のおやつは/nなんだろう#q1#",
      motion = "sentence_yokopatapata", args = { face = ["mogu2"], loop_num = 2 }
    },
    { sentence = "ぼくもう、/nおなかぺこぺこだよ～#e1#",
      motion = "sentence_gakkari", args = { face = ["sad2"], loop_num = 3 }, voice = "1"
    },
    { sentence = "ケーキかなっ#q1#/nクッキーかなっ#q1#/n和菓子もいいなぁ～#h1#",
      motion = "sentence_hyahho", args = { face = ["tere", "smile3_cheek"], loop_num = 3 }
    },
    ],
    "keroppi" = [
    { sentence = "おいしいおやつが/n食べたいな#e1#",
      motion = "sentence_tabetai", args = { loop_num = 3 }
    },
    { sentence = "あ#e1#ねぇねぇ、/nぼくといっしょに/nおやつ作ろうよ#e1#",
      motion = "sentence_yokopatapata", args = { face = ["warau"], loop_num = 3 }, voice = "1"
    },
    { sentence = "ぼく、ドーナッツが/n食べたいなー#e1#",
      motion = "sentence_banzai3", args = { face = ["mogu2", "tehepero"], loop_num = 1 }
    },
    { sentence = "#playernameは/n何食べたい#q1#",
      motion = "sentence_uun", args = { face = ["kyomi"], loop_num = 1 }
    },
    ],

  };
});

chara_sentence_list_settings[2] <- ::CharaSentenceListSetting({
  prev_action = "previewaction_tefuri";

  sentence_table = {

    "kitty" = [
