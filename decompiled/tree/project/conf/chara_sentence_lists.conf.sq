      motion = "sentence_burabura_loop", args = { face = ["manzoku"], loop_num = 2 }
    },
    { sentence = "うふふ#o1#/nど～う#q1#じょうずだった#q1#",
      motion = "sentence_hatena2", args = { face = ["smile3_cheek", "def"], loop_num = 1 }, voice = "2_2"
    },
    ],
    "cinnamon" = [
    { sentence = "イエーイ#o1#ウォウー#o1#/nウォーーー#o1#",
      motion = "sentence_banzai3", args = { face = ["kya", "kya"], loop_num = 3 }
    },
    { sentence = "えへへ#o1#/nお友達とカラオケで/n遊んだんだよ#e1#",
      motion = "sentence_yokopatapata2", args = { face = ["warau"], loop_num = 2 }, voice = "2_1"
    },
    { sentence = "みんなでいーっぱい/n歌っちゃった#o1#",
      motion = "sentence_burabura_loop", args = { face = ["manzoku"], loop_num = 2 }
    },
    { sentence = "今度は踊りながら/n歌っちゃおうかな#e1#",
      motion = "sentence_pyonpyon2", args = { face = ["kya", "kya"], loop_num = 4 }, voice = "2_2"
    },
    ],
    "purin" = [
    { sentence = "らららら～ん#o1#/nらららら～ん#o1#",
      motion = "sentence_burabura_loop", args = { face = ["manzoku"], loop_num = 2 }
    },
    { sentence = "あ、どうどう#q1#/nぼくの歌声#e1#/n上手でしょ#e1#",
      motion = "sentence_uun", args = { face = ["smile"], loop_num = 5 }, voice = "2_1"
    },
    { sentence = "今度、/n歌のコンテストで/n発表するんだぁ～#o1#",
      motion = "sentence_munehari", args = { face = ["kiri2"], loop_num = 3 }
    },
    { sentence = "#playernameも/n絶対見に来てね～#e1#",
      motion = "sentence_hyahho", args = { face = ["tere", "smile3_cheek"], loop_num = 3 }, voice = "2_2"
    },
    ],
    "keroppi" = [
    { sentence = "いぇいいぇいー#o1#/nるるるーーー#o1#",
      motion = "sentence_yokopatapata", args = { face = ["smile3"], loop_num = 3 }
    },
    { sentence = "ぼく、歌うの/nだいすきなんだ#e1#",
      motion = "sentence_tabetai", args = { loop_num = 3 }, voice = "2_1"
    },
    { sentence = "#playernameも/n一緒に歌おうよ#q1#/nきっと楽しいよ#o1#",
      motion = "sentence_banzai3", args = { face = ["smile", "smile2"], loop_num = 1 }
    },
    ],
  };
});

