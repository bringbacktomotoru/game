tutorial_settings[8] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "RoomEditPanel";
  guide_func = "tutorialRoomEdit";
  text_list = [
  "家具レイアウト画面では、/n新しく家具を置いたり、置いてある家具を移動させることができます。",
  "では、『ピンクカフェプラント』を/n好きな場所に置いてみましょう。"
  ];
  conditions = [6];
  with_end_ids = [7, 9];
})

tutorial_settings[9] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "HomeTopPanel";
  guide_func = "tutorialToRoomEdit";
  text_list = [
