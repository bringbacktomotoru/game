tutorial_settings[11] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "HomeTopPanel";
  guide_func = "tutorialMoveMissionPanelLetter";

  text_list = [
  "ダニエルから日記帳が届きました。",
  "この日記帳には、おともだちが/n「おもいで日記」を書いてくれます。",
  "お部屋で起きるいろんなイベントで、/nおもいで日記をいっぱいにしましょう！",
  "左下の『イベント』ボタンを/nタップしてください。",
  "次に『イベントピース』の１つを/nタップしましょう。",
  "ここに書かれている内容を達成すると、/nイベントピースが１つ入手できます。",
  "全部のイベントピースを集めたら、/nお部屋でイベントが発生します。",
  "さっそく、/nイベントピースを集めましょう！"
  ];

  conditions = [8];
  with_end_ids = [10];
})

tutorial_settings[12] <- ::TutorialSetting({
  title = "おともだちの興味を引こう";
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "HomeTopPanel";
  guide_func = "tutorialFurnitureAttract";

  text_list = [
  "家具を連続でタップすると、/nお部屋にいるおともだちの興味を/n引くことができます。",
  "『ピンクカフェプラント』を連続で/nタップしてみましょう。",
  "キティが『ピンクカフェプラント』/nに興味を持ちました。",
  "更に連続でタップを続けることで/nキティが家具を使い始めます。"
  ];

  conditions = [13];
})

