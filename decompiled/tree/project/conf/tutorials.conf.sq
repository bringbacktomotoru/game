tutorial_settings[1] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "RoomSelectPanel";

  title = "トモトルにようこそ！";
  image_list = ["1_1.png", "1_2.png"];

  guide_func = "tutorialRoomSelect";
  text_list = [
  "『はじめてのお部屋』を/n選んでみましょう。"
  ];
})

tutorial_settings[2] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "HomeTopPanel";

})

tutorial_settings[3] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "HomeTopPanel";

  guide_func = "tutorialUseFurniture";
  text_list = [
  "キティをタップしてみましょう。",
  "キティがいま使いたいと思っている/n家具のマークが頭の上に表示されます。",
  "もう一度タップするとキティが/n家具を使い始めます。"
  ];

  conditions = [1];
})

tutorial_settings[4] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_ADD_APPEAL_BALLOON;
  clazz = "HomeTopPanel";

  guide_func = "tutorialTapProduct";
  text_list = [
  "おともだちがリラックスしたり、/n楽しい気持ちになると/n#u2#ハピネスが生まれます。",
  "大きくなった#u2#ハピネスは/nタップすることで獲得できます。",
  "たくさんタップして/n#u2#ハピネスを集めましょう！"
  ];
  conditions = [2];
})

tutorial_settings[5] <- ::TutorialSetting({
  type = TutorialSetting.TYPE_ADD_APPEAL_BALLOON;
  clazz = "HomeTopPanel";

  guide_func = "tutorialFriendHapiness";
  text_list = [
  "おや？キティの頭上に#u1#が出ていますね。",
  "これは#u1#なかよしハピネスといいます。",
  "#u1#が出ているときは、キティが/nあなたとお話をしたがっています。/nタップして聞いてみましょう！"
  ];

  conditions = [3];
  time = 500;
})

tutorial_settings[6] <- ::TutorialSetting({
  title = "ショップで家具を買う";
  type = TutorialSetting.TYPE_MOVEPANEL;
  clazz = "HomeTopPanel";

  image_list = ["6_1.png"];

  guide_func = "tutorialShop";
  text_list = [
  "お部屋をかわいくするために/n新しい家具を置いてみましょう。",
  "『メニュー』ボタンを/nタップしてください。",
  "次に『ショップ』ボタンを/nタップしましょう。",
  "ショップでは、集めた#u2#ハピネスで/n家具やお洋服を買うことができます。",
  "まずは/n『ピンクカフェプラント』/nを買いましょう。"
  ];

  conditions = [4];
})

