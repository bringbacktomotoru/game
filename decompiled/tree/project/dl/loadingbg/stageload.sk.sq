local _path = "";

local _skview = ::loadSKView("/ui/title/Loading.ui");

local _pnl_bg = _skview.findChild("pnl_bg");

_skview.findChild("lbl_msg").setText(::dict.get("nowloading"));

local lang = ::READ_TRANS_FILE.equals("JP") ? "JP" : "EN";
local a = [
"/dl/loadingbg/pop/" + lang + "/room2.png"
"/dl/loadingbg/pop/" + lang + "/room3.png"
"/dl/loadingbg/pop/" + lang + "/room4.png"
"/dl/loadingbg/pop/" + lang + "/room5.png"
];

_path = a[skGetTime() % length(a)];

local _sp = ::getSprite(_path);
local _img_bg = ::SKImageView(_sp);
_img_bg.name = "img_bg";
_pnl_bg.addChild(_img_bg);

_skview.startMethod("loading");

return _skview;