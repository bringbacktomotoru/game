currentthread().setName("main");

function ByteBuffer ::compress(ziplv = 4, dst = null) {
  if (!dst) dst = ByteBuffer();
  local zd = ZDeflater(this, dst, ziplv);
  while (zd.step()) {; }
  dst.pos = 0;
  return dst;
}

function ByteBuffer ::uncompress(dst = null) {
  if (!dst) dst = ByteBuffer();
  local infl = ZInflater(this, dst);
  while (infl.step()) {; }
  dst.pos = 0;
  return dst;
}

function FileRef ::deleteAll() {
  if (!exists()) {
    return true;
  } else
  if (isDirectory()) {
    local list = getList();
    foreach (f in list) {
      if (!f.deleteAll()) {
        throw Exception("could not delete FileRef : " + f.path);
        return false;
      }
    }
  }
  local ret = deleteFile();
  return !ret;
}

function FileRef ::load(bbuf = null, mode = "rb") {
  bbuf = bbuf || ByteBuffer();
  bbuf.pos = 0; bbuf.size = 0;
  local is = open("rb");
  if (!is) throw Exception(sprintf("file could not open : %S - %S", path, mode));
  local r;
  do { r = is.read(bbuf); } while (r > 0);
  is.close();
  bbuf.pos = 0;
  return bbuf;
}

function FileRef ::save(bbuf, mode = null) {
  local is = open(mode || "wb");
  if (!is) throw Exception(sprintf("file could not open : %S - %S", path, mode));
  local w;
  do { w = is.write(bbuf); } while (w > 0);
  is.close();
}

with SxrFile
{
  autoreleasecount <- 0;
  releasecount <- 0;
  intervalid <- 0;

  function setAutoRelease(count) {
    autoreleasecount = releasecount = count;
    if (!intervalid && count > 0) {
      intervalid = setInterval(releasecheck.bindenv(this), 10000);
    } else
    if (intervalid && count <= 0) {
      clearInterval(intervalid);
      intervalid = 0;
    }
  }

  function releasecheck() {
    if (--releasecount <= 0) {
      closeStream();
      clearInterval(intervalid);
      intervalid = 0;
    }
  }

  function checkOpen() {
    if (!isCached()) {
      if (!isStreamOpen()) {
        openStream();
        if (autoreleasecount && !intervalid) {
          intervalid = setInterval(releasecheck.bindenv(this), 10000);
        }
      }
      releasecount = autoreleasecount;
    }
  }

  function forceRelease() {
    closeStream();
    clearInterval(intervalid);
    intervalid = 0;
    releasecount = 0;
  }

  function loadToCacheAll() {
    if (!isCached()) {
      openStream();
      local c = 0, r;
      do {
        r = loadToCache(c, 512 * 1024);
        c += r;
      } while (r > 0);
      closeStream();
    }
  }
}

with SxrEntity
{
  function getData(bb) {
    file.checkOpen();
    return loadData(bb);
  }
}

enum ResourceFlagID
{
  RES_SYSTEM = 4096,
  RES_ALIAS = 8192,
  RES_INVISIBLE = 16384,
}

class Resource
{
  static emptylist = [];
  name = "";
  pathcache = null;

  pres = null;
  list = null;

  isdir = false;
  flags = 0;
  cache = null;

  userdata = null;

  function _get(id) {
    switch (id) {
    case "path":
      {
        if (pathcache) return pathcache;
        if (pres) {
          local p = name, r = pres;
          while (r.pres) { p = r.name + "/" + p; r = r.pres; }
          return pathcache = ("/" + p);
        } else {
          return pathcache = "/";
        }
      }
    }
    return undefined;
  }

  function _cloned(org) {
    pres = null;
    pathcache = null;
    list = null;
    cache = null;
    userdata = null;
  }

  function isDirectory() {
    return isdir;
  }

  function flush() {
    cache = null;
    if (isdir && list) {
      foreach (r in list) {
        r.flush();
      }
      list.resize(0);
      list = null;
      userdata = null;
    }
  }

  function weakflush() {
    if (cache) {
      local c = refcount(cache);
      if (c <= 2) cache = null;
    }
    if (isdir) {
      foreach (r in list) r.weakflush();
    }
  }

  function getContent(p = null) {
    if (p) {
      local r = getResource(p);
      return r ? r.getContent() : null;
    } else {
      if (cache == null) load(1);
      return cache;
    }
  }

  function getDataSource() {
    return null;
  }

  function load(i = 1) {
    if (isdir) {
      if (!list) loadList();
      if (--i > 0) for (local l = 0; l < length(list); l++) list[l].load(i);
    } else
    if (cache == null) {
      cache = loadContent(name, loadData(), this);
      if ("loaded" in cache) cache.loaded(this);
    }
  }

  static function loadContent(name, bbuf, res) {
    local c, exp = name.substring(name.lastIndexOf(".") + 1).toLowerCase();
    foreach (loader in ::contentloaders) {
      if (c = loader(name, exp, bbuf, res)) {
        return c;
      }
    }
    return bbuf;
  }

  function getResource(p) {
    if (p == null || length(p) == 0) return null;
    local i = 0, len = length(p);
    local r = isdir ? this : pres;
    if (p[0] == 47) { r = ::resroot; i++; }
    local si = i, prev = 0, pprev = 0;
    for (; i < len; i++) {
      local c = p[i];
      if (c == 47 || i == len - 1) {
        if (prev == 46 && (pprev == 46 || !r.isdir)) r = r.pres;
        else
        if (prev != 46 || c != 47) {
          if (!(r = r.findList(p, si, (i == len - 1 ? len : i) - si))) return null;
        }
        si = i + 1;
      }
      pprev = prev; prev = c;
    }
    return r;
  }

  function findList(n, s, len) {

    local a = getList();
    foreach (r in a) {
      if (length(r.name) == len && n.startsWith(r.name, s)) {
        return r;
      }
    }
    return null;
  }

  function getList() {
    if (!list) loadList();
    return list;
  }

  function del() {
    if (pres) {
      local plist = pres.list;
      foreach (i, r in plist) {
        if (r == this) {
          plist.remove(i);
          break;
        }
      }
    }
  }

  function install(res) {
    local a = res.getList();
    if (a == null) return;
    getList();
    if (list == emptylist) return;
    foreach (i in a) {

      list + i;
      i.pres = this;

    }
  }

  static function checkAlias(r0) {
    local r;
    foreach (loader in ::aliasloaders) {
      if (r = loader(r0)) {
        return r;
      }
    }
    return r0;
  }

};

class FileResource extends Resource
{
  file = null;

  constructor(f, p = null) {
    file = f;
    isdir = f.isDirectory();
    if (p) pres = p;
    name = f.name;
  }

  function loadList() {
    if (!isdir) list = emptylist;
    else {
      local flist = file.getList();
      local _list = array(length(flist));
      for (local l = length(flist) - 1; l >= 0; l--) {
        local r = FileResource(flist[l], this);
        _list[l] = checkAlias(r);
      }
      if (!list) {
        list = _list;
      } else {
        printf("WARN : double loadList()? %S\n", path);
      }
    }
  }

  function getDataSource() {
    return file;
  }

  function loadData() {
    return file.load();
  }

  function mkdir(name) {
    if (file.exists() && !isdir) throw "cant mkdir : " + path;
    local dir = FileRef(file.path + "/" + name);
    dir.mkdir();
    local r = FileResource(dir, this);
    return r;
  }

  function create(name, data) {
    if (!isdir) throw "cant create : " + path + "/" + name;
    local f = FileRef(file.path + "/" + name);
    if (data) {
      f.save(data);
    }
    f = FileRef(file.path + "/" + name);
    local r = getResource(name);
    if (!r) {
      r = FileResource(f, this);
    } else {
      r.file = f;
    }
    getList();
    list.append(r);
    return r;
  }

  function del() {
    super.del();
    file.del();
  }

  function getDirectoryPath() {
    if (isdir) return file.path;
    return file.path.slice(0, file.path.len() - (file.name.len() + 1));
  }
};

class DeferredLinkResource extends Resource
{
  linkfunc = null;

  constructor(r0, func) {
    pres = r0.pres;
    name = r0.name;
    linkfunc = func;
    isdir = true;
  }

  function loadList() {
    local dir = linkfunc();
    if (!dir) list = emptylist;
    else {
      list = dir.getList();
      dir.list = null;
      for (local l = length(list) - 1; l >= 0; l--) {
        list[l].pres = this;
      }
    }
  }

  function loadData() {
    return null;
  }
}

class SxrResource extends Resource
{
  sxrentity = null;

  constructor(e, p) {
    sxrentity = e;
    isdir = e.isDirectory();
    if (p) pres = p;
    name = e.name;
  }

  function getDataSource() {
    return sxrentity;
  }

  function loadList() {
    if (!isdir) list = emptylist;
    else {
      local elist = sxrentity.getList([]);
      local _list = array(length(elist));
      for (local l = length(elist) - 1; l >= 0; l--) {
        local r = (SxrResource(elist[l], this));
        r = checkAlias(r);
        _list[l] = r;
      }
      if (!list) {
        list = _list;
      } else {
        printf("WARN : double loadList()? %S\n", path);
      }
    }
  }

  function loadData() {
    if (isdir) return null;
    local bb = ByteBuffer();
    return sxrentity.getData(bb);
  }
};

function createResource(src) {
  if (src instanceof SS_STRING) {
    src = FileRef(src);
  }
  if (!src.exists()) {
    throw Exception("file not found : " + src.path);
  }
  if (src.isDirectory()) {
    return FileResource(src);
  } else {
    local sxr = SxrFile(FileRef(src.path), "");
    sxr.open();
    return SxrResource(sxr.getRoot(), null);
  }
}

function getResource(path) {
  return ::resroot.getResource(path);
}

function getResourceContent(path, autoflush = true) {
  local r = ::resroot.getResource(path);
  if (r) {
    local c = r.getContent();

    return c;
  } else {
    return null;
  }
}

::loadimageoption <- null;

::contentloaders <- [
function(name, exp, bbuf, res) {
  switch (exp) {
  case "sk":
  case "conf":
    return bbuf.compile(res ? res.path : name, true);
  case "sk_":
    return bbuf.compile(res ? res.path : name, true);
  case "png":
  case "jpg":
  case "jpeg":
  case "dds":
  case "pvr":
  case "ktx":
  case "webp":
    return skLoadImage(bbuf, ::loadimageoption);
  case "wav":
    return skLoadWaveData(bbuf);
  case "plist":
    {
      local str = bbuf.asText();
      local xml = XMLDocument(str);
      return readPlist(xml);
    }
  }
  return null;
}
];

::aliasloaders <- [
function(res) {
  if (res.name.endsWith(".alias")) {
    local bbuf = res.getContent();
    local func = bbuf.compile(res.path, true)();
    local r = func(res);
    if (r) {
      r.name = res.name.substring(0, res.name.lastIndexOf("."));
      r.pres = res.pres;
      r.flags |= 8192;
      return r;
    } else {
      return res;
    }
  }
  return null;
}
]

local runskstack = [];

function getsk(path) {
  local dir;
  if (!path.startsWith("/") && length(runskstack) > 0) {
    dir = runskstack.last();
  } else {
    dir = ::resroot;
  }
  local r = dir.getResource(path);
  return r || dir.getResource(path + "_");
}

function runsk(path) {
  local r;
  if (path instanceof Resource) {
    r = path;
  } else {
    r = getsk(path);
  }
  if (!r) {
    throw Exception("sk|sk_ file not found : " + path);
  }
  try {
    runskstack + r.pres;
    local ret = r.getContent()();
    r.flush();
    runskstack.pop();
    return ret;
  } catch (ex) {
    runskstack.pop();
    throw ex;
  }
}

function runskbase() {
  return length(runskstack) > 0 ? runskstack.last() : resroot;
}

::resroot <- createResource(skGetCodebase());
::pkgmanager <- null;

if (!skGetWorkerID()) {
  local proj = resroot.getResource("sakana.proj");
  local pkg = resroot.getResource("pkg.json");

  if (::resroot["sxrentity"] && proj && pkg) {
    local pkgdir = FileRef(skGetCodebase());
    if (!pkgdir.isDirectory()) pkgdir = FileRef(pkgdir, "..");
    local appenddir = null;

    if (!pkgdir.isLocked()) {
      appenddir = pkgdir;
    } else {
      appenddir = FileRef(skGetCacheDir());
    }

    runsk("/system/packagemanager.sk");
    pkg = pkg.getContent();
    ::pkgmanager = PackageManager(pkgdir, appenddir);
    ::resroot.install(::pkgmanager.res);
  }
}

{
  local syssk = "/system/load.sk";
  local sys = getsk(syssk);
  if (sys) {
    sys.getContent()();
    sys.flush();
  } else {
    local binsys = createResource(skGetBinBaseDir() + "/system");
    binsys.flags |= 20480;
    ::resroot.getList() + binsys;
    binsys.pres = ::resroot;
    if (sys = getsk(syssk)) {
      sys.getContent()();
    } else {
      printf("WARN : system not loaded.....\n");
    }
  }
}

if (skGetWorkerID()) {

  WorkerDriver.startWorker();
} else {

  printf("mainsk : %S %S \n", skGetCodebase(), skGetMainSK());
  getsk(skGetMainSK()).getContent()();
}