import VirtualKeyCode;

class SKValueField extends SKView
{
  static deffontattr = FontAttribute(Fonts.ui, 11, 0xffffffff, 0);

  tf = null;
  btn = null;
  oldtext = null;

  val = 0.0;
  qua = 10;
  minval = 0.0;
  maxval = 100.0;
  barmin = 0.0;
  barmax = 100.0;
  stepValue = 1;
  loop = false;

  pval = 0.0;

  dynamic = false;
  format = "%.1f"

  constructor() {

    tf = SKTextField("", deffontattr);
    addChild(tf);

    btn = SKImageView(::getSprite("/system/ui.silver/ui.clp#valuechange"));
    btn.enabled = true;
    addChild(btn);

    tf.addEventListener(ACTION_EVENT, textactionevent);
    tf.addEventListener(FOCUS_EVENT, focusevent);
    btn.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function updateLayout() {
    local w = bnd.w, h = bnd.h;
    tf.setRect(0, 0, w, h);
    btn.setPosition(w - btn.bnd.w - 4, 2);
  }

  function setRange(mi, ma, qu, bmi = null, bma = null) {
    minval = mi;
    maxval = ma;
    qua = qu;
    barmin = bmi == null ? minval : bmi;
    barmax = bma == null ? maxval : bma;
    stepValue = (1.0 / qua);
    if (stepValue > 1) stepValue = 1;
  }

  function setValue(f) {
    local sign = (f >= 0) ? 1 : -1;
    local tmpInt = (f * qua + (0.5 * sign)) | 0;
    f = Math.clamp(tmpInt * 1.0 / qua, minval, maxval);
    val = f;
    tf.setText(oldtext = sprintf(format, f));
    return val;
  }

  function getValue() {
    return val;
  }

  function textactionevent(e) {
    local v = float(tf.getText());
    setValue(v);
    postActionEvent(e.modifiers);
  }

  function focusevent(e) {
    switch (e.id) {
    case FOCUS_GAINED:
      if (e.actioncmd == "rotateFocus") {
        tf.selectAll();
      }
      break;
    case FOCUS_LOST:
      if (oldtext != tf.getText()) {
        local v = float(tf.getText());
        if (v != val) {
          setValue(v);
          postActionEvent(e.modifiers);
          oldtext = tf.getText();
        }
      }
      break;
    }
    e.consume();
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_PRESSED:
      startValueBar(e);
      break;
    }
  }

  function processEvent(e) {
    if (e.src == tf && tf.editable)
    switch (e.id) {
    case KEY_PRESSED:
    case KEY_REPEATED:
      pressed(e);
      break;
    }
    return super.processEvent(e);
  }

  function pressed(e) {
    if (!tf.editable) return;
    switch (e.keycode) {
    case VK_UP:
      setValue((val + stepValue));
      tf.enterPressed(e);
      break;
    case VK_DOWN:
      setValue((val - stepValue));
      tf.enterPressed(e);
      break;
    }
    e.consume();
  }

  function startValueBar(e) {
    local bar = SKValueBar();
    bar.requestDrag(e);

    local y = bar.getY((Math.clamp(val, barmin, barmax) - barmin) / (barmax - barmin));
    bar.setpos(y);
    if (e.y - y + bar.bnd.h >= ::rootview.bnd.h) {
      bar.pos.set(e.x, ::rootview.bnd.h - bar.bnd.h, 0);
      skSetMousePos(e.x, bar.pos.y + y);
    } else {
      bar.pos.set(e.x, e.y - y, 0);
    }
    bar.matdirty = true;

    ::rootview.addChild(bar);
    bar.addEventListener(VALUE_EVENT,
    function(e) {
      e.consume();
      local v = barmin + e.actioncmd * (barmax - barmin);
      setValue(v);
      postValueEvent(e.modifiers);
    }
    )
    bar.addEventListener(ACTION_EVENT,
    function(e) {
      e.consume();
      postActionEvent(e.modifiers);
      tf.requestFocus(); tf.selectAll();
    }
    )
  }

  function postValueEvent(mod) {
    local e = Event();
    e.id = VALUE_CHANGED;
    e.src = this;
    e.actioncmd = val;
    e.modifiers = mod;
    ::rootview.postEvent(e);
  }

  function postActionEvent(mod) {
    local e = Event();
    e.id = ACTION_PERFORMED;
    e.src = this;
    e.modifiers = mod;
    ::rootview.postEvent(e);
  }
}

class SKValueBar extends SKView
{
  bgsp = null;
  cursp = null;

  val = 0.0;
  valchanged = false;

  constructor() {
    bgsp = ::getSprite("/system/ui.silver/ui.clp#valuebar");
    cursp = ::getSprite("/system/ui.silver/ui.clp#valuecurs");

    addEventListener(MOUSE_EVENT, mouseevent);

    setRect(-10, -60, 20, 256, 10, 0);
    bgsp.bnd.set(0, 0, 20, 256);
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_MOVED:
    case MOUSE_DRAGGED:
      valchanged = true;
      e.computeLocal(getInvMatrix());
      setpos(e.ly);
      postValueEvent(e.modifiers);
      break;
    case MOUSE_RELEASED:
      if (valchanged) {
        postActionEvent(e.modifiers);
      }
      parent.removeChild(this);
      break;
    }
  }

  function getY(v) {
    return (1.0 - v) * (bnd.h - 6) + 3;
  }

  function setpos(p) {
    cursp.bnd.y = Math.clamp(p - 3, 0.0, bnd.h - 6);
    val = 1.0 - Math.clamp((p - 3) / (bnd.h - 6), 0.0, 1.0);
    repaint();
  }

  function render() {
    skDrawSprite(bgsp);
    skDrawSprite(cursp);
  }

  function postValueEvent(mod) {
    local e = Event();
    e.id = VALUE_CHANGED;
    e.src = this;
    e.actioncmd = val;
    e.modifiers = mod;
    ::rootview.postEvent(e);
  }

  function postActionEvent(mod) {
    local e = Event();
    e.id = ACTION_PERFORMED;
    e.src = this;
    e.modifiers = mod;
    ::rootview.postEvent(e);
  }
}

class SKValueField2 extends SKView
{
  static deffontattr = FontAttribute(Fonts.ui, 11, 0xffffffff, 0);

  tf = null;
  decbtn = null;
  incbtn = null;

  val = 0.0;
  qua = 10;
  minval = 0.0;
  maxval = 100.0;
  barmin = 0.0;
  barmax = 100.0;

  loop = false;

  pval = 0.0;

  dynamic = false;
  format = "%.1f"
  oldtext = null;
  stepValue = 1;

  constructor() {

    tf = SKTextField("", deffontattr);
    addChild(tf);

    decbtn = SKIconButton(::getSprite("/system/ui.silver/ui.clp#left"));
    incbtn = SKIconButton(::getSprite("/system/ui.silver/ui.clp#right"));
    decbtn.repeatmode = 2; decbtn.repeatdelaytime = 30;
    incbtn.repeatmode = 2; incbtn.repeatdelaytime = 30;
    addChild(decbtn);
    addChild(incbtn);

    tf.addEventListener(ACTION_EVENT, textactionevent);
    tf.addEventListener(FOCUS_EVENT, focusevent);
    decbtn.addEventListener(ACTION_EVENT, decevent);
    incbtn.addEventListener(ACTION_EVENT, incevent);
    decbtn.addEventListener(ITEM_EVENT, decevent);
    incbtn.addEventListener(ITEM_EVENT, incevent);

  }

  function updateLayout() {
    local w = bnd.w, h = bnd.h;
    tf.setRect(0, 0, w, h);
    local bw = 14;
    decbtn.setRect(w - bw * 2 - 5, 2, bw, h - 4);
    incbtn.setRect(w - bw - 4, 2, bw, h - 4);
  }

  function setRange(mi, ma, qu, bmi = null, bma = null) {
    minval = mi;
    maxval = ma;
    qua = qu;
    barmin = bmi == null ? minval : bmi;
    barmax = bma == null ? maxval : bma;
    stepValue = (1.0 / qua);
    if (stepValue > 1) stepValue = 1;
  }

  function setValue(f) {
    local sign = (f >= 0) ? 1 : -1;
    local tmpInt = (f * qua + (0.5 * sign)) | 0;
    f = Math.clamp(tmpInt * 1.0 / qua, minval, maxval);
    val = f;
    tf.setText(oldtext = sprintf(format, f));
    return val;
  }

  function getValue() {
    return val;
  }

  function focusevent(e) {
    switch (e.id) {
    case FOCUS_GAINED:
      if (e.actioncmd == "rotateFocus") {
        tf.selectAll();
      }
      break;
    case FOCUS_LOST:
      if (oldtext != tf.getText()) {
        local v = float(tf.getText());
        if (v != val) {
          setValue(v);
          postActionEvent(e.modifiers);
          oldtext = tf.getText();
        }
      }
      break;
    }
    e.consume();
  }

  function textactionevent(e) {
    local v = float(tf.getText());
    setValue(v);
    postActionEvent(e.modifiers);
  }

  function incevent(e) {
    e.consume();
    if (e.id == ACTION_PERFORMED) {
      tf.requestFocus(); tf.selectAll();
      postActionEvent(e.modifiers);
    } else {
      setValue(val + (1.0 / qua));
    }
  }

  function decevent(e) {
    e.consume();
    if (e.id == ACTION_PERFORMED) {
      tf.requestFocus(); tf.selectAll();
      postActionEvent(e.modifiers);
    } else {
      setValue(val - (1.0 / qua));
    }
  }

  function postValueEvent(mod) {
    local e = Event();
    e.id = VALUE_CHANGED;
    e.src = this;
    e.actioncmd = val;
    e.modifiers = mod;
    ::rootview.postEvent(e);
  }

  function postActionEvent(mod) {
    local e = Event();
    e.id = ACTION_PERFORMED;
    e.src = this;
    e.modifiers = mod;
    ::rootview.postEvent(e);
  }

  function processEvent(e) {
    if (e.src == tf)
    switch (e.id) {
    case KEY_PRESSED:
    case KEY_REPEATED:
      pressed(e);
      break;
    }
    return super.processEvent(e);
  }

  function pressed(e) {
    if (!tf.editable) return;
    switch (e.keycode) {
    case VK_UP:
      setValue((val + stepValue));
      break;
    case VK_DOWN:
      setValue((val - stepValue));
      break;
    }
    e.consume();
  }
}