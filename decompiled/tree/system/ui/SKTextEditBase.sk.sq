local a_1 = [0, 0];
local a_2 = [0, 0];

import VirtualKeyCode;

class SKTextEditBase extends SKView
{
  static deffontattr = FontAttribute(Fonts.ui, 12, 0xffffffff, SK_FONT_BOLD);

  text = "";
  fontattr = null;
  prevText = null;
  imstr = null;

  editable = true;

  idx = 0;
  cursx = 0;
  cursy = 0;

  maxcolumn = 1;

  regselect = false;
  regend = -1;

  maxlen = 128;
  textfilter = null;

  typedtime = 0;
  issecret = false;
  showbar = true;

  textbox = null;

  prx = 0;
  pry = 0;

  sprite = null;

  mousein = false;
  sbintervalid = null;

  static clipString = [null];

  constructor(s = "", a = null) {
    fontattr = a ? a : deffontattr;
    textbox = TextBox(fontattr, s);
    sprite = Sprite(null);
    tabgroup = "textinput";
    setText(s);
  }

  function updateLayout() {
    textbox.setRect(0, 0, bnd.w, bnd.h);
    updateFigs();
  }

  function enableStateChanged(b) {
    updateComponentState();
  }

  function focusStateChanged(b) {
    if (b) {
      skEnableInputMethods(true);
      showbar = true;
      sbintervalid = setInterval(showbarInterval.bindenv(this), 500);
    } else {
      skEnableInputMethods(false);
      if (sbintervalid) clearInterval(sbintervalid);
    }
    updateComponentState();
  }

  function showbarInterval() {
    showbar = !showbar;
    repaint();
  }

  function render() {
    drawBack();
    startClip();
    if (focused && regselect) drawSelection(Math.min(regend, idx), Math.max(regend, idx));
    drawText();
    endClip();
    drawBorder();
    if (imstr) drawIMString(imstr);
    else if (focused && showbar && !regselect) drawCursor(cursx, cursy);
  }

  function startClip() {
  }
  function endClip() {
  }
  function drawBack() {
    sprite.setBound(0, 0, bnd.w, bnd.h); sprite.color = 255; skDrawSprite(sprite);
  }
  function drawText() {
    skDrawTextBox(textbox);
  }
  function drawBorder() {
  }
  function drawCursor(x, y) {
    sprite.bnd.set(x - 1, y + fontmet.y, 2, fontmet.h);
    sprite.color0 = 0xffffffff;
    skDrawSprite(sprite);
  }
  function drawSelectionLine(x, y, w, h) {
    sprite.setBound(x, y, w, h);
    sprite.color = 1431655935;
    skDrawSprite(sprite);
  }

  function drawSelection(s, e) {
    skPushRenderStates();
    local widx;
    local st = s;

    for (local l = 0;;++l) {
      local r = textbox.getLineCharRange(l, a_1);
      if (!r) break;
      local en = r[1];
      if (e < st || s > en) { st = en; continue; }
      if (e < en) en = e;
      textbox.getLineHeightRange(0, a_1);
      textbox.getCharPos(st, a_2);
      drawSelectionLine(a_2[0], a_1[0], textbox.strwidth(st, en), a_1[1]);
      st = en;
    }
    skPopRenderStates();
  }

  function drawIMString(s) {
    local imattr = fontattr;
    local cx = cursx;
    local bg = 0xffffffff;
    local uline = 0;
    local fc = 255;

    local ypos = cursy;

  }

  function posttext() {
    local e = Event();
    e.id = TEXT_CHANGED;
    e.src = this;
    ::rootview.postEvent(e);
  }

  function updateComponentState() {
  }

  function processEvent(e) {
    if (editable && e.src == this)
    switch (e.id) {
    case KEY_PRESSED:
    case KEY_REPEATED:
      if (e.isCommandDown()) {
        commandPressed(e);
      } else {
        pressed(e);
      }
      break;
    case KEY_TYPED:
      typed(e);
      e.consume();
      imstr = null;
      repaint();
      return true;
    case MOUSE_PRESSED:
      e.computeLocal(getInvMatrix());
      mousepressed(e);
      break;
    case MOUSE_DRAGGED:
      e.computeLocal(getInvMatrix());
      idx = textbox.charIndexAt(e.lx, e.ly);
      regselect = (regend != idx);
      updateCursorPos();
      updateMaxColumn();
      scrollCursorToVisible();
      updateRegion();
      break;
    case MOUSE_ENTERED:
      mousein = true;
      updateComponentState();
      break;
    case MOUSE_EXITED:
      mousein = false;
      updateComponentState();
      break;
    case IMTEXT_CHANGED:
      imstr = e.actioncmd;
      repaint();
      break;
    }
    return super.processEvent(e);
  }

  function mousepressed(e) {
    if (!focused) requestFocus();
    idx = textbox.charIndexAt(e.lx, e.ly);
    regend = idx;
    regselect = false;
    prx = e.lx;
    pry = e.ly;
    updateCursorPos();
    updateMaxColumn();
    scrollCursorToVisible();
    updateRegion();
  }

  function pressed(e) {
    if (!editable) return;
    switch (e.keycode) {
    case VK_TAB:
      rotateFocus();
      break;
    case VK_DELETE:
      if (regselect) {
        regselect = false;
        local nidx = Math.min(idx, regend);
        if (remove(nidx, Math.max(idx, regend))) {
          idx = nidx;
          updateFigs();
          updateRegion();
          posttext();
        }
      } else
      if (editable && remove(idx, idx + 1)) {
        updateFigs();
        updateRegion();
        posttext();
      }
      break;
    case VK_BACK_SPACE:
      if (regselect) {
        regselect = false;
        local nidx = Math.min(idx, regend);
        if (remove(nidx, Math.max(idx, regend))) {
          idx = nidx;
          updateFigs();
          updateRegion();
          posttext();
        }
      } else
      if (idx > 0) {
        local addidx = (idx == length(text));
        idx--;
        if (editable) {
          if (remove(idx, idx + 1)) {
            updateFigs();
            updateRegion();
            posttext();
          }
        }
        if (idx == 0 && length(text) > 0 && addidx) idx++;
      }
      break;
    case VK_UP:
      if (e.isShiftDown() && !regselect) regend = idx;
      if (!textbox.wrapmode) {
        idx = 0;
      } else {
        textbox.getColumnLine(idx, i_1);
        if (i_1[1] > 0) {
          idx = textbox.indexOfColumnLine(maxcolumn, i_1[1] - 1);
        } else {
          idx = 0;
        }
      }
      regselect = (e.isShiftDown() && regend != idx);
      updateCursorPos();
      scrollCursorToVisible();
      updateRegion();
      break;
    case VK_DOWN:
      if (e.isShiftDown() && !regselect) regend = idx;
      if (!textbox.wrapmode) {
        idx = length(text);
      } else {
        textbox.getColumnLine(idx, i_1);
        if (i_1[1] > 0) {
          idx = textbox.indexOfColumnLine(maxcolumn, i_1[1] + 1);
        } else {
          idx = text.len();
        }
      }
      regselect = (e.isShiftDown() && regend != idx);
      updateCursorPos();
      scrollCursorToVisible();
      updateRegion();
      break;
    case VK_LEFT:
      if (e.isShiftDown()) {
        if (!regselect) regend = idx;
        idx = (idx == 0) ? 0 : idx - 1;
        regselect = (regend != idx);
      } else {
        if (regselect) {
          idx = Math.min(idx, regend);
          regselect = false;
        } else { idx = (idx == 0) ? 0 : idx - 1; }
      }
      updateCursorPos();
      updateMaxColumn();
      scrollCursorToVisible();
      updateRegion();
      break;
    case VK_RIGHT:
      if (e.isShiftDown()) {
        if (!regselect) regend = idx;
        idx = Math.min(length(text), idx + 1);
        regselect = (regend != idx);
      } else {
        if (regselect) {
          idx = Math.max(idx, regend);
          regselect = false;
        } else {
          idx = Math.min(length(text), idx + 1);
        }
      }
      updateCursorPos();
      updateMaxColumn();
      scrollCursorToVisible();
      updateRegion();
      break;
    case VK_ENTER:
      if (enterPressed(e)) break;
    default:
      return;
    }
    typedtime = skGetTime();
    e.consume();
  }

  function _setClipString(clipstr) {
    if (!putClipboardData(KGL_CLIPBOARD_TEXT, clipstr)) {
      clipString[0] = clipstr;
    }
  }

  function _getClipString() {
    if (checkClipboardType(KGL_CLIPBOARD_TEXT)) {
      return getClipboardData(KGL_CLIPBOARD_TEXT);
    }
    return clipString[0];
  }

  function _insertText(s, idx) {
    if (length(text) >= maxlen) return 0;
    local slen = length(s);
    if (length(text) + slen > maxlen) {
      slen = maxlen - length(text);

    }

    local result = text.slice(0, idx);
    for (local i = 0; i < slen; i++) {
      if (s[i] >= 32) {
        result = result + s[i].tochar();
      } else {
        result = result + " ";
      }
    }
    text = result + text.slice(idx);
    return slen;
  }

  function commandPressed(e) {

    local key = e.keycode;
    if (key >= 65) {
      switch (key) {
      case 65:
        selectAll();
        e.consume();
        break;
      case 67:
        if (regselect) {
          _setClipString(text.slice(Math.min(idx, regend), Math.max(idx, regend)));
          e.consume();
        }
        break;
      case 86:
        local clipstr = _getClipString();
        if (clipstr == null || length(clipstr) == 0) break;
        prevText = text;
        if (regselect) {
          regselect = false;
          local nidx = Math.min(idx, regend);
          if (remove(nidx, Math.max(idx, regend))) {
            idx = nidx;
          }
        }
        idx += _insertText(clipstr, idx);
        updateFigs();
        updateRegion();
        posttext();
        e.consume();
        break;
      case 88:
        if (regselect) {
          prevText = text;
          local begin = Math.min(idx, regend);
          local end = Math.max(idx, regend);
          _setClipString(text.slice(begin, end));
          remove(begin, end);
          idx = begin;
          regend = 0;
          regselect = false;
          updateFigs();
          updateRegion();
          posttext();
          e.consume();
        }
        break;
      case 90:
        if (prevText != null) {
          local prevPrev = prevText;
          prevText = text;
          setText(prevPrev);
          e.consume();
        }
        break;
      default: return;
      }
    }
  }

  function enterPressed(e) {
    return false;
  }

  function typed(e) {
    if (!editable) return;
    local ch = e.keychar;
    typedtime = skGetTime();
    if (ch > 31 && ch != 127) {
      if (length(text) >= maxlen && !regselect) return;
      if (textfilter) if (!textfilter(ch)) return;
      if (regselect) {
        local nidx = Math.min(idx, regend);
        if (remove(nidx, Math.max(idx, regend))) {
          idx = nidx;
          e.consume();
        }
      }
      prevText = null;
      text = text.insert(idx, ch);
      regselect = false;
      idx = (idx + 1) | 0;
      updateFigs();
      e.consume();
      posttext();
    }
  }

  function setText(s) {
    text = s != null ? s : "";
    regselect = false;
    if (idx > length(text)) idx = length(text);
    updateFigs();
  }

  function getText() {
    return text;
  }

  function insert(idx, ch) {
    text = text.insert(idx, ch);
  }

  function remove(s, e) {
    if (s >= length(text) || e > length(text)) return false;
    local old = text;
    text = text.remove(s, e);

    return true;
  }

  function selectAll() {
    idx = length(text);
    regend = 0;
    regselect = (regend != idx);
    updateCursorPos();
    updateMaxColumn();
    scrollCursorToVisible();
    updateRegion();
  }

  function updateFigs() {
    textbox.setText(text);
    updateCursorPos();
    updateMaxColumn();
    scrollCursorToVisible();
  }

  function updateCursorPos() {
    typedtime = skGetTime();
    textbox.getCharPos(idx, a_1);
    cursx = a_1[0]; cursy = a_1[1];
    repaint();
  }

  function updateMaxColumn() {
    textbox.getColumnLine(idx, a_1);
    maxcolumn = a_1[0];
  }

  function setCursorIndex(i) {
    idx = Math.clamp(i, 0, length(text));
    updateCursorPos();
    regselect = false;
    return idx;
  }

  function scrollCursorToVisible() {
  }

  function updateRegion() {}

  function getParamDesc(a) {
    appendBasicParamDesc(a);
    a.append("break");
    a.append(KWTP[PARAM_ENABLED]);
    a.append(KWTP[PARAM_TEXT_EDITABLE]);
    return a;
  }

  function getParam(pid) {
    switch (pid) {
    case PARAM_TEXT_EDITABLE: return editable;
    default: return super.getParam(pid);
    }
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case PARAM_TEXT_EDITABLE:
      editable = p0 ? true : false;
      break;
    default:
      super.setParam(pid, p0, p1 = null, w = 0.0);
      break;
    }
  }

}