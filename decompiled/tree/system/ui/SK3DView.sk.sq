import SKViewPropertyID;

local oldvp = [0, 0, 0, 0];
local m_1 = Matrix();

local dsp = Sprite();
dsp.pos = Vector3D();
dsp.color = 0;

class SK3DView extends SKView
{
  scn = null;
  renderer = null;
  autoupdate = true;
  cleardepth = false;

  sd = null;
  sdpath = "";
  cameraname = "MainCamera";

  r_1 = Rect2D();
  a_1 = [0, 0, 0, 0];

  constructor(s = null, r = null) {
    updateFunc = updateScene;
    scn = s || SK3DScene();
    renderer = r || createSceneRenderer();
    renderer.setScene(scn);
    if (!scn.maincamera) scn.maincamera = renderer.camera;
  }

  function setAutoUpdate(b) {
    if (b != autoupdate) {
      setUpdateFunc(b ? updateScene : null);
      autoupdate = b;
    }
  }

  function updateScene(dt) {
    if (scn.updateScene(dt)) {
      repaint();
    }
    return true;
  }

  function drawdepth() {
    local rs = skGetRenderStates(#RenderStates());
    skPushRenderStates();
    rs.colormask = 0;
    rs.depthmask = 1;
    rs.depthtest = SK_ALWAYS;
    skSetRenderStates(rs);
    local m = #Matrix(); skGetMatrix(0, m);
    dsp.pos.z = 1999.0 / m[10];
    if (!skGetRenderTarget()) dsp.pos.z *= -1.0;
    skDrawSprite(dsp, 0, 0, bnd.w, bnd.h);
    skPopRenderStates();
  }

  function render() {

    if (cleardepth) drawdepth();

    skGetViewport(oldvp);
    skGetMatrix(4, m_1);
    local b = (r_1.set(0.0, 0.0, bnd.w, bnd.h)); b.transform(m_1);
    if (skGetRenderTarget()) {
      b.set((b.x + 1.0) * 0.5 * oldvp[2] + oldvp[0], (b.y + 1.0) * 0.5 * oldvp[3], (b.w * 0.5) * oldvp[2], (b.h * 0.5) * oldvp[3]);
    } else {
      b.set((b.x + 1.0) * 0.5 * oldvp[2] + oldvp[0], (b.y + 1.0) * 0.5 * oldvp[3] + oldvp[1], (b.w * 0.5) * oldvp[2], (b.h * 0.5) * oldvp[3]);
      b.y = oldvp[3] - (b.h + b.y);
    }
    local a = a_1;
    a[0] = b.x; a[1] = b.y; a[2] = b.w; a[3] = b.h;
    renderer.render(a);
  }

  function setStageDataPath(p) {
    if (p == "") return;
    sd = ::getResourceContent(p);
    if (!(sd instanceof SK3DStageData)) {

      return;
    }
    scn.clearObjects();
    foreach (e in sd.root.children) {
      addStageDataView(e, null);
    }

    local env = sd.getEnvironmentData();
    scn.setEnvironment(env);
    local renderset = ::createRenderSetting(env["postfx"]);
    renderer.setRenderSetting(renderset);
  }

  function addStageDataView(e, pobj) {
    if (!e.autogen) return;

    local sk3d = null;
    switch (getclass(e)) {
    case ::SK3DNullEntity:
    case ::SK3DObjectEntity:
    case ::SK3DCameraEntity:
      sk3d = SK3DObject(e["datapath"] || null);
      break;
    case ::SK3DCharaEntity:
      if ("createStageEditorChara" in getroottable()) {
        sk3d = ::createStageEditorChara(e);
      }
      break;
    }
    if (!sk3d) return;
    sk3d.setSK3DEntity(e);
    sk3d.name = e.name;
    sk3d.pos(e.pos[0], e.pos[1], e.pos[2]);
    sk3d.scale(e.scale[0], e.scale[1], e.scale[2]).scale(0.01);
    sk3d.rot.setHPB(e.rot[0] * Math.DTOR, e.rot[1] * Math.DTOR, e.rot[2] * Math.DTOR);
    sk3d.startScript(e["startfunc"] || "start");
    if (pobj) {
      pobj.addChild(sk3d);
    } else {
      scn.addObject(sk3d);
    }
    foreach (ce in e.children) {
      addStageDataView(ce, sk3d);
    }

    setCameraName(cameraname);
  }

  function setCameraName(n) {
    local cobj = scn.findByName(n);
    if (cobj) {
      renderer.setCameraObject(cobj);
    }
  }

  function startSK3DScript(s) {
    foreach (o in scn.objs) {

    }
  }

  function getProperties() {
    return #[
    (SKVP[NAME]),
    (SKVP[VISIBLE]),
    (SKVP[SIZE]),
    (SKVP[PIVOT]),
    (SKVP[POSITION]),
    (SKVP[SCALE]),
    (SKVP[BUFFER]),
    (SKVP[SDPATH]),
    (SKVP[CAMERANAME]),
    (SKVP[CLEARDEPTH]),
    (SKVP[ENABLED]),
    ];
  }

  function getParam(pid) {
    switch (pid) {
    case SDPATH: return sdpath;
    case CAMERANAME: return cameraname;
    case CLEARDEPTH: return cleardepth;
    default: return super.getParam(pid);
    }
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case SDPATH:
      setStageDataPath(sdpath = p0);
      repaint();
      break;
    case CAMERANAME:
      setCameraName(cameraname = p0);
      repaint();
      break;
    case CLEARDEPTH:
      cleardepth = p0;
      repaint();
      break;
    default:
      super.setParam(pid, p0, p1, w);
      break;
    }
  }
}