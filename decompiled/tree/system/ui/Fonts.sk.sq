class Fonts
{
  fonts = null;
  scanfonts = null;

  constructor() {
    fonts = {};
    scanfonts = {};
  }

  function _get(name) {
    return fonts[name];
  }

  function registerFont(name, font) {
    fonts[name] <- font;
    font.name = name;
    printf("Font registered : %S\n", name);
  }

  function getFonts() {
    local a = [];
    foreach (f in fonts) a + f;
    a.sort();
    return a;
  }

  function registerFonts(path) {
    local res = ::getResource(path);
    local lr = res.getResource("fontlist.json");
    if (lr) {
      local t = decodeJSON(lr.getContent());
      lr.flush();
      foreach (f in t) {
        local name = f.name;
        delete fonts[name];
        local r = lr.getResource(f.path);
        local font = ::getFont(r);

        font.name = name;
        fonts[name] <- font;
        scanfonts[name] <- font;
        printf("Font registered : %S\n", name);
      }
    } else {
      foreach (f in scanfonts) {
        delete fonts[f.name];
      }
      foreach (r in res.getList()) {
        local i = r.name.lastIndexOf(".");
        local ext = r.name.substring(i + 1).toLowerCase();
        switch (ext) {
        case "ttf":
        case "otf":
          {
            local name = r.name.substring(0, i);
            local font = ::getFont(r);
            font.name = name;
            fonts[name] <- font;
            scanfonts[name] <- font;
            printf("Font registered : %S\n", name);
            break;
          }
        case "link":
          {
            local name = r.name.substring(0, i);
            local lr = r.getResource(r.getContent().asText().trim());
            local font = Font(lr.getContent());
            font.name = name;
            fonts[name] <- font;
            scanfonts[name] <- font;
            printf("Font registered : %S linked from %S\n", name, lr.path);
            break;
          }
        }
      }
    }
  }
}

::Fonts <- Fonts();

function getFont(res) {
  if (typeof(res) == SS_STRING) {
    res = ::getResource(res);
  }
  if (!res.userdata) {
    try {
      local font = Font(res.getContent());
      res.flush();
      res.userdata = font;
    } catch (ex) {
      res.flush();
      return null;
    }
  }
  return res.userdata;
}

Fonts.registerFont("ui", getFont("/system/ui/mplus-1c-medium.ttf"));