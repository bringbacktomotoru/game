with ParticleGroup
{
  emitter <- null;
  modifiers <- null;
  localcoord <- false;

  function start() {
    emit(emitter);
  }
}

class ParticleEffect
{
  sk3dref = null;
  gmat = null;
  bnd = null;

  groups = null;
  alive = 1;

  layer = 0;

  constructor() {
    bnd = Rect3D();
  }

  function setSK3DObject(o) {
    sk3dref = weakref(o);
    local m = gmat = o.gmat;
    foreach (g in groups) {
      if (g.localcoord) {
        g.gmat = m;
      } else {
        g.emitmat = m;
      }
    }
  }

  function start() {
    foreach (g in groups) {
      g.emit(g.emitter);
    }
    alive = 1;
  }

  function _cloned(org) {
    groups = clone groups;
    foreach (i, g in groups) {
      groups[i] = clone g;
    }
    bnd = clone bnd;
  }

  function update(dt) {
    local _alive = alive;
    alive = 0;
    bnd.set(0, 0, 0, -1000, -1000, -1000);
    foreach (g in groups) {
      alive += g.update(dt);
      bnd << bnd | g.getBounds();
    }
    if (gmat) bnd.transform(gmat);
    return alive | _alive;
  }

  function getBounds() {
    return bnd;
  }

  function render() {

    skDrawParticleGroups(groups, gmat);
  }
}

class ParticleGroupData
{
  res = null;

  name = "GROUP";
  enabled = true;
  aimtype = 1;
  emitter = null;
  localcoord = false;

  shapetype = 0;
  shapedata = null;
  tf = null;

  texture = null;
  color = 0xffffffff;
  blend = SK_MIX;
  tec = null;
  overlay = false;

  mod = null;

  function createParticleGroup() {
    local pg = ParticleGroup();
    local pm = null;
    local iscustom = false;
    pg.aimtype = aimtype;
    pg.emitter = emitter;
    switch (shapetype) {
    case 0:
      {
        pg.ptcw = shapedata.w;
        pg.ptch = shapedata.h;
        pg.ptcaxis = shapedata.axis;
        break;
      }
    case 1:
      {
        pm = ::PrimitiveMeshes.createBox(shapedata.w, shapedata.h, shapedata.d);
        break;
      }
    case 2:
      {
        pm = ::PrimitiveMeshes.createSphere(shapedata.r, shapedata.segw, shapedata.segh);
        break;
      }
      break;
    case 3:
      {
        pm = ::PrimitiveMeshes.createCylinder(shapedata.topr, shapedata.btmr, shapedata.h, shapedata.segw, shapedata.closemask);
        break;
      }
      break;
    case 4:
      {
        local r = res.getResource(shapedata.path);
        if (r) pm = ::getPolygonMesh(r);
        if (!pm) {
          pm = ::PrimitiveMeshes.createBox(0.1, 0.1, 0.1);
        } else {
          iscustom = true;
        }
        pg.ptcw = shapedata["w"] || 0.1;
        pg.ptch = shapedata["h"] || 0.1;
        pg.ptcd = shapedata["d"] || 0.1;
        break;
      }
    }
    local m = null;
    if (pm) {
      pg.vtx = pm.vtx;
      pg.idx = pm.face[0].idx;
      pg.mode = pm.face[0].mode;
      m = pg.m = pm.face[0].m;
    } else {
      m = pg.m = Material();
      m.cullface = SK_OFF;
      m.tec = skFXFindTechnique("decal.def");
    }
    local tex = ::getTexture(res.getResource(texture));
    if (tex) m.tex0 = tex;

    m.Kd = color;
    m.blend = blend;
    if (blend) {
      m.depthmask = 0;
    }

    if (tec) {
      local t = skFXFindTechnique(tec);
      if (t) m.tec = t;
    }
    if (overlay) {
      m.depthtest = SK_ALWAYS;

    }
    pg.lmat = tf ? tf.toMatrix() : null;
    if (mod) pg.mods = ParticleModifiers(mod);
    pg.localcoord = localcoord;
    return pg;
  }
}

function getParticleEffect(res) {
  if (typeof(res) == SS_STRING) {
    res = getResource(res);
  }
  local p = res.userdata;
  if (!p) {
    local t = {};
    local func = res.getContent().compile().bindenv(t);
    func();
    foreach (pd in t.groups) { pd.res = res; }
    p = createParticleEffect(t);
    res.userdata = p;
  }
  return clone p;
}

function createParticleEffect(t) {
  local pga = [];
  local p = ParticleEffect();
  foreach (i, pd in t.groups) {
    if (pd.enabled) {
      pga + pd.createParticleGroup();
      if (pd.overlay) p.layer = 8;
    }
  }
  p.groups = pga;

  return p;
}