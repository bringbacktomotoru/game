class SK3DModifier
{
  order = 0;

  function start(o) {
  }

  function modify(o, dt) {
    return false;
  }

  function interrupt(o) {
  }

  function clear() {
  }
}

class TimeFadeModifier extends SK3DModifier
{
  time = 0.0;
  totaltime = 100.0;

  function modify(o, dt) {
    local w1 = time / totaltime;
    if ((time += dt) >= totaltime) {
      modifyw(o, w1, 1.0);
      return false;
    } else {
      modifyw(o, w1, time / totaltime);
      return true;
    }
  }

  function modifyw(o, w1, w2) {
  }
}

class ColorFadeModifier extends TimeFadeModifier
{
  order = 10;

  mate = null;
  idx = "Kmul";
  color1 = 0xffffffff;
  color2 = 0xffffffff;

  constructor(o, c2, t, i = "Kmul") {
    totaltime = t + 0.0;
    mate = o.getMaterials();
    color2 = c2;
    idx = i;
  }

  function start(o) {
    color1 = mate[0][idx];
  }

  function interrupt(o) {
    modifyw(o, 1.0, 1.0);
  }

  function modifyw(o, w1, w2) {
    local c = Math.lerpcolor(color1, color2, w2);
    foreach (m in mate) {
      m[idx] = c;
    }
  }
}

class ColorFlushModifier extends TimeFadeModifier
{
  order = 10;

  mate = null;
  idx = "Ke";
  color1 = 0;
  color2 = 0xffffffff;
  freq = 0;

  constructor(o, c2, f, t, i = "Ke") {
    totaltime = t + 0.0;
    mate = o.getMaterials();
    color2 = c2;
    freq = f + 0.0;
    idx = i;
  }

  function start(o) {
    color1 = mate[0][idx];
  }

  function interrupt(o) {
    foreach (m in mate) {
      m[idx] = color1;
    }
  }

  function modifyw(o, w1, w2) {
    if (w2 == 1.0) {
      foreach (m in mate) {
        m[idx] = color1;
      }
    } else {
      local w = (w2 * freq) % 1.0;
      local c = w < 0.5 ? color2 : color1;
      foreach (m in mate) {
        m[idx] = c;
      }
    }
  }
}

class AlphaFadeModifier extends TimeFadeModifier
{
  order = 11;

  mate = null;
  idx = "Kmul";
  alpha1 = 255;
  alpha2 = 0;

  constructor(o, a1, a2, t) {
    totaltime = t + 0.0;
    mate = o.getMaterials();
    alpha1 = a1;
    alpha2 = a2;
  }

  function modifyw(o, w1, w2) {
    local a = (alpha1 + (alpha2 - alpha1) * w2) | 0;
    foreach (m in mate) {
      m[idx] = (m[idx] & 0xffffff00) | a;
    }
  }
}

class BlinkModifier extends TimeFadeModifier
{
  order = 12;

  freq = 0;
  wt = 0.5;

  constructor(o, f, t, w = 0.5) {
    totaltime = t + 0.0;
    freq = f + 0.0;
    wt = w;
  }

  function start(o) {
  }

  function interrupt(o) {
    o.setVisible(true);
  }

  function modifyw(o, w1, w2) {
    if (w2 == 1.0) {
      o.setVisible(true);
    } else {
      local w = (w2 * freq) % 1.0;
      local c = w < wt ? false : true;
      o.setVisible(c);
    }
  }
}

local xyzvec = Vector3D(1, 1, 1);

class VibeModifier extends SK3DModifier
{
  order = 100;

  mag = 1.0;
  xyz = null;
  falloff = 0.0;
  time = 300;

  constructor(m, v, t, fo = 0.0) {
    mag = m;
    time = t;
    xyz = v || xyzvec;
    falloff = fo;
  }

  function modify(o, dt) {
    o.matdirty = true;
    if ((time -= dt) > 0) {
      o.getModTransform().translate(xyz * Vector3D.fromRandom(-mag, mag));
      mag = Math.max(mag - falloff * dt, 0.0);
      return true;
    } else {
      return false;
    }
  }
}

class SpinModifier extends SK3DModifier
{
  order = 101;

  v = null;
  time = 300;
  accel = 0;

  constructor(_v, t, a = 0) {
    v = _v;
    time = t;
    accel = 0;
  }

  function modify(o, dt) {
    local len = v.length();
    o.matdirty = true;
    if ((time -= dt) > 0) {
      o.rot.synthesize(Quaternion.fromAxis(len * dt * 0.001, v / len));
      return true;
    } else {
      o.rot.synthesize(Quaternion.fromAxis(len * (dt + time) * 0.001, v / len));
      return false;
    }
  }

}

class RotateModifier extends SK3DModifier
{
  order = 101;

  q0 = null;
  q1 = null;
  time = 300;
  w = 1.0;
  easing = null;

  constructor(_q0, _q1, t, e = null) {
    q0 = _q0;
    q1 = _q1;
    time = t;
    w = 1.0 / t;
    easing = e || Easing.easeLinear().easing;
  }

  function modify(o, dt) {
    if ((time -= dt) > 0) {
      o.rot << q1.slerp(q0, easing(time * w));
      o.matdirty = true;
      return true;
    } else {
      o.rot << q1;
      o.matdirty = true;
      return false;
    }
  }
}

class MoveForModifier extends TimeFadeModifier
{
  order = 102;

  vec = null;

  constructor(v, t) {
    vec = v;
    totaltime = t + 0.0;
  }

  function modifyw(o, w1, w2) {
    o.pos << o.pos + (vec * (w2 - w1));
    o.matdirty = true;
  }

  function interrupt(o) {
    modifyw(o, time / totaltime, 1.0);
  }
}

class MoveToModifier extends TimeFadeModifier
{
  order = 102;

  p0 = null;
  p1 = null;
  easing = null;

  constructor(a, b, t, e) {
    p0 = a;
    p1 = b;
    totaltime = t + 0.0;
    easing = e || Easing.easeLinear().easing;
  }

  function modifyw(o, w1, w2) {
    o.pos << p0.lerp(p1, easing(w2));
    o.matdirty = true;
  }
}

class ZoomModifier extends TimeFadeModifier
{
  order = 103;

  s1 = null;
  s2 = null;

  constructor(_s1, _s2, t) {
    s1 = _s1;
    s2 = _s2;
    totaltime = t + 0.0;
  }

  function modifyw(o, w1, w2) {
    o.scale << s1.lerp(s2, w2);
    o.matdirty = true;
  }

  function interrupt(o) {
    modifyw(o, 1.0, 1.0);
  }
}

class MorphModifier extends TimeFadeModifier
{
  order = 104;

  ss1 = null;
  ss2 = null;
  dst = null;

  constructor(_s1, _s2, _d, t) {
    ss1 = _s1;
    ss2 = _s2;
    dst = _d;
    totaltime = t + 0.0;
  }

  function modifyw(o, w1, w2) {
    ss1.interpolate(ss2, w2, dst);
    o.animating = true;
  }
}

local v1 = Vector3D(1, 1, 1);

class GummyZoomModifier extends TimeFadeModifier
{
  order = 105;

  s1 = null;
  s2 = null;
  ease = null;

  constructor(_s2, t) {
    s2 = _s2;
    totaltime = t + 0.0;
    ease = Easing.easeIn(0.6).easing;
  }

  function modifyw(o, w1, w2) {
    local _w = ease((w2 < 0.5 ? w2 : (1.0 - w2)) * 2.0);
    o.getModTransform().scale(v1.lerp(s2, _w));
    o.matdirty = true;
  }
}

class UVScrollModifier extends SK3DModifier
{
  order = 30;

  u = 0.0;
  v = 0.0;
  mate = null;

  constructor(o, _u, _v) {
    foreach (m in (mate = o.getMaterials())) {
      if (!m.uvmat) m.uvmat = Matrix();
    }
    u = _u;
    v = _v;
  }

  function modify(o, dt) {
    local udt = u * dt * 0.001;
    local vdt = v * dt * 0.001;

    foreach (m in mate) {
      local uvmat = m.uvmat;
      uvmat[12] += udt;
      uvmat[13] += vdt;
      return true;
    }
  }
}

class CameraMoveModifier extends TimeFadeModifier
{
  order = 106;

  eease = null;
  tease = null;
  zease = null;

  eye0 = null;
  to0 = null;
  z0 = 1.0;
  proj0 = null;
  eye1 = null;
  to1 = null;
  z1 = 1.0;
  proj1 = null;

  function set(o, e, t, easing = null) {
    totaltime = t + 0.0;
    eye0 = clone o.pos;
    to0 = (o.rot * Vector3D(0, 0, 1)).scale(o.focusz).add(eye0);
    z0 = o.focusz;
    proj0 = clone o.cameraproj;
    eye1 = Vector3D(e.pos[0], e.pos[1], e.pos[2]);
    to1 = Vector3D(e.lookat[0], e.lookat[1], e.lookat[2]);
    z1 = eye1.hypot(to1);
    proj1 = e.proj;
    eease = easing || Easing.easeIn(0.6).easing;
    tease = easing || Easing.easeIn(0.6).easing;
    zease = easing || Easing.easeIn(0.6).easing;
  }

  function modifyw(o, w1, w2) {
    local ew = eease(w2);
    local tw = tease(w2);
    local zw = zease(w2);
    local eye = eye0.lerp(eye1, ew);
    local to = to0.lerp(to1, tw);
    local z = Math.lerp(z0, z1, zw);
    eye.sub(to); eye.normalize(); eye.scale(z); eye.add(to);

    o.pos << eye;
    local hpb = #[0, 0, 0];
    ::SK3DCameraEntity.aimHP((to - eye).normalize(), hpb);
    o.rot << Quaternion.fromHPB(hpb[0] * Math.DTOR, hpb[1] * Math.DTOR, hpb[2] * Math.DTOR);
    o.focusz = z;
    o.matdirty = true;
    o.cameraproj.lerp(proj0, proj1, w2);

  }
}