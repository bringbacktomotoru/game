// UIScript created by LetterPanel.ui 


function invisible_letter() {
	$img_letter.anime(5, 5, 0);
}

function fade_letter() {
	$img_letter.anime(5, 10, 10);
pass(1000);
	while(true) {
		$img_letter.anime(20, 30, 10);
	pass(1000);
	}
}

function wait() {
	while(true) {
		$img_letter.anime(20, 30, 10);
	pass(1000);
	}
}

function show() {
//	generatePtd("/res/efx/ptd/diarymission_piece_efx.ptd", 640, 470, 0.75);
	generatePtd("/res/efx/ptd/TapHapiness3_ring.ptd", 640, 470, 0.3);
//	pass(150);
	$img_letter.anime(20, 20, 0);
	$pnl_ui.anime(0, 5, 18);
}

function show_buttons() {
	$pnl_ui.anime(5, 5, 0);
	$btn_close.anime(0, 5, 10);
	$btn_l.anime(0, 5, 10);
	$btn_r.anime(0, 5, 10);
}

function show_buttons_c() {
	$pnl_ui.anime(5, 5, 0);
	$btn_close.anime(0, 5, 10);
	
	$btn_l.anime(5, 5, 0);
	$btn_r.anime(5, 5, 0);
	$btn_l.visible = false;
	$btn_r.visible = false;
}

function show_buttons_r() {
	$pnl_ui.anime(5, 5, 0);
	$btn_r.anime(0, 5, 10);
	
	$btn_close.anime(5, 5, 0);
	$btn_close.visible = false;
	$btn_l.anime(5, 5, 0);
	$btn_l.visible = false;
}

function change_letter_n1() {
	$img_letter_bg1.anime(50,55,40);
	$img_letter_bg2.anime(50,55,40);
	$pnl_message.anime(50,55,40);
	$pnl_message_bg.anime(50,55,40);
	pass(150);
}
function change_letter_n2() {
	$img_letter_bg1.anime(60,60,0);
	$img_letter_bg2.anime(60,60,0);
	$pnl_message.anime(60,60,0);
}
function change_letter_n3() {
	$img_letter_bg1_anim.anime(60,65,40);
	$pnl_message_bg.anime(60,65,40);
	pass(150);
}

function change_letter_b1() {
