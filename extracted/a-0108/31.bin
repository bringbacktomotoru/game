	$img_letter_bg2.anime(55,55,0);
	$pnl_message.anime(55,55,0);
	$pnl_message_bg.anime(55,55,0);
}
function change_letter_b3() {
	$img_letter_bg1.anime(55,50,40);
	$img_letter_bg2.anime(55,50,40);
	$pnl_message.anime(55,50,40);
	$pnl_message_bg.anime(55,50,40);
