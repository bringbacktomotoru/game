function init() {
	$pnl.anime(10,10,0);
}

function showLtoR() {
	$pnl.anime(5,10,20);
	pass(400);
}
function hideLtoR() {
	$pnl.anime(10,15,20);
	pass(400);
}

function showRtoL() {
	$pnl.anime(15,10,20);
	pass(400);
}
function hideRtoL() {
	$pnl.anime(10,5,20);
	pass(400);
}