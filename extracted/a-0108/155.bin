// UIScript created by TapHapiness1.ui 

//出現直後
function init_all() {
//println("　～　～　～　Tap int　～　～　～　");
	$img_balloon.anime(30,40,12);
	$img_heart1.anime(30,30,0);
	$img_pointing.anime(30,30,0);
	$img_load1.anime(30,30,0);
pass(1000);
	$img_balloon.anime(40,48,5, true);
//	$img_heart1.anime(30,40,20);
	$img_load1.anime(30,40,20);
pass(500);
//	$img_heart1.anime(40,56,10, true);
	$img_load1.anime(40,56,5, true);
}

//再読込したとき
function init_continue(started, end) {
	$img_balloon.anime(40,48,5, true);
	
	$img_heart1.anime(30,30,0);

	$img_load1.anime(40,56,5, true);

	foreach(num in end) {
		switch(num) {
			case 1:
				$img_load1.setVisible(false); break;
		}
	}
	
	foreach(num in started) {
		switch(num) {
			case 1:
				$img_load1.setVisible(false);
				$img_heart1.anime(10,26,15, true);
				break;
		}
	}
	$img_pointing.setVisible(false); // タップできる場合はすぐtapStartが呼ばれる
}

//それぞれのハピネスがタップ可能になった
function tapStart(num=1, pointer=1) {
//println("　～　～　～　Tap tapStart　～　～　～　");
	$img_load1.setVisible(false);
	$img_heart1.anime(60,69,10);
pass(900);
	$img_heart1.anime(10,26,15, true);
pass(200);
//	$img_pointing.anime(30,37,10);

	// changeTapPointerと同じ。指の位置変更
	$img_pointing.setVisible(true);
	switch(pointer) {
	case 1: $img_pointing.anime(50,50,0); break;
	}
}

//それぞれのハピネスを最大数までタップしきったあと
function finishHeart(num=1, pos=null) {
//println("　～　～　～　Tap finishHeart　～　～　～　");
	local x = pos.x;
	local y = pos.y;

	$img_balloon.anime(100,120,30);	
	$img_pointing.setVisible(false);
	$img_heart1.setVisible(false);
	generatePtd("/res/efx/ptd/TapHapiness3_end.ptd", x-0, y-64, 0.15 );

pass(667);
	$img_balloon.anime(40,48,5, true);
}

function changeTapPointer(pointer=1) {
	$img_pointing.setVisible(true);
	
	switch(pointer) {
	case 1: $img_pointing.anime(50,50,0); break;
	}
}

//タップしたとき
function tapHeart(num=1, pos=null) {
//println("　～　～　～　Tap tapHeart　～　～　～　");
	local x = pos.x;
	local y = pos.y;

	$img_balloon.anime(100,120,30);
	$img_heart1.anime(100,115,20);
	generatePtd("/res/efx/ptd/TapHapiness_efx.sk3", x-0, y-64, 0.15 );
//	generatePtd("/res/efx/ptd/TapHapiness3_tap.ptd", x-1, y-56, 0.15);		//x-64-63, y-128-72, 　何故か計算式だと上手く行かず、計算結果にすると上手くいった。。
	$img_pointing.anime(50,52,15);
pass(667);
	$img_balloon.anime(40,48,5, true);
pass(83);
	$img_heart1.anime(10,26,15, true);
}