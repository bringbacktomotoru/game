// UIScript created by TutorialWindow.ui 
function show() {
	$pointing.anime(20,20,0);
	$lbl_txt.anime(10,10,0);
	$img_bg.anime(10,15,30);
	pass(280);
	$lbl_txt.anime(15,15,0);
	pass(1000);
	$pointing.anime(24,30,3,true);
}

function show_notap() {
	$pointing.anime(20,20,0);
	$lbl_txt.anime(10,10,0);
	$img_bg.anime(10,15,30);
	pass(280);
	$lbl_txt.anime(15,15,0);
}

function hide() {
	$pointing.anime(20,20,0);
	$lbl_txt.anime(10,10,0);
	pass(150);
	$img_bg.anime(15,10,30);
	sleep(500);
}
