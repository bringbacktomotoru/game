function show_bottom() {
//	$pnl_bottom_slide.visible = true;
//	$pnl_bottom_slide.anime(5, 10, 20);
	$btn_slide.anime(5,10,20);
}
function hide_bottom() {
//	$pnl_bottom_slide.anime(5, 10, 20);
	$btn_slide.anime(10,5,20);
}

function show_slide() {
	$pnl_bottom_slide.anime(10,15,20);
	$img_slide_bg.anime(10,15,20);
	$btn_slide_mail.anime(10,15,20);
	$btn_slide_home.anime(10,15,20);
	$img_menu_bggrd.anime(10,15,20);
	$img_menu_bar.anime(10,15,20);
	$pnl_camera_rotate.anime(10,15,20);
	$pnl_bottom_slide.visible = true;

}
function hide_slide() {
	$pnl_bottom_slide.anime(15,10,20);
	$img_slide_bg.anime(15,10,20);
	$btn_slide_mail.anime(15,10,20);
	$btn_slide_home.anime(15,10,20);
	$img_menu_bggrd.anime(15,10,20);
	$img_menu_bar.anime(15,10,20);
	$pnl_camera_rotate.anime(15,10,20);
pass(250);
	$pnl_bottom_slide.visible = false;
}

function show_money() {
	if ($pnl_topinfo.visible) return;
	$pnl_topinfo.visible = true;
	$pnl_topinfo.anime(5, 0, 20);
}
function hide_money() {
	try {
		if (!$pnl_topinfo.visible) return;
		$pnl_topinfo.anime(0, 5, 20);
	pass(400);
		$pnl_topinfo.visible = false;
	}catch( ex){
		if( ex == "interrupt"){ 
			println( "interrupt");
			$pnl_topinfo.visible = false;
		}else printexception( ex);
	}
}

function capturing(){
	$capturing_arrow.anime(10,20,5,true);
}

function recovery_heart(st=1, end=1) {
	if (st<=1) {
		$img_heart1.setVisible(true);
		$img_heart1.anime(40,55,20);
		pass(100);
		if (end<=1) return;
	}
	if (st<=2) {
		$img_heart2.setVisible(true);
		$img_heart2.anime(40,55,20);
		pass(100);
		if (end<=2) return;
	}
	if (st<=3) {
		$img_heart3.setVisible(true);
		$img_heart3.anime(40,55,20);
		pass(100);
		if (end<=3) return;
	}
	if (st<=4) {
		$img_heart4.setVisible(true);
		$img_heart4.anime(40,55,20);
		pass(100);
		if (end<=4) return;
	}
	if (st<=5) {
		$img_heart5.setVisible(true);
		$img_heart5.anime(40,55,20);
		if (end<=5) return;
	}
}
function consume_heart(num=1) {
	switch(num) {
	case 1:
		$img_heart1.anime(30,40,15);
		pass(667);
		$img_heart1.setVisible(false);
		break;
	case 2:
		$img_heart2.anime(30,40,15);
		pass(667);
		$img_heart2.setVisible(false);
		break;
	case 3:
		$img_heart3.anime(30,40,15);
		pass(667);
		$img_heart3.setVisible(false);
		break;
	case 4:
		$img_heart4.anime(30,40,15);
		pass(667);
		$img_heart4.setVisible(false);
		break;
	case 5:
		$img_heart5.anime(30,40,15);
		pass(667);
		$img_heart5.setVisible(false);
		break;
	}
}

