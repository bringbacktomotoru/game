// UIScript created by PanelMissionPanel.ui 

function inFromL() {
	$pnl_missionlist.anime(15,20,20);
	pass(300);
}

function outToR() {
	$pnl_missionlist.anime(20,25,20);
	pass(300);
}

function inFromR() {
	$pnl_missionlist.anime(25,20,20);
	pass(300);
}

function outToL() {
	$pnl_missionlist.anime(10,15,20);
	pass(300);
}

function animClearMission() {
	$pnl_mission_info.anime(10,10,0);
	$pnl_mission_info.visible = true;
	$pnl_mission_info.anime(10,15,15);
	$btn_detail.visible = false;
	generatePtd("/res/efx/ptd/diarymission_waku.ptd", 640, 240, 0.25);
	generatePtd("/res/efx/ptd/diarymission_waku_efx.sk3", 640, 240, 0.15 );
	pass(200);
	::playSound(::SoundConstants.SOUND_MISSION_CLEAR);
	pass(200);
	generatePtd("/res/efx/ptd/diarymission_kira.ptd", 640, 240, 0.15);
//	pass(200);
	$diarymission_clear.anime(5,5,0);
	$diarymission_clear.visible = true;
	generatePtd("/res/efx/ptd/diarymission_kira3.ptd", 1026, 255, 0.15);
	$diarymission_clear.anime(5,10,20.5);
	pass(2400);
	$diarymission_clear.anime(10,15,50);
	pass(1000);
	$diarymission_clear.anime(10,10,0);
	$btn_detail.visible = true;
}

function completeDiary() {
	generatePtd("/res/efx/ptd/diarymission_white_complete.ptd", 640, 495, 0.55);
	pass(200);
	::playSound(::SoundConstants.SOUND_MISSION_ALLCLEAR);
	pass(600);
	generatePtd("/res/efx/ptd/diarymission_complete_puzzle.ptd", 640, 493, 0.395);
	pass(800);
	generatePtd("/res/efx/ptd/diarymission_complete_kira.ptd", 640, 495, 0.22);
	pass(2000);
}

function completeDiaryFourPiece() {
	generatePtd("/res/efx/ptd/diarymission_white_complete.ptd", 640, 495, 0.55);
	pass(200);
	::playSound(::SoundConstants.SOUND_MISSION_ALLCLEAR);
	pass(600);
	generatePtd("/res/efx/ptd/diarymission_complete_puzzle_4piece.ptd", 640, 493, 0.395);
	pass(800);
	generatePtd("/res/efx/ptd/diarymission_complete_kira.ptd", 640, 495, 0.22);
	pass(2000);
}

function fadeoutMissionInfo() {
	$pnl_mission_info.findChild("lbl_text").anime(20, 25, 20);
	pass(500);
}

function fadeinMissionInfo() {
	$pnl_mission_info.findChild("lbl_text").anime(25, 20, 20);
	pass(500);
}

function targetMission(){
 $pnl_mission_info.findChild("lbl_text").anime(50, 55, 50);
 $pnl_mission_info.findChild("lbl_index").anime(50, 55, 50);
 $pnl_mission_info.findChild("lbl_progress").anime(50, 55, 50);
}


