//出現直後
function init_all() {
//println("　～　～　～　Tap int　～　～　～　");
	$img_balloon.anime(30,40,12);
	$img_heart1.anime(30,30,0);
	$img_heart2.anime(30,30,0);
	$img_heart3.anime(30,30,0);
	$img_pointing.anime(30,30,0);
	$img_load1.anime(30,30,0);
	$img_load2.anime(30,30,0);
	$img_load3.anime(30,30,0);
pass(1000);
	$img_balloon.anime(40,48,5, true);
//	$img_heart1.anime(30,40,20);
	$img_load1.anime(30,40,20);
pass(500);
	$img_load1.anime(40,56,5, true);
//	$img_heart2.anime(30,40,20);
	$img_load2.anime(30,40,20);
pass(500);
	$img_load2.anime(40,56,5, true);
//	$img_heart3.anime(30,40,20);
	$img_load3.anime(30,40,20);
pass(500);
	$img_load3.anime(40,56,5, true);
}

//再読込したとき
function init_continue(started, end) {
//println("　～　～　～　init_continue　～　～　～　");
	$img_balloon.anime(40,48,5, true);
	
	$img_heart1.anime(30,30,0);
	$img_heart2.anime(30,30,0);
	$img_heart3.anime(30,30,0);

	$img_load1.anime(40,56,5, true);
	$img_load2.anime(40,56,5, true);
	$img_load3.anime(40,56,5, true);

	foreach(num in end) {
		switch(num) {
			case 1:
				$img_load1.setVisible(false); break;
			case 2:
				$img_load2.setVisible(false); break;
			case 3:
				$img_load3.setVisible(false); break;
		}
	}
	
	foreach(num in started) {
		switch(num) {
			case 1:
				$img_load1.setVisible(false);
				$img_heart1.anime(10,26,15, true);
				break;
			case 2:
				$img_load2.setVisible(false);
				$img_heart2.anime(10,26,15, true);
				break;
			case 3:
				$img_load3.setVisible(false);
				$img_heart3.anime(10,26,15, true);
				break;
		}
	}
	$img_pointing.setVisible(false); // タップできる場合はすぐtapStartが呼ばれる
}

//それぞれのハピネスがタップ可能になった
function tapStart(num=1, pointer=1) {
//	println("---------------tapStart" .. num .. ", pointer = " .. pointer);
	
	// ハートが大きくなる
	switch(num) {
	case 1:
			$img_load1.setVisible(false);
			$img_heart1.anime(60,69,10);
		pass(900);
			$img_heart1.anime(10,26,15, true);
		break;
	case 2:
			$img_load2.setVisible(false);
			$img_heart2.anime(60,69,10);
		pass(900);
			$img_heart2.anime(10,26,15, true);
		break;
	case 3:
			$img_load3.setVisible(false);
			$img_heart3.anime(60,69,10);
		pass(900);
			$img_heart3.anime(10,26,15, true);
		break;
	}
	pass(200);
//		$img_pointing.anime(30,37,10);
	
	// changeTapPointerと同じ。指の位置変更
	$img_pointing.setVisible(true);
	switch(pointer) {
	case 1: $img_pointing.anime(50,50,0); break;
	case 2: $img_pointing.anime(55,55,0); break;
	case 3: $img_pointing.anime(60,60,0); break;
	}
}

//それぞれのハピネスを最大数までタップしきったあと
function finishHeart(num=1, pos=null) {
//	println("--------------finishHeart" .. num .. ", pos = " .. pos);
	local x = pos.x;
	local y = pos.y;

	$img_balloon.anime(100,120,30);
	$img_pointing.setVisible(false);

	switch(num) {
	case 1: $img_heart1.setVisible(false); break;
	case 2: $img_heart2.setVisible(false); break;
	case 3:
		$img_heart3.setVisible(false);
		generatePtd("/res/efx/ptd/TapHapiness3_end.ptd", x-0, y-64, 0.15 );
		break;
	}
pass(667);
	$img_balloon.anime(40,48,5, true);
}

function changeTapPointer(pointer=1) {
	$img_pointing.setVisible(true);
	
	switch(pointer) {
	case 1: $img_pointing.anime(50,50,0); break;
	case 2: $img_pointing.anime(55,55,0); break;
	case 3: $img_pointing.anime(60,60,0); break;
	}
}

//タップしたとき
function tapHeart(num=1, pos=null) {
//	println("--------------tapHeart" .. num .. ", pos = " .. pos);

	local x = pos.x;
	local y = pos.y;

	$img_balloon.anime(100,120,30);
	generatePtd("/res/efx/ptd/TapHapiness_efx.sk3", x-0, y-64, 0.15 );

	switch(num) {
	case 1:
			$img_heart1.anime(100,115,20);
//			generatePtd("/res/efx/ptd/TapHapiness_efx.sk3", x-29, y-28, 0.15 );
//			generatePtd("/res/efx/ptd/TapHapiness3_tap.ptd", x-29, y-28, 0.15);		//x-64-35, y-128-100, 　何故か計算式だと上手く行かず、計算結果にすると上手くいった。。
			$img_pointing.anime(50,52,15);
		pass(667);
			$img_balloon.anime(40,48,5, true);
		pass(83);
			$img_heart1.anime(10,26,15, true);
		break;
	case 2:
			$img_heart2.anime(100,115,20);
//			generatePtd("/res/efx/ptd/TapHapiness_efx.sk3", x+36, y-44, 0.15 );
//			generatePtd("/res/efx/ptd/TapHapiness3_tap.ptd", x+36, y-44, 0.15);	//x=100-64, y=128-84,
			$img_pointing.anime(55,57,15);
		pass(667);
			$img_balloon.anime(40,48,5, true);
		pass(83);
			$img_heart2.anime(10,26,15, true);
		break;
	case 3:
			$img_heart3.anime(100,115,20);
//			generatePtd("/res/efx/ptd/TapHapiness_efx.sk3", x-9, y-91, 0.15 );	
//			generatePtd("/res/efx/ptd/TapHapiness3_tap.ptd", x-9, y-91, 0.15);	//img座標 x=64-55, y=128-37
			$img_pointing.anime(60,62,15);
		pass(667);
			$img_balloon.anime(40,48,5, true);
		pass(83);
			$img_heart3.anime(10,26,15, true);
		break;
	}
}