function completeDiary() {
	generatePtd("/res/efx/ptd/diarymission_complete_kira.ptd", 640, 480, 0.2);
	pass(200);
	generatePtd("/res/efx/ptd/diarymission_complete_kira.ptd", 640, 480, 0.4);
	pass(2000);
}