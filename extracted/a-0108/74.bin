// UIScript created by DiaryContentsItem.ui 

function setupClear() {
	$img_empty.visible = false;
}
function setupNoClear() {
	$img_empty.visible = false;
	$pnl_lbl.visible = false;
}

function setupEmpty() {
	$btn_icon.visible = false;
	$pnl_lbl.visible = false;
}

function rotateLabel(val=0) {
	$pnl_lbl.rot.set(0, 0, val*Math.DTOR);
}

