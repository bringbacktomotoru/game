// UIScript created by PanelMissionPiece5.ui 

function init(b=false) {
	$img_piece.visible = b;
	$img_bg.visible = !b;
}

function visibleIllust(b=false) {
	$img_piece.visible = b;
	$img_bg.visible = !b;
}

function animSetPiece(pos=Vector3D()) {
	pass(1600);
	::playSound(::SoundConstants.SOUND_LEVELUP_FURNITURE,false,5.0);
	pass(200);
	$img_piece.visible = true;
	generatePtd("/res/efx/ptd/diarymission_piece_efx.ptd", pos.x, pos.y, 0.30);
	$img_piece.anime(20,25,10);
	pass(500);
	$img_piece.anime(10,12,4);
	pass(500);
	$img_piece.anime(12,12,0);
	pass(500);
	generatePtd("/res/efx/ptd/diarymission_kira2.ptd", pos.x, pos.y, 0.05);
	$img_piece.anime(12,15,15);
	pass(200);
}
