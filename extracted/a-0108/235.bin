@charset "UTF-8";

html {
  min-width: 320px;
  font-size: 62.5%;/*10px*/
}
body {
  margin: 0;
  line-height: 1.5;
  color: #333;
  font-size: 1.6rem;
  font-family:"ヒラギノ角ゴ Pro W3","Hiragino Kaku Gothic Pro","メイリオ","ＭＳ Ｐゴシック",sans-serif;
}
/*Headline*/
h1 {
  margin: 0.67em 0;
  font-size: 48px;
  font-size: 4.8rem;
}
h2 {
  margin: 0.1em 0;
  font-size: 2.8rem;
}
h3 {
  margin: 1em 0;
  font-size: 2.2rem;
}
h4 {
  margin: 1.33em 0;
  font-size: 1.4rem;
}
h5 {
  margin: 1.67em 0;
  font-size: 1.2rem;
}
h6 {
  margin: 1.67em 0;
  font-size: 1.2rem;
}
/*clearfix*/
.clearfix:after {
  content: "";
  display: block;
  clear: both;
}
.clearfix {
  zoom: 1;
}








