declare dashsprite;

//	hsin : 
//	

param common
{
	attribute mediump vec4 in_pos <ID=POSITION>;
	attribute mediump vec4 in_uv <id=UV1>;
	attribute lowp vec4 in_col <id=COLOR1>;
	
	uniform sampler2D coltex1 <id=COLORTEX1>;
	uniform sampler2D coltex2 <id=COLORTEX2>;
	
	uniform mediump mat4 colormat <id=COLORMAT>;
	uniform mediump mat4 miscmat <id=MISC1MAT>;
	
	varying mediump vec4 v_uv;
	varying lowp vec4 v_col;
}

vs def
{
	void main(){
		gl_Position = in_pos;
		v_uv = in_uv;
		v_col = in_col;
	}
}

//////////////////////////////////////////////////////////////////////
//	horizonal sin displacement shader

fs hsin
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) {
			lowp vec2 uv = vec2( v_uv.x + miscmat[0].x * sin( v_uv.y * miscmat[0].y + miscmat[0].z), v_uv.y);
			pix = texture2D( coltex1 , uv.xy) * v_col;
			pix.a -= step( 0.5, abs( uv.x - 0.5));
		} : {
			pix = v_col;
		}
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique hsin
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = hsin;
	}
}

//////////////////////////////////////////////////////////////////////
//	universal transition shader

fs unitrans
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) {
			pix = texture2D( coltex1 , v_uv.xy) * v_col;
		} : {
			pix = v_col;
		}
		$(COLORTEX2) {
			lowp float d = texture2D( coltex2, v_uv.zw).x;
			lowp float a2 = (miscmat[0].x - miscmat[0].y*d) * miscmat[0].z;
			pix.a = pix.a * min( a2, 1.0);
		}
		$(COLORMAT) pix = colormat * pix;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique unitrans
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = unitrans;
	}
}

//////////////////////////////////////////////////////////////////////
//	moveblur shader

fs moveblur
{
	lowp float rand( highp float v){
		float a = fract( v * 12.451168662908249) - 0.5;
		float s = a * (6.182785114200511 + a*a * (-38.026512460676566 + a*a * 53.392573080032137));
		return fract(s * 43758.5453);
	}
	
	lowp vec4 ctex2d( sampler2D s, mediump vec2 uv, mediump vec2 d){
		lowp vec4 pix = texture2D( s , uv);
		pix.a -= step( 0.5, abs( dot( uv, d) - 0.5));
		return pix;
	}
	
	void main(){
		lowp vec4 pix = vec4(1,1,1,1);
		$(COLORTEX1) {
			lowp vec2 v = miscmat[0].xy * ( miscmat[1].x + rand( dot( v_uv.xy, miscmat[0].zw)) * miscmat[1].y );
			mediump vec4 bpix =
			(
				ctex2d( coltex1 , v_uv.xy + v  , miscmat[0].xy) +
				ctex2d( coltex1 , v_uv.xy + v*2, miscmat[0].xy) +
				ctex2d( coltex1 , v_uv.xy + v*3, miscmat[0].xy) +
				ctex2d( coltex1 , v_uv.xy + v*4, miscmat[0].xy) +
				ctex2d( coltex1 , v_uv.xy + v*5, miscmat[0].xy)
			) * 0.2;
			pix = bpix * v_col;
		} : {
			pix = v_col;
		}
		$(COLORTEX2) {
			lowp float d = texture2D( coltex2, v_uv.zw).x;
			pix.a *= 1.0 - min( (d - miscmat[0].x) * miscmat[0].y, 1);
		}
		$(COLORMAT) pix = colormat * pix;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique moveblur
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = moveblur;
	}
}


//////////////////////////////////////////////////////////////////////
//	roundgauge


fs roundgauge
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) {
			pix = texture2D( coltex1 , v_uv.xy) * v_col;
		} : {
			pix = v_col;
		}
		lowp vec2 v = v_uv.zw;
		mediump float w = atan( -v.x, v.y);
		pix *= mix( miscmat[1], miscmat[2], step( miscmat[0].x, w));
		$(COLORMAT) pix = colormat * pix;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique roundgauge
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = roundgauge;
	}
}




//////////////////////////////////////////////////////////////////////
//	polar


fs polar
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) {
			mediump vec2 v = v_uv.xy;
			mediump float len = min( length( v), 0.99);
			v = normalize( v);
			mediump float w = (atan( -v.x, v.y)/6.283) + miscmat[0].x;
			pix = texture2D( coltex1 , vec2( w, len)) * v_col;
		} : {
			pix = v_col;
		}
		$(COLORMAT) pix = colormat * pix;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique polar
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = polar;
	}
}



//////////////////////////////////////////////////////////////////////
//	blockslide


fs blockslide
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) {
			mediump float f = floor( dot( v_uv.xy, miscmat[0].xy) * miscmat[0].z);
			mediump float s = mod( f, 2.0) * 2.0 - 1.0;
			mediump vec2 _v = v_uv.xy + miscmat[0].yx * s * miscmat[0].w;
			pix = texture2D( coltex1 , _v) * v_col;
			lowp vec2 clp = step( vec2(0.5,0.5), abs(_v - vec2(0.5,0.5)) );
			pix.a -= dot(clp,clp);
		} : {
			pix = v_col;
		}
		$(COLORMAT) pix = colormat * pix;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique blockslide
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = blockslide;
	}
}


//////////////////////////////////////////////////////////////////////
//	circlemask


fs circlemask
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) { pix = texture2D( coltex1 , v_uv.xy) * v_col; } : { pix = v_col; }
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		mediump vec2 d = (v_uv.zw - miscmat[0].xy) * miscmat[0].zw;
		mediump float da = max( 0.0, (1.0-length( d)) * miscmat[1].x );
		pix.a -= da;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique circlemask
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = circlemask;
	}
}

