//////////////////////////////////////////////////////////////////////
//	iosYCbCrToRGBA
fs iosYCbCrToRGBA
{
	void main(){
		precision mediump float;
		float y,u,v,r,g,b;
		lowp vec4 ytex = $(COLORTEX1) { texture2D( coltex1 , v_uv.xy) * v_col; } : { v_col; }
		$(COLORTEX2){
			lowp vec4 uvtex = texture2D( coltex2 , v_uv.zw);
			
			y = ytex.x;
			u = uvtex.x - 0.5;
			v = uvtex.w - 0.5;
			
			r = y + 1.402*v;
			g = y - 0.344*u - 0.714*v;
			b = y + 1.772*u;
		} : {
			r = ytex.x;
			g = ytex.y;
			b = ytex.z;
		}
		lowp vec4 pix = vec4( r,g,b,ytex.w);
		
		$(COLORMAT) pix = colormat * pix;
//		$(PREMULTALPHA) pix.xyz *= pix.w;
		gl_FragColor = pix;
	}
}

technique iosYCbCrToRGBA
{
	pass {
		using material;
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = iosYCbCrToRGBA;
	}
}

