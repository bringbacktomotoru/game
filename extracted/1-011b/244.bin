declare dashshading;

module mod_transform;
module mod_material;

param mainpass
{
	attribute lowp vec4 in_col <id=COLOR1>;
	attribute mediump vec4 in_uv <id=UV1>;
	
	uniform sampler2D coltex1 <id=COLORTEX1>;
	uniform sampler2D coltex2 <id=COLORTEX2>;
	uniform sampler2D coltex3 <id=COLORTEX3>;
	
	uniform highp mat4 uvmat <id=UVMAT>;
	uniform mediump mat4 colormat <id=COLORMAT>;
	
	varying mediump vec3 v_n;
	varying mediump vec3 v_wvp;
	varying mediump vec4 v_uv;
	varying lowp vec4 v_col;
	varying lowp vec3 v_diffspec;
}

vs mainpass
{
	void main(){
		highp mat4 transmat = getTransformedVectors();
		
		gl_Position = pmat * transmat[0];
		v_wvp = transmat[0].xyz;
		v_n = normalize( transmat[1].xyz);
		$(COLORTEX1 || COLORTEX2){
			$(UVMAT) { v_uv = uvmat * in_uv; } : { v_uv = in_uv; }
		}
		$(COLOR1) v_col = in_col; v_col.w *= Kd.w;
		
		lowp vec3 diff = Ka_offs + Ka_scale*transmat[1].y;
		lowp vec3 spec = vec3( 0, 0, 0);
		VLIGHT1FUNC( vlight1, v_wvp, v_n, diff, spec);
		VLIGHT2FUNC( vlight2, v_wvp, v_n, diff, spec);
		
		v_diffspec = min( diff+spec, vec3(1,1,1));
	}
}

//	koban

fs koban
{
	void main(){
		lowp vec4 pix = vec4(1,1,1,Kd.w);
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		$(COLORMAT) pix = colormat * pix;
		
		lowp vec3 diff = v_diffspec;
		lowp vec3 spec = vec3( 0, 0, 0);
		PLIGHTFUNC( plight, v_wvp, v_n, diff, spec);
		
		$(COLORTEX3) spec *= texture2D( coltex3 , v_uv.xy).xyz;
		$(COLOR1) spec += v_col;
		
		pix.xyz = Ke + pix.xyz*(min( diff, vec3( 1,1,1))) + spec;		//	ambient....
		
		gl_FragColor = pix;
	}
}

technique koban
{
	pass {
		using transform;
		using material;
		using lighting;
		
		param = mainpass;
		vs = mainpass;
		fs = koban;
	}
}

//	fresnel

fs fresnel
{
	void main(){
		lowp vec4 pix;
		$(COLOR1) { pix = v_col; } : { pix = vec4(1,1,1,Kd.w); }
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		$(COLORMAT) pix = colormat * pix;
		
		lowp vec3 diff = v_diffspec;
		lowp vec3 spec = vec3( 0, 0, 0);
		PLIGHTFUNC( plight, v_wvp, v_n, diff, spec);
		
		$(COLORTEX3) spec *= texture2D( coltex3 , v_uv.xy).xyz;
		
		lowp vec3 _n = normalize( v_n);
		lowp float nn = pow( dot( _n.xy, _n.xy), 4);
		spec.xyz += nn*0.5;
		
		pix.xyz = Ke + pix.xyz*(min( diff, vec3( 1,1,1))) + spec;		//	ambient....
		
		gl_FragColor = pix;
	}
}

technique fresnel
{
	pass {
		using transform;
		using material;
		using lighting;
		
		param = mainpass;
		vs = mainpass;
		fs = fresnel;
	}
}


