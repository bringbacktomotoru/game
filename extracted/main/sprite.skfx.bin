declare sprite;

//	一般的なスプライト描画
//	def : 普通に描画
//	mosaic : モザイクを掛けながら描画 (miscmat[0].x)
//	replace : 置換マッピング (miscmat[0].xy)
//	shadow1 : ソリッド影描画
//	shadow2 : ボケ影描画
//	strokefont : ストローク付きのフォント
//	

param common
{
	attribute mediump vec4 in_pos <ID=POSITION>;
	attribute mediump vec4 in_uv <id=UV1>;
	attribute lowp vec4 in_col <id=COLOR1>;
	
	uniform sampler2D coltex1 <id=COLORTEX1>;
	uniform sampler2D coltex2 <id=COLORTEX2>;
	
	uniform mediump mat4 colormat <id=COLORMAT>;
	uniform mediump mat4 miscmat <id=MISC1MAT>;
	
	varying mediump vec4 v_uv;
	varying lowp vec4 v_col;
}

vs def
{
	void main(){
		gl_Position = in_pos;
		v_uv = in_uv;
		v_col = in_col;
	}
}

//////////////////////////////////////////////////////////////////////
//	default sprite shader

fs def
{
	void main(){
		lowp vec4 pix = $(COLORTEX1) { texture2D( coltex1 , v_uv.xy) * v_col; } : { v_col; }
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		gl_FragColor = pix;
	}
}

technique def
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = def;
	}
}

//////////////////////////////////////////////////////////////////////
//	add 2nd sprite

fs mixadd
{
	void main(){
		lowp vec4 pix = $(COLORTEX1) { texture2D( coltex1 , v_uv.xy) * v_col; } : { v_col; }
		$(COLORTEX2) lowp vec4 p2 = texture2D( coltex2 , v_uv.zw);  pix.xyz += p2.xyz * pix.w;
		$(COLORMAT) pix = colormat * pix;
		gl_FragColor = pix;
	}
}

//////////////////////////////////////////////////////////////////////
//	default shader

technique mixadd
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = mixadd;
	}
}

//////////////////////////////////////////////////////////////////////
//	stroke shader

param strokefont
{
	uniform lowp vec4 subcolor <id=UNICOLOR1>;
}

fs strokefont
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) { 
			lowp vec4 p = texture2D( coltex1 , v_uv.xy);
			pix = p.x * v_col + p.y * subcolor;
		} : { 
			pix = v_col;
		}
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		gl_FragColor = pix;
	}
}

technique strokefont
{
	pass {
		using common;
		CULLFACE = OFF;
		
		param = strokefont;
		vs = def;
		fs = strokefont;
	}
}


//////////////////////////////////////////////////////////////////////
//	piechart shader

fs piechart
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) { pix = texture2D( coltex1 , v_uv.xy) * v_col; } : { pix = v_col; }
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		lowp vec2 v = v_uv.zw;
		mediump float w = atan( -v.x, v.y);
		pix *= mix( miscmat[1], miscmat[2], step( miscmat[0].x, w));
		$(COLORMAT) pix = colormat * pix;
		gl_FragColor = pix;
	}
}

technique piechart
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = piechart;
	}
}


//////////////////////////////////////////////////////////////////////
//	circlemask


fs circlemask
{
	void main(){
		lowp vec4 pix;
		$(COLORTEX1) { pix = texture2D( coltex1 , v_uv.xy) * v_col; } : { pix = v_col; }
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(COLORMAT) pix = colormat * pix;
		mediump vec2 d = (v_uv.zw - miscmat[0].xy) * miscmat[0].zw;
		lowp float da = max( 0.0, (1.0-length( d)) * miscmat[1].x );
		pix.a -= da;
		gl_FragColor = pix;
	}
}

technique circlemask
{
	pass {
		CULLFACE = OFF;
		
		param = common;
		vs = def;
		fs = circlemask;
	}
}
