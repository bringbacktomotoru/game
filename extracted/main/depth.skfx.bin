declare depth;

module mod_transform;
module mod_material;

param mainpass
{
	attribute lowp vec4 in_col <id=COLOR1>;
	attribute mediump vec4 in_uv <id=UV1>;
	
	uniform sampler2D coltex1 <id=COLORTEX1>;
	uniform sampler2D coltex2 <id=COLORTEX2>;
	
	uniform highp mat4 uvmat <id=UVMAT>;
	uniform mediump mat4 colormat <id=COLORMAT>;
	uniform highp vec2 dp <id=DEPTHRANGE>;
	
	varying mediump float v_d;
	varying mediump vec4 v_uv;
	varying lowp vec4 v_col;
}

vs mainpass
{
	void main(){
		highp mat4 transmat = getTransformedVectors();
		
		gl_Position = pmat * transmat[0];
		v_d = (-transmat[0].z + dp.x) * dp.y;
		$(COLORTEX1 || COLORTEX2){
			$(UVMAT) { v_uv = uvmat * in_uv; } : { v_uv = in_uv; }
		}
		$(COLOR1) v_col = in_col;
	}
}


fs def
{
	void main(){
		gl_FragColor = vec4( v_d, 0, 0, 1);
	}
}

//	normal depth render

technique def
{
	pass {
		using transform;
		
		param = mainpass;
		vs = mainpass;
		fs = def;
	}
}

//	mix depth render

fs mix
{
	void main(){
		lowp vec4 pix;
		$(COLOR1) { pix = v_col * Kd; } : { pix = Kd; }
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		
		gl_FragColor = vec4( v_d, 0, 0, pix.w);
	}
}

technique mix
{
	pass {
		using transform;
		using material;
		
		param = mainpass;
		vs = mainpass;
		fs = mix;
	}
}

//	add depth render

fs add
{
	void main(){
		lowp vec4 pix;
		$(COLOR1) { pix = v_col * Kd; } : { pix = Kd; }
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		
		lowp float a = dot( pix.xyz, vec3(1,1,1) ) * pix.w;
		gl_FragColor = vec4( v_d, 0, 0, a);
	}
}

technique add
{
	pass {
		using transform;
		using material;
		
		param = mainpass;
		vs = mainpass;
		fs = add;
		
		BLEND = MIX;
	}
}
