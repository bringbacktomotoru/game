declare shading;

module mod_transform;
module mod_material;

param mainpass
{
	attribute lowp vec4 in_col <id=COLOR1>;
	attribute mediump vec4 in_uv <id=UV1>;

	uniform sampler2D coltex1 <id=COLORTEX1>;
	uniform sampler2D coltex2 <id=COLORTEX2>;
	uniform sampler2D coltex3 <id=COLORTEX3>;

	uniform highp mat4 uvmat <id=UVMAT>;
	uniform mediump mat4 colormat <id=COLORMAT>;

	//	max 32 floats
	varying lowp vec3 v_n;
	varying mediump vec3 v_wvp;
	varying mediump vec4 v_uv;
	varying lowp vec3 v_tan;
	varying lowp vec3 v_bn;
	varying lowp vec4 v_col;
	varying lowp float v_rim;
	
	//	fragment param
	fragout lowp vec4 fragcolor;
}

vs mainpass
{
	void main(){
		highp mat4 transmat = getTransformedVectors();
		gl_Position = pmat * transmat[0];
		v_wvp = transmat[0].xyz;
		v_n = transmat[1].xyz;
		$(NORMALMAP){
			v_tan = transmat[2].xyz;
			v_bn = transmat[3].xyz;
		}
		$(COLORTEX1 || COLORTEX2){
			$(UVMAT) { v_uv = uvmat * in_uv; } : { v_uv = in_uv; }
		}

		lowp vec3 diff = Ka_offs + Ka_scale*transmat[1].y;
		lowp vec3 spec = vec3( 0, 0, 0);
		VLIGHT1FUNC( vlight1, v_wvp.xyz, v_n.xyz, diff, spec);
		VLIGHT2FUNC( vlight2, v_wvp.xyz, v_n.xyz, diff, spec);

		$(COLOR1) {
			v_col = vec4( in_col.xyz * min( diff+spec, vec3(1,1,1)), in_col.w * Kd.w);
		} : {
			v_col = vec4( min( diff+spec, vec3(1,1,1)), Kd.w);
		}

		vsfog( v_wvp.xyz);

		//	fresnel ... link de kesite kurerukana....
		v_rim = 1.0-abs(dot( v_n, normalize( v_wvp)));
	}
}

//////////////////////////////////////////////////////////////////////////////////////
//	basic shader

fs mainpass
{
	void main(){
		lowp vec4 pix = vec4( 1, 1, 1, v_col.w);
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		$(COLORMAT) pix = colormat * pix;

		lowp vec3 diff = v_col.xyz;
		lowp vec3 spec = vec3( 0, 0, 0);
		PLIGHTFUNC( plight, v_wvp.xyz, normalize( v_n.xyz), diff, spec);

		$(COLORTEX3) spec *= texture2D( coltex3 , v_uv.xy).xyz;

		pix.xyz = Ke + pix.xyz*(min( diff, vec3( 1,1,1))) + spec;		//	ambient....

		fsfog( pix);

		fragcolor = pix;
	}
}

technique basic
{
	tag = "3d shading";

	pass {
		using transform;
		using material;
		using lighting;
		using fog;

		param = mainpass;
		vs = mainpass;
		fs = mainpass;
	}
}

//////////////////////////////////////////////////////////////////////////////////////
//	normalmap shader

fs normalmap
{
	void main(){
		lowp vec4 pix = vec4( 1, 1, 1, v_col.w);
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		$(COLORMAT) pix = colormat * pix;
		lowp vec3 n = v_n;
		$(NORMALMAP && COLORTEX2) {
			lowp vec3 texn = (texture2D( coltex2 , i.uv.xy).xyz*2)-1;
			n += v_tan*texn.x + v_bn*texn.y;	//	normalizeしたほうが良いが。。。
		}
		
		lowp vec3 diff = v_col.xyz;
		lowp vec3 spec = vec3( 0, 0, 0);
		PLIGHTFUNC( plight, v_wvp.xyz, normalize( n.xyz), diff, spec);
		
		$(COLORTEX3) spec *= texture2D( coltex3 , v_uv.xy).xyz;
		
		pix.xyz = Ke + pix.xyz*(min( diff, vec3( 1,1,1))) + spec;		//	ambient....
		
		fragcolor = pix;
	}
}

technique normalmap
{
	tag = "3d shading";

	pass {
		using transform;
		using material;
		using lighting;
		using fog;

		param = mainpass;
		vs = mainpass;
		fs = normalmap;
	}
}


//////////////////////////////////////////////////////////////////////////////////////
//	rimlight shader

fs rimlight
{
	void main(){
		lowp vec4 pix = vec4( 1, 1, 1, v_col.w);
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		$(COLORMAT) pix = colormat * pix;
		
		lowp vec3 diff = v_col.xyz;
		lowp vec3 spec = vec3( 0, 0, 0);
		PLIGHTFUNC( plight, v_wvp.xyz, normalize( v_n.xyz), diff, spec);
		
		$(COLORTEX3) spec *= texture2D( coltex3 , v_uv.xy).xyz;
		
		pix.xyz = Ke + pix.xyz*(min( diff, vec3( 1,1,1))) + spec;		//	ambient....
		
		//	fresnel
		pix += v_rim*v_rim*rimcolor;
		
		fsfog( pix);
		
		fragcolor = pix;
	}
}

technique rimlight
{
	tag = "3d shading";

	pass {
		using transform;
		using material;
		using lighting;
		using fog;
		
		param = mainpass;
		vs = mainpass;
		fs = rimlight;
	}
}



//////////////////////////////////////////////////////////////////////////////////////
//	nightlight shader

vs nightlight
{
	void main(){
		highp mat4 transmat = getTransformedVectors();
		gl_Position = pmat * transmat[0];
		v_wvp = transmat[0].xyz;
		v_n = transmat[1].xyz;
		$(NORMALMAP){
			v_tan = transmat[2].xyz;
			v_bn = transmat[3].xyz;
		}
		$(COLORTEX1 || COLORTEX2){
			$(UVMAT) { v_uv = uvmat * in_uv; } : { v_uv = in_uv; }
		}
		
		lowp vec3 diff = Ka_offs + Ka_scale*transmat[1].y;
		lowp vec3 spec = vec3( 0, 0, 0);
		VLIGHT1FUNC( vlight1, v_wvp.xyz, v_n.xyz, diff, spec);
		VLIGHT2FUNC( vlight2, v_wvp.xyz, v_n.xyz, diff, spec);

		$(COLOR1) {
			lowp vec3 c2 = in_col.xyz*2.0;
			v_col = vec4( min( c2, vec3(1,1,1)) * min( diff+spec+max( c2-1.0, vec3(0,0,0)), vec3(1,1,1)), in_col.w * Kd.w);
		} : {
			v_col = vec4( min( diff+spec, vec3(1,1,1)), Kd.w);
		}

		vsfog( v_wvp.xyz);

		//	fresnel ... link de kesite kurerukana....
		v_rim = 1.0-abs(dot( v_n, normalize( v_wvp)));
	}
}

technique nightlight
{
	tag = "3d shading";

	pass {
		using transform;
		using material;
		using lighting;
		using fog;
		
		param = mainpass;
		vs = nightlight;
		fs = mainpass;
	}
}
