declare voxel;

module mod_transform;
module mod_material;

param mainpass
{
	attribute mediump float in_u <id=UV1>;
	
	uniform mediump mat4 voxuv <id=MISC1MAT>;
	uniform mediump mat4 colormat <id=COLORMAT>;
	
	uniform sampler2D coltex1 <id=COLORTEX1, MIN_FILTER=NEAREST, MAG_FILTER=NEAREST>;
	uniform sampler2D coltex2 <id=COLORTEX2, MIN_FILTER=NEAREST, MAG_FILTER=NEAREST>;
	
	//	max 32 floats
	varying lowp vec3 v_n;
	varying mediump vec3 v_wvp;
	varying mediump vec3 v_lp;
	varying mediump vec3 v_envp;
	varying mediump vec2 v_pal;
	varying lowp vec4 v_lit;
}

vs mainpass
{
	void main(){
		highp mat4 transmat = getTransformedVectors();
		gl_Position = pmat * transmat[0];
		v_wvp = transmat[0].xyz;
		v_n = transmat[1].xyz;
		v_lp = in_pos;
		
		$(COLORTEX1) v_pal = vec2( in_u, 0.0);
		$(COLORTEX2) v_envp = in_pos + vec3(1.0,1.0,1.0) + in_n * 0.5;
		
		lowp vec3 diff = Ka_offs + Ka_scale*transmat[1].y;
		lowp vec3 spec = vec3(0.0,0.0,0.0);
		VLIGHT1FUNC( vlight1, v_wvp.xyz, v_n.xyz, diff, spec);
		VLIGHT2FUNC( vlight2, v_wvp.xyz, v_n.xyz, diff, spec);
		
		v_lit = vec4( min( diff+spec, vec3(1.0,1.0,1.0)), 0.0);
		
		vsfog( v_wvp.xyz);
	}
}

//////////////////////////////////////////////////////////////////////////////////////
//	basic shader

fs mainpass
{
	vec2 touv( mediump vec3 pos){
		highp float i = dot( floor( pos), voxuv[0].xyz);
		return mod( floor( vec2( i, i) * voxuv[1].xy), voxuv[1].zw) * voxuv[2].xy;
	}
	
	void main(){
		lowp vec4 pix = $(COLORTEX1){ texture2D( colortex1, v_pal)} : { vec4(1.0,1.0,1.0,1.0) };
		lowp vec3 diff = v_lit.xyz;
		lowp vec3 spec = vec3(0.0,0.0,0.0);
		PLIGHTFUNC( plight, v_wvp.xyz, normalize( v_n.xyz), diff, spec);
		$(COLORTEX2) {
			lowp vec4 env = texture2D( coltex2 , touv( v_envp));
			diff = diff * env.www + env.xyz;
		}
		pix.xyz = pix.xyz*(min( diff+pix.www, vec3(1.0,1.0,1.0))) + spec;
		
		$(COLORMAT) pix = colormat * pix;
		
		fsfog( pix);
		
		gl_FragColor = pix;
	}
}

technique basic
{
	tag = "3d shading";

	pass {
		using transform;
		using material;
		using lighting;
		using fog;

		param = mainpass;
		vs = mainpass;
		fs = mainpass;
	}
}

//////////////////////////////////////////////////////////////////////////////////////
//	line shader

vs line
{
	void main(){
		highp vec4 wvp = pmat * (wvmat * in_pos);
		v_lp = in_pos;
		
		$(COLOR1){
			v_col = vec4( in_col.xyz * 0.5, 1.0);
		}
	}
}

fs line
{
	void main(){
		lowp vec4 pix = $(COLORTEX1){ texture2D( colortex1, v_pal)} : { vec4(1.0,1.0,1.0,1.0) };
		//	check edge line
		highp float v = dot( mod( v_lp, vec2(1.0,1.0)), vec2(1.0,1.0));
		if( v > 0.001) discard;
		gl_FragColor = pix;
	}
}
