declare decal;

module mod_transform;
module mod_material;

param mainpass
{
	attribute lowp vec4 in_col <id=COLOR1>;
	attribute mediump vec4 in_uv <id=UV1>;
	
	uniform sampler2D coltex1 <id=COLORTEX1>;
	uniform sampler2D coltex2 <id=COLORTEX2>;
	
	uniform highp mat4 uvmat <id=UVMAT>;
	uniform mediump mat4 colormat <id=COLORMAT>;
	
	varying mediump vec4 v_uv;
	varying lowp vec4 v_col;
}

vs mainpass
{
	void main(){
		highp mat4 transmat = getTransformedVectors();
		
		gl_Position = pmat * transmat[0];
		$(COLORTEX1 || COLORTEX2){
			$(UVMAT) { v_uv = uvmat * in_uv; } : { v_uv = in_uv; }
		}
		$(COLOR1) v_col = in_col;
	}
}

fs mainpass
{
	void main(){
		lowp vec4 pix;
		$(COLOR1) { pix = v_col * Kd; } : { pix = Kd; }
		$(COLORTEX1) pix *= texture2D( coltex1 , v_uv.xy);
		$(COLORTEX2) pix *= texture2D( coltex2 , v_uv.zw);
		$(ALPHATEST) if( pix.w < alpharef) discard;
		$(COLORMAT) pix = colormat * pix;
		pix.xyz += Ke;
		gl_FragColor = pix;
	}
}

technique def
{
	tag = "3d shading";
	
	pass {
		using transform;
		using material;
		
		param = mainpass;
		vs = mainpass;
		fs = mainpass;
	}
}

/////// single color shader

fs color
{
	void main(){
		gl_FragColor = Kd;
	}
}

technique color
{
	tag = "3d shading";
	
	pass {
		using transform;
		using material;
		
		param = mainpass;
		vs = mainpass;
		fs = color;
		
		BLEND = OFF;
	}
}

/////// draw edge shader

param drawedge
{
	attribute lowp vec3 in_e <id=UV2>;
	uniform highp mat4 p <id=MISC1MAT>;
}

vs drawedge
{
	void main(){
		highp vec4 wvp;
		mediump mat3 emat;
		mediump vec3 e = $( UV2){ in_e } : { in_n };
		$( BONEWEIGHT){
			mediump mat4 mixmat = 
				bonemat[int(in_widx.x)] * in_w.x + bonemat[int(in_widx.y)] * in_w.y + 
				bonemat[int(in_widx.z)] * in_w.z + bonemat[int(in_widx.w)] * in_w.w;
			wvp = wvmat * (mixmat * in_pos);
			e = mat3(wvmat) * ( mat3(mixmat) * e);
		} : {
			wvp = wvmat * in_pos;
			e = mat3( wvmat) * e;
		}
		wvp.xy += normalize( e.xy) * p[1].xx;
		highp vec4 wvpp = pmat * wvp + p[0];
		gl_Position = wvpp;
	}
}

fs drawedge
{
	void main(){
		gl_FragColor = Kd;
	}
}

technique drawedge
{
	tag = "3d shading";
	
	pass {
		using material;
		using transform;
		
		param = drawedge;
		vs = drawedge;
		fs = drawedge;
	}
}


/////// texgen shader

vs texgen_obj
{
	void main(){
		highp mat4 transmat = getTransformedVectors();
		
		gl_Position = pmat * transmat[0];
		$(COLORTEX1 || COLORTEX2){
			$(UVMAT) { v_uv = (uvmat * in_pos).xyxy; } : { v_uv = in_pos.xyxy; }
		}
		$(COLOR1) v_col = in_col;
	}
}

technique texgen_obj
{
	tag = "3d shading";
	
	pass {
		using transform;
		using material;
		
		param = mainpass;
		vs = texgen_obj;
		fs = mainpass;
	}
}
