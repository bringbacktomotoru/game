declare mod_material;

param material
{
	uniform lowp vec4 mate[6]<ID=MATERIALVEC>;
	uniform lowp float alpharef<ID=ALPHAREF>;
	uniform lowp vec4 rimcolor<ID=RIMCOLOR>;
}

define material
{
	#define Kd mate[0]
	#define Ks mate[1].xyz
	#define Ka_offs mate[2].xyz
	#define Ka_scale mate[3].xyz
	#define Ke mate[4].xyz
	#define shiness mate[5].x
	#define shiness3 mate[5].xxx
	#define reflection mate[5].y
	#define refraction mate[5].z
	#define fresnel mate[5].w
}

param fog
{
	uniform mediump vec4 fogp[6]<ID=FOGPARAMVEC>; 
	varying lowp vec3 v_fogex;
	varying lowp vec3 v_fogin;
}

vs fog
{
	void vsfog( in mediump vec3 wvp){
		$( FOG == 1) {
			mediump float z = wvp.z + fogp[0].x;
			lowp float w = clamp( fogp[0].y*z + (exp( fogp[0].z*z)), 0.0, 1.0);
			v_fogex = vec3( w);
			v_fogin = fogp[1].xyz * (1.0-w);
		}
		$( FOG == 2) {
			mediump float s = length( wvp);
			mediump float costh = dot( -wvp/s, fogp[0].xyz );
			lowp vec3 fex = exp( s * fogp[1].xyz );
			v_fogex = fex;
			v_fogin = (fogp[2].xyz*( 1.0+costh*costh) + fogp[3].xyz*pow( fogp[2].w+fogp[3].w*costh,-1.5)) * (1.0-fex);
		}
	}
}

fs fog
{
	void fsfog( inout lowp vec4 pix){
		$( FOG) pix.xyz = v_fogin.xyz + pix.xyz * v_fogex.xyz;
	}
}


param lighting
{
	uniform mediump mat4 plight<ID=PIXELLIGHT>;
	uniform mediump mat4 vlight1<ID=VERTEXLIGHT1>;
	uniform mediump mat4 vlight2<ID=VERTEXLIGHT2>;
	uniform sampler2D ibltex <id=IBLTEX>;
}

define lighting
{
	#define lightpos lmat[0].xyz
	#define lightvec lmat[1].xyz
	#define lightdiff lmat[2].xyz
	#define lightspec lmat[3].xyz
	#define lightatten1 lmat[0].w
	#define lightatten2 lmat[1].w
	#define lightspotexp lmat[2].w
	#define lightspotcut lmat[3].w
}

vsfs lighting
{
	void nolighting    ( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
	}
	
	void fulllighting  ( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
		diff = vec3( 1.0, 1.0, 1.0);
	}
	
	void dirlighting   ( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
		lowp float dif = dot( lightvec, pn);
		diff += lightdiff * max( dif, 0.0);
		lowp vec3 v = normalize( wvp);
		lowp vec3 r = v - 2.0 * dot( pn, v) * pn;
		spec += lightspec * pow( max( dot( r, lightvec), 0.0), shiness);
	}
	
	void dirlighting_ns( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
		lowp float dif = dot( lightvec, pn);
		diff += lightdiff * max( dif, 0.0);
	}
	
	void pntlighting   ( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
		mediump vec3 _lvec = lightpos - wvp;
		mediump float d = length( _lvec);
		lowp vec3 lvec = normalize( _lvec);
		lowp float atten = 1.0 / (1.0+lightatten1*d+lightatten2*d*d);
		lowp float dif = dot( lvec, pn);
		lowp vec3 v = normalize( wvp);
		diff += lightdiff * max( dif, 0.0) * atten;
		lowp vec3 r = v - 2.0 * dot( pn, v) * pn;
		spec += lightspec * pow( max( dot( r, lvec), 0.0), shiness) * atten;
	}
	
	void pntlighting_ns( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
		mediump vec3 _lvec = lightpos - wvp;
		mediump float d = length( _lvec);
		lowp vec3 lvec = normalize( _lvec);
		lowp float atten = 1.0 / (1.0+lightatten1*d+lightatten2*d*d);
		lowp float dif = dot( lvec, pn);
		diff += lightdiff * max( dif, 0.0) * atten;
	}
}

fs lighting
{
	lowp vec2 ibluv( in lowp vec3 h){
		return h.xy;
	}
	
	void iblighting    ( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
		lowp vec3 h = normalize( pn*2.0 + normalize( wvp));
		lowp vec2 uv = ibluv( h);
		diff += lightdiff * texture2D( ibltex, uv).xyz;
		spec += lightspec * pow( texture2D( ibltex, uv+vec2( 0.5, 0.0)).xyz, shiness3);
	}
	
	void iblighting_ns ( in mediump mat4 lmat, in mediump vec3 wvp, in mediump vec3 pn, inout lowp vec3 diff, inout lowp vec3 spec){
		lowp vec3 h = normalize( pn*2.0 + normalize( wvp));
		lowp vec2 uv = ibluv( h);
		diff += lightdiff * texture2D( ibltex, uv).xyz;
	}
}
