/**********************************************************************************
 *	module : mod_transform
 *	
 *	
 **********************************************************************************/
declare mod_transform;


param transform
{
	attribute highp vec4 in_pos <ID=POSITION>;
	attribute mediump vec3 in_n <ID=NORMAL>;
	attribute mediump vec3 in_tan <ID=TANGENT>;
	attribute lowp vec4 in_widx <id=WEIGHTIDX>;
	attribute lowp vec4 in_w <ID=WEIGHT>;
	
	uniform highp mat4 wvmat <id=WVMAT>;
	uniform highp mat4 pmat <id=PMAT>;
	uniform mediump mat4 bonemat[26] <id=BONEMAT>;
}

vs transform
{
	//	[0] : MVP mat, [1] : MVN, [2] : MVTAN, [3] : MVBN
	mat4 getTransformedVectorsPN( in highp vec4 p, in mediump vec3 n){
		highp mat4 m;
		mediump mat3 wv3 = mat3( wvmat[0].xyz, wvmat[1].xyz, wvmat[2].xyz);
		$( BONEWEIGHT){
			mediump mat4 mixmat = 
				bonemat[int(in_widx.x)] * in_w.x + bonemat[int(in_widx.y)] * in_w.y + 
				bonemat[int(in_widx.z)] * in_w.z + bonemat[int(in_widx.w)] * in_w.w;
			mediump mat3 mix3 = mat3( mixmat[0].xyz, mixmat[1].xyz, mixmat[2].xyz);
			m[0] = (wvmat * (mixmat * p));
			$( NORMAL) m[1] = normalize( wv3 * (mix3 * n)).xyzz;
			$( NORMALMAP) {
				m[2] = normalize( wv3 * (mix3 * in_tan.xyz)).xyzz;
				m[3] = (cross( m[1].xyz, in_tan.xyz)) * in_tan.w).xyzz;
			}
		} : {
			m[0] = (wvmat * p);
			$( NORMAL) m[1] = normalize( wv3 * n).xyzz;
			$( NORMALMAP) {
				m[2] = normalize( wv3 * in_tan.xyz).xyzz;
				m[3] = cross( m[1].xyz, in_tan.xyz)).xyzz;
			}
		}
		return m;
	}
	mat4 getTransformedVectors(){
		return getTransformedVectorsPN( in_pos, in_n);
	}
}
