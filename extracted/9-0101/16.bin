[startscene]

;カメラ指定-----------
;キティにフォーカス
;--------------------
	
; キティアクション
[startanime name=kitty time=2000 script=sentence_kurukuru script_args={[{loop_num = 1, face=["kya", "kya"]}]}]
[balloonoffset y=0.5]
[balloon name=kitty time=4000]
The third thing/n
I'd like to do is.../n
A sleepover#e1#
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=sentence_kurukuru]

; キティアクション
