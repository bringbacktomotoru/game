and #playername.
[startanime name=mymelo time=2000 script=sentence_ketsui2 
 script_args={[{loop_num = 3, face=["smile"]}]}]
[startanime name=purin time=2000 script=munehari script_args={["kiri",3]}]
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=tabetai_set]

