;
;----------- 初期登場 -------------
[playbgm bgm="BGM07"]
[changeroom id=3]

;使用する家具

;ミントカフェテーブル
;[popfurniture id=6702 x=5.5 y=0 z=-2 angle=135]
;ミントカフェスタイルテーブル
[popfurniture id=7002 x=-0.5 y=0 z=-4 angle=180]
;ブルーカフェプラント
[popfurniture id=907 x=3 y=0 z=-5 angle=180]
;ピンクカフェチェア
[popfurniture id=10801 x=6 y=0 z=-4 angle=135]
;ピンクカフェチェア
[popfurniture id=10801 x=7.5 y=0 z=-2.5 angle=135]
;ブルーカフェスタイルチェア
[popfurniture id=11201 x=-1.5 y=0 z=-5.5 angle=180]
;ブルーカフェスタイルチェア
[popfurniture id=11201 x=0.5 y=0 z=-5.5 angle=180]

[focusdoor]

; 位置確認用カメラ----------------------
[movecamera type=0 x=-1 y=2.3 z=13 time=0]
[rotatecamera pitch=0 head=180 time=0]
;------------------------------------

;キャラ出現 予め部屋の中にいたような位置
;シナモン
[popchara costume=207102 x=-1 z=-10 angle=200 relative=true]
;プリン
[popchara costume=204101 x=4 z=-10 angle=160 relative=true]

[startscene]

[wait time=1000]

;演出内容------------------
;;部屋に来たプレイヤーを出迎えてくれるようなカメラワーク
;--------------------------

[startanime name=purin time=2000 script=munehari script_args={["smile",3]}]
[voice name=purin voice_key="e9"]
[balloon name=purin time=3000]
Nice#e1# It looks good#e1#
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=tefuri_set2]

[startanime name=cinnamon time=2000 script=tabetai_set script_args={[3,"kirasmile","kirasmile"]}]
[voice name=cinnamon voice_key="e8"]
[balloon name=cinnamon time=3000]
Having matching chairs and tables/n
makes it feel like a real cafe#e1#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tabetai_set]

;演出内容------------------
;けろっぴ登場
[popchara costume=112105 x=0 z=-1 angle=0 relative=true]
;ドアの前
;--------------------------
[focusdoor]
[movecamera type=1 x=-0.5 y=2 z=-12 time=0]
[rotatecamera pitch=0 head=0]

[balloonoffset y=-0.3]

[startanime name=keroppi time=2000 script=tefuri_set2 script_args={[3,"smile","smile"]}]
[voice name=keroppi voice_key="e4"]
[balloon name=keroppi time=3000]
Hey there Cinnamon,/n
Purin#e1#
[wait time=3000]
[endballoon name=keroppi]
[waitaction name=keroppi script=tefuri_set2]

[startanime name=keroppi time=2000 script=pyonpyon_set script_args={[3,"yaa","yaa"]}]
[balloon name=keroppi time=3000]
I'm here to help#o1#
[wait time=3000]
[endballoon name=keroppi]
[waitaction name=keroppi script=pyonpyon_set]

[movechara name=keroppi x=0 z=-0.5 script=walk_face script_args={["smile"]} neutral=stand time=1000]
[wait time=1000]

[startanime name=keroppi time=2000 script=mitsuketa_set script_args={["biku","def"]}]
[balloon name=keroppi time=3000]
Oh#e1#You're/n
#playername, right?
[wait time=3000]
[endballoon name=keroppi]
[waitaction name=keroppi script=mitsuketa_set]

[startanime name=keroppi time=2000 script=sentence_kurukuru 
 script_args={[{loop_num = 3, face=["warau", "warau"]}]}]
[voice name=keroppi voice_key="e2"]
[balloon name=keroppi time=3000]
Hi there#e1#/n
I'm Keroppi#e1#/n
Nice to meet you#e1#
[wait time=3000]
[endballoon name=keroppi]
[waitaction name=keroppi script=sentence_kurukuru]

;演出内容------------------
;けろっぴがシナモンプリンの方に移動
;テーブルなどがある方へ
;--------------------------

[wait time=1000]

;シナモン
[popchara costume=207102 x=3 z=-7.5 angle=240 relative=true]
;プリン
[popchara costume=204101 x=4 z=-10 angle=220 relative=true]

; 位置確認用カメラ----------------------
[movecamera type=0 x=14 y=2 z=6.5 time=0]
[rotatecamera pitch=0 head=245 time=0]
;------------------------------------

[popchara costume=112105 x=4 z=-3 angle=0 relative=true]

[movechara name=keroppi x=0 z=-1.5 script=walk_face script_args={["smile"]} neutral=stand time=2000]
[wait time=2000]

[startanime name=keroppi time=2000 script=stand script_args={[3,"smile"]}]

;モーションだけで挨拶
[startanime name=cinnamon time=2000 script=tefuri_set2 script_args={[3,"warau"]}]
[startanime name=purin time=2000 script=teage_set script_args={["smile"]}]

[wait time=1000]

[startanime name=keroppi time=2000 script=tefuri_set2 script_args={[3,"kya"]}]
[wait time=2000]
[turnchara name=keroppi script=walk_face angle=270 script_args={["smile"]} time=300]
[wait time=300]
[startanime name=keroppi time=0 script=stand_end2 script_args={["smile"]}]
[balloonoffset y=0]

[charavisible name=cinnamon visible=false]
;けろっぴフォーカス
[movecamera type=1 x=-6 y=-0.3 z=-0.5 time=0]
[wait time=800]

[startanime name=keroppi time=2000 script=mitsuketa_set script_args={["biku","def"]}]
[voice name=keroppi voice_key="e13_1"]
[balloonoffset x=2.5 y=-1.1]
[balloon name=keroppi time=3000 type=1]
Woah#e1#
[startanime name=cinnamon time=2000 script=stand_end2 script_args={["def"]}]
[startanime name=purin time=2000 script=stand_end2 script_args={["def"]}]
[wait time=3000]
[endballoon name=keroppi]
[waitaction name=keroppi script=mitsuketa_set]

[startanime name=keroppi time=2000 script=sentence_tabetai script_args={[{loop_num = 3}]}]
[balloon name=keroppi time=3000 type=1]
There're so many/n
tables and chairs#e1#
[wait time=3000]
[endballoon name=keroppi]
[waitaction name=keroppi script=sentence_tabetai]

[startanime name=keroppi time=2000 script=sentence_souzou 
 script_args={[{loop_num = 3, face=["smile3_cheek"]}]}]
[voice name=keroppi voice_key="e9"]
[balloon name=keroppi time=3000 type=1]
It feels like/n
my mom's restaurant#e1#
[startanime name=cinnamon time=2000 script=stand_end2 script_args={["warau"]}]
[startanime name=purin time=2000 script=stand_end2 script_args={["smile"]}]
[wait time=3000]
[endballoon name=keroppi]
[waitaction name=keroppi script=sentence_souzou]

[charavisible name=cinnamon visible=true]
;3人フォーカス
[movecamera type=1 x=6 y=0.3 z=0.5 time=0]
[wait time=800]
	
[startanime name=purin time=2000 script=munehari script_args={["kiri2",3]}]
[voice name=purin voice_key="e80_1"]
[balloonoffset]
[balloon name=purin time=3000]
Me, Cinnamon,/n
and #playername/n
put them out#e1#
[startanime name=keroppi time=2000 script=stand_end2 script_args={["def"]}]
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=munehari]

[startanime name=cinnamon time=2000 script=kubikashige script_args={[3,"kiss"]}]
[balloon name=cinnamon time=3000]
But,/n
there's still a lot/n
that needs to be done.
[wait time=1000]
[startanime name=purin time=2000 script=bou_unaduku_face script_args={[1,"meisou"]}]
[wait time=2000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=kubikashige]

;演出内容------------------
;三人を画面に収めるように
;--------------------------

[startanime name=keroppi time=2000 script=cos_bishi]
[voice name=keroppi voice_key="e80_1"]
