;----------- クエスト_おゆうぎ_汎用_始 -------------

; ドア指定
[focusdoor]

; カメラ初期位置
[movecamera type=1 z=-20 y=2.3 time=0]
[rotatecamera pitch=0]

; キャラ出現
[popchara z=-9 angle=0 relative=true]
[wait time=200]

; キャラ手振り
[startanime time=2000 script=tefuri]
[waitaction script=tefuri]

; キャラ悩む
[startanime time=5500 script=multipurpose_nayamu]
[balloon time=5500]
[talk talk_key = "quest_relax_start_1_1" index=1]
[wait time=5500]
[endballoon]
[waitaction script=multipurpose_nayamu]
[wait time=500]
; キャラぶらぶら
[startanime time=5500 script=event_burabura]
[balloon time=5500]
[talk talk_key = "quest_relax_start_1_2" index=1]
[wait time=5500]
[endballoon]
[waitaction script=event_burabura]

[startanime time=800 script=multipurpose_nayamu]
[waitaction script=multipurpose_nayamu]
[wait time=800]
