;----------- 初期登場 -------------
[playbgm bgm="BGM07"]
[changeroom id=3]

;ミントカフェスタイルテーブル
[popfurniture id=7002 x=5.5 y=0 z=-2 angle=135]
;クリーミィカフェカウンター
[popfurniture id=903 x=-0.5 y=0 z=-4 angle=180]
;ブルーカフェプラント
[popfurniture id=907 x=3 y=0 z=-5 angle=180]
;ブルーカフェチェア
[popfurniture id=11201 x=6 y=0 z=-4 angle=135]
;ブルーカフェチェア
[popfurniture id=11201 x=7.5 y=0 z=-2.5 angle=135]
;ピンクカフェチェア
[popfurniture id=10801 x=-1.5 y=0 z=-5.5 angle=180]
;ピンクカフェチェア
[popfurniture id=10801 x=0.5 y=0 z=-5.5 angle=180]
;ミントラテ本棚
[popfurniture id=906 x=-4.5 y=0 z=-4.5 angle=225]

;↓↓↓↓↓↓;;;;;;;;;;;;;;;;;;;

[focusdoor]

; 位置確認用カメラ----------------------
[movecamera type=0 x=-3.6 y=2.2 z=12 time=0]
[rotatecamera pitch=0 head=165]

;キャラ出現 予め部屋の中にいたような位置
;プリン
[popchara costume=204101 x=0 z=-10 angle=180 relative=true]
;シナモン
[popchara costume=207102 x=2.5 z=-9 angle=165 relative=true]
;けろっぴ
[popchara costume=202105 x=4.7 z=-8 angle=140 relative=true]
;------------------------------------

[startscene]
	
;演出指定-------------------
