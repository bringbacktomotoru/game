
; ドア指定
[focusdoor]

; カメラ初期位置
[movecamera type=1 z=-20 y=2.3 time=0]
[rotatecamera pitch=0]

; キャラ出現
[popchara z=-9 angle=0 relative=true]
[wait time=200]

; キャラ手振り
[startanime time=2500 script=event_relax_bed2]
[waitaction script=event_relax_bed2]

[startanime time=4000 script=multipurpose_yokopatapata]
[balloon time=6000]
[talk talk_key = "quest_relax_end_chair_1_1" index=2]
[wait time=6000]
[endballoon]
[waitaction script=multipurpose_yokopatapata]

[startanime time=4000 script=multipurpose_tehe]
[balloon time=4500]
[talk talk_key = "quest_relax_end_chair_1_2" index=2]
[wait time=4500]
[endballoon]
[waitaction script=multipurpose_tehe]