;
;----------- 初期登場 -------------
	
[focusdoor]

; カメラ初期位置
[movecamera type=1 z=-15 y=6.2 time=0]
[rotatecamera pitch=17]

; キャラ出現
[popchara name=cinnamon z=-2 angle=180 relative=true]
[wait time=200]
[startanime name=cinnamon time=700 script=bookshelf_mitsuketa]
[waitaction name=cinnamon script=bookshelf_mitsuketa]
[wait time=700]

[movecamera type=1 z=-0.5 y=-3.9 time=2500]
[rotatecamera pitch=0 time=2500]

[turnchara name=cinnamon angle=0 time=1000 script=turn_r]
[waitaction name=cinnamon script=turn_r]

; キャラ前に向かって移動
[movechara name=cinnamon type=1 z=-2 script=skip_smile neutral=stand time=1300]
[wait time=2000]

; キャラ手振り
[startanime name=cinnamon time=2000 script=tefuri]
[balloon name=cinnamon time=3000]
[voice voice_key="event_new_chara" name=cinnamon]
Hiya#e1#/nI'm Cinnamoroll#o1#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri]

[turnchara name=cinnamon angle=30 time=500 script=turn_r]
[waitaction name=cinnamon script=turn_r]

[startanime name=cinnamon time=500 script=stand]
[waitaction name=cinnamon script=stand]

; キティ出現
[popchara name=kitty relative=1 x=-5.0 z=-3.7 angle=-90]
[movechara name=kitty type=1 x=2.0 script=movie_walk neutral=stand time=4500]
[movecamera type=1 x=-1.4 time=2000]
[wait time=2300]

[turnchara name=kitty angle=-30 time=300 script=turn_r]
[waitaction name=kitty script=turn_r]

[startanime name=cinnamon time=1500 script=teage]
[startanime name=kitty time=1500 script=teage]
[waitaction name=cinnamon script=teage]
[waitaction name=kitty script=teage]

[startanime name=cinnamon time=4000 script=event_kyorokyoro]
[startanime name=kitty time=4000 script=event_stand_smile]
[balloon name=cinnamon time=4000]
What a nice room#e1#
[wait time=4000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=event_kyorokyoro]
[waitaction name=kitty script=event_stand_smile]

[startanime name=cinnamon time=3000 script=work_end_event]
[startanime name=kitty time=1500 script=event_unaduku]
[waitaction name=kitty script=event_unaduku]
[startanime name=kitty time=4000 script=ketsui_event]
[balloon name=cinnamon time=7000]
[voice voice_key="event_smile" name=cinnamon]
I'm so happy you invited me#o1#
[wait time=7000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=work_end_event]
[waitaction name=kitty script=ketsui_event]
