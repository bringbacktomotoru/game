;
;----------- 初期登場 -------------

[playbgm bgm="BGM03"]
[changeroom id=1]

;カメラ初期位置
[movecamera type=0 x=-2.5 y=2.3 z=7 time=0]
[rotatecamera pitch=0 head=130 time=0]

;オレンジカントリーチェア
[popfurniture fname=chair1 id=8401 x=-12 y=2 z=-2 angle=130 relative=true]

;キャラ出現
[popchara costume=109001 x=-17.5 y=2 z=-4 angle=0 relative=true]
[startscene]
[wait time=200]

;右に70度首振り
[rotatecamera type=1 pitch=0 head=50 time=8000]
[wait time=7500]

;キャラがカメラに気がつく
[startanime name=kitty script=uun_set time=700]
[waitaction name=kitty script=uun_set]
[wait time=700]

;キャラが振り返る
[turnchara name=kitty script=turn_r angle=180  time=1000]
[waitaction name=kitty script=turn_r]

;キャラがカメラに近づく
[movechara name=kitty type=1 z=0.5 script=movie_walk neutral=stand time=1000]
[wait time=1000]

;キャラ手振り
[startanime name=kitty script=tefuri time=2000]
[voice name=kitty voice_key="e4"]
[balloon name=kitty time=3000]
Oh#e1# Hello there#e1#
[wait time=3000]
[endballoon name=kitty]

[startanime name=kitty script=kubikashige script_args={[2,"meisou","meisou"]} time=3000]
[balloon name=kitty time=3500]
I came here/n
looking for Daniel,/n
but it looks like he's not here.
[wait time=3500]
[endballoon name=kitty]
[waitaction name=kitty script=kubikashige]

[startanime name=kitty script=stand_end2 script_args={["sad"]} time=3000]
[balloon name=kitty time=3000]
Are you/n
Daniel's friend#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=pyonpyon]

[startanime name=kitty script=kubikashige script_args={[3,"sad","blink"]} time=3000]
[balloon name=kitty time=3000]
Do you know/n
where he went#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=pyonpyon]

[startanime name=kitty script=mitsuketa_set script_args={["def","blink"]} time=3000]
[balloon name=kitty time=3000]
Hm#q1#/n
On a photography trip#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=pyonpyon]

[startanime name=kitty script=bou_unaduku_face script_args={[2,"smile"]} time=3000]
[balloon name=kitty time=3500]
Oh, I see#e1#/n
Thank you/n
for telling me#e1#
[wait time=3500]
[endballoon name=kitty]
[waitaction name=kitty script=pyonpyon]

[startanime name=kitty script=tefuri time=2000]
[voice name=kitty voice_key="e2"]
[balloon name=kitty time=3000]
My name is Hello Kitty#e1#/n
Nice to meet you#o1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=tefuri]

[startanime name=kitty script=uun_set time=3000]
[balloon name=kitty time=3000]
What's your name#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=uun_set]

[popdialog target="InputPlayerInfo"]

[startanime name=kitty script=tabetai_set script_args={[3,"kirasmile","kirasmile"]} time=3000]
[voice name=kitty voice_key="e9"]
[balloon name=kitty time=3000]
So your name is/n
#playername#e1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=tabetai_set]

[startanime name=kitty script=teage script_args={["smile","smile"]} time=3000]
[balloon name=kitty time=3000]
Let's/n
be friends#e1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=teage]

[startanime name=kitty script=sentence_kurukuru 
 script_args={[{loop_num = 3, face=["smile2", "smile2"]}]} time=3000]
[voice name=kitty voice_key="e8"]
[balloon name=kitty time=4000]
Oh #playername,/n
I'm so happy#e1#
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=tabetai_set]
[wait time=300]
[startanime name=kitty script=gakkari_set script_args={[1,"meisou","meisou"]} time=2000]
[voice name=kitty voice_key="e24"]
[balloon name=kitty time=3500]
Phew.../n
All of this walking/n
has made me a little tired.
[wait time=3500]
[endballoon name=kitty]
[waitaction name=kitty script=gakkari_set]

[startanime name=kitty script=mitsuketa_set script_args={["biku","blink"]} time=3000]
[balloon name=kitty time=3000]
Hm#q1#/n
I can use this chair#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=yokopatapata]

[startanime name=kitty script=yokopatapata time=3000]
[voice name=kitty voice_key="e7"]
[balloon name=kitty time=3000]
Thank you so much#e1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=yokopatapata]

[startanime name=kitty script=bou_unaduku_face script_args={[2,"smile"]} time=3000]
[balloon name=kitty time=3000]
Well then,/n
I guess I'll take/n
a little break#e1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=yokopatapata]
[fadeoutbgm spd=12]
[wait time=2300]