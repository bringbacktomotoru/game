[balloon name=mymelo time=3000 type=1]
Here Melody goes#e1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=event_unaduku]

[wait time=500]

[jump target={"*end"}]


*branch2

; マイメロ决意
[startanime name=mymelo time=3000 script=event_onegai2 script_args={["tere"]}]
[balloonoffset x=1.3 y=-0.5]
[balloon name=mymelo time=3000 type=1]
[voice voice_key="e8" name=mymelo]
