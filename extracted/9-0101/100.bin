;----------- クエスト_おゆうぎ_植木_始 -------------

; ドア指定
[focusdoor]

; カメラ初期位置
[movecamera type=1 z=-20 y=2.3 time=0]
[rotatecamera pitch=0]

; キャラ出現
[popchara z=-9 angle=0 relative=true]
[wait time=200]

; キャラ手振り
[startanime time=2000 script=tefuri]
[waitaction script=tefuri]

; キャラ悩む
[startanime time=4500 script=create]
[balloon time=5500]
[talk talk_key = "quest_relax_start_plant_1_1" index=0]
[wait time=5500]
[endballoon]
[waitaction script=create]
[wait time=500]
; キャラぶらぶら
[startanime time=5500 script=tere]
[balloon time=5500]
[talk talk_key = "quest_relax_start_plant_1_2" index=0]
[wait time=5500]
[endballoon]
[waitaction script=tere]

[startanime time=800 script=event_unaduku]
[waitaction script=event_unaduku]
[wait time=800]
