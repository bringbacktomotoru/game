;
;----------- テスト -------------
;新しい服に着替えて自慢する話

; 作業部屋指定
[focusroom address={[0,0]}]

; キャラ出現
[popchara name=mymelo relative x=3.5 angle=90]

; 初期配置
[rotatecamera head=80 time=0]
[movecamera type=1 x=-3.0 z=14.0 y=-2.0 time=0]
[wait time=1000]

; 手を振りながら発見
[startanime name=mymelo time=2000 script=tefuri]
[balloon name=mymelo time=1000]
あら、
[wait time=1000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

; 移動＋カメラも移動
[movechara name=mymelo type=1 x=-2.0 script=movie_walk neutral=stand time=5000]
[rotatecamera head=1 time=3500]
[movecamera type=1 x=3.2 z=-5.0 time=3000]
; 移動しながら喋る
[balloon name=mymelo time=5000]
シナモンくん♪
[wait time=1500]
[endballoon name=mymelo]
[wait time=1000]

; 途中からキャラ出現
[popchara name=cinnamon relative=1 x=-1.0 angle=90]
; 2キャラ振り向き
[turnchara name=cinnamon angle=-55 time=1000 script=turn_r]
[waitaction name=cinnamon script=turn_r]
[turnchara name=mymelo angle=55 time=300 script=turn_r]
[waitaction name=mymelo script=turn_r]
; 手をあげて挨拶
[startanime name=cinnamon time=1500 script=teage]
[waitaction name=cinnamon script=teage]
[startanime name=mymelo time=1500 script=teage]
[waitaction name=mymelo script=teage]

[wait time=1000]

; 会話
[balloon name=mymelo time=3000]
あのね、おようふくを[r]きがえてみたの…♪
[wait time=3500]
[endballoon name=mymelo]
; カメラ移動_1キャラアップ
[movecamera type=1 x=-0.5 z=2.0 time=0]
[rotatecamera head=23 time=0]
; くるくるお披露目
[startanime name=mymelo time=4000 script=kurukuru]
[balloon name=mymelo]
どうかしら？[wait time=3500][r]めろでぃ、へんじゃない？
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=kurukuru]

[wait time=1000]
; カメラ移動_マイメロアップ
[movecamera type=1 x=2.5 z=1.3 time=0]
[rotatecamera head=-50 time=0]
; 2キャラ照れ
[startanime name=cinnamon time=7000 script=tere]
[balloon name=cinnamon]
わあ！[r][wait time=2500]とってもにあってるよ♪
[wait time=4000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tere]
; カメラ移動_二人映る
[movecamera type=1 x=-2.0 z=-3.3 time=0]
[rotatecamera head=1 time=0]
[wait time=1000]
[startanime name=mymelo time=3000 script=ketsui]
[balloon name=mymelo]
ほんとう？[r][wait time=2000]たくさんなやんだから[r]うれしいの♡
[wait time=4000]
[endballoon name=mymelo]
[waitaction name=mymelo script=ketsui]

[wait time=1000]
; カメラ移動_マイメロアップ
[movecamera type=1 x=2.0 z=3.3 time=0]
[rotatecamera head=-50 time=0]
[startanime name=cinnamon time=14000 script=picture_kansou_event]
[balloon name=cinnamon]
いいなあ～♪[r][wait time=2000]ぼくも新しい[wait time=2000][r]お洋服欲しいなぁ♪
[wait time=4000]
[endballoon name=cinnamon]

[wait time=1000]
; カメラ移動_二人映る
[movecamera type=1 x=-2.0 z=-3.3 time=0]
[rotatecamera head=1 time=0]

[wait time=500]

[balloon name=mymelo]
じゃあこんど、めろでぃと[r][wait time=1000]あたらしいおようふく、[wait time=1000][r]いっしょにえらぼ？
[waitaction name=cinnamon script=picture_kansou_event]
[wait time=1000]
[endballoon name=mymelo]
; アクション
[startanime name=mymelo time=5000 script=yokopatapata]
[startanime name=cinnamon time=5000 script=pyonpyon_set script_args={[3,"smile3"]}]
[waitaction name=mymelo script=ketsui]
[waitaction name=cinnamon script=pyonpyon]

[wait time=3000]

; 手を挙げて挨拶
[startanime name=mymelo time=2000 script=tefuri]
[startanime name=cinnamon time=2000 script=tefuri]
[waitaction name=mymelo script=tefuri]
[waitaction name=cinnamon script=tefuri]
[wait time=1000]

