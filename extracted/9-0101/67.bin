;
;----------- テストレベルアップ -------------
;レベルアップした時の軽いモーション的なののテストです

; 作業部屋指定
[focusroom address={[0,0]}]

; 初期配置
[popchara name=kiki relative=1 x=0 angle=0]

[startanime name=kiki time=2500 script=pyonpyon2_set script_args={[2,"smile","smile3"]}]
[movecamera type=1 x=0 z=12 y=3]
[rotatecamera pitch=65]

[movecamera type=1 z=-1 y=-4.3 time=2500]
[rotatecamera pitch=5 time=2500]
[waitaction name=kiki script=pyonpyon2_set]

[wait time=300]
[startanime name=kiki time=5000 script=munehari script_args={["nikawink",2]}]
[waitaction name=kiki script=munehari]
[wait time=500]


