;----------- おでかけから帰ってきたとき -------------

; 作業部屋指定
[focusdoor]

; カメラ初期位置
[movecamera type=1 z=-15 y=2.2 time=0]
[rotatecamera pitch=0]

; キャラ出現
[popchara z=-2 angle=180 relative=true]
[wait time=200]
[startanime time=700 script=bookshelf_mitsuketa]
[waitaction script=bookshelf_mitsuketa]
[wait time=700]

[turnchara angle=0 time=1000 script=turn_r]
[waitaction script=turn_r]

; キャラ手振り
[startanime time=2000 script=tefuri]
[balloon time=3000]
[talk talk_key = "going_2_1" index=2]
[wait time=2000]
[endballoon]
[waitaction script=tefuri]

; キャラ前に向かって移動
[movechara type=1 z=-2 script=skip_smile neutral=stand time=1300]
[wait time=2000]

[startanime time=4000 script=work_end_event]
[balloon time=7000]
[talk talk_key = "quest_wark_end_1_1" index=2]
[wait time=7000]
[endballoon]
[waitaction script=work_end_event]

[startanime time=5000 script=event_workend]
[balloon time=5500]
[talk talk_key = "quest_wark_end_1_2" index=2]
[wait time=5500]
[endballoon]
[waitaction script=event_workend]