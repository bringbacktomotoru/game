;
;----------- テスト -------------
;キティとマイメロで新しい服に着替えたキティがマイメロに自慢する話

; 作業部屋指定
[focusroom address={[0,0]}]

; キャラ出現
[popchara name=kitty relative x=3.5 angle=90]

; 初期配置
[rotatecamera head=80 time=0]
[movecamera type=1 x=-3.0 z=14.0 y=-2.0 time=0]
[wait time=1000]

; 手を振りながら発見
[startanime name=kitty time=2000 script=tefuri]
[balloon name=kitty time=1000]
あ！
[wait time=1000]
[endballoon name=kitty]
[waitaction name=kitty script=tefuri]

; 移動＋カメラも移動
[movechara name=kitty type=1 x=-2.0 script=movie_walk neutral=stand time=5000]
[rotatecamera head=1 time=3500]
[movecamera type=1 x=3.2 z=-5.0 time=3000]
; 移動しながら喋る
[balloon name=kitty time=5000]
メロディ！
[wait time=1500]
[endballoon name=kitty]
[wait time=1000]

; 途中からキャラ出現
[popchara name=mymelo relative=1 x=-1.0 angle=90]
; マイメロ振り向き
[turnchara name=mymelo angle=-55 time=1000 script=turn_r]
[waitaction name=mymelo script=turn_r]
[turnchara name=kitty angle=55 time=300 script=turn_r]
[waitaction name=kitty script=turn_r]
; 手をあげて挨拶
[startanime name=mymelo time=1500 script=teage]
[waitaction name=mymelo script=teage]
[startanime name=kitty time=1500 script=teage]
[waitaction name=kitty script=teage]

[wait time=1000]

; 会話
[balloon name=kitty time=3000]
新しいお洋服に[r]着替えてみたのよ！
[wait time=3000]
[endballoon name=kitty]
; カメラ移動_キティアップ
[movecamera type=1 x=-0.5 z=2.0 time=0]
[rotatecamera head=23 time=0]
; くるくるお披露目
[startanime name=kitty time=4000 script=kurukuru]
[balloon name=kitty]
どうかしら？[wait time=3500][r]似合ってる？[r]
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=kurukuru]

[wait time=1000]
; カメラ移動_マイメロアップ
[movecamera type=1 x=2.5 z=1.3 time=0]
[rotatecamera head=-50 time=0]
; マイメロ照れ
[startanime name=mymelo time=7000 script=tere]
[balloon name=mymelo]
わあ♡[r][wait time=2500]とってもかわいいの…♡
[wait time=4000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tere]
; カメラ移動_二人映る
[movecamera type=1 x=-2.0 z=-3.3 time=0]
[rotatecamera head=1 time=0]
[wait time=1000]
[startanime name=kitty time=3000 script=ketsui]
[balloon name=kitty]
ありがとう！[r]すっごく嬉しいわ！
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=ketsui]

[wait time=1000]
; カメラ移動_マイメロアップ
[movecamera type=1 x=2.0 z=3.3 time=0]
[rotatecamera head=-50 time=0]
[startanime name=mymelo time=14000 script=picture_kansou_event]
[balloon name=mymelo]
いいなあ…♪[r][wait time=2000]めろでぃもあたらしい[wait time=2000][r]おようふくほしいの…♪
[wait time=4000]
[endballoon name=mymelo]

[wait time=1000]
; カメラ移動_二人映る
[movecamera type=1 x=-2.0 z=-3.3 time=0]
[rotatecamera head=1 time=0]

[wait time=500]

[balloon name=kitty]
今度、メロディの[wait time=1000][r]新しいお洋服、[wait time=1000][r]一緒に選びましょう！
[waitaction name=mymelo script=picture_kansou_event]
[wait time=1000]
[endballoon name=kitty]
; アクション
[startanime name=kitty time=5000 script=yokopatapata]
[startanime name=mymelo time=5000 script=pyonpyon_set script_args={[3,"smile3"]}]
[waitaction name=kitty script=ketsui]
[waitaction name=mymelo script=pyonpyon]

[wait time=3000]

; 手を挙げて挨拶
[startanime name=kitty time=2000 script=tefuri]
[startanime name=mymelo time=2000 script=tefuri]
[waitaction name=kitty script=tefuri]
[waitaction name=mymelo script=tefuri]
[wait time=1000]

