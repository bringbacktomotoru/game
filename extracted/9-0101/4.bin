;
;----------- 初期登場 -------------
[playbgm bgm="BGM03"]
[changeroom id=1]

;オレンジまんまるラグ
[popfurniture fname=rug1 id=1703 x=-7.5 y=0 z=2.5 angle=0]
;チャーミーカントリーランプ
[popfurniture fname=lamp1 id=812 x=-6.5 y=0 z=5 angle=0]
;セピアウッドブックシェルフ
[popfurniture fname=book1 id=5405 x=-8.5 y=0 z=2.5 angle=270]

[focusdoor]

; カメラ初期位置
[movecamera type=0 z=-10 y=5 x=-1.7 time=0]
[rotatecamera  pitch=10 head=0]

; マイメロ出現
[popchara costume=108002 z=-2 angle=0 relative=true]
[startscene]
[wait time=200]
[startanime name=mymelo time=2000 script=kurukuru_set script_args={[3,"smile","smile"]}]
[waitaction name=mymelo script=kurukuru_set]
[wait time=500]


; キティ出現
[popchara costume=109001 z=-10 x=-5.7 angle=210 relative=true]
[wait time=200]
[startanime name=kitty time=700 script=bookshelf_mitsuketa]
[waitaction name=kitty script=bookshelf_mitsuketa]
[wait time=700]

; マイメロ前に向かって移動
[turnchara name=mymelo angle=15 time=500 script=turn_r]
[waitaction name=mymelo script=turn_r]
[movechara name=mymelo type=1 z=-2 x=-0.5 script=movie_dash neutral=stand time=1300]

; カメラ移動
[movecamera type=0 z=-11 y=4.2 x=-3.0 time=2500]

; キティ右に移動 マイメロ移動終了
[movechara name=kitty type=1 z=6 x=7.5 script=movie_walk neutral=stand time=3500]
[wait time=3500]
[waitaction name=mymelo script=movie_dash]
[wait time=1500]

; マイメロ手振り
[startanime name=mymelo time=902 script=tefuri_set2 script_args={[3,"warau"]}]
[wait time=500]
[startanime name=kitty time=902 script=teage_link_set script_args={[1]}]
[voice voice_key="e4" name=mymelo]
[balloonoffset x=1.5 y=0]
[balloon name=mymelo time=3000 type=2]
Hi, Kitty#e1#
[balloonoffset]
[wait time=2000]
[startanime name=kitty time=902 script=stand_end]
[wait time=500]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri_set2]


;メロディフォーカス
[movecamera type=0 z=-5 y=2 x=-2.5 time=0]
[rotatecamera  pitch=0 head=0]
[wait time=0]


; マイメロアクション
[startanime name=mymelo time=2000 script=pyonpyon_set script_args={[3,"kya","smile3"]}]
[voice voice_key="e8" name=mymelo]
[balloonoffset x=1.2 y=-0.5]
[balloon name=mymelo time=3000 type=2]
Melody came/nbecause you called#o1#
[balloonoffset]
[startanime name=kitty time=2000 script=yokoyure_set2 script_args={[1,"smile"]}]
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=pyonpyon_set]

; カメラ移動
[movecamera type=0 z=-3.7 y=4 x=7 time=0]
[rotatecamera pitch=10 head=355]
[rotatecamera type=1 pitch=0 head=-60 time=0]
[wait time=0]


; キティアクション
[startanime name=kitty time=2000 script=kurukuru_set script_args={[3,"smile2","smile2"]}]
[voice voice_key="e13_1" name=kitty]
[balloon name=kitty time=3000]
Hi Melody,/nI'm so happy you're here#e1#
[startanime name=mymelo time=2000 script=yokoyure_set2 script_args={[1,"smile"]}]
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=kurukuru_set]

[wait time=800]


;メロディフォーカス
[movecamera type=0 z=-2.7 y=2 x=5 time=0]
[rotatecamera  pitch=0 head=305]
[wait time=0]

;キティ非表示
[charavisible name=kitty visible=false]

; マイメロ方向転換
[turnchara name=mymelo angle=-55 time=300 script=turn_r]
[wait time=300]
[waitaction name=mymelo script=turn_r]

; マイメロアクション
[startanime name=mymelo time=2500 script=mitsuketa_set script_args={["biku","kyomi_blink"]}]
[balloonoffset x=1.5 y=-0.5]
[balloon name=mymelo time=2000 type=2]
Oh#e1#
[wait time=2000]
[endballoon name=mymelo]
[waitaction name=mymelo script=mitsuketa_set]

; マイメロアクション
