;ラグ
[popfurniture id=1713 x=0 y=0 z=0 angle=0]
;テーブル
[popfurniture id=100003 x=-4.5 y=0 z=-5 angle=180]
;椅子
[popfurniture id=5701  x=-5.5 y=0 z=-6 angle=180]
[popfurniture id=5701  x=-3.5 y=0 z=-6 angle=180]
;電話
[popfurniture id=14602   x=2 y=0 z=-9.5 angle=180]

[focusdoor]

; 位置確認用カメラ----------------------
;[movecamera type=1 x=2 y=55 z=-9 time=0]
;[rotatecamera pitch=90]
;------------------------------------
;カメラ初期位置
[movecamera type=0 x=-1 y=3 z=14 time=0]
[rotatecamera pitch=5 head=180 time=0]

;キャラ出現 初期カメラの表示範囲外に
[popchara costume=111101 x=2.5 z=-8 angle=70 relative=true]
;シナモン
[popchara costume=1104102 x=0 z=-9 angle=210 relative=true]
;メロディ
[popchara costume=904002 x=-1.3 z=-7 angle=220 relative=true]
[popchara costume=112105 x=3.8 z=-9 angle=145 relative=true]

; キャラアクション
[startanime name=purin time=0 script=lag_neteru_set script_args={["meisou",1]}]
[waitaction name=purin script=lag_neru_set]

[startscene]

[startanime name=keroppi time=2000 script=stand_end2 script_args={["kyomi"]}]
[startanime name=cinnamon time=2000 script=kubikashige script_args={[3,"sad2"]}]

[wait time=500]

; カメラワーク指定----------------------
