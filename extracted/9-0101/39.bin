;
;----------- 初期登場 -------------

[playbgm bgm="BGM02"]
[changeroom id=4]

;ハローキティハッピーリボンピアノ
[popfurniture fname=piano id=2001 x=0.5 y=0 z=-2.5 angle=225]
;キティラグ
[popfurniture fname=rug id=3901 x=-1 y=0 z=-1 angle=180]
;ピンクアンティークチェア
[popfurniture fname=chair1 id=9001 x=-4 y=0 z=1 angle=270]
;ピンクアンティークチェア
[popfurniture fname=chair2 id=9001 x=-3 y=0 z=-2 angle=225]
;フラワリーアンティーククロック
[popfurniture fname=clock id=1504 x=-2 y=0 z=-5 angle=180]
;ノスタルジックカントリーランプ
[popfurniture fname=lamp id=5712 x=-4 y=0 z=-5 angle=180]

;---------------------------------------------------------------------------

[focusdoor]

; カメラ初期位置
[movecamera type=0 x=-0.4 y=3 z=9 time=0]
[rotatecamera pitch=0 head=180]

;---------------------------------------------------------------------------

;キャラ出現 家具が見える範囲だと見栄えが良いかも
;キティ
[popchara costume=1509001 x=5 z=-7 angle=160 relative=true]
;メロディ
[popchara costume=1512002 x=2 z=-8 angle=180 relative=true]
;プリン
[popchara costume=1512101 x=0 z=-7 angle=200 relative=true]

; カメラワーク指定----------------------
;マイメロをフォーカス
;衣装全体を映すようにカメラを少しうごかしても良いかも
;（上から下に、下から上に等）
;------------------------------------

[charavisible name=kitty visible=false]
[charavisible name=mymelo visible=true]
[charavisible name=purin visible=false]

[startscene]

[movecamera type=1 x=0 y=-1.1 z=0 time=2000]
[wait time=1500]

;---------------------------------------------------------------------------

; キャラアクション
[startanime name=mymelo time=2000 script=sentence_kurukuru
 script_args={[{loop_num = 3, face=["tere", "tere"]}]}]
[voice name=mymelo voice_key="e8"]
[balloon name=mymelo time=3500]
ねぇねぇ#o1#/n
#playername/n
このかっこうどう#q1#
[wait time=3500]
[endballoon name=mymelo]
[waitaction name=mymelo script=sentence_kurukuru]

; カメラワーク指定----------------------
;プリンをフォーカス
;衣装全体を映すようにカメラを少しうごかしてもいいかも
;（上から下に、下から上に等）
;------------------------------------

[focusdoor]

[charavisible name=kitty visible=false]
[charavisible name=mymelo visible=false]
[charavisible name=purin visible=true]

[movecamera type=0 x=-2.5 y=3 z=9 time=0]
[rotatecamera pitch=0 head=180]

[movecamera type=1 x=0 y=-1.1 z=0 time=2000]
[wait time=1500]

[startanime name=purin time=2000 script=munehari script_args={["smile2",3]}]
[voice name=purin voice_key="e13_1"]
[balloon name=purin time=3000]
ぼくも着がえてきたよ/n
なにやるのー#q1#
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=munehari]

; カメラワーク指定----------------------
;キティをフォーカス
;衣装全体を映すようにカメラを少しうごかしてもいいかも
;（上から下に、下から上に等）
;------------------------------------

[focusdoor]

[charavisible name=kitty visible=true]
[movecamera type=0 x=2.3 y=2 z=8 time=0]

[startanime name=kitty time=2000 script=kubikashige script_args={[3,"smile"]}]
[voice name=kitty voice_key="e8"]
[balloonoffset x=-1.3 y=-0.5]
[balloon name=kitty time=3000 type=2]
うふふ#h1#/n
わたしのやりたいこと/n
ふたつめはね…
[wait time=2000]
[endballoon name=kitty]
[waitaction name=kitty script=kubikashige]

; カメラワーク指定----------------------
;ピアノとキティが映るようにカメラ変更
;マイメロとプリンもいれたい
;------------------------------------
[movecamera type=0 x=0.1 y=2 z=14 time=0]
[charavisible name=mymelo visible=true]
[charavisible name=purin visible=true]
[turnchara name=mymelo script=walk_face angle=210 script_args={["smile"]} time=0]
[wait time=100]
[startanime name=mymelo time=2000 script=kubikashige script_args={[3,"kyomi"]}]
[turnchara name=purin script=walk_face angle=210 script_args={["smile"]} time=0]
[wait time=100]
[startanime name=purin time=2000 script=uun2_set script_args={[3,"kyomi"]}]

[startanime name=kitty time=2000 script=sentence_ketsui2 script_args={[{loop_num = 3, face=["smile2"]}]}]
[balloonoffset]
[balloon name=kitty time=3000]
みんなにピアノの演奏を/n
聴いてもらうことなの#h1#
[wait time=1000]
[startanime name=purin time=2000 script=mitsuketa_set script_args={["kirasmile","biku"]}]
[wait time=200]
[startanime name=mymelo time=2000 script=mitsuketa_set script_args={["kirasmile","biku"]}]
[wait time=2800]
[endballoon name=kitty]
[waitaction name=kitty script=mitsuketa_set]

[startanime name=kitty time=2000 script=sentence_uun
 script_args={[{loop_num = 5, face=["smile2"]}]}]
[voice name=kitty voice_key="e80_1"]
[balloon name=kitty time=3000]
楽しんでもらえたらいいな#e1#
[startanime name=purin time=2000 script=sentence_picture_kansou1
 script_args={[{loop_num = 3, face=["kya"]}]}]
[startanime name=mymelo time=2000 script=sentence_tere_2
 script_args={[{loop_num = 3, face=["smile", "smile"]}]}]
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=sentence_pyonpyon2]
[fadeoutbgm spd=12]

;場面転換
[shutterstart]

[focusdoor]

; カメラ初期位置
[movecamera type=0 x=-5 y=4 z=0.5 time=0]
[rotatecamera pitch=14 head=110]

[charavisible name=kitty visible=true]
[charavisible name=mymelo visible=true]
[charavisible name=purin visible=true]

;キティピアノに座る
[usefurniture name=kitty fname=piano bone=chara1 script=event_start
 script_args={{face="meisou", num=3}}]

;メロディとプリン椅子に座る
[usefurniture name=mymelo fname=chair1 bone=chara1 script=event_start
 script_args={{face="meisou", num=3}}]
[usefurniture name=purin fname=chair2 bone=chara1 script=event_start
 script_args={{face="meisou", num=3}}]

; 演出指定----------------------
;ピアノと椅子が入るようにカメラ切り替え
;キティの表情が見えるようにキティ（ピアノ）が手前に来るようにカメラ位置調整したらいいかも
;家具の位置調整が必要であれば連絡ください
;------------------------------

[wait time=1500]

;キャラアクション
[startanime name=kitty time=2000 script=piano_play_set script_args={[10,"meisou"]}]
[startanime name=mymelo time=2000 script=tv_watching_yure_set script_args={[10,"meisou"]}]
[startanime name=purin time=2000 script=chair_patapata_set script_args={[10,"meisou"]}]

;場面転換終了
[shutterend]

; カメラワーク指定----------------------
;演奏しているキティを始めに映す
;次に聞いているプリンとメロディを映す
;------------------------------------

[playbgm bgm="P-2"]
[wait time=2000]

[movecamera type=0 x=5 y=4.5 z=2 time=0]
[rotatecamera pitch=14 head=254]

[wait time=3000]

[focusdoor]

; カメラ初期位置
[movecamera type=0 x=-1 y=2.5 z=12 time=0]
[rotatecamera pitch=0 head=181]

[balloonoffset x=0 y=0.5]

[startanime name=kitty time=2000 script=piano_end_set script_args={[2,"meisou","smile2"]}]
[startanime name=mymelo time=2000 script=chair_tere_2 script_args={[3,"meisou_cheek"]}]
[voice name=mymelo voice_key="e14"]
[balloon name=mymelo time=3000]
とってもじょうず#e1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=piano_end_set]

[startanime name=purin time=2000 script=rockingchair_kakaeru script_args={[3,"meisou_cheek"]}]
[voice name=purin voice_key="e9"]
[balloonoffset x=0 y=0.5]
