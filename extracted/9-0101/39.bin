聴いてくれてありがとう#e1#
[wait time=1000]
[startanime name=purin time=2000 script=chair_patapata_set script_args={[10,"smile"]}]
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=tv_watching_yure_set]

[startanime name=kitty time=2000 script=chair_kubikashige_set script_args={[3,"smile"]}]
[balloon name=kitty time=3000 type=2]
#playername/n
