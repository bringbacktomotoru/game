;----------- クエスト_おゆうぎ_植木_終 -------------

; ドア指定
[focusdoor]

; カメラ初期位置
[movecamera type=1 z=-20 y=2.3 time=0]
[rotatecamera pitch=0]

; キャラ出現
[popchara z=-9 angle=0 relative=true]
[wait time=200]

; キャラ手振り
[startanime time=2000 script=tefuri]
[waitaction script=tefuri]

[startanime time=4000 script=tere]
[balloon time=6000]
[talk talk_key = "quest_relax_end_plant_1_1" index=2]
[wait time=6000]
[endballoon]
[waitaction script=tere]

[startanime time=6000 script=event_relax_bed]
[balloon time=6000]
[talk talk_key = "quest_relax_end_plant_1_2" index=2]
[wait time=6000]
[endballoon]
[waitaction script=event_relax_bed]