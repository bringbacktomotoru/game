;
;----------- 初期登場 -------------
[playbgm bgm="BGM04"]
[changeroom id=5]

;使用する家具

;本棚
;[popfurniture id=5405 x=-0.5 y=0 z=-2 angle=180]
;ラグ
[popfurniture id=1713 x=0 y=0 z=0 angle=0]
;テーブル
[popfurniture id=100003 x=-4.5 y=0 z=-5 angle=180]
;椅子
[popfurniture id=5701  x=-5.5 y=0 z=-6 angle=180]
[popfurniture id=5701  x=-3.5 y=0 z=-6 angle=180]
;電話
[popfurniture id=14602   x=2 y=0 z=-9.5 angle=180]

[focusdoor]

; 位置確認用カメラ----------------------
;[movecamera type=1 x=2 y=55 z=-9 time=0]
;[rotatecamera pitch=90]
;------------------------------------

;キャラ出現 初期カメラの表示範囲外に
[popchara costume=111101 x=2.5 z=-8 angle=70 relative=true]
;シナモン
[popchara costume=1104102 x=-3.5 z=-10 angle=210 relative=true]
;メロディ
[popchara costume=904002 x=0 z=-8.5 angle=215 relative=true]

;カメラ初期位置
[movecamera type=0 x=0.5 y=3 z=12 time=0]
[rotatecamera pitch=5 head=190 time=0]

; キャラアクション
[startanime name=purin time=0 script=lag_neteru_set script_args={["meisou",1]}]
[waitaction name=purin script=lag_neru_set]

[startscene]

[startanime name=mymelo time=2000 script=loupe_start_set script_args={["def","def"]}]

[wait time=500]

; カメラワーク指定----------------------
;ラグの上にプリンがねている
;それをシナモン、メロディが見ている
;------------------------------------

; マイメロアクション
[startanime name=cinnamon time=2000 script=kubikashige script_args={[3,"sad"]}]
[startanime name=mymelo time=2000 script=loupe_sagasu_set script_args={[5,"sagasu_loupe"]}]
[voice name=mymelo voice_key="e26"]
[balloon name=mymelo time=3000]
ふむふむ…
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

[startanime name=mymelo time=2000 script=stand_end2 script_args={["def"]}]
[wait time=500]

; シナモンアクション
[startanime name=cinnamon time=2000 script=tefuri_set2 script_args={[3,"yaba","yaba"]}]
[balloon name=cinnamon time=3000 type=1]
メロディちゃん/n
プリンくんのことだけど…
[wait time=1000]
[startanime name=mymelo time=2000 script=uun2_set script_args={[3,"meisou"]}]
[wait time=2000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri_set2]

; マイメロアクション
[startanime name=cinnamon time=2000 script=stand_end2 script_args={["sad2"]}]
[startanime name=mymelo time=2000 script=cos_udekumi]
[balloon name=mymelo time=3000]
プリンくんは、げんかんから/n
テーブルにむかうときに/n
おそわれたようね#e1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

[movecamera type=0 x=-3.5 y=2.3 z=5 time=0]

; シナモンアクション
[startanime name=cinnamon time=2000 script=tabetai_set script_args={[3,"ita","ita"]}]
[balloonoffset x=1.3 y=-0.8]
[balloon name=cinnamon time=3500 type=1]
メロディちゃんってば#e1#
[wait time=1500]
[startanime name=mymelo time=2000 script=stand_end2 script_args={["biku"]}]
[wait time=1000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri_set2]

[startanime name=cinnamon time=2000 script=stand_end2 script_args={["sad"]}]

;演出-------------
;メロディがシナモンの方向を向く
;そのときにテーブルがメロディの視界に入るイメージ
;---------------------

[movecamera type=0 x=-1 y=3 z=10 time=0]

;マイメロ方向転換	
[turnchara name=mymelo script=walk_face angle=50 script_args={["kyomi"]} time=300]
[wait time=300]

; マイメロアクション
[startanime name=mymelo time=2000 script=uun2_set script_args={[3,"kyomi"]}]
[balloonoffset]
[voice name=mymelo voice_key="e16"]
[balloon name=mymelo time=3000]
なあに#q1#/n
なにかみつけたの#q1#
[wait time=3000]
[endballoon name=mymelo]

