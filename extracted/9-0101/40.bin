[focusdoor]

; カメラ初期位置
[movecamera type=0 z=15 y=3 x=0.5 time=0]
[rotatecamera pitch=3 head=180]

;キャラ出現 家具が見える範囲だと見栄えが良いかも
;キティ
[popchara costume=1308001 x=3 z=-7 angle=180 relative=true]
;メロディ
[popchara costume=1308002 x=5.5 z=-7 angle=160 relative=true]
;プリン
[popchara costume=1306101 x=0.5 z=-7 angle=200 relative=true]

