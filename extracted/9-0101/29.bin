;
;----------- 初期登場 -------------
[playbgm bgm="BGM05"]
[changeroom id=2]

[focusdoor]
	
;カメラ初期位置
[movecamera type=0 x=-2.5 y=2.3 z=15 time=0]
[rotatecamera pitch=0 head=180 time=0]

;キャラ出現 予め部屋の中にいたような位置
[popchara costume=108002 x=-0.5 z=-12 angle=180 relative=true]
[startscene]

; キャラアクション
[startanime name=mymelo time=2000 script=tefuri_set2 script_args={[3,"warau","warau"]}]
[waitaction name=mymelo script=teage]

[wait time=1000]

;カメラ前進
[movecamera type=1 x=0 y=0 z=-7 time=2500]

;キャラ前進
[movechara name=mymelo type=1 z=3 script=movie_dash neutral=stand time=2000]
[wait time=2000]
[waitaction name=mymelo script=skip_smile]
[wait time=500]
[startanime name=mymelo time=2000 script=tefuri]
[voice name=mymelo voice_key="e4"]
[balloon name=mymelo time=3000]
こんにちは#h1#/n
#playername
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

[startanime name=mymelo time=2000 script=pyonpyon_set script_args={[3,"smile","warau"]}]
[balloon name=mymelo time=3000]
きてくれて/n
ありがとう#h1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=pyonpyon_set]

[startanime name=mymelo time=2000 script=kurukuru_set script_args={[2,"tere","tere"]}]
[voice name=mymelo voice_key="e13_1"]
[balloon name=mymelo time=4000]
メロディも おへやの/n
かんりにんさんになったの#h1#/n
とってもうれしい#e1#
[wait time=4000]
[endballoon name=mymelo]
[waitaction name=mymelo script=kurukuru_set]

[startanime name=mymelo time=2000 script=cos_bishi]
[voice name=mymelo voice_key="e8"]
[balloon name=mymelo time=4000]
#playernameが/n
はじめての/n
おきゃくさまよ#h1#
[wait time=4000]
[endballoon name=mymelo]
[waitaction name=mymelo script=cos_bishi]

[startanime name=mymelo time=2000 script=stand_end2 script_args={["def"]}]
[wait time=500]

[startanime name=mymelo time=2000 script=hatena2_set script_args={[5,"tere"]}]
[balloon name=mymelo time=3500]
メロディ/n
おひめさまみたいな/n
おへやで
[wait time=3500]
[endballoon name=mymelo]

[balloon name=mymelo time=4000]
たくさんの/n
おきゃくさんを/n
おもてなしするの#h1#
[wait time=4000]
[endballoon name=mymelo]
[waitaction name=mymelo script=hatena2_set]

;カメラを動かしてなにもない部屋を映す

;----------- 部屋を見渡す -------------
[rotatecamera type=1 head=15 time=2500]
[wait time=2500]
[rotatecamera type=1 head=-30 time=3500]
[wait time=3500]
[rotatecamera type=1 head=15 time=2500]
[wait time=2500]

[startanime name=mymelo time=2000 script=yokoyure_set2 script_args={[6,"smile"]}]
[waitaction name=mymelo script=yokoyure_set2]

[startanime name=mymelo time=2000 script=stand_end2 script_args={["def"]}]
[balloon name=mymelo time=2000]
#q1#
[wait time=2000]
[endballoon name=mymelo]


[startanime name=mymelo time=2000 script=kubikashige script_args={[2,"sad"]}]
[voice name=mymelo voice_key="e16"]
[balloon name=mymelo time=2500]
なぁに#q1#
[wait time=2500]
[endballoon name=mymelo]
[waitaction name=mymelo script=kubikashige]

[startanime name=mymelo time=2000 script=mitsuketa_set script_args={["biku","meisou"]}]
[voice name=mymelo voice_key="e25"]
[balloon name=mymelo time=3500]
・・・え#eq#/n
このままじゃ/n
おもてなし できないの#q1#
[wait time=3500]
[endballoon name=mymelo]
[waitaction name=mymelo script=mitsuketa_set]

[startanime name=mymelo time=2000 script=yokopatapata_set script_args={["yaba","yaba",3]}]
[balloon name=mymelo time=4000]
たいへん#e1#/n
ほかの おともだちも/n
よんじゃった#e1#
[wait time=4000]
[endballoon name=mymelo]
[waitaction name=mymelo script=yokopatapata_set]

[startanime name=mymelo time=2000 script=tere_2 script_args={["sad2","sad2",4]}]
[voice name=mymelo voice_key="e21"]
