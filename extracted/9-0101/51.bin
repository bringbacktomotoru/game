;
;----------- 初期登場 -------------

;カメラ初期位置
[movecamera type=0 x=-2.5 y=2.3 z=7 time=0]
[rotatecamera pitch=0 head=130 time=0]

;オレンジカントリーチェア
[popfurniture fname=chair1 id=8401 x=-12 y=2 z=-2 angle=130 relative=true]

;キャラ出現
[popchara name=kitty x=-17.5 y=2 z=-4 angle=0 relative=true]
[wait time=200]

;右に70度首振り
[rotatecamera type=1 pitch=0 head=50 time=8000]
[wait time=7500]

;キャラがカメラに気がつく
[startanime name=kitty script=uun_set time=700]
[waitaction name=kitty script=uun_set]
[wait time=700]

;キャラが振り返る
[turnchara name=kitty script=turn_r angle=180  time=1000]
[waitaction name=kitty script=turn_r]

;キャラがカメラに近づく
[movechara name=kitty type=1 z=0.5 script=movie_walk neutral=stand time=1000]
[wait time=1000]

;キャラ手振り
[startanime name=kitty script=tefuri time=2000]
[voice name=kitty voice_key="e4"]
[balloon name=kitty time=3000]
あら#e1# こんにちは#e1#
[wait time=3000]
[endballoon name=kitty]

[startanime name=kitty script=kubikashige script_args={[2,"meisou","meisou"]} time=4000]
[balloon name=kitty time=4000]
ひょっとして/n
ダニエルが言ってたのは/n
あなたのことかしら#q1#
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=kubikashige]

[startanime name=kitty script=pyonpyon_set script_args={[2,"smile","smile"]} time=4000]
[balloon name=kitty time=4000]
わたしもダニエルに/n
管理人さんを頼まれたの
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=pyonpyon]

[startanime name=kitty script=tefuri time=2000]
[voice name=kitty voice_key="e2"]
[balloon name=kitty time=3000]
はじめまして#e1#/nわたし、キティ#o1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=tefuri]

[startanime name=kitty script=uun_set time=3000]
[balloon name=kitty time=3000]
あなたのお名前は#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=uun_set]

[popdialog target="InputPlayerInfo"]

[startanime name=kitty script=tabetai_set script_args={[3,"kirasmile","kirasmile"]} time=4000]
[voice name=kitty voice_key="e9"]
[balloon name=kitty time=4000]
#playernameっていうのね#e1#/n
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=tabetai_set]

[startanime name=kitty script=teage script_args={["smile","smile"]} time=3000]
[balloon name=kitty time=3000]
おともだちになりましょ#e1#/n
これからよろしくね#e1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=teage]

[startanime name=kitty script=gakkari_set script_args={[1,"meisou","meisou"]} time=2000]
[voice name=kitty voice_key="e24"]
[balloon name=kitty time=4000]
ここまで歩いてきたから/n
[wait time=2000]
[startanime name=kitty script=hatena_set time=2000]
ちょっぴり疲れちゃったわ
[wait time=2000]
[endballoon name=kitty]
[waitaction name=kitty script=uun_unaduki_set]

[startanime name=kitty script=yokopatapata time=4000]
[balloon name=kitty time=4000]
椅子に座って/nゆっくりしましょ#h2#
[wait time=4000]
[endballoon name=kitty]
[waitaction name=kitty script=yokopatapata]