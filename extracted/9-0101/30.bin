[voice name=mymelo voice_key="e22"]
[balloon name=mymelo time=3000]
じつは…
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=gakkari_set_2]
[fadeoutbgm spd=12]

