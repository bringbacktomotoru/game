;
;----------- 初期登場 -------------
[playbgm bgm="BGM05"]


[changeroom id=2]

;使用する家具

;ピンクプリンセスドレッサー
;[popfurniture fname=bed2 id=10202 x=-3.5 y=0 z=-2.5 angle=180]
;ピンクプリンセスチェア
;[popfurniture fname=chair1 id=10201 x=5 y=0 z=1.5 angle=0]
;ピンクプリンセスチェア
[popfurniture fname=chair2 id=10201 x=6.5 y=0 z=-3.5 angle=140]
;ももいろハイキングテーブル（仮）
[popfurniture fname=table1 id=12602 x=5 y=0 z=-1.5 angle=0]
;キューティープリンセストルソー
;[popfurniture fname=book1 id=6005 x=-0.5 y=0 z=-3.5 angle=145]
;チェリードールハウススタンドランプ
[popfurniture fname=rug1 id=14205 x=3.5 y=0 z=-4 angle=120]


[focusdoor]

; カメラ初期位置
[movecamera type=1 x=5 y=2.5 z=-15 time=0]
[rotatecamera pitch=0]

; マイメロ出現　家具のある位置に
[popchara costume=108002 x=5 z=-6 angle=-20 relative=true]
[popchara costume=109001 x=0 z=-1 angle=0 relative=true]

[startscene]

[startanime name=mymelo time=700 script=gakkari_set_2 script_args={[3,"sad3","sad3"]}]
[waitaction name=mymelo script=gakkari_set_2]

; キティ出現　ドアの前に
[startanime name=kitty time=700 script=bookshelf_mitsuketa script_args={[3,"smile","smile"]}]
[waitaction name=kitty script=bookshelf_mitsuketa]
[wait time=700]

[movecamera type=1 x=-5 y=0 z=0 time=2500]

; キャラ前に向かって移動
[movechara name=kitty type=1 z=-2 script=skip_smile neutral=stand time=1300]
[wait time=2000]

[turnchara name=kitty script=walk_face angle=-30 time=500 script_args={["smile"]}]
[wait time=500]


; キティアクション
[startanime name=kitty time=2000 script=tefuri_set2 script_args={[3,"smile","smile"]}]
[balloon name=kitty time=3000]
[voice name=kitty voice_key="e4"]
こんにちは#o1#/n
メロディ#e1#
[wait time=3000]
[endballoon name=kitty]

; キティアクション
[startanime name=kitty time=2000 script=kubikashige script_args={[3,"sad"]}]
[balloon name=kitty time=3000]
…あら#q1#/n
こげくさい#q1#
[wait time=3000]
[endballoon name=kitty]

；カメラマイメロをフォーカス
[movecamera type=1 x=3 y=0 z=0 time=2000]
[wait time=1500]

; マイメロアクション
[startanime name=mymelo time=2000 script=gakkari_set_2 script_args={[3,"sad3"]}]
[balloonoffset x=-0.5]
[balloon name=mymelo time=3000 type=1]
[voice name=mymelo voice_key="e19"]
ぐすん…
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=gakkari_set_2]

；カメラキティに戻す
[movecamera type=1 x=-3 y=0 z=0 time=300]
[wait time=300]

; キティアクション
[startanime name=kitty time=2000 script=mitsuketa_set script_args={["biku","def"]}]
[balloonoffset]
[balloon name=kitty time=3000]
メロディ#eq#
[turnchara name=mymelo script=turn_r angle=100 time=0]
[wait time=3000]
[endballoon name=kitty]

；キティがマイメロに駆け寄る
[startanime name=mymelo time=1000 script=cookie_burn_tray script_args={[3,"sad3","sad3"]}]
[movechara name=kitty type=1 x=20 z=-2 script=dash_face script_args={["biku"]} neutral=stand time=2000]
[wait time=2500]


；カメラをキティに追従させてマイメロとキティを中心に収める
[movecamera type=1 x=-4.7 y=-0.3 z=6.2 time=2000]
[rotatecamera type=1 head=64.5 time=2000]
[wait time=1500]


[turnchara name=kitty script=walk_face script_args={["biku"]} angle=20 time=500]
[wait time=500]

; キティアクション
[startanime name=kitty time=2000 script=uun2_set script_args={[3,"biku"]}]
[balloon name=kitty time=3000]
[voice name=kitty voice_key="e70_2"]
どうしたの#q1#
[wait time=3000]
[endballoon name=kitty]

;メロディフォーカス
[movecamera type=1 x=3 y=-0.3 z=0.5 time=0]

[charavisible name=kitty visible=false]
[startanime name=mymelo time=2000 script=cookie_burn_tray script_args={[3,"beso","beso"]}]
[balloonoffset x=-3.0]
[balloon name=mymelo time=3000 type=1]
え～ん#e1#/n
クッキーこがしちゃった
[wait time=3000]
[endballoon name=mymelo]
[charavisible name=kitty visible=true]

;　二人フォーカス
[movecamera type=1 x=-3 y=0.3 z=-0.5 time=0]

; キティアクション
[startanime name=kitty time=2000 script=kubikashige script_args={[3,"sad"]}]
[balloonoffset]
[balloon name=kitty time=3000]
何があったの#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=kubikashige]

; マイメロアクション
