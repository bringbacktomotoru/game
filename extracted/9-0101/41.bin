;
;----------- 初期登場 -------------
[playbgm bgm="BGM05"]
[changeroom id=5]

[focusdoor]

;ラグ
[popfurniture  id=1713 x=0 y=0 z=0 angle=0]
;テーブル
[popfurniture id=100003 x=4.5 y=0 z=-4 angle=180]

;カメラ初期位置
[movecamera type=0 x=-3 y=3 z=-5 time=0]
[rotatecamera pitch=5 head=0 time=0]

;キャラ出現 初期カメラの表示範囲外に
[popchara costume=111101 x=2.5 z=-8 angle=70 relative=true]
[popchara costume=101102 x=-1 z=-1 angle=200 relative=true]

[startscene]

; キャラアクション
[startanime name=purin time=0 script=lag_neteru_set script_args={["meisou",1]}]
[waitaction name=purin script=lag_neru_set]

;シナモン方向転換と移動
[turnchara name=cinnamon script=walk_face angle=0 script_args={["def"]} time=800]
[wait time=800]
[movechara name=cinnamon type=1 z=-5  script=movie_walk neutral=stand time=1300]
[wait time=1500]

;カメラ変更
[movecamera type=0 x=-1.5 y=3.5 z=20 time=0]
[rotatecamera pitch=3 head=180 time=0]

[wait time=1000]

; 指定---------------------
;ラグの上にプリンがねている
;それをシナモンが見つける
;シナモンの初期ポップ位置はドア側
;プリンの方に移動させながらカメラで追って、プリンの倒れている位置からドア側の方でストップ
;-----------------------------------	

; シナモンアクション
[startanime name=cinnamon time=2000 script=mitsuketa_set script_args={["bikkuri","sad"]}]
[voice name=cinnamon voice_key="e17"]
[balloon name=cinnamon time=3000]
わっ#eq#/n
プ、プリンくんが/n
倒れてる#eq#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=mitsuketa_set]

;カメラ
[movecamera type=1 x=0 y=-1 z=-6.5 time=2000]

;シナモン移動
[movechara name=cinnamon type=1 z=-10  script=movie_dash neutral=stand time=1500]
[wait time=1500]

[turnchara name=cinnamon angle=340 time=300 script=turn_r]
[wait time=300]

; 指定---------------------
;このあとの展開のため位置取り
;シナモンをプリンの顔が見えるような位置
;サンプルでポップしていたあたりに移動
;↑後に少し移動させたいので少しだけプリンから離れた位置に
;-----------------------------------	

; シナモンアクション
[startanime name=cinnamon time=2000 script=bookshelf_nozoku_set script_args={[3,"sad"]}]
[voice name=cinnamon voice_key="e16"]
[balloonoffset x=0 y=-0.5]
[balloon name=cinnamon time=2000]
どうしたの#q1#
[wait time=2000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri_set2]
[balloonoffset x=0 y=0]

;シナモン移動
[turnchara name=cinnamon script=walk_face angle=-35 script_args={["sad"]} time=300]
[movechara name=cinnamon type=1 x=1 z=-10  script=movie_dash neutral=stand time=2500]
[wait time=2500]
[turnchara name=cinnamon script=walk_face angle=-130 script_args={["sad"]} time=500]
[wait time=500]

; シナモンアクション
[startanime name=cinnamon time=1000 script=stand_end2 script_args={["biku"]}]
[wait time=1000]
[waitaction name=cinnamon script=tefuri_set2]	

; シナモンアクション
[startanime name=cinnamon time=2000 script=uun2_set script_args={[3,"kyomi"]}]
[voice name=cinnamon voice_key="e24"]
[balloon name=cinnamon time=3000]
あ、プリンくんってば/n
こんなところで…
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=uun2_set]

[movecamera type=0 x=-3.5 y=3 z=-3 time=0]
[rotatecamera pitch=5 head=0 time=0]

;マイメロ出現
[popchara costume=108002 x=-1 z=-1 angle=200 relative=true]
[turnchara name=mymelo script=walk_face angle=0 script_args={["def"]} time=800]
[wait time=800]
[movecamera type=0 x=-3.4 y=2.7 z=0 time=0]
[startanime name=mymelo time=2000 script=mitsuketa_set script_args={["bikkuri","sad"]}]
[waitaction name=mymelo script=mitsuketa_set]
[wait time=300]

;シナモン移動
[movechara name=cinnamon type=1  x=1 z=0.5  script=movie_dash neutral=stand time=200]
[wait time=200]

[movecamera type=0 x=-1.8 y=2.7 z=14 time=0]
[rotatecamera pitch=3 head=180 time=0]
;演出---------------
;シナモンがプリンに寄ろうとする
;ほんの数歩分プリンの方向に移動させる、サンプルのポップ位置くらい
;同時にマイメロが駆け寄ってくる
;シナモンが止まる
;--------------------------
	
[startanime name=cinnamon time=2000 script=mitsuketa_set script_args={["biku","sad"]}]

; マイメロアクション
[charavisible name=mymelo visible=false]
[startanime name=mymelo time=2000 script=sentence_ketsui2
  script_args={[{loop_num = 3, face=["kiri"]}]}]
[voice name=mymelo voice_key="e17"]
[balloon name=mymelo time=2000 type=1]
だめっ#e1#
[wait time=2000]

[endballoon name=mymelo]
[waitaction name=mymelo script=sentence_ketsui2]

[popchara costume=108002 x=-4 z=-4.5 angle=-20 relative=true]
[movechara name=mymelo type=0 x=6 z=-6.5 script=movie_dash neutral=stand time=2500]
[wait time=2500]
[turnchara name=mymelo script=walk_face angle=-140 script_args={["kiri"]} time=300]
[wait time=300]

; マイメロアクション
[startanime name=mymelo time=2000 script=clock_yubisashi_set script_args={[5,"meisou"]}]
[voice name=mymelo voice_key="e24"]
[balloon name=mymelo time=3000]
げんばをあらさないのが/n
そうさのてっそくよ#e1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

;シナモン方向転換
[turnchara name=cinnamon script=walk_face angle=180 script_args={["biku"]} time=300]
[wait time=300]

; シナモンアクション
[startanime name=cinnamon time=2000 script=uun2_set script_args={[3,"sad2"]}]
[balloon name=cinnamon time=3000]
め、メロディちゃん#q1#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri_set2]	
[fadeoutbgm spd=12]
; マイメロアクション
[startanime name=mymelo time=2000 script=munehari script_args={["kiri2",3]}]
[balloon name=mymelo time=3000]
シナモンくん/n
メロディ、じゃないわ
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

;演出---------------
;勢いよくアップするイメージでカメラをメロディにフォーカス
;0秒切り替えでもいいかも
;--------------------------


;カメラ変更
[movecamera type=0 x=2 y=2.3 z=7 time=300]
[rotatecamera pitch=3 head=225 time=300]
;シナモン消失
[charavisible name=cinnamon visible=false]
[wait time=500]
[playbgm bgm="BGM04"]
; マイメロアクション
[startanime name=mymelo time=2000 script=cos_udekumi]
[balloonoffset x=1.5 y=-0.5]
[voice name=mymelo voice_key="e8"]
[balloon name=mymelo time=3000 type=1]
めいたんていメロディよ#e1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

;演出---------------
;勢いよくにアップするイメージでカメラをシナモンにフォーカス
;0秒切り替えでもいいかも
;--------------------------

;カメラ変更
;シナモン出現
[charavisible name=cinnamon visible=true]
;プリン消失
[charavisible name=purin visible=false]
[movecamera type=0 x=-2.4 y=2.1 z=7 time=0]
[rotatecamera pitch=3 head=180 time=0]
[balloonoffset]
; シナモンアクション
[startanime name=cinnamon time=2000 script=mitsuketa_set script_args={["biku","sad"]}]
[balloonoffset x=0 y=-0.5]
[balloon name=cinnamon time=3000]
名探偵メロディ#eq#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri_set2]

;演出---------------
;メロディとシナモン二人にフォーカス
;プリンは写っていなくても大丈夫
;--------------------------

;カメラ
;シナモン出現
[charavisible name=purin visible=true]
[movecamera type=0 x=-1.8 y=2.7 z=14 time=0]
[rotatecamera pitch=3 head=180 time=0]
	
; マイメロアクション
[startanime name=mymelo time=2000 script=bou_unaduku_face script_args={[2,"meisou"]}]
[balloonoffset]
[voice name=mymelo voice_key="e9"]
[balloon name=mymelo time=3000]
だいじょうぶよ#e1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri]

