;
;----------- 初期登場 -------------
[playbgm bgm="BGM02"]
[changeroom id=4]

;使用する家具

;ピンクカフェプラント
[popfurniture fname=plant id=10806 x=-2.5 y=0 z=-6 angle=-0]
;ピンクドットラグ
[popfurniture fname=rug id=1711 x=0.5 y=0 z=-1.5 angle=0]
;ピンクカフェテーブル
[popfurniture fname=table id=100001 x=0.5 y=0 z=-1.5 angle=180]
;フラワリーアンティークチェア
[popfurniture fname=chair1 id=9001 x=1.5 y=0 z=-4.5 angle=180]
;フラワリーアンティークチェア
[popfurniture fname=chair2 id=9001 x=-0.5 y=0 z=-4.5 angle=180]
;フラワリーアンティークチェア
[popfurniture fname=chair3 id=9001 x=3.5 y=0 z=-2.5 angle=90]

[focusdoor]

; カメラ初期位置 キティのかおオップ
[movecamera type=0 x=0.5 y=2 z=8 time=0]
[rotatecamera pitch=0 head=180]

;キャラ出現 初期カメラの表示範囲外に
[popchara costume=109001 x=3 z=-7 angle=180 relative=true]

[startscene]

; キャラアクション
[startanime name=kitty time=2000 script=stand_end2 script_args={["def"]}]
[waitaction name=kitty script=teage]

[wait time=200]

[startanime name=kitty time=2000 script=uun2_set script_args={[3,"meisou"]}]]
[balloon name=kitty time=3000]
For the first thing...
[wait time=2000]

[playse se="ui/doorchime.wav"]
[wait time=1000]

[startanime name=kitty time=2000 script=mitsuketa_set script_args={["kirasmile","def"]}]

[wait time=2000]

[endballoon name=kitty]
[waitaction name=kitty script=uun2_set]

;場面転換
[shutterstart]
[wait time=100]

[popchara type=0 costume=109001 x=0.5 z=-4.5 angle=60 relative=true]
[popchara type=0 costume=108002 x=0 z=-2 angle=40 relative=true]
[popchara type=0 costume=111101 x=-2.5 z=-2 angle=20 relative=true]

[movecamera type=0 x=-10 y=2.3 z=-4.5 time=0]
[rotatecamera pitch=0 head=35]

[wait time=1500]	
	
;場面転換終了
[shutterend]

[startanime name=cinnamon time=2000 script=stand_end2 script_args={["def"]}]

;キャラアクション
[startanime name=mymelo time=2000 script=tefuri_set2 script_args={[3,"warau","warau"]}]
[voice name=mymelo voice_key="e4"]
[balloon name=mymelo time=3000]
Hello#e1#/n
#playername#o1#
[startanime name=kitty time=2000 script=stand_end2 script_args={["smile"]}]
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tefuri_set2]

[startanime name=purin time=2000 script=tefuri_set2 script_args={[3,"kya","kya"]}]
[voice name=purin voice_key="e4"]
[balloon name=purin time=3000]
Hi, Kitty#e1#/n
We're here to play.
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=tefuri_set2]

[turnchara name=mymelo script=walk_face angle=30 script_args={["smile"]} time=300]
[wait time=300]
[startanime name=mymelo time=2000 script=tabetai_set script_args={[3,"kirasmile","kirasmile"]}]
[balloon name=mymelo time=3000]
Thanks for inviting/n
us over today, Kitty./n
Let's have some fun#e1#
[startanime name=purin time=2000 script=stand_end2 script_args={["smile"]}]
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=tabetai_set]

[startanime name=kitty time=2000 script=pyonpyon_set script_args={[3,"smile2","smile2"]}]
[voice name=kitty voice_key="e7"]
[balloon name=kitty time=3000]
Thanks for coming#e1#
[startanime name=mymelo time=2000 script=stand_end2 script_args={["smile"]}]
[wait time=2500]

[startanime name=purin time=2000 script=mitsuketa_set script_args={["biku","def"]}]
[wait time=2000]
[endballoon name=kitty]
[waitaction name=kitty script=pyonpyon_set]

[startanime name=purin time=2000 script=sentence_hatena2 script_args={[{loop_num = 3, face=["kya"]}]}]
[voice name=purin voice_key="e40_1"]
[balloon name=purin time=3000]
...Hmmm#e2#/n
What a delicious smell#e1#
[wait time=3000]
[endballoon name=purin]

[turnchara name=mymelo script=walk_face angle=40 script_args={["smile"]} time=300]
[wait time=300]
[startanime name=mymelo time=2000 script=sentence_clock_nayamu
 script_args={[{loop_num = 5, face=[ "meisou_cheek"]}]}]
[voice name=mymelo voice_key="e9"]
[balloon name=mymelo time=3000]
You're right#e1#/n
It smells lovely#e1#
[wait time=3000]
[endballoon name=mymelo]

[startanime name=kitty time=2000 script=kubikashige script_args={[3,"smile"]}]
[balloon name=kitty time=3000]
The first thing/n
I'd like to do is...
[wait time=3000]

;キティ テーブルに向かって移動
[turnchara name=kitty script=walk_face angle=40 script_args={["smile"]} time=300]
[wait time=300]
[movechara name=kitty type=1 z=-5 x=-5 script=movie_dash neutral=stand time=1300]
[wait time=1300]

[endballoon name=kitty]
[waitaction name=kitty script=kubikashige]

;マイメロ プリンを非表示
[charavisible name=mymelo visible=false]
[charavisible name=purin visible=false]

[movecamera type=0 x=-5.5 y=2.3 z=13.5 time=0]
[rotatecamera pitch=0 head=160]

[turnchara name=kitty script=walk_face angle=180 script_args={["smile"]} time=300]
[wait time=300]

[startanime name=kitty time=2000 script=sentence_ketsui2 script_args={[{loop_num = 3, face=["tere"]}]}]
[balloon name=kitty time=3000]
a tea party with my friends#e1#
[startanime name=mymelo time=2000 script=stand_end2 script_args={["smile"]}]
[startanime name=purin time=2000 script=stand_end2 script_args={["smile"]}]
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=sentence_ketsui2]

[startanime name=kitty time=2000 script=sentence_kurukuru
 script_args={[{loop_num = 3, face=["kya", "kya"]}]}]
[voice name=kitty voice_key="e8"]
[balloon name=kitty time=3000]
I had #playername help me/n
with the preparations#e1#
[wait time=2000]
[startanime name=mymelo time=2000 script=kubikashige script_args={[3,"kyomi"]}]
[startanime name=purin time=2000 script=mitsuketa_set script_args={["kirasmile","biku"]}]
[wait time=2000]
[endballoon name=kitty]
[waitaction name=kitty script=sentence_kurukuru]

[startanime name=kitty time=2000 script=cos_okuhe]
[balloon name=kitty time=3000]
I hope they/n
match your tastes#e1#/n
Please, have a seat#e1#
[wait time=2000]
[startanime name=mymelo time=2000 script=tabetai_set script_args={[3,"kirasmile","kirasmile"]}]
[startanime name=purin time=2000 script=sentence_hyahho script_args={[{face=["tehepero", "tehepero"],loop_num = 3}]}]
[wait time=2000]
[endballoon name=kitty]
[waitaction name=kitty script=cos_okuhe]

;場面転換
[shutterstart]
[wait time=100]

;マイメロ プリンを表示
[charavisible name=mymelo visible=true]
[charavisible name=purin visible=true]

;カメラ テーブル前を写す
[movecamera type=0 x=1.5 y=2.3 z=10 time=0]
[rotatecamera pitch=0 head=180]

;キティ 机の脇に立つ
[popchara costume=109001 x=6 z=-9 angle=160 relative=true]
[startanime name=kitty time=2000 script=applepie_tray script_args={[3,"def","blink"]}]

;メロディとプリン椅子に座る
[usefurniture name=mymelo fname=chair1 bone=chara1 script=event_start script_args={{face="def", num=3}}]
[usefurniture name=purin fname=chair2 bone=chara1 script=event_start script_args={{face="def", num=3}}]

[wait time=1500]	
	
;場面転換終了
[shutterend]

[balloonoffset x=0 y=0.5]

;キャラアクション
[startanime name=purin time=2000 script=chair_tefuri_set script_args={[3,"warau"]}]
[voice name=purin voice_key="e13_1"]
[balloon name=purin time=2000]
Whoopee#e2#
[wait time=2000]
[endballoon name=purin]
[waitaction name=purin script=chair_tefuri_set]

[startanime name=purin time=2000 script=chair_sit_set script_args={[3,"smile"]}]

[startanime name=mymelo time=2000 script=chair_tere_2 script_args={[3,"meisou_cheek"]}]
[voice name=mymelo voice_key="e14"]
[balloon name=mymelo time=3000]
It's all so lovely#h1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=chair_tere_2]
[startanime name=mymelo time=2000 script=chair_sit_set script_args={[3,"smile"]}]

[balloonoffset x=0 y=0]

[startanime name=kitty time=2000 script=applepie_tray script_args={[3,"smile","smile"]}]
[balloon name=kitty time=3000]
The Apple Pie's/n
fresh out of the oven#e1#/n
What do you think#q1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=applepie_tray]

;分岐
[diarybranch]
[wait time=2000];
[s]

*branch1

;キャラアクション
[movecamera type=0 x=3.3 y=2 z=6 time=0]
[startanime name=kitty time=2000 script=applepie_tray script_args={[3,"smile2","smile2"]}]
[voice name=kitty voice_key="e7"]
[balloonoffset x=-1.3 y=-0.5]
[balloon name=kitty time=3000 type=2]
Thanks#o1#/n
I asked my mother/n
to teach me her recipe#e1#
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=applepie_tray]

[charavisible name=kitty visible=false]

;カメラ マイメロ プリンをアップに
[balloonoffset y=0.5]
[movecamera type=0 x=0.5 y=2.5 z=7 time=0]

[startanime name=purin time=2000 script=chair_teage_set script_args={[3,"tehepero_cheek"]}]
[voice name=purin voice_key="e22"]

[balloon name=purin time=3000]
Let's eat, let's eat#e1#/n
I can hardly wait#e1#
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=chair_teage_set]

[startanime name=mymelo time=3000 script=chair_kubikashige_set script_args={[3,"kyomi"]}]
[balloon name=mymelo time=3000]
#playername, will/n
you cut it for us#q1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=chair_kubikashige_set]

[startanime name=mymelo time=3000 script=chair_teage_set script_args={[5,"nikawink"]}]
[voice name=mymelo voice_key="e76_1"]
[balloon name=mymelo time=3000]
You can cut Melody's/n
slice a little larger/n
if you'd like.
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=chair_teage_set]

[startanime name=purin time=2000 script=chair_tefuri_set script_args={[15,"bikkuri"]}]
[voice name=purin voice_key="e20"]
[balloon name=purin time=3000]
I don't mind if you make
my slice extra large either#e1#
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=chair_tefuri_set]
[wait time=1000]

[jump target={"*end"}]

*branch2

;キャラアクション
[movecamera type=0 x=3.3 y=2 z=6 time=0]
[startanime name=kitty time=2000 script=applepie_tray script_args={[3,"smile2","smile2"]}]
[voice name=kitty voice_key="e7"]
[balloonoffset x=-1.3 y=-0.5]
[balloon name=kitty time=3000 type=2]
Do you mind#q1#/n
I'll put on some tea/n
while you cut the pie.
[wait time=3000]
[endballoon name=kitty]
[waitaction name=kitty script=applepie_tray]

[charavisible name=kitty visible=false]

;カメラ マイメロ プリンをアップに
[balloonoffset y=0.5]
[movecamera type=0 x=0.5 y=2.5 z=7 time=0]

[startanime name=purin time=2000 script=chair_tefuri_set script_args={[5,"kya"]}]
[voice name=purin voice_key="e13_1"]
[balloon name=purin time=3000]
Extra large#e1#/n
Remember to make/n
mine extra large#e1#
[wait time=3000]
[endballoon name=purin]
[startanime name=purin time=2000 script=chair_sit_set script_args={[3,"smile"]}]

[startanime name=mymelo time=3000 script=chair_kubikashige_set script_args={[5,"warau"]}]
[voice name=mymelo voice_key="e76_1"]
[balloon name=mymelo time=3000]
Heehee, Purin's/n
such a glutton#e1#
[wait time=3000]
[endballoon name=mymelo]
[waitaction name=mymelo script=chair_kubikashige_set]

[startanime name=purin time=2000 script=chair_tere_2 script_args={[5,"tere"]}]
[balloon name=purin time=3000]
I can't help it,/n
I'm a growing boy./n
I could even go for seconds#e1#
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=chair_tere_2]
[startanime name=mymelo time=2000 script=chair_sit_set script_args={[3,"smile"]}]
[wait time=1000]

[jump target={"*end"}]
*end
[fadeoutbgm spd=12]
