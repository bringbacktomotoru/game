;
;----------- 初期登場 -------------
[playbgm bgm="BGM01"]
[changeroom id=1]
; 位置確認用カメラ----------------------
;[movecamera type=1 x=0 y=50 z=0 time=0]
;[rotatecamera pitch=90]
;------------------------------------
		
;ロッキングチェア
[popfurniture fname=chair1 id=803 x=-9 y=2 z=2 angle=30 relative=true]
;プラント
[popfurniture fname=plant1 id=7006 x=-7.5 y=2 z=4 angle=30 relative=true]
;ストーブ
[popfurniture fname=stove1 id=5407 x=-10 y=2 z=4.5 angle=0 relative=true]
;本棚
[popfurniture fname=book1 id=7105 x=-12.5 y=2 z=3.5 angle=-30 relative=true]
;ラグ
[popfurniture fname=rug1 id=1701 x=-10 y=2 z=2.5 angle=0 relative=true]
;カメラ初期位置
[movecamera type=0 x=5 y=3 z=-15 time=0]
[rotatecamera pitch=5 head=0 time=0]
;キャラ出現
[popchara costume=109001 x=-10 y=2 z=1 angle=0 relative=true]
;キティ座る
[usefurniture name=kitty fname=chair1 bone=chara1 script=event_start2
 script_args={{face="meisou", num=3}}]
[wait time=1000]

;カメラ移動
[movecamera type=0 x=5 y=3 z=-10 time=6200]
;キティ足パタパタ
[startanime name=kitty time=2000 script=chair_patapata_set script_args={[3,"smile"]}]
[waitaction name=kitty script=chair_patapata_set]
[wait time=3000]

;キティ日記帳を読む
[startanime name=kitty time=2500 script=rockingchair_event_start]
[waitaction name=kitty script=rockingchair_event_start]
[wait time=2500]
;カメラ移動
[movecamera type=0 x=5 y=5 z=-10 time=4000]
[rotatecamera pitch=0 head=0 time=4000]
[fadeoutbgm spd=12]
[startanime name=kitty time=2000 script=rockingchair_book_patapata script_args={[3,"meisou"]}]
[waitaction name=kitty script=rockingchair_book_patapata]
[wait time=1000]

;----------- ハイライト402 -------------

;場面転換
[shutterstart]
[endusefurniture name=kitty fname=chair1]
[changeroom id=4]
[focusdoor]

[charavisible name=kitty visible=false]
[furniturevisible name=chair1 visible=false]
[furniturevisible name=plant1 visible=false]
[furniturevisible name=stove1 visible=false]
[furniturevisible name=book1 visible=false]
[furniturevisible name=rug1 visible=false]

;ハローキティハッピーリボンピアノ
[popfurniture fname=piano1 id=2001 x=0.5 y=0 z=-2.5 angle=225]
;キティラグ
[popfurniture fname=rug2 id=3901 x=-1 y=0 z=-1 angle=180]
;ピンクアンティークチェア
[popfurniture fname=chair2 id=9001 x=-4 y=0 z=1 angle=270]
;ピンクアンティークチェア
[popfurniture fname=chair3 id=9001 x=-3 y=0 z=-2 angle=225]
;フラワリーアンティーククロック
[popfurniture fname=clock1 id=1504 x=-2 y=0 z=-5 angle=180]

;キティ
[popchara costume=1509001 x=5 z=-7 angle=160 relative=true]
;メロディ
[popchara costume=1512002 x=2 z=-8 angle=180 relative=true]
;プリン
[popchara costume=1512101 x=0 z=-7 angle=200 relative=true]

; カメラ初期位置
[movecamera type=0 x=-5 y=4.1 z=0.5 time=0]
[rotatecamera pitch=14 head=110]

[charavisible name=kitty visible=true]
[charavisible name=mymelo visible=true]
[charavisible name=purin visible=true]

;キティピアノに座る
[usefurniture name=kitty fname=piano1 bone=chara1 script=event_start
 script_args={{face="meisou", num=3}}]

;メロディとプリン椅子に座る
[usefurniture name=mymelo fname=chair2 bone=chara1 script=event_start
 script_args={{face="meisou", num=3}}]
[usefurniture name=purin fname=chair3 bone=chara1 script=event_start
 script_args={{face="meisou", num=3}}]

[movecamera type=1 x=0 y=-0.1 z=0 time=3500]
[wait time=1500]

;キャラアクション
[startanime name=kitty time=2000 script=piano_play_set script_args={[10,"meisou"]}]
[startanime name=mymelo time=2000 script=tv_watching_yure_set script_args={[10,"meisou"]}]
[startanime name=purin time=2000 script=chair_patapata_set script_args={[10,"meisou"]}]

;場面転換終了
[shutterend]

[playbgm bgm="BGM03"]
[wait time=2000]

[movecamera type=0 x=5 y=4.5 z=2 time=0]
[rotatecamera pitch=14 head=254]

[wait time=2500]
[focusdoor]

; 三人をフォーカス
[movecamera type=0 x=-1 y=2.5 z=12 time=0]
[rotatecamera pitch=0 head=181]

[rotatecamera type=1 pitch=0 head=2 time=5000]

[startanime name=kitty time=2000 script=piano_end_set script_args={[2,"meisou","smile2"]}]
[startanime name=mymelo time=2000 script=chair_tere_2 script_args={[3,"meisou_cheek"]}]
[wait time=2000]
[waitaction name=mymelo script=piano_end_set]

[startanime name=purin time=2000 script=rockingchair_kakaeru script_args={[3,"meisou_cheek"]}]
[startanime name=mymelo time=2000 script=chair_patapata_set script_args={[10,"smile"]}]
[wait time=2000]
[waitaction name=purin script=rockingchair_kakaeru]

;キティにフォーカス
[balloonoffset]
[movecamera type=0 x=-5 y=4 z=0.5 time=0]
[rotatecamera pitch=14 head=110]
[wait time=800]
[startanime name=kitty time=2000 script=tv_watching_yure_set script_args={[3,"smile2"]}]
[startanime name=purin time=2000 script=chair_patapata_set script_args={[10,"smile"]}]

[wait time=2000]

[movecamera type=1 x=0 y=1 z=0 time=4000]
[waitaction name=kitty script=tv_watching_yure_set]
[fadeoutbgm spd=12]
[wait time=2000]

