;
;----------- 初期登場 -------------
[playbgm bgm="BGM07"]
[changeroom id=3]

[focusdoor]

; カメラ初期位置
[movecamera type=0 x=-1.5 y=2 z=10 time=0]
[rotatecamera pitch=0 head=180 time=0]

;キャラ出現 予め部屋の中にいたような位置
[popchara costume=101102 x=1 z=-15 angle=180 relative=true]

[startscene]

[wait time=1000]

;演出内容------------------
;部屋に来たプレイヤーを出迎えてくれるようなカメラワーク
;--------------------------


[movechara type=0 name=cinnamon x=0 z=2.5 script=dash_face script_args={["smile"]} neutral=stand time=500]
[movecamera type=1 x=0 y=0 z=-4 time=2000]
[waitaction name=cinnamon script=dash_face]
[wait time=500]

[balloonoffset x=0 y=-0.4]

[startanime name=cinnamon time=2000 script=tefuri_set2 script_args={[3,"warau","warau"]}]
[voice name=cinnamon voice_key="e13_1"]
[balloon name=cinnamon time=3000]
Welcome,/n
#playername#e1#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri_set2]

[startanime name=cinnamon time=2000 script=pyonpyon_set script_args={[3,"smile","warau"]}]
[voice name=cinnamon voice_key="e7"]
[balloon name=cinnamon time=3000]
Thanks for coming/n
to visit my room#e1#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=pyonpyon_set]

[startanime name=cinnamon time=2000 script=sentence_burabura_loop script_args={[{loop_num = 3, face=["def"]}]}]
[balloon name=cinnamon time=3000]
Actually,/n
I was thinking...
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=sentence_burabura_loop]

[startanime name=cinnamon time=2000 script=sentence_munehari
 script_args={[{loop_num = 3, face=["kya"]}]}]
[voice name=cinnamon voice_key="e8"]
[balloon name=cinnamon time=3000]
everyone could work together/n
to open a cafe#o1#
[wait time=3000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=sentence_burabura_loop]

[startanime name=cinnamon time=2000 script=stand_end2 script_args={["def"]}]
[wait time=500]

;演出内容-----------------
;プリン出現
;プレイヤーと話したあとシナモンが寄ってくるようなカメラワーク

;キャラ出現 ドアの前あたり
[popchara costume=111101 x=0 z=-1 angle=0 relative=true]
;-----------------------------	

[balloonoffset x=1.1 y=-1.4]
	
[startanime name=purin time=2000 script=tefuri_set2 script_args={[3,"ohohoho2","ohohoho2"]}]

[voice name=purin voice_key="e4"]
[balloon name=purin time=3000 type=1]
Hello~#e1# Hi Cinnamon,/n
I'm here to help!
[startanime name=cinnamon time=2000 script=sentence_kubikashige script_args={[{loop_num = 3, face=["biku"]}]}]
[wait time=1000]
[turnchara name=cinnamon script=walk_face angle=170 script_args={["biku"]} time=300]
[wait time=300]
[startanime name=cinnamon time=2000 script=sentence_kubikashige script_args={[{loop_num = 3, face=["kirasmile"]}]}]
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=tefuri_set2]
[waitaction name=cinnamon script=sentence_kubikashige]

;カメラをドアとシナモンにフォーカス
[focusdoor]
[movecamera type=1 x=-0.5 y=2 z=-12 time=0]
[rotatecamera pitch=0 head=0]

[balloonoffset x=0 y=-0.3]

[movechara name=purin x=0 z=-0.5 script=walk_face script_args={["smile"]} neutral=stand time=1000]
[wait time=1000]

[startanime name=purin time=2000 script=sentence_kubikashige script_args={[{loop_num = 3, face=["biku"]}]}]
[balloon name=purin time=3000]
Oh#e1# Hi there#e1#/n
So you're/n
#playername#q1#
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=sentence_kubikashige]

[startanime name=purin time=2000 script=cos_bishi]
[voice name=purin voice_key="e2"]
[balloon name=purin time=4000]
Nice to meet you#e1#/n
I'm Purin#o1#
[wait time=4000]
[endballoon name=purin]
[waitaction name=purin script=cos_bishi]

;演出内容----------------------
;シナモンがこちらに寄ってくる
;-----------------------------
;カメラ 2キャラの中央になるように移動
[focusdoor]
[movecamera type=0 x=2.5 y=2 z=-2.5 time=0]
[rotatecamera pitch=0 head=-35 time=0]
	
[popchara costume=101102 x=-2 z=-5 angle=160 relative=true]
[popchara costume=111101 x=0 z=-1 angle=-20 relative=true]

[movechara type=0 name=cinnamon x=0 z=2.5 script=dash_face script_args={["smile"]} neutral=stand time=500]
[waitaction name=purin script=dash_face]
[wait time=3000]
[turnchara name=cinnamon script=walk_face angle=300 script_args={["smile"]} time=500]
[wait time=500]

[startanime name=cinnamon time=2000 script=tefuri_set2 script_args={[3,"ohohoho2","ohohoho2"]}]
[voice name=cinnamon voice_key="e4"]
[balloon name=cinnamon time=3000]
Purin#e1#/n
Welcome!
[wait time=1000]
[startanime name=purin time=2000 script=teage_set script_args={["smile"]}]
[wait time=2000]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=tefuri_set2]

[startanime name=purin time=2000 script=bookshelf_nayamu_set script_args={[3,"smile","def"]}]
[balloon name=purin time=3000]
This is a nice room#e1#
[wait time=3000]
[startanime name=cinnamon time=2000 script=stand_end2 script_args={["smile3"]}]
[endballoon name=purin]
[waitaction name=purin script=bookshelf_nayamu_set]

[startanime name=purin time=2000 script=sentence_pyonpyon 
 script_args={[{loop_num = 3, face=["warau", "warau"]}]}]
[voice name=purin voice_key="e9"]
[balloon name=purin time=3000]
This room would definitely/n
make a nice cafe#e1#
[wait time=3000]
[endballoon name=purin]
[waitaction name=purin script=sentence_pyonpyon]

[startanime name=cinnamon time=2000 script=kubikashige script_args={[2,"yaa"]}]
[voice name=cinnamon voice_key="e7"]
[balloon name=cinnamon time=2500]
Ehehe#o1#　Thanks,/n
let's make our cafe#e1#
[wait time=2500]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=kubikashige]

;シナモン方向転換
[turnchara name=cinnamon script=walk_face angle=320 script_args={["smile"]} time=300]
[wait time=300]

[startanime name=cinnamon time=2000 script=sentence_ketsui2 script_args={[{loop_num = 3, face=["nikawink"]}]}]
[voice name=cinnamon voice_key="e76_1"]
[balloon name=cinnamon time=2500]
#playername,/n
help us make/n
this room a cafe#e1#
[wait time=2500]
[endballoon name=cinnamon]
[waitaction name=cinnamon script=sentence_ketsui2]

[fadeoutbgm spd=12]
[wait time=2300]

