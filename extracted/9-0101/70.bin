;
;----------- テストレベルアップ -------------
;レベルアップした時の軽いモーション的なののテストです

; 作業部屋指定
[focusroom address={[0,0]}]

; 初期配置
[popchara name=mymelo relative=1 x=0 angle=0]

[startanime name=mymelo time=2500 script=pyonpyon2_set script_args={[2,"smile","smile3"]}]
[movecamera type=1 x=0 z=12 y=3]
[rotatecamera pitch=65]

[movecamera type=1 z=-1 y=-4.3 time=2500]
[rotatecamera pitch=5 time=2500]
[waitaction name=mymelo script=pyonpyon2_set]

[wait time=300]
[startanime name=mymelo time=5000 script=kurukuru_set script_args={[2,"yaa","smile3_cheek"]}]
[waitaction name=mymelo script=kurukuru_set]
[wait time=500]


