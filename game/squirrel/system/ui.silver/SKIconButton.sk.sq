class SKIconButton extends SKImageListButton {

  iconsp = null;

  constructor(ic = null) {
    super([
    ::getSprite("/system/ui.silver/ui.clp#iconbtn1"),
    ::getSprite("/system/ui.silver/ui.clp#iconbtn2"),
    ::getSprite("/system/ui.silver/ui.clp#iconbtn3"),
    null
    ]);
    iconsp = ic;
    updateButtonState(4);
  }

  function updateButtonState(st) {
    super.updateButtonState(st);
    if (!iconsp) return;
    switch (st) {
    case 4:
      iconsp.color = (iconsp.color & 0xffffff00) | 204; break;
    case 5:
    case 6:
    case 7:
      iconsp.color = (iconsp.color & 0xffffff00) | 255; break;
    default:
      iconsp.color = (iconsp.color & 0xffffff00) | 102; break;
    }
  }

  function render() {
    super.render();
    skDrawSprite(iconsp, bnd.w >> 1, bnd.h >> 1);
  }
}