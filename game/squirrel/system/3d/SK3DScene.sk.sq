class SK3DScene
{

  env = null;
  sorttable = null;

  enablescenecull = true;

  lights = null;
  objs = null;
  inactives = null;
  draws = null;

  maincamera = null;

  shadowmat = null;
  shadowvec = null;
  dropshadow = null;

  b3world = null;
  b3res = null;
  pbonegroups = null;
  disablesimulation = false;

  animating = true;

  constructor() {
    env = SK3DEnvironment();
    sorttable = SortTable();
    lights = [];
    objs = [];
    inactives = [];
    draws = [];

    dropshadow = DropShadow(this);

    pbonegroups = [];
  }

  function getB3World(create = true) {
    if (!b3world && create) {
      b3world = b3World(Rect3D(0, 0, 0, 512, 64, 512), 0);
    }
    return b3world;
  }

  function setEnvironment(e) {
    env = e;
  }

  function countObjects() {
    return length(objs) + length(inactives);
  }

  function addObject(sk3d) {
    objs + sk3d;
    sk3d.addedToScene(this);
  }

  function removeObject(sk3d) {
    local a, i;
    if (sk3d.parent) {
      a = sk3d.parent.children;
      i = a.indexOf(sk3d);
    } else {
      a = objs;
      i = a.indexOf(sk3d);
      if (i < 0) {
        a = inactives;
        i = a.indexOf(sk3d);
      }
    }
    delete a[i];
    sk3d.removedFromScene(this);
  }

  function addDropShadowObject(sk3d) {
    dropshadow.addObject(sk3d);
  }

  function removeDropShadowObject(sk3d) {
    dropshadow.removeObject(sk3d);
  }

  function addLight(li) {
    lights + li;
  }

  function removeLight(li) {
    local i = lights.indexOf(sk3d);
    if (i >= 0) delete lights[i];
  }

  function clearObjects() {
    foreach (o in objs) {
      o.removedFromScene(this);
    }
    foreach (o in inactives) {
      o.removedFromScene(this);
    }
    objs.clear();
    inactives.clear();
    lights.clear();
  }

  function updateScene(dt) {
    local anim = animating;
    animating = updateObjects(dt, objs, false);

    inactiveCheck(dt);

    if (b3world) {
      if (disablesimulation) {
        foreach (g in pbonegroups) {
          skBonePoseToPhysicalList(g.sk3d.gmat, g.bones);
        }
        b3world.updateAABBs();
      } else {
        b3world.simulate(dt * 0.001);
        updatePhysicalBones();
        if (length(pbonegroups)) animating = true;
      }
    }

    dropshadow.update(dt);

    return anim || animating;
  }

  function updateObjects(dt, a, pmatdirty) {
    local anim = false;
    foreach (n in a) {
      local nmatdirty = pmatdirty || n.matdirty;
      if (!n.update(dt, pmatdirty)) {
        n.removedFromScene(this);
        n.parent = null;
        anim = true;
        removei;
      } else {
        anim |= n.animating;
        nmatdirty = nmatdirty || anim || n.parentbone;
        if (n.children) anim |= updateObjects(dt, n.children, nmatdirty);
      }
    }
    return anim;
  }

  function findByName(n) {
    return _findByName(n, objs) || _findByName(n, inactives);
  }

  function _findByName(n, a) {
    foreach (o in a) {
      local ret = o.findByName(n);
      if (ret) return ret;
    }
    return null;
  }

  function findObject(fn) {
    return _findObject(fn, objs) || _findObject(fn, inactives);
  }

  function _findObject(fn, a) {
    foreach (o in a) {
      if (fn(o)) return o;
      local co;
      if (o.children && (co = _findObject(fn, o.children))) return co;
    }
    return null;
  }

  function collectObjects(fn, ret = null) {
    if (!ret) ret = [];
    _collectObjects(fn, objs, ret);
    _collectObjects(fn, inactives, ret);
    return ret;
  }

  function _collectObjects(fn, a, ret = null) {
    foreach (o in a) {
      if (fn(o)) ret + o;
      if (o.children) _collectObjects(fn, o.children, ret);
    }
  }

  static m_1 = Matrix();

  function inactiveCheck(dt) {

  }

  function cull(cam, visiblemask = -1, cullfilterfunc = null) {
    if (enablescenecull) {
      if (cullfilterfunc) {
        _camerainpassf(cam, visiblemask, objs, cullfilterfunc);
      } else {
        _camerainpass(cam, visiblemask, objs);
      }
    } else {
      if (cullfilterfunc) {
        _allpassf(cam, visiblemask, objs, cullfilterfunc);
      } else {
        _allpass(cam, visiblemask, objs);
      }
    }
    dropshadow.addToRenderList(cam, visiblemask, sorttable);

    sorttable.toArray(draws);
    sorttable.clear();
    return draws;
  }

  function _camerainpass(cam, visiblemask, a) {
    local tmpa = draws;
    tmpa.clear();
    SK3DRenderNode.cull(a, cam, visiblemask, tmpa)
    foreach (o in tmpa) {
      o.addToRenderList(cam, visiblemask, sorttable);
    }
  }

  function _camerainpassf(cam, visiblemask, a, cullfilterfunc) {
    local tmpa = draws;
    tmpa.clear();
    SK3DRenderNode.cull(a, cam, visiblemask, tmpa)
    foreach (o in tmpa) {
      if (cullfilterfunc(o)) o.addToRenderList(cam, visiblemask, sorttable);
    }
  }

  function _allpass(cam, visiblemask, a) {
    foreach (o in a) {
      if (o.visiblemask & visiblemask) o.addToRenderList(cam, visiblemask, sorttable);
      if (o.children) _allpass(cam, visiblemask, o.children);
    }
  }

  function _allpassf(cam, visiblemask, a, cullfilterfunc) {
    foreach (o in a) {
      if ((o.visiblemask & visiblemask) && cullfilterfunc(o)) o.addToRenderList(cam, visiblemask, sorttable);
      if (o.children) _allpassf(cam, visiblemask, o.children, cullfilterfunc);
    }
  }

  function addPhysicalBoneGroup(g) {
    if (g) {
      pbonegroups + g;
    }
  }

  function removePhysicalBoneObject(sk3d) {
    if (sk3d) {
      foreach (i, g in pbonegroups) {
        if (g.sk3d == sk3d) {
          delete pbonegroups[i];
          return;
        }
      }
    }
  }

  function updatePhysicalBones() {
    foreach (g in pbonegroups) {
      skPhysicalPoseToBoneList(g.sk3d.gmat, g.bones);
    }
  }
}

class SK3DScene.PhysicalBoneGroup
{
  sk3d = null;
  bones = null;

  constructor(o, b) {
    sk3d = o;
    bones = b;
  }
}

class SK3DScene.DropShadow extends SK3DRenderNode
{
  scn = null;
  dropobjs = null;
  pg = null;
  elems = null;

  constructor(s) {
    scn = s;
    dropobjs = [];
    elems = [];
    gmat = Matrix();
    ptc = createptc();
    pg = ptc.groups[0];
    ptc.start();
  }

  function createptc() {
    local p = ParticleEffect();
    local pg = ParticleGroup();
    p.gmat = gmat;
    pg.aimtype = 0;
    pg.ptcw = 0.5;
    pg.ptch = 0.5;
    pg.ptcaxis = 1;
    pg.m = Material();
    pg.m.Kd = 0xffffff99;
    pg.m.blend = SK_MIX;
    pg.m.depthmask = 0;
    pg.m.cullface = SK_OFF;
    pg.m.tec = skFXFindTechnique("decal.def");
    pg.m.tex0 = ::getTexture("/system/3d/defshadow.png");
    p.groups = [pg];
    return p;
  }

  function addObject(o) {
    if (dropobjs.indexOf(o) < 0) {
      dropobjs + o;
    }
  }

  function removeObject(o) {
    dropobjs.removeValue(o);
  }

  function update(dt) {
    local w = scn.b3world;
    if (!w) return;
    local vy = #Vector3D(0, -10, 0);
    local scale = #Vector3D(1, 1, 1);
    local rot = #Quaternion(0, 0, 0, 1);
    local c = 0;
    foreach (o in dropobjs) {
      if (!o.isVisible()) continue;
      if ("getShadowScale" in o) {
        scale(o.getShadowScale());
      } else {
        scale(1);
      }
      local _p = #Vector3D();
      _p(0).transform(o.mat);
      local r = w.rayTest(1, _p, _p + vy, 128, -1);
      if (!r.len()) continue;

      local e;
      if (c >= length(elems)) {
        e = pg.emit1();
        elems + e;
      } else {
        e = elems[c];
      }
      ++c;
      local dpos = r.pointa;
      dpos.y += 0.02;
      e.setSRT(dpos, scale, rot);
    }
    for (local l = length(elems) - 1; l >= c; l--) {
      elems[l].kill();
      elems.pop();
    }
    ptc.update(dt);
    ptc.alive = 1;
  }

  function addToRenderList(cam, visiblemask, sorttable) {
    if ((visiblemask & 1) && length(elems)) {
      sorttable.append(2000.0, this);
    }
  }
}

with Fog
{
  function setData(t) {
  }

  function computeParams() {
  }
}

class DepthFog extends Fog
{
  fogc = 255;
  zoffs = 0.0;
  klin = 1.0;
  kexp = 0.0;

  function setData(t) {
    fogc = t.fogc;
    zoffs = t.zoffs;
    klin = t.klin;
    kexp = t.kexp;
    computeParams();
  }

  function computeParams() {
    setParams(zoffs, klin, kexp, 0.0, (fogc >>> 24) / 255.0, ((fogc >>> 16) & 255) / 255.0, ((fogc >>> 8) & 255) / 255.0, (fogc & 255) / 255.0);
  }
}

class AtmosphereFog extends Fog
{
  sunvec = null;
  esun = null;
  br = null;
  bm = null;
  g = 0.0;

  function atovec(a) {
    return Vector3D(a[0], a[1], a[2]);
  }

  function setData(t) {
    sunvec = atovec(t.sunvec);
    esun = atovec(t.esun);
    br = atovec(t.br);
    bm = atovec(t.bm);
    g = t.g;
    computeParams();
  }

  function computeParams() {

    local vmat = #Matrix()
    skGetMatrix(SK_MATRIX_VIEW, vmat);

    local bRM = br + bm;
    local ibRMEsun = #Vector3D();
    ibRMEsun(
    (bRM.x == 0.0) ? 10000.0 : esun.x / bRM.x,
    (bRM.y == 0.0) ? 10000.0 : esun.y / bRM.y,
    (bRM.z == 0.0) ? 10000.0 : esun.z / bRM.z
    );
    local bRpi = br * ibRMEsun * (3.0 / 16.0 * Math.PI);
    local bMpig = bm * ibRMEsun * ((1.0 - g) * (1.0 - g) / 4.0 * 3.1415927);
    local sv = #Vector3D();
    sv(sunvec).transform(vmat).normalize();
    setParams(
    sv.x, sv.y, sv.z, 0.0,
    -bRM.x, -bRM.y, -bRM.z, 0.0,
    bRpi.x, bRpi.y, bRpi.z, 1.0 + g * g,
    bMpig.x, bMpig.y, bRpi.z, -2.0 * g
    );
  }
}

class SK3DEnvironment extends Environment
{
  envlights = null;

  postfx = null;

  data = null;

  constructor(t = null) {
    if (t) {
      setData(t);
    }
  }

  function setData(t) {
    data = t;

    ambup = t.ambup;
    ambdown = t.ambdown;

    if (t["envlights"]) {
      envlights = [];
      foreach (i, v in t.envlights) {
        envlights + createLight(v);
      }
    } else {
      envlights = null;
    }

    if (t["fog"]["type"]) {
      local f = #[null, DepthFog, AtmosphereFog];
      f = f[t.fog.type]();
      f.type = t.fog.type;
      f.setData(t.fog);
      fog = f;
    } else {
      fog = null;
    }

    postfx = t["postfx"] || null;
  }

  function createLight(data) {
    local li = Light();
    li.type = data.type;

    if (("head" in data) && ("pitch" in data)) {

      local v = Quaternion.fromHPB(data.head * Math.DTOR, data.pitch * Math.DTOR, (data["bank"] || 0.0) * Math.DTOR) * Vector3D(0, 0, -1);
      li.vx = v.x;
      li.vy = v.y;
      li.vz = v.z;
    }
    if (data["pos"]) {
      li.px = data.pos[0];
      li.py = data.pos[1];
      li.pz = data.pos[2];
    }
    li.color = data["color"] || 0xffffffff;
    li.scolor = data["scolor"] || 0xffffffff;
    li.power = (data["power"] || 0.8) / 255.0;
    li.pixellight = data["pixellight"] || 0;
    li.k1 = data["k1"] || 0.0;
    li.k2 = data["k2"] || 0.0;
    return li;
  }
}

class SK3DEnvironments
{
  res = null;
  emvmap = null
  data = null;

  constructor() {
    emvmap = {};
    res = ::getResource("scnenv.json");

  }

  function load(r) {
    res = r;
    data = decodeJSON(r.getContent());
  }

  function checkLoadData() {
    if (data) return;
    if (!res) {
      data = {

        morning =
        {
          envlights = [
          {
            type = 1
            color = 0xffffffff
            scolor = 0xffffffff
            head = 24
            pitch = 70
            power = 0.9
            pixellight = 1
          }, {
            type = 1
            head = 45
            pitch = 80
            color = 0xffffffff
            scolor = 0
            power = 0.9
            pixellight = 0
          }],
          ambup = 0xeecceeff
          ambdown = 0xeeddccff
        },
        evening =
        {
          envlights = [
          {
            type = 1
            head = 24
            pitch = 66
            color = 0xffbbccff
            scolor = 0xffbbccff
            power = 1.0
            pixellight = 1
          }, {
            type = 1
            head = 24
            pitch = 66
            color = 0xff88ccff
            scolor = 0
            power = 0.8
            pixellight = 0
          }],
          ambup = 0xff66cc00
          ambdown = 0x99778800
        },
      }
    } else {
      data = decodeJSON(res.getContent());
    }
  }

  function save(r = null) {
    if (!r) {
      if (!res) {
        local f = FileRef(skGetCodebase() + "/scnenv.json");
        res = FileResource(f);
      }
      r = res;
    }
    local bb = ByteBuffer();
    bb.putText(encodeJSON(data, 1));
    bb.pos = 0;

    r.file.save(bb);
  }

  function getEnvironment(id) {
    checkLoadData();
    local env = SK3DEnvironment(data[id]);
    return env;
  }

  function setEnvironment(id, t) {
    data[id] <- t;
  }

  function deleteEnvironment(id) {
    delete data[id];
  }
}

::SK3DEnvironments <- SK3DEnvironments();