    case CHARAID: return charaid;
    case CHARAGROUP: return charagroup;
    }
    return super.getParam(pid);
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case CHARATYPE: charatype = p0 | 0; break;
    case CHARAID: charaid = p0 | 0; break;
    case CHARAGROUP: charagroup = p0 | 0; break;
    default: super.setParam(pid, p0, p1, w);
    }
  }
}

class CameraProjection
{
  fovy = 40.0;
  znear = 0.5;
  zfar = 100.0;
  orthoh = 10.0;

  function set(e) {
    fovy = e.fovy;
    znear = e.znear;
    zfar = e.zfar;
    orthoh = e.orthoh;
  }

  function lerp(e0, e1, w) {
    if (w <= 0.0) {
      set(e0);
    } else
    if (w >= 1.0) {
      set(e1);
    } else {
      fovy = Math.lerp(e0.fovy, e1.fovy, w);
      znear = Math.lerp(e0.znear, e1.znear, w);
      zfar = Math.lerp(e0.zfar, e1.zfar, w);
      orthoh = Math.lerp(e0.orthoh, e1.orthoh, w);
    }
  }

  function setProjectionMatrixTo(cam, vpw, vph) {
    cam.perspective(fovy, (vpw * 1.0 / vph), znear, zfar);
  }
}

class SK3DCameraEntity extends SK3DEntity
{
  static icontype = "cam";

  lookat = null;
  proj = null;

  constructor() {
    lookat = [0.0, 0.0, 0.0];
    proj = CameraProjection();
  }

  function getProperties() {
    return #[
    ::SK3VP[NAME],
    ::SK3VP[POSITION],
    ::SK3VP[CAMERATARGET],
    ::SK3VP[CAMERAFOVY],
    ::SK3VP[CAMERARANGE],
    ::SK3VP[AUTOGEN],
    ::SK3VP[USERDATA],
    ];
  }

  function setCameraParameters(fv, zn, zf, oh = 10.0) {
    proj.fovy = fv;
    proj.znear = zn;
    proj.zfar = zf;
    proj.orthoh = oh;
  }

  function getParam(pid) {
    switch (pid) {
    case CAMERATARGET: return lookat;
    case CAMERAFOVY: return proj.fovy;
    case CAMERARANGE: return [proj.znear, proj.zfar];
    }
    return super.getParam(pid);
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case POSITION: pos = p0; updateLookat(); break;
    case CAMERATARGET: lookat = p0; updateLookat(); break;
    case CAMERAFOVY: proj.fovy = p0; break;
    case CAMERARANGE: proj.znear = p0[0]; proj.zfar = p0[1]; break;
    default: super.setParam(pid, p0, p1, w);
    }
  }

  function updateLookat() {
    local eye = Vector3D(pos[0], pos[1], pos[2]);
    local to = Vector3D(lookat[0], lookat[1], lookat[2]);
    aimHP((to - eye).normalize(), rot);
  }

  function setProjectionMatrixTo(cam, vpw, vph) {
    proj.setProjectionMatrixTo(cam, vpw, vph);
  }

  static function aimHP(v, rot) {
    local h, p;
    local x = 0.0, y = 0.0, z = 0.0;
    local vxz = v.x * v.x + v.z * v.z;
    if (vxz > 0.0) {
      local v_z = v_2(v.x, 0.0, v.z).normalize();
      h = Math.acos(v_z.z) * ((v_z.x >= 0.0) ? 1.0 : -1.0);
      p = -Math.PI * 0.5 + Math.acos(v.y);
    } else {
      h = 0;
      p = Math.PI * (v.y < 0.0 ? 0.5 : -0.5);
    }
    rot[0] = h * Math.RTOD;
    rot[1] = p * Math.RTOD;
    rot[2] = 0.0;
  }

  static function getDir(vx, vz) {
    return d;
  }
}