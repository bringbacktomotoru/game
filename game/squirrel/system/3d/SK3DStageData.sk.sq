enum SK3DPropertyID
{

  NAME = 1000
  POSITION = 1001
  SCALE = 1002
  ROTATION = 1003
  VISIBLE = 1004
  AUTOGEN = 1005
  DATAPATH = 1006
  STARTFUNC = 1007
  RIGIDBODY = 1008
  USERDATA = 1009

  CHARATYPE = 2001
  CHARAID = 2002
  CHARAGROUP = 2003

  NULLSHAPE = 3001
  VOLUMESIZE = 3002
  VOLUMECOLOR = 3003

  CAMERATARGET = 4001
  CAMERAFOVY = 4002
  CAMERARANGE = 4003

}

import PropertyType;
import SK3DPropertyID;

local blendlist = ["0:OFF", "1:MIX", "2:PMAMIX", "3:ADD", "4:MULT", "5:MIXADD"];
local wraplist = ["0:OFF", "1:ON", "2:ON(-)"];

local charatypelist = ["0:キャラ", "1:アイテム", "2:オブジェクト"];
local charagrouplist = ["0:プレイヤー", "1:敵ザコ", "2:敵中ボス", "3:敵大ボス", "4:チームA", "5:チームB", "6:チームC", "7:チームD", "8:"];

local shapetypelist = ["0:NULL", "1:BOX", "2:SPHERE", "3:DISC", "4:ARROW"];

::SK3VP <- SKProperties();
::SK3VP + { id = NAME, label = "名前", type = STRING, };
::SK3VP + { id = POSITION, label = "位置", type = FLOAT3, min = -5000, max = 5000, quat = 100, fmt = "%.2f" };
::SK3VP + { id = SCALE, label = "スケール", type = INT3, min = -500, max = 500, quat = 1 };
::SK3VP + { id = ROTATION, label = "回転", type = INT3, min = -360, max = 360, quat = 1 };
::SK3VP + { id = VISIBLE, label = "表示", type = BOOL, };
::SK3VP + { id = DATAPATH, label = "パス", type = PATH, };
::SK3VP + { id = AUTOGEN, label = "自動生成", type = BOOL, };
::SK3VP + { id = STARTFUNC, label = "初期メソッド", type = STRING, };
::SK3VP + { id = RIGIDBODY, label = "コリジョン", type = BODY, }
::SK3VP + { id = USERDATA, label = "データ", type = STRING, };
::SK3VP + { id = VOLUMECOLOR, label = "色", type = RGB, };

::SK3VP + { id = CHARATYPE, label = "キャラタイプ", type = LIST, list = charatypelist };
::SK3VP + { id = CHARAID, label = "キャラID", type = INT1, min = 0, max = 11000 };
::SK3VP + { id = CHARAGROUP, label = "グループ", type = LIST, list = charagrouplist };
::SK3VP + { id = NULLSHAPE, label = "シェイプ", type = LIST, list = shapetypelist };
::SK3VP + { id = VOLUMESIZE, label = "サイズ", type = FLOAT3, min = 0.0, max = 100.0, quat = 100, fmt = "%.2f" };
::SK3VP + { id = CAMERATARGET, label = "注視点", type = FLOAT3, min = -256.0, max = 256.0, quat = 100, fmt = "%.2f" };
::SK3VP + { id = CAMERAFOVY, label = "視野角", type = INT1, min = 10, max = 170, quat = 1 }
::SK3VP + { id = CAMERARANGE, label = "カメラ範囲", type = FLOAT2, min = 0.1, max = 640.0, quat = 10, fmt = "%.1f" }

local v_1 = Vector3D();
local v_2 = Vector3D();
local v_y = Vector3D(0, 1, 0);

class SK3DStageData
{
  envdata = null;
  root = null;

  res = null;

  constructor() {
    root = SK3DRootEntity();
    local cam = SK3DCameraEntity();
    cam.name = "MainCamera";
    cam.pos = [0.0, 10.0, -10.0];
    cam.updateLookat();
    root.addChild(cam);
  }

  function loaded(r) {
    res = r;
  }

  function writeJSON() {
    local t = {
      version = 0,
      root = root.writeJSON(),
      envdata = envdata,
    };
    return t;
  }

  function readJSON(t) {
    root = SK3DEntity.create(t.root);
    envdata = t.envdata;
  }

  function getEnvironmentData() {
    local env = null;
    if (typeof(envdata) == SS_STRING) {
      env = SK3DEnvironments.getEnvironment(envdata);
    } else
    if (envdata) {
      env = SK3DEnvironment(envdata);
    }
    if (!env) {
      env = SK3DEnvironments.getEnvironment("morning");
    }
    return env;
  }
}

class SK3DEntity
{
  static isdir = false;
  sk3d = null;

  name = "";
  group = 0;
  pos = null;
  scale = null;
  rot = null;
  autogen = true;
  startfunc = null;
  userdata = null;
  bnd = null;

  layerflags = 3;

  parent = null;
  children = null;
  coldata = null;

  static function create(t) {
    local e = getroottable()[t.classname]();
    e.readJSON(t);
    return e;
  }

  constructor() {
    name = "";
    pos = [0.0, 0.0, 0.0];
    scale = [100, 100, 100];
    rot = [0, 0, 0];
    bnd = [0, 0, 0, 1, 1, 1];
  }

  function getProperties() {
    return #[];
  }

  function getParam(pid) {
    switch (pid) {
    case NAME: return name;
    case POSITION: return pos;
    case SCALE: return scale;
    case ROTATION: return rot;
    case VISIBLE: return visible;
    case AUTOGEN: return autogen;
    case STARTFUNC: return startfunc;
    case USERDATA: return userdata;
    }
    return null;
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case NAME: name = p0; break;
    case POSITION: pos = p0; break;
    case SCALE: scale = p0; break;
    case ROTATION: rot = p0; break;
    case VISIBLE: visible = p0; break;
    case AUTOGEN: autogen = p0; break;
    case STARTFUNC: startfunc = p0; break;
    case USERDATA: userdata = p0; break;
    }
  }

  function getMatrix() {
    local m = Matrix();
    m.translate(pos[0], pos[1], pos[2]);
    m.scale(scale[0] * 0.01, scale[1] * 0.01, scale[2] * 0.01);
    m.rotate(rot[0] * Math.DTOR, rot[1] * Math.DTOR, rot[2] * Math.DTOR);

    if (parent) {
      m = parent.getMatrix().mult34(m);
    }
    return m;
  }

  function getLocalMatrix() {
    local m = Matrix();
    m.translate(pos[0], pos[1], pos[2]);
    m.scale(scale[0] * 0.01, scale[1] * 0.01, scale[2] * 0.01);
    m.rotate(rot[0] * Math.DTOR, rot[1] * Math.DTOR, rot[2] * Math.DTOR);
    return m;
  }

  function getBounds() {
    return Rect3D(bnd);
  }

  function findByName(n) {
    if (name == n) return this;
    foreach (c in children) {
      local e = c.findByName(n);
      if (e) return e;
    }
    return null;
  }

  function find(fn) {
    if (fn(this)) return this;
    foreach (c in children) {
      local e = find(fn);
      if (e) return e;
    }
    return null;
  }

  function collect(fn = null, a = null) {
    if (!a) a = [];
    if (!fn || fn(this)) {
      a + this;
    }
    foreach (c in children) {
      c.collect(fn, a);
    }
    return a;
  }

  function createCollisionBody(res, gmat) {
    if (!length(coldata["shapes"])) return null;
    gmat = clone gmat;
    local gscale = gmat.getScale().x;
    local a = [];
    local bmat = null;
    local b3shape = null;
    foreach (s in coldata.shapes) {
      local shp = createCollisionShape(s, res, gscale);
      if (shp) a + [s, shp];
    }
    switch (length(a)) {
    case 0: return null;
    case 1:
      local s = a[0][0];
      bmat = Matrix();
      bmat.translate(s.pos[0], s.pos[1], s.pos[2]);
      bmat.rotate(Quaternion.fromHPB(s.rot[0] * Math.DTOR, s.rot[1] * Math.DTOR, s.rot[2] * Math.DTOR));
      b3shape = a[0][1];
      gmat = gmat.mult34(bmat);
      break;
    default:
      b3shape = b3Shape.createCompound();
      foreach (ss in a) {
        local s = ss[0];
        local m = Matrix();
        m.translate(s.pos[0], s.pos[1], s.pos[2]);
        m.rotate(Quaternion.fromHPB(s.rot[0] * Math.DTOR, s.rot[1] * Math.DTOR, s.rot[2] * Math.DTOR));
        b3shape.addChild(s[1], m);
      }
      break;
    }
    local body = b3Body(coldata["dynamic"] ? coldata.mass : 0.0, b3shape, gmat, coldata.collisiongroup, coldata.collisionmask);
    if (bmat) body.setOffsetTransform(bmat);
    return body;
  }

  function createCollisionShape(s, res, gscale) {
    switch (s.shapetype) {
    case SK_SHAPE_BOX:
      return b3Shape.createBox(s.size[0] * gscale, s.size[1] * gscale, s.size[2] * gscale);
    case SK_SHAPE_SPHERE:
      return b3Shape.createSphere(s.size[0] * gscale * 0.5);
    case SK_SHAPE_CYLINDER:
      return b3Shape.createCylinder(s.size[0] * gscale * 0.5, s.size[1] * gscale, s.size[2] * gscale);
    case SK_SHAPE_CAPSULE:
      return b3Shape.createCapsule(s.size[0] * gscale * 0.5, s.size[1] * gscale);
    case SK_SHAPE_MESH:
      if (!s["pmpath"]) return null;
      local r = res.getResource(s.pmpath);
      if (!r) return null;
      local pm = ::getPolygonMesh(r);
      if (!pm) return null;
      local shp = b3Shape.createMesh(pm.vtx.getStream(SK_POSITION), [pm.face[0].idx]);
      shp.setLocalScaling(s.size[0] * gscale, s.size[1] * gscale, s.size[2] * gscale);
      return shp;
    }
  }

  function writeJSON() {
    local t = {};
    local pa = [];
    foreach (prop in getProperties()) {
      pa + [prop.id, getParam(prop.id)];
    }
    t.classname <- getclassname(this);
    t.bnd <- bnd;
    t.params <- pa;
    if (layerflags != 3) t.layerflags <- layerflags;
    if (length(children)) {
      local ca = [];
      t.children <- ca;
      foreach (c in children) {
        ca + c.writeJSON();
      }
    }
    if (coldata) t.coldata <- coldata;
    return t;
  }

  function readJSON(t) {
    foreach (p in t.params) {
      setParam(p[0], p[1]);
    }
    layerflags = "layerflags" in t ? t.layerflags : 3;
    if (t["bnd"]) {
      bnd = t.bnd;
    }
    if (t["children"]) {
      children = [];
      foreach (i, c in t.children) {
        local ce = create(c);
        children + ce;
        ce.parent = this;
      }
    }
    if (t["coldata"]) {
      coldata = t.coldata;
    }
  }

  function addChild(e) {
    if (children) children + e;
    else children = [e];
    e.parent = this;
  }

  function removeChild(c) {
    if (!children) return false;
    if (children.removeValue(c) == c) {
      c.parent = null;
      return true;
    } else {
      return false;
    }
  }

  function insertChild(i, c) {
    if (c.parent) throw Exception("SK3DEntity has another parent");
    if (!children) children = [c];
    else children[i] <- c;
    c.parent = this;
  }
}

class SK3DRootEntity extends SK3DEntity
{
  static isdir = true;

  function getProperties() {
    return #[];
  }
}

class SK3DNullEntity extends SK3DEntity
{
  static isdir = true;
  static icontype = "nul";

  nullshape = 0;
  body = null

  constructor() {
  }

  function getProperties() {
    return #[
    ::SK3VP[NAME],
    ::SK3VP[NULLSHAPE],
    ::SK3VP[RIGIDBODY],
    ::SK3VP[POSITION],
    ::SK3VP[SCALE],
    ::SK3VP[ROTATION],
    ::SK3VP[AUTOGEN],
    ::SK3VP[USERDATA],
    ];
  }

  function getParam(pid) {
    switch (pid) {
    case NULLSHAPE: return nullshape;
    case RIGIDBODY: return body;
    }
    return super.getParam(pid);
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case NULLSHAPE: nullshape = p0; break;
    case RIGIDBODY: body = p0; break;
    default: super.setParam(pid, p0, p1, w);
    }
  }
}

class SK3DVolumeEntity extends SK3DEntity
{
  static isdir = true;
  static icontype = "nul";

  volsize = null;
  volcolor = 6750207;

  constructor() {
    volsize = [1.0, 1.0, 1.0];
  }

  function getProperties() {
    return #[
    ::SK3VP[NAME],
    ::SK3VP[POSITION],
    ::SK3VP[VOLUMESIZE],
    ::SK3VP[VOLUMECOLOR],
    ::SK3VP[USERDATA],
    ];
  }

  function getParam(pid) {
    switch (pid) {
    case VOLUMESIZE: return volsize;
    case VOLUMECOLOR: return volcolor;
    }
    return super.getParam(pid);
  }

  function setParam(pid, p0, p1 = null, w = 0.0) {
    switch (pid) {
    case VOLUMESIZE: volsize = p0; break;
    case VOLUMECOLOR: volcolor = p0; break;
    default: super.setParam(pid, p0, p1, w);
    }
  }

  function getVolumeRect() {
    local r = Rect3D(0, 0, 0, volsize[0], volsize[1], volsize[2]);
    return r;
  }
}

