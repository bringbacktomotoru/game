class ScrollAdaptor
{
  vunitinc = 16;
  vblockinc = 0;
  vfixsize = 1;
  hunitinc = 16;
  hblockinc = 0;
  hfixsize = 1;

  function setUnitInc(orient, unit) {
    if (orient == 0) {
      vunitinc = unit;
    } else {
      hunitinc = unit;
    }
  }

  function setBlockInc(orient, block) {
    if (orient == 0) {
      vblockinc = block;
    } else {
      hblockinc = block;
    }
  }

  function getUnitInc(orient) {
    if (orient == 0) {
      return vunitinc;
    } else {
      return hunitinc;
    }
  }

  function getBlockInc(orient) {
    if (orient == 0) {
      return vblockinc;
    } else {
      return hblockinc;
    }
  }

  function setFixSize(orient, f) {
    if (orient == 0) {
      vfixsize = Math.max(1, f);
    } else {
      hfixsize = Math.max(1, f);
    }
  }

  function getFixSize(orient) {
    if (orient == 0) {
      return vfixsize;
    } else {
      return hfixsize;
    }
  }

  function getScrollTrack(bar, pos) {
    local fixsize = getFixSize(bar.orient);
    pos = pos + (fixsize / 2);
    local v = pos - (pos % fixsize);
    return Math.max(bar.min, Math.min(bar.max - bar.visibleamount, v));
  }

  function getScrollUnitInc(bar, dir) {
    local min = bar.min;
    local max = bar.max;
    local visibleamount = bar.visibleamount;
    local value = bar.value;
    local fixsize = getFixSize(bar.orient);
    local unitinc = getUnitInc(bar.orient);
    if (dir > 0) {
      if (value + unitinc < max - visibleamount) {
        return unitinc - ((value + unitinc) % fixsize);
      } else {
        return max - visibleamount - value;
      }
    } else {
      if (value - unitinc > min) {
        return -unitinc - ((value - unitinc) % fixsize);
      } else {
        return min - value;
      }
    }
  }

  function getScrollBlockInc(bar, dir) {
    local min = bar.min;
    local max = bar.max;
    local visibleamount = bar.visibleamount;
    local value = bar.value;
    local fixsize = getFixSize(bar.orient);
    local blockinc = getBlockInc(bar.orient);
    local bi = (blockinc > 0) ? blockinc : visibleamount;
    if (dir > 0) {
      if (value + bi < max - visibleamount) {
        return bi - ((value + bi) % fixsize);
      } else {
        return max - visibleamount - value;
      }
    } else {
      if (value - bi > min) {
        return -bi + ((value - bi) % fixsize);
      } else {
        return min - value;
      }
    }
  }
}