class SKScrollPaneBase extends SKView
{

  bg = null;
  vbar = null;
  hbar = null;
  showvbar = 1;
  showhbar = 0;

  vpw = 0.0;
  vph = 0.0;

  prevh = 0.0;
  prevv = 0.0;

  bordersize = null;
  cliparea = null;
  content = null;

  static v_1 = Vector3D();
  static r_1 = Rect2D();
  static m_1 = Matrix();

  constructor(v = 1, h = 0) {
    showvbar = v;
    showhbar = h;

    bordersize = [0, 0, 0, 0];
    createComponents();
  }

  function setScrollbar(v, h) {
    showvbar = v;
    showhbar = h;
    updateLayout();
  }

  function getScrollbar(i) {
    return i == 0 ? vbar : hbar;
  }

  function createComponents() {
    if (children) clear();
    bg = createBackground();
    cliparea = createClipArea();
    vbar = createScrollBar(0);
    hbar = createScrollBar(1);
    if (bg) addChild(bg);
    addChild(cliparea);
    addChild(vbar);
    addChild(hbar);
  }

  function updateLayout() {
    updateValues();
  }

  function setContent(c) {
    if (content) cliparea.removeChild(content);
    content = c;
    if (c) {
      c.pos.set(0, 0, 0);
      cliparea.addChild(c);
      if (c["getScrollAdaptor"]) {
        local sa = c.getScrollAdaptor();
        vbar.setScrollAdaptor(sa);
        hbar.setScrollAdaptor(sa);
      } else {
        vbar.setScrollAdaptor(null);
        hbar.setScrollAdaptor(null);
      }
    }
    updateValues();
  }

  function updateValues() {

    local hw = hbar.barw;
    local vw = vbar.barw;
    local vshow = false;
    local hshow = false;
    local ps;
    if (content) {
      ps = content.getPreferredSize(v_1);
      if (showvbar == 1 || (showvbar == 2 && bnd.h < ps.y)) {
        vshow = true;
      }
      if (showhbar == 1 || (showhbar == 2 && bnd.w < ps.x)) {
        hshow = true;
      }
    } else {
      vshow = (showvbar == 1);
      hshow = (showhbar == 1);
    }
    if (vshow) {
      vbar.setRect(bnd.w - vw - bordersize[2], bordersize[1], vw, bnd.h - (hshow ? hw : 0) - bordersize[1] - bordersize[3]);
      vbar.visible = true;
    } else {
      vbar.visible = false;
    }
    if (hshow) {
      hbar.setRect(bordersize[0], bnd.h - hw - bordersize[3], bnd.w - (vshow ? vw : 0) - bordersize[0] - bordersize[2], hw);
      hbar.visible = true;
    } else {
      hbar.visible = false;
    }
    vpw = bnd.w - (vshow ? vbar.barw : 0) - bordersize[0] - bordersize[2];
    vph = bnd.h - (hshow ? hbar.barw : 0) - bordersize[1] - bordersize[3];

    cliparea.setRect(bordersize[0], bordersize[1], vpw, vph);

    if (!content) {
      vbar.setEnabled(false);
      hbar.setEnabled(false);
    } else {
      vbar.setEnabled(true);
      hbar.setEnabled(true);
      local cpos = content.pos;
      local cbnd = content.bnd;
      local _w = (hshow) ? ps.x : vpw;
      local _h = (vshow) ? ps.y : vph;
      content.bnd.set(0, 0, _w, _h);

      if (vph >= cbnd.h) {
        vbar.setEnabled(false);
        vbar.setValue(0);
      } else {
        vbar.setEnabled(true);
        local max = (cbnd.h) | 0;
        local vamo = vph | 0;
        local val = Math.clamp(-cpos.y, 0, max - vamo) | 0;
        vbar.setValues(0, max, vamo, val);
      }
      if (vpw >= cbnd.w) {
        hbar.setEnabled(false);
        hbar.setValue(0);
      } else {
        hbar.setEnabled(true);
        local max = (cbnd.w) | 0;
        local hamo = vpw | 0;
        local val = Math.clamp(-cpos.y, 0, max - hamo) | 0;
        hbar.setValues(0, max, hamo, val);
      }
      content.pos.x = -hbar.value | 0;
      content.pos.y = -vbar.value | 0;
      content.updateLayout();
    }
  }

  function setTo(tox, toy) {
    if (!content) return;
    content.pos.x = -tox | 0;
    content.pos.y = -toy | 0;
    if ("refleshWindow" in content) content.refleshWindow();
    content.matdirty = true;
    content.repaint();
    prevh = tox;
    prevv = toy;
    repaint();
  }

  function getViewportSize(vpsize) {
    updateValues();
    vpsize.x = vpw;
    vpsize.y = vph;
    return vpsize;
  }

  function updateFunc(dt) {

    if (content) {
      local v = vbar.value;
      local h = hbar.value;
      if (prevh != h || prevv != v) {
        content.pos.x = -h | 0;
        content.pos.y = -v | 0;
        if ("refleshWindow" in content) content.refleshWindow();
        content.matdirty = true;
        content.repaint();
        prevh = h;
        prevv = v;
      }
    }
  }

  function revalidate() {

    updateValues();
    repaint();
  }

  function processEvent(e) {
    switch (e.id) {
    case MOUSE_WHEEL_MOVED:
      if (!e.consumed && mouseWheelMoved(e)) {
        e.consume();
      }
      break;
    }
    return super.processEvent(e);
  }

  function scrollRectToVisible(c, r) {
    m_1 << c.mat.mult44(getInvMatrix());
    r = r_1.set(r).transform(m_1);
    local cpos = content.pos;
    local newx = cpos.x;
    local newy = cpos.y;
    if (r.x + r.w > vpw) {
      newx = cpos.x - (r.x + r.w - vpw);
    }
    if (r.x < 0) {
      newx = cpos.x - (r.x);
    }
    if (r.y + r.h > vph) {
      newy = cpos.y - (r.y + r.h - vph);
    }
    if (r.y < 0) {
      newy = cpos.y - r.y;
    }
    if (cpos.x != newx) {
      hbar.setValue((-newx) | 0);
    }
    if (cpos.y != newy) {
      vbar.setValue((-newy) | 0);
    }
    setTo(-newx, -newy);
  }

  function mouseWheelMoved(e) {
    local b = false;
    if (showvbar) {
      if (e.count > 0) {
        for (local l = 0; l < e.count;++l) b |= vbar.decrementUnit();
      } else {
        for (local l = 0; l > e.count;--l) b |= vbar.incrementUnit();
      }
    } else
    if (showhbar) {
      if (e.count > 0) {
        for (local l = 0; l < e.count;++l) b |= hbar.decrementUnit();
      } else {
        for (local l = 0; l > e.count;--l) b |= hbar.incrementUnit();
      }
    }
    return b;
  }

  function setIncSize(unit, block) {
    vbar.setIncSize(unit, block);
    hbar.setIncSize(unit, block);
  }

  function setUnitInc(unit) {
    vbar.setUnitInc(unit);
    hbar.setUnitInc(unit);
  }

  function setBlockInc(block) {
    vbar.setBlockInc(block);
    hbar.setBlockInc(block);
  }

  function setFixSize(f) {
    vbar.setFixSize(f);
    hbar.setFixSize(f);
  }

  function createBackground() { throw Exception("not implemented!"); }
  function createClipArea() { throw Exception("not implemented!"); }
  function createScrollBar(ori) { throw Exception("not implemented!"); }
}