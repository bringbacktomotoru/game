class SKBoxLayoutView extends SKView
{
  static defbordersp = null;

  dir = 1;
  margin = 4.0;
  bordersp = null;

  constructor() {
    bordersp = defbordersp;
  }

  function addChild(c) {
    super.addChild(c);
    boxlayout();
  }

  function insertChild(i, c) {
    super.insertChild(i, c);
    boxlayout();
  }

  function removeChild(c) {
    super.removeChild(c);
    boxlayout();
  }

  function clearChildren() {
    super.clearChildren();
    boxlayout();
  }

  function addSpace(w) {
    local v = SKView();
    v.setRect(0, 0, w, w);
    v.visible = false;
    v.enabled = false;
    addChild(v);
  }

  function boxlayout() {
    local change = false;
    local y = margin;
    foreach (c in children) {
      if (c.pos.y != y) {
        change = true;
        c.pos.y = y;
        c.matdirty = true;
        c.repaint();
      }
      y += c.bnd.h + margin;
    }
    if (change || bnd.h != y) {
      bnd.h = y;
      repaint();
      return true;
    } else {
      return false;
    }
  }

  function revalidate() {
    boxlayout();
    super.revalidate();
  }

  function render() {
    local len = length(children);
    if (bordersp && len) {
      local w = bnd.w;
      local sph = bordersp.bnd.h;
      local sy = -margin + ((margin - sph) >> 1);
      for (local l = 1; l < len; l++) {
        local c = children[l];
        skDrawSprite(bordersp, 0, c.pos.y + sy, w, sph);
      }
      local c = children[len - 1];
      skDrawSprite(bordersp, 0, c.pos.y + c.bnd.h + sy + margin, w, sph);
      skDrawSprite(bordersp, 0, 0, w, sph);
    }
  }
}