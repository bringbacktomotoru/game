import ModifiersMask;

class SKToggleButtonBase extends SKView
{
  group = null;

  selected = false;

  actioncmd = null;

  mousein = false;
  pressed = false;
  viewenabled = true;

  function processEvent(e) {
    if (!(e.modifiers & BUTTON1_MASK)) return super.processEvent(e);
    switch (e.id) {
    case MOUSE_ENTERED:
      mousein = true;
      if (e.isMouseDown()) {

      }
      updateComponentState();
      e.consume();
      break;
    case MOUSE_EXITED:
      mousein = false;
      updateComponentState();
      e.consume();
      break;
    case MOUSE_PRESSED:
      pressed = true;
      if (group) {
        if (!selected) {
          setSelected(this);
          postActionEvent(actioncmd);
        } else {
          updateComponentState();
        }
      } else {
        setSelected(!selected);
        postActionEvent(actioncmd);
      }
      break;
      e.consume();
    case MOUSE_RELEASED:
    case MOUSE_CANCELLED:
      pressed = false;
      updateComponentState();
      e.consume();
      break;
    }
    return super.processEvent(e);
  }

  function updateComponentState() {
  }

  function isSelected() {
    return selected;
  }

  function setSelected(b) {
    if (b && group) {
      group.setSelected(this);
    }
    selected = b;
    updateComponentState();
  }

  function setEnabled(b) {
    super.setEnabled(b);
    viewenabled = b;
    updateComponentState();
  }
}

class CheckboxGroup
{

  selected = null;

  constructor() {}

  function setSelected(box) {
    if (box != null && box.group != this) {
      return false;
    }
    local old = selected;
    selected = box;
    if (old && (old != box)) {
      old.setSelected(false);
    }
    return true;
  }
}