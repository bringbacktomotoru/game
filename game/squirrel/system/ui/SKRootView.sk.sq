::rootview <- null;

class SKRootView extends SKView
{
  prjmat = null;
  renderstates = null;

  mouses = null;
  focusing = null;
  dndmouse = null;
  dragsource = null;
  dropview = null;
  focusview = null;

  droptarget = null;

  eventqueue = null;
  eventthread = null;
  dispatchlock = null;
  dorepaintall = true;
  quit = false;
  autoresize = false;

  ev = null;
  abuf = null;
  v_1 = Vector3D();

  constructor() {
    eventqueue = [];
    abuf = [];
    ev = Event();

    mouses = array(10);
    for (local l = 0; l < 10; l++) mouses[l] = MouseState(l);

    skGetScreenSize(abuf);

    prjmat = Matrix.fromOrtho(0, abuf[0], abuf[1], 0, -2000, 2000);
    bnd.set(0, 0, abuf[0], abuf[1]);

    renderstates = RenderStates();

    eventthread = newthread();
    eventthread.setFrameMask(-1);
    eventthread.setName("processEvent Thread");
    eventthread.setSuspendTimer(12);
    eventthread.call(eventloop, this, null);
  }

  function updateLayout() {
    prjmat = Matrix.fromOrtho(0, bnd.w, bnd.h, 0, -2000, 2000);
  }

  function processEvent(e) {
    foreach (f in (listeners && listeners[e.id / 100])) {
      f(e)
      if (e.consumed) return false;
    }
    switch (e.id) {
    case QUIT_REQUESTED: quit = true; break;
    case SCREEN_RESIZED:
      if (autoresize) {
        setRect(0, 0, e.x, e.y);
      }
      break;
    case SCREEN_REPAINT: dorepaintall = true; break;
    }
    return false;
  }

  function isMethodRunning(v = null) {
    if (v) {

      return v.isMethodRunning();
    } else {
      return super.isMethodRunning();
    }
  }

  nextflip = false;

  function update(dt) {
    if (nextflip) flipScreen();
    skSetFrameFlag(1);

    updateEvents(dt);
    updateViews(dt);
    nextflip = renderViews();
  }

  function updatefuncs(a, dt) {
    local ua = findOwners("updateFunc", abuf);
    foreach (v in ua) {
      local f = v.updateFunc;
      if (typeof(f) == SS_ARRAY) {
        foreach (c in f) { if (!c(dt)) removei; }
        if (!length(f) && v.updateFunc == f) {
          v.updateFunc = null;
        }
      } else {
        if (f) v.updateFunc(dt);
      }
    }
  }

  function updateEvents(dt) {
    if (dispatchlock) {
      skPeekEvents(deliverEventLocked, this, ev);
    } else {
      skPeekEvents(deliverEvent, this, ev);
    }
    if (dt > 0) {
      executeInterval(dt);
      eventthread.wakeup(dt);
    }
  }

  function updateViews(dt) {
    if (dt > 0) {
      updatefuncs(children, dt);
      updateMatrixAll(false);
    }
  }

  function renderViews() {
    if (skBeginRender()) {
      abuf.clear();
      if (repaintCheck(abuf) || dorepaintall) {
        if (length(abuf) > 0) {
          skSetRenderStates(renderstates);
          foreach (c in abuf) {
            c.renderToBuffer();
          }
          skSetRenderTarget(null);
        }
        skSetViewport(0, 0, 10, 10);
        skSetViewport();
        skSetRenderStates(renderstates);
        skSetMatrix(SK_MATRIX_PROJECTION, prjmat);
        skInitMatrix(SK_MATRIX_VIEW);
        skSetMatrix(SK_WORLD, mat);
        renderView();
        if (dragsource) {
          skInitMatrix(SK_WORLD);
          dragsource.dndrender(dndmouse);
        }
        skSetRenderStates(renderstates);
        skEndRender();
        dorepaintall = false;
        return true;
      }
    } else {
      dorepaintall = true;
    }
    return false;
  }

  function flipScreen() {
    skFlipScreen();
  }

  function render() {
    skClearScreen();
    super.render();
  }

  function changeKeyEventFocus(c, cmd = null) {
    if (focusview) {
      local e = Event();
      e.id = FOCUS_LOST;
      e.src = focusview;
      postEvent(e);
      focusview.setFocused(false);
    }
    focusview = c;
    if (c) {
      local e = Event();
      e.id = FOCUS_GAINED;
      e.src = c;
      e.actioncmd = cmd;
      postEvent(e);
      c.setFocused(true);
    }
    return true;
  }

  function changeDragTarget(mid, v, e) {
    local m = mouses[mid];
    if (m.dragview) {
      postEvent(Event().setMouseEvent(mid, mouses[mid].dragview, MOUSE_CANCELLED, e.x, e.y, e.modifiers, 0, m.outofmodal));
    }
    m.dragview = v;
    m.outofmodal = false;
  }

  function eventloop(modalview) {
    local oldlock = dispatchlock;
    for (;;) {
      local e = length(eventqueue) > 0 ? (delete eventqueue[0]) : null;
      dispatchlock = (e);
      if (!e) { suspend(); continue; }
      try {
        if (e.src) e.src.processEvent(e);
      } catch (ex) {
        printf("error in event loop...\n");
        printexception(ex);
      }
      dispatchlock = null;
      if (modalview && (modalview.getRoot() != this || !modalview.modal)) {
        break;
      }
    }
    dispatchlock = oldlock;
  }

  function suspendOrUpdate() {
    local oldlock = dispatchlock;
    dispatchlock = null;
    suspend();
    if (currentthread() == eventthread) {
      while (length(eventqueue)) {
        local e = delete eventqueue[0];
        dispatchlock = (e);
        try {
          if (e.src) e.src.processEvent(e);
        } catch (ex) {
          printf("error in event loop...\n");
          printexception(ex);
        }
      }
    }
    dispatchlock = oldlock;
  }

  function postEvent(e) {
    eventqueue + e;
  }

  function deliverEvent(e) {
    local eid = e.id;

    switch (eid / 100) {
    case MOUSE_EVENT:
      deliverMouseEvent(e);
      break;
    case APP_EVENT:
    case IAP_EVENT:
    case COMMAND_EVENT:

      if (isEnabled()) {
        e = clone e;
        e.src = this;
        postEvent(e);
      }
      break;
    default:
      local f = focusview || this;
      if (f.isEnabled()) {
        e = clone e;
        e.src = f;
        postEvent(e);
      }
      break;
    }
  }

  function deliverEventLocked(e) {
    local eid = e.id;
    switch (eid / 100) {
    case MOUSE_EVENT:
      deliverMouseEventLocked(e);
      break;
    case APP_EVENT:
    case IAP_EVENT:
    case COMMAND_EVENT:
      if (isEnabled()) {
        e = clone e;
        e.src = this;
        postEvent(e);
      }
      break;
    }
  }

  function exclusiveCheck(target, seq) {
    if (dragsource) {
      return true;
    } else
    if (target.exclusivetouch) {
      foreach (m in mouses) {
        if (m.dragview && target != m.dragview) return true;
      }
    } else {
      foreach (m in mouses) {
        if (m.dragview && m.dragview.exclusivetouch) return true;
      }
    }
    return false;
  }

  function mouseEnterCheck(mid, m, toenter, x, y, id) {
    local entered = m.entered;
    if (id == MOUSE_DRAGGED && entered && entered.exclusivedrag) return;
    if (entered != toenter) {
      if (entered && entered.isEnabled() &&--entered.mouseincount <= 0) {
        entered.mouseincount = 0;
        postEvent(Event().setMouseEvent(mid, entered, MOUSE_EXITED, x, y, m.modifiers, 0, false));
      }
      if (toenter && toenter.isEnabled() &&++toenter.mouseincount <= 1) {
        postEvent(Event().setMouseEvent(mid, toenter, MOUSE_ENTERED, x, y, m.modifiers, 0, false));
        m.entered = toenter;
      } else {
        m.entered = null;
      }
    }
  }

  function getDropTargetView(dc, x, y, dragsource) {
    do {
      if (dc.acceptDrop(dragsource, x, y)) break;
      dc = dc.parent;
    } while (dc);
    return dc;
  }

  function deliverMouseEvent(e) {
    local eid = e.id;
    local mid = e.mouseid;
    local m = mouses[mid];
    local x = e.x, y = e.y;
    local v = v_1;
    local target = pick(x, y, true, v);
    local outofmodal = (v_1.z != 0.0);
    local mod = e.modifiers;
    switch (eid) {
    case MOUSE_EXITED:
      mouseEnterCheck(mid, m, null, x, y, eid);
      break;
    case MOUSE_PRESSED:
      local mmod = mod & (64 | 128 | 256 | 512);
      mouseEnterCheck(mid, m, outofmodal ? null : target, x, y, eid);
      m.downx = x; m.downy = y; m.dndcheck = true;
      m.downtime = e.time;
      if (target) {
        if (exclusiveCheck(target, mid)) { break; }
        local tmid = target.mouseid;
        if (!target.multitouch && tmid >= 0 && tmid != mid && mouses[tmid].dragview == target) { break; }
        target.mouseid = mid;
        m.dragview = target;
        m.dragbtn = mmod;
        m.dsoffsx = v.x;
        m.dsoffsy = v.y;
        m.mousex = x;
        m.mousey = y;
        m.modifiers = m.modifiers | mod;
        m.outofmodal = outofmodal;
        println("pick:" + target.name);
        postEvent(Event().setMouseEvent(mid, target, MOUSE_PRESSED, x, y, mod, e.count, outofmodal));
      }
      break;
    case MOUSE_RELEASED:
      local mmod = mod & (64 | 128 | 256 | 512);
      if (dragsource) {
        if (m == dndmouse) {
          local dv = !target || outofmodal ? null : getDropTargetView(target, x, y, dragsource);
          if (dv) {
            postEvent(Event().setDDEvent(mid, dv, TARGET_DROP, x, y, mod, dragsource));
          }

          if (m.dragview) {
            postEvent(Event().setDDEvent(mid, m.dragview, SOURCE_DROP, x, y, mod, dragsource));
          }
          dragsource = null;
          dndmouse = null;
        }
        dorepaint = true;
      }
      if (m.dragview) {
        postEvent(Event().setMouseEvent(mid, m.dragview, MOUSE_RELEASED, x, y, mod, e.count, m.outofmodal));
        if ((mmod) == m.dragbtn) m.dragview = null;
      }
      m.modifiers = m.modifiers & (~mmod);
      break;
    case MOUSE_CLICKED:
      if (m.dragview) {
        postEvent(Event().setMouseEvent(mid, m.dragview, MOUSE_CLICKED, x, y, mod, e.count, false));
      }
      break;
    case MOUSE_MOVED:
    case MOUSE_DRAGGED:
      mouseEnterCheck(mid, m, outofmodal ? null : target, x, y, eid);
      m.mousex = x;
      m.mousey = y;
      if (dragsource) {
        if (m != dndmouse) break;
        local dv = !target || outofmodal ? null : getDropTargetView(target, x, y, dragsource);
        if (dv != dropview) {
          if (dropview) postEvent(Event().setDDEvent(mid, dropview, TARGET_DRAG_EXIT, -1, -1, mod, dragsource));
          if (dv) postEvent(Event().setDDEvent(mid, dv, TARGET_DRAG_ENTER, x, y, mod, dragsource));
          dropview = dv;
        } else {
          if (dropview) postEvent(Event().setDDEvent(mid, dropview, TARGET_DRAG_OVER, x, y, mod, dragsource));
        }
        dorepaint = true;
      } else
      if (m.dragview) {

        if (m.dndcheck && Math.max(Math.abs(m.downx - x), Math.abs(m.downy - y)) >= 6) {
          local notouch = true;
          foreach (a in mouses) { if (a != m && a.dragview) { notouch = false; break; } }
          local ds = m.dragview.dragsource;
          if (notouch && ds && ds.acceptDrag(Event().setDDEvent(mid, m.dragview, SOURCE_DRAG_ENTER, m.downx, m.downy, mod, getDnDAction(mod)))) {
            dragsource = ds; dropview = null; dndmouse = m;
          }
          m.dndcheck = false;
        } else {
          postEvent(Event().setMouseEvent(mid, m.dragview, MOUSE_DRAGGED, x, y, mod, 0, m.outofmodal));
        }
      } else {
        if (target) postEvent(Event().setMouseEvent(mid, target, MOUSE_MOVED, x, y, mod, 0, outofmodal));
      }
      break;
    case MOUSE_WHEEL_MOVED:
    case MOUSE_HWHEEL_MOVED:
      if (target) {
        e = clone e;
        e.src = target;
        postEvent(e);
      }
      break;
    }
  }

  function getDnDAction(mod) {
    return 0;
  }

  function deliverMouseEventLocked(e) {
    local eid = e.id;
    switch (eid) {
    case MOUSE_RELEASED:
      local mid = e.mouseid;
      local m = mouses[mid];
      local x = e.x, y = e.y;
      local v = v_1;
      local target = pick(x, y, true, v);
      local outofmodal = (v_1.z != 0.0);
      local mod = e.modifiers;
      if (dragsource) {
        if (m == dndmouse) {
          local dv = !target || outofmodal ? null : getDropTargetView(target, x, y, dragsource);
          if (dv) {
            postEvent(Event().setDDEvent(mid, dv, TARGET_DROP, x, y, mod, dragsource));
          }

          if (m.dragview) {
            postEvent(Event().setDDEvent(mid, m.dragview, SOURCE_DROP, x, y, mod, dragsource));
          }
          dragsource = null;
          dndmouse = null;
        }
        dorepaint = true;
      }
      if (m.dragview) {
        postEvent(Event().setMouseEvent(mid, m.dragview, MOUSE_RELEASED, x, y, mod, e.count, false));
        if ((mod) == m.dragbtn) m.dragview = null;
      }
      m.modifiers = m.modifiers & (~mod);
      break;
    }
  }
}

Event.setMouseEvent <- function(_mid, _src, _id, _x, _y, _mod, _cnt, outofmodal) {
  mouseid = _mid;
  src = _src;
  id = outofmodal ? (_id + MODAL_MOUSE_OFFSET) : _id;
  x = _x;
  y = _y;
  modifiers = _mod;
  count = _cnt;
  time = skGetTime();
  return this;
}

Event.setDDEvent <- function(_mid, _src, _id, _x, _y, _mod, _dsrc) {
  mouseid = _mid;
  src = _src;
  id = _id;
  x = _x;
  y = _y;
  modifiers = _mod;
  dragsrc = _dsrc;
  time = skGetTime();
  return this;
}

Event.isClicked <- function() {
  local m = ::rootview.mouses[mouseid];
  return m ? m.isClicked() : false;
}

class MouseState
{
  mouseid = -1;
  entered = null;
  mousex = -1; mousey = -1;
  modifiers = 0;
  mousein = false;

  dragview = null;
  dragbtn = 0;
  downtime = 0;
  downx = 0; downy = 0;
  dsoffsx = 0; dsoffsy = 0;
  dndcheck = false;

  outofmodal = false;

  constructor(mid) {
    mouseid = mid;
  }

  function isClicked() {
    if (skGetTime() >= downtime + 300) return false;
    local dx = mousex - downx, dy = mousey - downy;
    return (dx * dx + dy * dy) < (100);
  }
}