class TreeAdaptor extends ListAdaptor
{

  rootnode = null;

  constructor() {
    list = [];
  }

  function getView(idx, parentv) {
    return null;
  }

  function getNodeKey(o) {
    return o;
  }

  function getChildCount(o) {
    return 0;
  }

  function getChildren(o) {
    return null;
  }

  function getParent(o) {
    return null;
  }

  function getIndent(o) {
    local l = -1;
    while (o = getParent(o)) l++;
    return l;
  }
}