local ud = ::gamesession.userdata;
local path = "";
local lang = ::READ_TRANS_FILE.equals("JP") ? "JP" : "EN";

local a = [
"/dl/loadingbg/pop/" + lang + "/room2.png"
"/dl/loadingbg/pop/" + lang + "/room3.png"
"/dl/loadingbg/pop/" + lang + "/room4.png"
"/dl/loadingbg/pop/" + lang + "/room5.png"
];

path = a[skGetTime() % length(a)];

return ::getTexture(path);