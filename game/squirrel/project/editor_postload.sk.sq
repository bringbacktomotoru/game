printf("Start of KittyEditor Post \n");

runsk("src/tool/load.sk");

local game = ::GameSession();
game.serverurl = null;
setGameSession(game);
game.userdata = game.createNewUserData();
game.init(::rootview);
newthread().start(function() {
  local time = 0;
  for (;;) {
    local t = skGetTime();
    if (::gamesession.currentscene) ::gamesession.currentscene.updateScene(t - time);
    time = t;
    suspend();
  }
});

printf("End of KittyEditor Post \n");