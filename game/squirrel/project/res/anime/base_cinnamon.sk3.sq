runsk("/res/anime/base.sk");

model =
{

  body = { pm = "../clothes/default/cinnamon.pm" }
  face = { pm = "../facial/cinnamon_face.pm" parentname = "body" shadowbones = "body" }
  r_hand = { pm = "../hand/cinnamon/guR.pm" parentname = "body" shadowbones = "body" }
  l_hand = { pm = "../hand/cinnamon/guL.pm" parentname = "body" shadowbones = "body" }

}

with script {

  function setup() {

    setCharaSetting(::gamesetting.sanrio_chara_settings[102]);
    morphFace("tehepero_wink", 0);
    sk3d.setMotion(getMotionData(::getResource("/res/anime/scene01_cinnamon.mot")));
  }

  function first_chara_select() {
    hyahho_set(3);
    ketsui(2);

  }

}