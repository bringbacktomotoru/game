runsk("/res/anime/base.sk");

model =
{

  body = { pm = "../clothes/default/purin.pm" }
  face = { pm = "../facial/purin_face.pm" parentname = "body" shadowbones = "body" }
  r_hand = { pm = "../hand/purin/guR.pm" parentname = "body" shadowbones = "body" }
  l_hand = { pm = "../hand/purin/guL.pm" parentname = "body" shadowbones = "body" }
}

with script {

  function setup() {

    setCharaSetting(::gamesetting.sanrio_chara_settings[101]);

    sk3d.setMotion(getMotionData(::getResource("/res/anime/scene01_purin.mot")));
  }

  function first_chara_select() {
    yokopatapata_set(1, "smile");

    burabura_set(100);
  }

}