runsk("/res/goods/goods_base.sk")

with model {
  body <- {
    pm = "wateringcan.pm"
  }

}

with script {

  function start() {
  }

  function water_start() {
    efx = generate({ view = "/res/goods/goods_1/wateringcan_efxwater.sk3", hpb = [0, 0, 0], pos = [0, 0, 0], connect = true });
    for (;;) {
      if (efx) {
        if (sk3d.visible) efx.visible = true;
        else efx.visible = false;
      }
      pass(200);
    }
  }
  function water_end() {
    efx.startScript("end");
    pass(300);
    efx.kill();
  }

  function end() {
  }

}