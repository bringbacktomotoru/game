scriptclass = "SK3DScriptRunner"

script =
{
  efx = null;

  function start() {

    local efx_arrow = { view = "/res/efx/ptd/furniture_productselect_red.ptd", scale = [3.2, 3.2, 3.2] }
    if (efx) efx.kill();
    while (true) {

      efx = generate(efx_arrow);
      pass(1100);
    }
  }

  function current() {

    local efx_arrow = { view = "/res/efx/ptd/furniture_productselect_yellow.ptd", scale = [3.2, 3.2, 3.2] }
    if (efx) efx.kill();
    while (true) {
      efx = generate(efx_arrow);
      pass(1100);
    }
  }

  function selected() {

    local efx_arrow = { view = "/res/efx/ptd/furniture_productselect_green.ptd", scale = [3.2, 3.2, 3.2] }
    if (efx) efx.kill();
    while (true) {
      efx = generate(efx_arrow);
      pass(1100);
    }
  }

  function efxkill() {
    if (efx) efx.kill();
  }
}