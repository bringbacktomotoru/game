scriptclass = "SK3DScriptRunner"

script =
{
  function start() {
    for (local i = 1; i <= 4; i++) {
      local h = ::PUBLIC_RANDOM.nexti(300) - 150;
      local p = ::PUBLIC_RANDOM.nexti(300) - 150;
      generate({ view = "/res/efx/ptd/focusEffectFurniture.ptd", hpb = [h, p, 0], connect = false });
      pass(35);
    }
  }
}