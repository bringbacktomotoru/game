local initializer = [];

class WorkerDriverEx extends WorkerDriver {

  static function addWorkerInitializer(o) {

    local s = null;
    if (o instanceof Resource) {
      s = o.loadData().asText();
      initializer + [s, o.path];
    } else
    if (o instanceof FileRef) {
      s = o.load().asText();
      initializer + [s, o.name];
    } else {
      initializer + [o, null];
    }
  }

  function popq() {
    println("override popq");
    local len = length(qpool);
    if (len < maxworker) {
      local w = WorkerThread(len + 1);

      if (!w.isRunning()) w.start();
      local q = MessageQueue(len + 1);
      qpool + q;
      queue[len + 1] <- q;

      foreach (v in initializer) {
        q.pushMessage("compilerun", SENDER_NON, -1, v);
      }
      return q;
    } else {
      local q = delete qpool[0];
      qpool + q;

      local qid = q.getID();
      local w = WorkerThread(qid);
      if (!w.isRunning()) w.start();
      return q;
    }
  }

  static function startMaster(maxw = 3) {
    local qid = skGetWorkerID();
    local wd = WorkerDriverEx(qid);
    newthread().start(function() {
      printf("WorkerMaster[%d] start.\n", qid);
      wd.maxworker = maxw;
      wd.running = true;
      do {
        suspend();
        wd.receive();
      } while (wd.running);
    });
    ::workerdriver = wd;
    return wd;
  }
}