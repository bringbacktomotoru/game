class PackageUpdator
{
  static STORE_URL_IOS = "https://itunes.apple.com/app/id1439788857";

  sakanaproj = null;
  pkgjson = null;

  pkgversion = 0;
  pkgurl = null;
  cachedir = null;

  dlpkg = null;
  totalsize = 0;
  dlsize = 0;

  dlstate = 0;

  resumesize = 0;

  web_view = null;

  constructor() {
  }

  function getSxrFileName(si) {
    return sprintf("%s-%04x.sxr", si.sxrname, si.version);
  }

  function check() {

    if (::gamesession.trailmode) {
      return PackageCheckScene.RESULT_PACKAGECHECK_LATEST;
    }

    local r = ::getResource("/pkg.json");
    if (r) {
      pkgjson = decodeJSON(r.getContent());
      pkgversion = pkgjson["version"];
    } else {

      printf("no pkg.json. skip download.\n");
      return PackageCheckScene.RESULT_PACKAGECHECK_LATEST;
    }

    local r = ::getResource("/sakana.proj");
    if (r) {
      sakanaproj = decodeJSON(r.getContent());
      pkgurl = sakanaproj["pkgurl"]
      if (!pkgurl) {
        printf("no pkgurl. skip download.\n");
        return PackageCheckScene.RESULT_PACKAGECHECK_LATEST;
      }
    }

    cachedir = FileRef(skGetCodebase());
    if (!cachedir.isDirectory()) {
      cachedir = FileRef(cachedir.path + "/..");
    }

    local _osname = skGetOSName();

    local http = HTTPClient();
    local _is_inspect = false;

    try {
      local _maintenance_info = decodeJSON(http.get(pkgurl + "/setting.json", HTTPByteBufferReceiver()));

      local _release_ver = _maintenance_info.release_pkg_version;

      if (pkgversion > _release_ver) {
        ::gamesession.setMaintenanceInfo(null);
        _is_inspect = true;
      } else {

        local _min_ver = _maintenance_info.min_pkg_version;
        local _min_sk_ver = _osname.equals("iOS") ? _maintenance_info.min_sk_ver_ios : _maintenance_info.min_sk_ver_android;

        if (pkgversion < _min_ver || skGetVersion() < _min_sk_ver) {
          local _t;
          if (_osname.equals("iOS")) {
            _t = "error_pkgversion_ios";
            this.web_view = WebView();
            this.web_view.setType(-1);
            this.web_view.openURL(STORE_URL_IOS);
            this.web_view.show();
          }
          else {
            _t = "error_pkgversion_and";

          }

          local _dlg = SimpleDialog();
          _dlg.lbl_msg.setText(::dict.get(_t));
          _dlg.show();

          return PackageCheckScene.RESULT_PACKAGECHECK_NEED_STOREUPDATE;
        }

        if (_maintenance_info.mode > 0) {

          local _udl = ::gamesession.getUserDataLocal();
          local _mycode = _udl.getFriendCode();
          if (_mycode > 0) {
            _mycode = "" + _mycode;
          } else {
            _mycode = "1" + (_mycode * -1);
          }

          local _debug_fcode = decodeJSON(_maintenance_info.debug_friendcode);
          local _check = false;

          local _dcode = _maintenance_info.debug_friendcode;
          if (_dcode.len() > 0) {
            local _idx = _dcode.indexOf(",");
            if (_idx < 0) {
              if (_mycode.indexOf(_dcode) >= 0) _check = true;
            } else {
              local _list = [];
              do {
                local _code = _dcode.slice(0, _idx);
                _dcode = _dcode.slice(_idx + 1, _dcode.len());
                _list + _code;
                _idx = _dcode.indexOf(",");
                if (_idx < 0 && _dcode.len() > 0) _list + _dcode;
              } while (_idx >= 0);

              foreach (_code in _list) {
                if (_mycode.indexOf(_code) < 0) continue;
                _check = true;
                break;
              }

            }
          }

          if (!_check) {
            ::gamesession.setMaintenanceInfo(_maintenance_info);
            return PackageCheckScene.RESULT_PACKAGECHECK_MAINTENANCE;
          }
        } else {
          ::gamesession.setMaintenanceInfo(null);
        }
      }
    } catch (ex) {
      printexception(ex);

      local _dlg = SimpleDialog();
      _dlg.lbl_msg.setText(::dict.get("error_connect_fail"));
      _dlg.show();

      return PackageCheckScene.RESULT_PACKAGECHECK_ERROR_NETWORK;
    }

    if (_is_inspect) {
      this.pkgurl = sakanaproj["inspect_pkgurl"];
      if (::gamesession.con) ::gamesession.con.setURL(::INSPECT_SERVER_URL);
      ::SERVER_URL = ::INSPECT_SERVER_URL;
    }
    dlpkg = decodeJSON(http.get(pkgurl + "/pkg.json", HTTPByteBufferReceiver()));

    if (pkgversion != dlpkg.version) {
      printf("new package version=%d, old=%d. start download.\n", dlpkg.version, pkgversion);
      return PackageCheckScene.RESULT_PACKAGECHECK_DOWNLOAD;
    } else {
      printf("package version=%d. no change. \n", pkgversion);
    }

    printf("existing package check.\n");
    foreach (si in dlpkg.sxrlist) {

      local sxrname = getSxrFileName(si);
      local sxrf = FileRef(cachedir.path + "/" + sxrname);

      if (!sxrf.exists() || sxrf.size != si.size) {
        printf("sxr not found: %S start download.\n", sxrname);
        return PackageCheckScene.RESULT_PACKAGECHECK_DOWNLOAD;
      }
    }

    return PackageCheckScene.RESULT_PACKAGECHECK_LATEST;
  }

  function download() {

    local dllist = [];
    totalsize = resumesize;
    dlsize = resumesize;

    foreach (si in dlpkg.sxrlist) {

      local sxrname = getSxrFileName(si);
      local sxrf = FileRef(cachedir.path + "/" + sxrname);
      if (sxrf.exists()) {
        if (sxrf.size == si.size) {

          continue;
        }
      }
      dllist + {
        sxrname = sxrname
        size = si.size
        md5 = si.md5
      };
      totalsize += si.size;
    }

    {
      dllist + {
        sxrname = "main.sxr"
        size = dlpkg.mainsxr.size
      }
      totalsize += dlpkg.mainsxr.size;
    }

    foreach (t in dllist) {
      printf("download[%S] start. size=%d\n", t.sxrname, t.size);

      local http = HTTPClient();
      http.listener = this;
      local sxrfile = FileRef(cachedir.path + "/" + t.sxrname);
      http.get(pkgurl + "/" + t.sxrname, HTTPFileReceiver(sxrfile));

      sxrfile.refresh();
      local dlmd5 = ::getMD5(sxrfile);

      if (sxrfile.size != t.size || (t["md5"] && dlmd5 != t.md5)) {

        throw Exception("dl file incorrect[" + t.sxrname + "] pkg.size=" + t.size + " md5=" + (t.md5) + " dl.size=" + sxrfile.size + " md5=" + (dlmd5));
      }
      printf("completed.\n");
      resumesize += t.size;
    }

  }

  function httpStageChanged(http, st, arg) {
  }

  function httpReceive(http, size) {
    dlsize += size;
  }

}