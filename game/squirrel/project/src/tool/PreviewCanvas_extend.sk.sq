::PreviewCanvas <- class extends ::PreviewCanvas {
  static RENDER_SIZE = 4096;
  roth = 180 * Math.DTOR;

  function setSK3(s) {
    {
      scn.clearObjects();
      scn.addObject(gridobj);
      local env = SK3DEnvironments.getEnvironment(::selenv);
      if (!env) {
        env = SK3DEnvironments.getEnvironment("morning");
      }
      scn.setEnvironment(env);
      local _fx = env["postfx"];
      _fx.type = 102;
      local renderset = ::createRenderSetting(_fx);
      renderer.setRenderSetting(renderset);
    }

    sk3d = s;
    scn.addObject(sk3d);
    sk3d.updateMatrix();
    repaint();
  }

  function renderToImage() {
    showgrid.visible = false;
    camselect.visible = false;
    envselect.visible = false;

    local _w = RENDER_SIZE;
    local _h = int(this.bnd.h * RENDER_SIZE / this.bnd.w);

    if (_h > RENDER_SIZE) _h = RENDER_SIZE;

    local _oldw = this.bnd.w;
    local _oldh = this.bnd.h;
    this.setRect(0, 0, _w, _h);

    updateLayout();

    updateScene(0);

    local _sp = capture();
    local _rgba_image = RGBAImage(_w, _h);
    local old = skGetRenderTarget();

    skSetRenderTarget(_sp.tex0);
    skSetViewport();
    skReadPixels(0, 0, _w, _h, _rgba_image);
    skSetRenderTarget(old);

    local _date = ::getServerDate();
    local _filename = sprintf("%04d%02d%02d%02d%02d%02d.%s", _date.tm_year, _date.tm_mon + 1, _date.tm_mday, _date.tm_hour, _date.tm_min, _date.tm_sec, "png");

    local _outres = FileRef(_filename);

    local _png = _rgba_image.encodePNG();
    _png.pos = 0;
    _outres.save(_png);

    println("render image finished.");

    this.setRect(0, 0, _oldw, _oldh);
    showgrid.visible = true;
    camselect.visible = true;
    envselect.visible = true;
    updateLayout();
  }
}

::PMPreviewCanvas <- class extends ::PMPreviewCanvas {
  showrect = null;

  constructor() {

    group = BoneGroup();
    scn.addObject(group);

    physon = SKToggleButton("Physcal");
    physon.setRect(112, 4, 64, 24);
    addChild(physon);

    showbone = SKToggleButton("B");
    showbone.setRect(28, 4, 24, 24);
    showbone.setSelected(true);
    addChild(showbone);

    showrect = SKToggleButton("R");
    showrect.setRect(28, 4, 24, 24);
    showrect.setSelected(true);
    addChild(showrect);

    scn.disablesimulation = true;

  }

  function setSK3(s) {

    {
      scn.clearObjects();
      scn.addObject(gridobj);
      local env = SK3DEnvironments.getEnvironment(::selenv);
      if (!env) {
        env = SK3DEnvironments.getEnvironment("morning");
      }
      scn.setEnvironment(env);
      local _fx = env["postfx"];
      _fx.type = 102;
      local renderset = ::createRenderSetting(_fx);
      renderer.setRenderSetting(renderset);
    }

    sk3d = s;
    scn.addObject(sk3d);
    sk3d.updateMatrix();
    repaint();

    sk3d.addChild(group);
    group.clear();
    group.addBones(sk3d);
    resetRigidBody();
  }

  function updateStageEnv() {

    camera.perspective(40.0, 1.0, 4.0, 1000.0);

    envselect.adapt.clearNodes();
    ::SK3DEnvironments.checkLoadData();

    local a = [];
    foreach (i, v in ::SK3DEnvironments.data) {
      a + [i, v];
    }
    a.sort(function(a, b) { return objcmp(a[0], b[0]); });
    foreach (i, v in a) {
      envselect.adapt.addItem({ icontype = "ptd", name = v[0], ref = v[1] });
    }

    foreach (v in envselect.adapt.rootnode.list) {
      if (::selenv == v.name) {
        envselect.selectItem(v);
      }
    }
  }

  function updateLayout() {
    local w = bnd.w, h = bnd.h;
    sp.bnd.set(0, 0, w, h);
    camera.perspective(40.0, w / h, 4.0, 1000.0);
    envselect.setRect(w - 160, 4, 156, 24);
    showgrid.setRect(w - 186, 5, 22, 22);
    showrect.setRect(w - 210, 5, 22, 22);
  }

  function actionevent(e) {
    switch (e.src) {
    case physon:
      setPhysical(physon.isSelected());
      break;
    case showbone:
      group.visible = showbone.isSelected();
      repaint();
      break;
    case showrect:
      parent.setVisibleRectWire(showrect.isSelected());
      break;
    default:
      super.actionevent(e);
      break;
    }
  }
}