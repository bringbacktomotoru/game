class GameSetting {
  scnenv = null;
  stageenv = null;

  action_settings = null;
  costume_motion_settings = null;
  room_motion_settings = null;

  furniture_item_production_settings = null;
  sanrio_chara_settings = null;
  costume_settings = null;
  room_settings = null;
  room_conditions = null;
  room_slot_settings = null;
  furniture_settings = null;

  furniture_type_settings = null;

  series_settings = null;

  motion_drop_items_settings = null;

  condition_settings = null;
  room_slot_unlock_condition_settings = null;
  tutorial_condition_settings = null;
  shop_settings = null;
  shop_sale_settings = null;
  level_settings = null;
  event_scene_settings = null;

  tutorial_settings = null;
  help_settings = null;

  costume_health_table = null;
  costume_exp_table = null;

  room_exp_table = null;
  room_parameter_settings = null;

  costume_action_settings = null;
  release_motion_settings = null;
  costume_request_settings = null;
  item_settings = null;
  gacha_settings = null;
  gacha_items_settings = null;

  menu_button_settings = null;
  title_settings = null;

  rental_costume_settings = null;
  chara_sentence_list_settings = null;
  chara_sentence_list_condition_settings = null;
  prop_settings = null;
  chara_pat_reward_settings = null;
  new_costume_event_settings = null;

  diary_settings = null;
  diary_contents = null;
  diary_condition_settings = null;
  panel_mission_settings = null;
  panel_mission_condition_settings = null;
  mission_settings = null;
  letter_settings = null;

  game_rule = null;

  mark_possibility_table = null;
  shop_gm_price_table = null;
  shop_rm_price_table = null;
  shop_setting_table = null;

  snd = null;
  bgm = null;
  voice_table = null;

  reply_texts = null;

  iaplists = null;
  iap_settings = null;

  constructor() {
    this.scnenv = decodeJSON(::getResource("/scnenv.json").getContent());
    stageenv = {};
    action_settings = {};
    costume_motion_settings = {};
    room_motion_settings = {};

    furniture_item_production_settings = {};
    sanrio_chara_settings = {};
    costume_settings = {};
    room_slot_settings = {};
    room_settings = {};
    room_conditions = {};
    room_parameter_settings = {};
    furniture_settings = {};

    furniture_type_settings = {};

    series_settings = {};

    condition_settings = {};
    room_slot_unlock_condition_settings = {};
    tutorial_condition_settings = {};
    shop_settings = {};
    shop_sale_settings = {};
    level_settings = {};
    event_scene_settings = {};

    motion_drop_items_settings = {};

    tutorial_settings = {};
    help_settings = {};

    costume_action_settings = {};
    release_motion_settings = {};
    costume_request_settings = {};
    item_settings = {};
    gacha_settings = {};
    gacha_items_settings = {};
    menu_button_settings = {};
    title_settings = {};
    rental_costume_settings = {};
    chara_sentence_list_settings = {};
    chara_sentence_list_condition_settings = {};
    prop_settings = {};
    chara_pat_reward_settings = {};
    new_costume_event_settings = {};

    diary_settings = {};
    diary_condition_settings = {};
    panel_mission_settings = {};
    panel_mission_condition_settings = {};
    mission_settings = {};
    letter_settings = {};

    game_rule = null;

    snd = {};
    bgm = {};
    voice_table = {};

    iaplists = {};

    this.mark_possibility_table = {};
    shop_gm_price_table = {};
    shop_rm_price_table = {};

    reply_texts = {};

    this.iap_settings = {};
  }

  function transRunsk(s) {
    runsk(s);
  }

  function loadConfSetting(ret) {
    local conf = ret.conf;
    if ("GameRule" in conf) _createGameRuleSetting(decodeJSON(conf.GameRule));
    if ("SanrioCharaSetting" in conf) _createSanrioCharaSettingTable(decodeJSON(conf.SanrioCharaSetting));
    if ("LevelSetting" in conf) _loadConfAtServer(LevelSetting, this.level_settings, decodeJSON(conf.LevelSetting));
    if ("SeriesSetting" in conf) _loadConfAtServer(SeriesSetting, this.series_settings, decodeJSON(conf.SeriesSetting));
    if ("FurnitureTypeSetting" in conf) _loadConfAtServer(FurnitureTypeSetting, this.furniture_type_settings, decodeJSON(conf.FurnitureTypeSetting));
    if ("FurnitureSetting" in conf) _createFurnitureSettingTable(decodeJSON(conf.FurnitureSetting));
    if ("ProductionSetting" in conf) _createProductionSettingTable(decodeJSON(conf.ProductionSetting));
    if ("ConditionSetting" in conf) _createConditionSettingTable(decodeJSON(conf.ConditionSetting));
    if ("ItemSetting" in conf) _createItemSettingTable(decodeJSON(conf.ItemSetting));
    if ("CostumeMotionSetting" in conf) _loadConfAtServer(ActionSetting, this.costume_motion_settings, decodeJSON(conf.CostumeMotionSetting));
    if ("RoomMotionSetting" in conf) _loadConfAtServer(ActionSetting, this.room_motion_settings, decodeJSON(conf.RoomMotionSetting));
    if ("CostumeActionSetting" in conf) _createCostumeActionSettingTable(decodeJSON(conf.CostumeActionSetting));
    if ("CostumeRequestSetting" in conf) _loadConfAtServer(CostumeRequestSetting, this.costume_request_settings, decodeJSON(conf.CostumeRequestSetting));
    if ("CostumeSetting" in conf) _createCostumeSettingTable(decodeJSON(conf.CostumeSetting));
    if ("ReleaseMotionSetting" in conf) _createReleaseMotionSettingTable(decodeJSON(conf.ReleaseMotionSetting));
    if ("ShopSetting" in conf) _createShopSettingTable(decodeJSON(conf.ShopSetting));
    if ("GachaSetting" in conf) _createGachaSettingTable(decodeJSON(conf.GachaSetting));
    if ("GachaItemsSetting" in conf) _createGachaItemsSettingTable(decodeJSON(conf.GachaItemsSetting));
    if ("MenuButtonSetting" in conf) _createMenuButtonSettingTable(decodeJSON(conf.MenuButtonSetting));
    if ("TitleSetting" in conf) _loadConfAtServer(decodeJSON(conf.TitleSetting));
    if ("RoomSetting" in conf) _loadConfAtServer(RoomSetting, this.room_settings, decodeJSON(conf.RoomSetting));
    if ("RoomConditionSetting in conf") _loadConfAtServer(ConditionSetting, this.room_conditions, decodeJSON(conf.ConditionSetting));
    if ("RoomParameterSetting" in conf) _loadConfAtServer(RoomParameterSetting, this.room_parameter_settings, decodeJSON(conf.RoomParameterSetting));
    if ("RoomSlotUnlockConditionSetting" in conf) _loadConfAtServer(ConditionSetting, this.room_slot_unlock_condition_settings, decodeJSON(conf.ConditionSetting));
    if ("TutorialConditionSetting" in conf) _loadConfAtServer(ConditionSetting, this.tutorial_condition_settings, decodeJSON(conf.TutorialConditionSetting));
    if ("RoomSlotSetting" in conf) _loadConfAtServer(RoomSlotSetting, this.room_slot_settings, decodeJSON(conf.RoomSlotSetting));
    if ("ActionSetting" in conf) _loadConfAtServer(ActionSetting, this.action_settings, decodeJSON(conf.ActionSetting));
    if ("EventSceneSetting" in conf) _loadConfAtServer(EventSceneSetting, this.event_scene_settings, decodeJSON(conf.EventSceneSetting));
    if ("MotionDropItemsSetting" in conf) _loadConfAtServer(MotionDropItemsSetting, this.motion_drop_items_settings, decodeJSON(conf.MotionDropItemsSetting));
    if ("RentalCostumeSetting" in conf) _loadConfAtServer(RentalCostumeSetting, this.rental_costume_settings, decodeJSON(conf.RentalCostumeSetting));
    if ("PropSetting" in conf) _loadConfAtServer(PropSetting, this.prop_settings, decodeJSON(conf.PropSetting));
    if ("DiarySetting" in conf) _loadConfAtServer(DiarySetting, this.diary_settings, decodeJSON(conf.DiarySetting));
    if ("PanelMissionSetting" in conf) _loadConfAtServer(PanelMissionSetting, this.panel_mission_settings, decodeJSON(conf.PanelMissionSetting));
    if ("MissionSetting" in conf) _loadConfAtServer(MissionSetting, this.mission_settings, decodeJSON(conf.MissionSetting));
    if ("TutorialSetting" in conf) _loadConfAtServer(TutorialSetting, this.tutorial_settings, decodeJSON(conf.TutorialSetting));

    if ("roomExpTable" in conf) this.room_exp_table = decodeJSON(conf.roomExpTable);
    if ("costumeHealthTable" in conf) this.costume_health_table = decodeJSON(conf.costumeHealthTable);
    if ("costumeExpTable" in conf) this.costume_exp_table = decodeJSON(conf.costumeExpTable);
    if ("diaryContents" in conf) this.diary_contents = decodeJSON(conf.diaryContents);
  }

  function _createGameRuleSetting(t) {
    this.game_rule = GameRuleSetting.loadConfAtServer(t);
  }
  function _createSanrioCharaSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = SanrioCharaSetting.loadConfAtServer(list[i]); sanrio_chara_settings[e.chara_id] <- e;
    }
  }
  function _createFurnitureSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = FurnitureSetting.loadConfAtServer(list[i]); furniture_settings[e.id] <- e;
    }
  }
  function _createProductionSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = ProductionSetting.loadConfAtServer(list[i]); furniture_item_production_settings[e.id] <- e;
    }
  }
  function _createConditionSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = ConditionSetting.loadConfAtServer(list[i]); condition_settings[e.id] <- e;
    }
  }
  function _createItemSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = ItemSetting.loadConfAtServer(list[i]); item_settings[e.id] <- e;
    }
  }
  function _createCostumeActionSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = CostumeActionSetting.loadConfAtServer(list[i]); costume_action_settings[e.id] <- e;
    }
  }
  function _createCostumeSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = CostumeSetting.loadConfAtServer(list[i]); costume_settings[e.id] <- e;
    }
  }
  function _createReleaseMotionSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = ReleaseMotionSetting.loadConfAtServer(list[i]); release_motion_settings[e.id] <- e;
    }
  }
  function _createShopSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = ShopSetting.loadConfAtServer(list[i]); shop_settings[e.id] <- e;
    }
  }
  function _createGachaSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = GachaSetting.loadConfAtServer(list[i]); gacha_settings[e.id] <- e;
    }
  }
  function _createGachaItemsSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = GachaItemsSetting.loadConfAtServer(list[i]); gacha_items_settings[e.id] <- e;
    }
  }

  function _createMenuButtonSettingTable(list) {
    for (local i = 0; i < list.len(); i++) {
      local e = MenuButtonSetting.loadConfAtServer(list[i]); menu_button_settings[e.id] <- e;
    }
  }

  function _loadConfAtServer(clazz, tbl, list) {
    foreach (t in list) {
      local e = clazz.loadConfAtServer(t);
      tbl[e.id] <- e;
    }
  }

  function _setid(a, idx) {
    foreach (i, v in a) v[idx] = i;
  }

  function _checkValid(a) {
    foreach (i, v in a) {
      if (!v.isValid()) {
        print("" + v + " - id[" + i + "] has invalid value\n")
        throw Exception();
      }
    }
  }

  function validate() {

    _setid(furniture_item_production_settings, "id");
    _setid(sanrio_chara_settings, "chara_id");
    _setid(series_settings, "id");
    _setid(action_settings, "id");
    _setid(costume_motion_settings, "id");
    _setid(room_motion_settings, "id");
    _setid(costume_request_settings, "id");

    _setid(costume_settings, "id");
    _setid(room_settings, "id");
    _setid(room_conditions, "id");
    _setid(furniture_settings, "id");
    _setid(furniture_type_settings, "id");

    _setid(condition_settings, "id");
    _setid(tutorial_condition_settings, "id");
    _setid(shop_settings, "id");
    _setid(shop_sale_settings, "id");
    _setid(level_settings, "id");
    _setid(event_scene_settings, "id");

    _setid(costume_action_settings, "id");
    _setid(release_motion_settings, "id");
    _setid(item_settings, "id");
    _setid(gacha_settings, "id");
    _setid(gacha_items_settings, "id");
    _setid(menu_button_settings, "id");
    _setid(title_settings, "id");
    _setid(tutorial_settings, "id");
    _setid(help_settings, "id");
    _setid(motion_drop_items_settings, "id");
    _setid(rental_costume_settings, "id");
    _setid(chara_sentence_list_settings, "id");
    _setid(prop_settings, "id");
    _setid(new_costume_event_settings, "id");
    _setid(diary_settings, "id");
    _setid(diary_condition_settings, "id");
    _setid(panel_mission_settings, "id");
    _setid(mission_settings, "id");
    _setid(letter_settings, "id");
    _setid(iap_settings, "id");

    local wall = {};
    local floor = {};
    local ceiling = {};
    foreach (idx, t in this.furniture_type_settings) {
      switch (t.place) {
      case ::FurnitureSetting.PLACE_FLOOR:
        floor[idx] <- t;
        break;
      case ::FurnitureSetting.PLACE_BACK_WALL:
      case ::FurnitureSetting.PLACE_WALL:
        wall[idx] <- t;
        break;
      case ::FurnitureSetting.PLACE_CEILING:
        ceiling[idx] <- t;
        break;
      }
    }

  }

  function getActionSettingByName(name) {
    foreach (setting in this.action_settings) {
      if (setting.action_name == name) return setting;
    }
    return null;
  }

  function getSanrioCharaSettingByNameKey(key) {
    foreach (setting in this.sanrio_chara_settings) {
      if (setting.getNameKey() == key) return setting;
    }
    return null;
  }

  function getCharaCostumeTable(costume_ids) {
    if (!costume_ids) return {};

    local _table = {};
    foreach (cos_id in costume_ids) {
      local _cs = costume_settings[cos_id];
      if (_cs) _table[_cs.getCharaID()] <- cos_id;
    }
    return _table;
  }

  function getIAPItem(id) {
    local item_id = this.iap_settings[id].item_id;
    return getIAPItemByItemId(item_id);
  }
  function getIAPByItemId(item_id) {
    foreach (iap in this.iap_settings) {
      if (iap.item_id.equals(item_id)) return iap;
    }
    return null;
  }
  function getIAPItemByItemId(item_id) {
    local os_name = skGetOSName();
    local iap_list = this.iaplists[os_name];
    foreach (item in iap_list) {
      if (item.id == item_id) return item;
    }
    return null;
  }

  function getShopSettings(type) {
    local _settings = this.shop_setting_table[type];
    if (!_settings) return [];
    return _settings;
  }

  function createShopPriceTables() {
    local _udl = ::gamesession.getUserDataLocal();
    local _ud = ::gamesession.getUserData();
    local _room_idx = _ud.getCurrentRoomIndex();
    local _room_id = _ud.getRooms()[_room_idx].getRoomUID();
    Table.clear(this.shop_gm_price_table);
    Table.clear(this.shop_rm_price_table);

    Table.clear(this.mark_possibility_table);

    foreach (_ss in this.shop_settings) {
      local _type = _ss.getType();
      if (_type == SHOP_ITEM_TYPE_MOTION) continue;
      if (_type == SHOP_ITEM_TYPE_RM) continue;
      if (_type == SHOP_ITEM_TYPE_ROOM) continue;

      if (_ss.getRoomID() != _room_id) continue;

      if (_ud.hasItemByShopSetting(_ss)) continue;

      _addShopPriceTable(_ss);
    }
  }

  function _addShopPriceTable(ss) {

    local _type = ss.getType();
    local _price = ss.getPrice();

    if (!shop_gm_price_table[_type]) shop_gm_price_table[_type] <- [];

    local _udl = ::gamesession.getUserDataLocal();
    if (!this.mark_possibility_table[_type]) mark_possibility_table[_type] <- [];

    local _add = false;
    local _arr = shop_gm_price_table[_type];
    foreach (_idx, _id in _arr) {
      local _tag_ss = this.shop_settings[_id];
      if (_tag_ss.getPrice() < _price) continue;
      _add = true;
      _arr[_idx] <- ss.getID();
      this.mark_possibility_table[_type][_idx] <- ss.getID();
      break;
    }

    if (!_add) {
      _arr + ss.getID();
      this.mark_possibility_table[_type] + ss.getID();
    }
  }

  function createShopSettingTable() {
    this.shop_setting_table = {};

    local _furnitures = {};
    local _costumes = {};
    local _rooms = {};
    local _motions = {};
    local _rms = {};
    this.shop_setting_table[SHOP_ITEM_TYPE_FURNITURE] <- _furnitures;
    this.shop_setting_table[SHOP_ITEM_TYPE_COSTUME] <- _costumes;
    this.shop_setting_table[SHOP_ITEM_TYPE_ROOM] <- _rooms;
    this.shop_setting_table[SHOP_ITEM_TYPE_MOTION] <- _motions;
    this.shop_setting_table[SHOP_ITEM_TYPE_RM] <- _rms;

    foreach (k, v in this.shop_settings) {
      if (!v.checkPlatform()) continue;

      switch (v.getType()) {
      case SHOP_ITEM_TYPE_FURNITURE:
        _furnitures[k] <- v;
        break;
      case SHOP_ITEM_TYPE_COSTUME:
        _costumes[k] <- v;
        break;
      case SHOP_ITEM_TYPE_ROOM:
        _rooms[k] <- v;
        break;
      case SHOP_ITEM_TYPE_MOTION:
        _motions[k] <- v;
        break;
      case SHOP_ITEM_TYPE_RM:
        _rms[k] <- v;
        break;
      }
    }
  }
}

::gamesetting <- null;

function loadGameSetting(r) {
  local gset = GameSetting();
  r.getContent().call(gset);
  ::gamesetting = gset;
  gset.validate();
  r.pres.flush();
}