class ProductionSetting extends ::Setting {
  id = -1;

  products = null;
  furniture_exp = null;

  reward_gms = null;
  reward_rms = null;
  random_time = null;

  recieve_timeout = 60 * 60 * 10;

  product_time = null;
  tap_nums = null;
  wait_taps = null;
  limit_tap_time = null;

  bonus_priority_high = null;

  function loadConfAtServer(t) {
    local setting = ProductionSetting();

    foreach (k, v in t) {
      switch (k) {
      case "products":
      case "reward_gms":
      case "reward_rms":
      case "random_time":
      case "tap_nums":
      case "wait_taps":
        setting[k] = decodeJSON(v);
        break;
      case "bonus_priority_high":
        setting[k] = v > 0 ? true : false;
      default:
        setting[k] = v;
      }
    }
    return setting;
  }

  function getProductByLevel(lv) {
    local ret = null;
    foreach (p in this.products) {
      local product_lv = p.level;

      local product = p;
      if (lv < product_lv) break;
      ret = product;
    }
    return ret;
  }

  function getMaxProduct() {
    if (!this.products) return null;
    local _len = this.products.len();
    if (_len < 1) return null;

    return this.products[_len - 1];
  }

  function getFurnitureAddExp() {
    return this.furniture_exp;
  }

  function getMinRewardGM() {
    if (!reward_gms) return 0;
    return _getMin(reward_gms);
  }
  function getMaxRewardGM() {
    if (!reward_gms) return 0;
    return _getMax(reward_gms);
  }
  function getMinRewardRM() {
    if (!reward_rms) return 0;
    return _getMin(reward_rms);
  }
  function getMaxRewardRM() {
    if (!reward_rms) return 0;
    return _getMax(reward_rms);
  }

  function _getMin(arr) {
    local val = arr[0];
    if (arr.len() <= 1) return val;

    local _min = Math.min;
    for (local i = 1; i < arr.len(); i++) {
      val = _min(val, arr[i]);
    }
    return val;
  }
  function _getMax(arr) {
    local val = arr[0];
    if (arr.len() <= 1) return val;

    local _max = Math.max;
    for (local i = 1; i < arr.len(); i++) {
      val = _max(val, arr[i]);
    }
    return val;
  }

  function getRecieveTimeout() {
    return recieve_timeout;
  }

  function getRandomProductTime() {
    local _dif = this.random_time[1] - this.random_time[0];
    local _t = this.random_time[0] + ::PUBLIC_RANDOM.nexti(_dif);

    _t += getProductByLevel(1).time;

    return _t;
  }

  function getTapNums() {
    return this.tap_nums;
  }
  function getWaitTaps() {
    return this.wait_taps;
  }
  function getLimitTapTime() {
    return this.limit_tap_time || 0;
  }

  function getProductTime() {
    return this.product_time;
  }

  function isBonusPriorityHigh() {
    return this.bonus_priority_high;
  }

}