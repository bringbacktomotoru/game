class IAPSetting extends Setting {
  id = -1;
  item_id = null;
  name = null;
  add_rm = 0;
  bonus_rm = 0;
  price = null;

  room_id = -1;

  function getTranslateTarget() {
    local trans = [];

    if (name) trans + "name";
    return trans;
  }

  function needConstume() {
    return this.room_id < 0 ? true : false;
  }

  function getItemId() {
    return this.item_id;
  }

  function getRoomId() {
    return this.room_id;
  }

  function getOnerousRM() {
    return this.add_rm;
  }
  function getBonusRM() {
    return this.bonus_rm;
  }

  function getPrice() {
    return this.price;
  }
}