class EventSceneSetting extends Setting {
  static TYPE_EVENT = 1;
  static TYPE_TUTORIAL = 2;

  id = -1;
  title = null;
  scripts = null;

  conditions = null;
  type = -1;

  function loadConfAtServer(t) {
    local _setting = EventSceneSetting();
    foreach (k, v in t) {
      switch (k) {
      case "scripts":
      case "conditions":
        _setting[k] = decodeJSON(v);
        break;
      default:
        _setting[k] = v;
      }
    }
    return _setting;
  }

  function getFilePath() {
    return "/talk/" + ::READ_TRANS_FILE + "/" + scripts[0];
  }
}