class TitleSetting extends ::Setting {
  static TYPE_CLEAR_CHILD = 1;
  static TYPE_DEFAULT = 0;
  id = 0;

  key = null;
  name = null;
  icon_id = 0;
  panel_type = 0;

  large_background = false;

  function loadConfAtServer(t) {
    local _setting = TitleSetting();

    foreach (k, v in t) {
      _setting[k] = v;
    }
    return _setting;
  }

  function getTranslateTarget() {
    local trans = [];

    if (name) trans + "name";

    return trans;
  }

  function getID() {
    return this.id;
  }

  function getKey() {
    return this.key;
  }

  function getName() {
    if (!this.name) return "no text";
    return this.name;
  }

  function getPanelKey() {
    return this.panel_key;
  }

  function getPanelType() {
    return panel_type;
  }

  function largeBackground() {
    return this.large_background;
  }

  function getIconSprite() {

    local _path = "/image/icon/title/title/icon_" + this.icon_id + ".png";
    if (!_path) _tex = ::getTexture("/image/icon/title/title/icon_999.png");
    local _sp = ::getSprite(_path);

    _sp.blend = SK_MIX;
    return _sp;
  }

}