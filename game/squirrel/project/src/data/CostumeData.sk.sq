with Serializable() {

  class CostumeData
  {
    static SerialVersion = 1;

    static PAT_RECOVER_TIME = 60 * 60 * 3;
    static PAT_COOL_TIME = 1;

    static PAT_HEALTH = 1;
    static PAT_MOOD_UP = 60 * 60 * 2;
    static PAT_MOOD_DOWN = 60 * 60 * 12;
    static MAX_PAT_MOOD = 2;
    static MAX_PAT_POWER = 3;

    id = 0;

    work_data = null;
    exp = 0;
    level = 1;

    health = 0;
    pat_time = -1;
    pat_power = -1;
    pat_mood = 0;
    closet_time = -1;
    motions = null;

    model_script_list = null;

    levelup_num = null;

    constructor() {
    }

    function createCostumeData(cid, init = false) {
      local _cd = ::CostumeData();
      _cd.id = cid;
      _cd.level = 1;
      _cd.exp = 0;
      _cd.motions = [];
      if (init) {
        _cd.initMotions();

      }

      return _cd;
    }

    static function loadWithCreate(loader) {

      local _data = ::CostumeData.createCostumeData(loader.get());
      _data.exp = loader.get();
      _data.level = loader.get();
      _data.health = loader.get();
      _data.pat_time = loader.get();
      _data.pat_power = loader.get();
      _data.pat_mood = loader.get();
      _data.closet_time = loader.get();

      local _motion_num = loader.get();
      for (local i = 0; i < _motion_num; i++) {
        _data.motions + loader.get();
      }

      if (loader.get() == 1) {
        local _wd = ::WorkData();
        _wd.loadWorkData(loader);
        _data.setWorkData(_wd);
      }
      return _data;
    }

    function getID() {
      return this.id;
    }

    function getSetting() {
      return ::gamesetting.costume_settings[id];
    }

    function getName() {
      local setting = ::gamesetting.costume_settings[id];
      return setting.getName();
    }

    function getDesc() {
      local setting = ::gamesetting.costume_settings[id];
      return setting.getDesc();
    }

    function getCharaID() {
      return getSetting().getCharaID();
    }

    function getCharaName() {
      local _chara = ::gamesetting.sanrio_chara_settings[getCharaID()];
      if (!_chara) return "";
      return _chara.getName();
    }

    function getCharaSetting() {
      return ::gamesetting.sanrio_chara_settings[getCharaID()];
    }

    function setModelScript(scp) {
      if (!scp) return;
      if (!this.model_script_list) this.model_script_list = [];
      this.model_script_list + scp;
    }

    function getModelScript() {
      if (!this.model_script_list || this.model_script_list.len() == 0) return null;
      return delete this.model_script_list[0];
    }

    function hasWorkData() {
      return this.work_data != null;
    }
    function getWorkData() {
      return this.work_data;
    }
    function setWorkData(wd) {
      this.work_data = wd;
    }
    function clearWorkData() {
      this.work_data = null;
    };

    function addWorkHealth() {
      if (!work_data) return;
      addHealth(-work_data.getUseHealth());
    }

    function getExp() {
      return this.exp;
    }

    function getExpRatio() {
      local _me = getMaxExp();
      if (_me < 1) return 0.0;
      return float(getExp()) / float(_me);
    }

    function getMaxExp(lv = -1) {
      if (lv == -1) lv = this.level;
      return getSetting().getMaxExp(lv);
    }

    function addExp(val) {
      local _setting = getSetting();
      local _max_level = _setting.getMaxLevel();
      if (_max_level <= this.level) return;

      local _me = getMaxExp();
      if (_me < 0 || _me <= this.exp) return;

      this.exp += val;
    }

    function getLevel() {
      return this.level;
    }

    function getLevelupIncrement() {
      return levelup_num;
    }

    function levelUp() {
      local _me = getMaxExp();
      if (_me < 0 || _me > this.exp) return 0;

      local _sup = ::gamesession.levelUpCostume(getID());
      if (_sup <= 0) return 0;

      local _exp = this.exp;
      local _up = 0;
      local _motions = [];
      while (_me >= 0 && _exp >= _me) {
        _up++;
        _exp -= _me;
        _me = getMaxExp(this.level + _up);
        local _rms = getReleaseMotionsID(this.level + _up);
        if (_rms) {
          for (local i = 0; i < _rms.len(); i++) {
            if (_rms[i]) _motions + _rms[i];
          }
        }
      }

      if (_sup != _up) return 0;

      if (_up > 0) {
        this.level += _up;
        this.exp = _exp;
        fullHealth();
        for (local i = 0; i < _motions.len(); i++) {
          addMotion(_motions[i]);
        }
      }
      levelup_num = _up;
      return _up;
    }

    function enableLevelUp(exp = -1) {
      local _exp = exp != -1 ? exp : this.exp;
      return getMaxExp() <= _exp;
    }

    function fullHealth() {
      local _mh = getMaxHealth();
      if (_mh >= 0) {
        this.health = _mh;
      }
    }

    function getHealth(recover = false) {
      if (recover) return this.health + getRecoverHealth();
      return this.health;
    }
    function addHealth(val) {
      this.health += val;

      local _mh = getMaxHealth();
      if (this.health > _mh) this.health = _mh;
      else if (this.health < 0) this.health = 0;
    }

    function getMaxHealth() {
      return getSetting().getMaxHealth(this.level);
    }

    function getRecoverHealth() {
      if (this.closet_time < 0) return 0;
      return getSetting().calcRecoverHealth(::getServerTime() - this.closet_time);
    }

    function setClosetTime(t) {
      this.closet_time = t;
    }

    function enablePat() {
      return this.pat_time + PAT_COOL_TIME < ::getServerTime();
    }

    function getPatMood() {
      return this.pat_mood;
    }

    function adjustPatTime(_t) {

      this.pat_time = _t;
    }

    function execPat(st) {
      updatePatPower(st);

      local _diff = st - (this.pat_time + PAT_COOL_TIME);
      if (_diff < 0) {
        return;
      } else if (_diff < PAT_MOOD_UP) {
        this.pat_mood++;
        if (this.pat_mood > MAX_PAT_MOOD) this.pat_mood = MAX_PAT_MOOD;
      } else if (_diff > PAT_MOOD_DOWN) {
        this.pat_mood--;
        if (this.pat_mood < 0) this.pat_mood = 0;
      }

      this.pat_time = st;
      this.pat_power--;

      addHealth(PAT_HEALTH);
    }

    function updatePatPower(st = -1) {
      if (st < 0) st = ::getServerTime();

      local pt = st - this.pat_time;
      local rec = pt * 1.0 / PAT_RECOVER_TIME;
      this.pat_power += rec;
      this.pat_power = Math.min(this.pat_power, MAX_PAT_POWER);
    }

    function getPatPower() {
      updatePatPower();
      return this.pat_power;
    }

    function initMotions() {
      local _ms = getReleaseAllMotionsID();
      if (_ms) {
        for (local i = 0; i < _ms.len(); i++) {
          if (_ms[i]) addMotion(_ms[i]);
        }
      }
    }

    function getReleaseMotionsID(lv = -1) {
      if (lv < 0) lv = this.level;
      return getSetting().getReleaseMotionsID(lv);
    }

    function getReleaseAllMotionsID(lv = -1) {
      if (lv < 0) lv = this.level;
      return getSetting().getReleaseAllMotionsID(lv);
    }

    function addMotion(mid) {
      for (local i = 0; i < this.motions.len(); i++) {
        if (this.motions[i] == mid) return;
      }
      this.motions + mid;
    }

    function getMotions() {
      return this.motions;
    }
  }

}