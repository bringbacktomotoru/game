with Serializable() {

  class ProductData {
    static SerialVersion = 1;

    static TYPE_PRODUCT = 1;
    static TYPE_LEVELUP = 2;
    static TYPE_DELIVER = 3;

    static STATE_NONE = 0;
    static STATE_WAIT = 1;
    static STATE_PRODUCTING = 2;
    static STATE_FINISHED = 3;
    static STATE_GOT_REWARD = 4;
    static STATE_STOP = 5;

    producer_id = -1;
    product_id = 1;
    start_time = 0;
    product_time = -1;
    state = 0;
    type = 0;
    has_motion_reward = null;

    constructor() {
    }

    static function createProductData(product_id) {
      if (product_id == -1) currentthread().printStackTrace();
    }

    function startProductAtClient(time) {
      this.start_time = time;
      this.state = STATE_PRODUCTING;
    }

    function setServerData(server_data) {
      if (!server_data) return;

      if ("time" in server_data) this.start_time = server_data.time;

    }
    function setStartTimeAtServer(time) {
      this.start_time = time;
    }
    function setProductTimeAtServer(time) {
      this.product_time = time;
    }
    function setState(state) {
      this.state = state;
    }

    function getProductID() {
      return this.product_id;
    }

    function getType() {
      return this.type;
    }

    function getStartTime() {
      return this.start_time;
    }

    function getProductTime() {
      return this.product_time;
    }

    function getFinishTime() {
      return getStartTime() + getProductTime();
    }
    function debug_getRemainingTime() {
      return getFinishTime() - ::getServerTime();
    }

    function isFinished(time) {
      return getFinishTime() <= time;
    }

    function getRemainTime(time) {
      local remain = getFinishTime() - time;
      return remain;
    }

    function isFinishedAtState() {
      return this.state == STATE_FINISHED ? true : false;
    }

    function getProducerID() {
      return producer_id;
    }
    function getState() {
      return this.state;
    }

    function getName() {

    }

    function setMotionRewardFlag(b) {
      this.has_motion_reward = b;
    }
    function hasMotionReward() {
      return this.has_motion_reward;
    }

    function canRecieveHapiness() {
      return false;
    }
  }

  class FurnitureProductData extends ProductData {

    costume_id_list = null;
    room_index = null;

    enable_hapiness = null;
    static HAPINESS_WAIT_TIME = 5;
    static BONUS_TIME = 10;

    reward_states = null;
    static REWARD_STATE_WAIT = 0;
    static REWARD_STATE_TAP = 1;
    static REWARD_STATE_BONUS = 2;
    static REWARD_STATE_ALLEND = 3;

    is_attract = false;
    tapped_num = null;
    pool_tap_num = null;
    end_bonus = null;
    next_rewardstate_time = null;

    function createProductData(product_id, furniture_data, costume_id_list, room_index) {
      super.createProductData(product_id);

      local data = ::FurnitureProductData();
      data.product_id = product_id;
      data.producer_id = furniture_data.getUID();
      data.state = ::ProductData.STATE_WAIT;
      data.type = ::ProductData.TYPE_PRODUCT;

      data.costume_id_list = costume_id_list;
      data.room_index = room_index;

      data.enable_hapiness = false;
      data.is_attract = false;
      data.tapped_num = 0;
      data.pool_tap_num = 0;
      data.end_bonus = false;

      data.reward_states = [];
      data.next_rewardstate_time = -1;

      return data;
    }

    function setRewardStateListAtServer(list) {
      this.reward_states = list;
    }

    function getSetting() {
      return ::gamesetting.furniture_item_production_settings[this.product_id];
    }
    function getName() {
      local fd = ::gamesession.getUserData().getFurnitureData(this.producer_id);
      return fd.getCurrentName();
    }

    function getTargetCharaID() {
      return this.target_chara_id;
    }
    function getCostumeIDList() {
      return this.costume_id_list;
    }
    function getRoomIndex() {
      return this.room_index;
    }

    function getTimeout() {
      local _timeout = getSetting().getRecieveTimeout();
      local _finish_time = getFinishTime();
      return _finish_time + _timeout;
    }

    function isRecieveTimeout(time) {
      local _timeout = getSetting().getRecieveTimeout();
      if (!_timeout || _timeout < 0) return false;
      local _finish_time = getFinishTime();

      return (_finish_time + _timeout <= time);
    }

    function startProduct() {
      this.start_time = ::getServerTime();
      if (getSetting() == undefined) {
        local fd = ::gamesession.getUserData().getFurnitureData(this.producer_id);
        println("[ERROR] setting is undefined  fid = " + fd.getID() + ", pid = " + this.product_id);
      }

      this.product_time = getSetting().getProductTime();

      this.next_rewardstate_time = this.start_time + HAPINESS_WAIT_TIME;

      this.reward_states = [];
      if (getSetting().isBonusPriorityHigh()) {
        this.reward_states + REWARD_STATE_WAIT;
        this.reward_states + REWARD_STATE_BONUS;
        this.reward_states + REWARD_STATE_TAP;
        this.reward_states + REWARD_STATE_ALLEND;
      } else {
        this.reward_states + REWARD_STATE_WAIT;
        this.reward_states + REWARD_STATE_TAP;
        this.reward_states + REWARD_STATE_BONUS;
        this.reward_states + REWARD_STATE_ALLEND;
      }
    }

    function canRecieveHapiness() {
      return this.enable_hapiness;
    }
    function recieveHapiness() {
      if (!this.enable_hapiness) return;
      this.enable_hapiness = false;
    }
    function setEnableHapiness() {
      if (this.is_attract) {
        this.enable_hapiness = true;
      } else {

        if (::PUBLIC_RANDOM.nexti(100) < 30) {

          local _scene = ::gamesession.getCurrentScene();
          if (_scene instanceof ::SanrioGameScene) {
            local _stage = _scene.getStage();
            local _ret = true;
            foreach (cid in this.costume_id_list) {
              local _cm = _stage.getChara(cid);
              if (_cm.isStateAttract()) _ret = false;
            }
            this.enable_hapiness = _ret;
          }
        }
      }
      return this.enable_hapiness;
    }

    function setAttractProduct(b = true) {
      this.is_attract = b;
    }

    function hasNextStateTime() {
      return this.next_rewardstate_time > 0 ? true : false;
    }
    function setNextStateTime(_now) {
      if (this.reward_states[1] == undefined || this.reward_states[1] == REWARD_STATE_ALLEND) {
        this.reward_states[0] = REWARD_STATE_ALLEND;
        this.next_rewardstate_time = -1;
        return;
      }
      this.next_rewardstate_time = _now + HAPINESS_WAIT_TIME;
    }

    function resetNextStateTime() {
      this.next_rewardstate_time = -1;

    }

    function checkNextRewardState(now, has_bonus_num) {
      if (next_rewardstate_time > 0 && now >= next_rewardstate_time) {
        delete this.reward_states[0];
        resetNextStateTime();
        checkNextRewardState(now, has_bonus_num);
      } else if (next_rewardstate_time < 0) {
        if (this.reward_states[0] == REWARD_STATE_BONUS) {
          if (this.isEndBonusHapiness() || !has_bonus_num) {
            setNextStateTime(now);
          } else {

            if (_isEndBonusHapinessTutorial()) this.next_rewardstate_time = now + BONUS_TIME;
            else this.next_rewardstate_time = now + 99999999;
          }
        } else if (this.reward_states[0] == REWARD_STATE_TAP) {
          if (this.isFinishTapHapinessTime(now) || !this.isRemainTapNum()) setNextStateTime(now);
        } else if (this.reward_states[0] == REWARD_STATE_WAIT) {
          setNextStateTime(now);
        }
      }
    }

    function _isEndBonusHapinessTutorial() {
      if (::gamesetting.game_rule.disableTutorial()) return true;

      local _ud = ::gamesession.getUserData();
      if (::TutorialSetting.CHECK_TUTORIAL_FIRSTFOCUSTALK >= 0 && !_ud.isEndTutorialId(::TutorialSetting.CHECK_TUTORIAL_FIRSTFOCUSTALK)) {
        return false;
      }
      return true;
    }

    function getPoolTapNum() {
      return this.pool_tap_num;
    }
    function resetPoolTapNum() {
      this.pool_tap_num = 0;
    }

    function addTapped() {
      this.tapped_num++;
      this.pool_tap_num++;
    }
    function getTappedNum() {
      return this.tapped_num;
    }
    function setTappedNumAtServer(num) {
      this.tapped_num = num;
    }
    function isRemainTapNum() {
      local _tap_nums = getSetting().getTapNums();
      local _num = 0;
      foreach (num in _tap_nums) {
        _num += num;
      }
      return this.tapped_num < _num ? true : false;
    }
    function isFinishTapHapinessTime(now = -1) {
      local _now = now > 0 ? now : ::getServerTime();
      local _limit = getSetting().getLimitTapTime();

      return _now > getStartTime() + _limit ? true : false;
    }
    function enableTapHapiness() {
      if (isFinishTapHapinessTime(::getServerTime())) return false;
      if (!isRemainTapNum()) return false;

      return true;
    }

    function isEndBonusHapiness() {
      return this.end_bonus;
    }
    function endBonusHapiness() {
      this.end_bonus = true;
    }

    function getRewardState() {
      return this.reward_states[0] || REWARD_STATE_ALLEND;
    }
    function isRewardStateWait() {
      return this.reward_states[0] == REWARD_STATE_WAIT ? true : false;
    }
    function isRewardStateTap() {
      return this.reward_states[0] == REWARD_STATE_TAP ? true : false;
    }
    function isRewardStateBonus() {
      return this.reward_states[0] == REWARD_STATE_BONUS ? true : false;
    }
    function isRewardStateAllEnd() {
      return this.reward_states[0] == REWARD_STATE_ALLEND ? true : false;
    }

  }

  class FurnitureLevelupData extends ProductData {
    function createLevelupData(levelup_id, furniture_data) {

      local data = ::FurnitureLevelupData();
      data.product_id = levelup_id;
      data.producer_id = furniture_data.getUID();
      data.state = ::ProductData.STATE_WAIT;
      data.type = ::ProductData.TYPE_LEVELUP;
      return data;
    }

    function getSetting() {
      return ::gamesetting.level_settings[this.product_id];

    }

    function getName() {
      local fd = ::gamesession.getUserData().getFurnitureData(this.producer_id);
      return fd.getName();
    }
  }

  class FurnitureDeliverData extends ProductData {
    shop_id = 0;

    function createFurnitureDeliverData(furniture_data, shop_id) {
      local data = ::FurnitureDeliverData();
      data.shop_id = shop_id;
      data.producer_id = furniture_data.getUID();
      data.state = ::ProductData.STATE_PRODUCTING;
      data.type = ::ProductData.TYPE_DELIVER;

      return data;
    }

    function getSetting() {
      return ::gamesetting.shop_settings[this.shop_id];
    }
    function getName() {
      local ud = ::gamesession.getUserData();
      local fd = ud.getFurnitureData(this.producer_id);
      if (fd) {
        return fd.getName();
      }
    }
  }

  class ShopDeliverData extends ProductData {
    shop_id = 0;
    layout_data = null;

    function createDeliverProductData(uid, shop_id, layout_data) {

      local data = ::ShopDeliverData();
      data.shop_id = shop_id;
      data.layout_data = layout_data;
      data.producer_id = uid;
      data.state = ::ProductData.STATE_PRODUCTING;
      return data;
    }

    function getShopID() {
      return this.shop_id;
    }

    function getSetting() {
      return ::gamesetting.shop_settings[this.shop_id];
    }

    function getName() {
      return getSetting().getItemName();
    }
  }

}