class UserDataLocal {
  static FAVIRITE_MOTION_NOT_INIT = 0;
  static FAVIRITE_MOTION_INITIALIZED = 1;
  user_fl_flag = null;
  furniture_action_table = null;

  have_seen_gacha_table = null;

  friend_code = null;

  agreed_term_of_service_version = -1;

  local_flag_table = null;

  new_items = null;

  last_ar_time = null;

  init_favorite = 0;
  favorite_motions = null;
  favorite_prop_motions = null;

  focus_talk_flag = false;

  checked_gm_shop_id_table = null;
  checked_rm_shop_id_table = null;
  marked_gm_shop_id_table = null;
  marked_rm_shop_id_table = null;

  room_motions = null;
  room_move_motions = null;

  room_index = null;

  takeover_code = null;
  language = null;

  pm_reward_dialog = null;

  effect_mission_room = -1;
  effect_mission_table = null;

  showed_op_movie = null;

  constructor() {
    furniture_action_table = {};
    have_seen_gacha_table = {};
    new_items = {};
    last_ar_time = -1;
    user_fl_flag = false;

    favorite_motions = {};
    favorite_prop_motions = {};
    init_favorite = FAVIRITE_MOTION_NOT_INIT;

    checked_gm_shop_id_table = {};
    checked_rm_shop_id_table = {};

    marked_gm_shop_id_table = {};
    marked_rm_shop_id_table = {};

    room_motions = [];
    room_move_motions = [];

    room_index = 0;

    effect_mission_table = {};

    this.showed_op_movie = false;
  }

  function setup() {
    _load();
  }

  function save() {

    local userdata_local = {};

    local fat = clone this.furniture_action_table;
    foreach (uid, table in fat) {
      foreach (cos_id, bone in table) {
        if (table[cos_id] == null) {
          table[cos_id] = "null";
        }
      }
    }
    userdata_local["furniture_action_table"] <- fat;
    userdata_local["have_seen_gacha_table"] <- clone this.have_seen_gacha_table;
    userdata_local["friend_code"] <- this.friend_code;
    userdata_local["agreed_term_of_service_version"] <- this.agreed_term_of_service_version;
    userdata_local["new_items"] <- _encodeIntegerTable(this.new_items);
    userdata_local["last_ar"] <- this.last_ar_time;

    userdata_local["favorite_motions"] <- _encodeIntegerTable(this.favorite_motions);
    userdata_local["favorite_prop_motions"] <- _encodeIntegerTable(this.favorite_prop_motions);
    userdata_local["init_favorite"] <- this.init_favorite;

    userdata_local["checked_gm_shop_id_table"] <- _encodeIntegerTable(this.checked_gm_shop_id_table);
    userdata_local["checked_rm_shop_id_table"] <- _encodeIntegerTable(this.checked_rm_shop_id_table);

    userdata_local["marked_gm_shop_id_table"] <- _encodeIntegerTable(this.marked_gm_shop_id_table);
    userdata_local["marked_rm_shop_id_table"] <- _encodeIntegerTable(this.marked_rm_shop_id_table);

    userdata_local["room_index"] <- this.room_index;
    userdata_local["user_fl_flag"] <- this.user_fl_flag;
    userdata_local["takeover_code"] <- this.takeover_code;
    userdata_local["language"] <- this.language;

    userdata_local["showed_op_movie"] <- this.showed_op_movie

    local file = FileRef(skGetDataDir() + "/userdata_local");
    local jr = JSONOutput();
    jr.writeObject(userdata_local);
    local txt = encodeJSON(jr.getObject());
    local bb = ByteBuffer();
    bb.putText(txt);
    bb.pos = 0;
    file.save(bb);

  }

  function _encodeIntegerTable(table) {
    local _table = {};
    local _str = "";
    foreach (k, v in table) {
      _table["" + k] <- v;
    }
    return _table;
  }

  function _decodeIntegerTable(table) {
    local _table = {};
    foreach (k, v in table) {
      _table[int(k)] <- v;
    }
    return _table;
  }

  function _load() {
    local file = FileRef(skGetDataDir() + "/userdata_local");
    if (file.exists()) {
      try {
        local txt = file.load().asText();
        local ji = JSONInput(decodeJSON(txt));
        local data = ji.readObject();

        this.furniture_action_table = data.furniture_action_table;
        foreach (uid, table in furniture_action_table) {
          foreach (cos_id, bone in table) {
            if (bone == "null") table[cos_id] = null;
          }
        }
        this.have_seen_gacha_table = data.have_seen_gacha_table;
        this.friend_code = data.friend_code;
        this.agreed_term_of_service_version = data.agreed_term_of_service_version;
        local _new = data["new_items"];
        if (_new) this.new_items = _decodeIntegerTable(_new);
        this.last_ar_time = data["last_ar"] || -1;
        local _fm = data["favorite_motions"];
        if (_fm) this.favorite_motions = _decodeIntegerTable(_fm);
        local _fpm = data["favorite_prop_motions"];
        if (_fpm) this.favorite_prop_motions = _decodeIntegerTable(_fpm);
        this.init_favorite = data["init_favorite"] || 0;

        local _csit = data["checked_gm_shop_id_table"];
        if (_csit) this.checked_gm_shop_id_table = _decodeIntegerTable(_csit);
        _csit = data["checked_rm_shop_id_table"];
        if (_csit) this.checked_rm_shop_id_table = _decodeIntegerTable(_csit);

        local _smit = data["marked_gm_shop_id_table"];
        if (_smit) this.marked_gm_shop_id_table = _decodeIntegerTable(_smit);

        _smit = data["marked_rm_shop_id_table"];
        if (_smit) this.marked_rm_shop_id_table = _decodeIntegerTable(_smit);

        this.room_index = data.room_index;

        this.user_fl_flag = data["user_fl_flag"] || false;
        this.takeover_code = data["takeover_code"] || null;
        this.language = data["language"] || null;
        this.showed_op_movie = data["showed_op_movie"] || false;

      } catch (ex) {

        sendException(ex, "error in userdatalocal ....");
      }

      if (this.checked_gm_shop_id_table) _checkShopMarkTable(this.checked_gm_shop_id_table);
      if (this.checked_rm_shop_id_table) _checkShopMarkTable(this.checked_rm_shop_id_table);
      if (this.marked_gm_shop_id_table) _checkShopMarkTable(this.marked_gm_shop_id_table);
      if (this.marked_rm_shop_id_table) _checkShopMarkTable(this.marked_rm_shop_id_table);
    }
  }

  function _checkShopMarkTable(t) {
    local _shop_settings = ::gamesetting.shop_settings;
    foreach (ids in t) {
      if (!ids || ids.len() < 1) continue;
      local _list = [];
      foreach (sid in ids) {
        if (!_shop_settings[sid]) continue;
        _list + sid;
      }
      ids = _list;
    }
  }

  function resetUserDataLocal() {
    furniture_action_table = {};
    new_items = {};
    save();
  }

  function addFurnitureActionCharaTable(uid, table) {
    this.furniture_action_table[uid] <- table;
  }
  function removeFurnitureActionCharaTable(uid) {
    if (!(uid in this.furniture_action_table)) return;
    delete this.furniture_action_table[uid];
  }
  function getFurnitureActionCharaTable() {
    return this.furniture_action_table;
  }

  function getHaveSeenGachaTable() {
    return this.have_seen_gacha_table;
  }

  function getFriendCode() {
    return friend_code;
  }

  function setFriendCode(code) {
    this.friend_code = code;
  }

  function setLocalFlag(key, val) {
    if (!local_flag_table) local_flag_table = {};
    local_flag_table[key] <- val;
  }

  function getLocalFlag(key) {
    if (!local_flag_table) local_flag_table = {};
    return local_flag_table[key];
  }

  function hasSeenGachas(gacha_id, version) {
    if (!(gacha_id in this.have_seen_gacha_table)) return false;
    local _ver = this.have_seen_gacha_table[gacha_id];
    return _ver == version;
  }

  function agreedTOS() {
    this.agreed_term_of_service_version = ::TermOfServicePanel.VERSION;
  }
  function isAgreedTOS() {
    return this.agreed_term_of_service_version >= ::TermOfServicePanel.VERSION;
  }

  function addNewItem(kind, id) {
    local _list = this.new_items[kind];
    if (!_list) {
      _list = [];
      this.new_items[kind] <- _list;
      _list + id;
    }
    else {
      if (_list.indexOf(id) < 0) _list + id;
    }
  }

  function deleteNewItem(kind, id) {
    local _list = this.new_items[kind];
    if (!_list) return;
    if (id == -1) {
      _list.clear();
      return;
    }
    local _idx = _list.indexOf(id);
    if (_idx < 0) return;
    delete _list[_idx];
  }

  function getNewItem(kind) {

    return [];

  }

  function hasNewItems(kind) {

    return false;
  }

  function changeRoomIndex(idx) {
    this.room_index = idx;
  }
  function getRoomIndex() {
    return this.room_index;
  }

  function getLastARTime() {
    return this.last_ar_time;
  }
  function setLastARTime() {
    this.last_ar_time = ::getServerTime();
  }

  function addFavoriteMotion(chara_id, mid) {
    local _motions = this.favorite_motions[chara_id];
    if (!_motions) {
      _motions = [];
      this.favorite_motions[chara_id] <- _motions;
      _motions + mid;
      return true;
    }
    else {
      if (_motions.indexOf(mid) < 0) {
        _motions + mid;
        return true;
      }
    }
    return false;
  }

  function removeFavoriteMotion(chara_id, mid) {
    local _motions = this.favorite_motions[chara_id];
    local _idx = _motions.indexOf(mid);
    if (_idx == -1) return false;
    delete _motions[_idx];
    return true;
  }

  function getFavoriteMotions(chara_id) {
    local _motions = this.favorite_motions[chara_id];
    return _motions ? _motions : [];
  }

  function addFavoritePropMotion(prop_id, mid) {
    local _motions = this.favorite_prop_motions[prop_id];
    if (!_motions) {
      _motions = [];
      this.favorite_prop_motions[prop_id] <- _motions;
      _motions + mid;
      return true;
    }
    else {
      if (_motions.indexOf(mid) < 0) {
        _motions + mid;
        return true;
      }
    }
    return false;
  }

  function removeFavoritePropMotion(prop_id, mid) {
    local _motions = this.favorite_prop_motions[prop_id];
    local _idx = _motions.indexOf(mid);
    if (_idx == -1) return false;
    delete _motions[_idx];
    return true;
  }

  function getFavoritePropMotions(prop_id) {
    local _motions = this.favorite_prop_motions[prop_id];
    return _motions ? _motions : [];
  }

  function getFavoriteMotionsByARCharaModel(acm) {
    if (!acm) return [];
    local _prop_id = acm.getPropID();
    return _prop_id < 0 ? getFavoriteMotions(acm.getCharaID()) : getFavoritePropMotions(_prop_id);
  }

  function addFavoriteMotionByARCharaModel(acm, mid) {
    if (!acm) return false;
    local _prop_id = acm.getPropID();
    return _prop_id < 0 ? addFavoriteMotion(acm.getCharaID(), mid) : addFavoritePropMotion(_prop_id, mid);
  }

  function removeFavoriteMotionByARCharaModel(acm, mid) {
    if (!acm) return false;
    local _prop_id = acm.getPropID();
    return _prop_id < 0 ? removeFavoriteMotion(acm.getCharaID(), mid) : removeFavoritePropMotion(_prop_id, mid);
  }

  function isFavoriteMotionByARCharaModel(acm, mid) {
    if (!acm) return false;
    local _ids;
    local _prop_id = acm.getPropID();
    if (_prop_id < 0) _ids = getFavoriteMotions(acm.getCharaID());
    else _ids = getFavoritePropMotions(_prop_id);

    return _ids.indexOf(mid) >= 0 ? true : false;
  }

  function initFavoriteMotions() {
    if (this.init_favorite == FAVIRITE_MOTION_INITIALIZED) return false;
    this.init_favorite = FAVIRITE_MOTION_INITIALIZED;

    this.favorite_motions = {};
    local _chara_table = ::gamesession.getUserData().getCharacterDataTable();
    foreach (c in _chara_table) {
      local _motions = clone c.getMotions();
      _motions[0] <- -1;
      this.favorite_motions[c.getID()] <- _motions;
    }

    this.favorite_prop_motions = {};
    local _settings = ::gamesetting.prop_settings;
    foreach (s in _settings) {
      local _motions = clone s.getMotionList();
      this.favorite_prop_motions[s.getID()] <- _motions;
    }

    return true;
  }

  function setFocusTalkFlag(b) {
    this.focus_talk_flag = b;
  }
  function getFocusTalkFlag() {
    return this.focus_talk_flag;
  }

  function checkRemovedShopSettings() {
    local _shop_settings = ::gamesetting.shop_settings;
    local _temp_gm = {};
    foreach (key, ids in this.checked_gm_shop_id_table) {
      foreach (id in ids) {
        if (!_shop_settings[id]) removei;
      }
      if (ids.len() > 0) _temp_gm[key] <- ids;
    }
    this.checked_gm_shop_id_table = _temp_gm;

    local _temp_rm = {};
    foreach (key, ids in this.checked_rm_shop_id_table) {
      foreach (id in ids) {
        if (!_shop_settings[id]) removei;
      }
      if (ids.len() > 0) _temp_rm[key] <- ids;
    }
    this.checked_rm_shop_id_table = _temp_rm;
  }

  function setCheckedShopIdTable(table, is_gm) {
    if (is_gm) this.checked_gm_shop_id_table = table;
    else this.checked_rm_shop_id_table = table;
  }

  function getCheckedShopIdTable(is_gm) {
    return is_gm ? this.checked_gm_shop_id_table : this.checked_rm_shop_id_table;
  }

  function setMarkedShopIdTable(table, is_gm) {
    if (is_gm) this.marked_gm_shop_id_table = table;
    else this.marked_rm_shop_id_table = table;
  }
  function getMarkedShopIdTable(is_gm) {
    return is_gm ? this.marked_gm_shop_id_table : this.marked_rm_shop_id_table;
  }

  function setupRoomMotion() {
    local _rank = ::gamesession.getUserData().getRank();
    local _motions = ::gamesetting.game_rule.getRoomMotions();
    local _settings = ::gamesetting.room_motion_settings;
    this.room_motions = [];
    this.room_move_motions = [];
    foreach (m in _motions) {
      local _rms = _settings[m.motion_id];
      if (!_rms || m.rank > _rank) continue;
      if (_rms.isMoveAction()) this.room_move_motions + m.motion_id;
      else this.room_motions + m.motion_id;
    }
  }
  function getRoomIdleMotions() {
    return this.room_motions;
  }
  function getRoomMoveMotions() {
    return this.room_move_motions;
  }

  function setFlFlag() {
    this.user_fl_flag = true;
  }
  function getFlFlag() {
    return this.user_fl_flag;
  }

  function setTakeoverCode(code) {
    this.takeover_code = code;
  }
  function getTakeoverCode() {
    return this.takeover_code;
  }

  function setLanguage(lang) {
    this.language = lang;
  }
  function getLanguage() {
    return this.language;
  }

  function setPanelMissionRewardDialog(dlg) {
    this.pm_reward_dialog = dlg;
  }
  function getPanelMissionRewardDialog() {
    return this.pm_reward_dialog;
  }

  function checkMissionEffect(num) {
    local _cur = ::gamesession.getUserData().getCurrentRoomUID();
    if (_cur != this.effect_mission_room) {

      this.effect_mission_room = _cur;
      this.effect_mission_table[_cur] <- num;
      return num > 0 ? true : false;
    }

    local _local_num = this.effect_mission_table[_cur] || 0;
    this.effect_mission_table[_cur] <- num;
    return num > 0 && _local_num != num ? true : false;
  }

  function isShowedOPMovie() {
    return this.showed_op_movie;
  }
  function setShowedOPMovie() {
    this.showed_op_movie = true;
  }
}