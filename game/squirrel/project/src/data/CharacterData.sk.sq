class CharacterData {
  id = null;
  motion_list = null;
  recieved_motion_reward_index = -1;
  rental_costume_table = null;

  last_focus_talk = null;
  static FOCUS_TALK_INTERVAL = 60 * 60;

  enable_chara_sentence_list = null;

  static RESET_FURNITURE_TIME_SEC = 30;
  wanted_furniture_model = null;
  reset_wanted_furniture_time = -1;

  constructor() {
    motion_list = []
    recieved_motion_reward_index = -1;
    rental_costume_table = {};

    last_focus_talk = -1;

    enable_chara_sentence_list = [];
  }

  function loadWithCreate(loader) {
    local cd = ::CharacterData();
    cd.id = loader.get();

    local len = loader.get();
    cd.motion_list = [];
    for (local i = 0; i < len; i++) {
      cd.motion_list + loader.get();
    }
    cd.recieved_motion_reward_index = loader.get();

    len = loader.get();
    cd.rental_costume_table = {};
    for (local i = 0; i < len; i++) {
      local _key = loader.get();
      local _data = ::CharacterData.RentalCostumeData();
      _data.setData(loader.get(), loader.get());
      cd.rental_costume_table[_key] <- _data;
    }

    return cd;
  }

  function initMotions() {
    local _add_motions = ::gamesetting.game_rule.getInitialMotions();
    if (!_add_motions) return;

    local _udl = ::gamesession.getUserDataLocal();
    foreach (mid in _add_motions) {
      if (this.motion_list.indexOf(mid) < 0) {
        this.motion_list + mid;
      }
    }
  }

  function getID() {
    return this.id;
  }
  function getSetting() {
    return ::gamesetting.sanrio_chara_settings[this.id];
  }

  function hasMotion(mid) {
    if (this.motion_list.indexOf(mid) >= 0) return true;
    return false;
  }
  function addMotion(mid) {
    if (hasMotion(mid)) return;
    this.motion_list + mid;
  }
  function getMotionNums() {
    if (!this.motion_list) return 0;
    return this.motion_list.len();
  }

  function getMotions() {
    return this.motion_list;
  }

  function getRecievedMotionRewardIndex() {
    return this.recieved_motion_reward_index;
  }
  function setRecievedMotionRewardIndex(idx) {
    this.recieved_motion_reward_index = idx;
  }

  function getRentalCostume(cid) {
    return this.rental_costume_table[cid];
  }

  function setRentalCostume(cid, rental_cid, tl) {
    local _cs = ::gamesetting.costume_settings[cid];
    local _rental_data = this.rental_costume_table[cid];
    if (!_rental_data) {
      _rental_data = RentalCostumeData();
      this.rental_costume_table[cid] <- _rental_data;
    }
    _rental_data.setData(rental_cid, tl);
  }

  function canFocusTalk() {

    local _now = ::getServerTime();
    if (_now >= this.last_focus_talk + FOCUS_TALK_INTERVAL) return true;
    return false;
  }
  function setLastFocusTalkTime() {
    this.last_focus_talk = ::getServerTime();
  }

  function setupEnableCharaSentenceList(is_init = false) {
    if (is_init) {
      local _list = getSetting().getCharaSentenceIdList();
      this.enable_chara_sentence_list = [];
      foreach (sid in _list) {
        local _ss = ::gamesetting.chara_sentence_list_settings[sid];
        if (_ss && _ss.checkCondition()) this.enable_chara_sentence_list + _ss;
      }
    } else {
      local _list = clone this.enable_chara_sentence_list;
      this.enable_chara_sentence_list = [];
      foreach (_ss in _list) {
        if (_ss && _ss.checkCondition()) this.enable_chara_sentence_list + _ss;
      }
    }
  }

  function getSpecialCharaSentenceListSetting() {
    local _chara_setting = getSetting();
    local _list = _chara_setting.getCharaSentenceIdList();
    if (_list && _list.len() > 0) {
      return ::gamesetting.chara_sentence_list_settings[_list[0]];
    }
    return null;
  }

  function getRandamCharaSentenceListSetting(ignore_prev_actions = null) {
    if (this.enable_chara_sentence_list.len() > 0) {
      local _sprate = ::gamesetting.game_rule.getCharaSentenceSpecialRate();
      local _is_sp = ::PUBLIC_RANDOM.nexti(100) < _sprate ? true : false;
      if (_is_sp) {
        local MAX_NUM = 3;
        local _list = [];
        for (local i = 0; i < MAX_NUM; i++) {
          local _ss = this.enable_chara_sentence_list[i] || -1;
          if (_ss < 0) break;
          _list + _ss;
        }

        if (_list.len() > 0) {
          local _ss = Math.rndArray(_list);
          return _ss;
        }
      }
    }

    local _chara_key = getSetting().getTalkKey();
    local _is_highest_only = false;
    local _list = [];

    foreach (setting in ::gamesetting.chara_sentence_list_settings) {
      if (setting.getPriority() == ::CharaSentenceListSetting.PRIORITY_SPECIAL) continue;
      if (ignore_prev_actions && ignore_prev_actions.indexOf(setting.getPrevAction()) > 0) continue;

      if (setting.checkCondition()) {
        local _sl = setting.getSentenceList(_chara_key);
        if (!_sl) continue;

        if (!_is_highest_only) {
          if (setting.getPriority() == ::CharaSentenceListSetting.PRIORITY_HIGHEST) {
            _list = [];
            _is_highest_only = true;
          } else if (setting.getPriority() == ::CharaSentenceListSetting.PRIORITY_HIGH) {
            _list + setting;
          }
          _list + setting;
        } else {

          if (setting.getPriority() == ::CharaSentenceListSetting.PRIORITY_HIGHEST) _list + setting;
        }
      }
    }
    if (_list.len() == 0) return null;
    local _setting = Math.rndPick(_list);
    return _setting;
  }

  function getWantedFurnitureModel() {
    local _st = ::getServerTime();
    local _stage = ::gamesession.getCurrentScene().getStage();
    if (this.reset_wanted_furniture_time < _st || !_stage.existFurnitureModel(this.wanted_furniture_model, true)) {

      resetWantedFurnitureModel();
    }
    return this.wanted_furniture_model;
  }

  function resetWantedFurnitureModel() {

    this.reset_wanted_furniture_time = ::getServerTime() + RESET_FURNITURE_TIME_SEC;

    this.wanted_furniture_model = ::gamesession.getCurrentScene().getStage().getRandomFurnitureModel(true);
  }

}

class CharacterData.RentalCostumeData {
  costume_id = -1;
  time_limit = -1;

  constructor() {
  }

  function setData(cid, tl) {
    this.costume_id = cid;
    this.time_limit = tl;
  }

  function getCostumeID() {
    return costume_id;
  }

  function getTimeLimit() {
    return this.time_limit;
  }

  function enableUse() {
    return ::getServerTime() < this.time_limit;
  }
}