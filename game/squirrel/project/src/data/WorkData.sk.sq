with Serializable() {

  class WorkData {
    static SerialVersion = 1;

    static STATE_NONE = 0;
    static STATE_WORKING = 1;
    static STATE_FINISHED = 2;

    state = -1;

    start_time = -1;
    costume_id = -1;
    work_id = -1;
    room_id = -1;

    constructor() {
    }

    function createWorkData(cos_id, w_id, r_id, st) {
      local _wd = ::WorkData();
      _wd.costume_id = cos_id;
      _wd.work_id = w_id;
      _wd.room_id = r_id;
      _wd.start_time = st;
      _wd.state = ::WorkData.STATE_WORKING;
      return _wd;
    }

    function loadWorkData(loader) {
      this.state = loader.get();
      this.start_time = loader.get();
      this.costume_id = loader.get();
      this.work_id = loader.get();
      this.room_id = loader.get();
    }

    function getState() {
      return this.state;
    }

    function isWorking() {
      return this.state == STATE_WORKING;
    }

    function getCostumeID() {
      return this.costume_id;
    }

    function getWorkID() {
      return this.work_id;
    }

    function getRoomID() {
      return this.room_id;
    }

    function getStartTime() {
      return this.start_time;
    }

    function adjustStartTime(t) {
      this.start_time += t;
    }

    function isFinished(t) {
      return getFinishTime() <= t;
    }

    function isFinishedState() {
      return this.state == STATE_FINISHED;
    }

    function getFinishTime() {
      return getStartTime() + getSetting().time;
    }

    function getRemainingTime(t) {
      local _rt = getFinishTime() - t;
      if (_rt < 0) _rt = 0;
      return _rt;
    }

    function getSetting() {
      return ::gamesetting.costume_action_settings[this.work_id];
    }

    function getUseHealth() {
      return getSetting().getUseHealth();
    }
  }

}