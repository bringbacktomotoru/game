class ARCharaModel extends ARModel {
  static LINK_ACTION_INTERVAL = 3000;
  static FOCUS_CHECK_TIME = 3000;
  static MOVE_ACTION_THRESHOLD = 100;
  static DASH_SPEED = 1.1;

  sk3d = null;
  b3body = null;

  is_auto_action = true;
  tasks = null;
  current_script_name = null;
  current_action_id = null;
  random_action_state = null;
  target_furniture_uid = null;
  is_furniture_script = null;
  action = null;
  actiontime = 0;
  action_target = null;

  speed = 6.0;

  actions = {};
  turn_action = null;
  tefuri_action = null;
  neutral_action = null;
  walk_action = null;
  dash_action = null;
  last_furniture_try = -1;
  approach_lock = false;
  approach_lock_time = -1;
  last_tap_time = -1;

  attracted_target = null;
  lose_attract_time = null;

  last_use_furniture = null;
  last_use_furniture_time = -1;

  only_move_action = false;
  furniture_end_counter = -1;

  first_action = true;

  is_dark = false;

  costume_id = null;

  modifier_param = null;
  effect_runner = null;

  interval_id = -1;
  prop_id = -1;

  link_charas = null;
  link_host = null;
  last_link_time = -1;

  reserve_id = null;

  pause_bound = false;

  tapped_script = null;

  focus_time = -1;

  route_move_action = false;

  constructor(scene) {
    super(scene);

    this.tasks = [];
    createCharaActions();

    random_action_state = -1;
    current_action_id = -1;
    is_furniture_script = false;

    turn_action = ::gamesetting.action_settings[30];

    tefuri_action = ::gamesetting.action_settings[1000];
    setDefaultAction();

    this.target_furniture_uid = -1;
    this.last_furniture_try = -1;
    this.last_link_time = -1;
  }

  function _createB3body() {
    if (!this.sk3d) return;
    if (this.b3body) this.scene.b3world.removeBody(this.b3body);
    local _bnd = this.sk3d.bnd;
    local pm = ::PrimitiveMeshes.createBox(_bnd.r, _bnd.s, _bnd.t);
    local shp = b3Shape.createMesh(pm.vtx.getStream(SK_POSITION), [pm.face[0].idx]);
    b3body = b3Body(0.0, shp, Matrix(), ::ViewFactory.RAYTEST_GROUP, ::ViewFactory.RAYTEST_MASK);
    b3body.updateAABB();
  }

  function build(is_init = true, capture_model = null, susp = false, rebuild_attr = null) {
    if (this.reserve_id) {
      clearInterval(this.reserve_id);
      this.reserve_id = null;
    }

    local _chara_id = ::gamesetting.costume_settings[costume_id].getCharaID();
    this.capture_model = capture_model;

    local _attr = null;
    this.sk3d = ::viewfactory.createUserCharaView(_chara_id, costume_id, 3.0, susp);
    this.sk3d.setCaptureModel(this.capture_model != null);
    if (susp) suspend();
    addToStage(is_init);
    setAutoAction(false);

    if (rebuild_attr) {
      resetLink();
      setPos(rebuild_attr.pos);
      setRotation(rebuild_attr.rot);
    }
  }

  function addToStage(is_init = true) {
    if (this.b3body) this.scene.b3world.addBody(this.b3body);

    this.scene.addObject(this.sk3d);

    shadow_obj = _createShadow();
    shadow_obj.scale.scale(0.3);
    shadow_obj.updateMatrix();
    this.sk3d.scn.addObject(shadow_obj);
    this.sk3d.addChild(shadow_obj);

    local _chara_id = getCostumeData().getCharaID();
    local _chara_setting = ::gamesetting.sanrio_chara_settings[_chara_id];
    if (_chara_setting.efx_script) {
      local script_res = ::getResource(_chara_setting.efx_script);
      if (script_res) {
        this.setEffectScript(script_res);
        this.startEffect("start");
      }
      this.registerModifierParameters();
    }

    if (this.b3body) this.scene.b3world.removeBody(this.b3body);
    _createB3body();
    this.scene.b3world.addBody(this.b3body);

    if (is_init) {
      startScript("start");
    } else {
      clearActionParameters(false);
    }

    if (capture_model) {
      local _seed = this.sk3d.scprunner.changeRandomSeed(true);
      capture_model.sk3d.scprunner.setSeed(_seed);
    }

  }

  function removeShadow() {
    if (!shadow_obj) return;
    sk3d.removeChild(shadow_obj);
    shadow_obj.parent = null;
    scene.removeObject(shadow_obj);

    shadow_obj = null;
    if (capture_model) capture_model.removeShadow();
  }

  function _createShadow() {
    return SK3DObject("/res/shadow/shadow_1.pm");
  }

  function shadowVisible(b) {
    this.shadow_obj.setVisible(b);
    if (capture_model) capture_model.shadowVisible(b);
  }

  function _particleEmitter() {
    local _emit = with ParticleEmitter() {
      num = 1
      start = 0, start_spr = 0
      life = 10000, life_spr = 10000
      posx = 0.0, posy = 0.0, posz = 0.0
      pos_sprx = 0.0, pos_spry = 0.0, pos_sprz = 0.0
      dirx = 0.0, diry = 0.0, dirz = 0.0
      dir_sprx = 0, dir_spry = 0.0, dir_sprz = 0
    };
    return _emit;
  }

  function startUpdate() {

    this.tasks + _createTurnAction(0);
    this.tasks + _createScriptAction(tefuri_action);
    changeAction(this.tasks[0]);
    if (capture_model) {
      capture_model.startUpdate();
    }
  }

  function release() {
    if (capture_model) {
      capture_model.release();
    }
    capture_model = null;

    removeShadow();

    if (this.sk3d.parent) this.sk3d.removeFromParent();
    if (this.b3body) {
      this.scene.b3world.removeBody(this.b3body);
      this.b3body = null;
    }

    if (interval_id != -1) {
      clearInterval(interval_id);
      interval_id = 0;
    }
    if (this.reserve_id) {
      clearInterval(this.reserve_id);
      this.reserve_id = null;
    }

    this.scene.removeObject(this.sk3d);
  }

  function createTapScriptAction(rot_h) {
    local _tasks = [];
    _tasks + _createTurnAction(rot_h);
    local _tap_script = ::gamesetting.costume_settings[costume_id].getTapScript();
    _tasks + _createScriptNameAction(_tap_script);
    return _tasks;
  }

  function update(dt) {
    if (b3body) _updateB3body();

    local _now = skGetTime();

    if (this.attracted_target && (this.lose_attract_time < _now || this.attracted_target.hasProductData())) {
      this.attracted_target.removeAttractChara(this);
      this.attracted_target = null;
      clearTasks();
    }

    if (!action) {
      if (_getNewAction()) {
        changeAction(this.tasks[0]);
        if (this.capture_model) this.capture_model.changeAction(this.capture_model.tasks[0]);
        this.approach_lock = false;
      }
      else {
        startCharaScriptAction("stand");
      }
    }

    if (action) action.update(dt, this);
    if (effect_runner) effect_runner.update(dt);

    if (is_dark) {
      local l_hand = sk3d.findByName("l_hand");
      local materials = l_hand.getMaterials();
      foreach (mate in materials) mate["colormat"] = Matrix.fromHSV(0, 0.5, 0.5);
      local r_hand = sk3d.findByName("r_hand");
      materials = r_hand.getMaterials();
      foreach (mate in materials) mate["colormat"] = Matrix.fromHSV(0, 0.5, 0.5);
    }

    if (capture_model) {
      capture_model.update(dt);

    }

    return true;
  }

  function _focusCheck(t) {
    local _fc = this.model_viewer.getFocusChara();
    if (this.model_viewer.getFocusLock() || isInLinkAction() || isFurnitureScriptRunning()) {
      this.focus_time = -1;
    }
    else if (!_fc) {
      if (isInCenter()) {
        if (this.focus_time < 0) {
          this.focus_time = t;
        }
        else if (this.focus_time + FOCUS_CHECK_TIME < t) {
          this.model_viewer.setFocusChara(this);
        }
      }
      else {
        this.focus_time = -1;
      }
    }
    else if (_fc == this) {
      if (isInCenter()) {
        this.model_viewer.updateFocusTime();
      }
    }
    else {
      this.focus_time = -1;
    }
  }

  function _updateB3body() {
    local _v1 = Vector3D(this.sk3d.pos);
    if (this.sk3d.parent) _v1.add(this.sk3d.parent.pos);

    local _bnd = this.sk3d.bnd;
    b3body.setTransform(Matrix.fromTranslate(_v1.x + (_bnd.x + _bnd.r) / 2, _v1.y + (_bnd.y + _bnd.s) / 2, _v1.z + (_bnd.z + _bnd.t) / 2));
  }
  function getB3body() {
    return this.b3body;
  }

  function setPauseBound(b) {
    this.pause_bound = b;
  }
  function getPauseBound() {
    return this.pause_bound;
  }

  function inBoundOtherModel(mypos) {
    if (getTargetFurnitureUID() != -1) return null;
    if (!capture_model) return null;

    return model_viewer.inBoundOtherModel(this, mypos);
  }

  function checkHit(p1, p2, bnd2) {
    local bnd1 = this.sk3d.bnd;
    local _x1 = p1.x + bnd1.x; local _y1 = p1.y + bnd1.y; local _z1 = p1.z + bnd1.z;
    local _x2 = p2.x + bnd2.x; local _y2 = p2.y + bnd2.y; local _z2 = p2.z + bnd2.z;

    return _x1 + bnd1.r > _x2 - bnd2.r && _x1 - bnd1.r < _x2 + bnd2.r
    && _y1 + bnd1.s > _y2 - bnd2.s && _y1 - bnd1.s < _y2 + bnd2.s
    && _z1 + bnd1.t > _z2 - bnd2.t && _z1 - bnd1.t < _z2 + bnd2.t;
  }

  function initPos(param = null) {
    setPosXYZ(0, 0, 0);
    setAngle(Math.PI / 2 * Math.RTOD);
    sk3d.anime(10, 26, 2.0, -1);

    if (capture_model) capture_model.initPos(param);
  }

  function inBounds(pos) {

    if (!this.sk3d) return false;

    local _pos = getPos();

    local bnd = this.sk3d.bnd;
    local cx = _pos.x + bnd.x;
    local cy = _pos.y + bnd.y;
    local cz = _pos.z + bnd.z;

    return cx - bnd.r < pos.x && cx + bnd.r > pos.x
    && cy - bnd.s < pos.y && cy + bnd.s > pos.y
    && cz - bnd.t < pos.z && cz + bnd.t > pos.z;

  }

  function setDefaultAction() {
    local _stand_id = DEFAULT_ACTION_STAND;
    local _walk_id = DEFAULT_ACTION_WALK;
    local _dash_id = DEFAULT_ACTION_DASH;
    local _ps = ::gamesetting.prop_settings[this.prop_id];
    if (_ps) {
      _stand_id = _ps.getStandMotion();
      _walk_id = _ps.getWalkMotion();
      _dash_id = _ps.getDashMotion();
    }
    this.neutral_action = ::gamesetting.action_settings[_stand_id];
    this.walk_action = ::gamesetting.action_settings[_walk_id];
    this.dash_action = ::gamesetting.action_settings[_dash_id];
  }

  function changeAction(ad) {
    if (!ad) {

      this.action = null;
      return;
    }
    ad.convertCaptureModel(this);
    this.action = clone ad.action;
    action.startAction(this, ad);
  }

  function _getNewAction() {
    local _tasks = [];

    this.approach_lock = false;

    if (this.is_auto_action && getTargetFurnitureUID() == -1) {
      if (first_action) {
        _tasks.extend(_firstAction());
        first_action = false;
      } else {

        local _now = skGetTime();

        if (this.attracted_target && this.lose_attract_time > _now) {
          local _t = _createMoveToTargetNearList(this.attracted_target.getPos(), ::CharaModel.USE_FURNITURE_DISTANCE * 0.9);

          if (_t.len() < 1) {
            _t + _createIdleAction(neutral_action, 1000);
          }
          _tasks.extend(_t);
        } else if (isPlayRandomAction()) {
          if (::PUBLIC_RANDOM.nexti(100) < 3 && this.last_link_time + LINK_ACTION_INTERVAL < _now) {
            local _cm = this.model_viewer.getNearRandomActionChara(this);
            if (_cm) {
              setLinkAction(_cm);
              return false;
            }
          }
          _tasks.extend(createRandomAction());
        } else if (isPlayNoMoveAction()) {
          _tasks + getRandomActionTask(true);
        } else {
          _tasks + _createIdleAction(neutral_action, 30000);
        }
      }
    }
    if (_tasks.len() < 1) return false;
    tasks.extend(_tasks);
    if (capture_model) {
      local _tasks2 = [];
      foreach (_task in _tasks) {
        _tasks2 + _task.getDeepClone()
      }

      capture_model.getTasks().extend(clone _tasks2);
      println("capture_model_tasks.len():" + capture_model.getTasks().len() + " this.len():" + tasks.len());
    }

    return capture_model && capture_model.getTasks().len() > this.tasks.len();
  }

  function createRandomAction() {

    if (!is_auto_action) return null;
    local _script_name = getCurrentScriptName();
    local _candidates = _createCandidateActionList(_script_name);

    local _total_frequency = _calcTotalFreqActionList(_candidates);

    local _action_setting = _drawLotsAction(_total_frequency, _candidates);
    if (!_action_setting) return null;

    println("_candidates.len():" + _candidates.len() + " _total_frequency:" + _total_frequency + " _action_setting.id:" + _action_setting.id + " type:" + _action_setting.action_type);

    local _tasks = [];

    switch (_action_setting.action_type) {
    case ActionSetting.IDLE:
      _tasks + _createIdleAction(_action_setting, 1500);
      break;
    case ActionSetting.ACTION:
      _tasks + _createScriptAction(_action_setting);
      break;
    case ActionSetting.MOVE:
      if (is_AR_mode) {
        if (this.model_viewer.getHouseManager().getRoomInfo()) {
          _tasks.extend(_createMoveInRoomActionList(_action_setting));
        }
        else {
          local _MAX_FORMULATE_NUM = 10;
          local _v = Vector3D();
          local _in_rectangle = null;

          local _rectangle = ar_module.getRectangle(getPos(), true);

          if (!_rectangle) {
            _tasks + _createIdleAction(neutral_action, 3000);
          } else {

            if (_rectangle.getVertexes().len() > 0) {
              local _pos_min = _rectangle.getPosMin();
              local _pos_max = _rectangle.getPosMax();
              local _ra = _rectangle.getVertexes();
              local _v1 = getRotation() * Vector3D(0.0, 0.0, -1.0);
              for (local i = 0; i < _MAX_FORMULATE_NUM; i++) {

                _v.set(::PUBLIC_RANDOM.nextf(_pos_min.x, _pos_max.x), _ra[0].position_.y, ::PUBLIC_RANDOM.nextf(_pos_min.z, _pos_max.z));

                _in_rectangle = _rectangle.isInRectangle(_v);

                if (!_in_rectangle) continue;

                if (only_move_action) {

                  local _v2 = _in_rectangle - getPos();
                  local _cos_theta = (_v1.dot(_v2) / (_v1.length() * _v2.length()));
                  local _deg = Math.abs(Math.acos(_cos_theta) * Math.RTOD);
                  if (_deg > 180.0) _deg -= 180.0;
                  if (_deg < 110.0) continue;
                }

                if (::PUBLIC_RANDOM.nexti(100) < 50) {

                  _tasks + getRandomActionTask();
                }

                local dir = _getDiffHead(getPos(), _in_rectangle);
                _tasks + _createTurnAction(dir);
                _tasks + _createMoveAction(_action_setting, _in_rectangle);
                only_move_action = false;
                break;
              }

              if (only_move_action) {
                only_move_action = false;
                return createRandomAction();
              }
            } else {
              _tasks.extend(_stepAction(_action_setting));
            }

            if (!_in_rectangle) _tasks + _createIdleAction(neutral_action, 3000);
          }
        }
      } else {
        _tasks.extend(_stepAction(_action_setting));
      }
      break;
    }
    return _tasks;
  }

  function _firstAction() {
    local _first_action = ::gamesetting.action_settings[0];
    local _tasks = [];

    _tasks + _createTurnAction(0);
    _tasks + _createScriptAction(_first_action);
    return _tasks;
  }

  function _stepAction(action_setting, is_random_action = true) {
    local _tasks = [];
    if (is_random_action && ::PUBLIC_RANDOM.nexti(100) < 50) {

      _tasks + getRandomActionTask();
    }
    local _time = 1500 + ::PUBLIC_RANDOM.nexti(1500);
    _tasks + _createMoveAction(action_setting, null, _time);
    return _tasks;
  }

  function _drawLotsAction(frequency, list) {

    local action_setting = null;
    if (frequency == 0) return neutral_action;
    else {
      local val = ::PUBLIC_RANDOM.nexti(frequency);
      foreach (setting in list) {
        val -= setting.frequency;
        if (val > 0) continue;
        return setting;
      }
    }
    return null;
  }

  function _getRandomLinkActionSetting() {
    local _list = [];
    local _freq = 0;
    foreach (_setting in ::gamesetting.action_settings) {
      if (!_setting.isLinkAction()) continue;
      _list + _setting;
      _freq += _setting.getFreq();
    }

    return _drawLotsAction(_freq, _list);
  }

  function setLinkAction(linked_cm) {
    local _link_setting = _getRandomLinkActionSetting();
    if (!_link_setting) return;
    setAutoAction(false);
    setRandomAction(false);

    this.link_charas = [];
    this.link_charas + linked_cm;

    linked_cm.approachLinkHost(this, _link_setting);

    local _tasks = [];
    _tasks + _createTurnAction(_getDiffHead(this.getPos(), linked_cm.getPos()));
    _tasks + _createIdleLinkAction(this.neutral_action, true, this.link_charas, 30 * 1000);
    _tasks + _createScriptLinkAction(_link_setting, true, this.link_charas, this.link_charas);

    setupTasks(_tasks);
  }

  function approachLinkHost(link_host, _setting) {
    this.link_host = link_host;
    setAutoAction(false);
    setRandomAction(false);

    clearTasks(true, true, true, false);

    local _tasks = [];

    _tasks.extend(_createMoveToTargetNearList(link_host.getPos(), 2.0));

    local _stay_action_setting = _setting.getWaitActionSetting();
    _tasks + _createIdleLinkAction(_stay_action_setting, false, null, 10 * 1000);

    setupTasks(_tasks);
  }

  function resetLink(is_clear_tasks = true, called_child = false) {
    this.last_link_time = skGetTime();

    if (this.link_host && !called_child) {
      this.link_host.resetLink(is_clear_tasks, true);
      return;
    }

    this.link_host = null;

    setAutoAction(false);
    setRandomAction(true);
    if (is_clear_tasks) clearTasks();
    endAction();

    if (this.link_charas) {
      foreach (cm in this.link_charas) {
        cm.resetLink(is_clear_tasks, called_child);
      }
      this.link_charas.clear();
    }

  }

  function clearLinkParameters(is_clear_tasks) {
    this.last_link_time = skGetTime();
    this.link_host = null;
    setAutoAction(false);
    setRandomAction(true);
    if (is_clear_tasks) clearTasks();
    endAction();
  }

  function isInLinkAction() {
    if ((this.link_charas == null || this.link_charas.len() == 0) && !this.link_host) return false;
    return true;
  }

  function getLinkHost() {
    return this.link_host;
  }

  function approachFurniture(furniture_model, bone = null) {
    if (!this.canInterruptAction()) return;

    startScript("end_common");

    clearActionParameters(false);

    setTargetFurnitureUID(furniture_model.getFurnitureData().getUID());
    setRandomAction(false);

    this.attracted_target = null;
    this.lose_attract_time = -1;

    this.tasks.extend(_createApproachFurnitureActionList(furniture_model, bone));
    _writeModelActions();
  }

  function tryUseFurniture() {
    if (::DISABLE_TRIAL) return;
    local _scene = ::gamesession.getCurrentScene();
    local _chara_id = getCostumeData().getCharaID();
    if (getTargetFurnitureUID() != -1) {
      return;
    }

    if (!isPlayRandomAction()) return;

    if (isInLinkAction()) {
      return;
    }

    local _now = skGetTime();
    if (_now < this.last_furniture_try + ::CharaModel.RETRY_FURNITURE_TIME) {
      return;
    }

    local _fm = this.attracted_target;
    if (_fm) {
      if (!_is2RectCollided(_fm)) {
        return;
      }
    } else {
      local _nearest = this.model_viewer.getNearestFurnitureModel(getPos(), this.capture_model == null);
      _fm = _nearest.fm;
      if (!_fm) {
        return;
      }
      if (!_is2RectCollided(_fm)) {
        return;
      }
    }

    if (this.last_use_furniture_time + ::CharaModel.USE_FURNITURE_COOL_TIME > _now) {
      return;
    }

    local ret = ::CharaModel.getTryUseFurnitureResult(this.last_tap_time, _now, _fm, costume_id);
    if (ret) {
      if (attracted_target) attracted_target.removeAttractChara(this);
      local _uid = _fm.getFurnitureData().getUID();
      startFurnitureAction(_uid, _chara_id);

      if (capture_model) {

        capture_model.startFurnitureAction(_uid, _chara_id);
      }
    }
    else {
      this.last_furniture_try = _now;
      this.approach_lock = true;
    }

  }

  function _is2RectCollided(fm) {
    local cp = getPos();
    local fp = fm.getPos();

    local _fs = fm.getFurnitureSetting();

    return ::is2RectCollided(cp.x, cp.z, ::CharaModel.USE_FURNITURE_DISTANCE, ::CharaModel.USE_FURNITURE_DISTANCE, 0.0, fp.x, fp.z, _fs.size_w, _fs.size_d, fm.getAngle() * Math.DTOR);
  }

  function startFurnitureAction(uid, chara_id) {
    local fm = model_viewer.getFurnitureModel(uid, this.capture_model == null);
    local _bone_list = [];
    local _pos_list = fm.getFurnitureSetting().getActionPosData();
    foreach (pos in _pos_list) {
      local _bone = pos["bone"] || null;
      _bone_list + _bone;
    }

    local _chara_table = {};
    _chara_table[chara_id] <- _bone_list[0];
    fm.setFurnitureAction(_chara_table);
  }

  function reduceRetryUseFurnitureTime(t) {
    this.last_furniture_try -= t;
    this.last_tap_time = skGetTime();
    if (capture_model) capture_model.reduceRetryUseFurnitureTime(t);
  }

  function _writeModelActions() {
    if (capture_model) {
      capture_model.clearActionParameters();

      writeToCaptureModel();
    }
    changeAction(this.tasks[0]);

    if (capture_model) {
      local _tasks2 = [];
      foreach (task in tasks) {
        _tasks2 + task.getDeepClone();
      }
      capture_model.tasks.extend(_tasks2);
      capture_model.changeAction(capture_model.tasks[0]);
    }
  }

  function shortApproachPosition(p) {
    if (getTargetFurnitureUID() > 0) return false;
    if (this.approach_lock_time > skGetTime()) return false;
    if (this.approach_lock) return false;
    if (!this.canInterruptAction()) return false;

    setRandomAction(false);

    this.approach_lock = true;
    this.last_tap_time = skGetTime();
    this.approach_lock_time = last_tap_time + ::CharaModel.APPROACH_LOCK_TIME + 1000;
    clearActionParameters(false);

    this.tasks.extend(_createShortMoveToTarget(p));

    _writeModelActions();

    return true;
  }

  function approachAttractModel(am) {
    if (getTargetFurnitureUID() > 0) return false;
    if (!this.canInterruptAction()) return false;
    if (isInLinkAction()) return false;

    this.approach_lock = true;
    clearTasks();

    setRandomAction(false);

    local _now = skGetTime();
    this.last_tap_time = _now;
    this.lose_attract_time = _now + ::SanrioGameScene.CHARACTER_APPROACH_LIMIT;
    if (this.attracted_target) attracted_target.removeAttractChara(this);
    this.attracted_target = am;

    local _tasks = _createMoveToTargetNearList(am.getPos(), ::CharaModel.USE_FURNITURE_DISTANCE * 0.9);
    this.tasks.extend(_tasks);

    _writeModelActions();

    return true;
  }

  function updateAttractTime() {
    local _now = skGetTime();
    this.lose_attract_time = _now + ::SanrioGameScene.CHARACTER_APPROACH_LIMIT;
    this.last_tap_time = _now;
  }
  function getLoseAttractTime() {
    return this.lose_attract_time;
  }
  function hasAttractTarget() {
    return this.attracted_target ? true : false;
  }
  function getAttractTarget() {
    return this.attracted_target;
  }

  function resetAttractTarget() {
    if (!hasAttractTarget()) return;
    this.attracted_target.removeAttractChara(this);
    this.attracted_target = null;
  }

  function lookAt(p) {
    local _now = skGetTime();
    if (getTargetFurnitureUID() > 0) return false;
    if (this.approach_lock_time > _now) return false;
    if (this.approach_lock) return false;
    if (!this.canInterruptAction()) return false;

    this.approach_lock = true;
    this.approach_lock_time = _now + ::CharaModel.APPROACH_LOCK_TIME + 1000;

    clearActionParameters(false);

    this.last_tap_time = _now;
    setRandomAction(false);

    this.tasks.extend(_createLookAtTarget(p));

    _writeModelActions();

    return true;
  }

  function clearAction(random_action_reset = true, force = false) {
    if (!force && !this.canInterruptAction()) return;

    clearTasks();

    current_action_id = -1;
    if (random_action_reset) random_action_state = -1;

    _getNewAction();
    changeAction(this.tasks[0]);

    if (this.capture_model) this.capture_model.changeAction(this.capture_model.tasks[0]);

  }

  function clearActionParameters(start_script = true) {
    if (start_script) startScript("end_common");
    this.tasks.clear();
    this.actiontime = 0;
    this.action_target = null;
    this.route_move_action = false;
  }

  function clearModifiers() {
    if (sk3d) sk3d.clearModifiers();
  }

  function startCharaScriptAction(script, scp_args = null, is_turn_front = true, can_interrupt = true) {

    if (getTargetFurnitureUID() != -1 || !canInterruptAction()) return false;

    if (isInLinkAction() || hasAttractTarget()) return false;

    setRandomAction(false);
    local _tasks = [];

    if (is_turn_front && !route_move_action) {

      _tasks + _createTurnAction(_getDiffHead(getPos(), this.model_viewer.getFixedCameraPos()));
    }
    _tasks + _createScriptNameAction(script, null, scp_args);

    if (route_move_action) {

      foreach (idx, _task in _tasks) {
        this.tasks[idx] <- _task;
      }
      _writeModelActions();
    } else {
      if (_tasks) setupTasks(_tasks);
    }

    if (!can_interrupt) setCanInterruptAction(false);

    return true;
  }

  function setCanInterruptAction(b) {
    if (!this.tasks) return;
    foreach (t in this.tasks) {
      t.setCanInterruptAction(b);
    }
  }

  function startMoveAction(target) {
    if (getTargetFurnitureUID() > 0) return false;
    if (!this.canInterruptAction()) return false;

    clearActionParameters();

    this.tasks.extend(_createMoveToTarget(target));
    _writeModelActions();

    return true;
  }

  function startRouteMoveAction(route) {
    if (!route || route.len() < 2) return;
    if (getTargetFurnitureUID() > 0) return;
    if (!this.canInterruptAction()) return;

    clearActionParameters();

    local _tasks = [];
    local _prev = null;
    local _prev_turn_dir = 1000;

    local _THETA = 45;
    foreach (idx, r in route) {

      local _turn_dir;
      if (_prev) _turn_dir = _getDiffHead(_prev.pos, r.pos);
      else _turn_dir = _getDiffHead(getPos(), r.pos);

      local _dig = _turn_dir * Math.RTOD;
      local _tmp = _prev_turn_dir;
      if (_prev_turn_dir > 360 - _THETA && _dig < _THETA) _dig += 360;
      else if (_dig > 360 - _THETA && _prev_turn_dir < _THETA) _tmp += 360;

      local _action = !_prev ? walk_action : (r.timestamp - _prev.timestamp > MOVE_ACTION_THRESHOLD ? walk_action : dash_action);

      if (Math.abs(_prev_turn_dir - _dig) > _THETA) {
        _prev_turn_dir = _dig;
        _tasks + _createTurnAction(_turn_dir);
        _tasks + _createMoveAction(_action, r.pos, 0);
      } else {

        _tasks + _createLookToMoveAction(_action, r.pos, 0, DASH_SPEED);
      }
      _prev = r;
    }
    this.tasks.extend(_tasks);

    routeMoveAction(true);

    _writeModelActions();
  }

  function routeMoveAction(b) {
    route_move_action = b;
    if (capture_model) capture_model.routeMoveAction(b);
  }

  function reserveTasks(tasks, time) {
    if (this.reserve_id) {
      clearInterval(this.reserve_id);
      this.reserve_id = null;
    }
    local _env = {
      self = this,
      tasks = tasks
    };

    this.reserve_id = setTimeout(_doReserveTasks.bindenv(_env), time);
  }

  function _doReserveTasks() {
    if (self.reserve_id) {
      clearInterval(self.reserve_id);
      self.reserve_id = null;
    }

    if (!self.canInterruptAction()) return;
    self.clearTasks();
    self.setupTasks(tasks);
  }

  function clearTasks(start_end_common = true, reset_furniture_uid = true, write_to_capture = true, reset_link = true) {
    if (reset_link) {
      resetLink(false);
    }
    if (start_end_common) {
      startScript("end_common");
    }
    this.action = null;

    if (this == this.model_viewer.getCurrentChara()) {
      this.model_viewer.clearMoveRoute(false);
    }

    clearActionParameters(false);

    if (reset_furniture_uid) resetTargetFurnitureUID();
    if (this.capture_model) {
      capture_model.clearTasks(start_end_common, reset_furniture_uid);

      routeMoveAction(false);

      if (write_to_capture) writeToCaptureModel();
    }
  }

  function isActionEnd() {
    return action.isActionEnd(this);
  }

  function canInterruptAction() {
    return action ? action.canInterruptAction() : true;
  }

  function endAction() {

    if (tasks[0]) {
      println("action_target clear:endAction. tasks[0]:" + tasks[0].scp_id + " iscapturemodel:" + isCaptureModel());
      delete this.tasks[0];
    }
    this.actiontime = 0;
    this.action_target = null;

    if (is_auto_action) tryUseFurniture();

    if (!isPlayRandomAction()) setRandomAction(true);

    local _b = false;
    if (!(0 in this.tasks)) {
      routeMoveAction(false);
      _b = _getNewAction();

    }
    changeAction(this.tasks[0]);
  }

  function resetPhysicalBones() {
    sk3d.matdirty = true;
    sk3d.disablePhysicalBones();
    sk3d.enablePhysicalBones();

    if (capture_model) {
      capture_model.resetPhysicalBones();
    }
  }

  function setupTasks(tasks) {
    if (tasks[0]) {
      println("action_target clear:setupTasks. tasks[0]:" + tasks[0].scp_id);
      clearActionParameters(false);
    }

    this.tasks.extend(tasks);
    _writeModelActions();
  }

  function getScriptActionTasks(action_id = -1) {

    if (isPlayRandomAction()) {
      return createRandomAction();
    } else if (isPlayNoMoveAction()) {
      local _tasks = [];
      _tasks + getRandomActionTask(true);
      return _tasks;
    } else {
      local candidates = [];
      local action_settings = ::gamesetting.room_motion_settings;
      local tasks = [];
      local _action_id = action_id != -1 ? action_id : current_action_id;
      if (_action_id in action_settings) {
        local _setting = action_settings[_action_id];
        if (_setting.action_type == ::ActionSetting.ACTION || _setting.action_type == ::ActionSetting.IDLE) {
          tasks + _createScriptAction(_setting);
          current_action_id = _action_id;
        } else if (_setting.action_type == ::ActionSetting.MOVE) {
          tasks.extend(_stepAction(_setting, false));
          current_action_id = _action_id;
        }
      }
      return tasks.len() >= 1 ? tasks : null;
    }
    return null;
  }

  function _getDiffHead(pos1, pos2) {
    if (!pos1 || !pos2) return 0.0;

    local x = pos1.x - pos2.x;
    local y = pos1.y - pos2.y;
    local z = pos1.z - pos2.z;
    return _getVecHead(x, z);
  }

  function _hasDirDiff(angle1, angle2) {
    return (angle2 - angle1) % (Math.PI * 2) != 0.0;
  }

  function _getVecHead(x, z) {
    if (x == 0.0) return z >= 0.0 ? 0.0 : Math.PI;
    else {
      if (x > 0.0) return Math.PI / 2 - Math.atan(z / x);
      else return Math.PI * 3 / 2 - Math.atan(z / x);
    }
  }

  function _createMoveInRoomActionList(setting) {

    local tasks = [];

    local PI = Math.PI;
    local PI2 = PI * 2;
    local PIh = PI / 2;

    local prev_target_pos = Vector3D();
    local target_pos = Vector3D().set(getPos());
    local prev_target_angle = 0.0;
    local target_angle = getAngle();

    local _info = this.model_viewer.getHouseManager().getRoomInfo();
    local paths = _info.getRoute(getPos(), _info.getRandomNodePos());
    local floor_depth = 0.0;

    foreach (path in paths) {
      prev_target_pos.set(target_pos);
      target_pos = Vector3D(path.x, floor_depth, path.z);
      if (_getDistances(prev_target_pos, target_pos) > 0.0) {
        prev_target_angle = target_angle;
        target_angle = _getDiffHead(prev_target_pos, target_pos);
        if (_hasDirDiff(prev_target_angle, target_angle)) {
          tasks + _createTurnAction(target_angle);
        }
        tasks + _createMoveAction(setting, target_pos);
      }
    }

    return tasks;
  }

  function _getDistances(v_1, v_2) {
    local x_diff = v_1.x - v_2.x;
    local y_diff = v_1.y - v_2.y;
    local z_diff = v_1.z - v_2.z;
    return Math.sqrt(x_diff * x_diff + y_diff * y_diff + z_diff * z_diff);
  }

  function _createShortMoveToTarget(tp) {
    local tasks = [];

    local _chara_pos = getPos();
    local _turn_dir = _getDiffHead(_chara_pos, tp);
    local _move_pos = Vector3D();
    _move_pos.x = _chara_pos.x - Math.sin(_turn_dir) * 2.0;
    _move_pos.y = _chara_pos.y;
    _move_pos.z = _chara_pos.z - Math.cos(_turn_dir) * 2.0;

    tasks + _createTurnAction(_turn_dir);
    tasks + _createMoveAction(walk_action, _move_pos);
    return tasks;
  }

  function _createMoveToTargetNearList(tp, dist = 0.0) {
    local tasks = [];

    local _info = this.model_viewer.getHouseManager().getRoomInfo();
    if (_info) {
      local _near_pos = _info.getEnabledNodeByVortex(tp.x, tp.z);
      local _route = _info.getRoute(getPos(), _near_pos);
      local _move_num = Math.min(length(_route), 6);
      local _points = [];
      for (local i = 0; i < _move_num; i++) {
        _points + _route[i];
      }
      tasks.extend(createPointsMoveActionList(_points));
    }
    else {
      local _turn_dir = _getDiffHead(getPos(), tp);
      v_1.set(tp).sub(dist * Math.sin(_turn_dir), 0, dist * Math.cos(_turn_dir));

      tasks + _createTurnAction(_turn_dir);
      tasks + _createMoveAction(walk_action, Vector3D(0, 0, 0).set(v_1));
    }

    return tasks;
  }

  function _createMoveToTarget(tp) {
    local tasks = [];

    local _info = this.model_viewer.getHouseManager().getRoomInfo();
    if (_info) {
      local _near_pos = _info.getEnabledNodeByVortex(tp.x, tp.z);
      local _route = _info.getRoute(getPos(), _near_pos);
      local _move_num = length(_route);
      local _points = [];
      for (local i = 0; i < _move_num; i++) {

        _route[i].y -= ::HouseModel.FLOOR_DEPTH;
        if (_route[i].y < 0.0) _route[i].y = 0.0;
        _points + _route[i];
      }
      tasks.extend(createPointsMoveActionList(_points));
    }
    else {
      local _turn_dir = _getDiffHead(getPos(), tp);

      tasks + _createTurnAction(_turn_dir);
      tasks + _createMoveAction(walk_action, tp);
    }

    return tasks;
  }

  function createPointsMoveActionList(points) {
    local tasks = [];

    local curr = points[0];
    local dir = getAngle() * Math.DTOR;
    foreach (next in points) {
      if (curr.equals(next)) continue;

      local target_dir = _getDiffHead(curr, next);
      if (_hasDirDiff(dir, target_dir)) {
        tasks + _createTurnAction(target_dir);
      }

      tasks + _createMoveAction(walk_action, next);

      curr = next;
      dir = target_dir;
    }

    return tasks;
  }

  function _createLookAtTarget(tp) {
    local tasks = [];
    tasks + _createTurnAction(_getDiffHead(getPos(), tp));
    return tasks;
  }

  function createStartCharaScriptActionTasks(script, scp_args = null, is_turn_front = true) {
    local _tasks = [];
    if (is_turn_front) {
      _tasks + _createTurnAction(0);
    }
    _tasks + _createScriptNameAction(script, null, scp_args);
    return _tasks;
  }

  function interruptCharaScriptAction(scp_id) {

    if (getTargetFurnitureUID() != -1 || !canInterruptAction()) return;

    if (isInLinkAction() || hasAttractTarget()) return;

    setRandomAction(false);
    local _tasks = getScriptActionTasks(scp_id);

    if (route_move_action) {

      this.tasks[0] <- _tasks[0];
      _writeModelActions();
    } else {
      if (_tasks) setupTasks(_tasks);
    }
  }

  function _createApproachFurnitureActionList(furniture_model, target_bone = null, only_approach = false) {
    local _setting = ::gamesetting.furniture_settings[furniture_model.getFurnitureData().getID()];
    local _f_pos = furniture_model.getPos();

    local _target_pos_data = null;
    foreach (idx, pos_data in _setting.getActionPosData()) {
      if (target_bone) {
        if (!("bone" in pos_data) || pos_data.bone != target_bone) continue;
        _target_pos_data = pos_data;
        break;
      } else {
        if ("bone" in pos_data) continue;
        _target_pos_data = pos_data;
        break;
      }
    }

    if (!_target_pos_data) {
      println("[ERROR] createApproachFurnitureActionList -- not target pos!!!!! id = " + _setting.getID() + " , bone = " + target_bone);
      return _createIdleAction(neutral_action, 3000);
    }

    local _f_angle = furniture_model.getAngle();
    local _dist = _target_pos_data.dist;

    local v1 = Vector3D(0, 0, 0);
    local v2 = Vector3D(0, 0, 0);

    local bone_x = 0;
    local bone_z = 0;

    local _bone = "bone" in _target_pos_data ? _target_pos_data.bone : null;

    if (_bone) {
      local sk3d = furniture_model.obj.sk3d;
      local parts = null;
      foreach (k, val in sk3d.motion.parts) {
        if (val.name != target_bone) continue;
        parts = val;
        break;
      }

      if (parts && parts != undefined) {
        local p0 = parts.bindpose;
        v1.set(p0[12], 0, p0[14]).transform0(sk3d.gmat);

        bone_x = v1.x;
        bone_z = v1.z;
      }
    }
    local _chara_pos = this.getPos();

    for (local add_angle = 0; add_angle < 360; add_angle += 90) {

      switch (_target_pos_data.type) {
      case ::FurnitureSetting.ACTION_AREA_FRONT:
        if (add_angle > 0) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_SIDE:
        if (add_angle % 180 == 0) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK:
        if (add_angle == 180) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_RIGHT:
        if (add_angle != 90) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_LEFT:
        if (add_angle != 270) continue;
        break;
      }
      local _dir = (_f_angle + add_angle) * Math.PI / 180;
      v1.set(_f_pos.x, _f_pos.y, _f_pos.z).add(_dist * Math.sin(_dir) * -1, 0, _dist * Math.cos(_dir) * -1).add(bone_x, 0, bone_z).sub(_chara_pos);

      if (v2.length() == 0 || v2.length() > v1.length()) {
        v2.set(v1);
      }
    }

    v2.add(_chara_pos);

    local target_pos = Vector3D();
    target_pos.set(v2);

    local tasks = [];
    tasks + _createTurnAction(_getDiffHead(this.getPos(), target_pos));
    tasks + _createMoveAction(walk_action, target_pos);
    tasks + _createTurnAction(_getDiffHead(target_pos, _f_pos));

    if (only_approach) return tasks;

    local _stay_action_setting = _setting.getStayActionSettingAtUseFurniture();
    tasks + _createScriptAction(_stay_action_setting, furniture_model, _bone);

    return tasks;
  }

  function getRandomActionTask(idle = false) {

    local total_frequency = 0;
    local candidates = [];
    local _motions = [];
    local _ps = ::gamesetting.prop_settings[getPropID()];
    if (_ps) {
      _motions = _ps.getMotionList();
    }
    else {
      _motions = ::gamesession.getUserDataLocal().getRoomIdleMotions();
    }

    foreach (_motion in _motions) {
      local setting = ::gamesetting.room_motion_settings[_motion];
      if (setting.action_type == ::ActionSetting.ACTION) {
        candidates + setting;
        total_frequency += setting.frequency;
      }
      if (idle && setting.action_type == ::ActionSetting.IDLE) {
        candidates + setting;
        total_frequency += setting.frequency;
      }
    }

    local action_setting = _drawLotsAction(total_frequency, candidates);

    local _task;
    switch (action_setting.action_type) {
    case ActionSetting.IDLE:
      _task = _createIdleAction(action_setting, 1500);
      break;
    case ActionSetting.ACTION:
      _task = _createScriptAction(action_setting);
      break;
    }
    return _task;
  }

  function _createCandidateActionList(script_name) {
    local candidates = [];

    foreach (action_id in ::gamesetting.game_rule.getDefaultCharaActions()) {
      local setting = ::gamesetting.action_settings[action_id];
      if (setting.action_name != script_name) candidates + setting;
    }

    local motion_ids = [];
    local _ps = ::gamesetting.prop_settings[getPropID()];
    if (_ps) {
      motion_ids = _ps.getMotionList();
    }
    else {
      motion_ids = ::gamesession.getUserDataLocal().getRoomIdleMotions();
    }
    foreach (motion_id in motion_ids) {
      local setting = ::gamesetting.room_motion_settings[motion_id] || null;
      if (!setting) {
        println("[ERROR]MotionSetting Id is undefined!!!!!!!!!!!!!!!  id = " + motion_id)
        continue;
      }

      if (setting.action_name != script_name) {
        if (only_move_action && setting.action_type != ::ActionSetting.MOVE) continue;
        candidates + setting;
      }
    }

    return candidates;
  }

  function _calcTotalFreqActionList(_action_settings) {
    local freq = 0;
    for (local i = 0; i < _action_settings.len(); i++) {
      freq += _action_settings[i].frequency;
    }
    return freq;
  }

  function setHapinessAction() {

  }

  function finishProduct() {
    setAutoAction(false);
    setFurnitureScriptRunning(false);
    resetTargetFurnitureUID();
  }

  function registerModifierParameters() {
    if (!modifier_param) modifier_param = {};

    local _materials = sk3d.getMaterials();
    local _temp_materials = [];
    foreach (_mate in _materials) {
      _temp_materials + clone _mate;
    }
    modifier_param["materials"] <- clone _temp_materials;
    modifier_param["scale"] <- clone sk3d.scale;

    if (effect_runner instanceof SK3DEffectRunner) effect_runner.registerModifierParameters(modifier_param);
  }

  function setEffectScript(r) {
    local sk3 = r.getContent();
    local clsstr = sk3.scriptclass || "SK3DEffectRunner";
    local cls = getroottable()[clsstr];
    effect_runner = cls(sk3.clonescp ? clone sk3.script : sk3.script);
    effect_runner.setSK3DObject(this.sk3d);
    if ("setup" in effect_runner) effect_runner._exec_("setup");
  }

  function startEffect(fname, ...) {
    local _b = effect_runner ? effect_runner._starta_(fname, varguments()) : false;
    if (_b && capture_model) {
      capture_model.startEffect(fname, varguments());
    }
    return _b;
  }

  function setDark(dark) {
    is_dark = dark;
    local materials = sk3d.getMaterials();
    foreach (mate in materials) {
      mate["colormat"] = is_dark ? Matrix.fromHSV(0, 0.5, 0.5) : Matrix.fromHSV(0, 1.0, 1.0);
    }
    foreach (c in sk3d.children) {
      materials = c.getMaterials();
      foreach (mate in materials) {
        mate["colormat"] = is_dark ? Matrix.fromHSV(0, 0.5, 0.5) : Matrix.fromHSV(0, 1.0, 1.0);
      }
    }

    if (capture_model) {
      capture_model.setDark(dark);
    }
  }

  function isPlayRandomAction() {
    return random_action_state == ::ActionSetting.TYPE_RANDOM;
  }

  function isPlayNoMoveAction() {
    return random_action_state == ::ActionSetting.TYPE_NOMOVE;
  }

  function isFurnitureScriptRunning() {
    return this.is_furniture_script;
  }

  function isEffectRunning(key) {
    if (!effect_runner || !effect_runner.running_effect_table) return false;
    return this.effect_runner.running_effect_table[key];
  }

  function isScriptRunning() {
    return sk3d.scprunner.running;
  }

  function isRouteMoveAction() {
    return this.route_move_action;
  }

  function getCostumeID() { return costume_id; }

  function getCostumeData() {
    return ::gamesession.getUserData().getCostumeData(costume_id);
  }

  function getCharaID() {
    return getCostumeData().getCharaID();
  }

  function getCharaData() {
    return ::gamesession.getUserData().getCharacterDataByCostumeId(costume_id);
  }

  function getCurrentScriptName() {
    return current_script_name;
  }

  function getCaptureModel() {
    return this.capture_model;
  }

  function getPos() {
    local _v = Vector3D(this.sk3d.pos);
    local _y = this.model_viewer.getHouseManager().getHouseModel() ? ::HouseModel.FLOOR_DEPTH : 0.0;

    _v.y -= _y;
    return _v;
  }
  function getRotation() {
    return clone this.sk3d.rot;
  }
  function getScale() {
    return clone this.sk3d.scale;
  }

  function isInCenter() {
    if (!this.model_viewer) return false;
    local _v = this.model_viewer.renderer.camera.project(getPos());
    local _spos = [_v.x * ::viewWidth, _v.y * ::viewHeight];
    local _hw = ::screenWidth / 2.0;
    local _hh = ::screenHeight / 2.0;

    return _spos[0] > _hw - 50 && _spos[0] < _hw + 50 && _spos[1] > _hh - 50 && _spos[1] < _hh + 100;
  }

  function isInBroadCenter() {
    if (!this.model_viewer) return false;
    local _v = this.model_viewer.renderer.camera.project(getPos());
    local _spos = [_v.x * ::viewWidth, _v.y * ::viewHeight];
    local _hw = ::screenWidth / 2.0;
    local _hh = ::screenHeight / 2.0;

    return _spos[0] > _hw - 150 && _spos[0] < _hw + 150 && _spos[1] > _hh - 100 && _spos[1] < _hh + 150;
  }

  function isInScreen() {
    local _v = this.model_viewer.renderer.camera.project(getPos());
    local _spos = [_v.x * ::viewWidth, _v.y * ::viewHeight];
    return _spos[0] > 0 && _spos[0] < ::screenWidth && _spos[1] > 0 && _spos[1] < ::screenHeight;
  }

  function getTasks() {
    return tasks;
  }

  function getTargetFurnitureUID() {
    return this.target_furniture_uid;
  }

  function setScale(sc) {
    this.sk3d.scale.set(sc);
  }

  function setVisible(v) {
    super.setVisible(v);
    this.sk3d.setVisible(this.visible);
    foreach (c in this.sk3d.children) {
      c.setVisible(this.visible);
    }

    if (capture_model) capture_model.setVisible(v);
  }

  function _swapAttribute() {
    local _tmp_pos = Vector3D(another_pos);
    local _tmp_rot = Quaternion(another_rot);
    local _tmp_sca = Vector3D(another_scale);
    another_pos.set(sk3d.pos);
    another_rot.set(sk3d.rot);
    another_scale.set(sk3d.scale);
    sk3d.pos.set(_tmp_pos);
    sk3d.rot.set(_tmp_rot);
    sk3d.scale.set(_tmp_sca);
  }

  function setAutoAction(b) {
    if (!capture_model) this.is_auto_action = false;
    else this.is_auto_action = b;
    if (capture_model) capture_model.setAutoAction(b);
  }

  function setRandomAction(b) {
    random_action_state = b ? ::ActionSetting.TYPE_RANDOM : -1;
    if (capture_model) capture_model.setRandomAction(b);
  }

  function setNoMoveAction(b) {
    random_action_state = b ? ::ActionSetting.TYPE_NOMOVE : -1;
    if (capture_model) capture_model.setNoMoveAction(b);
  }

  function setFurnitureScriptRunning(b) {
    if (this.is_furniture_script && !b) {
      setPauseBound(true);
    }

    this.is_furniture_script = b;
    if (capture_model) capture_model.setFurnitureScriptRunning(b);
  }

  function setTargetFurnitureUID(furniture_uid) {
    this.target_furniture_uid = furniture_uid;
    if (capture_model) capture_model.setTargetFurnitureUID(furniture_uid);
  }

  function resetTargetFurnitureUID() {
    this.target_furniture_uid = -1;
    if (capture_model) capture_model.resetTargetFurnitureUID();
  }

  function setLastUseFurniture(fm, t) {
    this.last_use_furniture = fm;
    this.last_use_furniture_time = t;

  }

  function setCostumeID(cid) {
    this.costume_id = cid;
    if (capture_model) capture_model.setCostumeID(cid);
  }

  function onlyMoveAction() {
    only_move_action = true;
  }

  function createCharaActions() {

    actions.idle <- ::ARCharaActionIdle();
    actions.script <- ::ARCharaActionScript();
    actions.move <- ::ARCharaActionMove();
    actions.turn <- ::ARCharaActionTurn();
    actions.link_idle <- ::ARCharaActionLinkIdle();
    actions.link_script <- ::ARCharaActionLinkScript();
    actions.look_to_move <- ::ARCharaActionLookToMove();
  }

  function _createScriptAction(setting, target = null, args = null) {
    local ad = ARActionData(actions.script, setting.action_name, args, target, 0, setting.canInterrupt());
    return ad;
  }

  function _createScriptNameAction(script_name, target = null, args = null, interrupt = true) {
    local ad = ARActionData(actions.script, script_name, args, target, 0, interrupt);
    return ad;
  }

  function _createScriptLinkAction(setting, is_host, args = null, target = null) {
    local ad = ARLinkActionData(actions.link_script, setting.getActionName(), args, target, 0, setting.canInterrupt(), is_host);
    return ad;
  }

  function _createTurnAction(target_angle) {
    local ad = ARActionData(actions.turn, turn_action.action_name, null, target_angle, 0, turn_action.canInterrupt());
    return ad;
  }

  function _createMoveAction(setting, target_pos, time = 0, args = null) {
    local ad = ARActionData(actions.move, setting.action_name, args, target_pos, time, setting.canInterrupt());
    return ad;
  }

  function _createLookToMoveAction(setting, target_pos, time = 0, args = null) {
    local ad = ARActionData(actions.look_to_move, setting.action_name, args, target_pos, time, setting.canInterrupt());
    return ad;
  }

  function _createIdleAction(setting, time = null) {
    local _time = time || 500 + ::PUBLIC_RANDOM.nexti(1500);
    local ad = ARActionData(actions.idle, setting.action_name, null, null, _time, setting.canInterrupt());
    return ad;
  }

  function _createIdleLinkAction(setting, is_host, target, time = 0) {
    local ad = ARLinkActionData(actions.link_idle, setting.getActionName(), null, target, time, setting.canInterrupt(), is_host);
    return ad;
  }

  function changeProp() {
    if (isFurnitureScriptRunning()) return;

    if (this.prop_id >= 0) {

      startEffect("prop_end");
      this.prop_id = -1;
    }
    else {

      startEffect("cos_fork_spoon_start");
      this.prop_id = 1;
    }
    if (this.capture_model) this.capture_model.setPropID(this.prop_id);
  }

  function startProp(ps, force = false) {
    if (isFurnitureScriptRunning()) return;
    if (!ps || !ps.getPropScript() || (!force && this.prop_id == ps.getID())) return;

    startEffect(ps.getPropScript());
    this.prop_id = ps.getID();
    setDefaultAction();
    if (this.capture_model) this.capture_model.startProp(ps, force);
  }

  function endProp() {
    if (this.prop_id < 0) return;

    startEffect("prop_end");
    this.prop_id = -1;
    setDefaultAction();
    if (this.capture_model) this.capture_model.endProp();
  }

  function getPropID() {
    return this.prop_id;
  }

  function setPosXYZ(x, y, z) {
    super.setPosXYZ(x, y, z);

    local _y = this.model_viewer.getHouseManager().getHouseModel() ? ::HouseModel.FLOOR_DEPTH : 0.0;

    sk3d.pos.set(x, y + _y, z);
    sk3d.matdirty = true;
  }

  function setPos(pos) {

    super.setPos(pos);

    local _y = this.model_viewer.getHouseManager().getHouseModel() ? ::HouseModel.FLOOR_DEPTH : 0.0;

    sk3d.pos.set(pos.x, pos.y + _y, pos.z);
    sk3d.matdirty = true;
  }

  function setAngle(angle) {
    super.setAngle(angle);

    sk3d.rot.set(Quaternion.fromHPB(this.angle, 0, 0));
    sk3d.matdirty = true;
  }

  function setRotation(rot) {
    super.setRotation(rot);

    sk3d.rot.set(rot);
    sk3d.matdirty = true;
  }

  function setScale(sca) {
    super.setScale(sca);
    sk3d.scale.set(sca);
    sk3d.matdirty = true;
  }

  function startScript(name, ...) {

    if (this.current_script_name == name) return false;

    println("[startScript] " + name + ", is_cap = " + isCaptureModel())
    local _result = false;
    switch (vargc) {
    case 1: _result = this.sk3d.startScript(name, vargv[0]); break;
    case 2: _result = this.sk3d.startScript(name, vargv[0], vargv[1]); break;
    case 3: _result = this.sk3d.startScript(name, vargv[0], vargv[1], vargv[2]); break;
    case 4: _result = this.sk3d.startScript(name, vargv[0], vargv[1], vargv[2], vargv[3]); break;
    default: _result = this.sk3d.startScript(name); break;
    }

    if (_result) {
      this.current_script_name = name;

      if (this.current_script_name.equals("end_common_furniture")) {
        interval_id = setInterval(_isEndFurnitureScript.bindenv(this), 100);
      }
    }

    return _result;
  }

  function _isEndFurnitureScript(dt) {
    if (!isScriptRunning() && furniture_end_counter == -1) {
      furniture_end_counter = skGetTime() + 500;
    }

    if (furniture_end_counter != -1 && furniture_end_counter < skGetTime()) {

      local _furn = model_viewer.getFurnitureModel(getTargetFurnitureUID(), this.capture_model == null);

      if (!_furn) return undefined;

      setPos(this.sk3d.pos);
      setRotation(this.sk3d.rot);
      _furn.clearFurnitureAction();
      furniture_end_counter = -1;
      interval_id = -1;

      return undefined;
    }
  }

  function setTappedScript(scp_name) {
    this.tapped_script = scp_name;

    local _ud = ::gamesession.getUserData();

    if (scp_name) {
      setHapinessAction();
    } else {
      _ud.failHapinessAction(this.getCostumeData().getID());
    }
  }
  function hasTappedScript() {
    return this.tapped_script ? true : false;
  }
  function startTappedScript() {
    if (!this.tapped_script) return;

    local _addgm = 0;

    local ret = ::gamesession.getUserData().succesHapinessAction(this.getCostumeData().getID());
    if (ret) {
      _addgm = ::gamesession.communicateChara();
    }

    startScript(this.tapped_script, _addgm);
    this.tapped_script = null;
  }

  function resetTappedScript() {

    local _ud = ::gamesession.getUserData();
    local _cid = this.getCostumeData().getID();
    if (_ud.isHapinessAction(_cid)) {
      _ud.failHapinessAction(_cid);
    }

    this.tapped_script = null;
  }
}

class ARCharaModel.ARActionData {
  action = null;
  scp_id = null;
  scp_args = null;

  time = 0;
  target = null;

  can_interrupt = true;

  constructor(action, scp_id, scp_args = null, _target = null, _time = 0, _interrupt = true) {
    this.action = clone action;
    this.scp_id = scp_id;

    this.scp_args = scp_args;
    this.target = _target;

    this.time = _time;

    this.can_interrupt = _interrupt;
  }

  function canInterruptAction() {
    return this.can_interrupt;
  }

  function setCanInterruptAction(b) {
    this.can_interrupt = b;
  }

  function getDeepClone() {
    local ad = ::ARCharaModel.ARActionData(clone this.action, clone this.scp_id, clone this.scp_args, clone this.target, time, this.can_interrupt);
    return ad;
  }

  function convertCaptureModel(ar_chara_model) {
    if (ar_chara_model.isCaptureModel()) {
      this.scp_args = _changeCaptureModel(this.scp_args);
      this.target = _changeCaptureModel(this.target);
    }
  }

  function _changeCaptureModel(args) {
    if (args instanceof ::ARCharaModel) {
      return args.isCaptureModel() ? args : args.capture_model;
    } else if (typeof(args) == SS_ARRAY) {
      foreach (idx, val in args) {
        args[idx] = _changeCaptureModel(val);
      }
      return args;
    } else if (typeof(args) == SS_TABLE) {
      local _t = {};
      foreach (key, val in args) {
        local _key = _changeCaptureModel(key);
        local _val = _changeCaptureModel(val);

        _t[_key] <- _val;
      }
      return _t;
    }
    return args;
  }
}

class ARCharaModel.ARLinkActionData extends ARCharaModel.ARActionData {
  is_host = null;

  constructor(action, scp_id, scp_args = null, _target = null, _time = 0, _interrupt = true, _is_host = false) {
    super(action, scp_id, scp_args, _target, _time, _interrupt);

    this.is_host = _is_host;
  }

  function getDeepClone() {
    local ad = ::ARCharaModel.ARLinkActionData(clone this.action, clone this.scp_id, clone this.scp_args, clone this.target, time, this.can_interrupt, this.is_host);
    return ad;
  }

  function isHost() {
    return this.is_host;
  }
}

class ARCharaModel.ARCharaAction {
  force_end_action = null;
  can_interrupt = true;

  function startAction(ar_chara_model, action_data) {
    local id = action_data.scp_id || ar_chara_model.neutral_action.id;
    local args = action_data.scp_args;
    force_end_action = false;
    this.can_interrupt = action_data.canInterruptAction();

    switch (length(args)) {
    case 0: ar_chara_model.startScript(id); break;
    case 1: ar_chara_model.startScript(id, args[0]); break;
    case 2: ar_chara_model.startScript(id, args[0], args[1]); break;
    case 3: ar_chara_model.startScript(id, args[0], args[1], args[2]); break;
    }
  }

  function update(dt, ar_chara_model) {
    if (isActionEnd(ar_chara_model)) {
      ar_chara_model.endAction();
      return;
    }

    ar_chara_model.actiontime -= dt;
    if (ar_chara_model.actiontime < 0) {
      updateAction(dt - ar_chara_model.actiontime, ar_chara_model);
      if (isActionEnd(ar_chara_model)) {
        ar_chara_model.endAction();
      }
    }
    else {
      updateAction(dt, ar_chara_model);
    }
  }

  function forceEndAction() {
    force_end_action = true;
  }

  function updateAction(dt, ar_chara_model) {
  }

  function isActionEnd(ar_chara_model) {
    return true;
  }

  function canInterruptAction() {
    return this.can_interrupt;
  }
}

class ARCharaActionIdle extends ARCharaModel.ARCharaAction {

  function startAction(ar_chara_model, action_data) {
    super.startAction(ar_chara_model, action_data);
    ar_chara_model.actiontime = action_data.time;

  }

  function updateAction(dt, ar_chara_model) {
    super.updateAction(dt, ar_chara_model);
  }

  function isActionEnd(ar_chara_model) {
    return ar_chara_model.actiontime <= 0 || force_end_action;
  }
}

class ARCharaActionLinkIdle extends ARCharaModel.ARCharaAction {
  action_data = null;
  function startAction(ar_chara_model, action_data) {
    super.startAction(ar_chara_model, action_data);

    this.action_data = action_data;
    ar_chara_model.actiontime = action_data.time;
  }

  function update(dt, ar_chara_model) {
    if (isActionEnd(ar_chara_model)) {
      ar_chara_model.endAction();
      return;
    }

    ar_chara_model.actiontime -= dt;
    if (ar_chara_model.actiontime < 0) {
      updateAction(dt - ar_chara_model.actiontime, ar_chara_model);
      if (isActionEnd(ar_chara_model)) {
        ar_chara_model.endAction();
      } else {

        local _linkhost = this.action_data.isHost() ? ar_chara_model : ar_chara_model.getLinkHost();
        if (_linkhost) _linkhost.resetLink();
      }
    }
    else {
      updateAction(dt, ar_chara_model);
    }
  }

  function isActionEnd(ar_chara_model) {
    if (this.action_data.isHost()) {

      foreach (cm in this.action_data.target) {
        if (!(cm.action instanceof ::ARCharaActionLinkIdle)) {
          return false;
        }
      }
      return true;
    } else {

      return false;
    }
  }

}

class ARCharaActionScript extends ARCharaModel.ARCharaAction {

  function startAction(ar_chara_model, action_data) {
    force_end_action = false;
    if (action_data.target instanceof ::ARFurnitureModel) {
      if (!ar_chara_model.isFurnitureScriptRunning()) {
        ar_chara_model.setFurnitureScriptRunning(true);
        ar_chara_model.endProp();
      }
      if (action_data.scp_args) {
        ar_chara_model.startScript(action_data.scp_id, action_data.target, action_data.scp_args);
      } else {
        ar_chara_model.startScript(action_data.scp_id, action_data.target);
      }
    } else {
      super.startAction(ar_chara_model, action_data);
    }
  }

  function isActionEnd(ar_chara_model) {
    return !ar_chara_model.sk3d.scprunner.running || force_end_action;
  }
}

class ARCharaActionLinkScript extends ARCharaModel.ARCharaAction {
  target = null;

  function startAction(ar_chara_model, action_data) {
    this.target = action_data.target;

    if (action_data.scp_args) {
      ar_chara_model.startScript(action_data.scp_id, action_data.target, action_data.scp_args);
    } else {
      ar_chara_model.startScript(action_data.scp_id, action_data.target);
    }
  }

  function update(dt, ar_chara_model) {
    if (isActionEnd(ar_chara_model)) {
      ar_chara_model.resetLink();
    }

    super.update(dt, ar_chara_model);
  }

  function isActionEnd(ar_chara_model) {
    return !ar_chara_model.sk3d.scprunner.running || force_end_action;
  }
}

class ARCharaActionMove extends ARCharaModel.ARCharaAction {

  is_move_around = null;
  task_clear = null;

  function startAction(ar_chara_model, action_data) {
    super.startAction(ar_chara_model, action_data);

    if (action_data.time > 0) {
      ar_chara_model.actiontime = action_data.time;
      is_move_around = false;
    } else {
      local action_setting = ::gamesetting.getActionSettingByName(action_data.scp_id) || ar_chara_model.walk_action;
      local spd = action_setting.move_speed * DASHSPEED_SCALE;
      if (typeof(action_data.scp_args) == SS_FLOAT) {
        spd *= action_data.scp_args;
      }
      ar_chara_model.speed = spd;

      local _cp = ar_chara_model.getPos();
      local dx = action_data.target.x - _cp.x;
      local dy = action_data.target.y - _cp.y;
      local dz = action_data.target.z - _cp.z;
      ar_chara_model.actiontime = Math.sqrt(dx * dx + dy * dy + dz * dz) / spd;

      ar_chara_model.action_target = Vector3D();
      ar_chara_model.action_target.set(action_data.target);
      is_move_around = true;
    }
    task_clear = false;
  }

  function updateAction(dt, ar_chara_model) {
    if (!is_move_around) return;

    local _c = _updateBoundTable(ar_chara_model, dt);
    if (ar_chara_model.getPauseBound()) {
      if (!_c) {
        ar_chara_model.setPauseBound(false);
      }
    }
    else if (_c) {
      return;
    }

    local _cname = ar_chara_model.getCostumeData().getCharaName();
    local _is_cap = ar_chara_model.isCaptureModel();

    local _topos = _calcToPos(ar_chara_model, dt);

    ar_chara_model.setPosXYZ(_topos.x, _topos.y, _topos.z);
  }

  function _updateBoundTable(ar_chara_model, dt) {
    local _topos = _calcToPos(ar_chara_model, dt);

    local _c = ar_chara_model.inBoundOtherModel(_topos);

    if (_c && !ar_chara_model.getPauseBound()) {

      this.task_clear = true;
      ar_chara_model.onlyMoveAction();
      ar_chara_model.clearTasks();
    }
    return _c;
  }

  function isActionEnd(ar_chara_model) {
    if (!is_move_around) return ar_chara_model.actiontime <= 0 || force_end_action;
    if (task_clear) return false;

    local _pos = ar_chara_model.getPos();
    if (force_end_action) {
      _writeTarget(ar_chara_model);
      return true;
    }

    if (!ar_chara_model.action_target) {
      println("[ERROR] ActionTarget is null !!!! cap_model = " + ar_chara_model.capture_model)
      return true;
    }

    if (reachedToPos(ar_chara_model, _pos)) {
      return true;
    } else if (ar_chara_model.actiontime <= 0) {

      _writeTarget(ar_chara_model);
      return true;
    }

    return false;
  }

  function _writeTarget(ar_chara_model) {
    if (ar_chara_model.action_target) ar_chara_model.setPos(ar_chara_model.action_target);
  }

  function _calcToPos(ar_chara_model, dt) {
    local _pos = ar_chara_model.getPos();
    local x = _pos.x + (ar_chara_model.action_target.x - _pos.x) * dt / (ar_chara_model.actiontime + dt);
    local y = _pos.y + (ar_chara_model.action_target.y - _pos.y) * dt / (ar_chara_model.actiontime + dt);
    local z = _pos.z + (ar_chara_model.action_target.z - _pos.z) * dt / (ar_chara_model.actiontime + dt);

    return { x = x, y = y, z = z };
  }

  function reachedToPos(ar_chara_model, pos) {
    return (pos.x == ar_chara_model.action_target.x && pos.y == ar_chara_model.action_target.y && pos.z == ar_chara_model.action_target.z);
  }
}

class ARCharaActionTurn extends ARCharaModel.ARCharaAction {
  function startAction(ar_chara_model, action_data) {
    super.startAction(ar_chara_model, action_data);

    local max_rotate_time = 600.0;
    ar_chara_model.action_target = action_data.target * Math.RTOD;
    ar_chara_model.actiontime = action_data.time > 0 ? action_data.time : Math.abs(_calcAngleDiff(ar_chara_model.getAngle(), ar_chara_model.action_target) / 180.0 * max_rotate_time);

  }

  function updateAction(dt, ar_chara_model) {
    super.updateAction(dt, ar_chara_model);
    local calc = _calcAngleDiff(ar_chara_model.getAngle(), ar_chara_model.action_target) / (ar_chara_model.actiontime + dt);
    ar_chara_model.addAngle(calc * dt);
  }

  function _calcAngleDiff(angle, target_angle) {
    local diff = target_angle - angle;
    if (diff > 180) {
      diff = diff % 360;
      if (diff > 180) {
        diff = diff - 360;
      }
    } else if (diff < -180) {
      diff = diff % 360;
      if (diff < -180) {
        diff = diff + 360;
      }
    }
    return diff;
  }

  function isActionEnd(ar_chara_model) {
    if (ar_chara_model.actiontime <= 0 || force_end_action) {

      if (ar_chara_model.action_target) ar_chara_model.setAngle(ar_chara_model.action_target);
      return true;
    }

    return false;
  }
}

class ARCharaActionLookToMove extends ARCharaActionMove {
  function startAction(ar_chara_model, action_data) {
    super.startAction(ar_chara_model, action_data);

    local _p = ar_chara_model.getPos();
    local x = _p.x - ar_chara_model.action_target.x;
    local z = _p.z - ar_chara_model.action_target.z;
    local _theta = 0.0;
    if (x == 0.0) _theta = (z >= 0.0 ? 0.0 : Math.PI);
    else {
      if (x > 0.0) _theta = (Math.PI / 2 - Math.atan(z / x));
      else _theta = (Math.PI * 3 / 2 - Math.atan(z / x));
    }
    _theta *= Math.RTOD;

    ar_chara_model.action_target = { pos = ar_chara_model.action_target, angle = _theta };
  }

  function updateAction(dt, ar_chara_model) {
    super.updateAction(dt, ar_chara_model);

    if (!task_clear) {

      local calc = _calcAngleDiff(ar_chara_model.getAngle(), ar_chara_model.action_target.angle) / (ar_chara_model.actiontime + dt);
      ar_chara_model.addAngle(calc * dt);
    }
  }

  function _calcAngleDiff(angle, target_angle) {
    local diff = target_angle - angle;
    if (diff > 180) {
      diff = diff % 360;
      if (diff > 180) {
        diff = diff - 360;
      }
    } else if (diff < -180) {
      diff = diff % 360;
      if (diff < -180) {
        diff = diff + 360;
      }
    }
    return diff;
  }

  function _writeTarget(ar_chara_model) {
    if (ar_chara_model.action_target) {
      ar_chara_model.setPos(ar_chara_model.action_target.pos);
      ar_chara_model.setAngle(ar_chara_model.action_target.angle);
    }
  }

  function _calcToPos(ar_chara_model, dt) {
    local _pos = ar_chara_model.getPos();
    local x = _pos.x + (ar_chara_model.action_target.pos.x - _pos.x) * dt / (ar_chara_model.actiontime + dt);
    local y = _pos.y + (ar_chara_model.action_target.pos.y - _pos.y) * dt / (ar_chara_model.actiontime + dt);
    local z = _pos.z + (ar_chara_model.action_target.pos.z - _pos.z) * dt / (ar_chara_model.actiontime + dt);

    return { x = x, y = y, z = z };
  }

  function reachedToPos(ar_chara_model, pos) {
    return (pos.x == ar_chara_model.action_target.pos.x && pos.y == ar_chara_model.action_target.pos.y && pos.z == ar_chara_model.action_target.pos.z);
  }
}