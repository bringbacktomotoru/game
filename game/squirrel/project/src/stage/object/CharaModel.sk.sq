class CharaModel extends ProducerModel {
  static BODY_SK3D_NAME = "body";
  static FACE_SK3D_NAME = "face";
  static RIGHT_HAND_SK3D_NAME = "r_hand";
  static LEFT_HAND_SK3D_NAME = "l_hand";

  static SCRIPT_NAME_TAP = "tefuri";
  static SCRIPT_NAME_FOCUS = "banzai";
  static SCRIPT_NAME_ATTRACT = "home_nayamu";

  costume_id = -1;
  rental_data = null;

  obj = null;
  b3body = null;

  is_auto_action = true;
  tasks = null;
  current_script_name = null;
  action = null;
  actiontime = 0;
  action_target = null;

  target_furniture_uid = null;
  is_furniture_script = null;

  speed = 6.0;

  stage = null;

  v_1 = Vector3D();

  pause_bound = false;
  last_bound_times = null;

  static RETRY_FURNITURE_TIME = 5000;
  static RETRY_FURNITURE_TIME_REDUCE = 50;
  static USE_FURNITURE_DISTANCE = 3.0;
  static USE_FURNITURE_PROBABILITY = 100;
  static USE_FURNITURE_PROBABILITY_TAP = 100;
  static APPROACH_LOCK_TIME = 2000;
  static USE_FURNITURE_TAP_TIME = 2000;
  static DISABLE_AUTOUSE_SAME_FURNITURE_TIME = 3 * 60 * 1000;
  static SELECT_FURNITURE_WAIT_TIME = 30 * 1000;
  last_furniture_try = -1;
  approach_lock = false;
  approach_lock_time = -1;
  last_tap_time = -1;

  state = -1;
  static STATE_NONE = 0;
  static STATE_SELECT_FURNITURE = 1;
  static STATE_WAIT_FURNITURE = 2;
  static STATE_APPROACH_FURNITURE = 3;
  static STATE_USING_FURNITURE = 4;

  static STATE_AUTO_APPROACH = 10;

  thread = null;
  target_furniture = null;
  wait_tap = null;
  disable_approach_furniture = null;

  static USE_FURNITURE_COOL_TIME = 15000;
  last_use_furniture = null;
  last_use_furniture_time = -1;

  static WAITING_PRODUCT_TIME = 15 * 1000;
  waiting_product_limit = -1;
  waiting_product_model = null;

  chara_sentence_list_setting = null;
  tapped_script = null;
  disable_start_tapped_script = null;
  disable_reset_tapscp_name = null;
  disable_tap = null;

  constructor(scene, stage) {
    super(scene);

    this.obj = ::StageObject(this.scene);
    this.stage = stage;
    this.tasks = [];

    is_furniture_script = false;

    this.last_bound_times = [];

    this.state = STATE_NONE;

    this.thread = null;
    this.target_furniture = null;
    this.last_use_furniture = null;
    this.wait_tap = false;
    this.disable_approach_furniture = false;
    this.disable_start_tapped_script = false;
    this.disable_reset_tapscp_name = false;
    this.disable_tap = false;
  }

  function getAngle() {
    if (!this.obj.sk3d) return super.getAngle();
    return int(this.obj.sk3d.dir * Math.RTOD);
  }

  function getCostumeID() {
    return this.costume_id;
  }

  function initPos(param = null) {
    local grid_pos = this.stage.getHouseManager().getRandomNodePos();
    local posx = grid_pos.x;
    local posy = ::HouseModel.FLOOR_DEPTH;
    local posz = grid_pos.z;
    local _search = 50;

    this.pause_bound = true;
    local i = 0;
    for (i = 0; i < _search; i++) {
      if (!inBoundOtherCharas({ x = posx, y = posy, z = posz })) break;
      grid_pos = this.stage.getHouseManager().getRandomNodePos();
      posx = grid_pos.x;
      posz = grid_pos.z;
    }

    if (i == _search) {
      grid_pos = this.stage.getHouseManager().getValidNodePos(_isValid.bindenv(this));
      posx = grid_pos.x;
      posz = grid_pos.z;
    }
    setPosXYZ(posx, posy, posz);
    applyPos();

    setAngle(Math.PI / 2);
    applyAngle();

    this.obj.sk3d.anime(10, 26, 2.0, -1);
    resetWaitingProduct();
  }

  function _isValid(p) {
    local _v = Vector3D().set(p);
    _v.y = ::HouseModel.FLOOR_DEPTH;
    return !inBoundOtherCharas(p);
  }

  function build(cos_id, is_init = true, rental_check = false) {
    local _need_upd = this.is_need_update;
    this.is_need_update = false;

    local _pos = { x = 0, y = 0, z = 0, a = getAngle() };
    if (!is_init && this.obj) {
      local _p = getPos();
      if (_p) { _pos.x = _p.x; _pos.y = _p.y; _pos.z = _p.z; }
    }

    this.obj.removeFromStage();

    this.costume_id = cos_id;
    local _chara_id = ::gamesetting.costume_settings[cos_id].getCharaID();

    local _view_cos_id = cos_id;
    if (rental_check) {
      local _chara_data = ::gamesession.getUserData().getCharacterData(_chara_id);
      if (_chara_data) {
        this.rental_data = _chara_data.getRentalCostume(this.costume_id);
        if (this.rental_data && this.rental_data.enableUse()) {
          _view_cos_id = this.rental_data.getCostumeID();
        }
      }
    }
    else {
      this.rental_data = null;
    }

    this.obj.sk3d = ::ViewFactory.createUserCharaView(_chara_id, _view_cos_id);
    this.obj.sk3d.setDropShadow(true);

    local _chara_setting = ::gamesetting.sanrio_chara_settings[_chara_id];
    if (_chara_setting.efx_script) {
      local script_res = ::getResource(_chara_setting.efx_script);
      if (script_res) {
        this.obj.setEffectScript(script_res);
        this.obj.startEffect("start");
      }
      this.obj.registerModifierParameters();
    }
    if (!is_init) {
      setAngle(_pos.a);
      setPosXYZ(_pos.x, _pos.y, _pos.z);
    }
    applyPos();
    applyAngle();
    applyVisible();

    if (this.obj) {
      if (this.b3body) this.obj.scene.b3world.removeBody(this.b3body);
      _createB3body();
    }

    resetWaitingProduct();
    this.obj.registerModifierParameters();
    _addToStage(is_init);

    this.is_need_update = _need_upd;
  }
  function rebuild(is_init = true, rental_check = false) {
    build(this.costume_id, is_init, rental_check);
  }

  function _addToStage(is_init = true) {
    this.obj.addToStage();
    if (this.b3body) this.obj.scene.b3world.addBody(this.b3body);

    if (is_init) {
      startScript("start");
      initPos();
    }
    else {
      this.tasks.clear();
      this.action = null;
      this.actiontime = 0;
      this.action_target = null;
    }
  }

  function _createB3body() {
    local _bnd = this.obj.sk3d.bnd;
    local pm = ::PrimitiveMeshes.createBox(_bnd.r, _bnd.s, _bnd.t);
    local shp = b3Shape.createMesh(pm.vtx.getStream(SK_POSITION), [pm.face[0].idx]);
    b3body = b3Body(0.0, shp, Matrix(), ::ViewFactory.RAYTEST_GROUP, ::ViewFactory.RAYTEST_MASK);
    b3body.updateAABB();
  }

  function startUpdate() {
    super.startUpdate();
    if (this.is_auto_action) {
      this.tasks.extend(::charaActionListFactory.createFirstActionList(this));
      local _rule = ::gamesetting.game_rule;
      local _ud = ::gamesession.getUserData();
      if (::tutorial_manager.canExecBonusHapinessTutorial()) {
        if (!_ud.hasHapinessAction()) _ud.resetHapinessAction();
        extendHapinessAction();
      }

      changeAction(this.tasks[0]);
    }
  }

  function release() {
    resetWaitingProduct();
    stopUpdate();
    super.release();

    clearTasks();
    this.is_auto_action = false;

    if (this.obj.sk3d.parent) this.obj.sk3d.removeFromParent();
    if (this.b3body) {
      this.obj.scene.b3world.removeBody(this.b3body);
      this.b3body = null;
    }
    this.obj.scene.removeObject(this.obj.sk3d);

    ::gamesession.getUserData().setHapinessActionCosId(-1);
  }

  function startScript(name, ...) {

    if (this.current_script_name == name) return false;

    _removeTalkQueue();

    local _result = false;
    switch (vargc) {
    case 1: _result = this.obj.sk3d.startScript(name, vargv[0]); break;
    case 2: _result = this.obj.sk3d.startScript(name, vargv[0], vargv[1]); break;
    case 3: _result = this.obj.sk3d.startScript(name, vargv[0], vargv[1], vargv[2]); break;
    case 4: _result = this.obj.sk3d.startScript(name, vargv[0], vargv[1], vargv[2], vargv[3]); break;
    case 5: _result = this.obj.sk3d.startScript(name, vargv[0], vargv[1], vargv[2], vargv[3], vargv[4]); break;
    case 6: _result = this.obj.sk3d.startScript(name, vargv[0], vargv[1], vargv[2], vargv[3], vargv[4], vargv[5]); break;
    case 7: _result = this.obj.sk3d.startScript(name, vargv[0], vargv[1], vargv[2], vargv[3], vargv[4], vargv[5], vargv[6]); break;
    default: _result = this.obj.sk3d.startScript(name); break;
    }

    if (_result) {
      this.current_script_name = name;
    }

    return _result;
  }

  function isScriptRunning() {
    return obj.sk3d.scprunner.running;
  }

  function update(dt) {

    _updateProcess(dt);

  }

  function _updateProcess(dt) {

    if (!super.update(dt)) return false;
    this.obj.update(dt);

    if (b3body) _updateB3body();

    local _now = skGetTime();

    if (!action) {
      if (is_auto_action) {
        this.tasks.extend(_getNewAction());
        changeAction(this.tasks[0]);
        if (action) action.update(dt, this);
      }
      this.approach_lock = false;
    } else {

      if (action instanceof CharaActionMove) {
        local _bc = action.getBoundChara(getCostumeID());
        if (_bc) {
          if (!this.pause_bound) {

            if (this.last_bound_times.len() >= 2 && this.last_bound_times[0] + 2000 > _now) {
              this.last_bound_times = [];
              startCharaScriptAction("stand_short", null, false);
            }
            else {

              if (_bc.isActionMoving()) _bc.startCharaScriptAction("stand_short", null, false);
              startActionTurnAndMove();
              this.last_bound_times + _now;
              if (this.last_bound_times.len() > 2) delete this.last_bound_times[0];
            }
            this.pauseBound();
          }
          else {
            action.update(dt, this);
          }
        }
        else {
          this.pause_bound = false;
          action.update(dt, this);
        }
      }
      else {
        action.update(dt, this);
      }
    }

    if (this.waiting_product_model && _now > this.waiting_product_limit) {
      resetWaitingProduct();
      startActionTurnAndMove();
    }

    if (this.rental_data && !this.rental_data.enableUse()) {
      this.rental_data = null;
      rebuild(false);
    }

    return true;
  }

  static function getTryUseFurnitureResult(ltt, now, fm, cid = -1) {
    local rate = Math.rndi(99) + 1;
    local ret = false;
    local favorite_rate = ::CharaModel.getFavoriteRate(fm, cid);
    if (ltt + ::CharaModel.USE_FURNITURE_TAP_TIME > now) {
      ret = (::CharaModel.USE_FURNITURE_PROBABILITY_TAP + favorite_rate) >= rate ? true : false;
    } else {
      ret = (::CharaModel.USE_FURNITURE_PROBABILITY + favorite_rate) >= rate ? true : false;
    }
    return ret;
  }

  function _isInFurnitureApproachArea(fm) {
    local chara_pos = getPos();
    local furniture_pos = fm.getPos();

    local furniture_setting = fm.getFurnitureSetting();

    local x1 = chara_pos.x;
    local z1 = chara_pos.z;
    local dist = USE_FURNITURE_DISTANCE;

    local x2 = furniture_pos.x;
    local z2 = furniture_pos.z;
    local w2 = furniture_setting.size_w;
    local d2 = furniture_setting.size_d;
    local dir2 = fm.getDir();

    if (::is2RectCollided(x1, z1, dist, dist, 0.0, x2, z2, w2, d2, dir2)) return true;

    local sin = Math.sin;
    local cos = Math.cos;
    local pi = Math.PI;
    local pih = Math.PI / 2.0;
    local pi3h = pih * 3;
    local furniture_dir = fm.getDir();
    foreach (target_pos_data in furniture_setting.getActionPosData()) {
      if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_FRONT || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
        local dist = target_pos_data.dist;
        local sin_dir = sin(furniture_dir);
        local cos_dir = cos(furniture_dir);
        local x2 = furniture_pos.x + dist * sin_dir * -1.0;
        local z2 = furniture_pos.z + dist * cos_dir * -1.0;
        if (::isRectAndPointCollided(x1, z1, dist, dist, 0.0, x2, z2)) return true;
      }
      if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_RIGHT || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_SIDE || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
        local dist = target_pos_data.dist;
        local sin_dir = sin(furniture_dir + pih);
        local cos_dir = cos(furniture_dir + pih);
        local x2 = furniture_pos.x + dist * sin_dir * -1.0;
        local z2 = furniture_pos.z + dist * cos_dir * -1.0;
        if (::isRectAndPointCollided(x1, z1, dist, dist, 0.0, x2, z2)) return true;
      }
      if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_LEFT || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_SIDE || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
        local dist = target_pos_data.dist;
        local sin_dir = sin(furniture_dir + pi3h);
        local cos_dir = cos(furniture_dir + pi3h);
        local x2 = furniture_pos.x + dist * sin_dir * -1.0;
        local z2 = furniture_pos.z + dist * cos_dir * -1.0;
        if (::isRectAndPointCollided(x1, z1, dist, dist, 0.0, x2, z2)) return true;
      }
      if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
        local dist = target_pos_data.dist;
        local sin_dir = sin(furniture_dir + pi);
        local cos_dir = cos(furniture_dir + pi);
        local x2 = furniture_pos.x + dist * sin_dir * -1.0;
        local z2 = furniture_pos.z + dist * cos_dir * -1.0;
        if (::isRectAndPointCollided(x1, z1, dist, dist, 0.0, x2, z2)) return true;
      }
    }

    return false;
  }

  function isStateNone() {
    return this.state == STATE_NONE ? true : false;
  }
  function resetState() {
    this.state = STATE_NONE;
    resetTargetFurnitureUID();
  }
  function isStateAutoApproach() {
    return this.state == STATE_AUTO_APPROACH ? true : false;
  }

  function canRecieveHapiness() {
    if (hasTappedScript()) return true;

    if (getTargetFurnitureUID() > 0) {
      local _pd = ::gamesession.getUserData().getFurnitureData(getTargetFurnitureUID()).getProductData();
      if (_pd && _pd.canRecieveHapiness()) return true;
    }

    return false;
  }

  function shortApproachPosition(p) {
    if (getTargetFurnitureUID() > 0) return false;
    if (this.approach_lock_time > skGetTime()) return false;
    if (this.approach_lock) return false;
    if (!this.canInterruptAction()) return false;

    this.approach_lock = true;
    clearTasks();

    this.last_tap_time = skGetTime();

    this.tasks = ::charaActionListFactory.createShortMoveToTarget(this, p);
    changeAction(this.tasks[0]);

    return true;
  }

  function setSelectFurnitureAction(fm, is_attract = false) {
    if (this.state == STATE_APPROACH_FURNITURE) return;

    if (!fm && this.isStateSelectFurniture()) {
      if (this.thread) this.thread.interruptGoto("END");
      this.state = STATE_NONE;
      if (this.target_furniture) this.target_furniture.getObject().startEffect("removeSelectArrow");
      this.target_furniture = null;
      clearTasks(false);
      setAutoAction(true);
      return;
    }

    if (isStateNone()) {
      if (!fm) return;

      this.state = STATE_SELECT_FURNITURE;
      setAutoAction(false);
      clearTasks();

      this.target_furniture = fm;

      this.thread = newthread();
      this.thread.start(function() {
        local _scene = ::gamesession.getCurrentScene();
        if (!(_scene instanceof SanrioGameScene)) goto END;
        local _cp = _scene.getUI().getCurrentPanel();

        this.wait_tap = true;
        local _last_fm = this.target_furniture;

        if (is_attract) {
          if (_cp instanceof ::HomeTopPanel) {
            _cp.addNoticeBalloon(this);
            sleep(500);
          }

          this.tasks = ::charaActionListFactory.createLookAtTarget(this, this.target_furniture.getPos());
          this.tasks.extend(::charaActionListFactory.createNeutralActionList(this));
          changeAction(this.tasks[0]);
          sleep(2500);

          clearTasks();
          this.tasks = ::charaActionListFactory.createSimpleScriptAction(this, ::CharaModel.SCRIPT_NAME_ATTRACT, false, null);
          changeAction(this.tasks[0]);
          sleep(500);
        }
        else {
          this.tasks = ::charaActionListFactory.createSimpleScriptAction(this, ::CharaModel.SCRIPT_NAME_TAP, true, null);
          changeAction(this.tasks[0]);
          sleep(1500);
        }

        if (_cp instanceof ::HomeTopPanel) {
          _cp.addSelectFurnitureBalloon(this);
          this.target_furniture.getObject().startEffect("startSelectArrow");
        }
        sleep(300);
        this.wait_tap = false;
        sleep(700);

        if (!is_attract) {
          clearTasks();
          this.tasks = ::charaActionListFactory.createLookAtTarget(this, this.target_furniture.getPos());
          this.tasks.extend(::charaActionListFactory.createNeutralActionList(this));
          changeAction(this.tasks[0]);
        }

        local _wait_limit = SELECT_FURNITURE_WAIT_TIME;
        if (::tutorial_manager.tutorialThreadRunning()) _wait_limit = 30 * 60 * 1000;

        while (this.state == STATE_SELECT_FURNITURE) {
          if (_last_fm != this.target_furniture) {
            this.tasks = ::charaActionListFactory.createLookAtTarget(this, this.target_furniture.getPos());
            this.tasks.extend(::charaActionListFactory.createNeutralActionList(this));
            changeAction(this.tasks[0]);

            _last_fm = this.target_furniture;
            _wait_limit = SELECT_FURNITURE_WAIT_TIME;
          } else if (_wait_limit < 0) {
            this.state = STATE_NONE;
            if (this.target_furniture) this.target_furniture.getObject().startEffect("removeSelectArrow");
            this.target_furniture = null;
            clearTasks(false);
            setAutoAction(true);

            goto END;
          }
          sleep(16);
          _wait_limit -= 16;
        }

        this.thread = null;

        END:
        this.thread = null;

      }.bindenv(this), { is_attract = is_attract });
    } else {
      if (this.target_furniture) this.target_furniture.getObject().startEffect("removeSelectArrow");
      this.target_furniture = fm;
      if (this.target_furniture) this.target_furniture.getObject().startEffect("startSelectArrow");
    }
  }
  function stopSelectFurnitureThread() {
    if (this.thread) this.thread.interruptGoto("END");
  }
  function isStateSelectFurniture() {
    return this.state == STATE_SELECT_FURNITURE ? true : false;
  }
  function isStateApproachFurniture() {
    return this.state == STATE_APPROACH_FURNITURE ? true : false;
  }
  function getTargetFurniture() {
    return this.target_furniture;
  }
  function getLastUseFurniture() {
    local _now = skGetTime();

    if (this.last_use_furniture_time + DISABLE_AUTOUSE_SAME_FURNITURE_TIME < _now) {
      this.last_use_furniture = null;
    }
    return this.last_use_furniture;
  }
  function isWaitTap() {
    return this.wait_tap;
  }

  function setDisableApproachFurniture(b) {
    this.disable_approach_furniture = b;
  }
  function isDisableApproachFurniture() {
    return this.disable_approach_furniture;
  }

  function setDisableStartTappedScript(b) {
    this.disable_start_tapped_script = b;
  }
  function isDisableStartTappedScript() {
    return this.disable_start_tapped_script;
  }

  function setDisableTap(b) {
    this.disable_tap = b;
  }
  function isDisableTap() {
    return this.disable_tap;
  }

  function lookAt(p) {
    local _now = skGetTime();
    if (getTargetFurnitureUID() > 0) return false;
    if (this.approach_lock_time > _now) return false;
    if (this.approach_lock) return false;
    if (!this.canInterruptAction()) return false;

    this.approach_lock = true;
    this.approach_lock_time = _now + APPROACH_LOCK_TIME;

    clearTasks();

    this.last_tap_time = _now;

    this.tasks = ::charaActionListFactory.createLookAtTarget(this, p);
    changeAction(this.tasks[0]);

    return true;
  }

  function getFavoriteRate(fm, cid = -1) {
    local chara_id;
    if (cid < 0) {
      chara_id = this.getCharaID();
    } else {
      local cos_setting = ::gamesetting.costume_settings[cid];
      chara_id = cos_setting.getCharaID();
    }

    local _scs = ::gamesetting.sanrio_chara_settings[chara_id];
    local rate = _scs.getFavoriteRateFurnitureUse(fm.getFurnitureSetting().getSeries());

    return rate;
  }

  function startMoveAction(pos) {
    if (getTargetFurnitureUID() > 0) return false;

    if (!this.canInterruptAction()) return false;

    clearTasks();
    this.state = STATE_NONE;
    this.target_furniture = null;

    this.tasks = ::charaActionListFactory.createMoveToTarget(this, pos);
    changeAction(this.tasks[0]);

    return true;
  }

  function isActionMoving() {
    if (!action) return false;
    return action instanceof CharaActionMove;
  }

  function pauseBound() {
    this.pause_bound = true;
  }
  function getPauseBound() {
    return this.pause_bound;
  }

  function inBoundOtherCharas(mypos) {
    local _charas = this.stage.getCharacters();
    if (!_charas) return null;

    local _scene = ::gamesession.getCurrentScene();
    if (!(_scene instanceof SanrioGameScene)) return null;

    local _pmanager = _scene.getProductionManager();
    if (_pmanager.isProducting(getCostumeID())) return null;
    foreach (c in _charas) {

      if (_pmanager.isProducting(c.getCostumeID())) continue;
      if (_inBoundOtherChara(mypos, c)) {

        return c;
      }
    }
    return null;
  }

  static CHECK_CHARA_SIZE = 0.75;
  function _inBoundOtherChara(my, other_chara) {
    if (!other_chara || getCostumeID() == other_chara.getCostumeID()) return false;
    local _other = other_chara.getPos();
    return my.x + CHECK_CHARA_SIZE > _other.x - CHECK_CHARA_SIZE && my.x - CHECK_CHARA_SIZE < _other.x + CHECK_CHARA_SIZE
    && my.y + CHECK_CHARA_SIZE > _other.y - CHECK_CHARA_SIZE && my.y - CHECK_CHARA_SIZE < _other.y + CHECK_CHARA_SIZE
    && my.z + CHECK_CHARA_SIZE > _other.z - CHECK_CHARA_SIZE && my.z - CHECK_CHARA_SIZE < _other.z + CHECK_CHARA_SIZE;
  }

  function _updateB3body() {

    v_1.set(this.obj.sk3d.pos);
    if (this.obj.sk3d.parent) v_1.add(this.obj.sk3d.parent.pos);

    local _bnd = this.obj.sk3d.bnd;
    b3body.setTransform(Matrix.fromTranslate(v_1.x + (_bnd.x + _bnd.r) / 2, v_1.y + (_bnd.y + _bnd.s) / 2, v_1.z + (_bnd.z + _bnd.t) / 2));
  }
  function getB3body() {
    return this.b3body;
  }

  function _getCurrentFloorIndex() {
    return int((pos.y - ::HouseManager.Factory.ROOM_POS_Y - ::RoomModel.FLOOR_DEPTH) / ::RoomModel.ROOM_HEIGHT);
  }

  function _getCurrentRoomIndex() {
    return int((pos.x - ::HouseManager.Factory.ROOM_POS_X) / ::RoomModel.ROOM_WIDTH);
  }

  function getLocalPos() {

    return Vector3D();
  }

  function setTappedScript(scp_name) {
    if (!this.chara_sentence_list_setting) return;
    if (this.disable_reset_tapscp_name && !scp_name) return;

    this.tapped_script = scp_name;
    local _ud = ::gamesession.getUserData();

    if (scp_name) {

      local _scene = ::gamesession.getCurrentScene();
      if (_scene instanceof ::SanrioGameScene) {
        local _cp = _scene.getUI().getCurrentPanel();
        if (_cp instanceof ::HomeTopPanel) {

          _cp.addHapinessBalloon(this);
        }
      }
    }
  }
  function getTappedScript() {
    return this.tapped_script;
  }
  function hasTappedScript() {
    return this.tapped_script ? true : false;
  }
  function setDisableResetTapScriptName() {
    this.disable_reset_tapscp_name = true;
  }
  function startTappedScript() {
    if (!this.tapped_script) return;

    local _addgm = 0;

    startScript(this.tapped_script);

    this.tapped_script = null;
    this.disable_reset_tapscp_name = false;
  }

  function _createHapinessActionList() {
    local _ud = ::gamesession.getUserData();
    local _chara_data = _ud.getCharacterDataByCostumeId(getCostumeData().getID());

    local _rule = ::gamesetting.game_rule;
    local _ud = ::gamesession.getUserData();
    if (!_ud.hasHapinessAction() &&
    !_rule.disableTutorial() &&
    !_ud.isEndTutorialId(::TutorialSetting.CHECK_TUTORIAL_FIRSTFOCUSTALK)
    ) {
      this.chara_sentence_list_setting = ::gamesetting.chara_sentence_list_settings[::TutorialSetting.TUTORIAL_FIRST_FOCUS_TALK_ID];
      if (!this.chara_sentence_list_setting) this.chara_sentence_list_setting = _chara_data.getRandamCharaSentenceListSetting();
    }
    else {
      this.chara_sentence_list_setting = _chara_data.getRandamCharaSentenceListSetting();
    }

    if (!this.chara_sentence_list_setting) return null;
    return ::charaActionListFactory.createHapinessActionList(this, this.chara_sentence_list_setting);
  }

  function createHapinessActionAtTap() {
    if (!this.canInterruptAction()) return false;

    local _ud = ::gamesession.getUserData();
    local _cd = getCostumeData();
    local _chara_data = _ud.getCharacterDataByCostumeId(_cd.getID());
    this.chara_sentence_list_setting = _chara_data.getRandamCharaSentenceListSetting(["previewaction_kokeru"]);

    if (!this.chara_sentence_list_setting) return false;

    _ud.setHapinessActionCosId(_cd.getID());

    clearTasks();
    this.actiontime = 0;
    this.action = null;
    this.action_target = null;
    this.tasks = ::charaActionListFactory.createHapinessAction(this, this.chara_sentence_list_setting);

    changeAction(this.tasks[0]);
  }

  function getCharaSentenceListSetting() {
    return this.chara_sentence_list_setting;
  }

  function _removeTalkQueue() {
    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      _scene.removeTalkQueue(this.obj.sk3d);
    }
  }

  function setHapinessAction() {
    local _ud = ::gamesession.getUserData();
    if (!_ud.enableHapinessAction()) return;

    local _scene = ::gamesession.getCurrentScene();
    if (_scene instanceof ::SanrioGameScene) {
      local _cp = _scene.getUI().getCurrentPanel();
      if (_cp instanceof ::HomeTopPanel) {
        _ud.setHapinessActionCosId(this.getCostumeData().getID());
        _cp.addHapinessBalloon(this);
      }
    }
  }

  function applyPos() {

    this.obj.applyPos();
  }
  function setPos(pos) {
    this.obj.setPos(pos);
    applyPos();
  }
  function setPosXYZ(x, y, z) {
    this.obj.setPosXYZ(x, y, z);
    applyPos();
  }
  function getPos() {
    return this.obj.getPos();
  }

  function applyAngle() {
    super.applyAngle();
    this.obj.setAngle(this.angle);
  }

  function applyVisible() {
    super.applyVisible();
    this.obj.setVisible(this.is_visible);
    foreach (c in this.obj.sk3d.children) {
      local n = c.name;
      if (n != FACE_SK3D_NAME && n != RIGHT_HAND_SK3D_NAME && n != LEFT_HAND_SK3D_NAME) continue;
      c.setVisible(this.is_visible);
    }
  }

  function inBounds(pos) {

    return this.obj.inBounds(pos);
  }

  function disablePhysicalBones() {
    this.obj.disablePhysicalBones();
  }

  function resetPhysicalBones() {
    this.obj.resetPhysicalBones();
  }

  function enablePhysicalBones() {
    this.obj.enablePhysicalBones();
  }

  function getTaskLength() {
    return this.tasks.len();
  }

  function getProductReward() {
    return null;
  }

  function getProductData() {
    return null;
  }
  function hasProductData() {
    return false;
  }
  function getProductState() {
    return -1;
  }

  function changeAction(ad) {
    if (!ad) return;
    this.action = clone ad.action;
    action.startAction(this, ad);
  }

  function _getNewAction() {
    local _ud = ::gamesession.getUserData();
    local _cd = getCostumeData();
    if (!_cd) return;

    local _now = skGetTime();
    this.approach_lock = false;

    if (this.chara_sentence_list_setting || this.tapped_script) {
      this.tapped_script = null;
      this.chara_sentence_list_setting = null;
      _ud.setHapinessActionCosId(-1);
    }

    if (this.state == STATE_NONE) {
      local _f = ::tutorial_manager.canExecBonusHapinessTutorial();
      if (_ud.enableHapinessAction(_f)) {
        local _tasks = _createHapinessActionList();
        if (_tasks) {
          _ud.setHapinessActionCosId(_cd.getID());
          return _tasks;
        }
      }
    }

    local _scp = _cd.getModelScript();
    if (_scp) {
      return ::charaActionListFactory.createSimpleScriptAction(this, _scp.scp, _scp.turn, _scp.args);
    }
    else if (_cd.enableLevelUp()) {
      local _script_name = "levelup_already_enabled";
      return ::charaActionListFactory.createSimpleScriptAction(this, _script_name, true);
    }

    return ::charaActionListFactory.createActionList(this);
  }

  function approachFurniture(furniture_model, bone = null) {
    if (!this.canInterruptAction()) return false;

    startScript("end_common");

    this.tasks.clear();
    this.actiontime = 0;
    this.action = null;
    this.action_target = null;

    setTargetFurnitureUID(furniture_model.getFurnitureData().getUID());

    this.target_furniture = furniture_model;
    this.state = STATE_APPROACH_FURNITURE;

    this.tasks = ::charaActionListFactory.createApproachFurnitureActionList(this, furniture_model, bone, false);
    changeAction(this.tasks[0]);
  }

  function startCharaScriptAction(script, scp_args = null, is_turn_front = true, add_idle = false) {
    if (!this.canInterruptAction()) return false;

    startScript("end_common");
    this.tasks.clear();
    this.actiontime = 0;
    this.action = null;
    this.action_target = null;

    this.tasks = ::charaActionListFactory.createSimpleScriptAction(this, script, is_turn_front, scp_args);
    if (add_idle) {
      this.tasks.extend(::charaActionListFactory.createNeutralActionList(this));
    }

    changeAction(this.tasks[0]);

    if (!scp_args || scp_args.len() < 2 || typeof(scp_args[1]) != SS_TABLE) return;
    local _reward = scp_args[1];
    if (!_reward["old_values"] || !_reward["old_values"][getCostumeID()]) return;

    local _old_value = _reward["old_values"][getCostumeID()];
    local _cd = getCostumeData();

    if (!_cd.enableLevelUp() || _cd.enableLevelUp(_old_value.exp)) return;

    this.tasks.extend(::charaActionListFactory.createSimpleScriptAction(this, "levelup_enabled", true));

  }

  function extendHapinessAction(force = true) {
    if (!getCostumeData()) return;

    local _ud = ::gamesession.getUserData();
    if (_ud.enableHapinessAction(force)) {
      local _tasks = _createHapinessActionList();
      if (_tasks) {
        _ud.setHapinessActionCosId(getCostumeID());
        this.tasks.extend(_tasks);
      }
    }
  }

  function startActionTurnAndMove() {
    if (!this.canInterruptAction()) return false;

    this.tasks.clear();
    this.actiontime = 0;
    this.action = null;
    this.action_target = null;

    this.tasks = ::charaActionListFactory.createTurnAndMoveAction(this);
    changeAction(this.tasks[0]);
  }

  function clearAction(reset_furniture_uid = true) {
    this.tasks.clear();
    this.actiontime = 0;
    this.action = null;
    this.action_target = null;
    if (reset_furniture_uid) resetTargetFurnitureUID();

    this.tasks.extend(_getNewAction());

    changeAction(this.tasks[0]);
  }

  function isActionEnd() {
    if (!action) return true;
    return action.isActionEnd(this);
  }
  function canInterruptAction() {
    return action ? action.canInterruptAction() : true;
  }

  function endAction() {
    delete this.tasks[0];
    this.actiontime = 0;
    this.action_target = null;
    this.action = null;

    if (this.is_auto_action && !(0 in this.tasks)) {
      this.tasks.extend(_getNewAction());
    }

    if (this.is_auto_action) {
      while (this.tasks.len() <= 0) {
        println(getCostumeData().getCharaName() + "state = " + this.state + ", task.len = " + this.tasks.len() + ", newAction = " + (0 in this.tasks) + "target_furniture_uid = " + target_furniture_uid + "   !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!")
        this.tasks.extend(_getNewAction());
      }
    }

    if ((0 in this.tasks)) changeAction(this.tasks[0]);
  }

  function clearTasks(start_end_common = true, reset_furniture_uid = true) {
    if (start_end_common) startScript("end_common");
    this.tasks.clear();
    this.action = null;
    this.actiontime = 0;
    this.action_target = null;
    if (reset_furniture_uid) resetTargetFurnitureUID();
  }

  function setupTasks(tasks, reset_curr_scp = false) {
    if (reset_curr_scp) this.current_script_name = "";

    this.tasks.clear();
    this.actiontime = 0;
    this.action = null;
    this.action_target = null;
    this.tasks.extend(tasks);

    changeAction(this.tasks[0]);
  }

  function setFurnitureScriptRunning(b) {
    this.is_furniture_script = b;
    if (b) this.state = STATE_USING_FURNITURE;

  }
  function isFurnitureScriptRunning() {
    return this.is_furniture_script
  }

  function setupStopTasks() {

    setupTasks(::charaActionListFactory.createStopActionList(this));
  }

  function setupStartGrowingTasks() {

    setupTasks(::charaActionListFactory.createGrowingStartActionList(this));
  }

  function setupCalledTasks() {

    setupTasks(::charaActionListFactory.createCalledActionList(this));
  }

  function setupStartGrowingResultTasks() {
    setupTasks(::charaActionListFactory.createGrowingResultActionList(this));
  }

  function setupEndGrowingResultTasks() {
    setupTasks(::charaActionListFactory.getEndGrowingResultTasks(this));
  }

  function getObject() {
    return this.obj;
  }
  function getCurrentScriptName() {
    return current_script_name;
  }

  function setCurrentScriptName(s) {
    this.current_script_name = s;
  }

  function getRoomInfoManager() {
    return stage.getRoomInfoManager();
  }

  function setTargetFurnitureUID(furniture_uid) {
    this.target_furniture_uid = furniture_uid;
  }
  function getTargetFurnitureUID() {
    return this.target_furniture_uid;
  }
  function resetTargetFurnitureUID() {
    this.target_furniture_uid = -1;
  }

  function getCostumeData() {
    return ::gamesession.getUserData().getCostumeData(this.costume_id);
  }

  function getCharaData() {
    return ::gamesession.getUserData().getCharacterData(getCharaID());
  }

  function getCharaID() {

    local cos_setting = ::gamesetting.costume_settings[this.costume_id];
    return cos_setting.getCharaID();
  }

  function getCharaSetting() {
    return ::gamesetting.sanrio_chara_settings[getCharaID()];
  }

  function setAutoAction(b) {
    this.is_auto_action = b;
  }

  function setLastUseFurniture(fm, t) {
    this.last_use_furniture = fm;
    this, last_use_furniture_time = t;
  }

  function setWaitingProductModel(m) {
    this.waiting_product_model = m;
    if (m) {
      stopSelectFurnitureThread();
      this.state = STATE_WAIT_FURNITURE;
    }
  }
  function isWaitingProduct() {
    return this.waiting_product_model != null;
  }

  function resetWaitingProduct() {
    if (this.waiting_product_model) {
      this.waiting_product_model.removeWaitingProductChara(this);
      this.waiting_product_model = null;
    }
  }

  function finishProduct() {

    setFurnitureScriptRunning(false);
    resetTargetFurnitureUID();

    this.target_furniture = null;
    this.state = STATE_NONE;
  }

  function isInScreen() {
    local _v = ::gamesession.getCurrentScene().getStage().renderer.camera.project(getPos());
    local _spos = [_v.x * ::viewWidth, _v.y * ::viewHeight];
    return _spos[0] > 0 && _spos[0] < ::screenWidth && _spos[1] > 0 && _spos[1] < ::screenHeight;
  }

  function getEnableUseFurnitureList(f) {
    return stage.getEnableUseFurnitureList(f);
  }

}