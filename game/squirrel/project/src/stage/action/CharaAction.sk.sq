class CharaAction {
  can_interrupt = true;

  constructor() {
  }

  function startAction(chara_model, action_data) {
    local id = action_data.scp_id || ::neutral_action.action_name;
    local args = action_data.scp_args;
    this.can_interrupt = action_data.canInterruptAction();

    switch (length(args)) {
    case 0: chara_model.startScript(id); break;
    case 1: chara_model.startScript(id, args[0]); break;
    case 2: chara_model.startScript(id, args[0], args[1]); break;
    case 3: chara_model.startScript(id, args[0], args[1], args[2]); break;
    }
  }

  function update(dt, chara_model) {
    if (isActionEnd(chara_model)) {
      chara_model.endAction();
      return;
    }

    chara_model.actiontime -= dt;
    if (chara_model.actiontime <= 0) {
      updateAction(int(dt - chara_model.actiontime), chara_model);
      if (isActionEnd(chara_model)) {
        chara_model.endAction();
      };
    }
    else {
      updateAction(dt, chara_model);
    }
  }

  function updateAction(dt, chara_model) {
  }

  function isActionEnd(chara_model) {
    return true;
  }

  function canInterruptAction() {
    return this.can_interrupt;
  }
}

class CharaActionIdle extends CharaAction {

  function startAction(chara_model, action_data) {
    super.startAction(chara_model, action_data);
    chara_model.actiontime = action_data.time;
  }

  function updateAction(dt, chara_model) {
    super.updateAction(dt, chara_model);
  }

  function isActionEnd(chara_model) {
    return chara_model.actiontime <= 0;
  }
}

class CharaActionScript extends CharaAction {

  function startAction(chara_model, action_data) {
    if (action_data.target instanceof ::FurnitureModel) {
      if (action_data.scp_args) {
        chara_model.startScript(action_data.scp_id, action_data.target, action_data.scp_args);
      } else {
        chara_model.startScript(action_data.scp_id, action_data.target);
      }

      local args = action_data.scp_args;
    }
    else {
      super.startAction(chara_model, action_data);
    }
  }

  function isActionEnd(chara_model) {
    return !chara_model.obj.sk3d.scprunner.running;
  }
}

class CharaActionMove extends CharaAction {
  bound_table = null;

  function startAction(chara_model, action_data) {
    super.startAction(chara_model, action_data);

    local action_setting = ::gamesetting.getActionSettingByName(action_data.scp_id) || ::charaActionListFactory.walk_action;
    local spd = action_setting.move_speed * DASHSPEED_SCALE;
    chara_model.speed = spd;

    local chara_pos = chara_model.getPos();
    local dx = action_data.target.x - chara_pos.x;
    local dy = action_data.target.y - chara_pos.y;
    local dz = action_data.target.z - chara_pos.z;
    chara_model.actiontime = Math.sqrt(dx * dx + dy * dy + dz * dz) / spd;

    chara_model.action_target = action_data.target;

    if (!this.bound_table) this.bound_table = {};
    else delete this.bound_table[chara_model.getCostumeID()];

    _updateBoundTable(chara_model, 0.0);
  }

  function updateAction(dt, chara_model) {
    super.updateAction(dt, chara_model);

    local chara_pos = chara_model.getPos();
    local x = chara_pos.x + (chara_model.action_target.x - chara_pos.x) * dt / (chara_model.actiontime + dt);
    local y = chara_pos.y + (chara_model.action_target.y - chara_pos.y) * dt / (chara_model.actiontime + dt);
    local z = chara_pos.z + (chara_model.action_target.z - chara_pos.z) * dt / (chara_model.actiontime + dt);

    local _c = _updateBoundTable(chara_model, dt);
    if (_c) {
      if (!chara_model.getPauseBound()) return;
    }
    chara_model.setPosXYZ(x, y, z);
  }

  function _updateBoundTable(chara_model, dt) {
    local chara_pos = chara_model.getPos();
    local x = chara_pos.x + (chara_model.action_target.x - chara_pos.x) * dt / (chara_model.actiontime + dt);
    local y = chara_pos.y + (chara_model.action_target.y - chara_pos.y) * dt / (chara_model.actiontime + dt);
    local z = chara_pos.z + (chara_model.action_target.z - chara_pos.z) * dt / (chara_model.actiontime + dt);

    local _c = chara_model.inBoundOtherCharas({ x = x, y = y, z = z });
    if (_c) {
      this.bound_table[chara_model.getCostumeID()] <- _c;
    } else {

      delete this.bound_table[chara_model.getCostumeID()];
    }
    return _c;
  }

  function isActionEnd(chara_model) {
    local chara_pos = chara_model.getPos();
    if (chara_pos.x == chara_model.action_target.x && chara_pos.y == chara_model.action_target.y && chara_pos.z == chara_model.action_target.z) {
      return true;
    }
    else if (chara_model.actiontime <= 0) {

      chara_model.setPos(chara_model.action_target);
      return true;
    }

    return false;
  }

  function getBoundChara(cid) {
    return this.bound_table[cid];
  }
}

class CharaActionTurn extends CharaAction {
  function startAction(chara_model, action_data) {
    super.startAction(chara_model, action_data);

    local max_rotate_time = 600.0;
    chara_model.action_target = action_data.target * Math.RTOD;
    chara_model.actiontime = action_data.time > 0 ? action_data.time : Math.abs(_calcAngleDiff(chara_model.angle, chara_model.action_target) / 180.0 * max_rotate_time);
  }

  function updateAction(dt, chara_model) {
    super.updateAction(dt, chara_model);
    local calc = _calcAngleDiff(chara_model.getAngle(), chara_model.action_target) / (chara_model.actiontime + dt);
    chara_model.addAngle(calc * dt);
  }

  function _calcAngleDiff(angle, target_angle) {
    local diff = target_angle - angle;
    if (diff > 180) {
      diff = diff % 360;
      if (diff > 180) {
        diff = diff - 360;
      }
    } else if (diff < -180) {
      diff = diff % 360;
      if (diff < -180) {
        diff = diff + 360;
      }
    }
    return diff;
  }

  function isActionEnd(chara_model) {
    if (chara_model.actiontime <= 0) {

      chara_model.setAngle(chara_model.action_target);
      return true;
    }

    return false;
  }
}