class ActionData {
  action = null;
  scp_id = null;
  scp_args = null;

  time = 0;
  target = null;

  can_interrupt = true;

  constructor(action, scp_id, scp_args = null, _target = null, _time = 0, _interrupt = true) {
    this.action = action;
    this.scp_id = scp_id;
    this.scp_args = scp_args;

    this.target = _target;
    this.time = _time;
    this.can_interrupt = _interrupt;
  }

  function canInterruptAction() {
    return this.can_interrupt;
  }

  function isActionMove() {
    return this.action instanceof CharaActionMove ? true : false;
  }
}

local CharaActionListFactory = class {
  static CAN_USE_FURNITURE_DIST = 1.0;
  static CANCEL_USE_FURNITURE_SCRIPT = "route_cancel_use_furniture_kubifuri";

  actions = {};
  v1 = Vector3D();
  v2 = Vector3D();

  walk_action = null;
  tefuri_action = null;
  turn_action = null;

  neutral_action = null;
  default_move_action = null;
  default_turn_action = null;

  constructor() {

    actions.idle <- ::CharaActionIdle();
    actions.script <- ::CharaActionScript();
    actions.move <- ::CharaActionMove();
    actions.turn <- ::CharaActionTurn();
  }

  function initCommonActionSetting() {
    walk_action = ::gamesetting.action_settings[20];
    tefuri_action = ::gamesetting.action_settings[1000];
    turn_action = ::gamesetting.action_settings[30];

    neutral_action = ::gamesetting.action_settings[10];
    default_move_action = ::gamesetting.action_settings[20];
    default_turn_action = ::gamesetting.action_settings[30];
  }

  function _getCurrentFloorIndex(p) {
    return 0;
  }

  function _getCurrentRoomIndex(p) {
    return 0;
  }

  function _setIdleRoomActionSettings(result, prev_scp = null) {
    local _ids = ::gamesession.getUserDataLocal().getRoomIdleMotions();
    return _setRoomActionSettings(result, _ids, prev_scp);
  }

  function _setMoveRoomActionSettings(result, prev_scp = null) {
    local _ids = ::gamesession.getUserDataLocal().getRoomMoveMotions();
    return _setRoomActionSettings(result, _ids, prev_scp);
  }

  function _setRoomActionSettings(result, motion_ids, prev_scp = null) {
    local _total_frequency = 0;
    foreach (mid in motion_ids) {
      local _setting = ::gamesetting.room_motion_settings[mid];
      if (!_setting) continue;
      if (!prev_scp || _setting.getActionName() != prev_scp) {
        result + _setting;
        _total_frequency += _setting.getFreq();
      }
    }
    return _total_frequency;
  }

  function _getRandomSelectSetting(candidates, total_frequency = -1) {
    if (total_frequency < 0) total_frequency = _calcTotalFreqActionList(candidates);
    if (total_frequency == 0) return default_move_action;

    local _val = ::PUBLIC_RANDOM.nexti(total_frequency);
    foreach (setting in candidates) {
      _val -= setting.getFreq();
      if (_val <= 0) return setting;
    }
    return default_move_action;
  }

  function _findCandidateAction(prev_actions, script_name) {
    foreach (prev in prev_actions) {
      if (prev == script_name) return true;
    }

    return false;
  }

  function _calcPosLocalToGlobal(_pos, floor, room) {
    local _v1 = ::gamesession.getCurrentScene().getStage().getHouseManager().getHouseBasePos();

    return _v1.add(_pos.x, _pos.y, _pos.z);
  }

  function _calcTotalFreqActionList(_action_settings) {
    local freq = 0;
    for (local i = 0; i < _action_settings.len(); i++) {
      freq += _action_settings[i].frequency;
    }

    return freq;
  }

  function _getActionSettingByRandom(p) {
    local _script_name = p.getCurrentScriptName();
    local _candidates = [];

    local _total_frequency = 0;
    if (Math.rndi(99) < 60) _total_frequency = _setIdleRoomActionSettings(_candidates, _script_name);
    else _total_frequency = _setMoveRoomActionSettings(_candidates, _script_name);

    return _getRandomSelectSetting(_candidates, _total_frequency);
  }

  function _getMoveActionSettingByRandom() {
    local _candidates = [];
    local _total_frequency = _setMoveRoomActionSettings(_candidates);
    return _getRandomSelectSetting(_candidates, _total_frequency);
  }

  function createActionList(p) {
    local userdata = ::gamesession.getUserData();

    local _rnd = Math.rndi(99);
    if (_rnd < 5 && userdata.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_FURNITURE_AUTO_USE)) {
      local _stage = ::gamesession.getCurrentScene().getStage();
      local _last_fm = p.getLastUseFurniture();
      local _furn = _stage.getNearestFurnitureModel(p.getPos(), true, -1, _last_fm).fm;
      if (_furn && _furn.canSelectedProduct()) {
        _furn.addWaitingProductChara(p, true);
        return [];
      }
    }

    local action_setting = _getActionSettingByRandom(p);
    switch (action_setting.action_type) {
    case ActionSetting.IDLE:
      ::debugln("ActionSetting.IDLE")
      return [_createIdleAction(action_setting)];
    case ActionSetting.ACTION:
      ::debugln("ActionSetting.ACTION")
      return [_createScriptAction(action_setting)];
    case ActionSetting.MOVE:
      ::debugln("ActionSetting.MOVE")
      return _createMoveInRoomActionList(action_setting, p);
    }
  }

  function createNeutralActionList(p) {
    local tasks = [];

    tasks + _createScriptAction(neutral_action);

    return tasks;
  }

  function createStopActionList(p) {
    local tasks = [];

    tasks + _createTurnAction(0);
    tasks + _createScriptAction(neutral_action);

    return tasks;
  }

  function createSimpleScriptAction(p, script, is_turn_front = false, scp_args = null) {
    local tasks = [];

    if (is_turn_front) {
      local _h = ::gamesession.getCurrentScene().getStage().camera_work.hpb[0];
      tasks + _createTurnAction(_h);
    }
    tasks + _createSimpleScriptAction(script, scp_args);

    return tasks;
  }

  function createTurnAndMoveAction(p) {
    local tasks = [];

    local PI = Math.PI;
    local PI2 = PI * 2;
    local PIh = PI / 2;

    local house_manager = p.stage.house_manager;

    local prev_target_pos = Vector3D();
    local target_pos = Vector3D().set(p.getPos());
    local prev_target_angle = 0.0;
    local target_angle = p.angle;

    local paths = house_manager.getRandomTurnMovingRoute(p.getPos(), p.getAngle());
    local floor_depth = ::HouseModel.FLOOR_DEPTH;
    foreach (path in paths) {
      prev_target_pos.set(target_pos);
      target_pos = Vector3D(path.x, floor_depth, path.z);
      if (_getDistances(prev_target_pos, target_pos) > 0.0) {
        prev_target_angle = target_angle;
        target_angle = _getDiffHead(prev_target_pos, target_pos);
        if (_hasDirDiff(prev_target_angle, target_angle)) {
          tasks + _createTurnAction(target_angle);
        }
        tasks + _createMoveAction(_getMoveActionSettingByRandom(), target_pos);
      }
    }

    if (tasks.len() < 1) {
      tasks.extend(createActionList(p));
    }
    return tasks;
  }

  function createTurnSideAndNearMoveActionList(p) {
    local tasks = [];

    local PI = Math.PI;
    local PI2 = PI * 2;
    local PIh = PI / 2;

    local house_manager = p.stage.house_manager;
    local prev_angle = 0.0;
    local target_angle = p.getAngle();

    local paths = house_manager.getRandomTurnSideMovingRoute(p.getPos(), p.getAngle());
    local floor_depth = ::HouseModel.FLOOR_DEPTH;

    local target = Vector3D().set(p.getPos());;
    local prev = Vector3D()

    v2.set(p.getPos());

    foreach (path in paths) {
      prev.set(target);
      target.set(path.x, floor_depth, path.z);
      if (_getDistances(prev, target) > 0.0) {
        prev_angle = target_angle;
        target_angle = _getDiffHead(prev, target);
        if (_hasDirDiff(prev_angle, target_angle)) {
          tasks + _createTurnAction(target_angle);
        }
        tasks + _createMoveAction(_getMoveActionSettingByRandom(), target);
      }
    }

    return tasks;
  }

  function createShortMoveToTarget(p, tp) {
    local tasks = [];

    local house_manager = p.stage.house_manager;
    local near_pos = house_manager.getEnabledNodeByVortex(tp.x, tp.z);
    local route = house_manager.getMovingRoute(p.getPos(), near_pos);

    local move_num = Math.min(length(route), 6);
    local points = [];
    for (local i = 0; i < move_num; i++) {
      points + route[i];
    }
    tasks.extend(createPointsMoveActionList(p, points, _getMoveActionSettingByRandom()));

    return tasks;
  }

  function createMoveToFurniture(chara_model, furniture_model, interrupt = true) {
    local target_pos = null;
    local dist = 100000.0

    local house_manager = chara_model.stage.house_manager;
    local sin = Math.sin;
    local cos = Math.cos;
    local pi = Math.PI;
    local pih = Math.PI / 2.0;
    local pi3h = pih * 3;

    local chara_pos = chara_model.getPos();
    local furniture_pos = furniture_model.getPos();
    local furniture_dir = furniture_model.getDir();
    local furniture_setting = furniture_model.getFurnitureSetting();
    local target_pos_data = null;
    foreach (data in furniture_setting.getActionPosData()) {
      target_pos_data = data;
      break;
    }

    local bone_x = 0.0;
    local bone_z = 0.0;

    local action_points = [];
    if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_FRONT || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
      v1.set(furniture_pos).add(bone_x, 0.0, bone_z);
      local dist = target_pos_data.dist;
      local sin_dir = sin(furniture_dir);
      local cos_dir = cos(furniture_dir);
      v2.set(v1).add(dist * sin_dir * -1.0, 0.0, dist * cos_dir * -1.0);
      action_points + ({ x = v2.x, z = v2.z });
    }
    if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_RIGHT || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_SIDE || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
      v1.set(furniture_pos).add(bone_x, 0.0, bone_z);
      local dist = target_pos_data.dist;
      local sin_dir = sin(furniture_dir + pih);
      local cos_dir = cos(furniture_dir + pih);
      v2.set(v1).add(dist * sin_dir * -1.0, 0.0, dist * cos_dir * -1.0);
      action_points + ({ x = v2.x, z = v2.z });
    }
    if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_LEFT || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_SIDE || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK || target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
      local dist = target_pos_data.dist;
      local sin_dir = sin(furniture_dir + pi3h);
      local cos_dir = cos(furniture_dir + pi3h);
      v2.set(v1).add(dist * sin_dir * -1.0, 0.0, dist * cos_dir * -1.0);
      action_points + ({ x = v2.x, z = v2.z });
    }
    if (target_pos_data.type == ::FurnitureSetting.ACTION_AREA_ALL) {
      local dist = target_pos_data.dist;
      local sin_dir = sin(furniture_dir + pi);
      local cos_dir = cos(furniture_dir + pi);
      v2.set(v1).add(dist * sin_dir * -1.0, 0.0, dist * cos_dir * -1.0);
      action_points + ({ x = v2.x, z = v2.z });
    }

    foreach (point in action_points) {
      local pos = house_manager.getNearestValidNodePos(point.x, point.z);
      if (!pos) continue;

      local length = v1.set(pos).sub(chara_pos).length();
      if (dist > length) {
        target_pos = { x = pos.x, z = pos.z };
        dist = length;
      }
    }

    if (!target_pos) {

      local size_wh = furniture_setting.size_w / 2.0;
      local size_hh = furniture_setting.size_h / 2.0;
      local x1 = furniture_pos.x - size_wh;
      local x2 = furniture_pos.x + size_wh;
      local z1 = furniture_pos.z - size_hh;
      local z2 = furniture_pos.z + size_hh;

      foreach (point in action_points) {

        v1.set(point).sub(furniture_pos).set(v1.x * 100, v1, v1.z * 100);

        local x3 = furniture_pos.x;
        local z3 = furniture_pos.z;
        local x4 = v1.x;
        local z4 = v1.z;

        if (::isLineCrossed(x1, z1, x2, z2, x3, z3, x4, z4)) {
          local cross_point = ::getVertexCoordinate(x1, z1, x2, z2, x3, z3, x4, z4);
          local pos = house_manager.getNearestValidNodePos(cross_point.x, cross_point.z);
          target_pos = { x = pos.x, z = pos.z }
        }
      }

    }

    if (!target_pos) {
      target_pos = house_manager.getEnabledNodeByVortex(furniture_pos.x, furniture_pos.z);
    }

    local tasks = createMoveToTarget(chara_model, target_pos, interrupt);
    return tasks;
  }

  function createMoveToTarget(p, tp, interrupt = true) {
    local tasks = [];

    local house_manager = p.stage.house_manager;
    local near_pos = house_manager.getNearestValidNodePos(tp.x, tp.z);
    local route = house_manager.getMovingRoute(p.getPos(), near_pos);

    local points = route;
    tasks.extend(createPointsMoveActionList(p, points, _getMoveActionSettingByRandom(), interrupt));

    return tasks;
  }

  function createLookAtTarget(p, tp) {
    local tasks = [];
    tasks + _createTurnAction(_getDiffHead(p.getPos(), tp));
    return tasks;
  }

  function createPointsMoveActionList(p, points, action_setting = null, interrupt = true) {
    local tasks = [];

    if (!action_setting) {
      action_setting = _getActionSettingByRandom(p);
    }

    local curr = points[0];
    local dir = p.getAngle() * Math.DTOR;
    foreach (next in points) {
      if (curr.equals(next)) continue;

      local target_dir = _getDiffHead(curr, next);
      if (_hasDirDiff(dir, target_dir)) {
        tasks + _createTurnAction(target_dir, interrupt);
      }

      tasks + _createMoveAction(action_setting, next, interrupt);

      curr = next;
      dir = target_dir;
    }

    return tasks;
  }

  function createCalledActionList(p) {
    local tasks = [];

    tasks + _createTurnAction(0);
    tasks + _createScriptAction(::mayoi_action);

    return tasks;
  }

  function createApproachFurnitureActionList(p, furniture_model, target_bone = null, can_interrupt = true) {
    local _setting = furniture_model.getFurnitureSetting();
    local _f_pos = furniture_model.getPos();

    local _target_pos_data = null;
    foreach (idx, pos_data in _setting.getActionPosData()) {
      if (target_bone) {
        if (!("bone" in pos_data) || pos_data.bone != target_bone) continue;
        _target_pos_data = pos_data;
        break;
      } else {
        if ("bone" in pos_data) continue;
        _target_pos_data = pos_data;
        break;
      }
    }

    if (!_target_pos_data) {
      println("[ERROR] createApproachFurnitureActionList -- not target pos!!!!! id = " + _setting.getID() + " , bone = " + target_bone);
      return createNeutralActionList(p);
    }

    local _f_angle = furniture_model.getAngle();
    local _dist = _target_pos_data.dist;

    v1.set(0, 0, 0);

    local bone_x = 0;
    local bone_z = 0;

    local _bone = "bone" in _target_pos_data ? _target_pos_data.bone : null;

    if (_bone) {
      local sk3d = furniture_model.obj.sk3d;
      local parts = null;
      foreach (k, val in sk3d.motion.parts) {
        if (val.name != target_bone) continue;
        parts = val;
        break;
      }

      if (parts && parts != undefined) {
        local p0 = parts.bindpose;
        v1.set(p0[12], 0, p0[14]).transform0(sk3d.gmat);

        bone_x = v1.x;
        bone_z = v1.z;
      }
    }
    local _chara_pos = p.getPos();
    local _target_pos_list = [];
    for (local add_angle = 0; add_angle < 360; add_angle += 90) {

      switch (_target_pos_data.type) {
      case ::FurnitureSetting.ACTION_AREA_FRONT:
        if (add_angle > 0) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_SIDE:
        if (add_angle % 180 == 0) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_IGUNORE_BACK:
        if (add_angle == 180) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_RIGHT:
        if (add_angle != 90) continue;
        break;
      case ::FurnitureSetting.ACTION_AREA_LEFT:
        if (add_angle != 270) continue;
        break;
      }
      local _dir = (_f_angle + add_angle) * Math.PI / 180;
      v1.set(_f_pos.x, _f_pos.y, _f_pos.z).add(_dist * Math.sin(_dir) * -1, 0, _dist * Math.cos(_dir) * -1).add(bone_x, 0, bone_z).sub(_chara_pos);

      local _in = false;
      foreach (idx, tp in _target_pos_list) {
        if (tp.length() > v1.length()) {
          _target_pos_list[idx] <- Vector3D().set(v1).add(_chara_pos);
          _in = true;
          break;
        }
      }
      if (!_in) _target_pos_list + Vector3D().set(v1).add(_chara_pos);
    }

    local tasks = [];
    local house_manager = p.stage.house_manager;

    local _use_route;
    local _use_index;
    local _def_route;
    local _success = false;
    foreach (idx, tp in _target_pos_list) {
      _use_index = idx;
      local _near_pos = house_manager.getNearestValidNodePos(tp.x, tp.z);
      if (!_near_pos) _near_pos = house_manager.getEnabledNodeByVortex(tp.x, tp.z);

      local _route = house_manager.getMovingRoute(_chara_pos, _near_pos);
      if (idx == 0) _def_route = _route;
      if (_route) {
        local _last_route = _route[length(_route) - 1];
        if (_last_route) {
          local _dist = ::getDistance(_last_route, tp);
          if (_last_route.equals(tp)) {
            _use_route = _route;
            _success = true;
            break;
          }
          else if (_dist < CAN_USE_FURNITURE_DIST) {
            _route + tp;
            _use_route = _route;
            _success = true;
            break;
          }
        }
        else {
          local _dist = ::getDistance(_chara_pos, tp);
          if (_dist < CAN_USE_FURNITURE_DIST) {
            _success = true;
            break;
          }
        }
      }
    }
    if (!_success) {
      _use_route = _def_route;
      _use_index = 0;
    }

    if (_use_route) {

      tasks.extend(createPointsMoveActionList(p, _use_route, _getMoveActionSettingByRandom(), can_interrupt));
    }

    if (_target_pos_list.len() > 0) tasks + _createTurnAction(_getDiffHead(_target_pos_list[_use_index], _f_pos), can_interrupt);
    if (_success) {

      local _stay_action_setting = _setting.getStayActionSettingAtUseFurniture();
      tasks + _createScriptAction(_stay_action_setting, furniture_model, _bone);
    }
    else {

      tasks + _createSimpleScriptAction(CANCEL_USE_FURNITURE_SCRIPT, null, false);
    }
    return tasks;
  }

  function createFirstActionList(p) {
    local tasks = [];

    tasks + _createTurnAction(0);
    tasks + _createScriptAction(tefuri_action);

    return tasks;
  }

  function createHapinessActionList(p, sentence_setting) {

    local tasks = _createMoveInRoomActionList(_getMoveActionSettingByRandom(), p, false);
    local _idx = tasks.len() / 3;

    for (local i = _idx; i < tasks.len(); i++) {
      local _ad = tasks[i];
      if (!_ad.isActionMove()) continue;

      tasks[i + 1] <- _createSimpleScriptAction(sentence_setting.getPrevAction(), null, false);
      break;
    }

    return tasks;
  }

  function createHapinessAction(p, sentence_setting) {
    local tasks = [];
    tasks + _createSimpleScriptAction(sentence_setting.getPrevAction(), null, false);
    return tasks;
  }

  function _hasDirDiff(angle1, angle2) {
    return (angle2 - angle1) % (Math.PI * 2) != 0.0;
  }

  function _getVecHead(vec) {
    if (!vec) return 0.0;

    local x = vec.x;
    local z = vec.z;

    if (x == 0.0) {
      return z >= 0.0 ? 0.0 : Math.PI;
    }
    else {
      if (x > 0.0) {
        return Math.PI / 2 - Math.atan(z / x);
      }
      else {
        return Math.PI * 3 / 2 - Math.atan(z / x);
      }
    }
  }

  function _getDiffHead(pos1, pos2) {
    if (!pos1 || !pos2) return 0.0;

    local x = pos1.x - pos2.x;
    local y = pos1.y - pos2.y;
    local z = pos1.z - pos2.z;
    return _getVecHead(v1.set(x, y, z));
  }

  function _getRandomActionTask(p) {
    return _createScriptAction(_getActionSettingByRandom(p));
  }

  function _createTurnAction(target_angle, interrupt = true) {
    if (interrupt) interrupt = turn_action.canInterrupt();

    local ad = ActionData(actions.turn, turn_action.action_name, null, target_angle, 0, interrupt);
    return ad;
  }

  function _createMoveAction(setting, target_pos, interrupt = true) {
    if (interrupt) interrupt = setting.canInterrupt();

    local ad = ActionData(actions.move, setting.action_name, null, target_pos, 0, interrupt);
    return ad;
  }

  function _createIdleAction(setting) {
    local _time = 500 + ::PUBLIC_RANDOM.nexti(1500);
    local ad = ActionData(actions.idle, setting.action_name, null, null, _time, setting.canInterrupt());
    return ad;
  }

  function _createScriptAction(setting, target = null, args = null) {
    local ad = ActionData(actions.script, setting.action_name, args, target, 0, setting.canInterrupt());
    return ad;
  }

  function _createSimpleScriptAction(script, scp_args = null, interrupt = true) {
    local ad = ActionData(actions.script, script, scp_args, null, 0, interrupt);
    return ad;
  }

  function _createMoveNearGridActionList(p) {
    local tasks = [];

    local _isContains = function(arr, a) { if (!a) return true; foreach (e in arr) { if (e == a) return true }; return false; }

    local action_setting = _getMoveActionSettingByRandom();
    local chara_pos = p.getLocalPos();
    if (chara_pos.z < 0.0 && false) {

      local floor_idx = _getCurrentFloorIndex(p);
      local room_idx = _getCurrentRoomIndex(p);

      local origin = ::HouseManager.Factory.getRoomPos(floor_idx, room_idx);
      local next = chara_pos.z <= -2.5 && chara_pos.y == origin.y || chara_pos.y < origin.y + ::RoomModel.ROOM_HEIGHT / 2.0 ? -1 : 1;

      if (next == -1) {
        floor_idx += 1;
      }
      else {
        if (chara_pos.y == origin.y) {
          floor_idx -= 1;
        }
      }

      tasks.extend(_createMoveStairActionList(action_setting, p, chara_pos, floor_idx, room_idx, next));
    }
    else {
      local house_manager = p.stage.house_manager;
      local near_grid = house_manager.getNearestNodePos(chara_pos.x, chara_pos.z);
      if (!near_grid) near_grid = house_manager.getRandomNodePos();
      local target_pos = Vector3D(near_grid.pos_x, ::HouseModel.FLOOR_DEPTH, near_grid.pos_z);

      local target_angle = _getDiffHead(p.getPos(), target_pos);
      if (_hasDirDiff(p.angle, target_angle)) {
        tasks + _createTurnAction(target_angle);
      }
      tasks + _createMoveAction(action_setting, target_pos);
    }

    return tasks;
  }

  function _createMoveInRoomActionList(setting, p, is_random_action = true) {

    local tasks = [];

    local PI = Math.PI;
    local PI2 = PI * 2;
    local PIh = PI / 2;

    local house_manager = p.stage.house_manager;

    local prev_target_pos = Vector3D();
    local target_pos = Vector3D().set(p.getPos());
    local prev_target_angle = 0.0;
    local target_angle = p.angle;

    local paths = house_manager.getRandomMovingRoute(p.getPos());
    local floor_depth = ::HouseModel.FLOOR_DEPTH;
    foreach (path in paths) {
      prev_target_pos.set(target_pos);
      target_pos = Vector3D(path.x, floor_depth, path.z);
      if (_getDistances(prev_target_pos, target_pos) > 0.0) {
        prev_target_angle = target_angle;
        target_angle = _getDiffHead(prev_target_pos, target_pos);
        if (_hasDirDiff(prev_target_angle, target_angle)) {
          if (is_random_action && ::PUBLIC_RANDOM.nexti(100) < 20) {

            tasks + _getRandomActionTask(p);
          }
          tasks + _createTurnAction(target_angle);
        }
        tasks + _createMoveAction(setting, target_pos);
      }
    }

    return tasks;
  }

  function _getDistances(v_1, v_2) {
    local x_diff = v_1.x - v_2.x;
    local y_diff = v_1.y - v_2.y;
    local z_diff = v_1.z - v_2.z;
    return Math.sqrt(x_diff * x_diff + y_diff * y_diff + z_diff * z_diff);
  }
}

charaActionListFactory <- CharaActionListFactory();