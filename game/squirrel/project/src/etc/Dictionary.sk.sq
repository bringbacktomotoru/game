class Dictionary {
  dict_table = {};

  constructor() {
    dict_table = {};
  }

  function get(key, param = null) {
    if (key in dict_table) {
      if (param && param.len() != 0) {

        local res = dict_table[key];

        if (res == "") {
          return "no text";
        }
        local paramIndex = 0;

        local i = res.indexOf("%s");
        while (i != -1) {
          res = res.slice(0, i) + param[paramIndex] + res.slice(i + 2, res.len());
          i = res.indexOf("%s");
          paramIndex++;
        }

        return res;
      } else {

        local res = dict_table[key];

        if (res == "") {
          return "no text";
        } else {
          return res;
        }
      }
    }

    return "no text";
  }
}

::dict <- null;

function loadDictionary(path = null) {
  local _dict = Dictionary();

  if (!path) path = "conf/dict.conf"
  local res = getResource(path);

  if (!res) {
    print("[ERROR ]dict file not fount \n");
  } else {
    res.getContent().call(_dict);
    ::dict = _dict;
    res.pres.flush();

  }
}