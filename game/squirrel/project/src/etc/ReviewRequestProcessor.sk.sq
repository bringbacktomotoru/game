class ReviewRequestProcessor {
  static URL_IOS_REVIEW = "https://itunes.apple.com/us/app/tomotoru/id1439788857?action=write-review";
  static URL_FEEDBACK = "https://www.tomotoru.com/contact";

  webview = null;

  function start() {
    newthread().start(_start.bindenv(this), this);
  }

  function _start() {
    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(::dict.get("review_confirm"));
    _dlg.lbl_caution.setText("");
    _dlg.setTextOk(::dict.get("review_confirm_yes"));
    _dlg.setTextCancel(::dict.get("review_confirm_no"));
    _dlg.show();

    if (_dlg.ret > 0) _processStoreReview();
    else _processFeedback();
  }

  function _processStoreReview() {
    local _osname = skGetOSName();

    local _dlg = ::SimpleDialog2();
    local _dkey = _osname == "iOS" ? "review_request_ios" : "review_request_and";
    _dlg.lbl_msg.setText(::dict.get(_dkey));
    _dlg.lbl_caution.setText("");
    _dlg.setTextOk(::dict.get("review_yes"));
    _dlg.setTextCancel(::dict.get("review_no"));
    _dlg.show();

    if (_dlg.ret > 0) {
      if (_osname == "iOS") {
        this.webview = WebView();
        this.webview.setType(-1);
        this.webview.openURL(URL_IOS_REVIEW);
        this.webview.show();
      } else if (_osname == "Android") {
        ARUtils.openGooglePlayStoreApp();
      }

      _waitReview();

      if (this.webview) {
        this.webview.close();
        this.webview = null;
      }

      local _dlg = ::SimpleDialog();
      _dlg.lbl_msg.setText(::dict.get("review_thank"));
      _dlg.show();
    }
  }

  function _processFeedback() {
    local _dlg = ::SimpleDialog2();
    _dlg.lbl_msg.setText(::dict.get("feedback_request"));
    _dlg.lbl_caution.setText("");
    _dlg.setTextOk(::dict.get("feedback_yes"));
    _dlg.setTextCancel(::dict.get("feedback_no"));
    _dlg.show();

    if (_dlg.ret > 0) {

      local _fc = ::gamesession.getUserDataLocal().getFriendCode();
      if (_fc < 0) _fc = "1" + (_fc * -1);
      local _url = URL_FEEDBACK + "?uid=" + _fc;
      if (skGetOSName() == "iOS") _url = _url + "&device=ios";
      else _url = _url + "&device=android";

      local _webdlg = ::WebViewDialog();
      _webdlg.setURL(_url);
      _webdlg.show();

      local _dlg = ::SimpleDialog();
      _dlg.lbl_msg.setText(::dict.get("feedback_thank"));
      _dlg.show();
    }
  }

  function _waitReview() {

    local _ctx = { waiting = true };
    local _wait_inactive = function(e) {
      if (e.id == ACTIVESTATE_CHANGED) {
        switch (e.keycode) {
        case AppActiveState.APPACTIVE_INACTIVE:
        case AppActiveState.APPACTIVE_BACKGROUND:
          waiting = false;
          break;
        }
      }
    };

    local _fn_inactive = ::gamesession.root.addEventListener(APP_EVENT, _wait_inactive, _ctx);

    while (_ctx.waiting) {
      ::gamesession.root.suspendOrUpdate();
    }
    ::gamesession.root.removeEventListener(APP_EVENT, _fn_inactive);

    _ctx.waiting = true;
    local _wait_active = function(e) {
      if (e.id == ACTIVESTATE_CHANGED && e.keycode == AppActiveState.APPACTIVE_ACTIVE) waiting = false;
    }

    local _fn_active = ::gamesession.root.addEventListener(APP_EVENT, _wait_active, _ctx);

    while (_ctx.waiting) {
      ::gamesession.root.suspendOrUpdate();
    }
    ::gamesession.root.removeEventListener(APP_EVENT, _fn_active);
  }
}