class LoadingView extends SKView {
  is_animating = null;

  spr = 5.0;
  f = 60;
  loadingimg = null;
  w1 = 0.0;
  w2 = 1.0;
  fnum = 60;

  constructor() {
    local tex = ::getTexture("/ui/image/bg_test.png");
    local mask = ::getTexture("/image/rule/163.jpg");

    loadingimg = SKImageView();
    local sp = loadingimg.sp;
    sp.shadersrc = skFXFindTechnique("dashsprite.unitrans").getShaderSource(0);
    local m = sp.miscmat = Matrix();

    sp.tex0 = tex;
    sp.tex1 = mask;
    sp.color = 0xffffffff;
    sp.blend = SK_MIX;
    m[0] = 0.0;
    m[1] = 1.0;
    m[2] = spr;
    w1 = -1.0 / spr;
    w2 = 1.0 + 1.0 / spr;
    fnum = f;

    is_animating = false;
  }

  function show() {
    clearChildren();

    local sp = loadingimg.sp;
    local m = sp.miscmat;

    m[0] = 0.0;
    m[1] = 1.0;
    m[2] = spr;
    w1 = -1.0 / spr;
    w2 = 1.0 + 1.0 / spr;

    local tw = sp.tex0.width < ::screenWidth ? ::screenWidth : sp.tex0.width;
    local offset = sp.tex0.width > ::screenWidth ? (sp.tex0.width - ::screenWidth) / 2 : 0;
    loadingimg.setRect(-offset, 0, tw, ::screenHeight);

    addChild(loadingimg);

    is_animating = true;

    local _div = 1.0 / (fnum - 1);
    for (local l = 0; l < fnum; l++) {
      m[0] = Math.lerp(w1, w2, l * _div);
      println("m[0] = " + m[0])
      loadingimg.repaint();
      sleep(16);
    }

    is_animating = false;

  }

  function hide() {
    local sp = loadingimg.sp;
    local m = sp.miscmat;

    is_animating = true;

    local _div = 1.0 / (fnum - 1);

    for (local l = fnum; l >= 0; l--) {
      m[0] = Math.lerp(w1, w2, l * _div);
      println("m[0] = " + m[0])
      loadingimg.repaint();
      sleep(16);
    }

    is_animating = false;

    removeChild(loadingimg);
  }

  function isAnimating() {
    return is_animating;
  }
}