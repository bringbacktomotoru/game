class SanrioGameScene extends ::GameScene {

  stage = null;
  ui = null;

  production_manager = null;
  panel_mission_manager = null;

  is_need_update = false;

  dialog = null;

  setting_bgm = null;

  static FURNITURE_BARRAGE_LIMIT = 800;
  static CHARACTER_APPROACH_LIMIT = 3000;
  static SELECT_STATE_NONE = 0;
  static SELECT_STATE_CHARA = 1;
  static SELECT_STATE_FURNITURE = 2;
  static SELECT_STATE_FURNITURE_USING = 3;
  static NEED_ATTRACT_TIME = 0;
  static NEXT_CONDUCT_INTERVAL = 2000;

  attract_model = null;
  start_attract_time = -1;
  approach_model = null;
  approach_chara_list = null;
  select_model = null;
  last_select_model = null;
  select_state = 0;
  last_tap_time = -1;

  select_chara_model = null;

  v_1 = Vector3D();
  next_can_conduct_time = 0;

  lock_tap_chara = false;
  lock_tap_scene = false;
  lock_tap_space = false;
  lock_tap_attact_tutorial = false;

  furniture_barrage_manager = null;
  happiness_barrage_manager = null;

  constructor() {
    super();

    this.stage = ::StageScene();
    this.ui = ::HomeUI.create();
    this.production_manager = ::ProductionManager();
    this.panel_mission_manager = ::PanelMissionManager(this);
    this.approach_chara_list = [];
    select_chara_model = null;
    this.furniture_barrage_manager = FurnitureBarrageManager(this);
    this.happiness_barrage_manager = HappinessBarrageManager(this);

    dialog = null;
  }

  function setStageID(stage_id) {
    this.stage.setNextStageID(stage_id);
  }

  function getStageID() {
    return this.stage.getStageID();
  }

  function initApproachCharaList() {
    this.approach_chara_list.clear();
    foreach (c in this.stage.getCharacters()) {
      this.approach_chara_list + c;
    }
  }

  function clearApproachCharaList() {
    this.approach_chara_list.clear();
  }

  function addApproachList(model) {
    if (this.approach_chara_list.indexOf(model) >= 0) return;
    this.approach_chara_list[0] <- model;
  }

  function removeApproachList(model) {
    local _idx = this.approach_chara_list.indexOf(model);
    if (_idx < 0) return;
    delete this.approach_chara_list[_idx];
  }

  function replaceApprochList(model, is_top) {
    local _idx = this.approach_chara_list.indexOf(model);
    if (_idx < 0) return;
    delete this.approach_chara_list[_idx];
    if (is_top) this.approach_chara_list[0] <- model;
    else this.approach_chara_list + model;
  }

  function popApproachChara() {
    local _tmp_list = clone this.approach_chara_list;
    local _pmanager = ::gamesession.getCurrentScene().getProductionManager();
    local _ret = null;
    for (local i = 0; i < this.approach_chara_list.len(); i++) {
      local _cm = this.approach_chara_list[i];
      delete _tmp_list[0];
      _tmp_list + _cm;

      if (!_cm.canRecieveHapiness() &&
      _cm.canInterruptAction() &&
      !_cm.isFurnitureScriptRunning() &&
      _cm.isStateNone()) {
        _ret = _cm;
        break;
      }
    }
    this.approach_chara_list = _tmp_list;

    return _ret;
  }

  function loadScene() {
    super.loadScene();

    this.stage.loadStageScene(true, true);
    addChild(this.stage.view);
    this.stage.viewAdded();

    addChild(this.ui);
  }

  function startScene() {
    super.startScene();

    addCurrentRoomSanrioCharas();
    _registerProduct();

    this.is_need_update = true;
    this.stage.startStageScene();
    ::gamesetting.createShopPriceTables();

    this.ui.updateShopMark(true, true);
  }

  function showScene() {
    this.stage.showStageScene();
  }

  function endScene() {
    super.endScene();
    this.stage.releaseStageScene();
    removeChild(this.stage.view);
    removeChild(this.ui);
  }

  function releaseScene() {
    super.releaseScene();

    this.stage = null;
    this.ui = null;

    this.production_manager = null;
  }

  function updateScene(dt) {
    super.updateScene(dt);
    if (!this.is_need_update) return;

    this.stage.updateScene(dt);
    this.ui.updateScene(dt);
    this.production_manager.update(dt);

    if (this.dialog && this.dialog.isClosing()) this.dialog = null;
  }

  function getCurrentStageID() {
    return this.stage.getStageID();
  }

  function getHouseManager() {
    return this.stage.getHouseManager();
  }

  function getUI() {
    return this.ui;
  }

  function getStage() {
    return this.stage;
  }

  function getProductionManager() {
    return this.production_manager;
  }
  function getPanelMissionManager() {
    return this.panel_mission_manager;
  }

  function getHappinessBarrageManager() {
    return this.happiness_barrage_manager;
  }

  function getAttractModel(cm) {
    if (this.approach_model != cm) return null;

    if (this.last_tap_time + CHARACTER_APPROACH_LIMIT < skGetTime()) return null;
    return this.attract_model;
  }

  function sceneTapped(screen_x, screen_y, is_longtapped = false, furniture_to_furniture = false) {

    return trialSceneTapped(screen_x, screen_y, is_longtapped);
  }

  function trialSceneTapped(screen_x, screen_y, is_longtapped = false) {
    if (disableSceneTap()) return false;
    if (this.happiness_barrage_manager.barrageTap()) return false;

    local _now = skGetTime();
    local _select = false;
    local _model;

    if (!this.select_chara_model && this.last_tap_time + FURNITURE_BARRAGE_LIMIT > _now) {
      _model = this.stage.getTappedFurnitureModelAtScreenPosition(screen_x, screen_y);
    }
    else {
      _model = this.stage.getTappedModel_atScreenPos(screen_x, screen_y);
    }

    if (_model != this.select_model) {
      _select = true;
      this.ui.setARButtonImage(null);

      if (this.select_model instanceof ::CharaModel) {
        this.select_model.getObject().startEffect("removeFocusEffect");
      }
    }
    this.select_model = _model;

    this.production_manager.deselectProducer();
    local _ret = false;
    if (_model instanceof ::UIModel) {
      _ret = _tappedUIModel(_model);
    }
    else if (_model instanceof ::CharaModel) {
      if (is_longtapped) {
        _ret = _longTappedCharaModel(_model);
      }
      else {
        _ret = _tappedCharaModel(_model, _select);
      }
    }
    else if (_model instanceof ::FurnitureModel) {
      if (is_longtapped) {
        _ret = _longTappedFurnitureModel(_model);
      }
      else {

        if (disableAttractTutorialTap(_model.getFurnitureSettingId())) return false;
        _ret = _tappedFurnitureModel(_model, _select, _now, screen_x, screen_y);
      }
    }
    else if (!_model) {
      if (disableSpaceTap()) return false;
      _ret = _tappedSpace(_select, screen_x, screen_y);
    }

    this.last_select_model = _model;

    return _ret;
  }

  function _tappedUIModel(model) {
    model.startUI();
    this.stage.stopTrackModel();
    return true;
  }

  function _longTappedCharaModel(model) {
    local _cp = this.ui.getCurrentPanel();
    if (_cp instanceof HomeTopPanel) {
      local _bl = _cp.getTapHapinessBalloonByCostumeID(model.getCostumeID());
      if (_bl) _bl.longTapped();
    }
    return true;
  }

  function tappedCharaModel(model, select) {
    return _tappedCharaModel(model, select);
  }
  function _tappedCharaModel(model, select) {
    if (disableCharaTap()) return false;
    if (model.isDisableTap()) return false;

    local _cd = model.getCostumeData();

    local _ud = ::gamesession.getUserData();
    local _cp = this.ui.getCurrentPanel();

    if (!this.select_chara_model) {
      local _fs_condition = ::gamesetting.game_rule.disableTutorial() || ::TutorialSetting.TUTORIAL_LIMIT_FRUTNITURE_SELECT < 0 || _ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LIMIT_FRUTNITURE_SELECT);
      if (!model.canRecieveHapiness() && !model.isFurnitureScriptRunning() && model.isStateNone() && _fs_condition) {
        if (::tutorial_manager.isTutorialTapLock()) return true;

        if (_ud.enableHapinessAction()) {
          model.createHapinessActionAtTap();
        } else {
          local _fm = model.getCharaData().getWantedFurnitureModel();
          if (!_fm) return true;
          this.select_chara_model = model;
          model.setSelectFurnitureAction(_fm);
        }

        return true;
      } else {

        if (_cp instanceof HomeTopPanel) {
          local _pd = this.getProductionManager().getProductDataByCosID(model.getCostumeID());
          if (_pd && model.isFurnitureScriptRunning()) {

            if (_pd.isRewardStateTap() && _pd.enableTapHapiness()) {
              local _bl = _cp.getTapHapinessBalloon(_pd);
              if (_bl) {
                _bl.tapped();
                return false;
              } else {
                return true;
              }

            } else if (_pd.isRewardStateBonus() && !_pd.endBonusHapiness()) {
              local _bl = _cp.getHapinessProductBalloon(_pd);
              if (_bl) {
                _bl.tapped();
                return false;
              } else {
                return true;
              }

            }
          } else if (model.isStateApproachFurniture()) {
            _cp.addApproachFurnitureBalloon(model);
            return false;
          } else if (model.hasTappedScript()) {
            if (model.isDisableStartTappedScript()) return false;

            local _bl = _cp.getHapinessBalloon(model);
            if (_bl) {
              _bl.tapped();
              return false;
            } else {
              return true;
            }

          }
        }

      }
    } else {
      if (model == this.select_chara_model) {
        if (model.isWaitTap()) return false;
        if (model.isDisableApproachFurniture()) {
          return false;
        }
        if (!model.isStateSelectFurniture()) {
          print("[ERROR] cannot approach furniture !!! ")
          println(model.getCostumeData().getCharaName() + ", state = " + model.state + ", target = " + model.getTargetFurniture() + ", is_usingfurniture = " + model.isFurnitureScriptRunning())
          return true;
        }

        local _fm = model.getTargetFurniture();
        if (!_fm.canSelectedProduct()) return false;

        _fm.addWaitingProductChara(model);
        _fm.getObject().startEffect("removeSelectArrow");
        this.select_chara_model = null;

        if (_cp instanceof HomeTopPanel) {
          ::tutorial_manager.checkAndStartTutorialAtApproachFurniture(_cp);
        }

        return true;
      } else {

        if (!model.canRecieveHapiness() && !model.isFurnitureScriptRunning() && model.isStateNone()) {
          local _nearest = this.stage.getNearestFurnitureModel(model.getPos(), true);
          local _fm = _nearest.fm;
          if (!_fm) return;

          this.select_chara_model.setSelectFurnitureAction(null);
          this.select_chara_model = model;

          model.setSelectFurnitureAction(_fm);

          return false;
        }
      }
    }

    return false;
  }

  function setLockTapChara(b) {
    this.lock_tap_chara = b;
  }
  function disableCharaTap() {
    return this.lock_tap_chara;
  }

  function setLockTapScene(b) {
    this.lock_tap_scene = b;
  }
  function disableSceneTap() {
    return this.lock_tap_scene;
  }

  function setLockTapSpace(b) {
    this.lock_tap_space = b;
  }
  function disableSpaceTap() {
    return this.lock_tap_space;
  }

  function setLockTapAttractTutorial(b) {
    this.lock_tap_attact_tutorial = b;
  }
  function disableAttractTutorialTap(fid) {
    return this.lock_tap_attact_tutorial && fid != ::TutorialSetting.TUTORIAL_FIRST_BUY_FURNITURE_ID;
  }

  function _longTappedFurnitureModel(model) {

    this.ui.movePanel(::RoomEditPanel, false, { "uid" = model.getFurnitureData().getUID() });
    return true;
  }
  function tappedFurnitureModel(model) {
    _tappedFurnitureModel(model, true, skGetTime());
  }
  function _tappedFurnitureModel(model, select, now, screen_x = -1, screen_y = -1) {
    local _ret = true;
    local _fd = model.getFurnitureData();

    if (!_fd.getSetting().canUseFurniture()) {

      if (disableSpaceTap()) return false;
      return _tappedSpace(select, screen_x, screen_y);
    }

    local _pd = _fd.getProductData();
    local _cp = this.ui.getCurrentPanel();
    if (this.select_chara_model) {
      if (false) {

        if (!model.canSelectedProduct()) return false;
        if (this.select_chara_model.isWaitTap()) return false;

        if (this.select_chara_model.getTargetFurniture() == model) {
          if (this.select_chara_model.isDisableApproachFurniture()) {
            return false;
          }

          model.addWaitingProductChara(this.select_chara_model);
          model.getObject().startEffect("removeSelectArrow");
          this.select_chara_model = null;
          return false;
        } else {
          model.getObject().startEffect("focusEffectFurniture");
          this.select_chara_model.setSelectFurnitureAction(model);
          return true;
        }
      }
    } else {

      if (_pd && _cp instanceof HomeTopPanel) {
        if (_pd.isRewardStateTap() && _pd.enableTapHapiness()) {
          local _bl = _cp.getTapHapinessBalloon(_pd);
          if (_bl) {
            _bl.tapped();
            return false;
          } else {
            return false;
          }
        } else if (_pd.isRewardStateBonus() && !_pd.endBonusHapiness()) {
          local _bl = _cp.getHapinessProductBalloon(_pd);
          if (_bl) {
            _bl.tapped();
            return false;
          } else {
            return false;
          }

        }
      }
    }

    local _ud = ::gamesession.getUserData();
    if (!_pd && ::tutorial_manager.enableFurnitureAttract()) {
      this.furniture_barrage_manager.tapFurniture(model);

      if (this.furniture_barrage_manager.canGetHapiness()) {

        model.getObject().startEffect("tapHapiness");
        this.production_manager.updateSendPoolTapTime();
        this.production_manager.addFurnitureTapHapiness();
        ::gamesession.getUserData().addGameMoneyAtFurnitureTapped();
        ::playSound(::SoundConstants.SOUND_PLUS);
      }
      else {

        model.getObject().startEffect("focusEffectFurniture");
        ::playSound(::SoundConstants.SOUND_BUTTON);
      }

      if (this.select_chara_model && this.furniture_barrage_manager.canUseFurniture()) {

        if (!model.canSelectedProduct()) return false;
        if (this.select_chara_model.isWaitTap()) return false;

        if (this.select_chara_model.getTargetFurniture() == model) {
          if (this.select_chara_model.isDisableApproachFurniture()) {
            return false;
          }

          model.addWaitingProductChara(this.select_chara_model);
          model.getObject().startEffect("removeSelectArrow");
          local _cp = this.ui.getCurrentPanel();
          if (_cp instanceof ::HomeTopPanel) _cp.addNoteBalloon(this.select_chara_model);
          this.select_chara_model = null;

          if (_cp instanceof HomeTopPanel) {
            ::tutorial_manager.checkAndStartTutorialAtApproachFurniture(_cp);
          }
          return false;
        }
      }

      if (this.furniture_barrage_manager.canAttractChara()) {
        if (!this.select_chara_model) {
          local _cm = popApproachChara();
          if (_cm) {
            this.select_chara_model = _cm;
            _cm.setSelectFurnitureAction(model, true);
            ::playSound(::SoundConstants.SOUND_NOTICE_CHARA);
            _ret = false;
          }
        }
        else if (this.select_chara_model.getTargetFurniture() != model) {
          this.select_chara_model.setSelectFurnitureAction(model, true);
          ::playSound(::SoundConstants.SOUND_NOTICE_CHARA);
          _ret = false;
        }
      }
    }
    return _ret;
  }

  function _tappedSpace(select, screen_x = -1, screen_y = -1) {

    if (select) {
      this.ui.resetSelectInfo();
      this.select_state = SELECT_STATE_NONE;
    }

    if (this.select_chara_model) {
      if (::tutorial_manager.tutorialThreadRunning()) return false;
      this.select_chara_model.setSelectFurnitureAction(null);
      this.select_chara_model = null;
      return false;
    }

    return false;
  }

  function resetSelectModel() {
    this.select_model = null;
  }
  function getSelectModel() {
    return this.select_model;
  }
  function getSelectCharaModel() {
    return this.select_chara_model;
  }

  function resetSelectCharaModel() {
    if (this.select_chara_model) select_chara_model.setSelectFurnitureAction(null);
    this.select_chara_model = null;
  }

  function showGetHapinessEffect(mdl, camera = null) {
    if (!camera) {
      camera = this.stage.renderer.camera;
    }

    if (mdl) {
      local sk3d = (getclass(mdl) == CharaModel) ? mdl.obj.sk3d : mdl.sk3d;
      v_1.set(0, 0, 0);
      if (sk3d.parent) {
        local bone = sk3d.parentbone;
        local p0 = bone.parts.bindpose;
        v_1.set(p0[12], 0, p0[14]).transform0(sk3d.parent.gmat);
        v_1.add(sk3d.parent.pos);
      }
      v_1.add(mdl.getPos());

      local v = camera.project(v_1.add(0, 0.8, 0));
      v.x *= ::screenWidth;
      v.y *= ::screenHeight;
      ::gamesession.getTapViewLayer().addGetHapinessEffect(v.x, v.y);
    }
    else {
      ::gamesession.getTapViewLayer().addGetHapinessEffect(::screenWidth / 2.0, ::screenHeight / 2.0);
    }
    ::playSound(::SoundConstants.SOUND_PLUS);
  }

  function showGetHapinessEffectAndAddGM(model, addgm, camera = null, wait_talk = true, check_money = false) {
    newthread().start(function() {
      if (wait_talk) sleep(2500);
      local _home_ui = self.getUI();
      local _clazz = getclass(_home_ui.getCurrentPanel());
      if (!_clazz.need_money_layer) _home_ui.showMoneyUI(true);

      self.showGetHapinessEffect(model, camera);
      sleep(1600);
      _clazz = getclass(_home_ui.getCurrentPanel());
      ::gamesession.getUserData().addGameMoney(addgm);
      if (check_money) {
        _scene.getUI().updateShopMark(true, true);
      }

      if (!_clazz.need_money_layer) {
        sleep(2000);
        _home_ui.showMoneyUI(false);
      }
    }.bindenv({ self = this, model = model, addgm = addgm, camera = camera, wait_talk = wait_talk, check_money = check_money }), this);
  }

  function removeTalkQueue(sk3d) {
    local _cp = this.ui.getCurrentPanel();
    if (_cp) _cp.removeTalkQueue(sk3d);
  }

  function _moveCharaFocusPanel(cm) {
    cm.getObject().startEffect("removeFocusEffect");

    local _tex = ::getTexture("/ui/image/bg.png");
    local _trans = MaskPanelTransition(_tex, ::getTexture("/image/black.jpg"), 5.0, 50);
    this.ui.movePanel(::CharaFocusPanel, false, { model = cm }, null);
  }
  function moveCharaFocusPanelAtSelectModel() {
    if (this.select_model instanceof ::CharaModel) {
      _moveCharaFocusPanel(this.select_model);
      return;
    }
    return;
  }

  function stopStageUpdate() {
    this.stage.stopUpdate();
  }

  function startStageUpdate() {
    this.stage.startUpdate();
  }

  function canChangeRoom(room_idx) {

    return !this.production_manager.isProductingByRoomID(room_idx);
  }

  function changeCurrentRoom(uid) {
    local ud = ::gamesession.getUserData();
    local current_room_idx = ud.getCurrentRoomIndex();
    if (!canChangeRoom(current_room_idx)) {
      local dlg = SimpleDialog();
      dlg.lbl_msg.setText(::dict.get("alart_cannot_change_room"));
      dlg.show();
      return;
    }

    ud.removeAllResideChara(current_room_idx);
    ud.setRoom(current_room_idx, uid);

    this.stage.changeCurrentRoom(uid);
  }

  function selectRoom(room_idx, force = false, send_api = true) {
    local ud = ::gamesession.getUserData();
    if (ud.isCurrentRoomIndex(room_idx) && !force) {
      return;
    }

    ud.selectRoom(room_idx);

    local room_uid = ud.getCurrentRoomUID();
    this.stage.changeCurrentRoom(room_uid);

    if (send_api) {
      ::gamesession.selectRoom(room_idx);
    }
  }

  function playStageBGM(reset = true) {

    local stage_setting = ::gamesetting.stageenv[this.stage.getStageID()];
    if (false) {

    } else if (reset) {

      setting_bgm = stage_setting.bgm[1];
    }
    ::playBGM(::gamesetting.bgm[setting_bgm]);
  }

  function zoomCamera(rate, immediate = false) {
    this.stage.zoomCamera(rate, immediate);
  }

  function moveCamera_byScreenDist(move_sx, move_sy) {
    this.stage.moveCamera_byScreenDist(move_sx, move_sy);
  }

  function addCurrentRoomSanrioCharas() {

    local _ud = ::gamesession.getUserData();
    local _costumes = _ud.getCostumeDataTable();
    local _reside_charas = _ud.getCurrentRoomResideCharas();
    foreach (cid in _reside_charas) {
      if (!_ud.getCostumeData(cid).hasWorkData()) addSanrioChara(cid);
    }
  }

  function updateActiveSanrioCharas() {
    local ud = ::gamesession.getUserData();
    local _reside_charas = ud.getCurrentRoomResideCharas();

    local _residing = {};
    foreach (idx, id in _reside_charas) {
      _residing[id] <- null;
    }

    local remove_ids = [];
    foreach (cos_id, _ in this.stage.getCharacters()) {
      if (!(cos_id in _residing)) {

        remove_ids + cos_id;
      }
    }
    foreach (cos_id in remove_ids) {
      removeSanrioChara(cos_id);
    }

    addCurrentRoomSanrioCharas();

    restartProductFurnitureAction();
  }

  function removeAllSanrioChara() {

    local fms = this.stage.getFurnitureModels();
    foreach (fm in fms) {
      fm.resetParam();
    }

    local charas = clone this.stage.getCharacters();
    foreach (cos_id, _ in charas) {
      removeSanrioChara(cos_id);
    }
  }

  function addSanrioChara(cos_id) {
    if (this.stage.getChara(cos_id)) return;
    this.stage.addChara(cos_id);
  }

  function removeSanrioChara(cos_id) {
    this.stage.removeChara(cos_id);
  }

  function closeupChara(cos_id, isUI = true) {
    this.stage.trackChara(cos_id);
    if (cos_id > 0) this.ui.movePanel(::CharaFocusPanel);
  }

  function getCloseupCharaModel() {
    local selected_chara_id = this.ui.getSelectedSearchCharaID();
    if (selected_chara_id == -1) return null;

    return this.stage.getChara(selected_chara_id);
  }

  function _registerProduct() {
    this.production_manager.init();

    local _ud = ::gamesession.getUserData();
    local _udl = ::gamesession.getUserDataLocal();

    if (_udl) {
      local _f_use_chara_table = _udl.getFurnitureActionCharaTable();
      local _curr_ridx = _ud.getCurrentRoomIndex();
      local _flm = this.stage.getHouseManager().getFurnitureLayoutManager();

      local _rooms = _ud.getRooms();
      for (local ridx = 0; ridx < _rooms.len(); ridx++) {
        local _ed = _ud.getRoomEditDataBySlotIdx(ridx);
        if (!_ed) continue;
        local _flds = _ed.getFurnitureLayouts();
        foreach (_fld in _flds) {
          local _fd = _ud.getFurnitureData(_fld.getUID());
          local _pd = _fd.getProductData();
          if (!(_pd instanceof ::FurnitureProductData)) {
            _udl.removeFurnitureActionCharaTable(_fd.getUID());
            continue;
          }
          this.production_manager.registerFurnitureProduct(_fd);

          if (ridx == _curr_ridx) {
            local _chara_table = _f_use_chara_table[_fld.getUID()] || null;
            if (_chara_table) {
              local _failed = false;
              foreach (cid, bone in _chara_table) {
                local _cm = this.stage.getChara(cid) || null;
                if (!_cm) {
                  _failed = true;
                  break;
                }
                if (_failed) {
                  this.production_manager.cancelProduct(_fd.getUID(), false, true);
                  _udl.removeFurnitureActionCharaTable(_fd.getUID());
                  continue;
                }
              }

              local _fm = _flm.getFurnitureModel(_fld.getUID());
              if (_fm && !_fm.isRunningProductScript()) _fm.restartUserFurnitureAction(_chara_table);
            }

          }
        }
      }

      _udl.save();
    }
  }

  function restartProductFurnitureAction() {
    local ud = ::gamesession.getUserData();
    local udl = ::gamesession.getUserDataLocal();
    local furnitures = this.stage.getFurnitureModels();
    local furniture_use_chara_table = udl.getFurnitureActionCharaTable();

    foreach (uid, fm in furnitures) {
      if (fm.isRunningProductScript()) continue;
      local fd = ud.getFurnitureData(uid);
      local pd = fd.getProductData();
      if (!(pd instanceof ::FurnitureProductData)) {
        udl.removeFurnitureActionCharaTable(fd.getUID());
        continue;
      }
      local _table = furniture_use_chara_table[uid] || null;
      if (_table) {
        local _failed = false;
        foreach (cid, bone in _table) {
          local _cm = this.stage.getChara(cid) || null;
          if (!_cm) {
            _failed = true;
            break;
          }
        }
        if (_failed) {
          this.production_manager.cancelProduct(fd.getUID(), false, true);
          udl.removeFurnitureActionCharaTable(fd.getUID());
          continue;
        }

        fm.restartUserFurnitureAction(_table);
      }
    }

    udl.save();
  }
}

class SanrioGameScene.FurnitureBarrageManager {
  static BARRAGE_TIME = 1200;
  static GET_HAPINESS_NUM = 3;
  static CHARA_ATTRACT_NUM = 9;
  static USE_FURNITURE_NUM = 3;

  model = null;
  scene = null;
  last_time = -1;
  barrage_count = 0;
  attract_count = 0;

  constructor(s) {
    this.scene = s;
  }

  function tapFurniture(fm) {
    if (!fm || !(fm instanceof FurnitureModel)) return;

    local _now = skGetTime();

    if (this.model != fm) {

      this.barrage_count = 0;
      this.model = fm;
      this.attract_count = 0;
    }
    else if (this.last_time + BARRAGE_TIME > _now) {

      this.barrage_count++;
      if (_enableAddAttractCount()) this.attract_count++;
      else this.attract_count = 0;
    }
    else {
      this.barrage_count = 0;
      this.attract_count = 0;
    }

    this.last_time = _now;
  }

  function _enableAddAttractCount() {
    local _m = this.scene.getSelectCharaModel();
    return _m && !_m.isWaitTap() ? true : false;
  }

  function getModel() {
    return this.model;
  }

  function canGetHapiness() {
    return this.barrage_count > 0 && this.barrage_count % GET_HAPINESS_NUM == 0 ? true : false;
  }

  function canAttractChara() {
    if (!this.model || !this.model.canSelectedProduct()) return false;
    return this.barrage_count > 0 && this.barrage_count % CHARA_ATTRACT_NUM == 0 ? true : false;
  }

  function canUseFurniture() {
    return this.attract_count > 0 && this.attract_count % USE_FURNITURE_NUM == 0 ? true : false;
  }
}

class SanrioGameScene.HappinessBarrageManager {
  static BARRAGE_TIME = 1000;
  static BARRAGE_START_COUNT = 3;

  model = null;
  scene = null;

  last_time = -1;
  barrage_count = 0;

  constructor(s) {
    this.scene = s;
  }

  function tapHappinessBalloon(cm) {
    if (!cm || !(cm instanceof CharaModel)) return;

    local _now = skGetTime();

    if (this.model != cm) {

      this.barrage_count = 0;
      this.model = cm;
    }
    else if (_checkBarrageTime(_now)) {

      this.barrage_count++;
    }
    else {

      this.barrage_count = 0;
    }

    if (this.barrage_count >= BARRAGE_START_COUNT) {

      local _cp = this.scene.getUI().getCurrentPanel();
      if (_cp instanceof HomeTopPanel) {
        _cp.setMouseEventLock(true);
      }
    }

    this.last_time = _now;
  }

  function barrageTap() {

    if (this.barrage_count < BARRAGE_START_COUNT) return false;

    local _cp = this.scene.getUI().getCurrentPanel();
    if (!(_cp instanceof HomeTopPanel)) return false;

    local _now = skGetTime();
    if (!_checkBarrageTime(_now)) {
      _cp.setMouseEventLock(false);
      return false;
    }

    local _bl = _cp.getTapHappinessBalloonByModel(this.model);
    if (!_bl || !_bl.tapped(true)) {
      this.barrage_count = 0;
      _cp.setMouseEventLock(false);
      return false;
    }

    this.last_time = _now;

    return true;
  }

  function _checkBarrageTime(now) {
    return this.last_time + BARRAGE_TIME > now;
  }
}