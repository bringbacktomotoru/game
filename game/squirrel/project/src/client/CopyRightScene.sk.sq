class CopyRightScene extends GameScene
{
  static TIME_TO_SHOW = 3000;
  baseview = null;
  time = 0;

  function setupScene() {
  }

  function loadScene() {
    this.baseview = ::loadSKView("/ui/title/CopyRight.ui");
    this.baseview.pos.x = this.bnd.w * 0.5;
    this.baseview.pos.y = this.bnd.h * 0.5;

    time = 0;
    addChild(baseview);

    ::gamesession.fitscreen(::rootview, true);
  }

  function updateScene(dt) {
    time += dt;
    if (time > TIME_TO_SHOW) {
      if (!::gamesession.getUserDataLocal().isShowedOPMovie()) {
        ::gamesession.changeTitleScene();
      } else {
        ::gamesession.changeOpningMovieScene();
      }

    }

  }

}