class TitleScene extends ::GameScene
{
  baseview = null;

  state = 0;

  is_force_initialize = false;
  is_all_get_start = false;

  trailerexpire = null;

  backdialog = null;

  lbl_ver = null;

  btn_start = null;
  btn_start_debug = null;
  btn_debug_middata = null;
  btn_debug_tedata = null;
  pnl_mouse_event = null;
  agree = false;
  is_starting = false;
  processing_start = null;

  intr = null;
  color_mask = 0;
  color_state = 0;
  img_start = null;
  lbl_start = null;

  lbl_version = null;
  lbl_mode = null;
  lbl_copy = null;
  lbl_id = null;
  loading_bar = null;

  btn_assumption = null;
  lbl_assumption = null;
  btn_select_transe = null;
  lbl_select_transe = null;
  btn_notice = null;

  constructor() {
  }

  function setupScene() {
    crientReportLogger.resetReportCount();
  }

  function loadScene() {
    this.processing_start = false;

    this.baseview = loadSKView("/ui/TopPanel.ui");
    this.baseview.pos.x = this.bnd.w * 0.5;
    this.baseview.pos.y = this.bnd.h * 0.5;
    addChild(baseview);

    this.btn_start = this.baseview.findChild("btn_start");
    this.img_start = this.btn_start.findChild("img_start");
    this.lbl_start = this.btn_start.findChild("lbl_start");
    this.lbl_start.setText(::dict.get("game_start"));
    this.lbl_version = this.baseview.findChild("lbl_ver");
    this.lbl_version.visible = false;
    this.lbl_mode = this.baseview.findChild("lbl_mode");
    this.lbl_mode.setText(::dict.get("application_state"));
    this.lbl_copy = this.baseview.findChild("lbl_copy");
    this.lbl_copy.setText(::dict.get("copyright"));
    this.lbl_id = this.baseview.findChild("lbl_ID");
    this.pnl_mouse_event = this.baseview.findChild("pnl_mouse_event");

    local _udl = gamesession.getUserDataLocal();
    if (_udl.getFriendCode() == null) this.lbl_id.setVisible(false);
    else {
      local _txt = ::dict.get("userid", [_toDigitString(_udl.getFriendCode(), 9)]);
      this.lbl_id.setText(_txt);
    }

    this.loading_bar = ::Slider(this.baseview.findChild("pnl_loadingbar"));

    this.pnl_mouse_event.addEventListener(MOUSE_EVENT, start_mouseevent);

    this.loading_bar.setValue(0.0);
    this.btn_start.setVisible(false);

    local os_name = skGetOSName();

    ::playBGM(::gamesetting.bgm["BGM01"]);

    if (::DEBUG_PANEL) {
      ::TapButton(this.baseview.findChild("btn_forceinit")).view.addEventListener(ACTION_EVENT, actionevent_forceinit);

      this.btn_start_debug = this.baseview.findChild("btn_start_allget");
      ::TapButton(this.btn_start_debug).view.addEventListener(ACTION_EVENT, actionevent_debugallget);

      this.btn_debug_middata = this.baseview.findChild("btn_mid_data");
      ::TapButton(this.btn_debug_middata).view.addEventListener(ACTION_EVENT, actionevent_debugmid);

      this.btn_debug_tedata = this.baseview.findChild("btn_te_data");
      ::TapButton(this.btn_debug_tedata).view.addEventListener(ACTION_EVENT, actionevent_debugted);

      this.btn_debug_tedata = this.baseview.findChild("btn_complete_data");
      ::TapButton(this.btn_debug_tedata).view.addEventListener(ACTION_EVENT, actionevent_debugcomplete);
    } else {
      this.baseview.findChild("btn_forceinit").setVisible(false);
      this.baseview.findChild("btn_start_allget").setVisible(false);
      this.baseview.findChild("lbl_debug").setVisible(false);
      this.baseview.findChild("btn_mid_data").setVisible(false);
      this.baseview.findChild("btn_te_data").setVisible(false);
      this.baseview.findChild("btn_complete_data").setVisible(false);
    }

    local _minfo = ::gamesession.getMaintenanceInfo();
    local _pnl_maintenance = this.baseview.findChild("pnl_maintenance");
    _pnl_maintenance.visible = false;

    setUpdateFunc(repaint);

    this.btn_assumption = this.baseview.findChild("btn_assumption");
    this.lbl_assumption = this.btn_assumption.findChild("lbl_assumption");
    this.lbl_assumption.setText(::dict.get("assumption"));
    ::TapButton(this.btn_assumption, false).region.addEventListener(ACTION_EVENT, assumption_select);

    this.btn_select_transe = this.baseview.findChild("btn_transe");
    this.lbl_select_transe = this.btn_select_transe.findChild("lbl_transe");
    this.lbl_select_transe.setText(::dict.get("select_transe_title"));
    ::TapButton(this.btn_select_transe, false).region.addEventListener(ACTION_EVENT, transe_select);

    this.btn_notice = this.baseview.findChild("btn_notice");
    this.btn_notice.findChild("lbl_notice").setText(::dict.get("notice"));
    ::TapButton(this.btn_notice).view.addEventListener(ACTION_EVENT, actionevent_notice);

    this.color_mask = 255;
    this.intr = setInterval(function() {
      if (!::gamesession.isIAPInitializeEnd()) {
        this.img_start.setColor(0);
        this.lbl_start.setColor(0);
        this.lbl_start.setStrokeColor(0);
        return;
      }

      local _add_color = this.is_starting ? 85 : 17;
      if (this.color_state) {
        this.color_mask += _add_color;
        if (this.color_mask > 255) {
          this.color_mask = 255;
          this.color_state = 0;
        }
      }
      else {
        this.color_mask -= _add_color;
        if (this.color_mask < 0) {
          this.color_mask = 0;
          this.color_state = 1;
        }
      }

      this.img_start.setColor(0xffffffff - this.color_mask);
      this.lbl_start.setColor(0xffffffff - this.color_mask);
      this.lbl_start.setStrokeColor(1548241151 - this.color_mask);
    }.bindenv(this), 50);

    setTimeout(function() { titleCall(); }.bindenv(this), 2000);
  }

  function _toDigitString(val, digit_num) {

    local _cnt = 1;
    local _temp = val;
    while (Math.abs(_temp / 10) > 0) {
      _temp = _temp / 10;
      _cnt++;
    }
    local _str = "";
    if (val < 0) _str = _str + "1";
    else if (val > 0) _str = _str + "0";
    local _sub = digit_num - _cnt;
    for (local i = 0; i < _sub; i++) {
      _str = _str + "0";
    }
    return (_str + Math.abs(val));
  }

  function startScene() {

    ::gamesession.initializeIAP();

  }

  function showScene() {
    local _minfo = ::gamesession.getMaintenanceInfo();
    if (_minfo) {
      local web_dialog = ::MaintenanceInfoPanel();
      this.baseview.addChild(web_dialog);
    }

    local r = ::getResource("/pkg.json");
    local ver = "Ver. x.x.xxx"
    if (r) {
      local pkgjson = decodeJSON(r.getContent());
      local v = pkgjson["version"];
      ver = sprintf("Ver. %d.%d.%03d", (v / 10000), (v / 1000) % 10, v % 1000);
    }

    this.btn_start.setVisible(true);
  }

  function endScene() {
  }

  function releaseScene() {
    if (intr) {
      clearInterval(intr);
      intr = null;
    }
  }

  function quitRequested(e) {
    if (backdialog) {
      backdialog.ret = 0;
      backdialog.close();
      ::rootview.quit = true;
    } else {

      local dlg = backdialog = ::SimpleDialog2();
      dlg.lbl_msg.setText(::dict.get("comfirm_exit_message"));
      dlg.lbl_caution.setText(::dict.get("comfirm_exit_caution"));
      dlg.show();
      backdialog = null;
      if (dlg.ret) {
        ::rootview.quit = true;
      }
    }
  }

  function _processAgreeTOS() {
    local user_data_local = ::gamesession.getUserDataLocal();
    local agreed_TOS = user_data_local.isAgreedTOS();
    this.agree = false;
    if (!agreed_TOS) {
      local web_dialog = ::TermOfServicePanel();
      this.baseview.addChild(web_dialog);

      while (this.baseview.childIndexOf(web_dialog) != -1) {
        suspend();
      }

      if (!web_dialog.agreed) return this.agree;

      local agreed = ::gamesession.agreedTOS(::TermOfServicePanel.VERSION);

      while (!agreed) {
        local _dlg = ::SimpleDialog2();
        _dlg.lbl_msg.setText(::dict.get("login_error"));
        _dlg.lbl_caution.setText("");
        _dlg.show();
        if (!_dlg.ret) return this.agree;
        agreed = ::gamesession.agreedTOS(::TermOfServicePanel.VERSION);
      }
      user_data_local.agreedTOS();
      user_data_local.save();
      this.agree = true;
    }
    else {
      this.agree = true;
    }

    return this.agree;
  }

  function showLogo() {
  }

  function showTitleAnimation() {

  }

  function skipTitleAnimation() {
    stopMethod();
    if (state == 1) {

    }
    state = 2;
  }

  function updateScene(dt) {
  }

  function actionevent_start(e) {
    e.consume();

    if (!::gamesession.is_iap_initialized) return;
    _pressedStart();
  }

  function start_mouseevent(e) {
    e.consume();
    if (this.processing_start) return;
    if (::gamesession.getMaintenanceInfo() != null || this.is_starting) return;

    if (e.id == MOUSE_CLICKED) {
      newthread().start(function() {
        this.processing_start = true;

        if (!::gamesession.isIAPInitializeEnd()) {
          this.processing_start = false;
          return;
        }
        if (!_processAgreeTOS()) {
          this.processing_start = false;
          return;
        }

        this.is_starting = true;
        _pressedStart();

        this.processing_start = false;
      }.bindenv(this), this);

    }
  }

  function actionevent_debugallget(e) {
    e.consume();
    if (!::gamesession.is_iap_initialized) return;

    this.is_all_get_start = true;
    _pressedStart();
  }

  function actionevent_takeover(e) {
    e.consume();

    ::gamesession.execTakeover();
  }

  function actionevent_forceinit(e) {
    e.consume();

    if (::DEBUG) {
      local dlg = ::SimpleDialog2();
      dlg.lbl_msg.setText("データを初期化します。よろしいですか？");
      dlg.lbl_caution.setText("");
      dlg.show();
      if (!dlg.ret) {
        return;
      }

      ::gamesession.userdata_local = ::UserDataLocal();
      ::gamesession.userdata_local.save();

      ::gamesession.con.auth_new_data();
    }
  }

  function actionevent_debugmid(e) {
    e.consume();

    if (::DEBUG) {
      local dlg = ::SimpleDialog2();
      dlg.lbl_msg.textbox.wrapmode = 1;
      dlg.lbl_msg.setText("中盤想定のデータで上書きします。\nよろしいですか？");
      dlg.lbl_caution.setText("");
      dlg.show();
      if (!dlg.ret) {
        return;
      }

      ::gamesession.userdata_local = ::UserDataLocal();
      ::gamesession.userdata_local.save();
      ::gamesession.con.auth_test_data();
    }
  }

  function actionevent_debugted(e) {
    e.consume();

    if (::DEBUG) {
      local dlg = ::SimpleDialog2();
      dlg.lbl_msg.textbox.wrapmode = 1;
      dlg.lbl_msg.setText("チュートリアル終了時のデータで上書きします。\nよろしいですか？");
      dlg.lbl_caution.setText("");
      dlg.show();
      if (!dlg.ret) {
        return;
      }

      ::gamesession.userdata_local = ::UserDataLocal();
      ::gamesession.userdata_local.save();
      ::gamesession.con.auth_tutorialend_data();
    }

  }

  function actionevent_debugcomplete(e) {
    e.consume();

    if (::DEBUG) {
      local dlg = ::SimpleDialog2();
      dlg.lbl_msg.textbox.wrapmode = 1;
      dlg.lbl_msg.setText("全クリア時のデータで上書きします。\nよろしいですか？");
      dlg.lbl_caution.setText("");
      dlg.show();
      if (!dlg.ret) {
        return;
      }

      ::gamesession.userdata_local = ::UserDataLocal();
      ::gamesession.userdata_local.save();
      ::gamesession.con.auth_complete_data();
    }

  }

  function textinputevent(e) {
    local t = btn_test.findChild("txt");
    t.setText(string(e.actioncmd));
  }

  titledone = false;

  function initTemp(force = false) {
    ::debugln("user data initialized");
    local ud = ::gamesession.getUserData();
    print("user data ___  : " + ud + "\n")

    if (true) {

      local furniture_posy = ::HouseModel.FLOOR_DEPTH;

      ud.addRoom(1);

      for (local i = 0; i < 1; i++) {
        ud.room_layout + [];
        for (local j = 0; j < 10; j++) {
          ud.room_layout[i] + 0;
        }
      }

      ud.addRoom(1);

    }
  }

  function _pressedStart() {
    local gs = ::gamesession;

    if (titledone) return;
    ::playSound("ui/nijiget.wav");

    sleep(1000);

    if (intr) {
      clearInterval(intr);
      intr = null;
    }
    this.img_start.setColor(0xffffffff);
    this.lbl_start.setColor(0xffffffff);
    this.lbl_start.setStrokeColor(1548241151);

    if (::gamesession.trailmode) {

      local t = Date.currentTime()[0];
      local et = trailerexpire.getTime()[0] + (60 * 60 * 24);
      if (t > et) {
        ::gamesession.showErrorDialog("体験版パッケージの有効期限を過ぎています。");
        return;
      }

      local d = loadCocos("/ui/dialog/Trailer.json");
      local dlg = Dialog(d);
      dlg.show();
      if (dlg.ret) {
        ::gamesession.userdata = ::gamesession.createNewUserData(0);
        ::fadeoutBGM(4);
        ::gamesession.changeOpeningScene();
      } else {
        ::gamesession.userdata = ::gamesession.createNewUserData(2);
        ::fadeoutBGM(4);
        gs.changeSanrioGameScene();
      }
      return;
    }
    if (!login()) return;

    local ud = gs.getUserData();
    if (ud.isInitialData()) {
      initTemp();

      local namelist = [];
      foreach (c in ::gamesetting.sanrio_chara_settings) {
        namelist + c.name;
      }
      ::gamesession.userdata.name = namelist[(skGetTime() / 17) % length(namelist)];
    }

    ::fadeoutBGM(4);
    if (skGetOSName() == "Android") {
      gs.restorePurchaseRMItems();
    }
    gs.changeSanrioGameScene();
    titledone = true;

    ::gamesetting.createShopPriceTables();
  }

  function titleCall() {
    local _chara_settings = ::gamesetting.sanrio_chara_settings;
    local _chara_array = [];
    foreach (cs in _chara_settings) {
      if (cs.getPermission()) _chara_array + cs;
    }
    local _set_cs = _chara_array[skGetTime() % _chara_array.len()];
    _set_cs.playVoice("e1");

  }

  function login() {
    local gs = ::gamesession;
    printf("TitleScene login!\n");

    local opt = null;
    opt = { force_init = this.is_force_initialize, debug_all_get = this.is_all_get_start };
    while (!gs.login(opt)) {

      local _dlg = ::SimpleDialog2();
      _dlg.lbl_msg.setText(::dict.get("login_error"));
      _dlg.lbl_caution.setText("");
      _dlg.show();
      if (!_dlg.ret) {

        return false;
      }
    }
    return true;
  }

  function startNameEntry() {
    local ne = TitleNameEntry(this);
    addChild(ne);
  }

  function assumption_select(e) {
    local _dlg = ::AssumptionDialog();
    _dlg.show();
  }
  function transe_select(e) {
    local _dlg = ::SelectTranseDialog();
    _dlg.show();
  }

  function actionevent_notice(e) {
    e.consume();

    local web_dialog = ::MaintenanceInfoPanel();
    web_dialog.setCloseToPkgscene(false);
    this.baseview.addChild(web_dialog);
  }
}

class TitleNameEntry extends SKView
{
  scn = null;
  baseview = null;
  navi_ok = null;
  btn_input = null;
  btn_shuffle = null;
  lbl_name = null;

  namelist = null;

  constructor(s) {
    scn = s;
    setRect(0, 0, 1280, ::screenHeight);
    baseview = loadCocos("/ui/title/NameEntry.json");
    addChild(baseview);

    navi_ok = $navi_ok;
    btn_input = $btn_input;
    lbl_name = $lbl_name;
    btn_shuffle = $btn_shuffle;

    TapButton(navi_ok);
    TapButton(btn_shuffle);
    TapButton(btn_input);

    addEventListener(ACTION_EVENT, actionevent);
    addEventListener(TEXTINPUT_EVENT, textinputevent);

    modal = true;

    namelist = [];
    foreach (c in ::gamesetting.sanrio_chara_settings) {
      namelist + c.name;
    }

    randomname();
  }

  function randomname() {
    lbl_name.setText(namelist[(skGetTime() / 17) % length(namelist)]);
    lbl_name.repaint();
  }

  function actionevent(e) {
    switch (e.src) {
    case btn_shuffle:
      randomname();
      break;
    case navi_ok:
      done();
      break;
    case btn_input:
      startinput();
      break;
    }
  }

  function textinputevent(e) {
    if (e.id != TEXTINPUT_DONE) return;
    local s = string(e.actioncmd);
    if (length(s) > 10) {
      s = s.substring(0, 10);
    }
    lbl_name.setText(s);
  }

  function done() {
    local s = lbl_name.getText();
    if (length(s) < 3 || length(s) > 10) {

    }
    if (::gamesession.showConfirmDialog(s + " さん、でよろしいですか？\n（名前は後から変えられます。）")) {
      ::fadeoutBGM(4);
      ::gamesession.userdata.name = s;
      ::gamesession.changeOpeningScene();
    }
  }

  function startinput() {
    requestFocus();
    skStartTextEdit({ text = lbl_name.getText(), maxlen = 10 });
  }

}

class TermOfServicePanel extends SKView {
  static VERSION = 3;
  static TOS_URL1 = "https://www.tomotoru.com/tos";
  static TOS_URL2 = "https://www.tomotoru.com/pp";

  static TOS_URL1_EN = "https://www.tomotoru.com/tos?lang=en";
  static TOS_URL2_EN = "https://www.tomotoru.com/pp?lang=en";

  agreed = false;
  web_view = null;
  pnl_web = null;

  epx = null;
  epy = null;
  size_w = null;
  size_h = null;

  constructor() {
    super();
    this.pickable = true;
  }

  function added() {
    super.added();

    local view = ::loadSKView("/ui/TermOfServicePanel.ui");
    setRect(0, 0, view.bnd.w, view.bnd.h);
    addChild(view);

    this.pnl_web = view.findChild("pnl_web");
    this.pnl_web.findChild("lbl_close").setText(::dict.get("close"));
    this.pnl_web.visible = false;

    local _pnl_web_view = this.pnl_web.findChild("pnl_web_view");
    local _ds = getDisplayScale();
    this.epx = (_pnl_web_view.pos.x - (view.bnd.w / 2.0 - ::screenWidth / 2.0)) * _ds;
    this.epy = (_pnl_web_view.pos.y - (view.bnd.h / 2.0 - ::screenHeight / 2.0)) * _ds;
    this.size_w = _pnl_web_view.bnd.w * _ds;
    this.size_h = _pnl_web_view.bnd.h * _ds;

    view.findChild("lbl_title").setText(::dict.get("terms_of_service_title"));
    view.findChild("lbl_desc").setText(::dict.get("terms_of_service_desc"));

    local _p1 = view.findChild("btn_page1");
    _p1.findChild("lbl_page1").setText(::dict.get("terms_of_service"));
    ::TapButton(_p1).view.addEventListener(ACTION_EVENT, actionevent_page1);
    local _p2 = view.findChild("btn_page2");
    _p2.findChild("lbl_page2").setText(::dict.get("privacy_policy"));
    ::TapButton(_p2).view.addEventListener(ACTION_EVENT, actionevent_page2);

    local _btn_ok = view.findChild("btn_ok");
    _btn_ok.findChild("lbl_agree").setText(::dict.get("agree"));
    ::TapButton(_btn_ok).view.addEventListener(ACTION_EVENT, actionevent_ok);
    local _btn_cancel = view.findChild("btn_cancel");
    _btn_cancel.findChild("lbl_no_agree").setText(::dict.get("no_agree"));
    ::TapButton(_btn_cancel).view.addEventListener(ACTION_EVENT, actionevent_cancel);

    ::TapButton(this.pnl_web.findChild("btn_back")).view.addEventListener(ACTION_EVENT, actionevent_back);

  }

  function _open_web(url) {
    this.pnl_web.visible = true;
    this.web_view = WebView();
    this.web_view.setType(-1);
    this.web_view.setRect(this.epx, this.epy, this.size_w, this.size_h);
    this.web_view.openURL(url);
    this.web_view.show();
  }

  function close() {
    if (this.web_view) {
      this.web_view.close();
      this.web_view = null;
    }

    this.parent.removeChild(this);
  }

  function actionevent_page1(e) {
    e.consume();

    local _url = TOS_URL1;
    switch (::READ_TRANS_FILE) {
    case "EN":
      _url = TOS_URL1_EN;
      break;
    }
    _open_web(_url);
  }
  function actionevent_page2(e) {
    e.consume();

    local _url = TOS_URL2;
    switch (::READ_TRANS_FILE) {
    case "EN":
      _url = TOS_URL2_EN;
      break;
    }
    _open_web(_url);
  }

  function actionevent_ok(e) {
    e.consume();
    if (e.actioncmd != "released") return;

    this.agreed = true;
    close();
  }

  function actionevent_cancel(e) {
    e.consume();
    if (e.actioncmd != "released") return;

    this.agreed = false;
    close();
  }

  function actionevent_back(e) {
    this.web_view.close();
    this.web_view = null;
    this.pnl_web.visible = false;
  }
}

class MaintenanceInfoPanel extends SKView {
  static VERSION = 3;
  static TOS_URL = "https://www.tomotoru.com/info_list?mode=sp";
  static TOS_URL_EN = "https://www.tomotoru.com/info_list?mode=sp&lang=en";
  web_view = null;
  pnl_web = null;
  epx = null;
  epy = null;
  size_w = null;
  size_h = null;
  view = null;

  close_to_pkgscene = null;

  constructor() {
    super();

    this.close_to_pkgscene = true;
  }

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/TermOfServicePanel.ui");
    setRect(0, 0, view.bnd.w, view.bnd.h);
    addChild(view);

    this.pnl_web = view.findChild("pnl_web");
    this.pnl_web.findChild("lbl_close").setText(::dict.get("close"));
    this.pnl_web.visible = true;

    local _pnl_web_view = this.pnl_web.findChild("pnl_web_view");
    local _ds = getDisplayScale();
    this.epx = (_pnl_web_view.pos.x - (view.bnd.w / 2.0 - ::viewWidth / 2.0)) * _ds;
    this.epy = (_pnl_web_view.pos.y - (view.bnd.h / 2.0 - ::viewHeight / 2.0)) * _ds;
    this.size_w = _pnl_web_view.bnd.w * _ds;
    this.size_h = _pnl_web_view.bnd.h * _ds;

    local _url = TOS_URL;
    switch (::READ_TRANS_FILE) {
    case "EN":
      _url = TOS_URL_EN;
      break;
    }
    _open_web(_url);
    ::TapButton(this.pnl_web.findChild("btn_back")).view.addEventListener(ACTION_EVENT, actionevent_back);

  }

  function setCloseToPkgscene(b) {
    this.close_to_pkgscene = b;
  }

  function _open_web(url) {
    this.pnl_web.visible = true;
    this.web_view = WebView();
    this.web_view.setType(-1);
    this.web_view.setRect(this.epx, this.epy, this.size_w, this.size_h);
    this.web_view.openURL(url);
    this.web_view.show();
  }

  function close() {
    if (this.web_view) {
      this.web_view.close();
      this.web_view = null;
    }
    this.view.close();
    this.parent.removeChild(this);

    if (this.close_to_pkgscene) {
      ::gamesession.dialoglayer.closeAllDialog();
      ::gamesession.messagelayer.closeAllMessage();
      ::gamesession.changePackageCheckScene();
    }
  }
  function actionevent_back(e) {
    if (this.close_to_pkgscene) {
      this.web_view = null;
      ::gamesession.dialoglayer.closeAllDialog();
      ::gamesession.messagelayer.closeAllMessage();
      ::gamesession.changePackageCheckScene();
    } else {
      this.web_view.close();
      this.web_view = null;
      this.parent.removeChild(this);
    }
  }
}