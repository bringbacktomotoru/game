class PanelTransition
{

  function perform(pop, prev_panel, topanel) {
  }
}
class MaskPanelTransition extends PanelTransition
{
  imgview = null;
  w1 = 0.0;
  w2 = 1.0;
  fnum = 60;
  sleeptime = 0;

  constructor(tex, mask, spr = 5.0, f = 60) {
    imgview = SKImageView();
    local sp = imgview.sp;
    sp.shadersrc = skFXFindTechnique("dashsprite.unitrans").getShaderSource(0);

    local m = sp.miscmat = Matrix();
    sp.tex0 = tex;
    sp.tex1 = mask;
    sp.color = 0xffffffff;
    sp.blend = SK_MIX;
    m[0] = 0.0;
    m[1] = 1.0;
    m[2] = spr;
    w1 = -1.0 / spr;
    w2 = 1.0 + 1.0 / spr;
    fnum = f;
  }

  function perform(pop, prev_panel, topanel, clazz, param) {

    local _func = function() {
      local _scene = ::gamesession.getCurrentScene();
      if (getclass(_scene) != SanrioGameScene) return;
      local _home_ui = _scene.getUI();

      _home_ui.setVisibleHomeUIItem(clazz);
      if (clazz.need_camera_record) {
        local _cw = _scene.getStage().camera_work;
        local ret = _cw.restoreCameraAtTempRecord(getclassname(clazz), true);
      }

      local _panel_name = getclassname(clazz);

      local _title_settings = ::gamesetting.title_settings;
      local _title_setting;
      foreach (_setting in _title_settings) {
        if (!_setting.getKey().equals(_panel_name)) continue;
        _title_setting = _setting;
        break;
      }
      if (_title_setting) _home_ui.setPanelModeSetting(_title_setting);
      else {
        _home_ui.setPanelNameBackground(false);
        _home_ui.setPanelNameText(::dict.get(_panel_name));
      }

      if (param) topanel.setPanelParam(param);

      if (_panel_name == "HomeTopPanel" || _panel_name == "RoomMemberPanel") {
        ::gamesession.checkAndAddNewResideChara();
      }

      switch (_panel_name) {
      case "RoomEditPanel":
      case "RoomMemberPanel":
      case "NewCostumeEventPanel":
        _scene.removeAllSanrioChara();
        break;
      default:
        _scene.updateActiveSanrioCharas();
      }

      if (pop) {
        _home_ui.insertChild(1, topanel);
        _home_ui.removeChild(prev_panel);
      } else {
        local insert_idx = prev_panel ? 2 : 1;
        _home_ui.insertChild(insert_idx, topanel);
        _home_ui.removeChild(prev_panel);
      }
    }.bindenv({ topanel = topanel, prev_panel = prev_panel, pop = pop, clazz = clazz, param = param });
    rePerformance(_func);
  }

  function rePerformance(func = null, view = null) {
    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != SanrioGameScene) return;
    local _home_ui;
    if (!view) {
      _home_ui = _scene.getUI();
    } else {
      _home_ui = view;
    }

    local r = ::rootview;
    local sp = imgview.sp;
    local m = sp.miscmat;
    imgview.setRect(0, 0, _home_ui.bnd.w, _home_ui.bnd.h);
    _home_ui.addChild(imgview);
    local _div = 1.0 / (fnum - 1);
    for (local l = 0; l < fnum; l++) {
      m[0] = Math.lerp(w1, w2, l * _div);
      imgview.repaint();
      sleep(16);
    }
    if (func) func();
    sleep(sleeptime);

    for (local l = 0; l < 50; l++) {
      local a = (255.0 - (l / 49.0) * 255.0);
      sp.color = (sp.color & 0xffffff00) | a;
      imgview.repaint();
      sleep(16);
    }
    _home_ui.removeChild(imgview);
  }

  function rePerformanceStart(func = null, view = null) {
    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != SanrioGameScene) return;
    local _home_ui;
    if (!view) {
      _home_ui = _scene.getUI();
    } else {
      _home_ui = view;
    }
    local r = ::rootview;
    local sp = imgview.sp;
    local m = sp.miscmat;
    imgview.setRect(0, 0, _home_ui.bnd.w, _home_ui.bnd.h);

    _home_ui.addChild(imgview);
    local _div = 1.0 / (fnum - 1);
    for (local l = 0; l < fnum; l++) {
      m[0] = Math.lerp(w1, w2, l * _div);
      imgview.repaint();
      sleep(16);
    }
  }

  function rePerformanceEnd(func = null, view = null) {
    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != SanrioGameScene) return;
    local _home_ui;
    if (!view) {
      _home_ui = _scene.getUI();
    } else {
      _home_ui = view;
    }
    local r = ::rootview;
    local sp = imgview.sp;
    local m = sp.miscmat;
    imgview.setRect(0, 0, _home_ui.bnd.w, _home_ui.bnd.h);

    local _div = 1.0 / (fnum - 1);
    for (local l = 0; l < 50; l++) {
      local a = (255.0 - (l / 49.0) * 255.0);
      sp.color = (sp.color & 0xffffff00) | a;
      imgview.repaint();
      sleep(16);
    }
    _home_ui.removeChild(imgview);
  }
}

class addedTransition extends PanelTransition
{
  imgview = null;
  w1 = 0.0;
  w2 = 1.0;
  fnum = 60;

  constructor(view, mask, spr = 5.0, f = 60) {
    imgview = view;
    local sp = imgview.sp;
    sp.shadersrc = skFXFindTechnique("dashsprite.unitrans").getShaderSource(0);

    local m = sp.miscmat = Matrix();
    sp.tex1 = mask;
    sp.color = 0xffffffff;
    sp.blend = SK_MIX;
    m[0] = 0.0;
    m[1] = 1.0;
    m[2] = spr;
    w1 = -1.0 / spr;
    w2 = 1.0 + 1.0 / spr;
    fnum = f;
  }

  function perform(panel, sleeptime, func = null) {

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) != SanrioGameScene) return;

    local r = ::rootview;
    local sp = imgview.sp;
    local m = sp.miscmat;
    local _div = 1.0 / (fnum - 1);
    for (local l = 0; l < fnum; l++) {
      m[0] = Math.lerp(w1, w2, l * _div);
      imgview.repaint();
      sleep(16);
    }

    panel.load();
    newthread().start(function() {
      sleep(sleeptime);
      if (func) func();
    }.bindenv({ sleeptime = sleeptime, func = func }), this);
  }

  function showPerform(spr = 5.0) {
    local sp = imgview.sp;
    sp.color = 0xffffffff;
    local m = sp.miscmat;
    m[0] = 0.0;
    m[1] = 1.0;
    m[2] = spr;
    w1 = -1.0 / spr;
    w2 = 1.0 + 1.0 / spr;
    local _div = 1.0 / (fnum - 1);
    for (local l = 0; l < fnum; l++) {
      m[0] = Math.lerp(w1, w2, l * _div);
      imgview.repaint();
      sleep(16);
    }
  }

  function hidePerform() {
    local sp = imgview.sp;

    for (local l = 0; l < 50; l++) {
      local a = (255.0 - (l / 49.0) * 255.0);
      sp.color = (sp.color & 0xffffff00) | a;
      imgview.repaint();
      sleep(16);
    }
  }
}