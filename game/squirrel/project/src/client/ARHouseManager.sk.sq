class ARHouseManager {
  room_id = -1;

  scene = null;
  image_scene = null;

  house_model = null;
  capture_model = null;
  room_rect = null;

  b3body = null;

  room_info = null;

  static CHECK_WALLS_VISIBLE = 5;
  last_update_dir = 1000;

  constructor(scene, img_scene) {
    this.scene = scene;
    this.image_scene = img_scene;
  }

  function getRoomID() {
    return this.room_id;
  }

  function getRoomInfo() {
    return this.room_info;
  }

  function getHouseModel() {
    return this.house_model;
  }

  function getRoomSetting() {
    return ::gamesetting.room_settings[this.room_id];
  }

  function addHouseModel(room_id) {
    if (!room_id || room_id < 0) return;

    local _rs = ::gamesetting.room_settings[room_id];
    if (!_rs) return;

    this.room_id = room_id;

    local _rtr = _rs.getRoomTotalRect();
    this.room_rect = Rect2D(_rtr.x - _rtr.w / 2.0 + 0.5, _rtr.y - _rtr.h / 2.0 + 0.5, _rtr.w / 2.0 - 0.5, _rtr.h / 2.0 - 0.5);

    this.house_model = ::HouseModel(this.scene);
    this.house_model.build(room_id);

    this.capture_model = ::HouseModel(this.image_scene);
    this.capture_model.build(room_id);

    local pm = ::PrimitiveMeshes.createBox(50, 0.5, 50);
    local shp = b3Shape.createMesh(pm.vtx.getStream(SK_POSITION), [pm.face[0].idx]);
    this.b3body = b3Body(0.0, shp, Matrix(), 4096, 0 | 128);
    this.b3body.setTransform(Matrix.fromTranslate(-25, -0.01, -25));
    this.b3body.updateAABB();
    this.scene.b3world.addBody(b3body);
  }

  function setRoomInfo(info) {
    this.room_info = info;
  }

  function setHouseVisible(b) {
    if (this.house_model) this.house_model.setVisible(b);
    if (this.capture_model) this.capture_model.setVisible(b);
  }

  function initHouseVisible(renderer) {
    if (!this.house_model) return;

    local _hpb = _getCameraHPB(renderer.camera);
    local _dir = (_hpb.x * Math.RTOD - 180) * -1;
    this.last_update_dir = _dir;

    this.house_model.setFloorVisible(true);
    this.house_model.updateVisibleWall(_dir * Math.DTOR);
    if (this.capture_model) {
      this.capture_model.setFloorVisible(true);
      this.capture_model.syncWallVisible(this.house_model);
    }
  }

  function updateHouseVisible(renderer) {
    if (!this.house_model) return;

    local _hpb = _getCameraHPB(renderer.camera);
    local _dir = (_hpb.x * Math.RTOD - 180) * -1;
    local _tmp = _dir < CHECK_WALLS_VISIBLE ? _dir + 360 : _dir;
    if (Math.abs(this.last_update_dir - _tmp) > CHECK_WALLS_VISIBLE) {
      this.house_model.updateVisibleWall(_dir * Math.DTOR);
      if (this.capture_model) this.capture_model.syncWallVisible(this.house_model);
      this.last_update_dir = _dir;
    }
  }

  function _getCameraHPB(camera) {
    local _viewmat = Matrix().set(camera[1]);
    local _inv4 = _viewmat.invert44();
    return _inv4.getHPB();
  }

  function getFloorCollisionPos(renderer, screen_x, screen_y) {
    local _v_1 = Vector3D();
    _v_1.set(screen_x / ::displayWidth, screen_y / ::displayHeight, 0.0)
    local near = renderer.camera.unproject(_v_1);
    _v_1.z = 1.0;
    local far = renderer.camera.unproject(_v_1);

    scene.b3world.updateAABBs();

    local b3res = scene.b3world.rayTest(1, near, far, 0 | 128, 4096);
    _v_1.set(0, 0, 0);
    if (b3res.len() > 0) {
      _v_1.set(b3res.pointb.x, 0, b3res.pointb.z);

      local _bnd = b3res.bodyb.getBounds();
      _v_1.add(_bnd.x, 0, _bnd.z);
      _v_1.add(_bnd.r / 2, 0, _bnd.t / 2);

      if (!isInRoom(_v_1)) return null;

      local _base = Vector3D(0.0, ::HouseModel.FLOOR_DEPTH, 0.0);
      _v_1.add(_base);
      _v_1.add(0, 0.1, 0);

      return _v_1;
    }

    return null;
  }

  function isInRoom(p) {
    local _rs = getRoomSetting();
    if (!_rs) return false;
    return _rs.isInRoom(p.x, p.z);
  }

  function getRandomRoomPos() {
    local _v = Vector3D(0.0, 0.0, 0.0);

    local _rs = getRoomSetting();
    if (!_rs) return _v;
    if (!this.room_rect) return _v;

    for (local i = 0; i < 10; i++) {
      _v.set(::PUBLIC_RANDOM.nextf(this.room_rect.x, this.room_rect.w), 0.0, ::PUBLIC_RANDOM.nextf(this.room_rect.y, this.room_rect.h));

      if (_rs.isInRoom(_v.x, _v.z)) break;
    }
    return _v;
  }
}