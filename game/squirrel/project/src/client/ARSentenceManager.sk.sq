class ARSentenceManager {
  model_viewer = null;
  sentence_processor = null;
  talk_window_layer = null;
  image_talk_window = null;

  camera = null;
  image_camera = null;

  constructor(viewer, twl, itw, rc, irc) {
    this.model_viewer = viewer;
    this.talk_window_layer = twl;
    this.image_talk_window = itw;
    this.camera = rc;
    this.image_camera = irc;
  }

  function addTalkSentence(chara_key, sentence) {
    return this.talk_window_layer.addTalkSentenceWindow(this.sentence_processor.getCharaModel(), sentence, chara_key, this.camera);
  }
  function addImageTalkSentence(chara_key, sentence) {
    return this.image_talk_window.addTalkSentenceWindow(this.sentence_processor.getCharaModel().getCaptureModel(), sentence, chara_key, this.image_camera);
  }

  function endSentence() {
    this.sentence_processor = null;
    this.model_viewer.setFocusLock(false);
  }

  function showGetHapinessEffectAndAddGM(model, addgm) {
    ::gamesession.getCurrentScene().showGetHapinessEffectAndAddGM(model, addgm, this.camera);
  }

  function execTapTalk(cm) {
    if (!this.sentence_processor) {
      local _ret = false;
      local _chara_data = ::gamesession.getUserData().getCharacterDataByCostumeId(cm.getCostumeID());
      if (_chara_data.canFocusTalk()) {
        this.sentence_processor = ARSentenceProcessor(cm, this);
        _ret = this.sentence_processor.setSentenceList();

        if (_ret) {
          removeAllTalkWindow();

          this.model_viewer.setFocusLock(true);
          this.sentence_processor.startSentence();
          return;
        }
      }

      if (!_ret) {
        removeAllTalkWindow();
        local _scp = "gakkari";
        if (!_tapScriptRunning(cm, _scp)) {
          cm.startCharaScriptAction(_scp);
        }

      }
    } else {
      this.sentence_processor.nextSentence();
    }

  }

  function removeAllTalkWindow() {
    this.talk_window_layer.removeAllTalkWindow();
    this.image_talk_window.removeAllTalkWindow();
  }

  function _tapScriptRunning(cm, scp) {
    if (cm.getCurrentScriptName() == scp && cm.isScriptRunning()) return true;
    return false;
  }
}

class ARSentenceManager.ARSentenceProcessor {
  manager = null;

  sentence_list = null;
  index = null;

  model = null;

  chara_key = null;

  current_tw = null;
  current_image_tw = null;

  thread = null;
  wait_next = null;

  constructor(cm, asm) {
    this.model = cm;
    this.manager = asm;
    this.chara_key = this.model.getCostumeData().getCharaSetting().getTalkKey();

    this.index = -1;
  }

  function getCharaModel() {
    return this.model;
  }

  function setSentenceList() {
    this.sentence_list = null;

    local _list = [];
    foreach (setting in ::gamesetting.chara_sentence_list_settings) {

      _list + setting;
    }

    while (_list.len() > 0) {
      local _setting = Math.rndPick(_list);
      local _sl = _setting.getSentenceList(this.chara_key);
      if (!_sl) continue;

      this.sentence_list = _sl;
      break;
    }

    if (!this.sentence_list) return false;

    local _setting = Math.rndArray(_list);
    this.sentence_list = _setting.getSentenceList(this.chara_key);

    return true;
  }

  function startSentence() {
    this.index = 0;

    this.thread = newthread().start(function() {
      local _mdl = this.model;
      _mdl.setAutoAction(false);
      _mdl.clearTasks();

      while (this.index < this.sentence_list.len()) {
        local _s = this.sentence_list[this.index];
        local _scp = _s["motion"] || null;
        local _sentence = _s.sentence;
        local _args = _s["args"] || null;

        if (_scp) this.model.startCharaScriptAction(_scp, [_args], false);
        this.current_tw = this.manager.addTalkSentence(this.chara_key, _sentence);
        this.current_image_tw = this.manager.addImageTalkSentence(this.chara_key, _sentence);

        this.index++;

        sleep(800);
        this.wait_next = true;

        local cnt = 0;
        while (true) {
          if (!this.wait_next) break;
          if (cnt > 2000) break;

          sleep(100);
          cnt += 100;
        }

        if (this.current_tw) {
          this.current_tw.interruptTalk();
          this.current_image_tw.interruptTalk();
          this.current_tw = null;
          this.current_image_tw = null;
          sleep(500);
        }
      }

      local _addgm = ::gamesession.communicateChara();
      if (_addgm > 0) {
        this.manager.showGetHapinessEffectAndAddGM(_mdl, _addgm);
        sleep(1600);

        local _ud = ::gamesession.getUserData();
        _ud.addGameMoney(_addgm);

        local _chara_id = _mdl.getCostumeData().getCharaSetting().getID();
        local _chara_data = _ud.getCharacterData(_chara_id);
        _chara_data.setLastFocusTalkTime();
      }

      sleep(400);

      this.manager.endSentence();

      this.thread = null;
    }.bindenv(this), this);
  }

  function nextSentence() {
    this.wait_next = false;

  }

  function isLast() {
    return this.index >= this.sentence_list.len() - 1 ? true : false;
  }
  function isTalking() {
    if (!this.current_tw) return false;
    if (this.current_tw.getState() == ::TalkWindow.STATE_STARTED) return true;

    return false;
  }
}