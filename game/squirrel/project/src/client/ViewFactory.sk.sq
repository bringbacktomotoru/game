class ViewFactory
{

  static RAYTEST_GROUP = 128;
  static RAYTEST_MASK = 128;

  function createTestView() {
    local sk3d = SK3DObject("/test/Cube.sk3");
    return sk3d;
  }

  function createUserCharaView(chara_id, costume_id = 0, visible_distance = 7.0, susp = false) {
    local chara_set = ::gamesetting.sanrio_chara_settings[chara_id];
    local costu_set = null;

    if (costume_id == 0) costume_id = chara_set.def_costume_id;
    costu_set = ::gamesetting.costume_settings[costume_id];

    local body3 = costu_set ? SK3DObject(costu_set.res) : SK3DObject(chara_set.body);
    if (susp) suspend();
    local face3 = SK3DObject(chara_set.face);
    if (susp) suspend();
    local rhand3 = SK3DObject(chara_set.handdir + "/paR.pm");
    if (susp) suspend();
    local lhand3 = SK3DObject(chara_set.handdir + "/paL.pm");

    body3.name = ::CharaModel.BODY_SK3D_NAME;
    face3.name = ::CharaModel.FACE_SK3D_NAME;
    rhand3.name = ::CharaModel.RIGHT_HAND_SK3D_NAME;
    lhand3.name = ::CharaModel.LEFT_HAND_SK3D_NAME;

    body3.scale << chara_set.scale;

    local mot = ::getMotionData(::getResource("/res/anime/scene01.mot"));
    body3.setMotion(mot);
    body3.addChild(face3);
    body3.addChild(rhand3);
    body3.addChild(lhand3);
    face3.shadowBonesTo(body3);
    rhand3.shadowBonesTo(body3);
    lhand3.shadowBonesTo(body3);

    face3.setLayer(1);

    body3.visible_distance = visible_distance;

    if (costu_set) {
      local _tex = ::getTexture(costu_set.hand_tex);
      rhand3.mesh.face[0].m.tex0 = _tex;
      lhand3.mesh.face[0].m.tex0 = _tex;

      if (!_tex) println("[ERROR] texture not found !!!! path = " + costu_set.hand_tex)
    }
    local script_res = ::getResource(chara_set.action);
    if (susp) suspend();
    if (script_res) {
      body3.setScript(script_res);
    } else {
      print("[ERROR] script file not found ... " + chara_set.action);
      currentthread().printStackTrace();
    }
    if (susp) suspend();

    body3.scprunner.scp.standscp = chara_set.stand;
    body3.scprunner.setCharaSetting(chara_set);
    body3.scprunner.setCostumeSetting(costu_set);

    return body3;
  }

  static function buildFurnitureModel(obj, furniture_data, view_index = -1, shadow_objs = null) {
    local furniture_setting = ::gamesetting.furniture_settings[furniture_data.getID()];
    local view_path = null;
    if (view_index >= 0) {
      view_path = furniture_setting.getViewPath(view_index);
    } else {
      view_path = furniture_data.getCurrentViewPath();
    }

    if (view_path == undefined) {
      view_path = furniture_setting.getViewPath(0);
      println("[ERROR] ViewFactory furniture view path undefined!!!!!!!!!!!!!!!!!!")
      println("furniture_id = " + furniture_setting.getID() + ", view_index = " + view_index)
    }

    obj.build(view_path);

    local body = obj.sk3d;
    body.name = "body";

    if (furniture_setting.script && furniture_setting.script != "") {
      local _res = ::getResource("/res/furniture" + furniture_setting.script);
      if (_res) {
        body.setScript(_res);
        body.startScript("start");
      }
    }

    if (furniture_setting.isOverlaid()) body.visible_distance = 1;

    local _shadows = furniture_setting.getShadows() || [];
    foreach (_shadow in _shadows) {
      local _shadow_obj = SK3DObject("/res/shadow/shadow_" + _shadow.id + ".pm");
      _shadow_obj.pos = Vector3D(_shadow["x"] || 0.0, _shadow["y"] || 0.0 + 0.02, _shadow["z"] || 0.0);
      _shadow_obj.name = "shadow";
      _shadow_obj.rot.set(Quaternion.fromHPB((_shadow["angle"] || 0.0) * Math.DTOR, 0.0, 0.0));
      _shadow_obj.scale.set(_shadow["sx"] || 1.0, _shadow["sy"] || 1.0, _shadow["sz"] || 1.0);

      body.addChild(_shadow_obj);
      if (shadow_objs) shadow_objs + _shadow_obj;
    }
  }

  static function buildFurnitureModelByID(obj, id, shadow_objs = null) {
    local furniture_setting = ::gamesetting.furniture_settings[id];

    obj.build(furniture_setting.getViewPath(0));

    local body = obj.sk3d;
    body.name = "body";
    foreach (name, p in furniture_setting.parts) {
      local part = ::SK3DObject("/res/furniture" + p);
      part.name = name;
      body.addChild(part);
      part.shadowBonesTo(body);
    }
    if (furniture_setting.script && furniture_setting.script != "") {
      body.setScript(::getResource("/res/furniture" + furniture_setting.script));
      body.startScript("start");
    }

    if (furniture_setting.isOverlaid()) body.visible_distance = 1;

    local _shadows = furniture_setting.getShadows() || [];
    foreach (_shadow in _shadows) {
      local _shadow_obj = SK3DObject("/res/shadow/shadow_" + _shadow.id + ".pm");
      _shadow_obj.pos = Vector3D(_shadow["x"] || 0.0, _shadow["y"] || 0.0 + 0.02, _shadow["z"] || 0.0);
      _shadow_obj.name = "shadow";
      _shadow_obj.rot.set(Quaternion.fromHPB((_shadow["angle"] || 0.0) * Math.DTOR, 0.0, 0.0));
      _shadow_obj.scale.set(_shadow["sx"] || 1.0, _shadow["sy"] || 1.0, _shadow["sz"] || 1.0);

      body.addChild(_shadow_obj);
      if (shadow_objs) shadow_objs + _shadow_obj;
    }

  }

  function _createDeliveryObject(body, furniture_setting) {

    local _w = furniture_setting.size_w;
    local _d = furniture_setting.size_d;
    local base_x = _w / 2;
    local base_z = _d / 2;

    for (local i = 0; i < _w % 0.5; i++) {
      local part1 = ::SK3DObject("/res/furniture/delivery/derivery_pole.pm");
      local part2 = ::SK3DObject("/res/furniture/delivery/derivery_pole.pm");

      body.addChild(part1);
      body.addChild(part2);

      part1.pos.set(base_x + 0.5 * -i, 0, base_z);
      part2.pos.set(-base_x + 0.5 * i, 0, -base_z);
      part2.rot.setHPB(180 * Math.DTOR, 0, 0);
      part2.matdirty = true;
      part2.updateMatrix();

      part1.shadowBonesTo(body);
      part2.shadowBonesTo(body);
    }
    for (local i = 0; i < _d % 0.5; i++) {
      local part1 = ::SK3DObject("/res/furniture/delivery/derivery_pole.pm");
      local part2 = ::SK3DObject("/res/furniture/delivery/derivery_pole.pm");

      body.addChild(part1);
      body.addChild(part2);

      part1.pos.set(base_x, 0, base_z + 0.5 * -i);
      part1.rot.setHPB(90 * Math.DTOR, 0, 0);
      part1.matdirty = true;
      part1.updateMatrix();

      part2.pos.set(-base_x, 0, -base_z + 0.5 * i);
      part2.rot.setHPB(270 * Math.DTOR, 0, 0);
      part2.matdirty = true;
      part2.updateMatrix();

      part1.shadowBonesTo(body);
      part2.shadowBonesTo(body);
    }

    local board = ::SK3DObject("/res/furniture/delivery/delivery_signboard.pm");
    board.name = "board";
    body.addChild(board);
    board.shadowBonesTo(body);

    body.setScript(::getResource("/res/furniture/delivery/delivery.sk3"));
  }
}

::viewfactory <- ViewFactory();