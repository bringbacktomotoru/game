class GameConnection
{
  http = null;
  blowfish = null;

  entrance_url = null;
  main_url = null;
  report_url = null;
  uuid = null;

  session_id = null;

  send_queue = null;
  is_sending = false;
  stop_command = false;

  constructor(_url, _uuid) {
    uuid = _uuid;
    entrance_url = _url + ::ENTRANCE_URL;
    main_url = _url + ::MAIN_URL;
    report_url = _url + ::REPORT_URL;
    blowfish = Blowfish("test");
    send_queue = [];
  }

  function init() {
    send_queue = [];
    is_sending = false;
    stop_command = false;
  }

  function setURL(_url) {
    entrance_url = _url + ::ENTRANCE_URL;
    main_url = _url + ::MAIN_URL;
    report_url = _url + ::REPORT_URL;
  }

  function encrypt(t) {

    local j = encodeJSON(t);
    local jb = ByteBuffer(); jb.putText(j); jb.pos = 0;
    local ebb = ByteBuffer();
    ebb.endian = 0;
    if (jb.size >= 10240) {
      ebb.putb(1); jb = jb.compress();
    } else {
      ebb.putb(0);
    }
    ebb.puti(jb.size);
    ebb.putBuffer(jb);
    ebb.pos = 0;

    if (true) {
      blowfish.encrypt(ebb, jb.clear());
      return encodeBASE64(jb, ebb.clear());
    } else {
      return encodeBASE64(ebb, jb.clear());
    }
  }

  function decrypt(bb) {
    local ebb = decodeBASE64(bb, ByteBuffer());
    if (true) {
      ebb = blowfish.decrypt(ebb, ByteBuffer());
    }
    ebb.endian = 0;
    local z = ebb.getb();
    local size = ebb.geti();

    ebb.resize(size + 5);
    if (z) {
      ebb = ebb.uncompress();
    }
    if (::debugenabled) {
      printf("ebb asText : %S\n", ebb.asText());
    }
    return decodeJSON(ebb);
  }

  function command(t, cmdurl) {
    local http = HTTPClient();

    local postdata = encrypt(t);
    local t0 = skGetTime();
    local bb = http.post(cmdurl, postdata, HTTPByteBufferReceiver());
    local t1 = skGetTime();
    local retdata = decrypt(bb);
    local t2 = skGetTime();

    if (::debugenabled) {
      printf("post time %d ... decode time %d  size:%d\n", t1 - t0, t2 - t1, bb.size);
    }

    if (retdata[0].ret <= 0) {
      _processServerResponseError(retdata[0]);
      println("CMD : " + t.cmd)
    }

    return retdata;
  }

  function agreedTOS(version) {
    try {
      command({
        uuid = this.uuid,
        cmd = ::ServletConstants.ENTRANCE_CMD_AGREED_TOS,
        params = version,
      }, this.entrance_url);
    } catch (ex) {
      printexception(ex);
      return false;
    }

    return true;
  }

  function issueTakeoverCode(password) {
    try {
      local _ret = command({
        uuid = this.uuid,
        cmd = ::ServletConstants.ENTRANCE_CMD_TAKEOVER_ISSUE,
        password = password,
      }, this.entrance_url);

      return _ret;
    } catch (ex) {
      printexception(ex);
      return null;
    }
    return null;
  }

  function useTakeoverCode(code, password) {
    local platform_id = ::ServletConstants.PLATFORM_UNKNOWN;
    switch (skGetOSName()) {
    case "iOS": platform_id = ::ServletConstants.PLATFORM_IOS; break;
    case "Android": platform_id = ::ServletConstants.PLATFORM_ANDROID; break;
    case "Windows": platform_id = ::ServletConstants.PLATFORM_WINDOWS; break;
    default: platform_id = ::ServletConstants.PLATFORM_OTHER; break;
    }

    try {
      local _ret = command({
        uuid = this.uuid,
        cmd = ::ServletConstants.ENTRANCE_CMD_TAKEOVER_USE,
        takeover_code = code,
        password = password,
        platform_id = platform_id,
      }, this.entrance_url);

      return _ret;
    } catch (ex) {
      printexception(ex);
      return null;
    }
    return null;
  }

  function auth() { return _auth(::ServletConstants.ENTRANCE_CMD_AUTH); }
  function auth_new_data() { return _auth(::ServletConstants.ENTRANCE_CMD_DEBUG_NEW_DATA); }
  function auth_test_data() { return _auth(::ServletConstants.ENTRANCE_CMD_DEBUG_TEST_DATA); }
  function auth_tutorialend_data() { return _auth(::ServletConstants.ENTRANCE_CMD_DEBUG_TUTORIALEND_DATA); }
  function auth_complete_data() { return _auth(::ServletConstants.ENTRANCE_CMD_DEBUG_COMPLETE_DATA); }

  function _auth(cmd) {
    local platform_id = ::ServletConstants.PLATFORM_UNKNOWN;
    switch (skGetOSName()) {
    case "iOS": platform_id = ::ServletConstants.PLATFORM_IOS; break;
    case "Android": platform_id = ::ServletConstants.PLATFORM_ANDROID; break;
    case "Windows": platform_id = ::ServletConstants.PLATFORM_WINDOWS; break;
    default: platform_id = ::ServletConstants.PLATFORM_OTHER; break;

    }
    try {
      local ret = command({
        uuid = this.uuid,
        cmd = cmd,
        token_id = _getPushToken(),
        platform_id = platform_id,
        room_index = ::gamesession.getUserDataLocal().getRoomIndex(),
        sk_ver = skGetVersion()
      }, this.entrance_url);

      local sid = ret[0]["sessionId"];
      if (sid) {

        this.session_id = delete ret[0]["sessionId"];
      }

      return ret;
    } catch (ex) {
      printexception(ex);
      return null;
    }
  }

  function commandToMain(cmd, prms = null) {

    local _wait_cmd = [cmd];
    this.send_queue + _wait_cmd;
    while (true) {
      if (this.stop_command || this.send_queue.len() == 0) return null;
      if (this.send_queue.indexOf(_wait_cmd) == 0 && !this.is_sending) break;
      sleep(100);
    }
    this.is_sending = true;
    delete this.send_queue[0];

    local _ret;
    for (local i = 0; i < 3; i++) {
      local _add_seq = i > 0 ? false : true;
      _ret = _commandToMain(cmd, prms, _add_seq);
      if (_ret) break;
      sleep(1000);
    }
    this.is_sending = false;
    if (!_ret) _moveTitle(::ServletConstants.RESPONSE_CONNECTION_FAIL);
    return _ret;
  }
  function _commandToMain(cmd, prms = null, add_seq = true) {
    try {
      if (add_seq) ::gamesession.command_sequence++;
      local res = command({

        sid = this.session_id,
        cmd = cmd,
        params = prms,
        seq = ::gamesession.command_sequence;
      }, this.main_url);

      if (res[0]["ret"] == ServletConstants.RESPONSE_SUCCEED) ::gamesession.initSessionUpdater();
      return res;
    } catch (ex) {
      printexception(ex);
      return null;
    }
  }

  function commandToReport(cmd, param) { return _commandToReport(cmd, param); }

  function _commandToReport(cmd, prms) {
    local ret = command({
      uuid = this.uuid,
      cmd = cmd,
      params = prms,
    }, this.report_url);
  }

  function _processServerResponseError(ret) {
    println("!!!!!!!!!!!! API_RESPONSE_ERROR :" + ret.ret);
    foreach (k, v in ret) {
      println(k + " = " + v);
    }

    switch (ret.ret) {
    case ::ServletConstants.RESPONSE_CONNECTION_FAIL:
    case ::ServletConstants.RESPONSE_ERROR_OTHERS:
    case ::ServletConstants.RESPONSE_SESSION_CLOSED:
    case ::ServletConstants.RESPONSE_MAINTENANCE:
    case ::ServletConstants.RESPONSE_UNAVAILABLE:
    case ::ServletConstants.RESPONSE_NOT_ALLOWED:
    case ::ServletConstants.RESPONSE_INVALID_REQUEST:
      _moveTitle(ret.ret);
      return false;
    case ::ServletConstants.RESPONSE_INCOMPLETE:
      ::gamesession.adjustTimeOffset(ret["server_time"]);
      break;

    case ::ServletConstants.RESPONSE_TAKEOVER_MISS:
      break;
    }

    return true;
  }

  function _getPushToken() {
    local _token = ::getOneSignalID() || "";
    return _token;
  }

  function _moveTitle(code) {

    this.stop_command = true;

    local dlg = ::SimpleDialog3();
    dlg.lbl_msg.setText(::dict.get("error_code", [code]));
    dlg.lbl_caution.setText(_getResponseErrorText(code));
    dlg.show();
    while (!dlg.isClosing()) suspend();

    ::gamesession.dialoglayer.closeAllDialog();
    ::gamesession.messagelayer.closeAllMessage();
    init();
    ::gamesession.changePackageCheckScene();
  }

  function _getResponseErrorText(code) {
    switch (code) {
    case ::ServletConstants.RESPONSE_CONNECTION_FAIL:
      return ::dict.get("error_connect_fail");
    case ::ServletConstants.RESPONSE_SESSION_CLOSED:
      return ::dict.get("api_error_sessionclosed");
    case ::ServletConstants.RESPONSE_MAINTENANCE:
      return ::dict.get("error_maintenance");
    }
    return ::dict.get("error_server");
  }

}

class HTTPDecryptReceiver
{

}

class HTTPEncryptSender
{

}