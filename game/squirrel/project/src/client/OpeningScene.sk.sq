class OpeningScene extends SKView
{
  baseview = null;
  logo = null;
  grad = null;

  talkthread = null;

  constructor() {
  }

  function updateLayout() {
    local w = bnd.w, h = bnd.h;
  }

  function setupScene() {
  }

  function loadScene() {
  }

  function startScene() {

    showTalk("opening.ks");

  }

  function endScene() {
  }

  function releaseScene() {
  }

  function updateScene(dt) {
    if (talkthread) {
      if (!talkthread.wakeup(dt)) {
        talkthread = null;

        ::gamesession.changeDashStageScene(0, ::gamesetting.stage[1]);
      }
    }
  }

  function showTalk(tid) {
    local talk = TalkView(::gamesession.talksystem);
    talk.setRect(0, 0, 1280, ::screenHeight);
    addChild(talk);

    talk.jumpscript("define.ks", null, true);
    talk.runscript();

    talk.jumpscript(tid, null, true);
    talkthread = newthread();
    talkthread.call(
    function() {
      try {
        talk.runscript();
      } catch (ex) {
        printexception(ex);
      }

    }, this);
  }

  function waitForTalk() {
    local thread = currentthread();
    if (mainthread() == thread) {

      while (talkthread) { suspend(); ::gamesession.update(); }
    } else
    if (::rootview.eventthread == thread) {

      ::rootview.eventloop(null);
    } else {
      while (talkthread) { suspend(); }
    }
  }
}