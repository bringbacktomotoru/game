class MemberSelectPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;
  static need_hint_layer = false;

  static SPACE_X = 0;
  static SPACE_Y = 0;

  view = null;
  reclist = null;
  scroll = null;

  costume_list = null;

  room_index = -1;
  chara_id = -1;
  costume_id = -1;

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/MemberSelectPanel.ui");
    addChild(this.view);

    if (this.chara_id < 0 || this.room_index < 0) return;

    local _btn_back = this.view.findChild("btn_back");
    ::TapButton(_btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    local _btn_change = this.view.findChild("btn_performance");
    ::TapButton(_btn_change).view.addEventListener(ACTION_EVENT, actionevent_change);
    _btn_change.setVisible(false);

    local _pnl_list = this.view.findChild("pnl_item_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    _pnl_list.addChild(this.reclist);
    _pnl_list.setBuffer(true);

    _setupCostumeCard();
  }

  function _setupCostumeCard() {
    this.reclist.clearChildren();
    this.costume_list = [];

    local _ud = ::gamesession.getUserData();
    local _costumes = _ud.getCostumeDataTable();
    local _costume_settings = ::gamesetting.costume_settings;
    local _offset = 0;
    local _cnt = 0;

    local _udl = ::gamesession.getUserDataLocal();
    local _new_items = _udl.getNewItem(ITEM_TYPE_COSTUME);
    if (!_new_items) _new_items = [];

    local _selecting = _costume_settings[this.costume_id];
    if (!_selecting) return;
    local _card = CostumeCard(this, _selecting, false, true);
    this.reclist.addChild(_card);
    this.costume_list + _card;
    _cnt++;

    local _size_x = _card.bnd.w;
    local _costumes_sort_list = [];

    foreach (cd in _costumes) {
      local _cs = _costume_settings[cd.getID()];
      if (_cs.getCharaID() != this.chara_id) continue;
      if (_cs.getID() == this.costume_id) continue;
      local _in = false;
      foreach (idx, slcs in _costumes_sort_list) {
        if (slcs.getPriority() >= _cs.getPriority()) continue;
        _in = true;
        _costumes_sort_list[idx] <- _cs;
        break
      }
      if (!_in) _costumes_sort_list + _cs;
    }

    foreach (cs in _costumes_sort_list) {
      local _card = CostumeCard(this, cs, _new_items.indexOf(cs.getID()) >= 0, false);
      if (_cnt > 0 && _cnt % 2 == 0) _offset += _size_x + SPACE_X;
      _card.pos.x = _offset;
      _card.pos.y = (_cnt % 2) * (_card.bnd.h + SPACE_Y);
      if (_cnt % 2 == 1) {
        _card.setInvisibleUnderLine();
      }
      this.reclist.addChild(_card);

      this.costume_list + _card;
      _cnt++;
    }
    _offset += _size_x * 2;

    local _pnl_list = this.view.findChild("pnl_item_list");
    this.reclist.setRect(0, 0, _offset, _pnl_list.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);

    local _scroll_bar = ::ScrollBarH(this.view.findChild("pnl_scroll_bar"));
    _scroll_bar.setup(this.scroll, _pnl_list.bnd, true);

    _udl.deleteNewItem(ITEM_TYPE_COSTUME, -1);
    _udl.save();
    getHomeUI().updateMenuNewMark(::HomeUI.UPDATE_MENU_MARK_COSTUME);

    newthread().start(_setupCardViews, this);
  }

  function _setupCardViews() {
    local t = skGetTime();
    foreach (card in this.costume_list) {
      card.setupViews();

      local t2 = skGetTime();
      if (t + 16 < t2) {
        t = t2;
        suspend();
      }
    }
  }

  function setPanelParam(param) {
    if ("chara_id" in param) this.chara_id = param.chara_id;
    if ("cos_id" in param) this.costume_id = param.cos_id;
    if ("room_index" in param) this.room_index = param.room_index;
  }

  function show() {
    this.view.startMethod("show");
    while (this.view.isMethodRunning()) { suspend(); }
  }

  function actionevent_back(e) {
    getHomeUI().backPanel();
  }

  function actionevent_change(e) {
    for (local i = 0; i < this.costume_list.len(); i++) {
      this.costume_list[i].reverseCard();
    }
  }

  function changeMember(cid) {
    local _ud = ::gamesession.getUserData();
    local _add_ids = [cid];
    local _remove_ids = [this.costume_id];
    _ud.changeResideChara(this.room_index, _remove_ids, _add_ids);

    if (_remove_ids.len() > 0) {
      local _scene = ::gamesession.getCurrentScene();
      if (_scene instanceof ::SanrioGameScene) {
        local _pm = _scene.getProductionManager();
        local _fuids = [];

        foreach (_cid in _remove_ids) {
          local _pd = _pm.getProductDataByCostumeID(_cid);
          if (_pd) _fuids + _pd.getProducerID();
        }
        if (_fuids.len() > 0) _pm.cancelProductList(_fuids, false);
      }
    }

    moveRoomMemberPanel();
  }

  function moveRoomMemberPanel() {
    getHomeUI().movePanel(::RoomMemberPanel, false, { "room_idx" = this.room_index });
  }
}

class MemberSelectPanel.CostumeCard extends SKView {
  view = null;
  pnl_parent = null;
  pnl_selected = null;
  img_chara = null;
  img_lineunder = null;

  costume_setting = null;
  is_new = false;
  img_new = null;
  is_selecting = false;

  constructor(p, cs, mark, s) {
    this.pnl_parent = p;
    this.costume_setting = cs;
    this.is_selecting = s;
    this.is_new = mark;

    this.view = ::loadSKView("/ui/common/CostumeCard.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    this.pnl_selected = this.view.findChild("pnl_selected");
    this.pnl_selected.findChild("lbl_selected").setText(::dict.get("room_member_selected"));
    this.pnl_selected.visible = this.is_selecting;

    local _btn_costume = this.view.findChild("btn_costume");
    this.img_new = _btn_costume.findChild("img_new");
    this.img_new.visible = this.is_new;

    this.img_lineunder = this.view.findChild("pink_line_under");

    local _btn_costume = this.view.findChild("btn_costume");
    ::TapButton(_btn_costume, false).region.addEventListener(ACTION_EVENT, actionevent_select);
  }

  function setupViews() {

    local _btn_costume = this.view.findChild("btn_costume");
    local _pnl_icon = _btn_costume.findChild("pnl_icon");
    this.img_chara = ::SKImageView();
    CostumeIcon(this.costume_setting.getID(), this.img_chara, false, false);
    this.img_chara.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(this.img_chara);
  }

  function setInvisibleUnderLine() {
    this.img_lineunder.setVisible(false);
  }

  function actionevent_select(e) {

    if (this.is_new) {
      this.img_new.visible = false;
      this.is_new = false;
      repaint();
    }

    if (this.is_selecting) {
      ::gamesession.messagelayer.closeAllMessage();
      local _message = ::Message();
      _message.setMsec(4 * 1000);
      _message.setFontSize(32);
      _message.setText(::dict.get("room_member_same_costume"));
      _message.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
      _message.show();
      return;
    }
    this.pnl_parent.changeMember(this.costume_setting.getID());
  }

  function reverseCard() {
  }
}