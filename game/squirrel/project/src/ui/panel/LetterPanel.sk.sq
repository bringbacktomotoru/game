class LetterPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;
  static need_hint_layer = false;
  static need_history_clear = true;
  static need_panel_name = false;
  static need_menu_layer = false;
  static disable_long_tap = true;

  static unique_move_sound = "";

  view = null;

  has_stamp = false;

  message = null;
  message_bg = null;
  lbl_page = null;
  btn_l = null;
  btn_r = null;
  btn_close = null;

  current_index = 0;
  setting = null;

  pnl_ui = null;
  pnl_mouseevent = null;

  function added() {
    super.added();
    registerMouseEventReceiver(this);
    this.view = ::loadSKView("/ui/LetterPanel.ui");
    addChild(this.view);

    this.pnl_ui = this.view.findChild("pnl_ui");
    this.pnl_mouseevent = this.view.findChild("pnl_mouseevent");

    this.message = Message(this.pnl_ui.findChild("pnl_message"));
    this.message_bg = Message(this.pnl_ui.findChild("pnl_message_bg"));

    this.lbl_page = this.pnl_ui.findChild("lbl_page");
    this.btn_l = this.view.findChild("btn_l");
    this.btn_r = this.view.findChild("btn_r");
    ::TapButton(this.btn_l).view.addEventListener(ACTION_EVENT, actionevent_l);
    ::TapButton(this.btn_r).view.addEventListener(ACTION_EVENT, actionevent_r);

    this.btn_close = this.view.findChild("btn_close");
    this.btn_close.findChild("lbl_close").setText(::dict.get("close"));
    ::TapButton(this.btn_close).view.addEventListener(ACTION_EVENT, actionevent_close);

    setup();

    this.view.startMethod("invisible_letter");
  }

  function showed() {
    newthread().start(_showGetLetterText, this);
  }

  function _showGetLetterText() {
    sleep(500);

    local _tl = ::gamesession.getTutorialLayer();
    local _key = ::tutorial_manager.isEndFirstLetterTutorial() ? "get_new_letter" : "get_letter";
    _tl.showText(::dict.get(_key), 4, true, false);
    ::playJingle(::SoundConstants.JINGLE_GET_LETTER, 0);
    sleep(750);
    _tl.waitTap();
    _tl.hideText();

    this.view.startMethod("fade_letter");
    sleep(1000);

    this.pnl_mouseevent.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function removed() {
    super.removed();
    removeMouseEventReceiver(this);
  }

  function setPanelParam(param) {
    if ("setting" in param) this.setting = param.setting;
  }

  function setup() {
    if (!this.setting) return;

    local _sender = this.setting.getSender();
    if (!_sender) _sender = "";
    this.message.setSenderText(_sender);
    this.message_bg.setSenderText(_sender);

    local _sp = this.setting.getIconSprite();
    if (_sp) {
      this.message.setStampSprite(_sp);
      this.message_bg.setStampSprite(_sp);
      this.has_stamp = true;
    }
    else {
      this.has_stamp = false;
    }

    this.btn_close.visible = false;

    _setupCurrentPage();
  }

  function _setupCurrentPage() {
    if (!_checkSetting()) return;

    _setupPageByIndex(this.message, this.current_index);

    local _message_list = this.setting.getMessageList();
    local _len = _message_list.len();

    if (_len == 1) {
      this.btn_l.visible = false;
      this.btn_r.visible = false;
    }
    else {
      if (this.current_index > 0) this.btn_l.visible = true;
      else this.btn_l.visible = false;

      if (this.current_index + 1 < _len) this.btn_r.visible = true;
      else this.btn_r.visible = false;
    }

    this.lbl_page.setText(::dict.get("nums_slash", [this.current_index + 1, _len]));
  }

  function _setupPageByIndex(msg, idx) {
    local _message_list = this.setting.getMessageList();
    local _len = _message_list.len();

    msg.setText(_message_list[idx]);

    if (_len == idx + 1) {

      msg.setVisibleSenderText(true);
      if (this.has_stamp) msg.setVisibleStamp(true);

      this.btn_close.visible = true;
    }
    else {

      msg.setVisibleSenderText(false);
      msg.setVisibleStamp(false);
    }
  }

  function _checkSetting() {
    if (!this.setting) return false;

    local _message_list = this.setting.getMessageList();
    if (!_message_list || _message_list.len() == 0) return false;

    return true;
  }

  function actionevent_l(e) {
    e.consume();
    movePage(false);
  }

  function flickLeft() {
    movePage(false);
  }

  function actionevent_r(e) {
    e.consume();
    movePage(true);
  }

  function flickRight() {
    if (!_checkSetting()) return;
    movePage(true);
  }

  function movePage(add) {
    local _old_index = this.current_index;
    local _message_list = this.setting.getMessageList();
    if (add) {
      local _len = _message_list.len();

      this.current_index++;
      if (this.current_index >= _len) {

        this.current_index = _len - 1;
        return;
      }
    }
    else {
      this.current_index--;
      if (this.current_index < 0) {

        this.current_index = 0;
        return;
      }
    }

    ::playSound(::SoundConstants.SOUND_TURN_LETTER);
    newthread().start(function() {
      _setupPageByIndex(this.message_bg, this.current_index);

      local _scp = add ? "change_letter_n1" : "change_letter_b1";
      this.view.startMethod(_scp);

      while (this.view.isMethodRunning()) { suspend(); };

      if (add) {

        _setupCurrentPage();
        this.view.startMethod("change_letter_n2");
      } else {

        this.view.startMethod("change_letter_b2");
        _setupCurrentPage();
      }
      while (this.view.isMethodRunning()) { suspend(); };

      if (add) {

        _setupPageByIndex(this.message_bg, _old_index);
        this.view.startMethod("change_letter_n3");
      } else {

        this.view.startMethod("change_letter_b3");
        _setupPageByIndex(this.message_bg, _old_index);
      }
    }.bindenv(this), this);
  }

  function actionevent_close(e) {
    e.consume();

    local _showing = ::tutorial_manager.getShowingTutorialID();
    local _dlg;
    local _sp;
    if (_showing == ::TutorialSetting.TUTORIAL_LETTER_DIARY) {
      _dlg = SimpleImageDialog();
      _dlg.lbl_msg.setText(::dict.get("get_diary"));
      _sp = ::getSprite("/ui/image/icon/icon/diary.png");
      if (_sp) {
        _sp.blend = SK_MIX;
        _dlg.setSprite(_sp);
        _dlg.show();
      }
    }
    else if (_showing == ::TutorialSetting.TUTORIAL_LETTER_CAMERA) {
      _dlg = SimpleImageDialog();
      _dlg.lbl_msg.setText(::dict.get("get_camera"));
      _sp = ::getSprite("/ui/image/icon/icon/camera.png");
      if (_sp) {
        _sp.blend = SK_MIX;
        _dlg.setSprite(_sp);
        _dlg.show();
      }
    }

    local _ud = ::gamesession.getUserData();
    if (_ud.isEndTutorialId(::TutorialSetting.TUTORIAL_LETTER_FIRST_MOVE)) {
      getHomeUI().moveTopPanel(MaskPanelTransition(::getTexture(::getLoadImagePath()), ::getTexture("/image/black.jpg"), 5.0, 50));
    }
    else {
      local _mask = MaskPanelTransition(::getTexture(::getLoadImagePath()), ::getTexture("/image/black.jpg"), 5.0, 50);
      _mask.rePerformance(_moveEventScene, this);
    }
  }

  function _moveEventScene() {
    ::stopBGM();
    local _eid = ::TutorialSetting.TUTORIAL_KITTY_EVENT1;
    local _ecid = ::TutorialSetting.TUTORIAL_KITTY_EVENT1_COSTUME;
    ::event_manager.startEventSceneTalk(_eid, this, null, _ecid, false);
  }

  show_event_lock = false;
  function mouseevent(e) {
    e.consume();
    if (this.show_event_lock) return;

    switch (e.id) {
    case MOUSE_CLICKED:
      this.show_event_lock = true;
      newthread().start(_showLetter, this);
      break;
    }
  }

  function _showLetter() {

    this.view.startMethod("show");
    sleep(150);
    ::playSound(::SoundConstants.SOUND_DIALOG);
    sleep(850);

    this.pnl_mouseevent.removeEventListener(MOUSE_EVENT, mouseevent);
    this.pnl_mouseevent.setEnabled(false);

    local _len = this.setting.getMessageList().len();
    if (_len < 2) this.view.startMethod("show_buttons_c");
    else this.view.startMethod("show_buttons_r");
  }
}

class LetterPanel.Message {
  static MAX_LINE = 7;
  message_lbl_list = null;
  lbl_sender = null;
  img_stamp = null;

  constructor(p) {
    this.message_lbl_list = [];
    for (local i = 1; i <= MAX_LINE; i++) {
      local _lbl = p.findChild("lbl_message" + i);
      this.message_lbl_list + _lbl;
      if (::READ_TRANS_FILE == "EN") _lbl.setFont("Neucha.ttf");

    }

    this.lbl_sender = p.findChild("lbl_sender");
    if (::READ_TRANS_FILE == "EN") this.lbl_sender.setFont("Neucha.ttf");
    this.img_stamp = p.findChild("img_stamp");

  }

  function setText(list) {
    if (!list) return;
    for (local i = 0; i < MAX_LINE; i++) {
      local _s = list[i];

      if (_s) this.message_lbl_list[i].setText(_s);
      else this.message_lbl_list[i].setText("");
    }
  }

  function setSenderText(sender) {
    this.lbl_sender.setText(sender);
  }
  function setVisibleSenderText(b) {
    this.lbl_sender.setVisible(b);
  }

  function setStampSprite(sp) {
    this.img_stamp.setSprite(sp);
    this.img_stamp.updateLayout();
  }
  function setVisibleStamp(b) {
    this.img_stamp.setVisible(b);
  }
}