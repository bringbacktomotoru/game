class PictureDetailPanel extends ::HomeUI.Panel {
  static need_money_layer = false;
  static need_rank_layer = false;
  static need_menu_layer = false;
  static need_panel_name = false;

  pnl_picture = null;
  btn_cancel = null;
  btn_save = null;
  btn_share = null;

  reclist = null;
  flick = null;

  back_to_home = false;
  file_list = null;

  textures = null;
  fileref = null;
  cache_dir = null;

  picture_state_table = null;
  current_index = -1;
  load_thread = null;

  still_image_size = null;

  timeout = -1;

  clear_table = true;

  picture_detail_param = null;

  function create() {
    return ::loadSKView("/ui/PictureDetailPanel.ui", ::PictureDetailPanel);
  }

  function added() {
    super.added();

    this.pnl_picture = findChild("pnl_picture");

    this.btn_cancel = findChild("btn_cancel");
    ::TapButton(this.btn_cancel).view.addEventListener(ACTION_EVENT, _actionevent_back);

    this.btn_share = findChild("btn_share");
    ::TapButton(this.btn_share).view.addEventListener(ACTION_EVENT, _actionevent_share);
    this.btn_save = findChild("btn_save");
    ::TapButton(this.btn_save).view.addEventListener(ACTION_EVENT, _actionevent_save);

    if (this.current_index in this.picture_state_table) {
      local _state = this.picture_state_table[this.current_index];
      local _saved = _state.saved;
      if (_saved) this.btn_save.setEnabled(false);
    } else {
      this.picture_state_table[this.current_index] <- { saved = false, frame = 0 };
    }

    this.btn_share.findChild("lbl_share").setText(::dict.get("share_image"));
    this.btn_save.findChild("lbl_save").setText(::dict.get("save_image"));
    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("close"));

    this.reclist = ::SKMaskView();
    this.reclist.pickable = true;
    this.flick = ::FlickPanel(this.reclist, false);
    this.flick.setFlickRate([0.7, 0.0]);
    this.flick.setBlock([this.pnl_picture.bnd.w, 32.0]);
    this.flick.setBlockChangedFunc(updateCurrentIndex.bindenv(this));
    this.flick.dyscale = 0.0;
    this.pnl_picture.addChild(this.reclist);
    this.pnl_picture.setBuffer(true);

    _setupPictures();
  }

  function removed() {
    super.removed();
    if (this.load_thread && isThreadRunning(this.load_thread)) {
      this.load_thread.interruptGoto("END");
    }
    this.load_thread = null;

    if (this.timeout != -1) {
      clearInterval(timeout);
      this.timeout = -1;
    }

    if (this.clear_table) {
      foreach (val in this.textures) {
        Table.clear(val);
      }
      this.textures.clear();
    }
    this.picture_detail_param = null;
  }

  function setPanelParam(param) {
    if ("textures" in param) {
      this.textures = param.textures;
    }

    if ("picture_state_table" in param) {
      this.picture_state_table = param.picture_state_table;
    }
    if ("index" in param) {
      this.current_index = param.index;
    }

    if ("image_size" in param) {
      this.still_image_size = param.image_size;
    }

    this.picture_detail_param = param;
  }

  function _setupPictures() {
    this.cache_dir = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_CACHE_IMAGE, ::FilePathManager.APPLICATION_MODE_NONE);
    this.reclist.clearChildren();
    local _tex_table = this.textures[this.current_index];

    this.fileref = FileRef(this.cache_dir + _tex_table.idx + (_tex_table.movie ? ".mp4" : ".jpg"));

    local _prev = this.current_index - 1 >= 0 ? current_index - 1 : 0;
    local _next = this.current_index + 1 < textures.len() ? this.current_index + 1 : textures.len() - 1;

    local _offset = 0.0;
    local _pad = 0.0;

    foreach (_idx, _tex_table in textures) {
      local _clz = _tex_table.movie ? ::PictureButton : ::Picture;
      local _picture = _clz(null);

      local _asp = float(still_image_size[0]) / still_image_size[1];
      local _w = _picture.bnd.w;
      local _h = _picture.bnd.h;
      if (_asp > 1.0) {
        _h = _w * (float(still_image_size[1]) / still_image_size[0]);
      } else {
        _w = _h * (float(still_image_size[0]) / still_image_size[1]);
      }
      _picture.setPictureBound(_w, _h);

      if (getclass(_picture) == ::PictureButton) {
        _picture.setTapFunc(_previewMovie.bindenv(this));
      }

      if (_prev <= _idx && _idx <= _next) {

        local _file;
        if (_tex_table.movie) {
          local _filepath = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_THUMBNAIL, ::FilePathManager.APPLICATION_MODE_NONE);
          _file = FileRef(_filepath + _tex_table.idx + "_m_l_thumb.jpg");
        } else {
          _file = FileRef(this.cache_dir + _tex_table.idx + ".jpg");
        }

        _picture.setTexImage(::getTexture(FileResource(_file)));

        if (_tex_table.movie) _picture.setPlayButton();

        local _iv = _picture.getImageView();
        local _scale = this.pnl_picture.bnd.h / _h;
        _picture.scale(_scale);
        _picture.setVisible(true);
      } else {
        _picture.setVisible(false);
      }

      local _width = this.pnl_picture.bnd.h * _picture.getAspectW();
      if (_pad == 0.0) _pad = (this.pnl_picture.bnd.w - _width) / 2.0;
      if (_offset == 0.0) _offset = _pad;

      _picture.pos.set(_offset, 0.0, 0.0);

      _tex_table["picture"] <- _picture;

      this.reclist.addChild(_picture);
      _offset += this.pnl_picture.bnd.w;
    }

    _offset -= _pad;
    this.reclist.setRect(0, 0, _offset, this.pnl_picture.bnd.h);
    this.flick.setScrollRect(this.reclist.bnd);

    local _blk = this.flick.getBlock();
    this.flick.updateCurrentBlock(Vector3D(this.current_index * _blk[0] * -1.0, 0.0, 0.0));
  }

  function updateCurrentIndex(table) {

    local _currentIndex = 0;
    local _view = table.view;
    local _w = _view.getWindowRect();
    local _scrollrect = table.self.getScrollRect();
    local _blk = table.self.getBlock();
    local _flickrate = table.self.getFlickRate();

    local _idx = int(table.self.adjust(_view.pos.x, _w.w, _scrollrect.x, _scrollrect.w, _blk[0], _flickrate[0]) / _blk[0]);
    if (_idx < 0) _idx *= -1;

    if (_idx != this.current_index) {
      this.current_index = _idx;

      local _tex_table = this.textures[this.current_index];

      this.fileref = FileRef(this.cache_dir + _tex_table.idx + (_tex_table.movie ? ".mp4" : ".jpg"));

      if (this.current_index in this.picture_state_table) {
        local _state = this.picture_state_table[this.current_index];
        local _saved = _state.saved;
        _state.frame = 0;
        this.btn_save.setEnabled(!_saved);
      } else {
        this.picture_state_table[this.current_index] <- { saved = false, frame = 0 };
        this.btn_save.setEnabled(true);
      }

      if (!this.load_thread) this.load_thread = newthread();

      if (::isThreadRunning(this.load_thread)) {
        this.load_thread.interruptGoto("END");
      }
      this.load_thread.start(_updateTexture, this);
    }
  }

  function _previewMovie() {
    this.clear_table = false;

    if ("index" in this.picture_detail_param) this.picture_detail_param.index = this.current_index;

    getHomeUI().movePanel(::MoviePanel, false, { fileref = this.fileref, picture_state = this.picture_state_table[this.current_index] });
  }

  function _updateTexture() {

    local _prev = this.current_index - 1 >= 0 ? current_index - 1 : 0;
    local _next = this.current_index + 1 < textures.len() ? this.current_index + 1 : textures.len() - 1;

    local _children = this.reclist.children;
    foreach (_idx, _tex_table in this.textures) {
      local _picture = _tex_table.picture;
      if (_prev <= _idx && _idx <= _next) {

        local _file = FileRef(this.cache_dir + _tex_table.idx + ".jpg");
        local _b = false;
        if (!_file.exists()) {
          local _filepath = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_THUMBNAIL, ::FilePathManager.APPLICATION_MODE_NONE);
          _file = FileRef(_filepath + _tex_table.idx + "_m_l_thumb.jpg");
          _b = true;
        }

        if (!_picture.getTexture()) {
          _picture.setTexImage(::getTexture(FileResource(_file)));
        } else {
          _picture.setTexImage(null);
        }
        if (_b) _picture.setPlayButton();

        local _pic = _picture.getPicture();
        local _scale = this.pnl_picture.bnd.h / _pic.bnd.h;
        _picture.scale(_scale);
        _picture.matdirty = true;
        _picture.repaint();
        _picture.setVisible(true);
      } else {
        _picture.unloadTexImage();
        _picture.setVisible(false);
      }
      suspend();
    }
    END:
  }

  function _actionevent_save(e) {
    e.consume();

    local _isMovie = this.textures[this.current_index].movie;
    local _ores = _copyToExternalDir(_isMovie);
    if (skGetOSName() == "iOS")
    ARUtils.savePhotoGallery(_ores.path, _isMovie);
    else
    ARUtils.savePhotoGallery(_ores.path);

    this.picture_state_table[this.current_index].saved = true;
    this.btn_save.setEnabled(false);

    local _msg = ::Message();
    _msg.setText(::dict.get(this.textures[this.current_index].movie ? "record_completed" : "capture_completed"));
    _msg.setFontSize(32);
    _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0, 0);
    _msg.setColor(0xffffffff);
    _msg.stroke();
    _msg.show();

  }

  function _actionevent_share(e) {
    e.consume();

    local _osname = skGetOSName();

    local _tex_table = this.textures[this.current_index];

    local _dictkey = "";
    if (_tex_table.movie) {
      local _idx = Math.rndi(3) + 1;
      _dictkey = "external_movie" + _idx;
    } else {
      local _idx = Math.rndi(4) + 1;
      _dictkey = "external_image" + _idx;
    }
    local _external_str = replaceNewLine(::dict.get(_dictkey));
    ARUtils.startExternalIntent(this.fileref.path, _external_str);

  }

  function _actionevent_back(e) {
    e.consume();
    this.picture_state_table[this.current_index].frame = 0;
    getHomeUI().backPanel(1, false);
  }

  function _copyToExternalDir(movie) {
    local _ex_dir = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_IMAGE, ::FilePathManager.APPLICATION_MODE_AR);
    local buf = ::makeFilename(movie ? "mp4" : "jpg");
    local _outres = FileRef(_ex_dir + buf);
    this.fileref.copyTo(_outres);

    return _outres;
  }
}