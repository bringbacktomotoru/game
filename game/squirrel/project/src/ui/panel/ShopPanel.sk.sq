    setup();
  }

  function setup() {
    local _ud = ::gamesession.getUserData();

    this.buy_state = BUY_STATE_OK;
    local _color = 0xffffffff;
    this.img_motion.setColor(_color);
    if (this.img_rm.visible) this.img_rm.setColor(_color);
    if (this.img_gm.visible) this.img_gm.setColor(_color);
    this.lbl_price.setColor(1548241151);

    _checkPrice(this.lbl_price);

    local _chara_data = _ud.getCharacterData(this.shop_setting.getTargetID());
    local _set_color = false;
    if (!_chara_data) {
      this.buy_state = BUY_STATE_CONDITION;
      _set_color = true;
      this.lbl_sold_out.visible = false;
    }
    else if (_chara_data.hasMotion(this.shop_setting.getItemID())) {
      this.buy_state = BUY_STATE_HAD;
      _set_color = true;
      this.lbl_sold_out.visible = true;
    }
    else {
      this.lbl_sold_out.visible = false;
    }
    if (_set_color) {
      _color = 0xffffff55;
      this.img_motion.setColor(_color);
      if (this.img_rm.visible) this.img_rm.setColor(_color);
      if (this.img_gm.visible) this.img_gm.setColor(_color);
      this.img_frame.setColor(0xffffffff);
      this.img_chara.setColor(_color);
      this.img_price_bg.setColor(_color);
      this.lbl_name.setColor(1548240998);
      this.lbl_price.setColor(1548240998);
    }
  }

  function actionevent_select(e) {
    e.consume();

    local _dlg = ::ConfirmShopMotionDialog();
    _dlg.setShopMotion(this.shop_setting, this.buy_state);
    _dlg.show();
    if (!_dlg.ret) return;
    local _ud = ::gamesession.getUserData();
    local _ridx = _ud.getCurrentRoomIndex();

    local _buy_items = ::gamesession.shopBuy(this.shop_setting.getID(), _ridx);
    if (!_buy_items || _buy_items.len() == 0) {

      return;
    }

    _ud.addRewardItems(_buy_items);

    local _home_ui = pnl_parent.getHomeUI();
    _ud.applyPurchase(this.shop_setting.getPriceType(), this.shop_setting.getPrice());
    _home_ui.updateShopMark(false, this.shop_setting.isPriceTypeGM());
    if (this.shop_setting.hasLimit()) _ud.addPurchaseRecord(this.shop_setting.getID(), 1);

    showBoughtenDialog();

    this.pnl_parent.addBoughtList(this.shop_setting.getID());

    this.pnl_parent.sortTabList(this);

    this.pnl_parent.updateTabs();

    this.pnl_parent.updateList();
  }
}

class ShopPanel.RMCard extends ShopPanel.ShopCard {
  img_rm = null;
  img_gm = null;
  img_icon = null;

  lbl_price = null;

  constructor(ss, p) {
    super(ss, p);

    this.view = ::loadSKView("/ui/common/RMShopCard.ui");
    addChild(this.view);
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    this.btn_view = this.view.findChild("btn_buy");
    ::TapButton(this.btn_view, false).region.addEventListener(ACTION_EVENT, actionevent_select);

    this.lbl_price = this.btn_view.findChild("lbl_price");
    this.img_rm = this.btn_view.findChild("img_rm");
    this.img_gm = this.btn_view.findChild("img_gm");

    local _pnl_rm = this.view.findChild("pnl_rm");
    this.img_icon = _pnl_rm.findChild("img_icon");
    _pnl_rm.findChild("lbl_name").setText(this.shop_setting.getItemName());
    _setPrice(this.lbl_price, this.btn_view);

    setup();
  }

  function setup() {
    this.buy_state = BUY_STATE_OK;

    this.img_icon.setSprite(this.shop_setting.getSpriteRM());
    this.img_icon.updateLayout();
  }

  function actionevent_select(e) {
    e.consume();

    ::gamesession.getCurrentScene().setEnabled(false);

    try {
      local _dlg = ::ConfirmShopRMDialog();
      _dlg.setShopRM(this.shop_setting);
      _dlg.show();

      if (_dlg.ret > 0) {
        ::gamesession.purchaseRMItem(this.pnl_parent, this.shop_setting, chargeRMCallback);
      } else {
        ::gamesession.getCurrentScene().setEnabled(true);
      }
    }

    catch (ex) {
      printexception(ex);
      sendException(ex, "error in purchase hapiness ....");

      local _dlg = SimpleDialog3();
      _dlg.lbl_msg.setText(ss.getItemName());
      _dlg.lbl_caution.setText(::dict.get("shop_buy_rm_failure"));
      _dlg.show();

      ::gamesession.getCurrentScene().setEnabled(true);
    }
  }

  function chargeRMCallback(info, pnl, ss) {
    local ud = ::gamesession.getUserData();
    ud.addRealMoney(info.add_rm);
    ud.addFreeRealMoney(info.bonus_rm);

    if (info.purchase_result) {
      if (info.server_result) {
        local _dlg = SimpleDialog3();
        _dlg.lbl_msg.setText(ss.getItemName());
        _dlg.lbl_caution.setText(::dict.get("shop_buy_rm_success"));
        _dlg.show();

        pnl.addBoughtList(ss.getID());

        pnl.updateList();

        ::gamesession.appsflyer.purchase(ss.getIapPriceValue());
      }

      else {
        local _dlg = SimpleDialog();
        _dlg.lbl_msg.setText(::dict.get("shop_buy_rm_failure"));
        _dlg.show();
      }
    }

    else {
      local _dlg = SimpleDialog3();
      _dlg.lbl_msg.setText(ss.getItemName());
      _dlg.lbl_caution.setText(::dict.get("shop_buy_rm_cancel"));
      _dlg.show();
    }

    ::gamesession.getCurrentScene().setEnabled(true);
  }
}

class ShopPanel.FilterManag {
  filter_table = null;
  type_list = null;
  number_list = null;

  constructor(type, table, shop_list) {
    filter_table = {};
    filter_table["room"] <- table[0];
    filter_table["has"] <- table[1];
    filter_table["select"] <- table[2];

    type_list = [];
    number_list = [];

    local _setting = null;
    local _number = null;
    local _number_setting = null;
    local _lbl = null;

    number_list + 0;
    type_list[0] <- "すべて";

    foreach (ss in shop_list) {
      if (type == SHOP_ITEM_TYPE_FURNITURE) {
        _setting = ::gamesetting.furniture_settings[ss.getItemID()];
        _number = _setting.getType();
        _number_setting = _setting.getTypeSetting();
        _lbl = _number_setting.name;
      }
      else if (type == SHOP_ITEM_TYPE_COSTUME) {
        _setting = ::gamesetting.costume_settings[ss.getItemID()];
        _number = _setting.getCharaID();
        _number_setting = _setting.getCharaSetting()
        _lbl = _number_setting.name;
      }
      else if (type == SHOP_ITEM_TYPE_MOTION) {
        _setting = ss.getTargetID();
        _number = ss.getTargetID();
        _number_setting = ::gamesetting.sanrio_chara_settings[_setting];
        _lbl = _number_setting.name;
      }

      for (local i = 0; i <= this.number_list.len() + 1; i++) {
        if (this.number_list[i] == _number)
        break;
        else if (!this.number_list[i] && i == this.number_list.len()) {
          this.number_list + _number;
          this.type_list + _lbl;
          break;
        }
      }
    }

  }

  function setTable(table, ret_table) {
    table[0] <- ret_table["room"];
    table[1] <- ret_table["has"];
    table[2] <- ret_table["select"];
    table[3] <- ret_table["select_number"];

  }

}