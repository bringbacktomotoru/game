import SKViewPropertyID;

class RoomEditPanel extends ::HomeUI.Panel {
  static need_camera_default = false;
  static need_camera_rotate = true;
  static need_money_layer = false;
  static need_rank_layer = false;

  static show_tapfloor_particle = true;
  static need_camera_record = true;
  static need_param_history_noadd = true;

  static EDIT_DEFAULT_X = 0.0;
  static EDIT_DEFAULT_Y = 4.0;
  static EDIT_DEFAULT_Z = -25.0;

  static EDIT_DEFAULT_H = 45.0;
  static EDIT_DEFAULT_P = 45.0;
  static EDIT_DEFAULT_B = 0.0;

  view = null;
  btn_furnitures = null;
  btn_back = null;

  edit_model = null;
  tap_model = null;
  tap_offset = null;

  stage = null;
  scene = null;
  furniture_layouter = null;

  first_uid = -1;
  first_shop_id = -1;
  editing = false;
  hide_tap_check = null;

  furniture_models_inroom = null;

  pnl_furniture_info = null;
  lbl_lv = null;
  lbl_exp = null;
  exp_bar = null;
  bar_width = 0;
  bar_pos = null;

  tutorial_model_lock = false;

  function added() {
    super.added();

    getHomeUI().setPanelNameText("");
    this.scene = ::gamesession.getCurrentScene();
    this.stage = this.scene.getStage();

    this.view = ::loadSKView("/ui/RoomEditPanel.ui");
    this.view.pickable = false;
    addChild(this.view);

    this.tap_offset = { x = 0.0, z = 0.0 };

    this.btn_back = this.view.findChild("btn_back");
    ::TapButton(btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    this.btn_furnitures = this.view.findChild("btn_furnitures");
    ::TapButton(btn_furnitures).view.addEventListener(ACTION_EVENT, actionevent_furnitures);

    local _pnl_mouse_event = this.view.findChild("pnl_mouse_event");
    _pnl_mouse_event.multitouch = true;
    registerMouseEventReceiver(this);
    _pnl_mouse_event.addEventListener(MOUSE_EVENT, mouseevent);

    this.pnl_furniture_info = this.view.findChild("pnl_furniture_info");
    this.pnl_furniture_info.visible = false;
    this.lbl_lv = this.pnl_furniture_info.findChild("lbl_lv");
    this.lbl_exp = this.pnl_furniture_info.findChild("lbl_exp");
    this.exp_bar = this.pnl_furniture_info.findChild("bar_exp").findChild("bar");
    this.bar_width = this.exp_bar.bnd.w;

    this.bar_pos = { x = 0, y = 0 };
    this.bar_pos.x = this.exp_bar.pos.x;
    this.bar_pos.y = this.exp_bar.pos.y;

    if (skGetOSName() == "Windows") {
      setUpdateFunc(updateAtWindows);
    }
    else {
      setUpdateFunc(updateFrame);
    }

    this.furniture_layouter = ::FurnitureLayouter(this.stage);
    this.edit_model = EditModel(this.view, getHomeUI(), this.furniture_layouter);

    this.furniture_models_inroom = ::gamesession.getCurrentScene().getStage().getHouseManager().getFurnitureLayoutManager().getFurnitureModels();

    if (this.first_uid >= 0) {
      local _model = this.furniture_models_inroom[this.first_uid];
      if (_model) {
        this.edit_model.setModel(_model);
        showBoundAreaEffect(true);

      }
      else {
        this.edit_model.setNewModel(this.first_uid);
        showBoundAreaEffect(true);
      }
    }
    else if (this.first_shop_id >= 0) {
      this.edit_model.setNewModel(-1, this.first_shop_id);
      showBoundAreaEffect(true);
      getHomeUI().showMoneyUI(true);
    }
    updatePanelName();

    _focusCameraToFurniture(this.edit_model.getModel());

    this.scene.removeAllSanrioChara();

    this.hide_tap_check = { x = 0, y = 0, t = -1 };

    this.stage.setVisibleGridWire(true);
  }

  function _focusCameraToFurniture(model) {
    if (model) {
      local _stage = ::gamesession.getCurrentScene().getStage();
      local _cw = _stage.getCameraWork();
      local is_camera_change = false;

      local _pos = model.getPos();
      _cw.input_lock = false;
      _cw.setTargetXYZ(_pos.x - 1, _pos.y, _pos.z - 2, true);
      _cw.is_rollcamera = false;
      _cw.setDistXYZ(EDIT_DEFAULT_X, EDIT_DEFAULT_Y, EDIT_DEFAULT_Z, true);
      _cw.rotateTo(EDIT_DEFAULT_H * Math.DTOR, EDIT_DEFAULT_P * Math.DTOR, EDIT_DEFAULT_B * Math.DTOR, true, true, true);

      is_camera_change = true;
    }
  }

  function setPanelParam(param) {
    if ("uid" in param) {
      this.first_uid = param.uid;
    }
    if ("sid" in param) this.first_shop_id = param.sid;
  }

  function updateFrame(dt) {
    repaint();
    this.edit_model.updateFrame();
  }

  function updateAtWindows(dt) {
    updateFrame(dt);

    local _delta = this.remaining_mouse_wheel_count * 0.01 * dt;
    this.remaining_mouse_wheel_count -= _delta;
    if (_delta > -0.01 && _delta < 0.01) return;

    local _rate = 1.0 - _delta * 0.05;
    local _game_scene = ::gamesession.getCurrentScene();
    _game_scene.zoomCamera(Math.clamp(_rate, 0.0, 2.0), true);
  }

  function mousePressed(event) {
    if (this.interval) {
      clearInterval(this.interval);
      this.interval = null;
      ::gamesession.getTapViewLayer().killLongTapEffect();
    }
    if (this.drag_interval) {
      clearInterval(this.drag_interval);
      this.drag_interval = null;
    }

    if (multi_tap_state != MULTI_TAP_NONE) return;
    this.enable_release_action = true;
    this.pressed_x = event.x;
    this.pressed_y = event.y;
    this.dragged_dist.set(0, 0, 0);
  }

  function mouseReleased(x, y) {
    super.mouseReleased(x, y);
  }
  function mouseDragged(vec_x, vec_y) {
    if (this.editing || _isMultiTapped()) return;
    super.mouseDragged(vec_x, vec_y);
    if (!is_camerarotate) this.scene.moveCamera_byScreenDist(vec_x, vec_y);
  }
  function mousePinched(rate) {
    this.scene.zoomCamera(Math.clamp(rate, 0.0, 2.0), true);
  }
  function longTapped(x, y) {
    super.longTapped(x, y);
  }

  function mouseevent(e) {
    if (_isMultiTapped()) return;

    switch (e.id) {
    case MOUSE_PRESSED:
      _pressFunc(e);
      break;

    case MOUSE_DRAGGED:
      if (this.editing) {

        this.edit_model.moveModelToScreenPosition(e.x, e.y, this.tap_offset);
      }
      break;

    case MOUSE_RELEASED:
      _releaseFunc(e);
      break;
    }
  }

  function _pressFunc(e) {

    if (this.edit_model.isSelect()) {
      this.tap_model = null;
      local _models = this.stage.getTappedFurnitureModelsAtScreenPosition(e.x, e.y);
      if (_models) {
        foreach (m in _models) {
          if (this.edit_model.isSelectModel(m)) {
            this.tap_model = m;
            break;
          }
        }
        if (!this.tap_model) this.tap_model = _models[0];
      }
    }
    else {
      if (!this.tutorial_model_lock) this.tap_model = this.stage.getTappedFurnitureModelAtScreenPosition(e.x, e.y);
    }

    if (this.tap_model) {

      if (this.edit_model.isSelect() && this.edit_model.isSelectModel(this.tap_model)) {
        ::playSound(SoundConstants.SOUND_ROOM_EDIT_PICK);
        this.editing = true;
        local _scpos = this.furniture_layouter.getTapScreenPosition(e.x, e.y);
        local _mpos = this.tap_model.getPos();
        this.tap_offset.x = _scpos.x - _mpos.x;
        this.tap_offset.z = _scpos.z - _mpos.z;
      }

    }

    this.hide_tap_check.t = ::getServerTime();
    this.hide_tap_check.x = e.x;
    this.hide_tap_check.y = e.y;
  }

  function _releaseFunc(e) {
    this.edit_model.resetDraggingFurniture();
    this.editing = false;

    local _tx = this.hide_tap_check.x - e.x;
    local _ty = this.hide_tap_check.y - e.y;
    local _dist = Math.sqrt(_tx * _tx + _ty * _ty);
    if (::getServerTime() - this.hide_tap_check.t <= 1 && _dist < 15) {

      this.edit_model.hideChangeButtons();

      if (this.tap_model && !this.edit_model.isSelect()) {
        this.edit_model.setModel(this.tap_model);
        showBoundAreaEffect(true);
        updatePanelName();
      }
    } else if (this.tap_model && this.edit_model.isSelect()) {
      ::playSound(SoundConstants.SOUND_ROOM_EDIT_DROP);
    }
    this.tap_model = null;
  }

  function showBoundAreaEffect(b) {
    local select_model = this.edit_model.getModel();

    if (b) {
      if (select_model) select_model.showBoundAreaEffect(true);
      local is_overlaid = select_model.isOverlaidModel();
      if (is_overlaid) {
        foreach (model in this.furniture_models_inroom) {
          if (select_model != model) model.stopBoundAreaEffect();
        }
      }
      else {
        foreach (model in this.furniture_models_inroom) {
          if (select_model != model && !model.isOverlaidModel()) model.showBoundAreaEffect(false);
        }
      }
    } else {
      if (select_model) select_model.stopBoundAreaEffect();
      foreach (model in this.furniture_models_inroom) {
        if (select_model != model) model.stopBoundAreaEffect();
      }
    }
  }

  function updatePanelName(set_panel_name = false) {
    local select_model = this.edit_model.getModel();
    if (!set_panel_name && select_model) {
      local fd = select_model.getFurnitureData();
      getHomeUI().setPanelNameText(fd.getCurrentName());

    } else {
      getHomeUI().setCurrentPanelName();
      this.pnl_furniture_info.visible = false;
    }
  }

  function _setFurnitureInfo(fd) {
    if (fd.getMaxExp() < 0) {
      this.pnl_furniture_info.visible = false;
      return;
    }

    local _lv = fd.getLevel();
    local _max_lv = fd.getMaxLevel();
    this.lbl_lv.setText(::dict.get("nums_level_per_max", [_lv, _max_lv]));

    local _ratio = 1.0;
    if (_lv == _max_lv) {
      this.lbl_exp.visible = false;
    }
    else {
      this.lbl_exp.visible = true;
      this.lbl_exp.setText(::dict.get("nums_ratio", [fd.getExpRatio()]));
      _ratio = float(fd.getExp()) / float(fd.getMaxExp());
      if (_ratio > 1.0) _ratio = 1.0;
    }
    local _w = this.bar_width * _ratio;
    if (_w <= 0.0) {
      this.exp_bar.visible = false;
    }
    else {
      this.exp_bar.visible = true;
      if (_w < 20) _w = 20;
      this.exp_bar.setRect(this.bar_pos.x, this.bar_pos.y, _w, this.exp_bar.bnd.h);
    }
  }

  function actionevent_back(e) {
    if (this.edit_model.getChangeButtonsVisible()) {
      this.edit_model.hideChangeButtons();
    }
    else {
      ::tutorial_manager.checkWaitingActionEvent(this.btn_back);
      this.stage.setVisibleGridWire(false);
      getHomeUI().backPanel();
    }
  }

  function actionevent_furnitures(e) {
    this.stage.setVisibleGridWire(false);
    getHomeUI().movePanel(::PropertyPanel);
  }

  function removed() {
    super.removed();
    this.edit_model.stopScript();
    this.edit_model.resetModel();
    showBoundAreaEffect(false);
    this.stage.setVisibleGridWire(false);
    this.scene.updateActiveSanrioCharas();

    removeMouseEventReceiver(this);

  }

  function setTutorialModelLock(b) {
    this.tutorial_model_lock = b;
  }

  function tutorialRoomEdit(setting) {
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _self.btn_furnitures.setEnabled(false);
    _self.btn_back.setEnabled(false);
    _self.setTutorialModelLock(true);
    local _btn = _home_ui.getButtonSlide();
    _btn.setEnabled(false);
    _btn = _self.edit_model.getButtonCancel();
    _btn.setEnabled(false);
    local _fix_btn = _self.edit_model.getButtonFix();
    _fix_btn.setEnabled(false);

    _tl.showText(_texts[0], 2);
    sleep(750);
    _tl.waitTap();
    _tl.updateText(_texts[1]);
    sleep(250);
    _tl.waitTap();
    _tl.hideText();
    _fix_btn.setEnabled(true);
  }

  function tutorialRoomEditEnd(setting) {
    local _home_ui = ::gamesession.getCurrentScene().getUI();
    local _self = _home_ui.getCurrentPanel();
    local _tl = ::gamesession.getTutorialLayer();
    local _texts = setting.getTextList();

    _self.btn_furnitures.setEnabled(false);
    _self.btn_back.setEnabled(false);
    _self.setTutorialModelLock(true);
    local _btn = _home_ui.getButtonSlide();
    _btn.setEnabled(false);
    _btn = _self.edit_model.getButtonCancel();
    _btn.setEnabled(false);

    sleep(500);

    _tl.showText(_texts[0], 1);
    sleep(750);
    _tl.waitTap();
    _tl.hideText();

    local _dlg = ::ImageViewDialogNoTitle();
    _dlg.setNoReadFlag(false);
    _dlg.setImagePathList(setting.getImagePathList());
    _dlg.show();
    sleep(500);

    _tl.showText(_texts[1]);
    sleep(750);
    _tl.waitTap();

    _self.btn_back.setEnabled(true);
    _tl.focusView(_self.btn_back, _home_ui);

    this.setWaitActionEvent(_self.btn_back);
    while (this.isWaitingActionEvent()) {
      suspend();
      if (!(_home_ui.getCurrentPanel() instanceof RoomEditPanel)) break;
    }
    _home_ui.getButtonSlide().setEnabled(true);
    _tl.focusOut();
    _tl.hideText();
  }
}

class RoomEditPanel.EditModel {
  static EDIT_ROTATE = 45;
  static TAPPED_SOUND = "ui/click.wav";

  model = null;
  start_x = 0.0;
  start_z = 0.0;
  start_angle = 0.0;
  start_view_index = -1;
  layout_data = null;
  v_1 = null;
  is_selecting = false;
  shop_id = -1;

  stage = null;
  camera = null;

  furniture_layouter = null;

  home = null;
  view = null;
  buttons = null;
  btn_cancel = null;
  btn_fix = null;
  btn_fix_ng = null;
  btn_buy = null;
  btn_buy_ng = null;
  btn_remove = null;
  btn_change = null;

  change_buttons = null;

  static RETURN_PANEL_HOME = 0;
  static RETURN_PANEL_ITEMS = 1;
  static RETURN_PANEL_SHOP = 2;
  return_panel = -1;

  static FIX_STATE_OK = -1;
  static FIX_STATE_NONE = 0;
  static FIX_STATE_OVERLAP = 1;
  static FIX_STATE_OUTSIDE = 2;
  static FIX_STATE_BLOCK_ROUTE = 3;
  static FIX_STATE_CAPACITY_OVER = 4;
  fix_state = 0;

  constructor(v, h, furniture_layouter) {
    this.view = v;
    this.home = h;
    this.furniture_layouter = furniture_layouter;

    this.buttons = ::loadSKView("/ui/common/FurnitureEditButtons3.ui");
    this.buttons.pickable = false;
    this.view.insertChild(1, this.buttons);
    this.buttons.visible = false;

    btn_cancel = this.buttons.findChild("btn_cancel");
    local _tap_button = ::TapButton(btn_cancel);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_cancel);
    _tap_button.setTappedSE(SoundConstants.SOUND_CANCEL);
    this.btn_fix = this.buttons.findChild("btn_fix");
    _tap_button = ::TapButton(this.btn_fix);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_fix);
    _tap_button.setTappedSE(SoundConstants.SOUND_ROOM_EDIT_FIX);
    this.btn_fix_ng = this.buttons.findChild("btn_fix_ng");
    ::TapButton(this.btn_fix_ng).view.addEventListener(ACTION_EVENT, actionevent_fix_ng);
    this.btn_buy = this.buttons.findChild("btn_buy");
    _tap_button = ::TapButton(this.btn_buy);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_fix);
    _tap_button.setTappedSE(SoundConstants.SOUND_DECIDE);
    this.btn_buy_ng = this.buttons.findChild("btn_buy_ng");
    ::TapButton(this.btn_buy_ng).view.addEventListener(ACTION_EVENT, actionevent_fix_ng);
    this.btn_remove = this.buttons.findChild("btn_remove");
    _tap_button = ::TapButton(this.btn_remove);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_remove);
    _tap_button.setTappedSE(SoundConstants.SOUND_ROOM_EDIT_REMOVE);

    local _btn_rotate = this.buttons.findChild("btn_rotate");
    _tap_button = ::TapButton(_btn_rotate);
    _tap_button.view.addEventListener(ACTION_EVENT, actionevent_rotate);
    _tap_button.setTappedSE(SoundConstants.SOUND_ROOM_EDIT_ROTATE);

    this.change_buttons = ChangeViewButtons(this);
    this.view.addChild(this.change_buttons);
    this.change_buttons.visible = false;

    this.stage = ::gamesession.getCurrentScene().getStage();
    this.camera = this.stage.renderer.camera;
    this.v_1 = Vector3D();
  }

  function getModel() {
    return this.model;
  }

  function setModel(m) {
    if (!m) return;
    if (this.is_selecting) return;

    this.shop_id = -1;
    this.layout_data = m.getLayoutData();
    _initEditModel(m);
    this.change_buttons.setChangeViewButton(m);

    this.btn_remove.visible = true;
    this.btn_fix.visible = true;
    this.btn_buy.visible = false;
    this.btn_fix_ng.visible = false;
    this.btn_buy_ng.visible = false;
    this.return_panel = RETURN_PANEL_HOME;

    if (m) {
      m.startEffect(::FurnitureModel.SCRIPT_SELECT_TAPPED);
      ::playSound(TAPPED_SOUND);
    }
  }

  function setNewModel(uid, sid = -1) {
    this.furniture_layouter.resetDraggingFurniture();
    local _model = ::FurnitureModel(this.stage.getScene());
    local _fd;
    this.shop_id = sid;
    if (uid == -1 && sid >= 0) {
      local _ss = ::gamesetting.shop_settings[sid];
      if (!_ss || _ss.type != SHOP_ITEM_TYPE_FURNITURE) return;
      _fd = FurnitureData().init(-1, _ss.item_id, _ss.getRoomID());

      local _fs = _fd.getSetting();
      if (_fs) _fd.setCurrentViewIndex(_fs.getViewLength() - 1);

      this.btn_fix.visible = false;
      this.btn_buy.visible = true;
      this.btn_fix_ng.visible = false;
      this.btn_buy_ng.visible = false;
      this.return_panel = RETURN_PANEL_SHOP;
    }
    else {
      _fd = ::gamesession.getUserData().getFurnitureData(uid);
      this.btn_fix.visible = true;
      this.btn_buy.visible = false;
      this.btn_fix_ng.visible = false;
      this.btn_buy_ng.visible = false;
      this.return_panel = RETURN_PANEL_ITEMS;
    }

    if (_fd) {
      _model.build(_fd);
      local _origin = this.stage.getHouseManager().getHouseBasePos();
      _model.setPosXYZ(_origin.x, _origin.y, _origin.z);
      _model.applyPos();

      _initEditModel(_model);

      _model.startEffect(::FurnitureModel.SCRIPT_SELECT_TAPPED);
      this.stage.getHouseManager().getFurnitureLayoutManager().addFurnitureModel(_model);

      local _fs = _fd.getSetting();
      if (_fs && !_fs.isOverlaid() && !this.furniture_layouter.enableAddFurniture()) disableFixButton(FIX_STATE_CAPACITY_OVER);
    }
    local _mpos = _model.getPos();
    this.furniture_layouter.moveFurnitureToPuttablePlace(this, _mpos.x, _mpos.z);
    resetDraggingFurniture();
    this.btn_remove.visible = false;

    this.stage.camera_work.moveToModel(_model);
  }

  function _initEditModel(m) {
    this.model = m;
    local _mpos = m.getPos();
    this.start_x = _mpos.x;
    this.start_z = _mpos.z;
    this.start_angle = m.getAngle();
    this.is_selecting = true;
    this.buttons.visible = true;
    this.start_view_index = m.getFurnitureData().getCurrentViewIndex();
    if (_isUIFurniture()) {
      this.btn_remove.visible = false;

    }
    else if (this.shop_id >= 0) {
      this.btn_remove.visible = true;

    }
    else {
      this.btn_remove.visible = true;

    }
  }

  function releaseSelect() {
    this.is_selecting = false;
    this.buttons.visible = false;
    this.view.parent.updatePanelName(true);
  }

  function updateFrame() {
    ::tutorial_manager.checkAndStartTutorialAtRoomEdit(this.home.getCurrentPanel());

    if (!this.is_selecting) return;

    local _area_v = this.camera.project(this.v_1.set(this.model.getPos()).add(0.0, 0, 0.0));
    local _area_x = (this.view.bnd.w - ::screenWidth) / 2.0 + ::screenWidth * _area_v.x;
    local _area_y = (this.view.bnd.h - ::screenHeight) / 2.0 + ::screenHeight * _area_v.y;

    local _move_x = _area_x - this.buttons.bnd.w / 1.8;
    local _move_y = _area_y - this.buttons.bnd.h - 135;
    this.buttons.pos.set(_move_x, _move_y);
    this.buttons.matdirty = true;
    this.buttons.repaint();

    if (this.change_buttons.visible) {
      this.change_buttons.pos.set(_move_x, _move_y);
      this.change_buttons.matdirty = true;
      this.change_buttons.repaint();
    }

    this.furniture_layouter.updateDraggingFurniture();
  }

  function isSelect() {
    return this.is_selecting;
  }

  function isSelectModel(m) {
    if (!m) return false;
    return this.model == m;
  }

  function enableFixButton() {
    if (isCapacityOverState()) return;

    this.fix_state = FIX_STATE_OK;
    if (this.shop_id < 0) this.btn_fix.visible = true;
    else this.btn_buy.visible = true;
    this.btn_fix_ng.visible = false;
    this.btn_buy_ng.visible = false;
  }

  function disableFixButton(fstate = -1) {
    if (isCapacityOverState()) fstate = FIX_STATE_CAPACITY_OVER;

    if (fstate >= 0) this.fix_state = fstate;
    this.btn_fix.visible = false;
    this.btn_buy.visible = false;
    if (this.shop_id < 0) this.btn_fix_ng.visible = true;
    else this.btn_buy_ng.visible = true;
  }

  function getFixState() {
    return this.fix_state;
  }

  function canFix() {
    return this.fix_state == FIX_STATE_OK;
  }

  function getButtonFix() {
    return this.btn_fix;
  }
  function getButtonCancel() {
    return this.btn_cancel;
  }

  function isOrverlapState() {
    return this.fix_state == FIX_STATE_OVERLAP;
  }

  function isCapacityOverState() {
    return this.fix_state == FIX_STATE_CAPACITY_OVER;
  }

  function resetDraggingFurniture() {
    this.furniture_layouter.resetDraggingFurniture();
  }

  function moveModelToScreenPosition(sx, sy, offset = null) {
    if (!this.is_selecting) return;

    this.furniture_layouter.moveFurnitureToScreenPosition(this, sx, sy, offset);
  }

  function resetModel() {
    if (!this.is_selecting) return;

    if (this.layout_data) {
      this.model.setPosXYZ(this.start_x, this.model.getPos().y, this.start_z);
      this.model.applyPos();
      this.model.setAngle(this.start_angle);
      this.model.applyAngle();

      local _fd = this.model.getFurnitureData();
      if (_fd.getCurrentViewIndex() != this.start_view_index) {
        _fd.setCurrentViewIndex(this.start_view_index);
        this.model.rebuild();
      }
      this.model.updateBoundObjView();
      this.model.stopBoundAreaEffect();
    }
    else {
      this.stage.getHouseManager().getFurnitureLayoutManager().removeFurnitureModel(this.model.getFurnitureData().getUID());
      this.model.release();
    }
  }

  function stopScript() {
    if (this.model && isSelect()) this.model.startEffect(::FurnitureModel.SCRIPT_SELECT_INTERRUPT);
    this.view.parent.showBoundAreaEffect(false);
  }

  function actionevent_cancel(e) {
    e.consume();
    if (!is_selecting) return;

    enableFixButton();
    stopScript();
    this.view.parent.updatePanelName(true);

    if (this.layout_data) {
      local _origin = this.stage.getHouseManager().getHouseBasePos();
      this.model.setupLayout(_origin, this.layout_data);

      resetModel();
      this.furniture_layouter.cancelFurnitureLaout(this);
    }
    else {
      this.stage.getHouseManager().getFurnitureLayoutManager().removeFurnitureModel(this.model.getFurnitureData().getUID());
      this.model.release();
    }
    releaseSelect();
    editFinished();
  }

  function actionevent_fix(e) {
    e.consume();
    if (!is_selecting) return;

    enableFixButton();

    local _origin = this.stage.getHouseManager().getHouseBasePos();
    local _mpos = this.model.getPos();
    local _ud = ::gamesession.getUserData();
    local _fd = this.model.getFurnitureData();

    if (this.layout_data) {
      if (_isEdit()) {
        local _lpos = this.layout_data.getPosXYZ();
        local _fld = ::FurnitureLayoutData.create(this.layout_data.getUID());
        _fld.setPosXYZ(_mpos.x + _origin.x, _lpos[1], _mpos.z + _origin.z);
        _fld.setAngle(this.model.getAngle() % 360);

        local _disp_id = this.model.furniture_setting.getID();
        println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
        println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
        println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);

        this.model.setupLayout(_origin, _fld);

        if (::gamesession.editLayoutFurniture(_fld, _ud.getCurrentRoomIndex(), _fd.getCurrentViewIndex())) {
          this.layout_data.apply(_fld);

          local _uid = this.layout_data.getUID();
          local _red = _ud.getRoomEditDataContainFurnitureFromSlots(_uid);
          local _layout = _red.getFurnitureLayoutData(_uid);
          _layout.apply(_fld);

          this.model.resetWaitingProductCharas();
        }
        else {
          resetModel();
        }
      }
      releaseSelect();
    }
    else {
      local _uid = this.model.getFurnitureData().getUID();
      if (_uid < 0) {
        local tmp_fld = ::FurnitureLayoutData.create(-1);
        tmp_fld.setAngle(this.model.getAngle());
        tmp_fld.setPosXYZ(_mpos.x + _origin.x, _mpos.y - _origin.y, _mpos.z + _origin.z);
        this.model.setupLayout(_origin, tmp_fld);

        _uid = _processPurchase();

        if (_uid == -2) {
          resetModel();
          releaseSelect();
          stopScript();
          return;
        }
        else if (_uid == -1) {
          return;
        }
        else {
          local _fld = ::FurnitureLayoutData.create(_uid);
          _fld.setAngle(this.model.getAngle());
          _fld.setPosXYZ(_mpos.x + _origin.x, _mpos.y - _origin.y, _mpos.z + _origin.z);
          this.model.setupLayout(_origin, _fld);
          _ud.getCurrentRoomEditData().addFurniture(_fld);

          releaseSelect();

          local _disp_id = this.model.furniture_setting.getID();
          println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
          println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
          println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
        }
      }
      else if (_uid >= 0) {
        local _fld = ::FurnitureLayoutData.create(_uid);
        _fld.setAngle(this.model.getAngle());
        _fld.setPosXYZ(_mpos.x + _origin.x, _mpos.y - _origin.y, _mpos.z + _origin.z);
        this.model.setupLayout(_origin, _fld);

        if (::gamesession.editLayoutFurniture(_fld, _ud.getCurrentRoomIndex(), _fd.getCurrentViewIndex())) {
          this.model.setupLayout(_origin, _fld);
          _ud.getCurrentRoomEditData().addFurniture(_fld);

          local _scene = ::gamesession.getCurrentScene();
          if (_scene instanceof SanrioGameScene) {
            local _pmm = _scene.getPanelMissionManager();
            local _fid = _ud.getFurnitureData(_uid).getID();
            _pmm.checkLayoutFurnitureID(_fid);
          }

          releaseSelect();
        }
        else {
          resetModel();
          releaseSelect();
          stopScript();
          return;
        }

        local _disp_id = this.model.furniture_setting.getID();
        println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
        println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
        println("*** set furniture id:" + _disp_id + " x:" + _fld.x + " y:" + _fld.y + " z:" + _fld.z + " a:" + _fld.angle);
      }
    }

    _fd = this.model.getFurnitureData();
    local _product_data = _fd.getProductData();

    if (_product_data && _product_data.getType() == ::ProductData.TYPE_DELIVER) {
      model.startEffect(::FurnitureModel.SCRIPT_PURCHASE);
    } else {
      model.startEffect(::FurnitureModel.SCRIPT_DECIDED);
    }

    local _udl = ::gamesession.getUserDataLocal();
    _udl.deleteNewItem(ITEM_TYPE_FURNITURE, _fd.getID());
    _udl.save();
    home.updateMenuNewMark(::HomeUI.UPDATE_MENU_MARK_FURNITURE);

    this.furniture_layouter.fixFurnitureLayout(this);
    stopScript();

    this.view.parent.getHomeUI().clearPanelHistory();

    ::tutorial_manager.checkWaitingActionEvent(this.btn_fix);
  }

  function actionevent_fix_ng(e) {
    e.consume();
    _showDisableMessage();
  }

  function actionevent_remove(e) {
    e.consume();
    if (!is_selecting) return;

    local _scene = ::gamesession.getCurrentScene();
    local _uid = this.model.getFurnitureData().getUID();
    local _ud = ::gamesession.getUserData();

    if (this.layout_data) {
      if (!::gamesession.removeLayoutFurniture(_uid, _ud.getCurrentRoomIndex())) return;
      this.furniture_layouter.removeFurniture(this);
      _ud.getCurrentRoomEditData().removeFurniture_byUID(_uid);

      local _env = {
        stage = this.stage,
        model = this.model,
        uid = _uid
      }

      newthread().start(function() {
        model.startEffect(::FurnitureModel.SCRIPT_CAUSE);
        model.setScriptLock(true);
        model.release(false);
        model.removeB3body();

        while (model.isEffectRunning(::FurnitureModel.SCRIPT_CAUSE)) { suspend(); }

        if (stage) stage.getHouseManager().getFurnitureLayoutManager().removeFurniture(uid);
      }.bindenv(_env));
    }
    else {

      this.stage.getHouseManager().getFurnitureLayoutManager().removeFurnitureModel(_uid);
      this.model.release();
    }

    if (_scene instanceof ::SanrioGameScene) {

      if (this.model.getFurnitureData().hasProductData()) {
        _scene.getProductionManager().cancelProduct(_uid, false);
      }

      local _pmm = _scene.getPanelMissionManager();
      local _fid = _ud.getFurnitureData(_uid).getID();
      _pmm.checkLayoutFurnitureID(_fid);
    }

    stopScript();
    releaseSelect();
    editFinished();
  }

  function actionevent_change(e) {
    e.consume();
    if (!is_selecting) return;
    if (this.change_buttons.canChange()) {
      this.change_buttons.visible = true;
      this.buttons.visible = false;
    }
  }

  function actionevent_rotate(e) {
    e.consume();
    if (!is_selecting) return;

    this.furniture_layouter.rotateFurniture(this, EDIT_ROTATE);
  }

  function getChangeButtonsVisible() {
    return this.change_buttons.visible;
  }

  function hideChangeButtons() {
    if (this.change_buttons.visible) {
      this.change_buttons.visible = false;
      this.buttons.visible = true;
    }
  }

  function _isEdit() {
    if (!this.is_selecting) return false;

    local _lpos = this.layout_data.getPosXYZ();
    local _mpos = this.model.getPos();
    local _vidx = this.model.getFurnitureData().getCurrentViewIndex();
    if (_mpos.x != _lpos[0] || _mpos.z != _lpos[2] || this.model.getAngle() != this.layout_data.getAngle() || this.start_view_index != _vidx) return true;
    return false;
  }

  function _isUIFurniture() {
    if (!this.model) return false;
    local _fid = this.model.getFurnitureSettingId();
    if (_fid >= UIFurnitures.CHARA && _fid <= UIFurnitures.DOOR) return true;
    return false;
  }

  function _processPurchase() {
    local _ss = ::gamesetting.shop_settings[this.shop_id];
    if (!_ss || _ss.type != SHOP_ITEM_TYPE_FURNITURE) return -2;

    local _dlg = ConfirmPurchaseDialog(this.shop_id);
    _dlg.need_moneylayer = true;
    _dlg.show();
    if (!_dlg.ret) return -1;

    local _ud = ::gamesession.getUserData();
    local _buid = -1;
    local _dst = -1;
    local _origin = this.stage.getHouseManager().getHouseBasePos();
    local _mpos = this.model.getPos();
    local _fld = ::FurnitureLayoutData.create(-1);
    _fld.setPosXYZ(_mpos.x + _origin.x, _origin.y - _origin.y, _mpos.z + _origin.z);
    _fld.setAngle(this.model.getAngle() % 360);

    _buid = ::gamesession.buyLayoutFurnitureNoDeliver(_fld, this.shop_id, _ud.getCurrentRoomIndex());
    if (_buid < 0) return -2;

    _ud.applyPurchase(_ss.getPriceType(), _ss.getPrice());
    if (_ss.limit > 0) {
      _ud.addPurchaseRecord(_ss.id, 1);
    }

    local _uid = _ud.addFurniture(_ss.item_id, _buid, false, _ss.getRoomID());
    this.model.removeBoundObject();
    this.stage.getHouseManager().getFurnitureLayoutManager().removeFurnitureModel(-1);

    local _fd = _ud.getFurnitureData(_uid);
    _fd.setCurrentViewIndex(0);
    local _pm = ::gamesession.getCurrentScene().getProductionManager();

    this.model.build(_fd, this.shop_id);
    this.stage.getHouseManager().getFurnitureLayoutManager().addFurnitureModel(this.model);
    return _uid
  }

  function editFinished() {
    switch (this.return_panel) {
    case RETURN_PANEL_ITEMS:
      this.home.movePanel(::PropertyPanel);
      break;
    case RETURN_PANEL_SHOP:
      this.home.movePanel(::ShopPanel);
      break;
    }
  }

  function _showDisableMessage() {
    ::gamesession.messagelayer.closeAllMessage();
    local _msg = ::Message();
    _msg.setMsec(1500);
    switch (this.fix_state) {
    case FIX_STATE_OK:
      return;
    case FIX_STATE_NONE:
      _msg.setText(::dict.get("layout_message_none"));
      break;
    case FIX_STATE_OVERLAP:
      _msg.setText(::dict.get("layout_message_overlap"));
      break;
    case FIX_STATE_OUTSIDE:
      _msg.setText(::dict.get("layout_message_outside"));
      break;
    case FIX_STATE_BLOCK_ROUTE:
      _msg.setText(::dict.get("layout_message_block_route"));
      break;
    case FIX_STATE_CAPACITY_OVER:
      _msg.setText(::dict.get("layout_message_capacity_over"));
      break;
    }
    _msg.setFontSize(32);
    _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
    _msg.show();
  }
}

class RoomEditPanel.EditModel.ChangeViewButtons extends SKView {
  view = null;
  pnl_buttons = null;

  button_size = -1;
  change_enable = false;
  edit_model = null;

  constructor(edit_model) {
    this.view = ::loadSKView("/ui/common/ChangeFurnitureView.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    this.view.findChild("lbl_title").setText(::dict.get("furniture_change_view"));
    this.pnl_buttons = this.view.findChild("pnl_buttons");
    local _btn_tmp = ::loadSKView("/ui/common/FurnitureViewSelect.ui");
    this.button_size = _btn_tmp.bnd.w;
    this.edit_model = edit_model;
  }

  function removed() {
    super.removed();
    edit_model = null;
  }

  function setChangeViewButton(m) {

    local _fd = m.getFurnitureData();
    this.pnl_buttons.clearChildren();
    if (!_fd) {
      this.change_enable = false;
      return;
    }

    local _fs = _fd.getSetting();
    local _vl = _fs.getViewLevelList();
    if (!_vl) {
      this.change_enable = false;
      return;
    }
    local _len = _vl.len();
    if (_len < 2) {
      this.change_enable = false;
      return;
    }

    local _def_x = 0;
    if (_len % 2 == 0) {
      _def_x += (this.button_size + 10) / 2;
    }

    for (local i = 0; i < _len; i++) {
      local _btn = ChangeViewButton(m, i, edit_model);
      _btn.pos.x = _def_x + i * (this.button_size + 10);
      this.pnl_buttons.addChild(_btn);
    }

    println("enable ok");

    this.change_enable = true;
  }

  function canChange() {
    return this.change_enable;
  }
}

class RoomEditPanel.EditModel.ChangeViewButtons.ChangeViewButton extends SKView {
  view = null;
  edit_model = null;

  model = null;
  index = -1;

  constructor(m, idx, edit_model) {
    this.model = m;
    this.index = idx;
    this.edit_model = edit_model;

    local _fd = m.getFurnitureData();

    this.view = ::loadSKView("/ui/common/FurnitureViewSelect.ui");
    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);
    addChild(this.view);

    local _btn_view = this.view.findChild("btn_view");
    local _btn_lock = _btn_view.findChild("btn_lock");
    local _img_frame = _btn_view.findChild("img_frame");
    local _img_lock = _btn_view.findChild("img_lock");

    local _lv = _fd.getSetting().getViewLeve(idx);
    _btn_lock.findChild("lbl_locklv").setText(::dict.get("nums_level", [_lv]));
    ::TapButton(_btn_view).view.addEventListener(ACTION_EVENT, actionevent_change_view);

    if (_fd.getCurrentViewIndex() == idx || (_fd.getUID() >= 0 && _fd.getLevel() >= _lv)) {
      _btn_lock.visible = false;
      _img_frame.visible = true;
      _img_lock.visible = false;
    }
    else {
      _btn_lock.visible = true;
      _img_frame.visible = false;
      _img_lock.visible = true;
    }

    local _pnl_icon = _btn_view.findChild("pnl_icon");
    local _sp = Sprite(::getTexture("/image/icon/furniture/" + _fd.getID() + "_" + idx + ".png"));
    _sp.blend = SK_MIX;
    local _img_icon = SKImageView(_sp);
    _img_icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(_img_icon);
  }

  function removed() {
    super.removed();
    edit_model = null;
  }

  function actionevent_change_view(e) {
    local _fd = this.model.getFurnitureData();
    if (_fd.getCurrentViewIndex() != this.index) {
      local _nedd_level = _fd.getSetting().getViewLeve(this.index);
      if (_nedd_level == null) {

      }
      else if (_nedd_level <= _fd.getLevel()) {

        local _uid = _fd.getUID();
        if (_uid >= 0) {
          _fd.setCurrentViewIndex(this.index);
          this.model.rebuild();

          this.model.startEffect(::FurnitureModel.SCRIPT_VIEW_CHANGED);
          this.model.showBoundAreaEffect(true);
        }
      }
      else {

        ::gamesession.messagelayer.closeAllMessage();
        local _msg = ::Message();
        _msg.setMsec(1500);
        _msg.setText(::dict.get("caution_view_level", [_nedd_level]));
        _msg.setFontSize(32);
        local _pos = clone this.edit_model.buttons.pos;
        local _parent_pos = clone this.parent.pos;
        local _parent_bnd = clone this.parent.bnd;
        local _x = _pos.x + this.pos.x + _parent_bnd.x + _parent_pos.x + this.bnd.w / 2.0;
        local _y = _pos.y + _parent_bnd.y + 30;
        _msg.setPosition(_x, _y);
        _msg.show();
        return;
      }
    }
    edit_model.hideChangeButtons();
  }
}

class RoomEditPanel.EditModel.ConfirmPurchaseDialog extends ::Dialog {

  static LEVELUP_FURNITURE_OFFSET = 15.0;

  static BUY_STATE_OK = 0;
  static BUY_STATE_SHORTAGE_GM = 1;
  static BUY_STATE_SHORTAGE_TOTALRM = 2;
  static BUY_STATE_SHORTAGE_RM = 3;
  buy_state = 0;

  btn_detail = null;
  shop_setting = null;
  img_buy = null;
  img_buy_ng = null;

  constructor(sid) {
    super(::loadSKView("/ui/dialog/ShopBuyConfirmDialog.ui"));

    this.shop_setting = ::gamesetting.shop_settings[sid];
    local _fs = ::gamesetting.furniture_settings[shop_setting.item_id];

    local _lbl_name = this.view.findChild("lbl_name");
    _lbl_name.setText(_fs.getName());
    local _lbl_confirm = this.view.findChild("lbl_confirm");
    _lbl_confirm.setText(::dict.get("shop_confirm"));

    this.img_buy = this.btn_ok.findChild("img_buy");
    this.img_buy_ng = this.btn_ok.findChild("img_buy_ng");

    _setupPrice();

    local _lbl_confirm = this.view.findChild("lbl_deliver");
    _lbl_confirm.setText(::dict.get("deliver_time"));

    local _lbl_time = this.view.findChild("lbl_time");
    _lbl_time.setText(::getTimeText(shop_setting.deliver_time, TIME_SLICE));

    this.btn_detail = this.view.findChild("btn_detail");
    ::TapButton(this.btn_detail).view.addEventListener(ACTION_EVENT, actionevent_showDialog);

    _setLevelupFurnitureInfo(_fs);
    _setupFurnitureSeriesIcon(_fs);

    this.tapbutton_ok.setTappedSE(SoundConstants.SOUND_PURCHASE);
  }

  function _setupPrice() {

    local _img_gm = this.btn_ok.findChild("img_gm");
    local _img_rm = this.btn_ok.findChild("img_rm");

    this.buy_state = BUY_STATE_OK;
    local _ud = ::gamesession.getUserData();
    switch (shop_setting.getPriceType()) {
    case PRICE_GM:
      _img_gm.visible = true;
      _img_rm.visible = false;
      if (_ud.getGameMoney() < shop_setting.getPrice()) this.buy_state = BUY_STATE_SHORTAGE_GM;
      break;
    case PRICE_RM:
      _img_gm.visible = false;
      _img_rm.visible = true;
      if (ud.getTotalRealMoney() < shop_setting.getPrice()) this.buy_state = BUY_STATE_SHORTAGE_TOTALRM;
      break;
    case PRICE_ONEROUS_RM:
      _img_gm.visible = false;
      _img_rm.visible = true;
      if (ud.getRealMoney() < shop_setting.getPrice()) this.buy_state = BUY_STATE_SHORTAGE_TOTALRM;
      break;
    }

    if (this.buy_state == BUY_STATE_OK) {
      this.img_buy.visible = true;
      this.img_buy_ng.visible = false;
    }
    else {
      this.img_buy.visible = false;
      this.img_buy_ng.visible = true;
    }

    local _lbl_price = this.btn_ok.findChild("lbl_price");
    _lbl_price.setText(shop_setting.price);
    if (this.buy_state == BUY_STATE_OK) _lbl_price.setColor(1548241151);
    else _lbl_price.setColor(0xff0000ff);
  }

  function _setupFurnitureSeriesIcon(_fs) {
    local pnl_series = this.view.findChild("pnl_seriesicon");
    local icon = SKImageView();
    icon.setSprite(_fs.getSeriesSetting().getIconSprite());
    icon.setRect(0, 0, pnl_series.bnd.w, pnl_series.bnd.h);
    pnl_series.addChild(icon);
  }

  function _setLevelupFurnitureInfo(_fs) {
    local _pnl_levelup = this.view.findChild("pnl_levelup");
    local _view_level_list = _fs.getViewLevelList();
    local _fid = _fs.getID();
    local _half_view_w = _pnl_levelup.bnd.w / 2.0;
    local _half_view_h = _pnl_levelup.bnd.h / 2.0;

    local _pnl_furniture = _pnl_levelup.findChild("pnl_furniture");
    _pnl_furniture.pickable = _pnl_furniture.visible = false;

    local _pnl_view = _pnl_furniture.findChild("pnl_view");
    local _arrow_sprite = _getArrowIconSprite();

    local _view_num = _view_level_list.len();
    local _arrow_num = _view_num - 1;
    local _offset_num = _arrow_num * 2;
    local _total_view_size = _view_num * _pnl_view.bnd.w + _arrow_num * _arrow_sprite.bnd.w + _offset_num * LEVELUP_FURNITURE_OFFSET;
    local _start_x = _half_view_w - _total_view_size / 2.0;
    local _right_pos = _start_x;
    for (local i = 0; i < _view_num; i++) {

      local _sp = Sprite(::getTexture(_fs.getIconPathByIndex(i)));
      _sp.blend = SK_MIX;
      local _img_icon = SKImageView(_sp);
      _img_icon.setRect(0, 0, _pnl_view.bnd.w, _pnl_view.bnd.h);
      _img_icon.centerize(0.0, 0.5);
      _img_icon.pos.set(_right_pos, _half_view_h, 0.0);
      _pnl_levelup.addChild(_img_icon);

      local _label_tmp = _pnl_furniture.findChild("lbl_level");
      local _label_level = SKLabelView("", _label_tmp.fontattr);
      _label_level.setParam(TEXTALIGN, 1);
      _label_level.setRect(0, 0, _label_tmp.bnd.w, _label_tmp.bnd.h);
      _label_level.pos.set(_right_pos, _half_view_h + (_label_tmp.bnd.h + _img_icon.bnd.h) / 2.0, 0.0);
      _label_level.updateLayout();
      _label_level.setText(::dict.get("nums_level", [_view_level_list[i]]));
      _pnl_levelup.addChild(_label_level);

      _right_pos += _pnl_view.bnd.w;

      if (i + 1 >= _view_num) break;

      _right_pos += LEVELUP_FURNITURE_OFFSET;

      _sp = _getArrowIconSprite();
      _sp.blend = SK_MIX;
      local _img_arrow = SKImageView(_sp);
      _img_arrow.setRect(0, 0, _sp.bnd.w, _sp.bnd.h);
      _img_arrow.centerize(0.0, 0.5);
      _img_arrow.pos.set(_right_pos, _half_view_h, 0.0);
      _pnl_levelup.addChild(_img_arrow);

      _right_pos += _arrow_sprite.bnd.w + LEVELUP_FURNITURE_OFFSET;
    }

  }

  function _getArrowIconSprite() {
    local _sp = Sprite(::getTexture("/ui/image/icon/icon/icon_arrow_right.png"));
    _sp.blend = SK_MIX;
    return _sp;
  }

  function actionevent_showDialog(e) {
    local _dlg = ::FurnitureInfoDialog();
    _dlg.setShopSetting(this.shop_setting.getID());
    _dlg.show();
  }

  function actionevent(e) {
    local _dlg;

    switch (e.src) {
    case btn_ok:
      if (this.buy_state != BUY_STATE_OK) {
        _dlg = ::SimpleDialog();
        _dlg.lbl_msg.setText(_getCantBuyText());
        _dlg.show();
        return;
      }
      ret = 1;
      close();
      break;
    case btn_cancel:
    case btn_close: ret = 0; close(); break;
    }

    if (func) func(ret);
  }

  function _getCantBuyText() {
    switch (this.buy_state) {
    case BUY_STATE_SHORTAGE_GM:
      return ::dict.get("no_have_gm");
    case BUY_STATE_SHORTAGE_TOTALRM:
    case BUY_STATE_SHORTAGE_RM:
      return ::dict.get("lack_rm");
    }
    return "error";
  }
}