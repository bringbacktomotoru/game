class FurnitureShopPanel extends ::HomeUI.Panel {
  static need_menu_layer = false;

  view = null;
  reclist = null;
  scroll = null;

  furniture_list = null;

  function added() {
    super.added();

    this.view = ::loadSKView("/ui/ItemListPanel.ui");
    addChild(this.view);

    local _btn_back = this.view.findChild("btn_back");
    ::TapButton(_btn_back).view.addEventListener(ACTION_EVENT, actionevent_back);

    local _btn_change = this.view.findChild("btn_performance");
    ::TapButton(_btn_change).view.addEventListener(ACTION_EVENT, actionevent_change);

    local _pnl_list = this.view.findChild("pnl_item_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dxscale = 0.0;
    _pnl_list.addChild(this.reclist);
    _pnl_list.setBuffer(true);
    this.reclist.clearChildren();

    this.furniture_list = [];
    local _shop_settings = ::gamesetting.shop_settings;
    local _offset = 0;
    local _cnt = 0;
    local _size_y = 0;
    local _home = getHomeUI();
    foreach (ss in _shop_settings) {
      if (ss.type != SHOP_ITEM_TYPE_FURNITURE) continue;

      local _furni = FurnitureCard(ss, _home);
      _size_y = _furni.bnd.h;
      if (_cnt > 0 && _cnt % 2 == 0) _offset += _size_y + 10;

      _furni.pos.x = (_cnt % 2) * _furni.bnd.w + (_cnt % 2) * 10;
      _furni.pos.y = _offset;
      this.reclist.addChild(_furni);
      _furni.matdirty = true;
      _furni.repaint();

      this.furniture_list + _furni;
      _cnt++;
    }
    _offset += _size_y;

    this.reclist.setRect(0, 0, _pnl_list.bnd.w, _offset);
    this.scroll.setScrollRect(this.reclist.bnd);

    local _scroll_bar = ::ScrollBarV(this.view.findChild("pnl_scroll_bar"));
    _scroll_bar.setup(this.scroll, _pnl_list.bnd, false);
  }

  function actionevent_back(e) {
    getHomeUI().movePanel(::ItemMenuPanel, false, { "mode" = 0 });
  }
  function actionevent_sort(e) {
  }
  function actionevent_filter(e) {
  }
  function actionevent_change(e) {
    for (local i = 0; i < this.furniture_list.len(); i++) {
      this.furniture_list[i].reverseCard();
    }
  }
}

class FurnitureShopPanel.FurnitureCard extends SKView {

  view = null;
  pnl_front = null;
  pnl_back = null;

  home = null;
  shop_setting = null;
  mode = 0;

  constructor(ss, home) {
    this.home = home;
    this.shop_setting = ss;
    local _setting = ::gamesetting.furniture_settings[ss.item_id];

    this.view = ::loadSKView("/ui/common/FurnitureShopCard.ui");
    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    local _btn_furni = this.view.findChild("btn_furni");
    ::TapButton(_btn_furni, false).region.addEventListener(ACTION_EVENT, actionevent_select);

    local _btn_detail = _btn_furni.findChild("btn_detail");
    ::TapButton(_btn_detail).view.addEventListener(ACTION_EVENT, actionevent_detail);

    local _pnl_icon = _btn_furni.findChild("pnl_icon");
    local _sp = Sprite(::getTexture("/image/icon/furniture/" + ss.item_id + "_" + 0 + ".png"));
    _sp.blend = SK_MIX;
    local _img_icon = SKImageView(_sp);
    _img_icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(_img_icon);

    this.pnl_front = _btn_furni.findChild("pnl_front");

    local _grade = _setting.getGrade();
    if (_grade > 0) {
      local _pnl_rare = this.pnl_front.findChild("pnl_rare");
      _sp = Sprite(::getTexture("/ui/image/icon/icon/icon_reality.png"));
      _sp.blend = SK_MIX;

      local _icon_size = _pnl_rare.bnd.h;
      local _def_x = _pnl_rare.bnd.w / 2.0;
      if (_grade % 2 == 1) _def_x -= _icon_size / 2.0;
      for (local i = 0; i < _grade; i++) {
        local _icon_grade = ::SKImageView(_sp);
        _icon_grade.setRect(0, 0, _icon_size, _icon_size);

        local _px = _def_x - (_grade / 2 - i) * _icon_size;
        _icon_grade.pos.set(_px, 0);
        _pnl_rare.addChild(_icon_grade);
      }
    }

    local _lbl_price = this.pnl_front.findChild("lbl_price");
    _lbl_price.setText(ss.price);

    local _img_gm = this.pnl_front.findChild("img_gm");
    local _img_rm = this.pnl_front.findChild("img_rm");

    switch (ss.price_type) {
    case PRICE_GM:
      _img_gm.visible = true;
      _img_rm.visible = false;
      break;
    case PRICE_RM:
      _img_gm.visible = false;
      _img_rm.visible = true;
      break;
    case PRICE_ONEROUS_RM:
      _img_gm.visible = false;
      _img_rm.visible = true;
      break;
    }

    this.pnl_back = _btn_furni.findChild("pnl_back");
    this.pnl_back.visible = false;

    local _production_setting = _setting.getProductionSetting();
    local _product = null;
    if (_production_setting) _product = _production_setting.getMaxProduct();
    local _lbl_health = this.pnl_back.findChild("lbl_health");
    local _lbl_time = this.pnl_back.findChild("lbl_time");
    if (_product) {
      _lbl_health.setText(_product.health);
      _lbl_time.setText(::getTimeText(_product.time));
    }
    else {
      _lbl_health.setText("--");
      _lbl_time.setText("--");
    }
  }

  function actionevent_select(e) {
    this.home.movePanel(::RoomEditPanel, false, { "uid" = -1, "sid" = this.shop_setting.id });
  }

  function actionevent_detail(e) {

    local _dlg = ::FurnitureInfoDialog();

    _dlg.setShopSetting(this.shop_setting.getID());
    _dlg.show();
  }

  function reverseCard() {
    if (this.mode == 0) {
      this.mode = 1;
      this.pnl_front.visible = false;
      this.pnl_front.matdirty = true;
      this.pnl_front.repaint();

      this.pnl_back.visible = true;
      this.pnl_back.matdirty = true;
      this.pnl_back.repaint();
    }
    else {
      this.mode = 0;
      this.pnl_front.visible = true;
      this.pnl_front.matdirty = true;
      this.pnl_front.repaint();

      this.pnl_back.visible = false;
      this.pnl_back.matdirty = true;
      this.pnl_back.repaint();
    }
  }
}