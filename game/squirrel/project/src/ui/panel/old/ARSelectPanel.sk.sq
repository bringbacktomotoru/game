import SKViewPropertyID;

class ARCharaSelectPanel extends HomeUI.Panel {
  view = null;
  panel = null;

  chara_list = null;

  pos_y = 0;

  btn_back = null;

  constructor(costume_id, panel) {
    local _processing = ::gamesession.processinglayer;
    _processing.startProcess(skGetTime());
    this.view = ::loadSKView("/ui/MemberSelectPanel.ui");

    local _menu_tab_menubg = view.findChild("menu_tab_menubg");
    _menu_tab_menubg.setVisible(false);
    local _img_list_bg = view.findChild("img_list_bg");
    _img_list_bg.setVisible(false);
    local _btn_performance = view.findChild("btn_performance");
    _btn_performance.setVisible(false);

    local _bg = view.findChild("pnl_img_bg_s");
    _bg.setVisible(true);

    local _pnl_item_list = view.findChild("pnl_item_list");
    chara_list = CharaList(_pnl_item_list, costume_id, this);

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) == SanrioGameScene) {
      local _home_ui = _scene.getUI();
      _home_ui.showPanelMode(true);
      local _panel_name = getclassname(this);

      local _title_settings = ::gamesetting.title_settings;
      local _title_setting;
      foreach (_setting in _title_settings) {
        if (!_setting.getKey().equals(_panel_name)) continue;
        _title_setting = _setting;
        break;
      }
      _home_ui.setPanelModeSetting(_title_setting);
    }

    this.panel = panel;
    setRect(0.0, 0.0, this.view.bnd.w, this.view.bnd.h);
    addChild(view);
    setVisible(false);
    panel.addChild(this);

    btn_back = view.findChild("btn_back");
    ::TapButton(btn_back).view.addEventListener(ACTION_EVENT, _actionevent_back);

    pos_y = this.pos.y;
    _processing.endProcess();
  }

  function resetCostumeID(costume_id) {
    chara_list.resetCostumeID(costume_id);
  }

  function changeChara() {
    if (chara_list.isCostumeUpdated()) {
      panel.changeSanrioChara(chara_list.selected_costume_id);
    }
    hide();
  }

  function show() {

    setVisible(true);
    is_animating = true;
    this.pos.y = pos_y;

    pushed();
    while (this.isAnimating()) {
      suspend();
    }

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) == SanrioGameScene) {
      local _home_ui = _scene.getUI();
      _home_ui.showPanelMode(true);
    }
    this.view.startMethod("show");
    while (this.view.isMethodRunning()) { suspend(); }
  }

  function hide() {

    popped();
    while (isAnimating()) {
      suspend();
    }
    setVisible(false);

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) == SanrioGameScene) {
      local _home_ui = _scene.getUI();
      _home_ui.showPanelMode(false);
    }
    this.view.startMethod("hide");
  }

  function _actionevent_back(e) {
    e.consume();
    hide();
  }
}

class ::ARCharaSelectPanel.CharaList extends SKView {
  static SPACE_X = 5;
  static SPACE_Y = 10;

  selected_costume_id = null;
  current_costume_id = null;

  view = null;
  panel = null;

  reclist = null;
  scroll = null;

  constructor(v, costume_id, panel) {
    resetCostumeID(costume_id);

    this.view = v;
    this.panel = panel;
    setRect(0, 0, v.bnd.w, v.bnd.h);
    view.addChild(this);

    local _costumes = ::gamesetting.costume_settings;
    local _ud_costumes = ::gamesession.getUserData().getCostumeDataTable();

    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.addChild(this.reclist);
    this.setBuffer(true);
    this.reclist.clearChildren();

    local _offset = 0;
    local _cnt = 0;
    local _ROW_NUM = 5;
    local card_size = this.view.bnd.w / _ROW_NUM;

    local _size_x = 0;

    foreach (cd in _ud_costumes) {
      local _chara_id = cd.getCharaID();

      local _card = CostumeCard(cd, this);
      if (!_size_x) _size_x = _card.bnd.w;
      if (_cnt > 0 && _cnt % 2 == 0) _offset += _size_x + SPACE_X;

      _card.pos.x = _offset;
      _card.pos.y = (_cnt % 2) * (_card.bnd.h + SPACE_Y);
      if (_cnt % 2 == 1) {
        _card.setInvisibleUnderLine();
      }
      this.reclist.addChild(_card);
      _card.matdirty = true;
      _card.repaint();

      _cnt++;
      suspend();
    }
    _offset += _size_x * 2;

    this.reclist.setRect(0, 0, _offset, v.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);

    local _scroll_bar = ::ScrollBarH(this.view.parent.findChild("pnl_scroll_bar"));
    _scroll_bar.setup(this.scroll, v.bnd, true);
  }

  function resetCostumeID(costume_id) {
    current_costume_id = selected_costume_id = costume_id;
  }
  function setCostumeId(costume_id) {
    if (costume_id != 0) selected_costume_id = costume_id;

    panel.changeChara();
  }

  function isCostumeUpdated() {
    return selected_costume_id != current_costume_id && current_costume_id != 0;
  }
}

class ARCharaSelectPanel.CharaList.CostumeCard extends SKView {
  costume_id = -1;
  costume_data = null;
  gacha_list = null;

  home = null;
  view = null;
  pnl_parent = null;
  pnl_front = null;
  pnl_back = null;
  img_rare = null;
  img_chara = null;
  img_collection = null;
  img_lineunder = null;
  lbl_level = null;
  lbl_per = null;

  detail_dialog = null;

  constructor(cd, gacha_list) {
    this.costume_data = cd;
    this.costume_id = cd.getID();
    this.gacha_list = gacha_list;

    this.view = ::loadSKView("/ui/common/CostumeCard.ui");
    setRect(view.bnd.x, view.bnd.y, view.bnd.w, view.bnd.h);
    addChild(view);

    local _btn_costume = view.findChild("btn_costume");
    ::TapButton(_btn_costume, false).region.addEventListener(ACTION_EVENT, actionevent_select);

    local _btn_detail = _btn_costume.findChild("btn_detail");
    ::TapButton(_btn_detail, false).view.addEventListener(ACTION_EVENT, actionevent_detail);

    local _pnl_icon = _btn_costume.findChild("pnl_icon");
    this.img_chara = ::SKImageView();
    CostumeIcon(cd.getID(), this.img_chara, false, false);
    this.img_chara.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(this.img_chara);

    local _img_house = _btn_costume.findChild("icon_house");
    _img_house.setVisible(false);

    this.img_lineunder = this.view.findChild("pink_line_under");

    this.pnl_front = _btn_costume.findChild("pnl_front");

    local _setting = cd.getSetting();
    local _pnl_rare = this.pnl_front.findChild("pnl_rare");
    this.img_rare = SKImageView();
    this.img_rare.setSprite(::Setting.getRarityIconSprite(_setting.grade));
    this.img_rare.setRect(0, 0, _pnl_rare.bnd.w, _pnl_rare.bnd.h);
    _pnl_rare.addChild(this.img_rare);

    this.lbl_level = this.pnl_front.findChild("lbl_level");
    this.lbl_level.setText(::dict.get("nums_level", [cd.getLevel()]));

    local _pnl_back = _btn_costume.findChild("pnl_back");
    _pnl_back.setVisible(false);
    local _pnl_selected = _btn_costume.findChild("pnl_selected");
    _pnl_selected.setVisible(false);

  }

  function setInvisibleUnderLine() {
    this.img_lineunder.setVisible(false);
  }

  function actionevent_select(e) {
    gacha_list.setCostumeId(costume_id);
  }

  function actionevent_detail(e) {
    if (!this.detail_dialog) {
      this.detail_dialog = ::CostumeInfoDialog();
      this.detail_dialog.setCostumeData(this.costume_data);
    }
    this.detail_dialog.show();
  }
}

class ARFurnitureSelectPanel extends HomeUI.Panel {
  static COL_NUM = 3;
  furniture_uid = -1;
  view = null;
  panel = null;

  pnl_card_list = null;
  reclist = null;
  scroll = null;
  card_list = null;
  scroll_bar = null;

  pos_y = null;

  btn_back = null;

  constructor(fuid, panel) {
    local _processing = ::gamesession.processinglayer;
    _processing.startProcess(skGetTime());

    resetFurnitureUID(fuid);
    this.view = ::loadSKView("/ui/ItemListPanel.ui");

    this.view.findChild("btn_performance").visible = false;
    this.view.findChild("btn_sort").visible = false;

    this.pnl_card_list = this.view.findChild("pnl_item_list");
    this.reclist = ::SKMaskView();
    this.scroll = ::ScrollPanel(this.reclist);
    this.scroll.dyscale = 0.0;
    this.pnl_card_list.addChild(this.reclist);
    this.pnl_card_list.setBuffer(true);

    this.scroll_bar = ::ScrollBarH(this.view.findChild("pnl_scroll_bar"));

    this.card_list = {};

    _setCardList();

    this.view.startMethod("init");

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) == SanrioGameScene) {
      local _home_ui = _scene.getUI();
      local _panel_name = getclassname(this);

      local _title_settings = ::gamesetting.title_settings;
      local _title_setting;
      foreach (_setting in _title_settings) {
        if (!_setting.getKey().equals(_panel_name)) continue;
        _title_setting = _setting;
        break;
      }
      _home_ui.setPanelModeSetting(_title_setting);
    }

    this.panel = panel;
    setRect(0.0, 0.0, this.view.bnd.w, this.view.bnd.h);
    addChild(view);
    panel.addChild(this);

    btn_back = view.findChild("btn_back");
    ::TapButton(btn_back).view.addEventListener(ACTION_EVENT, _actionevent_back);

    pos_y = this.pos.y;
    _processing.endProcess();

  }

  function _setCardList() {
    this.reclist.clearChildren();

    local _furnitures = ::gamesession.getUserData().getFurnitureDataTable();
    local _offset = 0;
    local _cnt = 0;
    local _size_x = 0;
    local _sort_list = _getFurnitureSortList(_furnitures);
    local _new_items = ::gamesession.getUserDataLocal().getNewItem(ITEM_TYPE_FURNITURE);
    if (!_new_items) _new_items = [];
    foreach (_sort_furniture_list in _sort_list) {
      foreach (fd in _sort_furniture_list) {

        if (fd.getSetting().getEnableActionNum() != 1) continue;
        local _furni = this.card_list[fd.getUID()] || FurnitureCard(this, fd);

        _size_x = _furni.bnd.w;
        if (_cnt > 0 && _cnt % COL_NUM == 0) _offset += _size_x + 10;

        _furni.pos.x = _offset;
        _furni.pos.y = (_cnt % COL_NUM) * (_furni.bnd.h + 5);
        this.reclist.addChild(_furni);
        _furni.matdirty = true;
        _furni.repaint();

        this.card_list[fd.getUID()] <- _furni;
        _cnt++;
      }
    }
    _offset += _size_x * 2;

    this.reclist.setRect(0, 0, _offset, this.pnl_card_list.bnd.h);
    this.scroll.setScrollRect(this.reclist.bnd);
    this.scroll_bar.setup(this.scroll, this.pnl_card_list.bnd, true);

    newthread().start(_setupCardViews, this);
  }

  function _setupCardViews() {
    sleep(140);
    local t = skGetTime();
    foreach (card in this.card_list) {
      card.setupViews();

      local t2 = skGetTime();
      if (t + 16 < t2) {
        t = t2;
        suspend();
      }
    }
  }

  function _getFurnitureSortList(furnitures) {
    local _lists = {};
    local _series_list = [];
    local _added;

    foreach (fd in furnitures) {
      local _sid = fd.getSeries();
      local _list = _lists[_sid];

      _added = false;
      if (!_list) {
        _list = [];
        _list + fd;
        _lists[_sid] <- _list;
        foreach (idx, slid in _series_list) {
          if (slid > _sid) {
            _series_list[idx] <- _sid;
            _added = true;
            break;
          }
        }
        if (!_added) _series_list + _sid;
      }
      else {
        foreach (idx, lfd in _list) {
          if (lfd.getID() > fd.getID()) {
            _list[idx] <- fd;
            _added = true;
            break;
          }
        }
        if (!_added) _list + fd;
      }
    }

    local _result = [];
    foreach (slid in _series_list) {
      _result + _lists[slid];
    }
    return _result;
  }

  function resetFurnitureUID(fuid) {
    furniture_uid = fuid;
  }

  function changeFurniture(fuid) {
    if (this.furniture_uid != fuid) {
      panel.changeFurniture(fuid);
    }
    hide();
  }

  function show() {

    is_animating = true;
    this.pos.y = pos_y;

    setVisible(true);
    pushed();
    while (this.isAnimating()) {
      suspend();
    }

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) == SanrioGameScene) {
      local _home_ui = _scene.getUI();
      _home_ui.showPanelMode(true);
    }
    this.view.startMethod("show");
    while (this.view.isMethodRunning()) { suspend(); }
  }

  function hide() {

    popped();
    while (isAnimating()) {
      suspend();
    }
    setVisible(false);

    local _scene = ::gamesession.getCurrentScene();
    if (getclass(_scene) == SanrioGameScene) {
      local _home_ui = _scene.getUI();
      _home_ui.showPanelMode(false);
    }
    this.view.startMethod("hide");
  }

  function _actionevent_back(e) {
    e.consume();
    hide();
  }

}

class ARFurnitureSelectPanel.FurnitureCard extends SKView {

  pnl_parent = null;
  view = null;
  pnl_front = null;
  pnl_back = null;

  furniture_data = null;
  mode = 0;

  static STATE_NORMAL = 0;
  static STATE_CURRENT_ROOM = 1;
  static STATE_OTHER_ROOM = 2;

  constructor(p, fd) {
    this.pnl_parent = p;
    this.furniture_data = fd;
    this.view = ::loadSKView("/ui/common/old/PropertyFurnitureCard_old.ui");

    addChild(this.view);
    setRect(this.view.bnd.x, this.view.bnd.y, this.view.bnd.w, this.view.bnd.h);

    setupHighPriorityViews();
  }

  function setupHighPriorityViews() {
    local _setting = this.furniture_data.getSetting();

    local _btn_furni = this.view.findChild("btn_furni");
    ::TapButton(_btn_furni, false).region.addEventListener(ACTION_EVENT, actionevent_select);

    local _btn_detail = _btn_furni.findChild("btn_detail");
    ::TapButton(_btn_detail).view.addEventListener(ACTION_EVENT, actionevent_detail);

    local _pnl_room = _btn_furni.findChild("pnl_room");
    _pnl_room.clearChildren();
    local _ud = ::gamesession.getUserData();

    this.pnl_front = _btn_furni.findChild("pnl_front");

    local _grade = _setting.getGrade();
    if (_grade > 0) {
      local _pnl_rare = this.pnl_front.findChild("pnl_rare");
      local _icon_size = _pnl_rare.bnd.h;
      local _icon_rare = SKImageView();
      _icon_rare.setSprite(::Setting.getRarityIconSprite(_grade));
      _icon_rare.setRect(0, 0, _icon_size, _icon_size);
      _pnl_rare.addChild(_icon_rare);
    }

    local _lbl_lv = this.pnl_front.findChild("lbl_level");
    _lbl_lv.setText(::dict.get("nums_level", [this.furniture_data.getLevel()]));

    this.pnl_back = _btn_furni.findChild("pnl_back");
    this.pnl_back.visible = false;

    local _production_setting = _setting.getProductionSetting();
    local _product = null;
    if (_production_setting) _product = _production_setting.getProductByLevel(this.furniture_data.getLevel());
    local _lbl_health = this.pnl_back.findChild("lbl_health");
    local _lbl_time = this.pnl_back.findChild("lbl_time");
    if (_product) {
      if (::DISABLE_TRIAL) {
        _lbl_health.setText(_product.health);
      }
      else {
        local _max = _production_setting.getMaxRewardGM();
        local _min = _production_setting.getMinRewardGM();
        if (_max == _min) _lbl_health.setText(_max);
        else _lbl_health.setText(::dict.get("nums_range", [_min, _max]));
      }
      _lbl_time.setText(::getTimeText(_product.time));
    }
    else {
      _lbl_health.setText("--");
      _lbl_time.setText("--");
    }

    _btn_furni.findChild("img_new").visible = false;
  }

  function setupViews() {

    local _setting = this.furniture_data.getSetting();
    local _btn_furni = this.view.findChild("btn_furni");
    local _pnl_icon = _btn_furni.findChild("pnl_icon");

    local _sp = Sprite(::getTexture(_setting.getIconPathByLevel(this.furniture_data.getLevel())));
    _sp.blend = SK_MIX;
    local _img_icon = SKImageView(_sp);
    _img_icon.setRect(0, 0, _pnl_icon.bnd.w, _pnl_icon.bnd.h);
    _pnl_icon.addChild(_img_icon);

  }

  function actionevent_select(e) {

    pnl_parent.changeFurniture(this.furniture_data.getUID());
  }

  function actionevent_detail(e) {

    local _dlg = ::FurnitureInfoDialog();
    _dlg.setFurnitureData(this.furniture_data, ::FurnitureInfoDialog.MODE_DETAIL);
    _dlg.show();

    if (_dlg.ret > 0) {
      ::gamesession.messagelayer.closeAllMessage();
      local _msg = ::Message();
      _msg.setMsec(4 * 1000);
      _msg.setText(::dict.get("shop_sold", [::dict.get("furniture")]));
      _msg.setFontSize(32);
      _msg.setPosition(::screenWidth / 2.0, ::screenHeight / 2.0);
      _msg.show();
      this.pnl_parent.removeCard(this.furniture_data.getUID());
    }
  }

}