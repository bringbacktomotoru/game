class SimpleImageDialog extends ::Dialog {
  lbl_msg = null;
  img_icon = null;

  constructor() {
    super(::loadSKView("/ui/dialog/ImageDialog_s.ui"));
    lbl_msg = this.view.findChild("lbl_text");
    img_icon = this.view.findChild("img_icon");
    this.view.findChild("lbl_ok").setText(::dict.get("close"));
  }

  function setSprite(sp) {
    if (!sp) return;
    this.img_icon.setSprite(sp);
    this.img_icon.updateLayout();
  }
}