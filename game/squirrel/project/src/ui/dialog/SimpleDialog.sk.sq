class SimpleDialog extends ::Dialog {
  lbl_msg = null;

  constructor() {
    super(::loadSKView("/ui/dialog/Dialog_s.ui"));
    lbl_msg = this.view.findChild("lbl_text");
    this.view.findChild("lbl_ok").setText(::dict.get("ok"));
  }
}

class SimpleDialog2 extends ::Dialog {
  static TYPE_WORK = 0;
  static TYPE_PRODUCT = 1;

  lbl_msg = null;
  lbl_caution = null;
  btn_shorten = null;
  lbl_rm_val = null;
  intr = 0;

  img_icon_gm = null;
  img_icon_rm = null;

  constructor() {
    super(::loadSKView("/ui/dialog/Dialog_s2.ui"));
    lbl_msg = this.view.findChild("lbl_text_title");
    lbl_caution = this.view.findChild("lbl_text");

    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("cancel"));
    this.btn_ok.findChild("lbl_ok").setText(::dict.get("ok"));

    this.btn_shorten = this.view.findChild("btn_shorten");
    this.btn_shorten.visible = false;
    this.img_icon_gm = this.btn_shorten.findChild("img_icon_gm");
    this.img_icon_rm = this.btn_shorten.findChild("img_icon_rm");
    this.lbl_rm_val = this.btn_shorten.findChild("lbl_rm_val");
  }

  function setTextOk(s) {
    this.btn_ok.findChild("lbl_ok").setText(s);
  }
  function setTextCancel(s) {
    this.btn_cancel.findChild("lbl_cancel").setText(s);
  }

  function setShorten(time, type) {

    local _calc_func;
    local _use_rm;
    if (type == TYPE_WORK) {
      _use_rm = ::gamesetting.game_rule.calcShortenRMWork(time);
    }
    else {
      _use_rm = ::gamesetting.game_rule.calcShortenRMProduct(time);
    }
    setPrice(_use_rm, PRICE_RM);
    this.btn_shorten.findChild("lbl_shorten").setText(::dict.get("shorten"));
    this.tapbutton_ok.setTappedSE(SoundConstants.SOUND_DECIDE);

    local _env = {
      self = this,
      time = time,
      type = type,
      t = 0
    }
    local _func = function(dt) {
      t += dt;
      local _use_rm;
      local _remaining = time - t / 1000;
      if (type == self.TYPE_WORK) {
        _use_rm = ::gamesetting.game_rule.calcShortenRMWork(_remaining);
      }
      else {
        _use_rm = ::gamesetting.game_rule.calcShortenRMProduct(_remaining);
      }
      self.lbl_rm_val.setText(_use_rm);
      self.lbl_rm_val.matdirty = true;
      self.lbl_rm_val.repaint();
      if (_remaining <= 0) {
        self.intr = null;
        return undefined;
      }
    }.bindenv(_env);
    this.intr = setInterval(_func, 1000);
  }

  function setPrice(price, type) {
    this.btn_ok.visible = false;
    this.btn_shorten.visible = true;
    this.tapbutton_ok = ::TapButton(this.btn_shorten);
    this.tapbutton_ok.view.addEventListener(ACTION_EVENT, actionevent_shorten);

    switch (type) {
    case PRICE_GM:
      this.img_icon_gm.visible = true;
      this.img_icon_rm.visible = false;
      break;
    case PRICE_RM:
      this.img_icon_gm.visible = false;
      this.img_icon_rm.visible = true;
      break;
    case PRICE_ONEROUS_RM:
      this.img_icon_gm.visible = false;
      this.img_icon_rm.visible = true;
      break;
    default:
      return;
    }
    this.lbl_rm_val.setText(::formatNumberString(price));
  }

  function actionevent_shorten(e) {
    this.ret = 1;
    close();
    if (this.func) this.func(this.ret);
  }

  function close() {
    super.close();
    if (this.intr) {
      clearInterval(this.intr);
      this.intr = null;
    }
  }
}

