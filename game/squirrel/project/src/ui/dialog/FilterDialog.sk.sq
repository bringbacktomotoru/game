class ShopFilterDialog extends ::Dialog {
  filter_table = null;
  num_list = null;
  dual_switch = null;
  triple_switch = null;
  multi_switch = null;

  constructor(filter_type, table, type_list, number_list) {
    super(::loadSKView("/ui/dialog/FilterDialog.ui"));
    this.filter_table = table;
    this.num_list = number_list;

    local _select_list = [];
    _select_list[0] <- this.filter_table["room"];
    _select_list[1] <- this.filter_table["has"];
    _select_list[2] <- this.filter_table["select"];

    local _lbl_list = [::dict.get("filter_all"), ::dict.get("filter_room_this")];
    this.dual_switch = MultiSwitch(this.view.findChild("pnl_dual"), ::dict.get("filter_desc_room"), _lbl_list, _select_list[0]);

    _lbl_list = [::dict.get("filter_all"), ::dict.get("filter_had"), ::dict.get("filter_no_had")];
    this.triple_switch = MultiSwitch(this.view.findChild("pnl_triple"), ::dict.get("filter_desc_has"), _lbl_list, _select_list[1]);

    _lbl_list = type_list;
    local _pnl_lbl;
    local _pnl;
    switch (filter_type) {
    case SHOP_ITEM_TYPE_FURNITURE:
      this.view.findChild("lbl_title").setText(::dict.get("furniture"));
      _pnl_lbl = ::dict.get("category");
      break;
    case SHOP_ITEM_TYPE_COSTUME:
      this.view.findChild("lbl_title").setText(::dict.get("costume"));
      _pnl_lbl = ::dict.get("roomslot_maxcharas");
      break;
    case SHOP_ITEM_TYPE_MOTION:
      this.view.findChild("lbl_title").setText(::dict.get("motion"));
      _pnl_lbl = ::dict.get("roomslot_maxcharas");
      break;
    }
    _pnl = this.view.findChild("pnl_multi");
    this.multi_switch = MultiSwitch(_pnl, _pnl_lbl, _lbl_list, _select_list[2]);

  }

  function actionevent(e) {
    e.consume();

    switch (e.src) {
    case this.btn_ok:
      this.filter_table["room"] <- this.dual_switch.getResult();
      this.filter_table["has"] <- this.triple_switch.getResult();
      this.filter_table["select"] <- this.multi_switch.getResult();
      this.filter_table["select_number"] <- num_list[this.multi_switch.getResult()];
      break;
    }
    super.actionevent(e);
  }

}

class PropattyFilterDialog extends ::Dialog {
  filter_table = null;
  num_list = null;
  dual_switch = null;
  triple_switch = null;
  multi_switch = null;
  l_select_list = [0, 0, 0];

  constructor(select_list, type_list, number_list) {
    super(::loadSKView("/ui/dialog/FilterDialog.ui"));
    this.view.findChild("lbl_title").setText(::dict.get("furniture"));
    this.num_list = number_list;
    this.l_select_list[0] = select_list[0];
    this.l_select_list[1] = select_list[1];
    this.l_select_list[2] = select_list[2];

    local _lbl_list = [::dict.get("filter_all"), ::dict.get("filter_installation")];
    local _pnl_lbl = ::dict.get("filter_desc_room");
    local _pnl = this.view.findChild("pnl_dual");
    this.dual_switch = MultiSwitch(_pnl, _pnl_lbl, _lbl_list, l_select_list[0]);

    _pnl = this.view.findChild("pnl_triple");
    _pnl.visible = false;

    _lbl_list = type_list;
    _pnl_lbl = ::dict.get("category");
    _pnl = this.view.findChild("pnl_multi");
    this.multi_switch = MultiSwitch(_pnl, _pnl_lbl, _lbl_list, l_select_list[1]);

  }

  function actionevent(e) {
    e.consume();

    switch (e.src) {
    case this.btn_ok:
      l_select_list[0] = this.dual_switch.getResult();
      l_select_list[1] = this.multi_switch.getResult();
      l_select_list[2] = num_list[this.multi_switch.getResult()];
      break;
    }
    super.actionevent(e);
  }

}

class MultiSwitch {
  switch_controller = null;
  btn_array = null;

  constructor(pnl, pnl_lbl, lbl_list, select) {
    pnl.findChild("lbl_desc").setText(pnl_lbl);
    this.switch_controller = ::CheckBoxController(::CheckBoxController.TYPE_ONLY);
    this.btn_array = [];

    local _len = lbl_list.len();
    local _i = 0;

    while (true) {
      local _btn = pnl.findChild("btn" + _i);
      if (!_btn) break;
      if (_i < _len) {
        this.btn_array + _btn.findChild("btn_ng");
        _btn.findChild("lbl").setText(lbl_list[_i]);
        this.switch_controller.addCheckBoxButton(this.btn_array[_i], _btn.findChild("btn"));
      }
      else {
        _btn.visible = false;
      }
      _i++;
    }

    this.switch_controller.checkButton(this.btn_array[select]);

  }

  function getResult() {
    local _checked = this.switch_controller.getCheckedButtonViews()[0];
    foreach (i, btn in this.btn_array) {
      if (_checked == btn) return i;
    }
  }
}