import SKViewPropertyID;

class Message
{
  static DEFAULT_WORDS = 18;
  static DEFAULT_MSEC = 2000;

  view = null;
  lbl_text = null;
  msec = 0;
  message_length = 0;

  sound = "ui/confirm.wav";

  constructor() {
    this.view = ::loadSKView("/ui/dialog/Message_s.ui");
    this.lbl_text = this.view.findChild("lbl_text");

    this.msec = DEFAULT_MSEC;
    this.message_length = DEFAULT_WORDS;
  }

  function setMsec(ms) {
    this.msec = ms;
  }

  function setText(t) {
    this.message_length = t.len();
    this.lbl_text.setText(t);
  }

  function getTextLength() {
    return this.message_length * lbl_text.fontattr.size;
  }

  function getAdjustLength() {
    local _len = getTextLength();
    local _hw = this.view.bnd.w / 2.0;
    return _hw + (_hw - _len / 2.0);
  }

  function setColor(color) {
    lbl_text.fontattr.color = color;
  }

  function stroke() {
    lbl_text.fontattr.strokecolor = 255;
    lbl_text.fontattr.strokex = 2;
  }

  function setFontSize(s) {
    lbl_text.fontattr.size = s;
  }

  function setPosition(x, y, z = 0.0) {

    local _layer = ::gamesession.messagelayer;

    local _text = lbl_text.textbox.getText();
    local _size = lbl_text.textbox.strwidth(0, _text.len());

    local _met = lbl_text.fontattr.getFontMetrics();
    _size = _met.w;

    local _bnd = lbl_text.fontattr.getTextBounds(_text, _text);
    local _len = _bnd.w;
    local _pos1 = []; lbl_text.textbox.getCharPos(0, _pos1);
    local _pos2 = []; lbl_text.textbox.getCharPos(_text.len(), _pos2);
    local _size_y = Math.abs(_pos2[1] - _pos1[1]) + _met.h;

    view.bnd.set(-_len / 2.0 - _met.advance / 2.0, -_size_y / 2.0 - _met.advance / 2.0, _len, _size_y);
    view.updateLayout();

    lbl_text.textbox.setRect(0, 0, _len, _size_y);

    local _min_x = _len / 2.0;
    local _max_x = _layer.bnd.w - _len / 2.0;
    local _min_y = _size_y / 2.0;
    local _max_y = _layer.bnd.h - _size_y / 2.0;

    x = x < _min_x ? _min_x : x > _max_x ? _max_x : x;
    y = y < _min_y ? _min_y : y > _max_y ? _max_y : y;

    this.view.pos.set(x, y, z);
  }

  function show() {
    local _t = newthread();
    _t.start(
    function() {
      ::playSound(sound);
      _scaleup();
      sleep(this.msec);
      close();
    },
    this);

  }

  function _scaleup() {
    local layer = ::gamesession.messagelayer;
    layer.showMessage(this);

  }

  function close() {

    local layer = ::gamesession.messagelayer;
    layer.closeMessage(this);
  }

}