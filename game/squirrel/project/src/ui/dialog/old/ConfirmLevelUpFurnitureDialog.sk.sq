class ConfirmLevelUpFurnitureDialog extends ::Dialog {
  iteminfo = null;
  model = null;
  data = null;

  gauge_health = null;
  gauge_time = null;

  enable_type = null;
  static LEVELUP_ENABLE = 1;
  static LEVELUP_FAIL_GM = -1;
  static LEVELUP_FAIL_EXP = -2;
  static LEVELUP_FAIL_GMEXP = -3;

  view = null;
  lbl_name = null;
  lbl_lvchange = null;
  lbl_health = null;
  lbl_time = null;
  lbl_lvup_time = null;
  lbl_lvup_price = null;
  img_ok = null;
  img_ng = null;

  constructor(furniture_data) {
    super(::loadSKView("/ui/dialog/ConfirmLevelupFurnitureDialog.ui"));

    this.lbl_name = this.view.findChild("lbl_name");
    this.lbl_health = this.view.findChild("lbl_health");
    this.lbl_time = this.view.findChild("lbl_time");

    local _btn_ok = this.view.findChild("btn_ok");
    this.img_ok = _btn_ok.findChild("img_ok");
    this.img_ng = _btn_ok.findChild("img_ng");
    this.lbl_lvup_time = this.view.findChild("lbl_lvup_time");
    this.lbl_lvup_price = _btn_ok.findChild("lbl_lvup_price");

    this.gauge_health = ::GrowingValueGauge2Line(this.view.findChild("pnl_bar_health"));
    this.gauge_time = ::GrowingValueGauge2Line(this.view.findChild("pnl_bar_time"));

    this.view.findChild("lbl_text").setText(::dict.get("confirm_lvup_furniture"));
    this.view.findChild("lbl_deliver").setText(::dict.get("need_time"));
    local _pnl_status = this.view.findChild("pnl_status");
    _pnl_status.findChild("txt_health").setText(::dict.get("recover_health"));
    _pnl_status.findChild("txt_time").setText(::dict.get("product_time"));
    _btn_ok.findChild("lbl_ok").setText(::dict.get("levelup"));
    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("cancel"));

    this.data = furniture_data;

    this.enable_type = 0;

    _setData();

  }

  function _setData() {
    local furni_setting = ::gamesetting.furniture_settings[this.data.getID()];
    local product_setting = ::gamesetting.furniture_item_production_settings[furni_setting.production_id];
    local series_setting = furni_setting.getSeriesSetting();

    this.lbl_name.setText(this.data.getCurrentName());

    local lv_now = data.getLevel();
    local _pnl_lvup = this.view.findChild("pnl_levelup");
    local _pnl_now = _pnl_lvup.findChild("pnl_furniture");
    local _pnl_next = _pnl_lvup.findChild("pnl_furniture_next");
    _pnl_now.findChild("lbl_level").setText(::dict.get("nums_level", [lv_now]));
    _pnl_next.findChild("lbl_level").setText(::dict.get("nums_level", [lv_now + 1]));

    local _pnl_icon_now = _pnl_now.findChild("pnl_icon");
    local _icon_now = SKImageView();
    _icon_now.setSprite(furni_setting.getIconSpriteByLevel(lv_now));
    _icon_now.setRect(0, 0, _pnl_icon_now.bnd.w, _pnl_icon_now.bnd.h);
    _pnl_icon_now.addChild(_icon_now);

    local _pnl_icon_next = _pnl_next.findChild("pnl_icon");
    local _icon_next = SKImageView();
    _icon_next.setSprite(furni_setting.getIconSpriteByLevel(lv_now + 1));
    _icon_next.setRect(0, 0, _pnl_icon_next.bnd.w, _pnl_icon_next.bnd.h);
    _pnl_icon_next.addChild(_icon_next);

    local _pnl_seriesicon = this.view.findChild("pnl_seriesicon");
    local _icon_series = SKImageView();
    _icon_series.setSprite(series_setting.getIconSprite());
    _icon_series.setRect(0, 0, _pnl_seriesicon.bnd.w, _pnl_seriesicon.bnd.h);
    _pnl_seriesicon.addChild(_icon_series);

    local product_now = product_setting.getProductByLevel(lv_now);
    local product_next = product_setting.getProductByLevel(lv_now + 1);
    local product_max = product_setting.getMaxProduct();

    this.gauge_health.init(product_now.health, product_max.health, product_next.health);
    local glow_health = product_next.health - product_now.health;
    if (glow_health > 0) {
      this.lbl_health.setText(::dict.get("nums_plus2", [product_now.health, glow_health]))
    } else {
      this.lbl_health.setText(string(product_now.health));
    }

    this.gauge_time.init(product_now.time, product_max.time, product_next.time);
    local glow_time = product_next.time - product_now.time;
    local now_txt = ::getTimeText(product_now.time);
    if (glow_time > 0) {
      local glow_txt = ::getTimeText(glow_time);
      this.lbl_time.setText(::dict.get("nums_plus2", [now_txt, glow_txt]));
    } else {
      this.lbl_time.setText(now_txt);
    }

    local lvup_time_txt = ::getTimeText(data.getNextLevelTime());
    this.lbl_lvup_time.setText(lvup_time_txt);
    this.lbl_lvup_price.setText(::formatNumberString(data.getNextLevelGM()));

    _checkEnableLevelup();
  }

  function _checkEnableLevelup() {
    if (this.data.getNextLevelGM() > ::gamesession.getUserData().getGameMoney()) this.enable_type = LEVELUP_FAIL_GM;
    if (!this.data.isEnableLevelUp()) this.enable_type = this.enable_type == LEVELUP_FAIL_GM ? LEVELUP_FAIL_GMEXP : LEVELUP_FAIL_EXP;

    if (this.enable_type >= 0) this.enable_type = LEVELUP_ENABLE;

    local is_disable = enable_type < 0 ? true : false;
    if (is_disable) {
      this.img_ok.visible = false;
      this.img_ng.visible = true;
    }
    else {
      this.img_ok.visible = true;
      this.img_ng.visible = false;
    }
  }

  function actionevent(e) {
    e.consume();
    if (this.enable_type > 0) {
      super.actionevent(e);
      return;
    }

    switch (e.src) {
    case btn_ok:

      local dlg = ::SimpleDialog();
      dlg.lbl_msg.textbox.wrapmode = 1;
      switch (this.enable_type) {
      case LEVELUP_FAIL_GM:
        dlg.lbl_msg.setText(::dict.get("levelup_fail_gm"));
        break;
      case LEVELUP_FAIL_EXP:
        dlg.lbl_msg.setText(::dict.get("levelup_fail_exp"));
        break;
      case LEVELUP_FAIL_GMEXP:
        dlg.lbl_msg.setText(::dict.get("levelup_fail_gmexp"));
        break;
      }
      dlg.show();

      break;
    case btn_cancel:
    case btn_close:
      ret = 0;
      close();
      break;
    }

  }

}