class ConfirmCaptureDialog extends ::Dialog {
  sprite_capture = null;
  save_path = null;

  view = null;
  lbl_title = null;
  lbl_name = null;
  btn_share = null;
  btn_save = null;
  pnl_capture_back = null;
  pnl_capture_front = null;

  capture_visibleswitch = true;

  constructor() {
    super(::loadSKView("/ui/dialog/ConfirmCaptureDialog.ui"));

    this.lbl_title = this.view.findChild("lbl_title");
    this.lbl_name = this.view.findChild("lbl_name");

    this.btn_share = this.view.findChild("btn_share");
    ::TapButton(this.btn_share).view.addEventListener(ACTION_EVENT, actionevent_share);

    this.btn_save = this.view.findChild("btn_save");
    ::TapButton(this.btn_save).view.addEventListener(ACTION_EVENT, actionevent_save);

    this.pnl_capture_back = this.view.findChild("pnl_capture_back");

    this.pnl_capture_front = this.view.findChild("pnl_capture_front");

    this.btn_share.findChild("lbl_share").setText(::dict.get("share_image"));
    this.btn_save.findChild("lbl_save").setText(::dict.get("save_image"));
    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("close"));
  }

  function setCapture(sp, mid) {
    local _padding_s = 30;
    local _padding_l = 80;
    this.sprite_capture = sp;
    local _spbnd = clone sp.bnd;
    local _img = SKImageView();
    _img.setSprite(sp);

    local _h = int(float(this.pnl_capture_back.bnd.w * sp.bnd.h) / sp.bnd.w);

    this.pnl_capture_back.bnd.h = _h;
    this.pnl_capture_back.bnd.y = -_h / 2;

    local _frame_path = "/ui/image/bg/picture_frame.png";
    local _frame = SKImageView(::getSprite(_frame_path));
    _frame.setRect(0, 0, this.pnl_capture_back.bnd.w, this.pnl_capture_back.bnd.h);
    this.pnl_capture_back.addChild(_frame);

    _img.setRect(0, 0, this.pnl_capture_back.bnd.w - _padding_s, this.pnl_capture_back.bnd.h - _padding_s);
    _img.centerize();
    _img.pos.x = this.pnl_capture_back.bnd.w / 2.0;
    _img.pos.y = this.pnl_capture_back.bnd.h / 2.0;
    this.pnl_capture_back.addChild(_img);
    ::TapButton(this.pnl_capture_back).view.addEventListener(ACTION_EVENT, event_tap);

    if (mid > 0) {
      this.lbl_title.setText(::dict.get("captured_newpoze"));
      local _setting = ::gamesetting.costume_motion_settings[mid];
      this.lbl_name.setText(::dict.get("naminami", [_setting.getDesc()]));
    } else {
      this.lbl_title.setText(::dict.get("captured_usefurniture"));
      this.lbl_name.setVisible(false);
    }

    this.pnl_capture_front.setRect(0, 0, _spbnd.w, _spbnd.h);
    this.pnl_capture_front.pos.y = (this.view.bnd.h - this.pnl_capture_front.bnd.h) / 2.0;
    local _frame = SKImageView(::getSprite(_frame_path));
    _frame.setRect(0, 0, this.pnl_capture_front.bnd.w, this.pnl_capture_front.bnd.h);
    this.pnl_capture_front.addChild(_frame);

    _img = SKImageView();
    _img.setSprite(clone sp);
    _img.setRect(0, 0, this.pnl_capture_front.bnd.w - _padding_l, this.pnl_capture_front.bnd.h - _padding_l);
    _img.centerize();
    _img.pos.x = this.pnl_capture_front.bnd.w / 2.0;
    _img.pos.y = this.pnl_capture_front.bnd.h / 2.0;
    this.pnl_capture_front.addChild(_img);
    this.pnl_capture_front.addEventListener(MOUSE_EVENT, event_tap);
  }

  function event_tap(e) {
    switch (e.id) {
    case MOUSE_RELEASED:
    case ACTION_PERFORMED:
      capture_visibleswitch = !capture_visibleswitch;
      this.pnl_capture_front.visible = capture_visibleswitch;
      break;
    }
  }

  function actionevent_share(e) {
    e.consume();

    local _ret = _saveImage();
    local _osname = skGetOSName();
    if (!_osname.equals("Android")) {
      close();
      return;
    }
    if (_ret) {
      local _external_str = replaceNewLine(::dict.get("external_text_picture"));
      ARUtils.startExternalIntent(this.save_path, _external_str);
    }
    close();
  }
  function actionevent_save(e) {
    e.consume();

    local _ret = _saveImage();
    close();
  }

  function _saveImage() {
    local home_ui = ::gamesession.getCurrentScene().getUI();

    local buf = ::makeFilename("jpg");
    local _filepath = ::FilePathManager.getFilePath(::FilePathManager.FILE_TYPE_IMAGE, ::FilePathManager.APPLICATION_MODE_GAME);

    this.save_path = _filepath + buf;

    local ret = home_ui.saveImage(this.sprite_capture, this.save_path, ::displayWidth, ::displayHeight);
    return ret;
  }
  function _shareImage() {
  }
}