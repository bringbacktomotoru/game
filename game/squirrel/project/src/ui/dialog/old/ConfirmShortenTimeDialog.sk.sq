class ConfirmShortenTimeDialog extends ::Dialog {
  need_moneylayer = true;

  remain = null;
  price = null;

  view = null;
  lbl_title = null;
  lbl_attention = null;
  lbl_itemname = null;
  lbl_time = null;
  lbl_price_rm = null;
  lbl_now_rm = null;
  lbl_new_rm = null;

  btn_interrupted = null;

  img_itemname_line = null;

  constructor() {
    super(::loadSKView("/ui/dialog/TimecutDialog.ui"));

    lbl_title = this.view.findChild("lbl_title");

    lbl_attention = this.view.findChild("lbl_attention");
    lbl_attention.visible = false;
    lbl_attention.matdirty = true;
    lbl_attention.repaint();

    local _pnl_name = this.view.findChild("pnl_itemname");
    lbl_itemname = this.view.findChild("lbl_name");
    img_itemname_line = this.view.findChild("img_line");

    local _pnl_info = this.view.findChild("pnl_info");
    lbl_time = _pnl_info.findChild("lbl_time");
    lbl_price_rm = _pnl_info.findChild("lbl_rm");

    local _pnl_money = this.view.findChild("pnl_havemoney");
    lbl_now_rm = _pnl_money.findChild("lbl_havemoney");
    lbl_new_rm = _pnl_money.findChild("lbl_newmoney");

    this.btn_interrupted = this.view.findChild("btn_interrupted");
    ::TapButton(this.btn_interrupted).view.addEventListener(ACTION_EVENT, actionevent);
  }

  function setProductData(pd) {
    local fd = ::gamesession.getUserData().getFurnitureData(pd.getProducerID());

    local _itemname = fd.getCurrentName();
    this.lbl_itemname.setText(_itemname);
    _updateUnderLineAtName(_itemname);

    this.remain = pd.getFinishTime() - ::getServerTime();
    local timer = TimeLabel(this.lbl_time, this.remain);
    timer.startCountDown();

    this.price = _calcShortenPriceProduct();
    _setRMInfo();
  }

  function setWorkData(wd) {
    local setting = wd.getSetting();

    local _itemname = setting.getName();
    this.lbl_itemname.setText(_itemname);
    _updateUnderLineAtName(_itemname);

    this.remain = wd.getRemainingTime(::getServerTime());
    local timer = TimeLabel(this.lbl_time, this.remain);
    timer.startCountDown();

    this.price = _calcShortenPriceProduct();
    _setRMInfo();
  }

  function _setRMInfo() {
    this.lbl_price_rm.setText(::dict.get("nums_kakeru", [this.price]));

    local _rm = ::gamesession.getUserData().getTotalRealMoney();
    this.lbl_now_rm.setText(_rm);
    this.lbl_new_rm.setText(_rm - this.price)

    if (this.price > _rm) this.btn_ok.setEnabled(false);
  }

  function _updateUnderLineAtName(text) {
    local _fontsize = this.lbl_itemname.getParam(SKViewPropertyID.FONT).fontsize;
    local _x = this.lbl_itemname.pos.x + this.lbl_itemname.bnd.w / 2;
    local _w = text.len() * _fontsize * 1.4;

    img_itemname_line.setRect(_x - _w / 2, img_itemname_line.pos.y, _w, img_itemname_line.bnd.h);
    img_itemname_line.matdirty = true;
    img_itemname_line.repaint();
  }

  function _calcShortenPriceProduct() {
    local price = remain / 180 + 1;
    return price;
  }
  function _calcShortenPriceWork() {
    local price = remain / 180 + 1;
    return price;
  }

  function actionevent(e) {
    switch (e.src) {
    case btn_ok: ret = 1; close(); break;
    case btn_interrupted: ret = 2; close(); break;
    case btn_cancel:
    case btn_close: ret = 0; close(); break;
    }

    if (func) func(ret);
  }
}

class ConfirmProductShortenTimeDialog extends ::Dialog {
  need_moneylayer = true;

  data = null;
  gauge_remain = null;
  time_label = null;

  can_shorten = null;

  lbl_title = null;
  lbl_name = null;
  lbl_lv = null;
  lbl_nokori = null;
  lbl_detail = null;
  lbl_price = null;
  lbl_interrupt = null;
  img_icon = null;
  pnl_product = null;
  pnl_lvup = null;
  pnl_deliver = null;
  btn_item = null;
  btn_detail = null;
  btn_shorten = null;
  img_shorten = null;
  img_shorten_ng = null;
  btn_interrupt = null;

  constructor() {
    super(::loadSKView("/ui/dialog/ConfirmShortenTimeDialog.ui"));

    local _pnl = this.view.findChild("pnl_mouseevent");
    _pnl.addEventListener(MOUSE_EVENT, mouseevent);

    this.lbl_title = this.view.findChild("lbl_title");
    this.lbl_name = this.view.findChild("lbl_name");
    this.lbl_lv = this.view.findChild("lbl_lv");
    this.lbl_nokori = this.view.findChild("lbl_nokori");
    this.lbl_detail = this.view.findChild("lbl_detail");
    this.img_icon = this.view.findChild("img_icon");

    this.gauge_remain = ::ValueGauge(this.view.findChild("gauge_remain"));
    this.time_label = ::TimeLabel(this.view.findChild("lbl_remain"), 0);
    this.lbl_nokori.setText(::dict.get("remain"));
    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("close"));

    this.pnl_product = this.view.findChild("pnl_product");
    this.pnl_lvup = this.view.findChild("pnl_lvup");
    this.pnl_deliver = this.view.findChild("pnl_deliver");

    this.btn_item = this.view.findChild("btn_item");
    ::TapButton(this.btn_item).view.addEventListener(ACTION_EVENT, actionevent_item);
    this.btn_detail = this.view.findChild("btn_detail");
    ::TapButton(this.btn_detail).view.addEventListener(ACTION_EVENT, actionevent_detail);

    this.btn_shorten = this.view.findChild("btn_shorten");
    this.img_shorten = this.btn_shorten.findChild("img_shorten");
    this.img_shorten_ng = this.btn_shorten.findChild("img_shorten_ng");

    local _btn = ::TapButton(this.btn_shorten);
    _btn.view.addEventListener(ACTION_EVENT, actionevent);
    _btn.setTappedSE(SoundConstants.SOUND_DECIDE);
    this.btn_shorten.findChild("lbl_shorten").setText(::dict.get("shorten"));
    this.btn_interrupt = this.view.findChild("btn_interrupt");
    ::TapButton(this.btn_interrupt).view.addEventListener(ACTION_EVENT, actionevent);

    this.lbl_interrupt = this.btn_interrupt.findChild("lbl_interrupt");

    this.lbl_price = this.btn_shorten.findChild("lbl_price");

    this.can_shorten = false;
  }

  function setData(fd) {
    this.data = fd;

    this.lbl_name.setText(this.data.getCurrentName());
    this.lbl_lv.setText(::dict.get("nums_level", [this.data.getLevel()]));

    local ss = this.data.getSetting().getSeriesSetting();
    this.img_icon.setSprite(ss.getIconSprite());
    this.img_icon.updateLayout();

    local pd = this.data.getProductData();

    local remain = pd.getRemainTime(::getServerTime());
    this.time_label.setRemainTime(remain);
    _updateRemainGauge();
    this.time_label.setRepeatFunc(_updateRemainGauge.bindenv(this), 1000);
    this.time_label.setEndFunc(_endRemain.bindenv(this));
    this.time_label.startCountDown();

    local price = ::gamesetting.game_rule.calcShortenRMProduct(remain);
    this.lbl_price.setText(price);
    if (::gamesession.getUserData().getTotalRealMoney() >= price) {
      this.can_shorten = true;
      this.img_shorten.visible = true;
      this.img_shorten_ng.visible = false;
    } else {
      this.can_shorten = false;
      this.img_shorten.visible = false;
      this.img_shorten_ng.visible = true;
    }

    switch (pd.getType()) {
    case ::ProductData.TYPE_PRODUCT:
      _setPanelProduct();
      this.view.startMethod("setProductView");
      break;
    case ::ProductData.TYPE_LEVELUP:
      _setPanelLevelup();
      this.view.startMethod("setLevelupView");
      break;
    case ::ProductData.TYPE_DELIVER:
      _setPanelDeliver();
      this.view.startMethod("setDeliverView");
      break;
    }
  }

  function _updateRemainGauge() {
    local pd = this.data.getProductData();
    local time = pd.getProductTime();
    local remain = this.time_label.getRemainTime();
    this.gauge_remain.init(remain, time);

    local price = ::gamesetting.game_rule.calcShortenRMProduct(remain);
    this.lbl_price.setText(price);
    if (::gamesession.getUserData().getTotalRealMoney() >= price) {
      this.can_shorten = true;
      this.img_shorten.visible = true;
      this.img_shorten_ng.visible = false;
    }
    else {
      this.can_shorten = false;
      this.img_shorten.visible = false;
      this.img_shorten_ng.visible = true;
    }
  }

  function _endRemain() {
    this.ret = 0;
    close();
  }

  function setTitle(txt) {
    this.lbl_title.setText(txt);
  }

  function _setPanelProduct() {

    this.lbl_title.setText(::dict.get("confirm_shortentime_product"));
    this.lbl_detail.setText(::dict.get("recover_health"));
    this.lbl_interrupt.setText(::dict.get("product_interrupt"));

    local _health = this.pnl_product.findChild("lbl_health");
    local product = this.data.getProductReward();
    if (::DISABLE_TRIAL) {
      _health.setText(product.health);
    }
    else {
      local _ps = this.data.getSetting().getProductionSetting();
      local _max = _ps.getMaxRewardGM();
      local _min = _ps.getMinRewardGM();
      if (_max == _min) _health.setText(_max);
      else _health.setText(::dict.get("nums_range", [_min, _max]));
    }
  }
  function _setPanelLevelup() {
    local lv_val = this.data.getLevel();

    this.lbl_title.setText(::dict.get("confirm_shortentime_levelup"));
    this.lbl_detail.setText(::dict.get("detail_nextlevel"));
    this.lbl_interrupt.setText(::dict.get("product_interrupt_levelup"));

    local product_now = this.data.getProductReward();
    local product_new = this.data.getProductReward(lv_val + 1);
    local product_max = this.data.getProductReward(this.data.getMaxLevel());

    local diff_health = product_new.health - product_now.health;
    local _health_now = this.pnl_lvup.findChild("lbl_health");
    local _health_add = this.pnl_lvup.findChild("lbl_health_add");
    _health_now.setText(product_now.health);
    _health_add.setText(::dict.get("nums_plus", [diff_health]));
    local gauge_health = ::GrowingValueGauge2Line(this.pnl_lvup.findChild("gauge_health"));
    gauge_health.init(product_now.health, product_max.health, product_new.health);

    local diff_time = product_new.time - product_now.time;
    local _time_now = this.pnl_lvup.findChild("lbl_time");
    local _time_add = this.pnl_lvup.findChild("lbl_time_add");
    _time_now.setText(::getTimeText(product_now.time, 2));
    _time_add.setText(::dict.get("nums_plus", [::getTimeText(diff_time, 2)]));
    local gauge_time = ::GrowingValueGauge2Line(this.pnl_lvup.findChild("gauge_time"));
    gauge_time.init(product_now.time, product_max.time, product_new.time);

  }
  function _setPanelDeliver() {

    this.lbl_title.setText(::dict.get("confirm_shortentime_deliver"));
  }

  function actionevent(e) {
    e.consume();
    local dlg;

    switch (e.src) {
    case btn_shorten:
      if (!this.can_shorten) {
        dlg = ::SimpleDialog();
        dlg.lbl_msg.setText(::dict.get("lack_rm"));
        dlg.show();
        return;
      }

      ret = 1;
      close();
      break;
    case btn_interrupt:
      ret = 2;
      close();
      break;
    case btn_cancel:
    case btn_close:
      ret = 0;
      close();
      break;
    }

    if (func) func(ret);
  }

  function actionevent_item(e) {
    e.consume();
  }

  function actionevent_detail(e) {
    e.consume();

    local dlg = ::FurnitureInfoDialog();
    dlg.setFurnitureData(this.data, ::FurnitureInfoDialog.MODE_DETAIL);
    dlg.show();
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_RELEASED:
      close();
      break;
    }
  }
}