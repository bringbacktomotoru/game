class RoomShopDetailDialog extends ::Dialog {

  level_param_cmp = null;
  price_cmp = null;

  view_scene = null;

  lbl_name = null;
  pnl_view = null;
  lbl_no_image = null;
  lbl_description = null;

  constructor() {
    super(::loadSKView("/ui/dialog/RoomShopDetailDialog.ui"), false);

    this.level_param_cmp = LevelParametersComponent(this.view.findChild("pnl_parameter"));
    this.price_cmp = PriceComponent(this.view.findChild("pnl_price"));

    this.lbl_name = this.view.findChild("lbl_name");
    this.pnl_view = this.view.findChild("pnl_view");
    this.lbl_no_image = this.pnl_view.findChild("lbl_no_image");
    this.lbl_description = this.view.findChild("lbl_description");

    local game_scene = ::gamesession.getCurrentScene();
    local stage_id = game_scene.getStageID();

    this.view_scene = ::ModelViewScene();
    this.pnl_view.addChild(this.view_scene.sk3dview);
    this.view_scene.viewAdded();

    this.view_scene.setNextStageID(stage_id);
    this.view_scene.loadStageScene(false);
    this.view_scene.startStageScene();
    this.view_scene.showStageScene();

    this.view.findChild("pnl_dialog").findChild("pnl_slide").findChild("lbl_slide").setText(::dict.get("rewarddialog_slide_desc"));
  }

  function setup(shop_setting_id) {
    release();

    local shop_setting = ::gamesetting.shop_settings[shop_setting_id];
    local room_setting = ::gamesetting.room_settings[shop_setting.item_id];
    this.level_param_cmp.setup(room_setting, 1);
    this.price_cmp.setup(shop_setting);

    this.lbl_name.setText(room_setting.getName());
    this.lbl_description.setText(room_setting.getDesc());

    _setupView(room_setting);
  }

  function _setupView(room_setting) {
    this.view_scene.changeRoom(room_setting.id);
    this.view_scene.cameraUpdated();
    this.view_scene.updateScene(0);
  }

  function release() {
    this.level_param_cmp.release();
    this.price_cmp.release();
  }
}

class RoomShopDetailDialog.LevelParametersComponent {
  curr_level = -1;
  room_setting = null;

  chara_bar = null;
  furniture_bar = null;
  rarity_bar = null;
  work_bar = null;

  lbl_level = null;
  img_previous = null;
  img_next = null;

  constructor(view) {
    this.lbl_level = view.findChild("lbl_level");

    this.chara_bar = ::ValueGauge(view.findChild("pnl_chara_bar"));
    this.furniture_bar = ::ValueGauge(view.findChild("pnl_furniture_bar"));
    this.rarity_bar = ::ValueGauge(view.findChild("pnl_rarity_bar"));
    this.work_bar = ::ValueGauge(view.findChild("pnl_work_bar"));

    this.img_previous = view.findChild("img_previous");
    ::TapButton(this.img_previous).view.addEventListener(ACTION_EVENT, actionevent_prev);
    this.img_next = view.findChild("img_next");
    ::TapButton(this.img_next).view.addEventListener(ACTION_EVENT, actionevent_next);

    release();
  }

  function setup(room_setting, room_level) {
    this.room_setting = room_setting;

    local max_params = room_setting.getMaxParameters();
    this.chara_bar.init(0, max_params["chara"]);
    this.furniture_bar.init(0, max_params["furniture"]);
    this.rarity_bar.init(0, max_params["rarity"]);
    this.work_bar.init(0, max_params["work"]);

    setupLevel(room_level);
  }

  function release() {
    this.curr_level = -1;

    this.lbl_level.setText("");
    this.chara_bar.init(0, 1);
    this.furniture_bar.init(0, 1);
    this.rarity_bar.init(0, 1);
    this.work_bar.init(0, 1);
  }

  function setupLevel(level) {
    if (level == 1) {
      this.img_previous.setEnabled(false);
    }
    else {
      this.img_previous.setEnabled(true);
    }

    local max_level = this.room_setting.getMaxLevel();
    if (level == max_level) {
      this.img_next.setEnabled(false);
    }
    else {
      this.img_next.setEnabled(true);
    }

    this.curr_level = Math.clamp(level, 1, max_level);

    local params = this.room_setting.getParameters(this.curr_level);
    if (!params) {
      release();
      return;
    }

    this.lbl_level.setText(::dict.get("nums_level", [this.curr_level]));
    this.chara_bar.setCurrentValue(params["chara"]);
    this.furniture_bar.setCurrentValue(params["furniture"]);
    this.rarity_bar.setCurrentValue(params["rarity"]);
    this.work_bar.setCurrentValue(params["work"]);
  }

  function actionevent_prev(e) {
    e.consume();
    setupLevel(this.curr_level - 1);
  }

  function actionevent_next(e) {
    e.consume();
    setupLevel(this.curr_level + 1);
  }
}

class RoomShopDetailDialog.PriceComponent {
  img_rm = null;
  img_gm = null;
  lbl_price = null;

  constructor(view) {
    this.img_rm = view.findChild("img_rm");
    this.img_gm = view.findChild("img_gm");
    this.lbl_price = view.findChild("lbl_price");
  }

  function setup(shop_setting) {

    switch (shop_setting.getPriceType()) {
    case PRICE_GM:
      this.img_rm.setVisible(false);
      this.img_gm.setVisible(true);
      break;
    case PRICE_RM:
      this.img_rm.setVisible(true);
      this.img_gm.setVisible(false);
      break;
    case PRICE_ONEROUS_RM:
      this.img_rm.setVisible(true);
      this.img_gm.setVisible(false);
      break;
    }

    this.lbl_price.setVisible(true);
    this.lbl_price.setText(shop_setting.price);
  }

  function release() {
    this.img_rm.setVisible(false);
    this.img_gm.setVisible(false);
    this.lbl_price.setVisible(false);
  }
}