class CostumeInfoDialog extends ::Dialog {

  lbl_name = null;
  lbl_desc = null;
  pnl_rare_icon = null;
  pnl_chara_icon = null;
  pnl_chara = null;
  health_bar = null;
  exp_bar = null;
  collection_bar = null;

  costume_data = null;

  sk3dview = null;

  last_x = null;
  angle = 0;

  constructor() {
    super(::loadSKView("/ui/dialog/CostumeInfoDialog.ui"));

    this.lbl_name = this.view.findChild("lbl_name");
    this.lbl_desc = this.view.findChild("lbl_desc");
    this.pnl_rare_icon = this.view.findChild("pnl_rare_icon");
    this.pnl_chara_icon = this.view.findChild("pnl_chara_icon");
    this.pnl_chara = this.view.findChild("pnl_chara");
    this.pnl_chara.addEventListener(MOUSE_EVENT, mouseevent_viewer);

    this.view.findChild("pnl_slide").findChild("lbl_slide").setText(::dict.get("rewarddialog_slide_desc"));
    this.view.findChild("pnl_health").findChild("lbl_health_text").setText(::dict.get("levelup_health"));
    this.view.findChild("pnl_level").findChild("lbl_exp_text").setText(::dict.get("exp"));

    this.health_bar = HealthBar(this.view.findChild("pnl_health"));
    this.exp_bar = ExpBar(this.view.findChild("pnl_level"));
    this.collection_bar = CollectionBar(this.view.findChild("pnl_collection"));

    this.sk3dview = Chara3DView();
    this.sk3dview.setRect(0, 0, this.pnl_chara.bnd.w, this.pnl_chara.bnd.h);
    this.pnl_chara.addChild(this.sk3dview);

    local _pnl_collection = this.view.findChild("pnl_collection");
    _pnl_collection.findChild("lbl_collection").setText(::dict.get("collection_ratio"));

    this.angle = 0;

    local _pnl_mouse_event = this.view.findChild("pnl_mouse_event");
    _pnl_mouse_event.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function setCostumeData(cd) {
    this.costume_data = cd;

    local _cs = cd.getSetting();
    this.lbl_name.setText(_cs.getName());
    this.lbl_desc.setText(_cs.getDesc());

    this.pnl_rare_icon.clearChildren();
    local _icon_rare = SKImageView();
    _icon_rare.setSprite(::Setting.getRarityIconSprite(_cs.getGrade()));
    _icon_rare.setRect(0, 0, this.pnl_rare_icon.bnd.w, this.pnl_rare_icon.bnd.h);
    this.pnl_rare_icon.addChild(_icon_rare);

    this.health_bar.setData(cd);
    this.exp_bar.setData(cd);
    this.collection_bar.setData(cd);
    this.collection_bar.setVisible(false);

    this.pnl_chara_icon.clearChildren();
    local _icon_chara = SKImageView();
    _icon_chara.setSprite(::gamesetting.sanrio_chara_settings[_cs.getCharaID()].getIconSprite());
    _icon_chara.setRect(0, 0, this.pnl_chara_icon.bnd.w, this.pnl_chara_icon.bnd.h);
    this.pnl_chara_icon.addChild(_icon_chara);

    newthread().start(function() {
      sk3dview.setCostumeId(_cs.getID());
      sk3dview.build(true);
      suspend();
    }, this);

  }

  function showed() {
    this.lbl_desc.setText(this.costume_data.getSetting().getDesc());
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_RELEASED:
      close();
      break;
    }
  }

  function mouseevent_viewer(e) {
    e.consume();

    switch (e.id) {
    case MOUSE_PRESSED:
      this.last_x = e.x;
      break;
    case MOUSE_DRAGGED:
      local diff = e.x - this.last_x;
      this.angle -= diff;
      this.sk3dview.obj.setAngle(this.angle);
      this.last_x = e.x;
      break;
    }
  }

}

class CostumeInfoDialog.HealthBar {
  bar = null;
  lbl_health = null;
  costume_data = null;

  constructor(v) {
    this.lbl_health = v.findChild("lbl_health");
    this.bar = CostumeInfoDialog.Bar(v.findChild("img_bar"));
  }

  function setData(cd) {
    this.costume_data = cd;
    updateView();
  }

  function updateView() {
    local _health = this.costume_data.getHealth();
    local _max_health = this.costume_data.getMaxHealth();
    this.lbl_health.setText(::dict.get("nums_slash", [_health, _max_health]));
    this.bar.setMaxValue(_max_health);
    this.bar.setValue(_health);
  }
}

class CostumeInfoDialog.ExpBar {
  bar = null;
  lbl_exp = null;
  lbl_level = null;
  costume_data = null;

  constructor(v) {
    this.lbl_exp = v.findChild("lbl_exp");
    this.lbl_level = v.findChild("lbl_lv");
    this.bar = CostumeInfoDialog.Bar(v.findChild("img_bar"));
  }

  function setData(cd) {
    this.costume_data = cd;
    updateView();
  }

  function updateView() {
    local _exp = this.costume_data.getExp();
    local _max_exp = this.costume_data.getMaxExp();
    local _lv = this.costume_data.getLevel();
    local _ratio = this.costume_data.getExpRatio();
    this.lbl_exp.setText(::dict.get("nums_ratio", [int(_ratio * 100.0)]));
    this.lbl_level.setText(::dict.get("nums_level", [_lv]));
    this.bar.setMaxValue(_max_exp);
    this.bar.setValue(_exp);
  }
}

class CostumeInfoDialog.CollectionBar {
  view = null;
  bar = null;
  lbl_per = null;
  costume_data = null;

  constructor(v) {
    this.view = v;
    this.lbl_per = v.findChild("lbl_per");
    this.bar = CostumeInfoDialog.Bar(v.findChild("img_bar"));
  }

  function setData(cd) {
    this.costume_data = cd;
    updateView();
  }

  function updateView() {
    local _wrd = ::gamesession.getUserData().getWorkRewardData(this.costume_data.getID());
    local _per = 0;
    if (_wrd) _per = _wrd.getCostumeRewardRate();
    this.lbl_per.setText(::dict.get("nums_ratio", [int(_per * 100.0)]));
    this.bar.setRatio(_per);
  }

  function setVisible(b) {
    this.view.setVisible(b);
  }
}

class CostumeInfoDialog.Bar {
  img_bar = null;

  pos = null;
  max_width = 0;
  max_value = -1;

  constructor(bar) {
    this.img_bar = bar;
    this.max_width = float(bar.bnd.w);
    this.pos = { x = 0, y = 0 };
    this.pos.x = bar.pos.x - this.max_width / 2.0;
    this.pos.y = bar.pos.y - bar.bnd.h / 2.0;
  }

  function setMaxValue(v) {
    this.max_value = float(v);
  }

  function setValue(v) {
    if (this.max_value <= 0 || v <= 0) {
      this.img_bar.visible = false;
      return;
    }
    setRatio(float(v) / this.max_value);
  }

  function setRatio(r) {
    local _w = this.max_width * r;
    if (_w <= 0) {
      this.img_bar.visible = false;
    }
    else {
      this.img_bar.visible = true;
      if (_w < 20) _w = 20.0;
      if (_w > this.max_width) _w = this.max_width;

      this.img_bar.setRect(this.pos.x, this.pos.y, _w, this.img_bar.bnd.h);
    }
  }
}