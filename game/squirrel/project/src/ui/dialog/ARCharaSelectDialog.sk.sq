class ARCharaSelectDialog extends ::FlickDialog {
  sk3dview = null;

  current_index = -1;
  chara_list = null;

  lbl_message = null;

  constructor(cl) {
    super(::loadSKView("/ui/dialog/ARCharaSelectDialog.ui"), true, this);

    this.chara_list = cl;

    local _pnl_chara_view = this.view.findChild("pnl_chara_view");
    this.sk3dview = Chara3DView();
    this.sk3dview.setRect(0, 0, _pnl_chara_view.bnd.w, _pnl_chara_view.bnd.h);
    _pnl_chara_view.addChild(this.sk3dview);

    this.lbl_message = this.view.findChild("lbl_message");

    local _btn_r = this.view.findChild("btn_r");
    local _btn_l = this.view.findChild("btn_l");
    if (this.chara_list.len() < 2) {
      _btn_r.visible = false;
      _btn_l.visible = false;
    }
    else {
      ::TapButton(_btn_r).view.addEventListener(ACTION_EVENT, actionevent_r);
      ::TapButton(_btn_l).view.addEventListener(ACTION_EVENT, actionevent_l);
    }

    this.btn_cancel.findChild("lbl_cancel").setText(::dict.get("cancel"));
    this.btn_ok.findChild("lbl_ok").setText(::dict.get("decide"));
    this.view.findChild("lbl_title").setText(::dict.get("ar_move_panel"));

    _setCharaView(0);
  }

  function _setCharaView(idx) {

    if (idx < 0) idx = this.chara_list.len() - 1;
    else if (idx >= this.chara_list.len()) idx = 0;

    if (this.current_index == idx) return false;

    this.current_index = idx;
    _stopAllCharaVoice();

    local _cos_id = this.chara_list[this.current_index];
    this.sk3dview.setCostumeId(_cos_id);
    this.sk3dview.build(true);
    this.sk3dview.charaScript("first_chara_select");

    local _setting = ::gamesetting.costume_settings[_cos_id].getCharaSetting();
    local _msg_list = ::talk.get("move_ar_panel", _setting.getTalkKey())
    this.lbl_message.setText(_msg_list[0]);
    _setting.playVoice("move_ar_panel");
    return true;
  }

  function _stopAllCharaVoice() {
    foreach (cos_id in this.chara_list) {
      local _setting = ::gamesetting.costume_settings[cos_id].getCharaSetting();
      _setting.stopVoice();
    }
  }

  function close() {
    if (is_closing) return;
    this.is_closing = true;

    ::gamesession.messagelayer.closeAllMessage();

    _stopAllCharaVoice();

    local layer = ::gamesession.dialoglayer;
    local _stopper = SKView();
    _stopper.name = "stopper";
    _stopper.enabled = _stopper.pickable = true;
    _stopper.setRect(0, 0, layer.bnd.w, layer.bnd.h);
    layer.addChild(_stopper);

    for (local l = 0; l < 12; l++) {
      local w = Math.pow(l / 11.0, 0.5);
      local s = Math.lerp(1.0, 0.1, w);
      view.scale(s, s, s);
      view.matdirty = true;
      view.repaint();
      sleep(16);
    }

    layer.closeDialog(this);

    _closed();

    layer.removeChild(_stopper);
  }

  function getResult() {
    if (!this.ret) return -1;
    return this.chara_list[this.current_index];
  }

  function actionevent_r(e) {
    e.consume();
    _setCharaView(this.current_index + 1);
  }
  function actionevent_l(e) {
    e.consume();
    _setCharaView(this.current_index - 1);
  }
  function flickRight() {
    if (_setCharaView(this.current_index + 1)) {
      ::playSound(::SoundConstants.SOUND_BUTTON);
    }
  }

  function flickLeft() {
    if (_setCharaView(this.current_index - 1)) {
      ::playSound(::SoundConstants.SOUND_BUTTON);
    }
  }
}