with SKGroupView {
  local _setEnabled = setEnabled;
  function setEnabled(b) {
    _setEnabled(b);

    if (b) setEnableColor();
    else setDisableColor();
  }

  function setEnableColor() {
    foreach (child in children) {
      if (child instanceof SKImageView) {
        child.setColor(0xffffffff);
      }
    }

  }

  function setDisableColor(b = true) {
    foreach (child in children) {
      if (child instanceof SKImageView) {
        child.setColor(b ? COLOR_DISABLE : 0xffffffff);
      }
    }

  }
}