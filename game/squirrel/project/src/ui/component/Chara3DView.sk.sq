class Chara3DView extends SK3DView {
  built = false;
  chara_id = 1;
  costume_id = 0;
  current_script_name = null;

  obj = null;

  constructor() {
    super();

    obj = ::StageObject(this.scn);

    local cameraobj = SK3DObject();
    this.renderer.setCameraObject(cameraobj);
    this.renderer.cameraobj.pos.set(0.0, 1.4, -4.0);
    this.renderer.camera.perspective(30.0, 1, 1.0, 100.0);

    local env = SK3DEnvironment(::gamesetting.scnenv["morning"]);
    this.scn.setEnvironment(env);
    local renderset = ::createRenderSetting({ type = 101 });
    renderer.setRenderSetting(renderset);

    local _passes = renderer.passes;
    foreach (i, _ps in _passes) {
      if (!renderset.passes[i].clearparam) continue;
      _ps.clearparam.clearmask = 0;
      local _setting_param = renderset.passes[i].clearparam;
      if (_setting_param["color"]) _ps.clearparam.clearmask |= SK_CLEAR_COLOR;
      if (_setting_param["depth"]) _ps.clearparam.clearmask |= SK_CLEAR_DEPTH;
      if (_setting_param["stencil"]) _ps.clearparam.clearmask |= SK_CLEAR_STENCIL;
    }

  }

  function updateLayout() {

    local w = bnd.w, h = bnd.h;
    this.renderer.cameraobj.pos.set(0.0, 1.4, -5.0);
    this.renderer.camera.perspective(40.0, float(w) / h, 1.0, 100.0);
    this.renderer.cameraobj.update(0);
    repaint();
  }

  function setCameraPos(x, y, z) {
    this.renderer.cameraobj.pos.set(x, y, z);
    this.renderer.cameraobj.update(0);
    repaint();
  }

  function setCameraHPB(h, p, b) {

    local pi2 = Math.PI * 2;
    h = (h < 0.0 ? h + pi2 : h) % pi2;
    p = (p < 0.0 ? p + pi2 : p) % pi2;
    b = (b < 0.0 ? b + pi2 : b) % pi2;

    this.renderer.cameraobj.rot.setHPB(h, p, b);
    this.renderer.cameraobj.matdirty = true;
    this.renderer.cameraobj.update(0);
    repaint();
  }

  function setCharaId(id) {
    this.chara_id = id;
    this.costume_id = 0;
  }
  function setCostumeId(id) {
    this.costume_id = id;
    this.chara_id = ::gamesetting.costume_settings[id].getCharaID();
  }
  function resetCostumeId() {
    this.costume_id = 0;
    this.chara_id = -1;
  }

  function build(rebuild = false) {
    if (this.built && !rebuild) return;
    this.built = true;

    this.obj.removeFromStage();

    obj.sk3d = ::viewfactory.createUserCharaView(this.chara_id, this.costume_id, 5.0);

    obj.addToStage();

    this.renderer.cameraobj.update(0);
    repaint();

    charaScript("stand");
  }

  function charaScript(s, arg = null) {
    if (!s) return;
    this.current_script_name = s;
    if (arg) this.obj.sk3d.startScript(s, arg);
    else this.obj.sk3d.startScript(s);
  }

  function getCurrentScriptName() {
    return this.current_script_name;
  }

  function isScriptRunning() {
    return obj.sk3d.scprunner.running;
  }

  function charaRelease() {
    this.obj.removeFromStage();
  }

  function addObject(p) {
    if (!p) return null;
    local _obj = ::StageObject(this.scn);
    _obj.build(p);
    _obj.addToStage();
    return _obj;
  }

  function _generateLight(t) {
    if (!t) return null;
    local li = Light();
    local dir = t.dir;
    li.setDirLight(Vector3D(dir[0], dir[1], dir[2]));
    li.color = t["color"] || 0xffffffff;
    li.scolor = t["scolor"] || 0xffffffff;
    li.power = (t["power"] || 0.8) / 255.0;
    li.pixellight = t["pixellight"] || 0;
    return li;
  }

  function setMoveFuncLock(b) {
    if (!obj || !obj.sk3d) return;
    obj.sk3d.setMoveFuncLock(b);
  }
}