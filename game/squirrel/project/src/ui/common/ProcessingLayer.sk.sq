class ProcessingLayer extends SKView {
  static DEFAULT_DELAY_TIME = 200;
  view = null;

  start_time = null;
  delay_time = null;

  processing = null;
  process_thread = null;

  constructor(view) {
    this.view = view;
    this.view.pickable = false;
    this.view.setVisible(false);
    addChild(this.view);
    this.processing = false;
    this.delay_time = DEFAULT_DELAY_TIME;
  }

  function removed() {
    if (process_thread && isThreadRunning(process_thread)) process_thread.wakeupThrow("stop");
    process_thread = null;
    view = null;
    processing = null;
    start_time = null;
    delay_time = null;
  }

  function setRect(x, y, w, h, lx = 0.0, ly = 0.0) {
    super.setRect(x, y, w, h, lx, ly);
    if (this.bnd.h < this.view.bnd.h) {
      this.view.bnd.y -= (this.view.bnd.h - this.bnd.h) / 2.0;
    }
  }

  function startProcess(time, delay = -1) {
    if (process_thread && isThreadRunning(process_thread)) process_thread.wakeupThrow("stop");
    this.start_time = time;
    if (delay >= 0) {
      this.delay_time = delay;
    }

    this.processing = true;
    this.process_thread = newthread();
    this.process_thread.start(_process, this);
  }

  function endProcess() {
    this.processing = false;
  }

  function _process() {
    try {
      while (this.processing) {
        if (view.visible) {
          suspend();
          continue;
        }
        local _time = skGetTime();
        if (_time - start_time >= delay_time) {
          view.setVisible(true);
          view.startMethod("processing");
        }
        suspend();
      }

      this.view.setVisible(false);
      this.view.stopMethod();
    } catch (ex) {
      if (ex != "stop") {
        printexception(ex);
      }

      this.processing = false;
      this.view.setVisible(false);
      this.view.stopMethod();
    }
  }
}