class FadingPanel {
  view = null;
  methods = null;
  curr_method = null;

  fading_time = 800;
  visible_time = 5000;

  curr_idx = -1;
  initial_params = null;
  interval_id = -1;

  constructor(view) {
    this.view = view;
  }

  function start(i = 0) {
    stop(true);

    this.curr_idx = Math.min(i, length(view.children) - 1);
    this.methods = [_fadeout, _fadein, _wait];
    this.curr_method = this.methods[0];

    this.initial_params = { fadeout = {}, fadein = {} };
    _setDefaultParams(initial_params.fadeout, view.children[curr_idx]);
    _setDefaultParams(initial_params.fadein, view.children[(curr_idx + 1) % length(view.children)]);

    restart();
  }

  function stop(reset = true) {
    if (this.interval_id != -1) {
      clearInterval(this.interval_id);
      this.interval_id = -1;
    }

    if (reset && initial_params != null) {
      this.methods = [];
      this.curr_method = null;

      _applyDefaultParams(this.initial_params.fadeout);
      _applyDefaultParams(this.initial_params.fadein);

      this.initial_params = null;
    }
  }

  function restart() {
    local env = {
      self = this,
      timer = 0,
    };
    this.interval_id = setInterval(curr_method.bindenv(env), 16);
  }

  function _nextMethod() {
    clearInterval(interval_id);
    this.interval_id = -1;

    foreach (i, m in this.methods) {
      if (m != curr_method) continue;

      local next = (i + 1) % length(methods);
      this.curr_method = methods[next];
      if (next == 0) {
        start((curr_idx + 1) % length(view.children));
        return;
      }
      break;
    }

    restart();
  }

  function _setDefaultParams(t, c) {

    if (c instanceof ::SKImageView) {
      t[c] <- {};
      t[c].color <- c.sp.color0;
    }
    else if (c instanceof ::SKLabelView) {
      t[c] <- {};
      t[c].color <- c.fontattr.color;
    }

    foreach (cc in c.children) {
      _setDefaultParams(t, cc);
    }
  }

  function _applyDefaultParams(t) {
    foreach (c, p in t) {

      if ("color" in p) c.setColor(p.color);
    }
  }

  function _invisibleAll(c) {
    if (c instanceof ::SKImageView || c instanceof ::SKLabelView) {
      c.visible = false;
      c.matdirty = true;
      c.repaint();
    }
    foreach (cc in c.children) {
      _invisibleAll(cc);
    }
  }

  function _fadeout(dt) {
    if (timer == 0) {

      foreach (idx, c in self.view.children) {
        self._invisibleAll(c);
      }
      foreach (c, _ in self.initial_params.fadeout) {
        c.visible = true;
        c.matdirty = true;
        c.repaint();
      }
    }

    if (timer < self.fading_time) {

      foreach (c, p in self.initial_params.fadeout) {
        if (c instanceof ::SKImageView || c instanceof ::SKLabelView) {
          c.setColor((0xffffff00 & p.color) + int((255 & p.color) * float(self.fading_time - timer) / self.fading_time));
          c.matdirty = true;
          c.repaint();
        }
      }

      timer += dt;
      return;
    }

    foreach (c, p in self.initial_params.fadeout) {

      if (c instanceof ::SKImageView || c instanceof ::SKLabelView) {
        c.visible = false;
        c.setColor(p.color);
      }
    }

    self._nextMethod();
  }

  function _fadein(dt) {
    if (timer == 0) {

      foreach (c, _ in self.initial_params.fadein) {
        c.visible = true;
        c.matdirty = true;
        c.repaint();
      }
    }

    if (timer < self.fading_time) {

      foreach (c, p in self.initial_params.fadein) {
        if (c instanceof ::SKImageView || c instanceof ::SKLabelView) {
          c.setColor((0xffffff00 & p.color) + int((255 & p.color) * float(timer) / self.fading_time));
          c.matdirty = true;
          c.repaint();
        }
      }

      timer += dt;
      return;
    }

    foreach (c, p in self.initial_params.fadein) {
      if (c instanceof ::SKImageView || c instanceof ::SKLabelView) {
        c.setColor(p.color);
      }
    }

    self._nextMethod();
  }

  function _wait(dt) {
    timer += dt;

    if (timer < self.visible_time) return;

    self._nextMethod();
  }
}