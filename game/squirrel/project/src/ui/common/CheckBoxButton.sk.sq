class CheckBoxButton extends ::TapButton {
  checked = null;
  img = null;

  constructor(v, img, consume = true) {
    super(v, consume);

    this.img = img;
    this.checked = false;
  }

  function isButtonChecked() {
    return this.checked;
  }

  function setChecked(b) {
    this.checked = b;
    this.img.visible = b;
    this.img.matdirty = true;
    this.img.repaint();
  }

  function getView() {
    return this.view;
  }
}

class CheckBoxController {
  btn_table = null;
  checkedviews = null;

  type = null;
  static TYPE_SIMPLE = 1;
  static TYPE_ONLY = 2;

  constructor(type) {
    this.type = type;

    this.btn_table = {};
    this.checkedviews = [];
  }

  function addCheckBoxButton(v, img) {
    local _btn = CheckBoxButton(v, img);
    v.addEventListener(ACTION_EVENT, actionevent);
    _btn.setChecked(false);
    this.btn_table[v] <- _btn;
  }

  function actionevent(e) {
    e.consume();

    local _btn = this.btn_table[e.src];
    updateCheck(_btn);
  }

  function updateCheck(btn) {
    switch (this.type) {
    case TYPE_SIMPLE:
      btn.setChecked(!btn.isButtonChecked());
      if (btn.isButtonChecked()) {
        this.checkedviews + btn.getView();
      } else {
        local _idx = this.checkedviews.indexOf(btn.getView());
        if (_idx >= 0) delete this.checkedviews[_idx];
      }
      break;
    case TYPE_ONLY:
      if (btn.isButtonChecked()) return;
      foreach (view in this.checkedviews) {
        local _btn = this.btn_table[view];
        _btn.setChecked(false);
      }
      this.checkedviews.clear();
      btn.setChecked(true);
      this.checkedviews + btn.getView();
    }
  }

  function getCheckedButtonViews() {
    return this.checkedviews;
  }

  function checkButton(v) {
    local _btn = this.btn_table[v] || null;
    if (!_btn) return;
    updateCheck(_btn);
  }
}