class CostumeList {
  span_x = 140;
  span_y = 170;

  columns = 1;
  items = null;

  scroll_panel = null;
  pnl_list = null;
  reclist = null;

  constructor(pnl_list, fit = true, consume = true) {
    local reclist = SKMaskView();
    scroll_panel = ScrollPanel(reclist, consume);
    scroll_panel.dxscale = 0.0;
    scroll_panel.block = [145, 170];

    this.pnl_list = pnl_list;
    this.reclist = reclist;
    pnl_list.addChild(reclist);

    if (fit) {

      setColumns(int(pnl_list.bnd.w / span_x), false);
    }
  }

  function setColumns(col, immediate = false) {
    this.columns = col;

    if (immediate) {
      updatePosition();
    }
  }

  function buildlist(datas, tapFunc = null, longTapFunc = null) {
    reclist.clearChildren();
    this.items = [];

    foreach (data in datas) {
      local p = CostumeListItem(data, tapFunc, longTapFunc);
      items.append(p);

      local v = p.view;
      reclist.addChild(v);
    }

    updatePosition();
  }

  function updatePosition() {
    local span_x = this.span_x;
    local span_y = this.span_y;
    local columns = this.columns;

    local num = length(items);
    local line = num / columns + 1;
    local rh = line * span_y;
    if (rh < pnl_list.bnd.h) rh = pnl_list.bnd.h;
    reclist.setRect(0, 0, pnl_list.bnd.w, rh);

    local px = 0;
    local py = 0;
    for (local i = 0; i < num; i++) {
      px = (i % columns) * (span_x + 25);
      if (i % columns == 0) {
        py = (i / columns) * span_y;
      }

      local v = items[i].view;
      v.pos.set(px, py, 0);

    }

    scroll_panel.setScrollRect(reclist.bnd);
    reclist.repaint();
  }

  function sortByIdx(idx) {

    local _Data = ::CostumeData;
    local env = function(func) {
      return function(item) { return func.bindenv(item.data)() };
    }

    local rev = function(func) {
      return function() { return -1 * func() };
    }

    local multiComparator = function(...) {
      local funcs = [];
      for (local i = 0; i < vargc; i++) {
        funcs + compareBy(env(vargv[i]));
      }

      return function(a, b) {
        foreach (f in funcs) {
          local r = f(a, b);
          if (r == 0) continue;

          return r;
        }

        return 0;
      }
    }

    local comparator = null;
    switch (idx) {
    case 0:

      comparator = multiComparator(rev(_Data.getUID));
      break;
    case 1:

      comparator = multiComparator(_Data.getCostumeType, rev(_Data.getGrade), rev(_Data.getCost), rev(_Data.getCostumeID));
      break;
    case 2:

      comparator = multiComparator(rev(_Data.getLocked), rev(_Data.getGrade), rev(_Data.getCost), rev(_Data.getCostumeID));
      break;
    case 3:

      comparator = multiComparator(rev(_Data.getGrade), rev(_Data.getCost), rev(_Data.getCostumeID));
      break;
    case 4:

      comparator = multiComparator(rev(_Data.getLevel), rev(_Data.getGrade), rev(_Data.getCost), rev(_Data.getCostumeID));
      break;
    case 5:

      comparator = multiComparator(rev(_Data.getCost), rev(_Data.getGrade), rev(_Data.getCostumeID));
      break;
    case 6:

      comparator = multiComparator(rev(_Data.getTotalCommandValue), rev(_Data.getLevel), rev(_Data.getGrade), rev(_Data.getCost), rev(_Data.getCostumeID));
      break;
    }

    sortBy(comparator, false);
    updatePosition();
  }

  function sortBy(comparator, immediate = true) {
    this.items = mergeSort(items, comparator);

    if (immediate) {
      updatePosition();
    }
  }

  function mergeSort(a, cmp) {
    local n = length(a);
    if (n <= 1) return a;

    local s = [array(n / 2), array(n - n / 2)];
    foreach (i, e in a) {
      if (i < n / 2) {
        s[0][i] = e;
      }
      else {
        s[1][i - n / 2] = e;
      }
    }
    return merge(
    mergeSort(s[0], cmp),
    mergeSort(s[1], cmp),
    cmp, a);
  }

  function merge(a, b, cmp, out) {
    local al = length(a);
    local bl = length(b);

    local i = 0;
    local j = 0, k = 0;

    while (j < al && k < bl) {
      if (cmp(a[j], b[k]) <= 0) {
        out[i++] = a[j++];
      } else {
        out[i++] = b[k++];
      }
    }
    while (j < al) {
      out[i++] = a[j++];
    }
    while (k < bl) {
      out[i++] = b[k++];
    }
    return out;
  }

  function compareBy(func) {
    return function(a, b) {
      local aa = func(a);
      local bb = func(b);
      return aa < bb ? -1 : aa > bb ? 1 : 0;
    }
  }
}

class CostumeListItem {
  static DISABLE_COLOR1 = 858993663;
  static DISABLE_COLOR2 = 0x999999ff;

  static LONG_TAP_TIME = 1500;

  data = null;

  tapFunc = null;
  longTapFunc = null;
  intv = null;

  dragged = false;

  constructor(data, tapFunc, longTapFunc) {
    this.tapFunc = tapFunc;
    this.longTapFunc = longTapFunc ? longTapFunc : tapFunc;

    _loadCocos();
    _setupData(data);
  }

  function _loadCocos() {}
  function _setupData(data) {
    this.data = data;
  }

  function mouseevent(e) {
    switch (e.id) {
    case MOUSE_PRESSED:
      if (longTapFunc) {
        this.intv = setTimeout(_callTimeoutFunc.bindenv(this), LONG_TAP_TIME);
      }

      break;
    case MOUSE_DRAGGED:
      if (intv) {
        clearInterval(intv);
        this.intv = null;
      }

      this.dragged = true;

      break;
    case MOUSE_RELEASED:
      if (dragged) {
        this.dragged = false;
      }
      else {
        if (intv) {
          clearInterval(intv);
          this.intv = null;
        }

        tapped();
      }

      break;
    }
  }

  function _callTimeoutFunc(dt) {
    clearInterval(intv);

    newthread().start(longTapped, this);
  }

  function disableButton() {
  }

  function tapped() {
    tapFunc(this);
  }

  function longTapped() {
    longTapFunc(this);
  }
}

class CheckFrame {
  view = null;

  img_frame = null;
  img_check = null;

  selected = false;

  constructor(icon) {
    this.view = loadCocos("/ui/common/CheckFrame.json");

    this.img_frame = view.findChild("img_frame");
    this.img_check = view.findChild("img_check");

    view.enabled = false;
    deselect();

    icon.addChild(view);
  }

  function select() {
    selected = true;

    img_frame.visible = true;
    img_check.visible = true;
  }

  function deselect() {
    selected = false;

    img_frame.visible = false;
    img_check.visible = false;
  }

  function isSelected() {
    return selected;
  }
}

class InformationFrame {

  static LV_MAX = 1;
  static LACK = 2;
  static COMMENT = 4;
  duplicate_flags = 0;

  img_lock = null;
  img_lv_max = null;
  img_lack = null;
  lbl_comment = null;

  view = null;

  constructor(icon) {
    this.view = loadCocos("/ui/common/InformationFrame.json");
    view.enabled = false;

    this.img_lock = view.findChild("img_lock");
    img_lock.visible = false;

    this.img_lv_max = view.findChild("img_lv_max");
    img_lv_max.visible = false;

    this.img_lack = view.findChild("img_lack");
    img_lack.visible = false;

    this.lbl_comment = view.findChild("lbl_comment");
    lbl_comment.setText("");

    icon.addChild(view);
  }

  function showLock() {

    img_lock.visible = true;
  }

  function isLockShown() {
    return img_lock.visible;
  }

  function showLvMax() {
    if (duplicate_flags != 0) return;

    img_lv_max.visible = true;
    duplicate_flags |= LV_MAX;
  }

  function showLack() {
    if (duplicate_flags != 0) return;

    img_lack.visible = true;
    duplicate_flags |= LACK;
  }

  function isLvMaxShown() {
    return img_lv_max.visible;
  }

  function showLack() {
    if (duplicate_flags != 0) return;

    img_lack.visible = true;
    duplicate_flags |= LACK;
  }

  function isLackShown() {
    return img_lack.visible;
  }

  function showComment(txt) {
    if (duplicate_flags != 0) return;

    lbl_comment.setText(txt);
    duplicate_flags |= COMMENT;
  }

  function isCommentShown() {
    return duplicate_flags & COMMENT == COMMENT;
  }
}