class CharaAppealLayer {

  static BALLOON_TYPE_ATTRACT = 0;
  static BALLOON_TYPE_ATTRACT_APPROACH = 1;
  static BALLOON_TYPE_NOTICE = 2;
  static BALLOON_TYPE_HAPINESS = 3;
  static BALLOON_TYPE_HAPINESS_PRODUCT = 4;
  static BALLOON_TYPE_SELECT_FURNTIURE = 5;
  static BALLOON_TYPE_TAP_HAPINESS = 6;
  static BALLOON_TYPE_APPROACH_FURNITURE = 7;
  static BALLOON_TYPE_WANNA_USE_FURNITURE = 8;
  static BALLOON_TYPE_NOTE = 9;
  static BALLOON_TYPE_FAILUER = 10;

  balloons = null;
  stage = null;
  user_data = null;
  last_room_index = null;

  view = null;

  recently_added_type = -1;

  constructor(view) {
    this.view = view;
    this.balloons = {};

    local scene = ::gamesession.getCurrentScene();
    this.user_data = ::gamesession.getUserData();
    this.stage = scene.getStage();

    this.last_room_index = this.user_data.getCurrentRoomIndex();
    this.view.setUpdateFunc(update.bindenv(this));
  }

  function update(dt) {

    local room_index = this.user_data.getCurrentRoomIndex();
    if (this.last_room_index != room_index) {
      releaseAllBalloons();
      this.last_room_index = room_index;
    }

    local _sk_time = skGetTime();
    foreach (bl in this.balloons) {
      if (!bl.isValidate()) {
        releaseBalloon(bl);
      }
      bl.update(_sk_time);
    }

  }

  function addAttractBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_ATTRACT)
    } else {
      if (bl instanceof AttractBalloonAtFurniture) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_ATTRACT)
      }
    }
  }

  function addAttractApproachBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_ATTRACT_APPROACH)
    } else {
      if (bl instanceof AttractApproachBalloon) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_ATTRACT_APPROACH)
      }
    }
  }

  function addNoticeBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_NOTICE)
    } else {
      if (bl instanceof NoticeBalloon) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_NOTICE)
      }
    }
  }

  function addNoteBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_NOTE)
    } else {
      if (bl instanceof NoteBalloon) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_NOTE)
      }
    }
  }

  function addFailuerBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_FAILUER)
    } else {
      if (bl instanceof FailuerBalloon) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_FAILUER)
      }
    }
  }

  function addHapinessBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_HAPINESS);
    } else {
      if (bl instanceof HapinessBalloon) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_HAPINESS)
      }
    }
  }

  function addHapinessProductBalloon(model, pd) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_HAPINESS_PRODUCT, pd);
    } else {
      if (bl instanceof HapinessProductBalloon) {
        bl.build(model);
        bl.setParam(pd);
      } else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_HAPINESS_PRODUCT, pd);
      }
    }
  }

  function addSelectFurnitureBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_SELECT_FURNTIURE);
    } else {
      if (bl instanceof SelectingFurnitureBalloon) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_SELECT_FURNTIURE)
      }
    }
  }

  function addApproachFurnitureBalloon(model) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_APPROACH_FURNITURE);
    } else {
      if (bl instanceof ApproachFurnitureBalloon) {
        bl.build(model);
      }
      else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_APPROACH_FURNITURE)
      }
    }
  }

  function addTapHapinessBalloon(model, pd) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_TAP_HAPINESS, pd);
    } else {
      if (bl instanceof TapHapinessBalloon) {
        bl.build(model);
        bl.setParam(pd);
      } else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_TAP_HAPINESS, pd);
      }
    }
  }

  function addWannaUseFurnitureBalloon(model, tutorial_mode = false) {
    local bl = this.balloons[model] || null;
    if (!bl) {
      addNewBalloon(model, BALLOON_TYPE_WANNA_USE_FURNITURE, tutorial_mode);
    } else {
      if (bl instanceof WannaUseFurnitureBalloon) {
        bl.build(model);
        bl.setParam(tutorial_mode);
      } else {
        releaseBalloon(bl);
        addNewBalloon(model, BALLOON_TYPE_WANNA_USE_FURNITURE);
      }
    }
  }

  function addNewBalloon(model, type, param = null) {
    local bl;
    switch (type) {
    case BALLOON_TYPE_ATTRACT: bl = AttractBalloonAtFurniture(this, this.stage); break;
    case BALLOON_TYPE_ATTRACT_APPROACH: bl = AttractApproachBalloon(this, this.stage); break;
    case BALLOON_TYPE_NOTICE: bl = NoticeBalloon(this, this.stage); break;
    case BALLOON_TYPE_HAPINESS: bl = HapinessBalloon(this, this.stage); break;
    case BALLOON_TYPE_HAPINESS_PRODUCT: bl = HapinessProductBalloon(this, this.stage); break;
    case BALLOON_TYPE_SELECT_FURNTIURE: bl = SelectingFurnitureBalloon(this, this.stage); break;
    case BALLOON_TYPE_APPROACH_FURNITURE: bl = ApproachFurnitureBalloon(this, this.stage); break;
    case BALLOON_TYPE_TAP_HAPINESS: bl = TapHapinessBalloon(this, this.stage); break;
    case BALLOON_TYPE_WANNA_USE_FURNITURE: bl = WannaUseFurnitureBalloon(this, this.stage); break;
    case BALLOON_TYPE_NOTE: bl = NoteBalloon(this, this.stage); break;
    case BALLOON_TYPE_FAILUER: bl = FailuerBalloon(this, this.stage); break;
    }
    if (!bl) return;
    bl.build(model);
    if (param) bl.setParam(param);
    this.view.addChild(bl.view);
    this.balloons[model] <- bl;

    this.recently_added_type = type;
    local _cp = ::gamesession.getCurrentScene().getUI().getCurrentPanel();
    ::tutorial_manager.checkAndStartTutorialAtCharaAppealBalloon(_cp);
  }

  function releaseAllBalloons() {
    foreach (bl in this.balloons) {
      bl.release();
      this.view.removeChild(bl.view);
    }
    this.balloons = {};
  }

  function releaseBalloon(bl) {
    bl.release();
    this.view.removeChild(bl.view);
    delete this.balloons[bl.getModel()];
  }

  function getBalloon(model) {
    return this.balloons[model];
  }

  function getHapinessBalloon(model) {
    local bl = this.balloons[model] || null;
    if (bl instanceof HapinessBalloon) return bl;

    return null;
  }

  function getTapHapinessBalloon(model) {
    local bl = this.balloons[model] || null;
    if (bl instanceof TapHapinessBalloon) return bl;

    return null;
  }
  function getHapinessProductBalloon(model) {
    local bl = this.balloons[model] || null;
    if (bl instanceof HapinessProductBalloon) return bl;

    return null;
  }

  function getWannaUseFurnitureBalloon(model) {
    local bl = this.balloons[model] || null;
    if (bl instanceof WannaUseFurnitureBalloon) return bl;

    return null;
  }

  function hasBalloon(type) {
    foreach (bl in this.balloons) {
      switch (type) {
      case BALLOON_TYPE_ATTRACT:
        if (bl instanceof AttractBalloonAtFurniture) return true;
        break;
      case BALLOON_TYPE_ATTRACT_APPROACH:
        if (bl instanceof AttractApproachBalloon) return true;
        break;
      case BALLOON_TYPE_NOTICE:
        if (bl instanceof NoticeBalloon) return true;
        break;
      case BALLOON_TYPE_HAPINESS:
        if (bl instanceof HapinessBalloon) return true;
        break;
      case BALLOON_TYPE_HAPINESS_PRODUCT:
        if (bl instanceof HapinessProductBalloon) return true;
        break;
      case BALLOON_TYPE_SELECT_FURNTIURE:
        if (bl instanceof SelectingFurnitureBalloon) return true;
        break;
      case BALLOON_TYPE_ATTRACT_APPROACH:
        if (bl instanceof ApproachFurnitureBalloon) return true;
      case BALLOON_TYPE_TAP_HAPINESS:
        if (bl instanceof TapHapinessBalloon) return true;
        break;
      case BALLOON_TYPE_NOTE:
        if (bl instanceof NoteBalloon) return true;
        break;
      case BALLOON_TYPE_FAILUER:
        if (bl instanceof FailuerBalloon) return true;
        break;
      }
    }
    return false;
  }

  function getRecentlyAddedType() {
    return this.recently_added_type;
  }

  function setVisible(b) {
    this.view.visible = b;
    this.view.repaint();
  }

  function setEnabled(b) {
    this.view.enabled = b;
  }
}

class CharaAppealLayer.CharaBalloon {
  layer = null;
  camera = null;
  stage = null;

  view = null;

  model = null;

  click_func = null;
  tap_lock = false;

  v_1 = Vector3D();

  constructor(layer, stage, view) {
    this.layer = layer;
    this.stage = stage;
    this.camera = stage.renderer.camera;
    this.view = view;
    if (this.view) this.view.addEventListener(MOUSE_EVENT, mouseevent);
  }

  function build(model) {
    this.model = model;
  }

  function setParam(param) {
  }

  function release() {
  }

  function update(sk_time) {
    if (!this.model || !this.view) return;
    _updateViewPosition();
  }

  function _updateViewPosition() {
    v_1.set(0, 0, 0);

    local sk3d = this.model.obj.sk3d;
    if (sk3d.parent) {
      local bone = sk3d.parentbone;
      local p0 = bone.parts.bindpose;
      v_1.set(p0[12], 0, p0[14]).transform0(sk3d.parent.gmat);
      v_1.add(sk3d.parent.pos);
    }

    v_1.add(this.model.getPos()).add(0, 2.5, 0.0);

    local v = this.camera.project(v_1);

    local x = (layer.view.bnd.w - ::screenWidth) / 2.0 + ::screenWidth * v.x;
    local y = (layer.view.bnd.h - ::screenHeight) / 2.0 + ::screenHeight * v.y;
    this.view.pos.set(x, y, v.z);
    this.view.matdirty = true;
    this.view.repaint();
  }

  function getView() {
    return this.view;
  }

  function getModel() {
    return this.model;
  }

  function isValidate() {
    return false;
  }

  function setClickFunc(f) {
    this.click_func = f;
  }

  function setTapLock(b) {
    this.tap_lock = b;
  }

  function mouseevent(e) {
    if (this.tap_lock) return;

    e.consume();

    switch (e.id) {
    case MOUSE_CLICKED:
      if (this.click_func) this.click_func();
      break;
    }
  }
}

class CharaAppealLayer.AttractBalloon extends CharaAppealLayer.CharaBalloon {
  static START_BLINK = 2000;

  static STATE_INIT = 0;
  static STATE_BLINK = 1;
  state = null;

  last_count = -1;
  lbl_count = null;

  constructor(layer, stage, view = null) {

    super(layer, stage, ::loadSKView("/ui/common/CharaAttractIcon.ui"));
    this.view.pickable = false;
    this.lbl_count = this.view.findChild("lbl_count");
  }

  function build(model) {
    this.model = model;
    local _tm = this.model.getAttractTarget();

    local _fd = _tm.getFurnitureData();
    local _sp = _fd.getCurrentIconSprite();
    local _icon = this.view.findChild("img_icon");
    _icon.setSprite(_sp);
    _icon.updateLayout();

    state = STATE_INIT;

    local cnt = this.model.getAttractCount();
    this.lbl_count.setText(cnt);
    this.last_count = cnt;
  }

  function update(sk_time) {

    local _remain = this.model.getLoseAttractTime() - sk_time;
    if (_remain > START_BLINK && this.state != STATE_INIT) {
      this.view.startMethod("init");
      this.state = STATE_INIT;
    } else if (_remain <= START_BLINK && this.state != STATE_BLINK) {
      this.view.startMethod("blink");
      this.state = STATE_BLINK;
    }

    local cnt = this.model.getAttractCount();
    if (cnt != this.last_count) {
      this.lbl_count.setText(cnt);
      this.last_count = cnt;
    }

    _updateViewPosition();
  }

  function isValidate() {
    if (!this.model.hasAttractTarget()) return false;
    if (!this.model.isStateAttractTap()) return false;

    if (this.last_count <= 0) return false;

    return true;
  }
}

class CharaAppealLayer.AttractBalloonAtFurniture extends CharaAppealLayer.CharaBalloon {
  static START_BLINK = 2000;

  static STATE_INIT = 0;
  static STATE_BLINK = 1;
  state = null;

  last_count = -1;
  lbl_count = null;
  furniture_model = null;

  constructor(layer, stage, view = null) {

    super(layer, stage, ::loadSKView("/ui/common/CharaAttractIcon.ui"));
    this.view.pickable = false;
    this.lbl_count = this.view.findChild("lbl_count");
  }

  function build(model) {
    this.model = model;
    this.furniture_model = this.model.getAttractTarget();

    local _cs = this.model.getCostumeData().getCharaSetting();
    local _sp = _cs.getIconSprite();
    local _icon = this.view.findChild("img_icon");
    _icon.setSprite(_sp);
    _icon.updateLayout();

    state = STATE_INIT;

    local cnt = this.model.getAttractCount();
    this.lbl_count.setText(cnt);
    this.last_count = cnt;
  }

  function update(sk_time) {

    local _remain = this.model.getLoseAttractTime() - sk_time;
    if (_remain > START_BLINK && this.state != STATE_INIT) {
      this.view.startMethod("init");
      this.state = STATE_INIT;
    } else if (_remain <= START_BLINK && this.state != STATE_BLINK) {
      this.view.startMethod("blink");
      this.state = STATE_BLINK;
    }

    local cnt = this.model.getAttractCount();
    if (cnt != this.last_count) {
      this.lbl_count.setText(cnt);
      this.last_count = cnt;
    }

    _updateViewPosition();
  }

  function _updateViewPosition() {
    v_1.set(0, 0, 0);

    v_1.add(this.furniture_model.getPos()).add(0, 2.5, 0.0);

    local v = this.camera.project(v_1);

    local x = (layer.view.bnd.w - ::screenWidth) / 2.0 + ::screenWidth * v.x;
    local y = (layer.view.bnd.h - ::screenHeight) / 2.0 + ::screenHeight * v.y;
    this.view.pos.set(x, y, v.z);
    this.view.matdirty = true;
    this.view.repaint();
  }

  function isValidate() {
    if (!this.model.hasAttractTarget()) return false;
    if (!this.model.isStateAttractTap()) return false;

    if (this.last_count <= 0) return false;

    return true;
  }
}

class CharaAppealLayer.AttractApproachBalloon extends CharaAppealLayer.CharaBalloon {

  constructor(layer, stage, view = null) {
    super(layer, stage, ::loadSKView("/ui/common/CharaAppealIcon.ui"));
    this.view.pickable = false;
  }

  function build(model) {
    this.model = model;
    local _tm = this.model.getAttractTarget();

    local _fd = _tm.getFurnitureData();
    local _sp = _fd.getCurrentIconSprite();
    local _icon = this.view.findChild("img_icon");
    _icon.setSprite(_sp);
    _icon.updateLayout();
  }

  function isValidate() {
    if (this.model.isFurnitureScriptRunning()) return false;
    if (!this.model.hasAttractTarget()) return false;
    if (!this.model.isStateAttractApproach() && !this.model.isStateAttractUseFurniture()) return false;

    return true;
  }
}

class CharaAppealLayer.NoticeBalloon extends CharaAppealLayer.CharaBalloon {
  static DISP_LIMIT = 3000;

  limit_time = -1;

  constructor(layer, stage, view = null) {
    super(layer, stage, ::loadSKView("/ui/common/CharaNoticeIcon.ui"));

  }

  function build(model) {
    this.model = model;
    this.limit_time = skGetTime() + DISP_LIMIT;
  }

  function _charaFocus() {
    if (!this.model) return;
    ::gamesession.getCurrentScene().getUI().movePanel(::CharaFocusPanel, false, { "model" = this.model });
  }

  function isValidate() {
    return skGetTime() < this.limit_time;
  }
}

