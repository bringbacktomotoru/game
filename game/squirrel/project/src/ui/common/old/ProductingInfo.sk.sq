class ProductingInfo extends SKView {
  time_label = null;
  model = null;
  product_data = null;

  view = null;
  lbl_name = null;
  lbl_health = null;
  lbl_remain = null;
  btn_get_rm = null;
  btn_cancel = null;

  constructor(p = null) {
    super();

    this.view = ::loadSKView("/ui/common/ProductingInfo.ui");
    if (p) {
      p.addChild(this.view);
    } else {
      addChild(this.view);
    }

    setRect(0, 0, this.view.bnd.w, this.view.bnd.h);

    local _pnl = this.view.findChild("pnl_time");
    this.lbl_name = _pnl.findChild("lbl_name");
    this.lbl_health = _pnl.findChild("lbl_health");
    this.lbl_remain = _pnl.findChild("lbl_time");

    this.btn_get_rm = _pnl.findChild("btn_get_rm");
    ::TapButton(this.btn_get_rm).view.addEventListener(ACTION_EVENT, actionevent);

    this.btn_cancel = _pnl.findChild("btn_cancel");
    ::TapButton(this.btn_cancel).view.addEventListener(ACTION_EVENT, actionevent_cancel);
  }

  function setData(model, _producting = true) {
    this.model = model;
    this.product_data = model.getProductData();

    local producer_data = null;

    producer_data = this.model.getFurnitureData();

    this.lbl_name.setText(producer_data.getCurrentName());
    this.lbl_health.setText(::dict.get("nums_plus", [::formatNumberString(this.model.getProductByLevel().health)]))

    this.time_label = ::TimeLabel(this.lbl_remain, 0);
    if (_producting) {
      local _remain = this.product_data.getFinishTime() - ::getServerTime();
      this.time_label.setRemainTime(_remain);
      this.time_label.startCountDown();
    } else {
      this.time_label.setRemainTime(producer_data.getProductTime());
    }
  }

  function updateRemain() {
    if (this.product_data.getState() == ::ProductData.STATE_FINISHED) {
      this.lbl_remain.setText(::dict.get("product_finished"));
      this.btn_get_rm.visible = false;
    } else {
      local _remain = this.product_data.getFinishTime() - ::getServerTime();
      this.time_label.setRemainTime(_remain);
      this.btn_get_rm.visible = true;
    }
  }

  function setVisibleRMButton(b) {
    this.btn_get_rm.visible = b;
    this.btn_get_rm.matdirty = true;
    this.btn_get_rm.repaint();
  }

  function setVisibleCancelButton(b) {
    this.btn_cancel.visible = b;
    this.btn_cancel.matdirty = true;
    this.btn_cancel.repaint();
  }

  function actionevent(e) {
    e.consume();

    local dlg = ::ConfirmShortenTimeDialog();
    dlg.setProductData(this.product_data);
    dlg.show();

    while (!dlg.isClosing()) {
      suspend();
    }

    if (dlg.ret > 0) {
      local pm = ::gamesession.getCurrentScene().getProductionManager();
      pm.setAPIResponseFunc(updateRemain.bindenv(this));
      pm.shortenProductTime(this.product_data.getProducerID());
      this.time_label.stopCountDown();
      updateRemain();
    }
  }

  function actionevent_cancel(e) {
    e.consume();

    local dlg = SimpleDialog2();
    if (this.product_data instanceof ::FurnitureProductData) {
      dlg.lbl_msg.setText(::dict.get("product_cancel"));
      dlg.lbl_caution.setText(::dict.get("product_cancel_caution"));
      dlg.show();
    } else if (this.product_data instanceof ::FurnitureLevelupData) {
      dlg.lbl_msg.setText(::dict.get("product_cancel_levelup"));
      dlg.lbl_caution.setText(::dict.get("product_cancel_levelup_caution"));
    } else {
      dlg.lbl_msg.setText(::dict.get("product_cancel_deliver"));
      dlg.lbl_caution.setText(::dict.get("product_cancel_deliver_caution"));
    }
    dlg.show();

    while (!dlg.isClosing()) {
      suspend();
    }

    if (dlg.ret > 0) {
      local pm = ::gamesession.getCurrentScene().getProductionManager();
      if (this.product_data instanceof ::FurnitureDeliverData) {
        pm.cancelDeliverProduct(this.product_data.getProducerID());
      } else {
        pm.cancelProduct(this.product_data.getProducerID());
      }
    }

  }
}