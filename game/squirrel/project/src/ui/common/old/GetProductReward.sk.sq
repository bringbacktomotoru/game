class GetProductRewardCostume extends SKView {
  view = null;
  lbl_health = null;
  lbl_exp = null;

  img_icon = null;

  add_exp = 0;
  old_exp = 0;
  add_health = 0;
  old_health = 0;

  model = null;
  camera = null;

  v_1 = Vector3D();
  layer = null;

  position_offset = null;

  constructor(layer) {
    view = ::loadSKView("/ui/common/GetRewardProductCos.ui");
    addChild(view);

    local _pnl_health = this.view.findChild("pnl_health");
    this.lbl_health = _pnl_health.findChild("lbl_health");

    local _pnl_exp = this.view.findChild("pnl_exp");
    this.lbl_exp = _pnl_exp.findChild("lbl_exp");

    this.img_icon = this.view.findChild("img_icon");

    this.camera = ::gamesession.getCurrentScene().getStage().renderer.camera;
    this.layer = layer;

    setUpdateFunc(update.bindenv(this));
  }

  function setExpValue(exp, old_exp) {
    this.add_exp = exp;
    this.old_exp = old_exp;
    this.lbl_exp.setText(::dict.get("nums_plus", [this.add_exp]));
  }

  function setHealthValue(health, old_health) {
    this.add_health = health;
    this.old_health = old_health;
    this.lbl_health.setText(::dict.get("nums_plus", [this.add_health]));
  }

  function setValue(exp, health, old_exp, old_health) {
    setExpValue(exp, old_exp);
    setHealthValue(health, old_health);
  }

  function _setValueText() {
    this.lbl_exp.setText(::dict.get("nums_plus", [this.add_exp]));
    this.lbl_health.setText(::dict.get("nums_plus", [this.add_health]));
  }

  function _setExpHealth() {
    local cos_data = this.model.getCostumeData();

  }
  function _setIcon() {
    local cos_setting = this.model.getCostumeData().getSetting();
    local chara_setting = ::gamesetting.sanrio_chara_settings[cos_setting.getCharaID()];

    local sp = chara_setting.getIconSprite();
    this.img_icon.setSprite(sp);
    this.img_icon.updateLayout();
  }

  function setModel(model) {
    this.model = model;

    _setIcon();
  }

  function setPositionOffset(x, y) {
    this.position_offset = { x = x, y = y };
  }

  function update(dt) {
    if (!this.model) return;

    local v = this.camera.project(v_1.set(this.model.getPos()));

    local x = (layer.bnd.w - ::screenWidth) / 2.0 + ::screenWidth * v.x;
    local y = (layer.bnd.h - ::screenHeight) / 2.0 + ::screenHeight * v.y;
    if (this.position_offset) {
      x += this.position_offset.x;
      y += this.position_offset.y;
    }
    this.view.pos.set(x, y, v.z);
    this.view.matdirty = true;
    this.view.repaint();
  }

  function showAnime() {
    this.layer.addChild(this);

    newthread().start(function() {
      this.view.startMethod("show_health");
      while (this.view.isMethodRunning()) {
        suspend();
      }

      this.view.startMethod("hide_health");
      while (this.view.isMethodRunning()) {
        suspend();
      }

      this.view.startMethod("show_exp");
      while (this.view.isMethodRunning()) {
        suspend();
      }

      this.view.startMethod("hide_exp");
      while (this.view.isMethodRunning()) {
        suspend();
      }

      removeFromParent();
    }, this);
  }

  function showExpAnime() {
    this.layer.addChild(this);

    newthread().start(function() {
      this.view.startMethod("show_exp");
      while (this.view.isMethodRunning()) {
        suspend();
      }

      sleep(1500);

      this.view.startMethod("hide_exp");
      while (this.view.isMethodRunning()) {
        suspend();
      }

      removeFromParent();
    }, this);
  }
}

class GetProductRewardFurniture extends SKView {
  view = null;
  lbl_exp = null;

  img_icon = null;

  add_exp = 0;
  old_exp = 0;
  enabled_lvup = null;

  model = null;
  camera = null;

  v_1 = Vector3D();
  layer = null;

  position_offset = null;

  constructor(layer, exp, old_exp) {
    view = ::loadSKView("/ui/common/GetRewardProductCos.ui");
    addChild(view);

    local _pnl_exp = this.view.findChild("pnl_exp");
    this.lbl_exp = _pnl_exp.findChild("lbl_exp");

    this.img_icon = this.view.findChild("img_icon");
    local sp = ::getSprite("/ui/image/ss_chara2/icon_action.png");
    sp.blend = SK_MIX;
    this.img_icon.setSprite(sp);
    this.img_icon.updateLayout();

    this.camera = ::gamesession.getCurrentScene().getStage().renderer.camera;
    this.layer = layer;

    this.add_exp = exp;
    this.old_exp = old_exp;
    this.enabled_lvup = false;

    _setValueText();

    setUpdateFunc(update.bindenv(this));
  }

  function _setValueText() {
    this.lbl_exp.setText(::dict.get("nums_plus", [this.add_exp]));
  }

  function _setExp() {
    local fur_data = this.model.getFurnitureData();

    this.enabled_lvup = fur_data.isEnableLevelUp();
  }

  function setModel(model) {
    this.model = model;
    _setExp();
  }

  function setPositionOffset(x, y) {
    this.position_offset = { x = x, y = y };
  }

  function update(dt) {
    if (!this.model) return;

    local v = this.camera.project(v_1.set(this.model.getPos()));

    local x = (layer.bnd.w - ::screenWidth) / 2.0 + ::screenWidth * v.x;
    local y = (layer.bnd.h - ::screenHeight) / 2.0 + ::screenHeight * v.y;
    if (this.position_offset) {
      x += this.position_offset.x;
      y += this.position_offset.y;
    }
    this.view.pos.set(x, y, v.z);
    this.view.matdirty = true;
    this.view.repaint();
  }

  function showAnime() {
    this.layer.addChild(this);

    newthread().start(function() {
      this.view.startMethod("show_exp");
      while (this.view.isMethodRunning()) {
        suspend();
      }

      this.view.startMethod("hide_exp");
      while (this.view.isMethodRunning()) {
        suspend();
      }
      if (this.enabled_lvup) this.model.startEffect(::FurnitureModel.SCRIPT_LEVELUP_ENABLED);

      removeFromParent();
    }, this);
  }
}