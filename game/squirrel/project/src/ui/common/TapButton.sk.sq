class TapButton
{
  view = null;
  region = null;

  is_prefunc = false;
  func = null;

  pressed = false;
  is_repeatable = true;
  is_release_animating = false;
  consume = true;

  x0 = 0;
  y0 = 0;
  t0 = 0;
  base_scale = 1.0;

  event_func = null;

  enable = true;
  isPressedPostAction = false;
  enablePullAction = true;
  last_post_release_time = null;

  snd = ::SoundConstants.SOUND_BUTTON;
  jingle_wait_time = 0;

  constructor(v, consum = true) {
    view = v;
    region = v.findChild("region") || v;
    this.event_func = region.addEventListener(MOUSE_EVENT, mouseevent);
    v.pickable = true;
    v.enabled = true;
    consume = consum;

    this.last_post_release_time = -1;
  }

  function remove() {
    region.removeEventListener(MOUSE_EVENT, event_func);
    this.event_func = null;
  }

  function lensq(e) {
    local dx = e.x - x0;
    local dy = e.y - y0;
    return dx * dx + dy * dy;
  }

  function setPressedPostAction(b) {
    this.isPressedPostAction = b;
  }

  function setRepeatable(b) {
    this.is_repeatable = b;
  }

  function setEnabledPullAction(b) {
    enablePullAction = b;
  }

  function setTappedSE(snd) {
    this.snd = snd;
  }

  function setTappedJingle(snd, wait) {
    this.snd = snd;
    this.jingle_wait_time = wait;
  }

  function setClickFunc(func, is_prefunc) {
    this.func = func;
    this.is_prefunc = is_prefunc;
  }

  function mouseevent(e) {

    if (!enable) {
      if (consume) e.consume();
      return;
    }

    switch (e.id) {
    case MOUSE_PRESSED:
      if (consume) e.consume();
      if ((this.pressed || this.is_release_animating) && !this.is_repeatable) break;

      pressed = true;
      x0 = e.x;
      y0 = e.y;
      t0 = e.time;

      _waitForViewMethod();
      view.startMethod(pushanime.bindenv(this));
      break;
    case MOUSE_DRAGGED:
      if (consume) e.consume();

      if (pressed) {
        local _sub = e.time - t0;
        local _len = lensq(e);
        if (enablePullAction && (_sub >= 300 || (_sub > 100 && _len > 2000) || _len > 2500)) {
          pressed = false;

          _waitForViewMethod();
          view.startMethod(pullanime.bindenv(this));
        } else {
        }
      }
      break;
    case MOUSE_RELEASED:
      if (consume) e.consume();

      if (pressed) {

        _waitForViewMethod();
        view.startMethod(clickanime.bindenv(this));
      }
      pressed = false;
      break;
    case MOUSE_CLICKED:

      break;
    }
  }

  function pushanime() {

    if (this.snd) {
      if (jingle_wait_time) {
        ::playJingle(this.snd, this.jingle_wait_time);
      } else {
        ::playSound(snd);
      }
    }
    local T = 3;
    for (local i = 0; i < T; i++) {
      view.scale << (base_scale * ((T - i) * 0.2 / T + 0.8));
      view.matdirty = true;
      view.parent.repaint();
      sleep(16);
    }

    if (isPressedPostAction) region.postActionEvent("pressed");
  }

  function pullanime() {
    this.is_release_animating = true;
    local T = 3;
    for (local i = 0; i < T; i++) {
      view.scale << (base_scale * ((i + 1) * 0.2 / T + 0.8));
      view.matdirty = true;
      view.parent.repaint();
      sleep(16);
    }
    this.is_release_animating = false;
  }

  function clickanime() {
    local _now = skGetTime();
    if (this.last_post_release_time > 0 && _now - this.last_post_release_time < 30) {
      return;
    } else {
      this.last_post_release_time = _now;
    }

    this.is_release_animating = true;
    if (func && is_prefunc) func();

    view.setBuffer(true);
    local sp = view.buf;
    local ct = sp.colormat = Matrix();
    local HT = 3;
    local T = 3;
    for (local i = 0; i < T; i++) {
      ct[12] = ct[13] = ct[14] = 1.0;
      view.scale << (base_scale * ((i + 1) * 0.2 / T + 0.8));
      view.matdirty = true;
      view.parent.repaint();
      sleep(16);
    }
    view.scale << base_scale;
    view.matdirty = true;
    view.setBuffer(false);
    view.parent.repaint();

    suspend();
    if (func && !is_prefunc) func();
    this.is_release_animating = false;

    region.postActionEvent("released");
  }

  function _waitForViewMethod() {
    while (view.isMethodRunning()) {
      if (!_isInRoot(view)) break;
      suspend();
    }
  }
  function _isInRoot(view) {
    if (!view.parent) return false;
    if (view.parent instanceof SKRootView) return true;

    _isInRoot(view.parent);

  }
}