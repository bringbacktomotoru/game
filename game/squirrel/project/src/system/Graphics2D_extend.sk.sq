function getTexture(src, premult = false) {
  if (!src) {
    return null;
  }
  if (src instanceof SS_STRING) {
    src = ::getResource(src);
    if (!src) return null;
  }
  if (src.userdata) return src.userdata;
  try {
    local img = src.getContent();
    local tex = Texture();
    if (premult) img.premultAlpha();
    tex.load(img);
    tex.ref = weakref(src);
    src.flush();
    src.userdata = tex;
    return tex;
  } catch (e) {
    printf("texture loading error : %S\n", src.path);
    printexception(e);
    return null;
  }
}

function getSprite(path, errsp = false) {
  local old_path = null;
  if (!::READ_TRANS_FILE.equals("JP")) {
    local tr_idx = path.indexOf("/JP/");
    if (tr_idx > 0) {
      old_path = path;
      path = path.slice(0, tr_idx) + "/" + ::READ_TRANS_FILE + "/" + path.slice(tr_idx + 4, path.len());

      tr_idx = path.indexOf("/JP/");
      if (tr_idx > 0) {
        path = path.slice(0, tr_idx) + "/" + ::READ_TRANS_FILE + "/" + path.slice(tr_idx + 4, path.len());
      }
    }
  }

  local i = path.indexOf("#");

  if (i < 0) {
    local r = ::getResource(path);
    if (!r && old_path) {
      r = ::getResource(old_path);
    }

    if (!r) {
      return errsp ? getErrorSprite(path) : null;
    }

    if (r.userdata) {
      if (r.userdata instanceof Texture) {
        return Sprite(r.userdata);
      } else {
        return clone r.userdata;
      }
    }
    if (r.getContent() instanceof Sprite) {
      r.userdata = r.cache;
      r.flush();
      return clone r.userdata;
    }

    local tex = ::getTexture(r);
    if (!tex) {
      return errsp ? getErrorSprite(path) : null;
    }

    local sp = Sprite(tex);
    return sp;
  } else {
    local p0 = path.substring(0, i);
    local clipid = path.substring(i + 1);
    local r = ::getResource(p0);

    if (!r && old_path) {
      i = old_path.indexOf("#");
      p0 = old_path.substring(0, i);
      clipid = old_path.substring(i + 1);

      r = ::getResource(p0);
    }

    if (!r) {
      return errsp ? getErrorSprite(path) : null;
    }
    local clipset = r.getContent();
    if (!(clipset instanceof ImageClipSet)) {
      return errsp ? getErrorSprite(path) : null;
    }

    local sp = clipset.getClipSprite(clipid);
    if (!sp) {
      return errsp ? getErrorSprite(path) : null;
    }
    return sp;
  }
}