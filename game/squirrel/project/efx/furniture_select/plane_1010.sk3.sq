model =
{
  root = {
    pm = "plane_1010.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
  }

  function start() {
    deselected();
  }

  function deselected() {
    setBlend(SK_ADD);
    fadeColor(2130706432, 0);
    for (;;) {
      fadeColor(0xcf000000, 800);
      pass(800);
      fadeColor(2130706432, 800);
      pass(800);
    }
  }

  function selected_move() {
    setBlend(SK_ADD);
    fadeColor(4144896, 0);
    for (;;) {
      fadeColor(8355584, 800);
      pass(800);
      fadeColor(4144896, 800);
      pass(800);
    }
  }

  function selected_rotate() {
    setBlend(SK_ADD);
    fadeColor(32512, 0);
    for (;;) {
      fadeColor(52992, 800);
      pass(800);
      fadeColor(32512, 800);
      pass(800);
    }
  }
}