model =
{
  root = {
  }
  body = {
    pm = "windcutter_mu.pm"
    parent = "root"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
    setScale(2.5, 2.5, 2.5);
  }

  function start() {
    zoomTo(5.0, 5.0, 5.0, 600);
    $body.setBlend(SK_MIX);
    $body.spin(0, 64, 0, 10000);
  }
}