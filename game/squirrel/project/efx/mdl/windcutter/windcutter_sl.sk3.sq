model =
{
  root = {
    pm = "windcutter_sl.pm"
  }
}

scriptclass = "SK3DScriptRunner"

script =
{
  function setup() {
  }

  function start() {
    setBlend(SK_MIX);
    spin(0, -45, 0, 1000);
    pass(200);
    fadeColor(0xffffff00, 200);
    zoomTo(0.5, 0.5, 0.5, 400);
    pass(200);
    kill();
  }
}