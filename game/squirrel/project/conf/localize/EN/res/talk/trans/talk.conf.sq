  "サンタさんが道に/n迷わないように、<ns>おそとに/n大きな雪だるま/n作ろうかしら…#q1#",
  ]
  "pocha" = [
  "メリークリスマス#o1#/n寒いところからやってくる<ns>サンタさんのために/n温かいココアで/nおもてなし～#o1#",
  ]
  "mell" = [
  "メルークリスマス#e1#/nサンタさんにちゃんと/nお手紙届いたかな#o1#",
  ]
  "kuromi" = [
  "メリークリスマス#o1#<ns>真っ黒なクロミサンタが/nあんたのとこに/n来るかもよ～#s2#",
  ]
  "cinnamon" = [
  "サンタさんが/n来るのが楽しみで/n今からドキドキしちゃう#e1#",
  ]
  "purin" = [
  "サンタさん、/nお手紙読んでくれたかな#q1#",
  ]
  "kiki" = [
  "おそとにでたら/n冷たい風で<ns>ぼくのお鼻も/nトナカイさんみたいに/n真っ赤になっちゃった#s1#",
  ]
  "mymelo" = [
  "さんたさん、/nちゃんと/nおうちわかるかな…#q1#",
  ]
  "lala" = [
  "聖なる夜、星の音と共に/nたくさんの幸せがあなたの/n元に訪れますように#o1#<ns>メリークリスマス#s1#",
  ]
  "mello" = [
  "メリークリスマス#o1#<ns>サンタさんのおもてなしは/nぼくにまかしぇろ#e1#/nなのです#o1#",
  ]
  "tabo" = [
  "メリークリスマス#o1#/nクラッカー、/nパーンってするー#q1#",
  ]
  "badtz" = [
  "サンタ…<ns>ハッ#e1#/nべ、別に/nサンタなんて待ってねぇー#e1#",
  ]
  "ribon" = [
  "クリスマスツリーの/nてっぺんには/nお星さまじゃなくて<ns>お気に入りの/nリボンをつけちゃうの#h1#",
  ]
  "hangyo" = [
  "サンタさんも寒い中/n大変です…おうち、/n暖かくして出迎えましょう#o1#",
  ]
  "piano" = [
  "めりーくりすます#o1#<ns>いっしょに/nくりすますをすごせて、/nピアノうれしいな…#o1#",
  ]
  "keroppi" = [
  "メリークリスマス#o1#/nシャンシャンシャン#o1#/n鈴の音がするよ#e1#<ns>サンタさんをむカエル/n準備はできた#q1#",
  ]
}

talk_table["leave_season_12_3"] <- {
