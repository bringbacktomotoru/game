letter_settings[1].sender = "Daniel";
letter_settings[1].message_list[0][0] = "Hey, how are you doing?"
letter_settings[1].message_list[0][1] = "I wanted to ask you for a favor, so I thought I'd write you a letter."
letter_settings[1].message_list[0][2] = ""
letter_settings[1].message_list[0][3] = "Recently I've been preparing to move into a new room,"
letter_settings[1].message_list[0][4] = "but I wanted to talk with you first."
letter_settings[1].message_list[1][0] = "I still haven't finished moving in, but"
letter_settings[1].message_list[1][1] = "something came up suddenly."
letter_settings[1].message_list[1][2] = "So I have to go overseas for a photography trip."
letter_settings[1].message_list[1][3] = ""
letter_settings[1].message_list[1][4] = "So, the favor I wanted to ask you was"
letter_settings[1].message_list[1][5] = "could you manage my room while I'm away?"
letter_settings[1].message_list[2][0] = "I've been wanting you to come visit anyway."
letter_settings[1].message_list[2][1] = "There's not much furniture, but it's really nice."
letter_settings[1].message_list[2][2] = "I'm sure you'll like it.,"
letter_settings[1].message_list[2][3] = ""
letter_settings[1].message_list[2][4] = "I'll write again soon."

letter_settings[2].sender = "Daniel";
letter_settings[2].message_list[0][0] = "Hey, #playername"
letter_settings[2].message_list[0][1] = ""
letter_settings[2].message_list[0][2] = "Have you met Kitty before?"
letter_settings[2].message_list[0][3] = ""
letter_settings[2].message_list[0][4] = "She's coming over to play too,"
letter_settings[2].message_list[0][5] = "and I think I forgot to mention it to you."
letter_settings[2].message_list[1][0] = ""
letter_settings[2].message_list[1][1] = "But you and Kitty"
letter_settings[2].message_list[1][2] = "both have such bright personalities"
letter_settings[2].message_list[1][3] = ""
letter_settings[2].message_list[1][4] = "that I'm sure you'll become good friends, #playername."
letter_settings[2].message_list[2][0] = "So I'm sending this letter together with a diary."
letter_settings[2].message_list[2][1] = "You can use it to write about everything that happens."
letter_settings[2].message_list[2][2] = "I'm sure it'll be fun."
letter_settings[2].message_list[2][3] = ""
letter_settings[2].message_list[2][4] = "I hope you two can make lots of fond memories."
letter_settings[2].message_list[2][5] = ""
letter_settings[2].message_list[2][6] = "I'll send another letter soon."

