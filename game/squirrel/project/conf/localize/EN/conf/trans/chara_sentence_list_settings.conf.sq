chara_sentence_list_settings[21]["sentence_table"]["keroppi"][2]["sentence"] = "But I sometimes/nskip it and sleep in/ninstead...geh heh..."

chara_sentence_list_settings[22]["sentence_table"]["kitty"][0]["sentence"] = "There are some really/npretty flowers outside#o1#"
chara_sentence_list_settings[22]["sentence_table"]["kitty"][1]["sentence"] = "I wonder what/nthat flower is called#q1#"
chara_sentence_list_settings[22]["sentence_table"]["kitty"][2]["sentence"] = "I wanted #playername/nto see it too#o1#"
chara_sentence_list_settings[22]["sentence_table"]["cinnamon"][0]["sentence"] = "Listen to this#e1#When I /nwent out for a walk,/nthe flowers were in full /nbloom#e1#"
chara_sentence_list_settings[22]["sentence_table"]["cinnamon"][1]["sentence"] = "I want to bring some/nsnacks and friends to/nlook at them～"
chara_sentence_list_settings[22]["sentence_table"]["cinnamon"][2]["sentence"] = "Ehehe#o1#/nDo you want to come too#q1#"
chara_sentence_list_settings[22]["sentence_table"]["purin"][0]["sentence"] = "Earlier, when I was /nout for a stroll,/nI found a beautiful field /nof flowers~#e1#"
chara_sentence_list_settings[22]["sentence_table"]["purin"][1]["sentence"] = "Next time /nI'd like to go there/non a picnic with you~#e1#"
chara_sentence_list_settings[22]["sentence_table"]["purin"][2]["sentence"] = "Heh heh heh~#o1#/nWhat kind of snacks/nshould we bring along~#h1#"
chara_sentence_list_settings[22]["sentence_table"]["mymelo"][0]["sentence"] = "The flowers were/nso pretty when/nMyMelody went out#h1#"
chara_sentence_list_settings[22]["sentence_table"]["mymelo"][1]["sentence"] = "They would make/nlovely flower crowns#h1#"
chara_sentence_list_settings[22]["sentence_table"]["mymelo"][2]["sentence"] = "MyMelody wants to find those flowers again."
