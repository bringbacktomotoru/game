chara_sentence_list_settings[27]["sentence_table"]["kitty"][0]["sentence"] = "I wonder where/n#playername's hometown is#q1#"
chara_sentence_list_settings[27]["sentence_table"]["kitty"][1]["sentence"] = "I live just outside/nof London, England#o1#"
chara_sentence_list_settings[27]["sentence_table"]["kitty"][2]["sentence"] = "There are many/nlovely gardens there#h1#"
