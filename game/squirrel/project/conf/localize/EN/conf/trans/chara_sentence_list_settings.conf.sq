chara_sentence_list_settings[22]["sentence_table"]["keroppi"][1]["sentence"] = "I'm sure if I practice a lot/nI'll get really good at it#e1#"
chara_sentence_list_settings[22]["sentence_table"]["keroppi"][2]["sentence"] = "Then I'll make you /none too#e1#/nWhat color flowers /ndo you like#q1#"

chara_sentence_list_settings[23]["sentence_table"]["kitty"][0]["sentence"] = "Heehee#o1#/nLook, look#o1#"
chara_sentence_list_settings[23]["sentence_table"]["kitty"][1]["sentence"] = "I tied my ribbon/nreally nicely today#o1#"
chara_sentence_list_settings[23]["sentence_table"]["kitty"][2]["sentence"] = "So#q1# Do you like it#q1#"
chara_sentence_list_settings[23]["sentence_table"]["cinnamon"][0]["sentence"] = "What do you think#q1#"
chara_sentence_list_settings[23]["sentence_table"]["cinnamon"][1]["sentence"] = "Ehehe～#o1#/nPretty cool, right#q1#"
chara_sentence_list_settings[23]["sentence_table"]["cinnamon"][2]["sentence"] = "I changed my look#o1#"
chara_sentence_list_settings[23]["sentence_table"]["purin"][0]["sentence"] = "Hey hey, /nwhat do you think#q1#"
chara_sentence_list_settings[23]["sentence_table"]["purin"][1]["sentence"] = "Oh#q1#/nYou can't tell~#q1#"
chara_sentence_list_settings[23]["sentence_table"]["purin"][2]["sentence"] = "Heh heh heh~#o1#/nThen I'll go ahead/nand tell you#e1#"
chara_sentence_list_settings[23]["sentence_table"]["purin"][3]["sentence"] = "I just finished exercising~#o1#I'm a reformed boy#e1#"
chara_sentence_list_settings[23]["sentence_table"]["mymelo"][0]["sentence"] = "Do you like MyMelody's/n hood#q1#"
chara_sentence_list_settings[23]["sentence_table"]["mymelo"][1]["sentence"] = "Teehee#h1#/nIt's cute right#q1#"
chara_sentence_list_settings[23]["sentence_table"]["mymelo"][2]["sentence"] = "It's MyMelody's favorite#h1#"
chara_sentence_list_settings[23]["sentence_table"]["keroppi"][0]["sentence"] = "Finding a necktie I like/nmakes me so happy#e1##o1#"
chara_sentence_list_settings[23]["sentence_table"]["keroppi"][1]["sentence"] = "Do you like/nwearing neckties/ntoo, #playername#q1#"
chara_sentence_list_settings[23]["sentence_table"]["keroppi"][2]["sentence"] = "I'll choose one/nfor you if you like#e1#"
