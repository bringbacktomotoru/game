chara_sentence_list_settings[27]["sentence_table"]["keroppi"][2]["sentence"] = "Let's play together/nthe next time you're/nin the area#e1#"

chara_sentence_list_settings[28]["sentence_table"]["kitty"][0]["sentence"] = "#playername, do you have/nany siblings#q1#"
chara_sentence_list_settings[28]["sentence_table"]["kitty"][1]["sentence"] = "I have a sister/nnamed Mimmy#o1#"
chara_sentence_list_settings[28]["sentence_table"]["kitty"][2]["sentence"] = "We're actually twins/nso we look just alike#h1#"
chara_sentence_list_settings[28]["sentence_table"]["cinnamon"][0]["sentence"] = "I live with the nice/ngirl at the cafe."
chara_sentence_list_settings[28]["sentence_table"]["cinnamon"][1]["sentence"] = "She makes the best/ncinnamon rolls ever#e1#"
chara_sentence_list_settings[28]["sentence_table"]["cinnamon"][2]["sentence"] = "Ehehe#o1# The smell/nwas what brought me/ndown to the cafe#o1#"
chara_sentence_list_settings[28]["sentence_table"]["purin"][0]["sentence"] = "My mama's cooking/nis soooo good~#o1#"
chara_sentence_list_settings[28]["sentence_table"]["purin"][1]["sentence"] = "Her onigiri,/ntamagoyaki, /nand hamburgers/nare all delicious…nom#e1#"
chara_sentence_list_settings[28]["sentence_table"]["purin"][2]["sentence"] = "If we ever have /nthe chance to go on a /npicnic together I'll ask /nMama to make a bento~#e1#"
chara_sentence_list_settings[28]["sentence_table"]["mymelo"][0]["sentence"] = "MyMelody is/na big sister#h1#"
