chara_sentence_list_settings[24]["sentence_table"]["kitty"][0]["sentence"] = "～#o1#～#o1#"
chara_sentence_list_settings[24]["sentence_table"]["kitty"][1]["sentence"] = "Something really good happened#o1#/nDo you know what#q1#"
chara_sentence_list_settings[24]["sentence_table"]["kitty"][2]["sentence"] = "Heehee#o1#/nIt's a secret#h1#"
chara_sentence_list_settings[24]["sentence_table"]["cinnamon"][0]["sentence"] = "Ehehe～#o1#/nI'm so happy right now#o1#"
chara_sentence_list_settings[24]["sentence_table"]["cinnamon"][1]["sentence"] = "You want to know what/n happened#q1#"
chara_sentence_list_settings[24]["sentence_table"]["cinnamon"][2]["sentence"] = "It's a secret#o1#"
chara_sentence_list_settings[24]["sentence_table"]["purin"][0]["sentence"] = "Heh heh heh~#o1#"
chara_sentence_list_settings[24]["sentence_table"]["purin"][1]["sentence"] = "Ehehe#o1#/nYou know,"
chara_sentence_list_settings[24]["sentence_table"]["purin"][2]["sentence"] = "I have a lot/nof fun talking with you,/n#playername#o1#"
chara_sentence_list_settings[24]["sentence_table"]["purin"][3]["sentence"] = "Huhuhuh#o1#/nThank you for always making the time /nto chat with me~#h1#"
chara_sentence_list_settings[24]["sentence_table"]["mymelo"][0]["sentence"] = "Teehee#o1#"
chara_sentence_list_settings[24]["sentence_table"]["mymelo"][1]["sentence"] = "MyMelody is smiling because something fun is happening#o1#"
chara_sentence_list_settings[24]["sentence_table"]["mymelo"][2]["sentence"] = "But it's a secret#o1#"
chara_sentence_list_settings[24]["sentence_table"]["keroppi"][0]["sentence"] = "Geh heh heh heh#o1#"
chara_sentence_list_settings[24]["sentence_table"]["keroppi"][1]["sentence"] = "Ah#e1# Heyyyy#e1#"
chara_sentence_list_settings[24]["sentence_table"]["keroppi"][2]["sentence"] = "Just now, the best thing/nhappened to me~#e1#"
chara_sentence_list_settings[24]["sentence_table"]["keroppi"][3]["sentence"] = "Geh heh#o1# But what it is, is a /nS-E-C-R-E-T#o1#"

chara_sentence_list_settings[25]["sentence_table"]["kitty"][0]["sentence"] = "I took pictures of a pretty shop/nwhile I was out today#o1#"
chara_sentence_list_settings[25]["sentence_table"]["kitty"][1]["sentence"] = "They're really, really nice#o1#"
chara_sentence_list_settings[25]["sentence_table"]["kitty"][2]["sentence"] = "I always want to take pictures/nof cute things#h1#"
chara_sentence_list_settings[25]["sentence_table"]["cinnamon"][0]["sentence"] = "I want to make/nbread that looks cute#o1#"
chara_sentence_list_settings[25]["sentence_table"]["cinnamon"][1]["sentence"] = "Something photogenic,/nbut still delicious～#o1#"
chara_sentence_list_settings[25]["sentence_table"]["cinnamon"][2]["sentence"] = "I hope Mocha/nlikes it#o1#"
chara_sentence_list_settings[25]["sentence_table"]["purin"][0]["sentence"] = "Hey hey, /nlook here#e1#/nCheeeeeeeese#e1##o1#"
chara_sentence_list_settings[25]["sentence_table"]["purin"][1]["sentence"] = ".........."
chara_sentence_list_settings[25]["sentence_table"]["purin"][2]["sentence"] = "Did you take a picture~#q1#/nHeh heh~#o1#/nIt's a photogenic pose, /nright#q1##h1#"
chara_sentence_list_settings[25]["sentence_table"]["purin"][3]["sentence"] = "Huh#q1# /nYou don't think that/nthis is really photogenic#q1#"
chara_sentence_list_settings[25]["sentence_table"]["mymelo"][0]["sentence"] = "#playername, do you like/ntaking pictures#q1#"
chara_sentence_list_settings[25]["sentence_table"]["mymelo"][1]["sentence"] = "MyMelody likes pictures#h1#"
chara_sentence_list_settings[25]["sentence_table"]["mymelo"][2]["sentence"] = "MyMelody really likes/nto take nice-looking /npictures#o1#"
chara_sentence_list_settings[25]["sentence_table"]["keroppi"][0]["sentence"] = "Earlier, while I was on an /nadventure, I saw a really /nbeautiful landscape#e1#"
chara_sentence_list_settings[25]["sentence_table"]["keroppi"][1]["sentence"] = "I thought it would make/na great photo#e1#"
chara_sentence_list_settings[25]["sentence_table"]["keroppi"][2]["sentence"] = "Next time we're out,/nlet's go there together#e1#"

chara_sentence_list_settings[26]["sentence_table"]["kitty"][0]["sentence"] = "#playername, do you/nlike cookies#q1#"
chara_sentence_list_settings[26]["sentence_table"]["kitty"][1]["sentence"] = "I'm/nreally good at/nbaking cookies#o1#"
chara_sentence_list_settings[26]["sentence_table"]["kitty"][2]["sentence"] = "I'll make cookies and tea/nfor you next time#o1#"
chara_sentence_list_settings[26]["sentence_table"]["cinnamon"][0]["sentence"] = "Guess what#o1#/nI've got a special skill#o1#"
chara_sentence_list_settings[26]["sentence_table"]["cinnamon"][1]["sentence"] = "See my ears#q1#/nI can fly with them#e1#"
chara_sentence_list_settings[26]["sentence_table"]["cinnamon"][2]["sentence"] = "Ehehe#o1#/nI can go as far as the /nclouds#o1#"
chara_sentence_list_settings[26]["sentence_table"]["purin"][0]["sentence"] = "Yaaaaawn.../nHeh heh#o1#/nI couldn't stop that yawn~#o1#"
chara_sentence_list_settings[26]["sentence_table"]["purin"][1]["sentence"] = "Falling asleep anywhere/nis actually a/nspecialty of mine~#o1#"
chara_sentence_list_settings[26]["sentence_table"]["purin"][2]["sentence"] = "Especially when I/ncan take naps with you,/n#playername#o1#"
