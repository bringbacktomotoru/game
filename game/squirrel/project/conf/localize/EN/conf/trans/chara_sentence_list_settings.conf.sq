chara_sentence_list_settings[27]["sentence_table"]["cinnamon"][1]["sentence"] = "It's so pretty up there#e1#"
chara_sentence_list_settings[27]["sentence_table"]["cinnamon"][2]["sentence"] = "I want/n#playername to/nsee it, too..."
chara_sentence_list_settings[27]["sentence_table"]["purin"][0]["sentence"] = "I have a house/nall my own~#o1#"
chara_sentence_list_settings[27]["sentence_table"]["purin"][1]["sentence"] = "My sister-owner made /na cozy basket /njust for me~#e1#"
chara_sentence_list_settings[27]["sentence_table"]["purin"][2]["sentence"] = "It's in the hallway of/nmy sister's house#e1#/nIt's really the best~#o1#"
