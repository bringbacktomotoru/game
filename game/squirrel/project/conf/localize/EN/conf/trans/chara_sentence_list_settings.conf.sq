chara_sentence_list_settings[28]["sentence_table"]["keroppi"][3]["sentence"] = "I want you/nto meet him sometime,/n#playername#e1#"

chara_sentence_list_settings[29]["sentence_table"]["kitty"][0]["sentence"] = "When I was walking..."
chara_sentence_list_settings[29]["sentence_table"]["kitty"][1]["sentence"] = "It felt like something/nwas behind me, but/nno one was there..."
chara_sentence_list_settings[29]["sentence_table"]["kitty"][2]["sentence"] = "Then I looked at me feet and...#e1#"
chara_sentence_list_settings[29]["sentence_table"]["kitty"][3]["sentence"] = "It was Charmmy Kitty#e1#"
chara_sentence_list_settings[29]["sentence_table"]["cinnamon"][0]["sentence"] = "I took a nap the other /nday..."
chara_sentence_list_settings[29]["sentence_table"]["cinnamon"][1]["sentence"] = "When I woke up,/nI couldn't move at all...#e1#"
chara_sentence_list_settings[29]["sentence_table"]["cinnamon"][2]["sentence"] = "It was so scary,/nbut I managed to open/nmy eyes..."
chara_sentence_list_settings[29]["sentence_table"]["cinnamon"][3]["sentence"] = "It turns out that/nMilk and Shirotaro/nwere using me as a/n pillow."
chara_sentence_list_settings[29]["sentence_table"]["purin"][0]["sentence"] = "At night, /nwhile I was sleeping.../nI heard a rustling sound/nthat woke me up..."
chara_sentence_list_settings[29]["sentence_table"]["purin"][1]["sentence"] = "My heart was racing, /nbut I went to the room /nwhere the sound /nwas coming from..."
chara_sentence_list_settings[29]["sentence_table"]["purin"][2]["sentence"] = "And there#e1#/nI found Muffin/nsneaking a snack#e1#"
chara_sentence_list_settings[29]["sentence_table"]["purin"][3]["sentence"] = "What a sneaker#e1#/nI was almost hungry.../n...but a lot more surprised#e1#"
chara_sentence_list_settings[29]["sentence_table"]["mymelo"][0]["sentence"] = "When MyMelody /nwoke up..."
chara_sentence_list_settings[29]["sentence_table"]["mymelo"][1]["sentence"] = "MyMelody could hear/na bird singing,/nbut it was dark...#e1#"
chara_sentence_list_settings[29]["sentence_table"]["mymelo"][2]["sentence"] = "MyMelody was scared,/nbut on MyMelody's face..."
chara_sentence_list_settings[29]["sentence_table"]["mymelo"][3]["sentence"] = "was MyMelody's hood#e1#/nIt slipped..."
chara_sentence_list_settings[29]["sentence_table"]["keroppi"][0]["sentence"] = "The other night, /nI was sleeping alone,/nwhen suddenly something cold touched my head...#e1#"
chara_sentence_list_settings[29]["sentence_table"]["keroppi"][1]["sentence"] = "I was afraid, but I/nopened my eyes slowly...#e1#"
chara_sentence_list_settings[29]["sentence_table"]["keroppi"][2]["sentence"] = "And it was Denden#e1#/nHe'd fallen asleep and fell on me#e1#"
chara_sentence_list_settings[29]["sentence_table"]["keroppi"][3]["sentence"] = "I was afraid/nI was going to croak#e1#"

chara_sentence_list_settings[30]["sentence_table"]["kitty"][0]["sentence"] = "The other day, I got/na lovely red paper airplane from Mom"
chara_sentence_list_settings[30]["sentence_table"]["kitty"][1]["sentence"] = "And went I let go of it,"
chara_sentence_list_settings[30]["sentence_table"]["kitty"][2]["sentence"] = "It flew into the sky/nand went really far /naway..."
chara_sentence_list_settings[30]["sentence_table"]["cinnamon"][0]["sentence"] = "I went on a walk/nin the clouds the other /nday#e1#"
chara_sentence_list_settings[30]["sentence_table"]["cinnamon"][1]["sentence"] = "It started raining/nso I had to come back /nearly..."
chara_sentence_list_settings[30]["sentence_table"]["cinnamon"][2]["sentence"] = "I think I'll check the/nforecast before going out/nnext time#e1##e1#"
chara_sentence_list_settings[30]["sentence_table"]["purin"][0]["sentence"] = "Hey, I wanted to eat /na pudding/nchilling in the fridge..."
chara_sentence_list_settings[30]["sentence_table"]["purin"][1]["sentence"] = "But when I went to look/nfor one in the fridge/nthey were all gone..."
chara_sentence_list_settings[30]["sentence_table"]["purin"][2]["sentence"] = "Muffin accidentally ate/nthem all, and now.../nI'm kind of bummed..."
chara_sentence_list_settings[30]["sentence_table"]["mymelo"][0]["sentence"] = "The flowers MyMelody used to decorate the room..."
chara_sentence_list_settings[30]["sentence_table"]["mymelo"][1]["sentence"] = "This morning,/nthey didn't look so well..."
chara_sentence_list_settings[30]["sentence_table"]["mymelo"][2]["sentence"] = "MyMelody is sad/nthat they didn't bloom/na bit more..."
chara_sentence_list_settings[30]["sentence_table"]["keroppi"][0]["sentence"] = "I was thinking/nabout seeing /nthe fireworks,/nso I got ready to go~"
chara_sentence_list_settings[30]["sentence_table"]["keroppi"][1]["sentence"] = "I'd gotten in /nmy yukata already/nwhen it started raining suddenly..."
chara_sentence_list_settings[30]["sentence_table"]["keroppi"][2]["sentence"] = "I like the rain, but.../nI was dissapointed about the fireworks."

chara_sentence_list_settings[31]["sentence_table"]["kitty"][0]["sentence"] = "The other day,/nI wanted to write a poem/nwhile listening to the rain"
chara_sentence_list_settings[31]["sentence_table"]["kitty"][1]["sentence"] = "I opened the window and/nmy notebook got soaked#e1#"
chara_sentence_list_settings[31]["sentence_table"]["kitty"][2]["sentence"] = "I'll never do something/nthat silly again...#e1#"
chara_sentence_list_settings[31]["sentence_table"]["cinnamon"][0]["sentence"] = "I tried to make some/nbread the other day..."
chara_sentence_list_settings[31]["sentence_table"]["cinnamon"][1]["sentence"] = "I ended up burning it.../nI really thought it/nwould come out fine..."
chara_sentence_list_settings[31]["sentence_table"]["cinnamon"][2]["sentence"] = "Baking bread is/nactually pretty difficult#e1#"
chara_sentence_list_settings[31]["sentence_table"]["purin"][0]["sentence"] = "This morning/nI woke up and/nwas doing my exercises~#e1#"
chara_sentence_list_settings[31]["sentence_table"]["purin"][1]["sentence"] = "...but I was still /nhalf asleep, /nso I got my legs /nand arms tangled..."
chara_sentence_list_settings[31]["sentence_table"]["purin"][2]["sentence"] = "And so I crashed over#e1#/nEh heh heh#o1# Whoops#e1#"
chara_sentence_list_settings[31]["sentence_table"]["mymelo"][0]["sentence"] = "MyMelody made a /nmistake while ironing/nher hood..."
chara_sentence_list_settings[31]["sentence_table"]["mymelo"][1]["sentence"] = "And it was/nMyMelody's favorite, too..."
chara_sentence_list_settings[31]["sentence_table"]["mymelo"][2]["sentence"] = "So MyMelody needs/nto get better at ironing..."
