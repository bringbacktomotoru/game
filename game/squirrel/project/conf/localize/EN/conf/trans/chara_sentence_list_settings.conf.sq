chara_sentence_list_settings[32]["sentence_table"]["kitty"][0]["sentence"] = "I got a call/nfrom Daniel and/nwe talked a lot#o1#"
chara_sentence_list_settings[32]["sentence_table"]["kitty"][1]["sentence"] = "And after we finished/nsuddenly I heard/nthe doorbell ring#e1#"
chara_sentence_list_settings[32]["sentence_table"]["kitty"][2]["sentence"] = "Who is it#q1#'/nI thought, and when I opened the door/nit was Daniel#e1#"
chara_sentence_list_settings[32]["sentence_table"]["kitty"][3]["sentence"] = "I was so surprised#o1#"
chara_sentence_list_settings[32]["sentence_table"]["cinnamon"][0]["sentence"] = "I was checking myself in the mirror this morning,/nbut I saw someone else's face#e1#"
chara_sentence_list_settings[32]["sentence_table"]["cinnamon"][1]["sentence"] = "I was so scared,/nit took a while for me/nto check it again..."
chara_sentence_list_settings[32]["sentence_table"]["cinnamon"][2]["sentence"] = "When I finally did,/nI saw.../nBerry's face#e1#"
chara_sentence_list_settings[32]["sentence_table"]["cinnamon"][3]["sentence"] = "I guess he was/nfeeling a bit sleepy too#q1#"
chara_sentence_list_settings[32]["sentence_table"]["purin"][0]["sentence"] = "Earlier, I was rolling/naround and basking /nin the sun/nin this big grassy field~#o1#"
chara_sentence_list_settings[32]["sentence_table"]["purin"][1]["sentence"] = "All of a sudden, right/nbeneath me I noticed/na perfect four-leaf clover#e1#"
chara_sentence_list_settings[32]["sentence_table"]["purin"][2]["sentence"] = "It was so unexpected/nthat I was completely /nsurprised~#e1#"
chara_sentence_list_settings[32]["sentence_table"]["purin"][3]["sentence"] = "Now I think I'll definitely/nhave good luck /nand happiness~#o1#"
chara_sentence_list_settings[32]["sentence_table"]["mymelo"][0]["sentence"] = "MyMelody made/na really big/ncake earlier#e1#"
chara_sentence_list_settings[32]["sentence_table"]["mymelo"][1]["sentence"] = "And when MyMelody /nshared it/nwith Pompompurin,/nhe ate it all#e1#"
chara_sentence_list_settings[32]["sentence_table"]["mymelo"][2]["sentence"] = "Him eating a really big /ncake all by himself/nsurprised MyMelody#e1#"
chara_sentence_list_settings[32]["sentence_table"]["mymelo"][3]["sentence"] = "MyMelody gets full/nafter having just/na little cake#h1#"
chara_sentence_list_settings[32]["sentence_table"]["keroppi"][0]["sentence"] = "I was outside /nplaying earlier/nwhen it started /nto rain suddenly#e1#"
