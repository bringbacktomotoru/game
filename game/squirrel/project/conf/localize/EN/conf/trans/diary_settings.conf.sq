diary_settings[500].lbl_titles = ["Detective/nMelody#MMe1#"]

diary_settings[501].name = "Leave it to Detective Melody"
diary_settings[501].texts = ["You noticed the Donuts Very sharp, Cinnamon#MMe1# Melody knew you'd make a great assistant#MMe1# We'll get to the bottom of this together.", "I guess I'm a detective's assistant now. Melody doesn't seem to be listening to me...what's going to happen now#CNq1#"]
