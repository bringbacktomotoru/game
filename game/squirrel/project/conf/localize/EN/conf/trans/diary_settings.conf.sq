diary_settings[501].lbl_titles = ["Dependable/nassistant", "Detective's assistant"]

diary_settings[502].name = "Leave it to Detective Melody"
diary_settings[502].texts = ["Detective Kitty is Detective Melody's rival. To think that she'd solve the case first...Melody expected no less from her rival.", "The usual suspects, airtight alibis, a rival detective... We're just getting started."]
diary_settings[502].titles = ["A rival appears", "Questions"]

diary_settings[503].name = "Leave it to Detective Melody"
diary_settings[503].texts = ["Purin's safe#MMe1# And that's yet another case cracked#MMe1# No case is too tough for Detective Melody#MMh1#", "Purin's safe#MMe1# We won't lose to Kitty next time#MMe1# No case is too tough for Detective Melody#MMh1#"]
