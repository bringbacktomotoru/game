diary_settings[301].name = "Let's Open a Cafe"
diary_settings[301].texts = ["What kind of books should we stock#KRq1# #playername made some suggestions#KRq1# I hope our visitors enjoy the selection#KRe1#", "It's too big and heavy to move alone#KRe1# Good thing #playername was there to help#KRe1# Best play carefully, wouldn't want to trip."]
