diary_settings[302].name = "Let's Open a Cafe"
diary_settings[302].texts = ["A fluffy sofa was just what we needed#PNq1# It's the perfect place for a quick nap#PNo1# Huh#PNq1# There's no time to rest～#PNq1#", "A TV was just what we needed#PNq1# This is sure to become a popular cafe to hang out#PNo1# Let's get ready#PNe1#"]
diary_settings[302].titles = ["Relaxing Sofa", "Fun Cafe"]

diary_settings[303].name = "Let's Open a Cafe"
diary_settings[303].texts = ["Welcome#CNe1# Our Cafe is finally ready#CNo1# #playername, would you like to place an order#CNe1# Take your time, enjoy the atmosphere#CNe1#"]
