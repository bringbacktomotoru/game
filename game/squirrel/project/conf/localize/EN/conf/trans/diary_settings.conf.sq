diary_settings[400].name = "Kitty's 3 Wishes"
diary_settings[400].texts = ["Let's start preparing#KTe1#I called some friends over. I only hope we can clear all 3 tasks beforehand#KTo1#"]
diary_settings[400].titles = ["Very excited#KTe1#"]

diary_settings[401].name = "Kitty's 3 Wishes"
diary_settings[401].texts = ["Apple Pie and Black Tea#MMo1# It's all so elegant#MMe1#/nMaybe we can have a party in Melody's room next time#MMo1#", "The tea party was wonderful#PNe1#I ate so much, I'm stuffed#PNe1# I hope I get invited to the next tea party too#PNo1#"]
diary_settings[401].titles = ["A fanciful tea party", "I'm stuffed#PNe1#"]
diary_settings[401].lbl_titles = ["A fanciful/ntea party", "I'm stuffed#PNe1#"]

diary_settings[402].name = "Kitty's 3 Wishes"
diary_settings[402].texts = ["Everyone enjoyed themselves#KTe1# Purin and Melody had fun dancing. I really loved the song we sung at the end.", "I was a little nervous, but our concert went well#KTe1# The last performance really fit the venue#KTe1# Thanks for the great suggestion#KTe1#"]
diary_settings[402].titles = ["Fun Concert", "Fancy Concert"]

diary_settings[403].name = "Kitty's 3 Wishes"
diary_settings[403].texts = ["Spending time with friends is wonderful. Next time I'll be the one to help #playername#KTe1#", "#playername said the tea party was fun while taking a catnap. Let's do something like this again#KTe1#"]
diary_settings[403].titles = ["Thanks", "Sleeptalking"]

diary_settings[500].name = "Leave it to Detective Melody"
