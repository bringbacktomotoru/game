letter_settings[1] <- ::LetterSetting({
  sender = "ダニエル";
  message_list = [
  [
  "やあ、元気にしてる？",
  "今日は、キミにお願いがあって手紙を書いてるんだ。",
  "",
  "ぼくが新しいお部屋へ引っ越しの準備をしていることは、",
  "以前キミにも話したよね。"
  ],
  [
  "まだ引っ越しは終わってないんだけど、",
  "実は急な予定が入って、",
  "しばらく海外へ撮影旅行に行くことになったんだ。",
  "",
  "お願いというのはそのことで、ぼくが留守にする間、",
  "新しいお部屋の管理をキミに頼めないかな？"
  ],
  [
  "ぜひ一度、お部屋を見に行ってほしいんだ。",
  "家具もまだないけど、すてきなお部屋だから、",
  "きっとキミも気に入るはずだよ。",
  "",
  "また手紙を送るね。"
  ]
  ];
  icon_path = "/ui/image/decoration/decoration/letter_danielstamp.png";
})

letter_settings[2] <- ::LetterSetting({
  sender = "ダニエル";
  message_list = [
  [
  "やあ、#playername",
  "",
  "キティにはもう会ったかな？",
  "",
  "彼女がお部屋に遊びに来ることになっていたんだけど、",
  "キミに伝えるのを忘れてしまっていたよ。",
  ],
  [
  "",
  "だけど、#playernameと",
  "キティは元気で明るいところがとっても似てるから、"
  "",
  "きっとなかよしのおともだちになれると思うんだ。"
  ],
  [
  "それと、この手紙と一緒に、日記帳を送ったよ。",
  "お部屋で起きたいろんなできごとを日記に書いたら、",
  "きっと楽しいよ。",
  "",
  "すてきな思い出で日記をいっぱいにできたらいいね。",
  "",
  "また手紙を送るよ。"
  ]
  ];
  icon_path = "/ui/image/decoration/decoration/letter_danielstamp.png";
})

letter_settings[3] <- ::LetterSetting({
  sender = "ダニエル";
  message_list = [
  [
  "やあ、#playername",
  "キティとは仲良くやってる？",
  "",
  "撮影旅行中に、ふしぎなカメラを手に入れたんだ。",
  "キミにぜひ使ってほしいから、手紙を一緒に送るよ。"
  ],
  [
  "",
  "どんなカメラなのかは使ってみてのお楽しみだよ。",
  "このカメラですてきな写真をたくさん撮ってほしいな。"
  ]
  ];
  icon_path = "/ui/image/decoration/decoration/letter_danielstamp.png";
})